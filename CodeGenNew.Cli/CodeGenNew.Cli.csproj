<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CodeGenNew.Core\CodeGenNew.Core.csproj" />
    <ProjectReference Include="..\CodeGenNew.Connections\CodeGenNew.Connections.csproj" />
    <ProjectReference Include="..\CodeGenNew.SchemaIntrospection\CodeGenNew.SchemaIntrospection.csproj" />
    <ProjectReference Include="..\CodeGenNew.TemplateEngine\CodeGenNew.TemplateEngine.csproj" />
    <ProjectReference Include="..\CodeGenNew.Generation\CodeGenNew.Generation.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>codegen</AssemblyName>
  </PropertyGroup>

  <!-- `dotnet pack` makes a .NET tool: `dotnet tool install -g CodeGenNew.Cli`, then `codegen ...`. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>codegen</ToolCommandName>
    <PackageId>CodeGenNew.Cli</PackageId>
    <Version>0.1.0</Version>
    <Authors>ericwood8</Authors>
    <Description>Generates stored procedures, entities, APIs and WinUI3 / React / Angular screens from a database schema with T4 templates.</Description>
    <PackageTags>codegen;t4;sql;entity-framework;winui;react;angular</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/ericwood8/CodeGenNew</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Settings.json lives next to the EXE (repo-root copy is the canonical, hand-edited source during
       development; this copies it alongside the built exe so a dev-time `dotnet run`/built binary finds
       it). Templates\*.tt(.config) and SpecialLogicColumns.config are instead embedded as a
       factory-default seed. DefaultAssetSeeder (called from Program.cs)
       materializes them as real, editable files next to the EXE the first time they're missing, and
       never overwrites an existing (possibly customized) one. -->
  <ItemGroup>
    <None Include="..\Settings.json" Link="Settings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- WithCulture=false on both: MSBuild's AssignCulture task otherwise reads the "tt" in
         "SP_Insert.tt.config" as the ISO culture code for Tatar and silently ships that file off into a
         "tt\" satellite resource assembly instead of embedding it in the main one. -->
    <EmbeddedResource Include="..\SpecialLogicColumns.config" Link="SpecialLogicColumns.config" WithCulture="false" />
    <EmbeddedResource Include="..\Templates\**\*.*" LinkBase="Templates" WithCulture="false" />
  </ItemGroup>

</Project>
