<ContentDialog
    x:Class="CodeGenNew.App.Views.TemplateManagementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CodeGenNew.App.ViewModels"
    PrimaryButtonText="Close"
    DefaultButton="Primary"
    RequestedTheme="Dark">

    <ContentDialog.Title>
        <TextBlock Text="Templates" FontFamily="{ThemeResource NocturneDisplayFontFamily}" FontWeight="SemiBold" />
    </ContentDialog.Title>

    <!-- A ContentDialog is capped at ~550px wide by default, which cut the row off: the
         second checkbox lost everything after its first letter and the Edit/Rename/Delete buttons were out of
         reach. Lifting the cap lets the dialog grow to fit the row (it still shrinks to the window). -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1400</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <Grid MinHeight="360">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="New Template..." Click="OnNewClick" ToolTipService.ToolTip="Create a new blank template" />
                <Button Content="Refresh" Click="OnRefreshClick" ToolTipService.ToolTip="Reload this list from the Templates folder" />
            </StackPanel>
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                       Text="Edit opens the template in your editor (double-clicking a row does the same)." />
        </StackPanel>

        <!-- If the window is ever narrower than the row, scroll sideways instead of clipping. -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
            <Border MinWidth="960" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- A tad darker than the row background so the header reads as a header. -->
                    <Grid Grid.Row="0" ColumnSpacing="12" Padding="8,6" Background="{ThemeResource CardBackgroundFillColorTertiaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Template" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Restrictions" FontWeight="SemiBold" Grid.ColumnSpan="2" />
                        <TextBlock Grid.Column="3" Text="Actions" FontWeight="SemiBold" Grid.ColumnSpan="3" />
                    </Grid>

                    <ListView Grid.Row="1" MaxHeight="420" ItemsSource="{x:Bind ViewModel.Templates}"
                              SelectedItem="{x:Bind ViewModel.SelectedTemplate, Mode=TwoWay}"
                              DoubleTapped="OnRowDoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TemplateRowViewModel">
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="12" Padding="8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   FontFamily="{ThemeResource NocturneMonoFontFamily}"
                                                   ToolTipService.ToolTip="{x:Bind SupersededTip}" />
                                        <CheckBox Grid.Column="1" Content="Requires Primary Key" IsChecked="{x:Bind RequiresPrimaryKey, Mode=TwoWay}" />
                                        <CheckBox Grid.Column="2" Content="Table Only" IsChecked="{x:Bind TableOnly, Mode=TwoWay}" />
                                        <Button Grid.Column="3" Content="Edit" Tag="{x:Bind}" Click="OnOpenClick"
                                                ToolTipService.ToolTip="Open this template in your editor" />
                                        <Button Grid.Column="4" Content="Rename" Tag="{x:Bind}" Click="OnRenameClick" />
                                        <Button Grid.Column="5" Content="{x:Bind DeleteButtonText, Mode=OneWay}" Tag="{x:Bind}" Click="OnDeleteClick" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </ScrollViewer>

        <InfoBar Grid.Row="2" Margin="0,8,0,0"
                 IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                 IsClosable="False"
                 Severity="Error"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </Grid>
</ContentDialog>
