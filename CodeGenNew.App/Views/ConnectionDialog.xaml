<ContentDialog
    x:Class="CodeGenNew.App.Views.ConnectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    SecondaryButtonText="Test"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    RequestedTheme="Dark">

    <ContentDialog.Title>
        <TextBlock Text="Connect to Database" FontFamily="{ThemeResource NocturneDisplayFontFamily}" FontWeight="SemiBold" />
    </ContentDialog.Title>

    <StackPanel Spacing="8" MinWidth="360">
        <ComboBox x:Name="ProviderCombo" Header="Database type" SelectionChanged="OnProviderChanged">
            <ComboBoxItem Content="SQL Server" />
            <ComboBoxItem Content="PostgreSQL" />
            <ComboBoxItem Content="MySQL" />
            <ComboBoxItem Content="SQLite (a file)" />
        </ComboBox>
        <TextBox x:Name="ServerBox" Header="Server" Text="{x:Bind ViewModel.ServerName, Mode=TwoWay}" />
        <TextBox x:Name="DatabaseBox" Header="Database" Text="{x:Bind ViewModel.DatabaseName, Mode=TwoWay}" />

        <RadioButtons x:Name="AuthRadios" Header="Authentication">
            <RadioButton x:Name="WindowsAuthRadio" Content="Windows Authentication" Checked="OnAuthModeChanged" />
            <RadioButton x:Name="SqlLoginRadio" Content="SQL Login" Checked="OnAuthModeChanged" />
        </RadioButtons>

        <TextBox x:Name="UserNameBox" Header="Username" Text="{x:Bind ViewModel.UserName, Mode=TwoWay}"
                 Visibility="Collapsed" />
        <PasswordBox x:Name="PasswordBoxControl" Header="Password" Visibility="Collapsed"
                     PasswordChanged="OnPasswordChanged" />

        <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                 IsClosable="False"
                 Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left" />
    </StackPanel>
</ContentDialog>
