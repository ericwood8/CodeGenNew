<ContentDialog
    x:Class="CodeGenNew.App.Views.GenerateAllDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CodeGenNew.App.ViewModels"
    PrimaryButtonText="Generate"
    CloseButtonText="Close"
    DefaultButton="Primary"
    RequestedTheme="Dark">

    <ContentDialog.Title>
        <TextBlock Text="Generate all for a project" FontFamily="{ThemeResource NocturneDisplayFontFamily}" FontWeight="SemiBold" />
    </ContentDialog.Title>

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">920</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="10" MinWidth="860">
        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="Every file of the chosen stacks for every table of the connected database, in one run. Which template runs for which tables comes from the templates and the project's settings. A file whose text did not change is not touched." />

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="8">
                <ComboBox Header="Project" ItemsSource="{x:Bind ViewModel.Projects}" SelectedItem="{x:Bind ViewModel.SelectedProject, Mode=TwoWay}" MinWidth="320" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Header="Output folder" Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay}" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse..." AccessKey="B" Click="OnBrowseClick" />
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Stacks" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Stacks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StackRowViewModel">
                            <CheckBox Content="{x:Bind Stack}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="16">
            <CheckBox Content="Dry run (write nothing)" IsChecked="{x:Bind ViewModel.DryRun, Mode=TwoWay}" />
            <CheckBox Content="Also the essentials (missing files only)" IsChecked="{x:Bind ViewModel.Essentials, Mode=TwoWay}" />
            <CheckBox Content="Delete stale files" IsChecked="{x:Bind ViewModel.DeleteStale, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16">
            <CheckBox Content="Build afterwards" IsChecked="{x:Bind ViewModel.Build, Mode=TwoWay}" />
            <CheckBox Content="Run tests afterwards" IsChecked="{x:Bind ViewModel.Test, Mode=TwoWay}" />
        </StackPanel>

        <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}" IsClosable="False" Severity="Warning" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
        <TextBlock Text="{x:Bind ViewModel.Progress, Mode=OneWay}" Opacity="0.7" />
        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />

        <ListView ItemsSource="{x:Bind ViewModel.Results}" SelectedItem="{x:Bind ViewModel.SelectedResult, Mode=TwoWay}" MaxHeight="200" />
        <TextBox Text="{x:Bind ViewModel.Diff, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MaxHeight="220" FontFamily="Consolas"
                 Header="What differs (the selected file)" Visibility="{x:Bind ViewModel.HasDiff, Mode=OneWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </StackPanel>
</ContentDialog>
