<ContentDialog
    x:Class="CodeGenNew.App.Views.LocationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Output Location"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <!-- Wider dialog and path field: a ContentDialog is capped at ~550px by default, which
         truncated any realistic path. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1400</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="8" MinWidth="820">
        <TextBlock Text="Generated files are written to this directory." TextWrapping="Wrap" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="Browse..." AccessKey="B" Click="OnBrowseClick" ToolTipService.ToolTip="Browse for a folder (Alt+B)" />
        </Grid>
        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
