<ContentDialog
    x:Class="CodeGenNew.App.Views.ProjectSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CodeGenNew.App.ViewModels"
    xmlns:core="using:CodeGenNew.Core"
    PrimaryButtonText="Save and Use"
    SecondaryButtonText="Use No Project"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    RequestedTheme="Dark">

    <ContentDialog.Title>
        <TextBlock Text="Project Settings" FontFamily="{ThemeResource NocturneDisplayFontFamily}" FontWeight="SemiBold" />
    </ContentDialog.Title>

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
        <DataTemplate x:Key="ChoiceTemplate" x:DataType="core:SettingChoice">
            <TextBlock Text="{x:Bind Label}" />
        </DataTemplate>
        <DataTemplate x:Key="SettingRowTemplate" x:DataType="vm:ProjectSettingRowViewModel">
            <StackPanel Margin="0,0,12,12" Spacing="2">
                <TextBlock Text="{x:Bind Caption}" FontWeight="SemiBold" Visibility="{x:Bind ShowCaption}" />
                <CheckBox Content="{x:Bind Caption}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" Visibility="{x:Bind IsBoolean}" />
                <TextBlock Text="{x:Bind Hint}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
                <TextBox Text="{x:Bind Value, Mode=TwoWay}" Visibility="{x:Bind IsText}" />
                <NumberBox Value="{x:Bind NumberValue, Mode=TwoWay}" Minimum="{x:Bind NumberMin}" Maximum="{x:Bind NumberMax}"
                           SpinButtonPlacementMode="Compact" ValidationMode="InvalidInputOverwritten" MinWidth="160" HorizontalAlignment="Left"
                           Visibility="{x:Bind IsNumber}" />
                <RadioButtons ItemsSource="{x:Bind Choices}" SelectedItem="{x:Bind SelectedChoice, Mode=TwoWay}"
                              ItemTemplate="{StaticResource ChoiceTemplate}" Visibility="{x:Bind IsRadio}" />
                <ComboBox ItemsSource="{x:Bind Choices}" SelectedItem="{x:Bind SelectedChoice, Mode=TwoWay}"
                          DisplayMemberPath="Label" MinWidth="260" Visibility="{x:Bind IsDropdown}" />
                <DropDownButton Content="{x:Bind OptionsSummary, Mode=OneWay}" MinWidth="260" HorizontalContentAlignment="Left" Visibility="{x:Bind IsMulti}">
                    <DropDownButton.Flyout>
                        <Flyout Placement="Bottom">
                            <ItemsControl ItemsSource="{x:Bind Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingOptionViewModel">
                                        <CheckBox Content="{x:Bind Label}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" MinWidth="0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </DataTemplate>
    </ContentDialog.Resources>

    <StackPanel Spacing="8" MinWidth="720">
        <TextBlock TextWrapping="Wrap"
                   Text="Namespaces, the context name and table lists the templates would otherwise hard-code. Only the project name is required; a blank namespace is derived from it." />
        <ComboBox x:Name="ProjectCombo" Header="Project name" IsEditable="True" MinWidth="360"
                  ItemsSource="{x:Bind ViewModel.Projects}"
                  Text="{x:Bind ViewModel.ProjectName, Mode=TwoWay}"
                  SelectionChanged="OnProjectSelectionChanged" />
        <TabView x:Name="SettingsTabs" IsAddTabButtonVisible="False" CanReorderTabs="False" CanDragTabs="False" TabWidthMode="SizeToContent" />
        <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                 IsClosable="False"
                 Severity="Error"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
