<ContentDialog
    x:Class="CodeGenNew.App.Views.ProjectSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CodeGenNew.App.ViewModels"
    PrimaryButtonText="Save and Use"
    SecondaryButtonText="Use No Project"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    RequestedTheme="Dark">

    <ContentDialog.Title>
        <TextBlock Text="Project Settings" FontFamily="{ThemeResource NocturneDisplayFontFamily}" FontWeight="SemiBold" />
    </ContentDialog.Title>

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="8" MinWidth="720">
        <TextBlock TextWrapping="Wrap"
                   Text="Namespaces, the context name and table lists the templates would otherwise hard-code. Only the project name is required; a blank namespace is derived from it." />
        <ComboBox x:Name="ProjectCombo" Header="Project name" IsEditable="True" MinWidth="360"
                  ItemsSource="{x:Bind ViewModel.Projects}"
                  Text="{x:Bind ViewModel.ProjectName, Mode=TwoWay}"
                  SelectionChanged="OnProjectSelectionChanged" />
        <TabView IsAddTabButtonVisible="False" CanReorderTabs="False" CanDragTabs="False" TabWidthMode="SizeToContent">
            <TabViewItem Header="General" IsClosable="False">
                <ScrollViewer MaxHeight="380" Padding="0,8,0,0">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.GeneralRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectSettingRowViewModel">
                                <TextBox Header="{x:Bind Key}" PlaceholderText="{x:Bind Hint}"
                                         Text="{x:Bind Value, Mode=TwoWay}" Margin="0,0,12,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="WinUI3" IsClosable="False">
                <ScrollViewer MaxHeight="380" Padding="0,8,0,0">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.WinUI3Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectSettingRowViewModel">
                                <TextBox Header="{x:Bind Key}" PlaceholderText="{x:Bind Hint}"
                                         Text="{x:Bind Value, Mode=TwoWay}" Margin="0,0,12,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
        <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                 IsClosable="False"
                 Severity="Error"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
