<Window
    x:Class="CodeGenNew.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CodeGenNew.App.ViewModels">

    <!-- Forced dark (Nocturne theme) regardless of the OS setting; see Themes/NocturneTheme.xaml. -->
    <Grid Padding="8" RequestedTheme="Dark" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- FontSize on each AppBarButton does NOT reach its label on its own: the default template
             hardcodes the label TextBlock to FontSize="12" rather than binding it to the button's own
             FontSize (confirmed against the WindowsAppSDK's own generic.xaml). Each button's Loaded handler
             (MainWindow.xaml.cs: OnAppBarButtonLoaded) reaches into the applied template afterward and
             copies the FontSize set here onto that TextBlock directly. Refresh lives with the TreeView now
             (the card header row below), not here: WinUI3's TreeView has no refresh affordance of its own
             to surface. -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Left"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Loaded="OnCommandBarLoaded">
            <AppBarButton x:Name="FirstCommandBarButton" Label="Output Location" FontSize="24" AccessKey="O" Click="OnLocationClick" Loaded="OnAppBarButtonLoaded" ToolTipService.ToolTip="Choose where generated files are written (Alt+O)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Project" FontSize="24" AccessKey="P" Click="OnProjectSettingsClick" Loaded="OnAppBarButtonLoaded" ToolTipService.ToolTip="Namespaces and names used in generated files for a project (Alt+P)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Templates" FontSize="24" AccessKey="T" Click="OnManageTemplatesClick" Loaded="OnAppBarButtonLoaded" ToolTipService.ToolTip="Add, rename, delete, or edit .tt templates (Alt+T)">
                <AppBarButton.Icon>
                    <ImageIcon Source="{x:Bind ViewModel.Icons.ManageTemplates, Mode=OneWay}" />
                </AppBarButton.Icon>
            </AppBarButton>
            <!-- The files every app of a kind needs and no table drives (App.xaml, MainWindow.xaml, styles, Program.cs ...): no connection is needed. -->
            <AppBarButton Label="Essentials" FontSize="24" AccessKey="E" Loaded="OnAppBarButtonLoaded" ToolTipService.ToolTip="The files every app needs that no table drives: App, main window, styles, Program.cs (Alt+E)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8A5;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="WinUI essentials" Tag="WinUI3" Click="OnEssentialsClick" />
                        <MenuFlyoutItem Text="React essentials" Tag="React" Click="OnEssentialsClick" />
                        <MenuFlyoutItem Text="Angular essentials" Tag="Angular" Click="OnEssentialsClick" />
                        <MenuFlyoutItem Text="API essentials" Tag="Api" Click="OnEssentialsClick" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Label="Connect" FontSize="24" AccessKey="C" Click="OnConnectClick" Loaded="OnAppBarButtonLoaded" ToolTipService.ToolTip="Connect to a SQL Server database (Alt+C)">
                <AppBarButton.Icon>
                    <ImageIcon Source="{x:Bind ViewModel.Icons.Connect, Mode=OneWay}" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <ProgressBar Grid.Row="1" IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Margin="0,8,0,0" />

        <Border Grid.Row="2" Margin="0,8,0,8" Padding="12" CornerRadius="6"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Background="Transparent" RightTapped="OnDatabaseRightTapped"
                                ToolTipService.ToolTip="Right-click for the templates that write files for the whole database">
                        <Image Source="{x:Bind ViewModel.Icons.Database, Mode=OneWay}" Width="22" Height="22" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.DatabaseLabel, Mode=OneWay}" FontWeight="SemiBold" FontSize="16"
                                       FontFamily="{ThemeResource NocturneDisplayFontFamily}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.DatabaseDetail, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Icon-only refresh for the tree below: WinUI3's TreeView has no built-in refresh
                         affordance, so this is the whole toolbar it gets, scoped to the same row as the
                         thing it reloads instead of a whole separate button bar. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Templates that write one file for the whole database (the DbContext, the API registration). -->
                        <Button x:Name="DatabaseTemplatesButton" Background="Transparent" BorderThickness="0" Padding="6"
                                AccessKey="D" Click="OnDatabaseTemplatesClick" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                ToolTipService.ToolTip="Generate for the whole database: DbContext, API registration, dashboard (Alt+D, or right-click the database name)">
                            <FontIcon Glyph="&#xE943;" FontSize="18" />
                        </Button>
                        <!-- Every file of a project's stacks for every table, in one run (the engine behind codegen generate). -->
                        <Button x:Name="GenerateAllButton" Background="Transparent" BorderThickness="0" Padding="6"
                                AccessKey="G" Click="OnGenerateAllClick" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                                ToolTipService.ToolTip="Generate everything for a project: every stack, every table, one run (Alt+G)">
                            <FontIcon Glyph="&#xE768;" FontSize="18" />
                        </Button>
                        <Button Background="Transparent" BorderThickness="0" Padding="6"
                                AccessKey="R" Command="{x:Bind ViewModel.RefreshCommand}"
                                ToolTipService.ToolTip="Reload the table list from the connected database (Alt+R)">
                            <ImageIcon Source="{x:Bind ViewModel.Icons.Refresh, Mode=OneWay}" Width="20" Height="20" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Grid.Row="*" (not a StackPanel) so the TreeView is given a bounded height and can
                     scroll internally. Inside an unbounded StackPanel it just kept growing past the
                     visible viewport, and tables below a certain point were only reachable by resizing
                     the window. -->
                <TreeView Grid.Row="1" x:Name="SchemaTreeView" ItemsSource="{x:Bind ViewModel.Tables}"
                          SelectionChanged="OnTreeSelectionChanged">
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TableNodeViewModel">
                            <TreeViewItem Tag="{x:Bind}" RightTapped="OnTableRightTapped">
                                <StackPanel Orientation="Vertical" Spacing="2" Padding="0,2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Background="Transparent" BorderThickness="0" Padding="2"
                                                Width="24" Height="24" Command="{x:Bind ToggleExpandCommand}"
                                                ToolTipService.ToolTip="Show/hide columns">
                                            <FontIcon Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" FontSize="10" />
                                        </Button>
                                        <Image Source="{x:Bind Icon}" Width="24" Height="24" />
                                        <TextBlock Text="{x:Bind DisplayName}" Foreground="{x:Bind TextBrush}" VerticalAlignment="Center" />
                                        <ProgressRing IsActive="{x:Bind IsLoadingColumns, Mode=OneWay}" Width="14" Height="14" />
                                    </StackPanel>

                                    <!-- Columns are plain read-only text inside the table's own row,
                                         not separate TreeView nodes, so they can never be selected or
                                         right-clicked. -->
                                    <ItemsControl ItemsSource="{x:Bind Columns}" Margin="30,0,0,0"
                                                  Visibility="{x:Bind IsExpanded, Mode=OneWay}"
                                                  IsTabStop="False" IsRightTapEnabled="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ColumnRowViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="4" Padding="0,1">
                                                    <Image Source="{x:Bind Icon}" Width="13" Height="13" />
                                                    <Image Source="{x:Bind PrimaryKeyIcon}" Width="13" Height="13"
                                                           Visibility="{x:Bind IsPrimaryKey}"
                                                           ToolTipService.ToolTip="Primary key" />
                                                    <TextBlock Text="{x:Bind DisplayText}" FontSize="12"
                                                               FontFamily="{ThemeResource NocturneMonoFontFamily}"
                                                               Opacity="0.75" IsTextSelectionEnabled="False" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Margin="12,4" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Foreground="{x:Bind ViewModel.StatusBrush, Mode=OneWay}" TextWrapping="Wrap" />
    </Grid>
</Window>
