# Restriction checkboxes for TS_EssentialStyles_v1.tt (see Docs/Reference.md section 3).
# One of the files every Angular app needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Angular
EssentialsGroup=Styles
Description=src/styles.css: the grids, forms, tabs, modal dialog, search row and shaded bold row buttons the generated components assume
