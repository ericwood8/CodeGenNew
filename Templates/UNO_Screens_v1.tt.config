# Restriction checkboxes for UNO_Screens_v1.tt (see Docs/Reference.md section 3).
# One run for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# The template writes its own paths (MainPage.Screens.cs, Services/ApiClients.cs) with @@@FILE markers.
OutputName=MainPage.Screens.cs
# Whole-project generation (codegen generate): the stacks that include this template.
Stacks=Uno
