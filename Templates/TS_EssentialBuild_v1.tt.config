# Restriction checkboxes for TS_EssentialBuild_v1.tt (see Docs/Reference.md section 3).
# One of the files every app of a stack needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Angular
EssentialsGroup=Build
Description=package.json, angular.json and the tsconfig files as ng new writes them (the @angular ranges follow AngularVersion)
