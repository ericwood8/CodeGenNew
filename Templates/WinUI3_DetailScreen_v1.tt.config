# Restriction checkboxes for WinUI3_DetailScreen_v1.tt (see Docs/specs.md section 5.3).
RequiresPrimaryKey=true
TableOnly=true
# <Table>Repo (CS_Repo, GenericRepo<T>) takes a plain int id.
RequiredPrimaryKeyShape=SingleInt
# A name/active table's repository is a NameActiveRepo (no GetAll for the paired master screen to call).
RequiresNotNameActiveTable=true
# The drop-downs for foreign keys show the parent table's display column, so ask for it.
NeedsReferencedDisplayColumns=true
# No OutputName: the template writes its own paths (Views/..., ViewModels/...) with @@@FILE markers.
