# Restriction checkboxes for WinUI3_DetailScreen_v1.tt (see Docs/Reference.md section 3).
RequiresPrimaryKey=true
TableOnly=true
# <Table>Repo (CS_Repo, GenericRepo<T, TKey>) takes the key as an int, a Guid or a string.
RequiredPrimaryKeyShape=SingleIntGuidOrText
# A name/active table's repository is a NameActiveRepo (no GetAll for the paired master screen to call).
RequiresNotNameActiveTable=true
# The drop-downs for foreign keys show the parent table's display column, so ask for it.
NeedsReferencedDisplayColumns=true
# No OutputName: the template writes its own paths (Views/..., ViewModels/...) with @@@FILE markers.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=WinUI3
PlanTables=ScreenForm
