# Restriction checkboxes for PY_Mod_v1.tt (see Docs/Reference.md section 3).
# One run for the whole database: the menu offers it on the database, the CLI runs it without -t.
DatabaseOnly=true
RequiresPrimaryKey=false
TableOnly=false
# The template writes its own paths (app/models/__init__.py, app/routes/__init__.py ...) with @@@FILE markers.
OutputName=app/routes/__init__.py
# Whole-project generation (codegen generate): the stacks that include this template.
Stacks=Python
