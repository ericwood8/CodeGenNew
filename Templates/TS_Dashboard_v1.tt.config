# Restriction checkboxes for TS_Dashboard_v1.tt (see Docs/Reference.md section 3).
# One set of files for the whole database: the menu offers it on the database, the CLI runs it without -t.
DatabaseOnly=true
RequiresPrimaryKey=false
TableOnly=false
# No OutputName: the template writes its own paths (services/dashboard.service.ts, components/...) with @@@FILE markers.
# Whole-project generation (codegen generate): written only for a project with Dashboard=true.
Stacks=Angular
OutputFolder=src/app
InPlan=false
