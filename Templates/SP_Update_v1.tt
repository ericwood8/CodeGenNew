<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // MySQL has real stored procedures with its own syntax: CodeGenNew.Core's MySqlProcedures writes this one for a table read from MySQL.
    if (Model.Dialect == SqlDialect.MySql)
    {
        Write(MySqlProcedures.Update(Model));
        return GenerationEnvironment.ToString();
    }
#>
<#
    // PostgreSQL has functions rather than stored procedures: CodeGenNew.Core's PostgresProcedures writes this one for a table read from PostgreSQL.
    if (Model.Dialect == SqlDialect.PostgreSql)
    {
        Write(PostgresProcedures.Update(Model));
        return GenerationEnvironment.ToString();
    }
#>
<#
    // ==========================================================================================
    // SP_Update_v1.tt
    // Generates: <TableName>_Update.sql
    // Updates one row by its primary key (single or composite). Every parameter is a VarChar and a NULL leaves its column untouched, so a caller sends only
    // what changed; strings are trimmed and quotes doubled, audit columns are set by rule. Returns 1 on success, 0 on failure. Needs a primary key.
    // SQL Server procedure, PostgreSQL function or MySQL procedure, by the source database.
    // Full notes: Docs/TemplateNotes/SP_Update_v1.md

    var updatableColumns = Model.Columns
        .Where(c => !c.IsComputed && !c.IsCreateDateColumn && !c.IsCreateUserColumn && !c.IsModifiedDateColumn && !c.IsLastChangedDateColumn)
        .ToList();
    // The active-flag column stays a parameter (so a caller can still reactivate a record) but is
    // excluded from the automatic per-column SET loop below - it's handled by a single IF/ELSE IF
    // instead, since it can be driven by either its own parameter or the inactivation triggers, never both.
    var setClauseColumns = updatableColumns.Where(c => !c.IsPrimaryKey && c != Model.ActiveColumn).ToList();
    var autoTouchedOnUpdateColumns = Model.Columns.Where(c => c.IsModifiedDateColumn || c.IsLastChangedDateColumn).ToList();

    // Columns that, when supplied on Update, imply the row should become inactive.
    var inactivationTriggerColumns = new List<ColumnModel>();
    if (Model.InactiveDateColumn is not null)
        inactivationTriggerColumns.Add(Model.InactiveDateColumn);
    inactivationTriggerColumns.AddRange(Model.Columns.Where(c => c.IsInactiveReasonColumn));

    bool hasInactivationForcing = Model.HasActiveInactivePair && Model.ActiveColumn is not null && inactivationTriggerColumns.Count > 0;
    string InactivatedLiteral(ColumnModel c) => c.Name.Contains("Inactive", StringComparison.OrdinalIgnoreCase) ? "1" : "0";

    string VarCharLength(ColumnModel c)
    {
        if (c.IsStringColumn && c.MaxLength.HasValue && c.MaxLength.Value > 0)
            return c.MaxLength.Value.ToString();
        if (c.IsDateColumn)
            return "40";
        if (c.IsMoneyColumn || c.IsNumericColumn)
            return "38";
        if (c.IsBooleanColumn)
            return "1";
        return "20"; // int / guid / fallback
    }
#>
CREATE OR ALTER PROCEDURE [<#= Model.SchemaName #>].[<#= Model.TableName #>_Update]
(
<#
    for (int i = 0; i < updatableColumns.Count; i++)
    {
        var c = updatableColumns[i];
        string comma = (i < updatableColumns.Count - 1) ? "," : "";
#>
<#= c.ParameterName #> VarChar(<#= VarCharLength(c) #>) = NULL<#= comma #>
<#
    }
#>
)
AS
	DECLARE @strUpdate varchar(8000);
	DECLARE @strSetStatement varchar(8000);

	DECLARE @lngReturn int;
	SET @strSetStatement = '';
<#
    foreach (var adc in autoTouchedOnUpdateColumns)
    {
#>
	SET @strSetStatement = @strSetStatement + ' [<#= adc.Name #>] = GETDATE(),';
<#
    }
#>

<#
    if (Model.HasStartEndDatePair && Model.StartDateColumn is not null && Model.EndDateColumn is not null)
    {
        var startCol = Model.StartDateColumn;
        var endCol = Model.EndDateColumn;
#>
	IF (<#= startCol.ParameterName #> IS NOT NULL AND <#= endCol.ParameterName #> IS NOT NULL
	    AND CAST(<#= startCol.ParameterName #> AS DATETIME) > CAST(<#= endCol.ParameterName #> AS DATETIME))
	BEGIN
		RAISERROR('[<#= startCol.Name #>] must not be later than [<#= endCol.Name #>].', 16, 1);
		RETURN 0;
	END
<#
    }
    if (Model.HasInOutDateTimePair && Model.InDateColumn is not null && Model.InTimeColumn is not null && Model.OutDateColumn is not null && Model.OutTimeColumn is not null)
    {
        var inDate = Model.InDateColumn;
        var inTime = Model.InTimeColumn;
        var outDate = Model.OutDateColumn;
        var outTime = Model.OutTimeColumn;
#>
	IF (<#= inDate.ParameterName #> IS NOT NULL AND <#= inTime.ParameterName #> IS NOT NULL AND <#= outDate.ParameterName #> IS NOT NULL AND <#= outTime.ParameterName #> IS NOT NULL
	    AND (CAST(<#= inDate.ParameterName #> AS DATETIME) > CAST(<#= outDate.ParameterName #> AS DATETIME)
	         OR (CAST(<#= inDate.ParameterName #> AS DATETIME) = CAST(<#= outDate.ParameterName #> AS DATETIME)
	             AND CAST(<#= inTime.ParameterName #> AS TIME) > CAST(<#= outTime.ParameterName #> AS TIME))))
	BEGIN
		RAISERROR('[<#= inDate.Name #>]/[<#= inTime.Name #>] must not be later than [<#= outDate.Name #>]/[<#= outTime.Name #>].', 16, 1);
		RETURN 0;
	END
<#
    }
#>

<#
    var pkCheckColumn = Model.PrimaryKeyColumns.First();
#>
	IF <#= pkCheckColumn.ParameterName #> IS NOT NULL
	BEGIN
	    SET @strUpdate = 'UPDATE [<#= Model.TableName #>] SET ';
<#
    foreach (var c in setClauseColumns)
    {
        if (c.IsStringColumn)
        {
#>
	    IF <#= c.ParameterName #> IS NOT NULL
	        SET @strSetStatement = @strSetStatement + ' [<#= c.Name #>] = ''' + REPLACE(RTRIM(LTRIM(<#= c.ParameterName #>)), '''', '''''') + ''',';
<#
        }
        else
        {
#>
	    IF <#= c.ParameterName #> IS NOT NULL
	        SET @strSetStatement = @strSetStatement + ' [<#= c.Name #>] = ''' + <#= c.ParameterName #> + ''',';
<#
        }
    }
#>
<#
    if (Model.HasActiveInactivePair && Model.ActiveColumn is not null)
    {
        var activeCol = Model.ActiveColumn;
        bool activeColIsString = activeCol.IsStringColumn;
        string ownValueExpression = activeColIsString
            ? $"REPLACE(RTRIM(LTRIM({activeCol.ParameterName})), '''', '''''')"
            : activeCol.ParameterName;
        if (hasInactivationForcing)
        {
            string triggerCondition = string.Join(" OR ", inactivationTriggerColumns.Select(c => $"{c.ParameterName} IS NOT NULL"));
#>
	    IF <#= triggerCondition #>
	        SET @strSetStatement = @strSetStatement + ' [<#= activeCol.Name #>] = ''<#= InactivatedLiteral(activeCol) #>'',';
	    ELSE IF <#= activeCol.ParameterName #> IS NOT NULL
	        SET @strSetStatement = @strSetStatement + ' [<#= activeCol.Name #>] = ''' + <#= ownValueExpression #> + ''',';
<#
        }
        else
        {
#>
	    IF <#= activeCol.ParameterName #> IS NOT NULL
	        SET @strSetStatement = @strSetStatement + ' [<#= activeCol.Name #>] = ''' + <#= ownValueExpression #> + ''',';
<#
        }
    }
#>
	    IF LEN(@strSetStatement) > 0
	    BEGIN
	        IF RIGHT(@strSetStatement, 1) = ','
	            SET @strSetStatement = LEFT(@strSetStatement, LEN(@strSetStatement) - 1);

	        SET @strUpdate = @strUpdate + @strSetStatement + ' WHERE (<#= string.Join(" AND ", Model.PrimaryKeyColumns.Select(pk => $"[{pk.Name}] = ' + {pk.ParameterName} + '")) #>)';
	        EXEC (@strUpdate);

	        IF @@ERROR = 0
	            SELECT @lngReturn = 1;
	        ELSE
	            SELECT @lngReturn = 0;
	    END
	END
RETURN IsNull(@lngReturn, 0);
