# Restriction checkboxes for CS_Validator_v1.tt (see Docs/specs.md section 5.3).
# The validator is for the entity class, which needs a key.
RequiresPrimaryKey=true
TableOnly=true
# Name the file like the class: Customer -> CustomerValidator.cs
OutputName={Table}Validator.cs
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso.
Stacks=Api
PlanTables=Entity
OutputFolder=Validators
InPlan=false
