<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // MD_Erd_v1.tt
    // Generates: ErDiagram.md   (one file for the whole database)
    // An entity-relationship diagram of every table in Mermaid's erDiagram syntax inside a Markdown file: GitHub, GitLab, Visual Studio Code and most documentation sites draw it. Each table lists its
    // columns (type, name, PK / FK / UK) and each foreign key is one relationship line, labelled with the foreign-key columns: the parent is "exactly one" and the child "zero or many" (a NULL-able
    // foreign key makes the parent "zero or one"). A foreign key that points at a table outside this database is left out.
    // A database of a few hundred tables makes a diagram nobody can read: set ErdTables (a comma-separated list) to draw only those tables and the relationships among them.
    // Full notes: Docs/TemplateNotes/MD_Erd_v1.md
    // ==========================================================================================

    var wanted = Project.ErdTables;
    var tables = Database.Tables
        .Where(t => wanted.Length == 0 || wanted.Contains(t.TableName, StringComparer.OrdinalIgnoreCase))
        .OrderBy(t => t.TableName, StringComparer.OrdinalIgnoreCase).ToList();
    var drawn = tables.Select(t => t.TableName).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var unknown = wanted.Where(w => !Database.Tables.Any(t => t.TableName.Equals(w, StringComparison.OrdinalIgnoreCase))).ToList();

    if (unknown.Count > 0)
    {
        Error("ErdTables names " + string.Join(", ", unknown) + ", which " + (unknown.Count == 1 ? "is" : "are") + " not in this database.");
    }
    else if (tables.Count == 0)
    {
        Error("The database has no table to draw.");
    }
    else
    {
        // Mermaid names are words; anything else is quoted
        string Name(string name) => Regex.IsMatch(name, "^[A-Za-z_][A-Za-z0-9_-]*$") ? name : "\"" + name.Replace("\"", "'") + "\"";
        // a type is one word: no spaces, and the length stays out ("nvarchar(50)" is "nvarchar")
        string Type(ColumnModel c) => Regex.Replace(Regex.Replace(c.SqlTypeDeclaration, @"\(.*\)", ""), @"[^A-Za-z0-9_\[\]-]", "_").Trim('_') is { Length: > 0 } t ? t : "unknown";
        string line = new string((char)45, 2);   // the two hyphens of a Mermaid relationship
        string AttributeName(string name) => Regex.Replace(name, @"[^A-Za-z0-9_-]", "_");

        var o = new StringBuilder();
        void L(string s = "") => o.Append(s).Append('\n');

        L("# Entity relationship diagram");
        L();
        L("`" + Database.DatabaseName + "`: " + tables.Count + " table" + (tables.Count == 1 ? "" : "s") + (wanted.Length > 0 ? " (the project's ErdTables)" : "") + ".");
        L();
        L("```mermaid");
        L("erDiagram");
        foreach (var table in tables)
        {
            foreach (var fk in table.ForeignKeys.Where(f => drawn.Contains(f.ReferencedTable)))
            {
                bool optional = fk.ReferencingColumns.All(name => table.Columns.FirstOrDefault(c => c.Name.Equals(name, StringComparison.OrdinalIgnoreCase))?.IsNullable ?? false);
                L("    " + Name(fk.ReferencedTable) + (optional ? " |o" + line + "o{ " : " ||" + line + "o{ ") + Name(table.TableName) + " : \"" + string.Join(", ", fk.ReferencingColumns).Replace("\"", "'") + "\"");
            }
        }
        foreach (var table in tables)
        {
            var fkColumns = table.ForeignKeys.SelectMany(f => f.ReferencingColumns).ToHashSet(StringComparer.OrdinalIgnoreCase);
            L("    " + Name(table.TableName) + " {");
            foreach (var c in table.Columns.OrderBy(c => c.OrdinalPosition))
            {
                var roles = new List<string>();
                if (c.IsPrimaryKey)
                    roles.Add("PK");
                if (fkColumns.Contains(c.Name))
                    roles.Add("FK");
                if (c.IsInUniqueIndex && !c.IsPrimaryKey)
                    roles.Add("UK");
                L("        " + Type(c) + " " + AttributeName(c.Name) + (roles.Count > 0 ? " " + string.Join(",", roles) : "") + (c.IsNullable ? " \"null\"" : ""));
            }
            L("    }");
        }
        L("```");
        Write("@@@FILE ErDiagram.md@@@\n" + o.ToString());
    }
#>
