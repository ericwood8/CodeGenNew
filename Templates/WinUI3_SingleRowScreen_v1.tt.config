# Restriction checkboxes for WinUI3_SingleRowScreen_v1.tt (see Docs/Reference.md section 3).
Requires=PrimaryKey,SingleKey,NotNameActive
# The page reads the same <Table>DetailViewModel as the dialog (WinUI3_DetailScreen), and its drop-downs show the parent table's display column, so ask for it.
NeedsReferencedDisplayColumns=true
# No OutputName: the template writes its own paths (Views/...) with @@@FILE markers.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=WinUI3
PlanTables=SingleRowScreen
