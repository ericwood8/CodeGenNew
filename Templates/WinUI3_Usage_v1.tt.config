# Restriction checkboxes for WinUI3_Usage_v1.tt (see Docs/Reference.md section 3).
# One set of files for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# No OutputName: the template writes its own paths with @@@FILE markers.
# Whole-project generation (codegen generate): written only for a project with Auth=true, ApiAuth, TenantTable and UsageTables.
Stacks=WinUI3
InPlan=false
