<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string componentsFolder = Project.ComponentsFolder;
    string apiFolder = Project.ApiFolder;
    string apiPrefix = "/api";
    // ==========================================================================================

    // ==========================================================================================
    // TSX_JunctionPage_v1.tt
    // Generates: components/<Table>Junction.tsx plus components/__tests__/<Table>Junction.test.tsx   (point the output folder at the React src folder)
    // A reusable function component with the two-list available/selected shuttle for a many-to-many junction table, calling the routes API_Junction writes.
    // Needs a table detected as a junction table (TableModel.IsJunctionTable).
    // Full notes: Docs/TemplateNotes/TSX_JunctionPage_v1.md
    // ==========================================================================================


    if (!Model.IsJunctionTable)
        Error($"TSX_JunctionPage cannot generate from [{Model.SchemaName}].[{Model.TableName}]: it is not a many-to-many junction table - TableModel.IsJunctionTable is false.");
    if (!Model.HasReferencedDisplayColumns)
        Error("TSX_JunctionPage needs the target table's display columns; its .tt.config must say NeedsReferencedDisplayColumns=true.");

    var junction = Model.Junction!;   // the anchor and target sides, in Core
    string anchorTs = junction.AnchorTs;
    string targetTs = junction.TargetTs;
    string targetRole = junction.TargetRole;

    string baseName = BaseName(Model.TableName);
    string stem = baseName.ToLowerInvariant();
    string cls = baseName + "Junction";
    string itemType = baseName + "JunctionItem";
    var displayColumns = junction.DisplayColumns.Select(LowerFirst).ToList(); // camelCase, matching TS_Model's JSON-casing convention
    string ToSelectionId = targetTs == "string" ? "o.value" : "Number(o.value)";

    var ts = new StringBuilder();
    void T(string s = "") => ts.Append(s).Append('\n');

    // ================= imports + item type
    T("import { useEffect, useState } from 'react';");
    T($"import {{ request }} from '../{apiFolder}/client';");
    T();
    T($"export interface {itemType} {{");
    T($"  targetId: {targetTs};");
    T("  isSelected: boolean;");
    foreach (string d in displayColumns)
        T($"  {d}?: string;");
    T("}");
    T();
    T($"export function {cls}({{ anchorId }}: {{ anchorId: {anchorTs} }}) {{");
    T($"  const [available, setAvailable] = useState<{itemType}[]>([]);");
    T($"  const [selected, setSelected] = useState<{itemType}[]>([]);");
    T($"  const [availableSelectionIds, setAvailableSelectionIds] = useState<{targetTs}[]>([]);");
    T($"  const [selectedSelectionIds, setSelectedSelectionIds] = useState<{targetTs}[]>([]);");
    T();
    T($"  const apiUrl = '{apiPrefix}/{stem.Pluralize()}/junction';");
    T();
    T("  const load = () => {");
    T($"    request<{itemType}[]>(`${{apiUrl}}/${{anchorId}}`).then((rows) => {{");
    T("      setAvailable(rows.filter((r) => !r.isSelected));");
    T("      setSelected(rows.filter((r) => r.isSelected));");
    T("    });");
    T("  };");
    T();
    T("  useEffect(() => {");
    T("    load();");
    T("  }, [anchorId]);");
    T();
    T($"  const displayText = (item: {itemType}): string =>");
    T($"    [{string.Join(", ", displayColumns.Select(d => $"item.{d}"))}].filter((v) => !!v).join(' ');");
    T();
    T($"  const link = (items: {itemType}[]) => {{");
    T("    for (const item of items) {");
    T("      void request(`${apiUrl}/link`, { method: 'POST', body: JSON.stringify({ anchorId, targetId: item.targetId }) }).then(() => {");
    T("        setAvailable((prev) => prev.filter((r) => r !== item));");
    T("        setSelected((prev) => [...prev, item]);");
    T("      });");
    T("    }");
    T("    setAvailableSelectionIds([]);");
    T("  };");
    T();
    T($"  const unlink = (items: {itemType}[]) => {{");
    T("    for (const item of items) {");
    T("      void request(`${apiUrl}/unlink`, { method: 'POST', body: JSON.stringify({ anchorId, targetId: item.targetId }) }).then(() => {");
    T("        setSelected((prev) => prev.filter((r) => r !== item));");
    T("        setAvailable((prev) => [...prev, item]);");
    T("      });");
    T("    }");
    T("    setSelectedSelectionIds([]);");
    T("  };");
    T();
    T("  const addSelected = () => link(available.filter((r) => availableSelectionIds.includes(r.targetId)));");
    T("  const addAll = () => link(available);");
    T("  const removeSelected = () => unlink(selected.filter((r) => selectedSelectionIds.includes(r.targetId)));");
    T("  const removeAll = () => unlink(selected);");
    T();
    T("  // outer line round each list, a line under every row, and the buttons on a shaded bar");
    T("  const listStyle = { minWidth: 200, border: '1px solid #8886' };");
    T("  const rowStyle = { padding: '4px 6px', borderBottom: '1px solid #8884' };");
    T("  const barStyle = { display: 'flex', flexDirection: 'column' as const, gap: 8, padding: 8, background: '#8883', border: '1px solid #8886', borderRadius: 4 };");
    T();
    T("  return (");
    T("    <div>");
    T($"      <h1>{targetRole}</h1>");
    T("      <div style={{ display: 'flex', gap: 12, alignItems: 'center' }}>");
    T("        <div>");
    T("          <label>Available</label>");
    T("          <select");
    T("            multiple");
    T("            size={10}");
    T("            style={listStyle}");
    T("            value={availableSelectionIds.map(String)}");
    T($"            onChange={{(event) => setAvailableSelectionIds(Array.from(event.target.selectedOptions, (o) => {ToSelectionId}))}}");
    T("          >");
    T("            {available.map((item) => (");
    T("              <option key={item.targetId} value={item.targetId} style={rowStyle}>{displayText(item)}</option>");
    T("            ))}");
    T("          </select>");
    T("        </div>");
    T("        <div style={barStyle}>");
    T("          <button type=\"button\" onClick={addAll} style={{ fontWeight: 700 }} title=\"Add all\">&gt;&gt;</button>");
    T("          <button type=\"button\" onClick={addSelected} style={{ fontWeight: 700 }} title=\"Add selected\">&gt;</button>");
    T("          <button type=\"button\" onClick={removeSelected} style={{ fontWeight: 700 }} title=\"Remove selected\">&lt;</button>");
    T("          <button type=\"button\" onClick={removeAll} style={{ fontWeight: 700 }} title=\"Remove all\">&lt;&lt;</button>");
    T("        </div>");
    T("        <div>");
    T("          <label>Selected</label>");
    T("          <select");
    T("            multiple");
    T("            size={10}");
    T("            style={listStyle}");
    T("            value={selectedSelectionIds.map(String)}");
    T($"            onChange={{(event) => setSelectedSelectionIds(Array.from(event.target.selectedOptions, (o) => {ToSelectionId}))}}");
    T("          >");
    T("            {selected.map((item) => (");
    T("              <option key={item.targetId} value={item.targetId} style={rowStyle}>{displayText(item)}</option>");
    T("            ))}");
    T("          </select>");
    T("        </div>");
    T("      </div>");
    T("    </div>");
    T("  );");
    T("}");

    // ================= test
    var test = new StringBuilder();
    void S(string s = "") => test.Append(s).Append('\n');
    S("import { render, screen } from '@testing-library/react';");
    S("import { describe, expect, it } from 'vitest';");
    S($"import {{ {cls} }} from '../{cls}';");
    S();
    S($"describe('{cls}', () => {{");
    S($"  it('renders the {targetRole} heading', async () => {{");
    S($"    render(<{cls} anchorId={{{(anchorTs == "string" ? "'00000000-0000-0000-0000-000000000000'" : "0")}}} />);");
    S($"    expect(await screen.findByText('{targetRole}')).toBeInTheDocument();");
    S("  });");
    S("});");

    var o = new StringBuilder();
    o.Append($"@@@FILE {componentsFolder}/{cls}.tsx@@@\n").Append(ts);
    o.Append($"@@@FILE {componentsFolder}/__tests__/{cls}.test.tsx@@@\n").Append(test);

    // The page the menu opens (JunctionPlan in Core): a drop-down of the anchor's rows and the shuttle for the row picked.
    if (JunctionPlan.HasPage(Model, Project))
    {
        string pagesFolder = Project.PagesFolder;
        string page = JunctionPlan.ReactPage(Model.TableName);
        string anchorLabel = Labels.Words(BaseName(junction.AnchorRole));
        var pg = new StringBuilder();
        void P(string s = "") => pg.Append(s).Append('\n');
        P("import { useEffect, useState } from 'react';");
        P($"import {{ request }} from '../{apiFolder}/client';");
        P($"import {{ {cls} }} from '../{componentsFolder}/{cls}';");
        P();
        P($"type Anchor = {{ id: {anchorTs}; name: string }};");
        P();
        P($"export function {page}() {{");
        P("  const [anchors, setAnchors] = useState<Anchor[]>([]);");
        P("  const [anchorId, setAnchorId] = useState('');");
        P("  const [error, setError] = useState<string | null>(null);");
        P();
        P("  useEffect(() => {");
        P($"    request<Anchor[]>('{JunctionPlan.AnchorLookupRoute(Model)}').then(setAnchors).catch(() => setError('Failed to load the {anchorLabel.ToLowerInvariant().Pluralize()}.'));");
        P("  }, []);");
        P();
        P("  return (");
        P("    <div className=\"rail\">");
        P($"      <h1>{JunctionPlan.Heading(Model)}</h1>");
        P($"      <label>{anchorLabel} <select aria-label=\"{anchorLabel}\" value={{anchorId}} onChange={{(event) => setAnchorId(event.target.value)}}>");
        P($"        <option value=\"\">Choose a {anchorLabel.ToLowerInvariant()}</option>");
        P("        {anchors.map((a) => <option key={a.id} value={a.id}>{a.name}</option>)}");
        P("      </select></label>");
        P("      {error && <p role=\"alert\">{error}</p>}");
        P($"      {{anchorId !== '' && <{cls} key={{anchorId}} anchorId={{{(anchorTs == "string" ? "anchorId" : "Number(anchorId)")}}} />}}");
        P("    </div>");
        P("  );");
        P("}");
        var pgTest = new StringBuilder();
        void Q(string s = "") => pgTest.Append(s).Append('\n');
        Q("import { render, screen } from '@testing-library/react';");
        Q("import { describe, expect, it } from 'vitest';");
        Q($"import {{ {page} }} from '../{page}';");
        Q();
        Q($"describe('{page}', () => {{");
        Q("  it('asks for an anchor row before it shows the lists', async () => {");
        Q($"    render(<{page} />);");
        Q($"    expect(await screen.findByText('{JunctionPlan.Heading(Model)}')).toBeInTheDocument();");
        Q($"    expect(screen.getByRole('combobox', {{ name: '{anchorLabel}' }})).toBeInTheDocument();");
        Q($"    expect(screen.queryByText('Available')).not.toBeInTheDocument();");
        Q("  });");
        Q("});");
        o.Append($"@@@FILE {pagesFolder}/{page}.tsx@@@\n").Append(pg);
        o.Append($"@@@FILE {pagesFolder}/__tests__/{page}.test.tsx@@@\n").Append(pgTest);
    }
    Write(o.ToString());
#>
