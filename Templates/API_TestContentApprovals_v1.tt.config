# Restriction checkboxes for API_TestContentApprovals_v1.tt (see Docs/Reference.md section 3).
# One run for the whole database: the test class of each content table that needs approval.
Scope=Database
# Whole-project generation (codegen generate): added by ApiTests=true when a ContentTables table is also in RowApprovals. The files go to the test project, not the API.
Stacks=Api
OutputRoot=ApiTests
InPlan=false
