# Restriction checkboxes for WinUI3_EssentialMainWindow_v1.tt (see Docs/specs.md section 5.3).
# One of the files every WinUI 3 app needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=WinUI3
EssentialsGroup=MainWindow
Description=MainWindow.xaml and MainWindow.xaml.cs: the navigation view, the shared context and the page switch (MainWindow.Screens.cs is the other half)
Needs=MainWindow.Screens.cs,Data/{Context}.cs
