# Restriction checkboxes for RS_EssentialCargo_v1.tt (see Docs/Reference.md section 3).
# One of the files every Rust API needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Rust
EssentialsGroup=Cargo
Description=Cargo.toml (the pinned dependencies and the sqlx features of the database), .env.example and .gitignore
