# Restriction checkboxes for SP_KeySequence_v1.tt (see Docs/Reference.md section 3).
# One script for the whole database: the table that holds the sequence and the GetNextID routine; the menu offers it on the database, the CLI runs it without -t.
DatabaseOnly=true
RequiresPrimaryKey=false
TableOnly=false
# No OutputName: the template writes its own path (KeySequence.sql) with an @@@FILE marker.
# Whole-project generation (codegen generate): only for a project that names the tables in PlanAlso (and KeySequenceTables).
Stacks=Api,WinUI3
OutputRoot=Sql
InPlan=false
Dialects=SqlServer
