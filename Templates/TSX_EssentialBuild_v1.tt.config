# Restriction checkboxes for TSX_EssentialBuild_v1.tt (see Docs/Reference.md section 3).
# One of the files every React app needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=React
EssentialsGroup=Build
Description=package.json, vite.config.ts (the /api proxy, the ports) and tsconfig.json
