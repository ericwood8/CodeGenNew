<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    // Folders under the React app's src folder (where -o points) that the generated files go in.
    string apiFolder = Project.ApiFolder;
    string modelsFolder = Project.ModelsFolder;
    string apiPrefix = "/api";
    // ==========================================================================================

    // ==========================================================================================
    // TSX_Api_v1.tt
    // Generates: api/<table>Api.ts   (a plain object of fetch-based functions; the path is written by the template, point the output folder at the React src folder)
    // The React counterpart of TS_Service: getAll, getPage (search and paging), getById, create, update, delete and, for a cloneable table, clone.
    // Needs the shared request helper and ApiError in api/client.ts (not generated). Imports the model from models/<table> (TS_Model).
    // Folder names come from the project's ApiFolder and ModelsFolder.
    // Full notes: Docs/TemplateNotes/TSX_Api_v1.md
    // ==========================================================================================


    var keyColumn = Model.PrimaryKeyColumns.Count == 1 ? Model.PrimaryKeyColumns[0] : null;
    var keyType = KeyType.Of(Model);   // how the key travels: a number, or a string for a uniqueidentifier or a text key
    if (Project.NoApiFor(Model.TableName, Model.LookupShape))
    {
        Error($"TSX_Api writes no api module for [{Model.SchemaName}].[{Model.TableName}]: it is an enum or excluded by the NoApiTables setting (an enum, a *Type lookup table, or a table with no entity class), so it has no API to call.");
    }
    else if (keyColumn is null || keyType is null)
    {
        Error($"TSX_Api needs a table with a single int, uniqueidentifier or text primary key (the routes take the id as {{id:int}}, {{id:guid}} or {{id}}), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else
    {
        string baseName = BaseName(Model.TableName);
        bool nameActive = Model.IsNameActiveTable;   // its API (NameActiveCrudApi) answers the whole list, the active rows, a lookup and find by name; no paging, no search, no clone
        string keyTs = keyType.TypeScript;   // a uniqueidentifier or text key travels as a string
        // A text key can hold characters a route treats as its own (a space, a slash, a question mark): it is encoded into the path.
        string keyPath = keyType.Kind == KeyKind.Text ? "${encodeURIComponent(id)}" : "${id}";
        string stem = baseName.ToLowerInvariant();
        string variable = LowerFirst(baseName);
        // Pagination: getPage always exists, once SP_Search.tt/API_Search.tt do; pagination and searchability are separate concerns.
        // Search: filters is simply empty for a table with no searchable column.
        // ListProtocol=Search: one search box, so one filter (the server decides which columns it matches); the answer { data, count } is turned into the same paged result
        bool listSearch = Project.ListSearchProtocol;
        var filters = listSearch
            ? new[] { new { ParamName = "search", Name = "search" } }.ToList()
            : Model.SearchableColumns.Concat(Model.SearchKeyColumns).Select(c => new { ParamName = LowerFirst(c.Name), c.Name }).ToList();   // the text boxes, then the key drop-downs (the page sends the key as text)
        // a table in LogTables also takes the first and the last day of the rows to list (the page sends them as yyyy-MM-dd text)
        if (!listSearch && LogTablePlan.For(Model, Project) is not null)
            filters.AddRange(new[] { new { ParamName = LogTable.FromParameter, Name = LogTable.FromParameter }, new { ParamName = LogTable.ToParameter, Name = LogTable.ToParameter } });

        var o = new StringBuilder();
        void L(string s = "") => o.Append(s).Append('\n');

        L($"@@@FILE {apiFolder}/{stem}Api.ts@@@");
        L("import { lookupQuery, request } from './client';");
        L($"import type {{ {baseName} }} from '../{modelsFolder}/{stem}';");
        L();
        L($"const apiUrl = '{apiPrefix}/{stem.Pluralize()}';");
        L();
        if (!nameActive)
        {
            L($"export interface {baseName}PagedResult {{");
            L($"  items: {baseName}[];");
            L("  page: number;");
            L("  pageSize: number;");
            L("  totalCount: number;");
            L("  totalPages: number;");
            L("}");
            L();
        }
        L($"export const {variable}Api = {{");
        L($"  getAll: () => request<{baseName}[]>(apiUrl),");
        L();
        if (nameActive)
        {
            L($"  getActive: () => request<{baseName}[]>(`${{apiUrl}}/active`),");
            L();
        }
        // the drop-downs of the screens that look this table up read just the key, the text to show and the active flag
        // with a query only the rows that match: the text a person typed in a type-ahead, or the keys whose names a page shows
        L($"  getLookup: (query: {{ search?: string; ids?: {keyTs}[]; take?: number }} = {{}}) => request<{{ id: {keyTs}; name: string; isActive?: boolean | null }}[]>(`${{apiUrl}}/lookup${{lookupQuery(query)}}`),");
        L();
        L($"  getById: (id: {keyTs}) => request<{baseName}>(`${{apiUrl}}/{keyPath}`),");
        L();
        string row = variable == "request" ? "row" : variable;   // a table called Request must not hide the request() helper behind its own parameter
        L($"  create: ({row}: {baseName}) => request<{baseName}>(apiUrl, {{ method: 'POST', body: JSON.stringify({row}) }}),");
        L();
        L($"  update: (id: {keyTs}, {row}: {baseName}) => request<{baseName}>(`${{apiUrl}}/{keyPath}`, {{ method: 'PUT', body: JSON.stringify({row}) }}),");
        L();
        L($"  delete: (id: {keyTs}) => request<void>(`${{apiUrl}}/{keyPath}`, {{ method: 'DELETE' }}),");
        // clone(id): copy a row into a new one and get the copy back (POST <route>/{id}/clone, API_Crud); only for the tables CloneShape says can be cloned.
        if (CloneShape.CanClone(Model, Project))
        {
            L();
            L($"  clone: (id: {keyTs}) => request<{baseName}>(`${{apiUrl}}/{keyPath}/clone`, {{ method: 'POST' }}),");
        }
        if (GatePlan.GuardsOf(Project, Model).Count > 0)
        {
            L();
            L("  // Which guarded columns the signed-in person may change (the screen shows the others as text), by the column's JSON name");
            L("  getGuards: () => request<Record<string, boolean>>(`${apiUrl}/guards`),");
        }
        if (Model.CanFindByName)
        {
            L();
            L($"  findByName: (name: string) => request<{baseName}[]>(`${{apiUrl}}/${{name}}`),");
        }
        if (!nameActive)
        {
            string filterType = filters.Count > 0 ? string.Join("; ", filters.Select(f => $"{f.ParamName}?: string")) : "";
            L();
            // A table with no searchable column never reads the argument; the leading underscore keeps a project that compiles with
            // noUnusedParameters (the Vite template's default) from failing on it.
            string filtersName = filters.Count > 0 ? "filters" : "_filters";
            // sort: the grid's chosen sort (a column name and a direction); left out of the request when there is none (the default order).
            L($"  getPage: (pageNumber: number, pageSize: number, {filtersName}: {{{(filterType.Length > 0 ? " " + filterType + " " : "")}}} = {{}}, sort: {{ column: string; descending: boolean }} | null = null) => {{");
            L("    const params = new URLSearchParams();");
            if (listSearch)
            {
                L($"    params.set('{Project.PageParameter}', String(pageNumber{(Project.PageBase == 0 ? " - 1" : "")}));");
                L($"    params.set('{Project.PageSizeParameter}', String(pageSize));");
                L($"    if (filters.search) params.set('{Project.SearchParameter}', filters.search);");
                L("    if (sort) {");
                L($"      params.set('{Project.SortParameter}', sort.column + (sort.descending ? ':desc' : ':asc'));");
                L("    }");
                L("    return request<Record<string, unknown>>(`${apiUrl}?${params.toString()}`).then((body) => {");
                L($"      const items = (body['{Project.ItemsMember}'] as {baseName}[] | undefined) ?? [];");
                L($"      const totalCount = Number(body['{Project.TotalMember}'] ?? 0);");
                L("      return { items, page: pageNumber, pageSize, totalCount, totalPages: totalCount === 0 ? 0 : Math.ceil(totalCount / pageSize) };");
                L("    });");
                L("  },");
            }
            else
            {
                L("    params.set('pageNumber', String(pageNumber));");
                L("    params.set('pageSize', String(pageSize));");
                foreach (var f in filters)
                    L($"    if (filters.{f.ParamName}) params.set('{f.ParamName}', filters.{f.ParamName});");
                L("    if (sort) {");
                L("      params.set('sortBy', sort.column);");
                L("      params.set('sortDir', sort.descending ? 'desc' : 'asc');");
                L("    }");
                L($"    return request<{baseName}PagedResult>(`${{apiUrl}}/search?${{params.toString()}}`);");
                L("  },");
            }
        }
        L("};");
        Write(o.ToString());
    }
#>
