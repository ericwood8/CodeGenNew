# Restriction checkboxes for RS_Test_v1.tt (see Docs/Reference.md section 3).
# The routes are keyed by the primary key, so one single-column int, uniqueidentifier or text key is required.
Requires=PrimaryKey,SingleKey,NotNameActive
# A name/active table's repository is hand-maintained; it gets no generated API.
# The sample bodies point a foreign key at the first row of the parent's API.
NeedsReferencedDisplayColumns=true
# The Rust stack reads PostgreSQL, MySQL and SQLite through sqlx; SQL Server is not supported.
Dialects=PostgreSql,MySql,Sqlite
# No OutputName: the template writes its own path (tests/api/<table>.rs) with an @@@FILE marker.
# Whole-project generation (codegen generate): for a project that sets RustTests=true (or names the template in PlanAlso).
Stacks=Rust
PlanTables=CrudApi
InPlan=false
