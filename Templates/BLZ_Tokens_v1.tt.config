# Restriction checkboxes for BLZ_Tokens_v1.tt (see Docs/Reference.md section 3).
# One page for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# No OutputName: the template writes its own path (Pages/<Table>Tokens.razor) with an @@@FILE marker.
# Whole-project generation (codegen generate): written only for a project with Auth=true, ApiAuth, TokenTables.
Stacks=Blazor
InPlan=false
