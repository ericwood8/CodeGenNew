# Restriction checkboxes for MD_Postman_v1.tt (see Docs/Reference.md section 3).
# One collection for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# No OutputName: the template writes its own path (<ProjectName>.postman_collection.json) with an @@@FILE marker.
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso.
Stacks=Api
OutputFolder=collections
InPlan=false
