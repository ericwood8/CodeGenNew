# Restriction checkboxes for RS_Queue_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# The template writes its own path (src/routes/queue.rs) with an @@@FILE marker.
OutputName=src/routes/queue.rs
# Whole-project generation (codegen generate): written only for a project with QueueTables.
Stacks=Rust
InPlan=false
