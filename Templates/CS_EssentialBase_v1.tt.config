# Restriction checkboxes for CS_EssentialBase_v1.tt (see Docs/specs.md section 5.3).
# One of the files every app of a stack needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Api,WinUI3
EssentialsGroup=BaseClasses
Description=BaseEntity, IGenericRepo and GenericRepo: the base classes the generated entities and repositories derive from
Needs=Data/{Context}.cs
