# Restriction checkboxes for TSX_LogPage_v1.tt (see Docs/Reference.md section 3).
# The rows are listed by their primary key, taken as {id:int}, so one is required; the table must be listed in LogTables or the template writes nothing.
Requires=PrimaryKey,SingleKey
# The drop-downs for foreign keys show the parent table's display column, so ask for it.
NeedsReferencedDisplayColumns=true
# No OutputName: the template writes its own paths (pages/<Table>Page.tsx, pages/__tests__/...) with @@@FILE markers.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=React
PlanTables=ScreenForm
OutputFolder=src
