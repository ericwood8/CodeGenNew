# Restriction checkboxes for RS_UserDirectory_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t. In a whole-project plan it runs only with ApiAuth=true and UserTable=<table>.
DatabaseOnly=true
RequiresPrimaryKey=false
TableOnly=false
InPlan=false
# No OutputName: the template writes its own path (src/users.rs) with an @@@FILE marker.
# Whole-project generation (codegen generate): the stacks that include this template.
Stacks=Rust
