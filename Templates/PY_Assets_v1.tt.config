# Restriction checkboxes for PY_Assets_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# The template writes its own path (app/routes/asset_files.py) with an @@@FILE marker.
OutputName=app/routes/asset_files.py
# Whole-project generation (codegen generate): written only for a project with AssetTables.
Stacks=Python
InPlan=false
