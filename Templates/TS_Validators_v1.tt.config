# Restriction checkboxes for TS_Validators_v1.tt (see Docs/Reference.md section 3).
RequiresPrimaryKey=true
TableOnly=true
# No OutputName: the template writes its own path (validators/<table>.validators.ts) with an @@@FILE marker.
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso.
Stacks=Angular
PlanTables=Entity
OutputFolder=src/app
InPlan=false
