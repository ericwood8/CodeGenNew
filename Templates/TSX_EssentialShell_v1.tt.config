# Restriction checkboxes for TSX_EssentialShell_v1.tt (see Docs/specs.md section 5.3).
# One of the files every React app needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=React
EssentialsGroup=Shell
Description=index.html, main.tsx and App.tsx: the page, the router and the menu with its hamburger button
Needs=src/screens.tsx
