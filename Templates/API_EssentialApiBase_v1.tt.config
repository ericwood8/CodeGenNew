# Restriction checkboxes for API_EssentialApiBase_v1.tt (see Docs/Reference.md section 3).
# One of the files every app of a stack needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Api
EssentialsGroup=BaseApi
Description=Apis/BaseApi.cs: the base of the generated API classes (route names, the same plural rule as the TypeScript clients)
