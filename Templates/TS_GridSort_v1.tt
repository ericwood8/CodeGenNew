<#
    // ==========================================================================================
    // TS_GridSort_v1.tt
    // Generates: grid-sort.ts and grid-sort.spec.ts   (point the output folder at the Angular app's src\app folder; the components import it as '../../grid-sort')
    // The shared sort helpers every component imports: the saved sort (browser local storage), the next-sort rule and the client-side row sort the child
    // grids use. One file for the whole project.
    // Full notes: Docs/TemplateNotes/TS_GridSort_v1.md

    Write("@@@FILE grid-sort.ts@@@\n");
