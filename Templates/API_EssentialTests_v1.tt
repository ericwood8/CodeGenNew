<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // API_EssentialTests_v1.tt
    // Generates: <ProjectName>.Api.Tests.csproj, ApiFixture.cs and GlobalUsings.cs   (no table, no database: an essentials group; the output folder is the test project's own folder, OutputApiTests)
    // The project the per-table API_Test classes live in. ApiFixture starts the API in process (WebApplicationFactory) once for the run and hands every test an HttpClient. The database is a scratch
    // copy: for SQLite a temporary copy of the database file (the file is never written), for the others the connection string in <PROJECT>_TEST_CONNECTION, and with neither the tests report
    // themselves as inconclusive. With ApiTestContainers=true and a PostgreSQL, MySQL or SQL Server database the fixture starts a throwaway container of that database (Testcontainers, Docker must run)
    // when the variable is not set, fills it from the ApiTestSchema scripts and removes it at the end. Writes nothing unless the project sets ApiTests=true.
    // Settings: ApiTests, ApiTestContainers, ApiTestSchema, OutputApiTests, OutputApi, DatabaseProvider, DatabaseName.
    // Full notes: Docs/TemplateNotes/API_Test_v1.md
    // ==========================================================================================
    if (Project.ApiTests)
    {
        string projectName = Project.ProjectName ?? "MyApp";
        string testsFolder = Project.OutputFolderOf("apitests");
        string apiFolder = Project.OutputFolderOf("api");
        string apiPath = Path.GetRelativePath(testsFolder, apiFolder).Replace('\\', '/');
        string variable = new string(projectName.ToUpperInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '_').ToArray()) + "_TEST_CONNECTION";
        bool sqlite = Project.DatabaseDialect == SqlDialect.Sqlite;
        bool containers = Project.ApiTestContainers && !sqlite;
        string containerPackage = Project.DatabaseDialect switch { SqlDialect.PostgreSql => "Testcontainers.PostgreSql", SqlDialect.MySql => "Testcontainers.MySql", _ => "Testcontainers.MsSql" };
        string containerType = Project.DatabaseDialect switch { SqlDialect.PostgreSql => "PostgreSqlContainer", SqlDialect.MySql => "MySqlContainer", _ => "MsSqlContainer" };
        string containerBuild = Project.DatabaseDialect switch
        {
            SqlDialect.PostgreSql => "new PostgreSqlBuilder(\"postgres:17-alpine\").WithDatabase(\"codegen_test\").Build()",
            // no binary log (the option is written in two pieces), so a trigger in the create script can be made without the SUPER privilege
            SqlDialect.MySql => "new MySqlBuilder(\"mysql:8.4\").WithDatabase(\"codegen_test\").WithCommand(\"-\" + \"-skip-log-bin\").Build()",
            _ => "new MsSqlBuilder(\"mcr.microsoft.com/mssql/server:2022-latest\").Build()"
        };
        string containerNamespace = Project.DatabaseDialect switch { SqlDialect.PostgreSql => "PostgreSql", SqlDialect.MySql => "MySql", _ => "MsSql" };
        string[] schema = Project.ApiTestSchema;
        if (containers && schema.Length == 0)
        {
            // no script of the project's own: the create script SP_CreateSchema writes from the catalog, then the routines of the SQL folder when the project uses them
            string sqlPath = Path.GetRelativePath(apiFolder, Project.OutputFolderOf("sql")).Replace('\\', '/');
            schema =Project.AccessModeFor(Project.DatabaseDialect) == AccessMode.Ef ? [sqlPath + "/CreateSchema.sql"] : [sqlPath + "/CreateSchema.sql", sqlPath];
        }
#>
@@@FILE <#= projectName #>.Api.Tests.csproj@@@
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace><#= projectName #>.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
<#
        if (containers)
        {
#>
    <PackageReference Include="<#= containerPackage #>" Version="4.15.0" />
<#
        }
#>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="<#= apiPath #>/<#= projectName #>.Api.csproj" />
  </ItemGroup>

</Project>
@@@FILE GlobalUsings.cs@@@
global using System.Net;
global using System.Net.Http.Json;
global using System.Text.Json.Nodes;
global using Microsoft.VisualStudio.TestTools.UnitTesting;
<#
        if (Project.ApiAuth)
        {
#>
@@@FILE AuthApiTests.cs@@@
namespace <#= projectName #>.Api.Tests;

/// <summary> The sign-in (ApiAuth=true): a right password gives a token, a wrong one is 401, an empty body is 400. </summary>
[TestClass]
public class AuthApiTests
{
    [TestMethod]
    public async Task A_wrong_password_answers_401()
    {
        ApiFixture.RequireDatabase();
        using var anonymous = ApiFixture.Anonymous();
        using var response = await anonymous.PostAsJsonAsync("/api/auth/login", new { userName = "test-admin", password = Guid.NewGuid().ToString("N") });
        Assert.AreEqual(HttpStatusCode.Unauthorized, response.StatusCode);
    }

    [TestMethod]
    public async Task A_blank_user_name_answers_400()
    {
        ApiFixture.RequireDatabase();
        using var anonymous = ApiFixture.Anonymous();
        using var response = await anonymous.PostAsJsonAsync("/api/auth/login", new { userName = "", password = "x" });
        Assert.AreEqual(HttpStatusCode.BadRequest, response.StatusCode);
    }
}
<#
        }
#>
@@@FILE ApiFixture.cs@@@
using Microsoft.AspNetCore.Mvc.Testing;
<#
        if (containers)
        {
#>
using Testcontainers.<#= containerNamespace #>;
<#
        }
#>

namespace <#= projectName #>.Api.Tests;

/// <summary> Starts the API in process once for the whole run, over a scratch database, and gives the tests its client and a few helpers. </summary>
[TestClass]
public static class ApiFixture
{
    private const string ConnectionVariable = "<#= variable #>";
<#
        if (Project.ApiAuth)
        {
#>
    private const string AdminUserName = "test-admin";
    private static string _jwtKey = "";
<#
        }
#>

    private static WebApplicationFactory<Program>? _factory;
<#
        if (sqlite)
        {
#>
    private static string? _scratchFile;
<#
        }
        if (containers)
        {
#>
    private static <#= containerType #>? _container;
    private static string? _containerProblem;

    // the scripts the container is filled from (ApiTestSchema, relative to the API project's folder), applied in this order; a folder means every .sql file in it by name
    private static readonly string[] SchemaScripts = [<#= string.Join(", ", schema.Select(x => ApiSampleValues.Json(x))) #>];
<#
        }
#>

    public static HttpClient Client { get; private set; } = null!;
    public static bool HasDatabase { get; private set; }

    [AssemblyInitialize]
    public static <#= Project.ApiAuth || containers ? "async Task" : "void" #> Start(TestContext context)
    {
        string? connection = Environment.GetEnvironmentVariable(ConnectionVariable);
<#
        if (sqlite)
        {
#>
        if (string.IsNullOrEmpty(connection))
        {
            // the database file is copied and never written: the tests add and remove rows in the copy
            string source = Path.GetFullPath(Path.Combine(ApiFolder(), "<#= Project.DatabaseName #>"));
            if (!File.Exists(source))
                return;
            _scratchFile = Path.Combine(Path.GetTempPath(), "<#= projectName #>_test_" + Guid.NewGuid().ToString("N") + ".db");
            File.Copy(source, _scratchFile);
            connection = "Data Source=" + _scratchFile;
        }
<#
        }
        else if (containers)
        {
#>
        if (string.IsNullOrEmpty(connection))
        {
            connection = await StartContainerAsync();
            if (connection is null)
                return;
        }
<#
        }
        else
        {
#>
        if (string.IsNullOrEmpty(connection))
            return;
<#
        }
#>

        Environment.SetEnvironmentVariable("ConnectionStrings__DbConnectionString", connection);
        Environment.SetEnvironmentVariable("RateLimit__PermitsPerMinute", "1000000");
<#
        if (Project.ApiAuth)
        {
#>
        // ApiAuth: a key and an administrator made for this run only, then a real sign-in; every test's client carries the token
        string password = Guid.NewGuid().ToString("N");
        _jwtKey = Guid.NewGuid().ToString("N") + Guid.NewGuid().ToString("N");
        Environment.SetEnvironmentVariable("Jwt__Key", _jwtKey);
        Environment.SetEnvironmentVariable("Bootstrap__AdminUserName", AdminUserName);
        Environment.SetEnvironmentVariable("Bootstrap__AdminPassword", password);
        _factory = new WebApplicationFactory<Program>();
        Client = _factory.CreateClient();
        var login = await Client.PostAsJsonAsync("/api/auth/login", new { userName = AdminUserName, password });
        login.EnsureSuccessStatusCode();
        string token = (await login.Content.ReadFromJsonAsync<JsonObject>())!["token"]!.GetValue<string>();
        Client.DefaultRequestHeaders.Authorization = new("Bearer", token);
        HasDatabase = true;
<#
        }
        else
        {
#>
        _factory = new WebApplicationFactory<Program>();
        Client = _factory.CreateClient();
        HasDatabase = true;
<#
        }
#>
    }

    [AssemblyCleanup]
    public static void Stop()
    {
        RemoveSeeded();
        Client?.Dispose();
        _factory?.Dispose();
<#
        if (containers)
        {
#>
        _container?.DisposeAsync().AsTask().GetAwaiter().GetResult();
<#
        }
#>
<#
        if (sqlite)
        {
#>
        try
        {
            if (_scratchFile is not null)
                File.Delete(_scratchFile);
        }
        catch (IOException)
        {
        }
<#
        }
#>
    }

<#
        if (Project.ApiAuth)
        {
#>
    /// <summary> A client with no token, for the tests that show a call is refused without one. </summary>
    public static HttpClient Anonymous() => _factory!.CreateClient();

    /// <summary> A client whose token carries this role, made with the signing key of the run (no user needs to exist): for the tests of ReadRoles and WriteRoles. </summary>
    public static HttpClient ClientInRole(string role)
    {
        string token = new Microsoft.IdentityModel.JsonWebTokens.JsonWebTokenHandler().CreateToken(new Microsoft.IdentityModel.Tokens.SecurityTokenDescriptor
        {
            Issuer = "<#= projectName #>.Api",
            Audience = "<#= projectName #>",
            Subject = new System.Security.Claims.ClaimsIdentity([new("sub", "role-test"), new("name", "role-test"), new("<#= Project.AuthRoleClaim #>", role)]),
            Expires = DateTime.UtcNow.AddMinutes(30),
            SigningCredentials = new Microsoft.IdentityModel.Tokens.SigningCredentials(
                new Microsoft.IdentityModel.Tokens.SymmetricSecurityKey(System.Text.Encoding.UTF8.GetBytes(_jwtKey)), Microsoft.IdentityModel.Tokens.SecurityAlgorithms.HmacSha256)
        });
        var client = _factory!.CreateClient();
        client.DefaultRequestHeaders.Authorization = new("Bearer", token);
        return client;
    }

<#
        }
#>
    /// <summary> Skips the test (inconclusive) when there is no scratch database to run against. </summary>
    public static void RequireDatabase()
    {
        if (!HasDatabase)
            Assert.Inconclusive("Set " + ConnectionVariable + " to the connection string of a scratch copy of the database (the tests add and remove rows)."<#= containers ? " + (_containerProblem is null ? \"\" : \" The test container could not be made: \" + _containerProblem)" : "" #>);
    }
<#
        if (containers)
        {
#>

    /// <summary> Starts a container of the project's database, fills it from the schema scripts and answers its connection string; null (with the reason kept for the tests' message) when Docker is not there or a script fails. </summary>
    private static async Task<string?> StartContainerAsync()
    {
        try
        {
            _container = <#= containerBuild #>;
            await _container.StartAsync();
            foreach (string script in ScriptFiles())
            {
<# if (Project.DatabaseDialect == SqlDialect.SqlServer) { #>
                // sqlcmd starts with QUOTED_IDENTIFIER off, which makes a routine that writes a table with a filtered or computed-column index fail when it runs
                var result = await _container.ExecScriptAsync("SET QUOTED_IDENTIFIER ON;\nGO\n" + await File.ReadAllTextAsync(script));
<# } else { #>
                var result = await _container.ExecScriptAsync(await File.ReadAllTextAsync(script));
<# } #>
                if (result.ExitCode != 0)
                    throw new InvalidOperationException(Path.GetFileName(script) + " failed: " + result.Stderr);
            }
            return _container.GetConnectionString();
        }
        catch (Exception problem)
        {
            _containerProblem = problem.GetType().Name + ": " + problem.Message;
            if (_container is not null)
                await _container.DisposeAsync();
            _container = null;
            return null;
        }
    }

    private static IEnumerable<string> ScriptFiles()
    {
        string api = ApiFolder();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (string entry in SchemaScripts)
        {
            string path = Path.GetFullPath(Path.Combine(api, entry));
            if (Directory.Exists(path))
            {
                foreach (string file in Directory.EnumerateFiles(path, "*.sql", SearchOption.AllDirectories).Order(StringComparer.OrdinalIgnoreCase).Where(seen.Add))
                    yield return file;
            }
            else if (File.Exists(path))
            {
                if (seen.Add(path))
                    yield return path;
            }
            else
                throw new FileNotFoundException("ApiTestSchema names " + entry + ", which is not in " + api);
        }
    }
<#
        }
#>

    /// <summary> Text with a short random ending, cut to the column's length, so a unique index does not stop a second run. </summary>
    public static string Unique(string text, int maxLength)
    {
        string tail = Guid.NewGuid().ToString("N")[..6];
        if (maxLength <= 0)
            return text + " " + tail;
        tail = tail[..Math.Min(tail.Length, maxLength)];
        int room = maxLength - tail.Length - 1;
        return room > 0 ? text[..Math.Min(text.Length, room)] + " " + tail : tail;
    }

<#
    if (Project.EffectiveDatedTables.Length > 0)
    {
#>
    private static long _day = Random.Shared.NextInt64(0, 30_000);
    private static string _lastDay = "";

    /// <summary> The first day of a one-day period in the 19th century, before the dates of real rows (and after the 1753 start of SQL Server's datetime), a new one on every call: rows made by different tests (EffectiveDatedTables) never overlap each other or an open period that began later. </summary>
    public static string NextDay() => _lastDay = new DateTime(1800, 1, 1).AddDays(Interlocked.Add(ref _day, 2)).ToString("yyyy-MM-dd'T'00:00:00");

    /// <summary> The last day of the period NextDay just began (the same day). </summary>
    public static string SameDay() => _lastDay;

<#
    }
#>
    /// <summary> A key for a table whose key the database does not number. </summary>
    public static long NewKey(long low, long high) => Random.Shared.NextInt64(low, high);

    /// <summary> A key for a table whose key is text the person chooses: random capital letters and digits, as long as the column allows (up to 12). </summary>
    public static string NewCode(int length)
    {
        const string alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
        return string.Create(Math.Clamp(length, 1, 12), alphabet, (span, letters) => { for (int i = 0; i < span.Length; i++) span[i] = letters[Random.Shared.Next(letters.Length)]; });
    }

    // the parent rows the tests added because a parent had none, newest last: removed again when the run ends
    private static readonly List<(string Route, string Key)> Seeded = [];
    private static int _seeding;

    /// <summary> The key of the first row the parent's API lists, for a foreign key to point at. When the parent has no list route the fallback is used; when it has no rows one is added with the body the parent's own tests use (<c>parentTests</c> names that class without "ApiTests"), and the test is inconclusive only when that cannot be done. </summary>
    public static async Task<long> ExistingKeyAsync(string route, string keyProperty, long fallback, string? parentTests = null)
    {
        var key = await ExistingAsync(route, keyProperty, parentTests);
        return key is null ? fallback : key.GetValue<long>();
    }

    /// <summary> The same for a foreign key to a table whose key is text or a guid. </summary>
    public static async Task<string> ExistingCodeAsync(string route, string keyProperty, string fallback, string? parentTests = null)
    {
        var key = await ExistingAsync(route, keyProperty, parentTests);
        return key is null ? fallback : key.GetValue<string>();
    }

    private static async Task<JsonNode?> ExistingAsync(string route, string keyProperty, string? parentTests)
    {
        using var response = await Client.GetAsync(route);
        if (!response.IsSuccessStatusCode)
            return null;
        var rows = await response.Content.ReadFromJsonAsync<JsonArray>();
        return rows is { Count: > 0 } ? rows[0]![keyProperty] : await SeedAsync(route, keyProperty, parentTests);
    }

    /// <summary> Adds a row to a parent that has none, with the body its own tests send (its foreign keys are seeded the same way, so a parent chain fills itself in order), and remembers it for the end of the run. </summary>
    private static async Task<JsonNode> SeedAsync(string route, string keyProperty, string? parentTests)
    {
        var body = parentTests is null ? null : Type.GetType(typeof(ApiFixture).Namespace + "." + parentTests + "ApiTests")
            ?.GetMethod("NewBodyAsync", System.Reflection.BindingFlags.Static | System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.NonPublic);
        if (body is null || _seeding >= 8)
            Assert.Inconclusive("There is no row in " + route + " for a foreign key to point at, and the parent has no tests to take a row from.");
        _seeding++;
        try
        {
            var row = await (Task<JsonObject>)body!.Invoke(null, null)!;
            using var created = await Client.PostAsJsonAsync(route, row);
            if (!created.IsSuccessStatusCode)
                Assert.Inconclusive("There is no row in " + route + " for a foreign key to point at, and adding one answered " + (int)created.StatusCode + ".");
            var key = (await created.Content.ReadFromJsonAsync<JsonObject>())?[keyProperty];
            if (key is null)
                Assert.Inconclusive("The row added to " + route + " did not answer its key (" + keyProperty + ").");
            Seeded.Add((route, key!.ToString()));
            return key;
        }
        finally
        {
            _seeding -= 1;
        }
    }

    // the rows the run added to empty parents, newest first (a child before its parent); a row something still points at stays
    private static void RemoveSeeded()
    {
        if (Client is null)
            return;
        for (int i = Seeded.Count - 1; i >= 0; i -= 1)
        {
            try
            {
                Client.DeleteAsync(Seeded[i].Route + "/" + Uri.EscapeDataString(Seeded[i].Key)).GetAwaiter().GetResult().Dispose();
            }
            catch (HttpRequestException)
            {
            }
        }
        Seeded.Clear();
    }
<#
        if (sqlite || containers)
        {
#>

    // the API project's folder: found by walking up from the test run to the folder that holds <#= apiPath #>
    private static string ApiFolder()
    {
        for (var folder = new DirectoryInfo(AppContext.BaseDirectory); folder is not null; folder = folder.Parent)
        {
            string candidate = Path.GetFullPath(Path.Combine(folder.FullName, "<#= apiPath #>"));
            if (File.Exists(Path.Combine(candidate, "<#= projectName #>.Api.csproj")))
                return candidate;
        }
        return AppContext.BaseDirectory;
    }
<#
        }
#>
}
<#
    }
#>
