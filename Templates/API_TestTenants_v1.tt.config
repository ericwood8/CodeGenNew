# Restriction checkboxes for API_TestTenants_v1.tt (see Docs/Reference.md section 3).
# One run for the whole database: the test classes of the tenant table and the tenant-owned Name and IsActive tables, which API_Test does not write.
Scope=Database
# Whole-project generation (codegen generate): added by ApiTests=true when TenantTable is set. The files go to the test project, not the API.
Stacks=Api
OutputRoot=ApiTests
InPlan=false
