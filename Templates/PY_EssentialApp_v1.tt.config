# Restriction checkboxes for PY_EssentialApp_v1.tt (see Docs/Reference.md section 3).
# One of the files every Python API needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Python
EssentialsGroup=App
Description=app/db.py (the engine and session of the database), app/support.py (errors, paging, helpers) and app/main.py (the FastAPI app with CORS)
Needs=app/routes/__init__.py
