# Restriction checkboxes for TSX_EssentialDocker_v1.tt (see Docs/Reference.md section 3).
# One of the files an app of a stack can have: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=React
EssentialsGroup=Docker
EssentialsDefault=false
Description=Dockerfile (build with Node, serve with nginx), nginx.conf.template (forwards /api/ to API_UPSTREAM) and .dockerignore
