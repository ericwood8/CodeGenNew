<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // BLZ_Dashboard_v1.tt
    // Generates: Services/DashboardClient.cs, Components/DashboardWidgetView.razor and Pages/Dashboard.razor   (the paths are written by the template; point the output folder at the Blazor app's folder)
    // The dashboard page of a Blazor app, drawn from what GET /api/dashboard returns (API_Dashboard): cards, bar lists, a sparkline and a list of recent rows, all written by the template, so no chart
    // package is added. Every chart has the same numbers beside it as text. Money widgets (isMoney) show the project's currency. BLZ_Screens adds the menu entry, registers DashboardClient and makes
    // the dashboard the first screen. There is no strip above each grid on Blazor.
    // Full notes: Docs/TemplateNotes/BLZ_Dashboard_v1.md
    // ==========================================================================================

    string ns = BlazorNames.Namespace(Project);
    string symbol = Project.CurrencyCode == "USD" ? "$" : Project.CurrencyCode + " ";
#>
@@@FILE Services/DashboardClient.cs@@@
using System.Net.Http.Json;

namespace <#= ns #>.Services;

public class DashboardPoint
{
    public string? Label { get; set; }
    public double? Value { get; set; }
}

public class DashboardRow
{
    public string? Label { get; set; }
    public string? Detail { get; set; }
}

// Kind is count, childCount, money, topBy, breakdown, trend, ratio, status or recent; a recent widget fills Rows, every other one Points. IsMoney: the numbers are amounts of money.
public class DashboardWidget
{
    public string Id { get; set; } = "";
    public string Kind { get; set; } = "";
    public string Title { get; set; } = "";
    public string Table { get; set; } = "";
    public string Route { get; set; } = "";
    public bool IsMoney { get; set; }
    public List<DashboardPoint> Points { get; set; } = [];
    public List<DashboardRow> Rows { get; set; } = [];

    public bool IsCard => Kind is "count" or "childCount" or "money" or "ratio" or "status";
}

public class DashboardResult
{
    public List<DashboardWidget> Widgets { get; set; } = [];
}

public class DashboardClient(HttpClient http)
{
    public async Task<DashboardResult> GetAsync() => await (await http.GetAsync("/api/dashboard")).ReadAsync<DashboardResult>();
}
@@@FILE Components/DashboardWidgetView.razor@@@
@using System.Globalization
@using <#= ns #>.Services

@* One widget: a card (count, childCount, money, ratio, status), a bar list (topBy, breakdown), a trend or the recent rows. *@
@switch (Widget.Kind)
{
    case "topBy":
    case "breakdown":
        <section class="dash-panel" aria-label="@Widget.Title">
            <h3>@Title()</h3>
            @if (Widget.Points.Count == 0)
            {
                <p>No data.</p>
            }
            else
            {
                <ol class="dash-bars">
                    @foreach (var p in Widget.Points)
                    {
                        <li>
                            <span>@p.Label</span>
                            <span class="dash-track" aria-hidden="true"><span class="dash-fill" style="width: @Share(p.Value)%"></span></span>
                            <span class="dash-value">@Format(p.Value)</span>
                        </li>
                    }
                </ol>
            }
        </section>
        break;
    case "trend":
        <section class="dash-panel" aria-label="@Widget.Title">
            <h3>@Title()</h3>
            @if (Widget.Points.Count == 0)
            {
                <p>No data.</p>
            }
            else
            {
                <svg class="dash-spark" viewBox="0 0 200 48" preserveAspectRatio="none" role="img" aria-label="@Summary()">
                    <polyline points="@SparkPoints()" />
                </svg>
                <details>
                    <summary>Show the numbers</summary>
                    <table>
                        <tbody>
                            @foreach (var p in Widget.Points)
                            {
                                <tr><td>@p.Label</td><td>@Format(p.Value)</td></tr>
                            }
                        </tbody>
                    </table>
                </details>
            }
        </section>
        break;
    case "recent":
        <section class="dash-panel dash-panel-wide" aria-label="@Widget.Title">
            <h3>@Title()</h3>
            @if (Widget.Rows.Count == 0)
            {
                <p>No rows.</p>
            }
            else
            {
                <ul class="dash-recent">
                    @foreach (var r in Widget.Rows)
                    {
                        <li><span>@r.Label</span><span>@r.Detail</span></li>
                    }
                </ul>
            }
        </section>
        break;
    default:
        <section class="dash-card" aria-label="@Widget.Title">
            <h3>@Title()</h3>
            <dl>
                @foreach (var p in Widget.Points)
                {
                    <div>
                        <dt>@p.Label</dt>
                        <dd>@Format(p.Value)</dd>
                    </div>
                }
            </dl>
        </section>
        break;
}

@code {
    [Parameter, EditorRequired] public DashboardWidget Widget { get; set; } = default!;

    private const string CurrencySymbol = "<#= symbol #>";

    private RenderFragment Title() => Widget.Route.Length == 0
        ? (builder => builder.AddContent(0, Widget.Title))
        : (builder =>
        {
            builder.OpenComponent<NavLink>(0);
            builder.AddAttribute(1, "href", Widget.Route);
            builder.AddAttribute(2, "ChildContent", (RenderFragment)(inner => inner.AddContent(0, Widget.Title)));
            builder.CloseComponent();
        });

    // Money shows the project's currency with thousands separators and two decimals; a count shows up to two decimals.
    private string Format(double? value)
    {
        if (value is null)
            return "";
        if (!Widget.IsMoney)
            return value.Value.ToString("#,##0.##", CultureInfo.InvariantCulture);
        return (value < 0 ? "-" : "") + CurrencySymbol + Math.Abs(value.Value).ToString("#,##0.00", CultureInfo.InvariantCulture);
    }

    private double Share(double? value)
    {
        double largest = Math.Max(Widget.Points.Max(p => p.Value ?? 0), 1);
        return Math.Round((value ?? 0) / largest * 100, 1);
    }

    // A line over the points of a trend, scaled to a 200 by 48 box; the numbers are in the table under it.
    private string SparkPoints()
    {
        var values = Widget.Points.Select(p => p.Value ?? 0).ToList();
        if (values.Count == 0)
            return "";
        double max = Math.Max(values.Max(), 0), min = Math.Min(values.Min(), 0), span = max - min == 0 ? 1 : max - min;
        double step = values.Count > 1 ? 200.0 / (values.Count - 1) : 0;
        return string.Join(' ', values.Select((v, i) => (i * step).ToString("0.0", CultureInfo.InvariantCulture) + "," + (46 - (v - min) / span * 44).ToString("0.0", CultureInfo.InvariantCulture)));
    }

    private string Summary() => Widget.Title + ": " + string.Join(", ", Widget.Points.Select(p => p.Label + " " + Format(p.Value)));
}
@@@FILE Pages/Dashboard.razor@@@
@page "/dashboard"
@using <#= ns #>.Components
@using <#= ns #>.Services
@inject DashboardClient Client

<PageTitle>Dashboard</PageTitle>

<style>
    .dash-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; margin: 12px 0; }
    .dash-card, .dash-panel { padding: 12px 16px; border: 1px solid #8886; border-radius: 6px; background: #8881; }
    .dash-card h3, .dash-panel h3 { margin: 0 0 8px; font-size: 1rem; }
    .dash-card a, .dash-panel a { color: inherit; text-decoration: none; }
    .dash-card a:hover, .dash-panel a:hover { text-decoration: underline; }
    .dash-card dl { display: flex; flex-wrap: wrap; gap: 4px 20px; margin: 0; }
    .dash-card dt { font-size: 0.85rem; opacity: 0.8; }
    .dash-card dd { margin: 0 0 4px; font-size: 1.6rem; font-weight: 700; }
    .dash-bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
    .dash-bars li { display: grid; grid-template-columns: minmax(80px, 30%) 1fr auto; align-items: center; gap: 8px; }
    .dash-track { display: block; height: 10px; border-radius: 5px; background: #8883; }
    .dash-fill { display: block; height: 100%; border-radius: 5px; background: currentColor; opacity: 0.55; }
    .dash-value { font-variant-numeric: tabular-nums; font-weight: 600; }
    .dash-spark { width: 100%; height: 56px; }
    .dash-spark polyline { fill: none; stroke: currentColor; stroke-width: 2; vector-effect: non-scaling-stroke; }
    .dash-recent { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
    .dash-recent li { display: flex; justify-content: space-between; gap: 12px; }
    .dash-recent li span:last-child { white-space: nowrap; font-variant-numeric: tabular-nums; }
    .dash-panel details { margin-top: 8px; }
    .dash-panel summary { cursor: pointer; font-size: 0.85rem; opacity: 0.8; }
    @@media (min-width: 720px) { .dash-panel-wide { grid-column: span 2; } }
</style>

<h1>Dashboard</h1>
<button type="button" @onclick="LoadAsync">Refresh</button>

@if (message is not null)
{
    <p class="error" role="alert">@message</p>
}
@if (result is not null && result.Widgets.Count == 0)
{
    <p>The schema suggests nothing to show.</p>
}
@if (result is not null)
{
    <div class="dash-grid">
        @foreach (var widget in result.Widgets.Where(w => w.IsCard))
        {
            <DashboardWidgetView Widget="widget" />
        }
    </div>
    <div class="dash-grid">
        @foreach (var widget in result.Widgets.Where(w => !w.IsCard))
        {
            <DashboardWidgetView Widget="widget" />
        }
    </div>
}

@code {
    private DashboardResult? result;
    private string? message;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        message = null;
        try
        {
            result = await Client.GetAsync();
        }
        catch (Exception)
        {
            message = "Failed to load the dashboard.";
        }
    }
}
