<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // WinUI3_EssentialControls_v1.tt
    // Generates: ViewModels/ViewModelBase.cs, ViewModels/GridSortStore.cs, Views/BusyOverlay.xaml and .xaml.cs, Views/PaginationBar.xaml and .xaml.cs, Views/CurrencyNumberFormatter.cs   (no table, no database: an essentials group)
    // The base class of every generated view model (the error sentence and the busy flag), the busy overlay that shows it, and the controls and helpers every generated list page and dialog shares: the pager under a grid (Previous, Next, rows per page), the store that remembers each grid's sort between runs
    // (GridSorts.json in the local application data folder), and the formatter a currency number box uses (it also reads a plain number). The table templates use them and no longer write them,
    // so run this group once before generating screens.
    // Needs the project settings AppNamespace, ViewNamespace, ViewModelNamespace, ViewsFolder and ViewModelsFolder (defaults derive from ProjectName).
    // Full notes: Docs/TemplateNotes/WinUI3_EssentialControls_v1.md
    // ==========================================================================================
    string appNamespace = Project.AppNamespace;
    string viewNamespace = Project.ViewNamespace ?? appNamespace + ".Views";
    string viewModelNamespace = Project.ViewModelNamespace ?? appNamespace + ".ViewModels";
    string viewsFolder = Project.ViewsFolder ?? "Views";
    string viewModelsFolder = Project.ViewModelsFolder ?? "ViewModels";
#>
@@@FILE <#= viewModelsFolder #>/ViewModelBase.cs@@@
using CommunityToolkit.Mvvm.ComponentModel;

namespace <#= viewModelNamespace #>;

/// <summary> The base of the generated view models: the sentence the page shows in its error bar, and a busy flag for work the person waits for. </summary>
public abstract partial class ViewModelBase : ObservableObject
{
    [NotifyPropertyChangedFor(nameof(HasError))]
    [ObservableProperty]
    private string? _errorMessage;
    public bool HasError => ErrorMessage is not null;

    [ObservableProperty]
    private bool _isBusy;

    /// <summary> Runs the work with IsBusy set, and clears it afterwards even when the work throws. Calls can nest: the flag clears when the last one ends. </summary>
    protected async Task RunBusyAsync(Func<Task> work)
    {
        _busyDepth++;
        IsBusy = true;
        try { await work(); }
        finally
        {
            _busyDepth -= 1;
            if (_busyDepth == 0)
                IsBusy = false;
        }
    }

    private int _busyDepth;

    /// <summary> The one context of the app is not thread-safe, and a page can start loading while the page before it still is: every view model takes turns on this gate. </summary>
    protected static readonly System.Threading.SemaphoreSlim ContextGate = new(1, 1);
}
@@@FILE <#= viewsFolder #>/BusyOverlay.xaml@@@
<UserControl
    x:Class="<#= viewNamespace #>.BusyOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Visibility="{x:Bind IsActive, Mode=OneWay}" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.8">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <ProgressRing IsActive="{x:Bind IsActive, Mode=OneWay}" Width="48" Height="48" AutomationProperties.Name="Loading" />
            <TextBlock Text="Loading..." HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
@@@FILE <#= viewsFolder #>/BusyOverlay.xaml.cs@@@
using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;

namespace <#= viewNamespace #>;

/// <summary> A dimmed cover with a progress ring over the area it is placed in while IsActive is true; it also blocks clicks on what is under it. </summary>
public sealed partial class BusyOverlay : UserControl
{
    public static readonly DependencyProperty IsActiveProperty =
        DependencyProperty.Register(nameof(IsActive), typeof(bool), typeof(BusyOverlay), new PropertyMetadata(false));

    public bool IsActive
    {
        get => (bool)GetValue(IsActiveProperty);
        set => SetValue(IsActiveProperty, value);
    }

    public BusyOverlay()
    {
        InitializeComponent();
    }
}
@@@FILE <#= viewModelsFolder #>/GridSortStore.cs@@@
using System.IO;
using System.Text.Json;

namespace <#= viewModelNamespace #>;

/// <summary> The sort of one grid: a column name and the direction. </summary>
public record GridSortEntry(string Column, bool Descending);

/// <summary> Remembers each grid's sort between runs in GridSorts.json in the local application data folder. The file maps a grid's name to a list of
/// { Column, Descending } so several sort columns can be added without changing the format. Clearing a sort removes its entry, and the file when none is left.
/// A file that cannot be read or written just means the sort is not remembered. </summary>
public static class GridSortStore
{
    private static readonly object Gate = new();
    private static readonly JsonSerializerOptions Json = new() { WriteIndented = true };

    private static string FilePath { get; } = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
        System.Reflection.Assembly.GetEntryAssembly()?.GetName().Name ?? "App",
        "GridSorts.json");

    /// <summary> The saved sort of a grid, or null when there is none or its column is not one of the grid's sortable columns. </summary>
    public static GridSortEntry? Load(string gridKey, IReadOnlyCollection<string> sortableColumns)
    {
        lock (Gate)
        {
            var first = ReadAll().GetValueOrDefault(gridKey)?.FirstOrDefault();
            return first is not null && sortableColumns.Contains(first.Column) ? first : null;
        }
    }

    /// <summary> Remember the sort of a grid, or forget it (null). </summary>
    public static void Save(string gridKey, GridSortEntry? sort)
    {
        lock (Gate)
        {
            var all = ReadAll();
            if (sort is null)
                all.Remove(gridKey);
            else
                all[gridKey] = [sort];

            try
            {
                if (all.Count == 0)
                {
                    File.Delete(FilePath);
                    return;
                }
                Directory.CreateDirectory(Path.GetDirectoryName(FilePath)!);
                File.WriteAllText(FilePath, JsonSerializer.Serialize(all, Json));
            }
            catch (Exception)
            {
                // the sort just is not remembered
            }
        }
    }

    private static Dictionary<string, List<GridSortEntry>> ReadAll()
    {
        try
        {
            if (File.Exists(FilePath))
                return JsonSerializer.Deserialize<Dictionary<string, List<GridSortEntry>>>(File.ReadAllText(FilePath)) ?? [];
        }
        catch (Exception)
        {
            // unreadable: start again with no saved sorts
        }
        return [];
    }
}
@@@FILE <#= viewsFolder #>/PaginationBar.xaml@@@
<UserControl
    x:Class="<#= viewNamespace #>.PaginationBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Previous" Click="OnPreviousClick" IsEnabled="{x:Bind CanGoPrevious, Mode=OneWay}" />
        <TextBlock Text="{x:Bind PageLabel, Mode=OneWay}" VerticalAlignment="Center" />
        <Button Content="Next" Click="OnNextClick" IsEnabled="{x:Bind CanGoNext, Mode=OneWay}" />
        <TextBlock Text="Rows per page" VerticalAlignment="Center" Margin="16,0,0,0" />
        <ComboBox x:Name="PageSizeBox" Width="80" AutomationProperties.Name="Rows per page" SelectionChanged="OnPageSizeSelected" />
    </StackPanel>
</UserControl>
@@@FILE <#= viewsFolder #>/PaginationBar.xaml.cs@@@
using Microsoft.UI.Xaml.Controls;

namespace <#= viewNamespace #>;

public sealed partial class PaginationBar : UserControl
{
    public static readonly DependencyProperty PageLabelProperty =
        DependencyProperty.Register(nameof(PageLabel), typeof(string), typeof(PaginationBar), new PropertyMetadata(""));
    public static readonly DependencyProperty CanGoPreviousProperty =
        DependencyProperty.Register(nameof(CanGoPrevious), typeof(bool), typeof(PaginationBar), new PropertyMetadata(false));
    public static readonly DependencyProperty CanGoNextProperty =
        DependencyProperty.Register(nameof(CanGoNext), typeof(bool), typeof(PaginationBar), new PropertyMetadata(false));

    public static readonly DependencyProperty PageSizeProperty =
        DependencyProperty.Register(nameof(PageSize), typeof(int), typeof(PaginationBar), new PropertyMetadata(20, OnPageSizeChanged));

    /// <summary> The page sizes the person can pick under the grid. </summary>
    public int[] PageSizeChoices { get; } = [10, 20, 50, 100];

    public int PageSize { get => (int)GetValue(PageSizeProperty); set => SetValue(PageSizeProperty, value); }

    /// <summary> Raised when the person picks another page size; the page reads its first page again with it. </summary>
    public event EventHandler<int>? PageSizeChanged;

    public string PageLabel { get => (string)GetValue(PageLabelProperty); set => SetValue(PageLabelProperty, value); }
    public bool CanGoPrevious { get => (bool)GetValue(CanGoPreviousProperty); set => SetValue(CanGoPreviousProperty, value); }
    public bool CanGoNext { get => (bool)GetValue(CanGoNextProperty); set => SetValue(CanGoNextProperty, value); }

    public event RoutedEventHandler? PreviousClicked;
    public event RoutedEventHandler? NextClicked;

    public PaginationBar()
    {
        InitializeComponent();
        PageSizeBox.ItemsSource = PageSizeChoices;
        PageSizeBox.SelectedItem = PageSize;
    }

    private static void OnPageSizeChanged(DependencyObject d, DependencyPropertyChangedEventArgs e) => ((PaginationBar)d).PageSizeBox.SelectedItem = (int)e.NewValue;

    private void OnPageSizeSelected(object sender, SelectionChangedEventArgs e)
    {
        if (PageSizeBox.SelectedItem is int size && size != PageSize)
            PageSizeChanged?.Invoke(this, size);
    }

    private void OnPreviousClick(object sender, RoutedEventArgs e) => PreviousClicked?.Invoke(this, e);
    private void OnNextClick(object sender, RoutedEventArgs e) => NextClicked?.Invoke(this, e);
}
@@@FILE <#= viewsFolder #>/CurrencyNumberFormatter.cs@@@
using Windows.Globalization.NumberFormatting;

namespace <#= viewNamespace #>;

// Shows a number as currency, but reads it with OR without the currency symbol. A plain CurrencyFormatter only parses text that
// includes the symbol, so typing 7777.77 into a currency NumberBox was silently thrown away. NumberBox needs one object that both
// formats (INumberFormatter2) and parses (INumberParser).
public sealed partial class CurrencyNumberFormatter : INumberFormatter2, INumberParser
{
    private readonly CurrencyFormatter _currency;
    private readonly DecimalFormatter _plain;

    public CurrencyNumberFormatter(string currencyCode, int fractionDigits)
    {
        _currency = new CurrencyFormatter(currencyCode) { FractionDigits = fractionDigits };
        _plain = new DecimalFormatter { FractionDigits = fractionDigits };
    }

    public string FormatInt(long value) => _currency.FormatInt(value);
    public string FormatUInt(ulong value) => _currency.FormatUInt(value);
    public string FormatDouble(double value) => _currency.FormatDouble(value);

    public long? ParseInt(string text) => _currency.ParseInt(text) ?? _plain.ParseInt(text);
    public ulong? ParseUInt(string text) => _currency.ParseUInt(text) ?? _plain.ParseUInt(text);
    public double? ParseDouble(string text) => _currency.ParseDouble(text) ?? _plain.ParseDouble(text);
}
