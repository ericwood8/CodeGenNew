<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    // Folders under the Angular app root (where -o points) that the generated files go in.
    string modelsFolder = Project.ModelsFolder;
    // Tables that have no API (C# enums, other *Type lookup tables, tables with no entity): no model is written for them.
    string[] noApiTables =
    {
        "ClearanceType", "ExpenseType", "LeaveType", "OvertimeType", "SY_RequestStatusType", "SY_RequestType",
        "SY_ResponseType", "SY_Role", "SY_Display", "SY_ISOCountry", "SY_PerDiem", "sysdiagrams"
    };
    // A foreign key to one of these stays a plain column: no navigation property.
    string[] noNavigationTables =
    {
        "ClearanceType", "ExpenseType", "LeaveType", "OvertimeType", "SY_Display", "SY_ISOCountry",
        "SY_RequestStatusType", "SY_RequestType", "SY_ResponseType", "SY_Role"
    };
    // Interfaces that live in another table's model file: table -> file name (without .ts).
    var modelFileOf = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["DepartmentTeam"] = "department",
        ["ProjectTask"] = "project"
    };
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    modelFileOf = Project.ModelFileOverrides ?? modelFileOf;
    // With a project chosen, which tables count as enums (no entity/repository/API of their own) comes from the project's
    // EnumTables, else from what the schema says about each table (LookupShape) - not from the lists above, which are
    // only used when no project is chosen.
    bool NoApi(string table, LookupShape shape) => Project.NoApi(table, shape) ?? noApiTables.Contains(table, StringComparer.OrdinalIgnoreCase);
    bool NoNavigation(string table, LookupShape shape) => Project.NoNavigation(table, shape) ?? noNavigationTables.Contains(table, StringComparer.OrdinalIgnoreCase);
    // ==========================================================================================

    // ==========================================================================================
    // TS_Model_v1.tt
    // Generates: models/<table>.ts   (an Angular TypeScript interface; the path is written by the template, point the output folder at src/app)
    // One row as the API sends and takes it: property names follow the server's JSON camel-casing, dates are strings, a foreign key gets an optional
    // navigation property of the parent's type. Used by TS_Service and TS_Component, and by the React TSX_Api. Folder name from the project's ModelsFolder.
    // Full notes: Docs/TemplateNotes/TS_Model_v1.md
    // ==========================================================================================

    string BaseName(string table) => System.Text.RegularExpressions.Regex.Replace(System.Text.RegularExpressions.Regex.Replace(table, "^E_", ""), "^SY_", "");
    string Camel(string name) => JsonNames.Camel(name);
    string TsType(ColumnModel c) => c.TypeScript();

    var keyColumn = Model.PrimaryKeyColumns.Count == 1 ? Model.PrimaryKeyColumns[0] : null;
    if (NoApi(Model.TableName, Model.LookupShape))
    {
        Error($"TS_Model writes no model for [{Model.SchemaName}].[{Model.TableName}]: it is listed in noApiTables (an enum, a *Type lookup table, or a table with no entity class), so the app never receives a row of it.");
    }
    else if (keyColumn is null)
    {
        Error($"TS_Model needs a table with a single primary key, but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : "a composite primary key (" + string.Join(", ", Model.PrimaryKeyColumns.Select(c => c.Name)) + ")."));
    }
    else
    {
        string baseName = BaseName(Model.TableName);
        var fkByColumn = Model.ForeignKeys.Where(f => f.ReferencingColumns.Count == 1)
            .ToDictionary(f => f.ReferencingColumns[0], f => f, StringComparer.OrdinalIgnoreCase);

        // navigation properties: one per foreign key whose parent is not an enum/lookup table
        var takenNames = new HashSet<string>(Model.Columns.Select(c => Camel(c.Name)), StringComparer.Ordinal);
        var navigations = new List<(string Property, string Type, string File)>();
        foreach (var c in Model.Columns.Where(c => !c.IsPrimaryKey && fkByColumn.ContainsKey(c.Name)))
        {
            var fk = fkByColumn[c.Name];
            if (NoNavigation(fk.ReferencedTable, fk.ReferencedLookupShape)) continue;
            string role = c.Name.Length > 2 && c.Name.EndsWith("Id", StringComparison.Ordinal) ? c.Name[..^2] : c.Name + "Ref";
            string property = Camel(role);
            if (!takenNames.Add(property)) continue;
            string type = BaseName(fk.ReferencedTable);
            string file = modelFileOf.TryGetValue(fk.ReferencedTable, out var f) ? f : type.ToLowerInvariant();
            navigations.Add((property, type, file));
        }

        var o = new StringBuilder();
        void L(string s = "") => o.Append(s).Append('\n');

        L($"@@@FILE {modelsFolder}/{baseName.ToLowerInvariant()}.ts@@@");

        // imports: one line per model file, collecting every interface it must supply (a table can have two roles to the same parent)
        string ownFile = baseName.ToLowerInvariant();
        var imports = navigations.Where(n => n.File != ownFile).GroupBy(n => n.File)
            .Select(g => (File: g.Key, Types: g.Select(n => n.Type).Distinct().OrderBy(t => t, StringComparer.Ordinal).ToList()))
            .OrderBy(g => g.File, StringComparer.Ordinal).ToList();
        foreach (var import in imports)
            L($"import {{ {string.Join(", ", import.Types)} }} from \"./{import.File}\";");
        if (imports.Count > 0) L();

        L($"export interface {baseName} {{");
        foreach (var c in Model.Columns)
        {
            bool optional = c.IsPrimaryKey || c.IsNullable;
            L($"    {Camel(c.Name)}{(optional ? "?" : "")}: {TsType(c)};{(c.IsPrimaryKey ? " // Optional for new ones" : "")}");
        }
        foreach (var n in navigations)
            L($"    {n.Property}?: {n.Type};");
        L("}");
        Write(o.ToString());
    }
#>
