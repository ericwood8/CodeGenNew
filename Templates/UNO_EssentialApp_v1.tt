<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // UNO_EssentialApp_v1.tt
    // Generates: App.xaml, App.xaml.cs, MainPage.xaml and MainPage.xaml.cs   (no table, no database: an essentials group)
    // The Uno application class (the control resources and OnLaunched, which opens the main page) and the main page: a NavigationView with a content area, the one HttpClient the API clients
    // share (its address is the API_BASE_URL environment variable, else http://localhost:<ApiPort>) and the selection handler. The menu entries, FirstScreen and ShowPage come from
    // MainPage.Screens.cs, the other half of this partial class (UNO_Screens writes it from the project's Screens setting). Namespace: the project's AppNamespace.
    // ==========================================================================================
    string appNamespace = Project.AppNamespace;
    string servicesNamespace = UnoNames.ServicesNamespace(Project);
    string viewNamespace = Project.ViewNamespace ?? appNamespace + ".Views";
    bool tenants = TenantPlan.HasSwitcher(Project);   // TenantTable and TenantMembership: the pane shows the tenant and, for a person in several, a drop-down to switch
#>
@@@FILE App.xaml@@@
<Application
    x:Class="<#= appNamespace #>.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- every button's caption is bold -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
@@@FILE App.xaml.cs@@@
namespace <#= appNamespace #>;

public partial class App : Application
{
    private Window? _window;

    public App()
    {
        InitializeComponent();
    }

    protected override void OnLaunched(LaunchActivatedEventArgs args)
    {
        _window = new Window { Title = "<#= Project.ProjectTitle #>", Content = new MainPage() };
        _window.Activate();
    }
}
@@@FILE MainPage.xaml@@@
<#
    if (Project.Auth)
    {
#>
<Page
    x:Class="<#= appNamespace #>.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <NavigationView x:Name="NavView" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" Visibility="Collapsed"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.PaneFooter>
<# if (tenants) { #>
                <StackPanel Margin="12" Spacing="8">
                    <TextBlock x:Name="TenantName" Visibility="Collapsed" TextWrapping="Wrap" />
                    <ComboBox x:Name="TenantList" AutomationProperties.Name="<#= TenantWords.SignInLabel #>" DisplayMemberPath="Text" HorizontalAlignment="Stretch" Visibility="Collapsed"
                              SelectionChanged="OnTenantChosen" />
                    <Button Content="Sign out" Click="OnSignOutClick" />
                </StackPanel>
<# } else { #>
                <Button Content="Sign out" Margin="12" Click="OnSignOutClick" />
<# } #>
            </NavigationView.PaneFooter>
            <!-- The menu entries are added by AddScreens() in MainPage.Screens.cs (generated by UNO_Screens): only the screens the role may read. -->
            <ContentControl x:Name="MainContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </NavigationView>
        <!-- The sign-in page, shown until someone is signed in. -->
        <ContentControl x:Name="LoginHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Page>
<#
    }
    else
    {
#>
<Page
    x:Class="<#= appNamespace #>.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <NavigationView x:Name="NavView" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                    SelectionChanged="NavView_SelectionChanged">
        <!-- The menu entries are added by AddScreens() in MainPage.Screens.cs (generated by UNO_Screens). -->
        <ContentControl x:Name="MainContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </NavigationView>
</Page>
<#
    }
#>
@@@FILE MainPage.xaml.cs@@@
<#
    if (Project.Auth)
    {
#>
using <#= servicesNamespace #>;
using <#= viewNamespace #>;
using Microsoft.UI.Xaml.Controls;

namespace <#= appNamespace #>;

public sealed partial class MainPage : Page
{
    // The generated API. API_BASE_URL overrides the address (an Android emulator reaches the machine it runs on as 10.0.2.2, and a phone needs the machine's own address).
    private static readonly string ApiBaseUrl = Environment.GetEnvironmentVariable("API_BASE_URL") ?? "http://localhost:<#= Project.ApiPort #>";

    private readonly AuthSession _session = new();
    private readonly HttpClient _http;
    private readonly ApiClients _api;
<# if (tenants) { #>
    private bool _showingTenants;
<# } #>

    public MainPage()
    {
        _http = new HttpClient(new AuthHandler(_session)) { BaseAddress = new Uri(ApiBaseUrl) };
        _api = new ApiClients(_http, _session);
        InitializeComponent();
        _session.Changed += () => DispatcherQueue.TryEnqueue(Refresh);
        Refresh();
    }

    // Signed in: the menu of the screens the role may read, and the first of them. Signed out: the sign-in page.
    private void Refresh()
    {
        if (!_session.IsSignedIn)
        {
            NavView.Visibility = Visibility.Collapsed;
            MainContent.Content = null;
            LoginHost.Content = new LoginPage(_http, _session);
            LoginHost.Visibility = Visibility.Visible;
            return;
        }

        LoginHost.Content = null;
        LoginHost.Visibility = Visibility.Collapsed;
        NavView.Visibility = Visibility.Visible;
<# if (tenants) { #>
        _ = ShowTenantsAsync();
<# } #>
        string? first = AddScreens();
        if (first is null)
        {
            MainContent.Content = new TextBlock { Text = "There is no screen your role may read.", Margin = new Thickness(24) };
            return;
        }
        NavView.SelectedItem = NavView.MenuItems[0];
        ShowPage(first);
    }

    private void NavView_SelectionChanged(NavigationView sender, NavigationViewSelectionChangedEventArgs args)
    {
        if (args.SelectedItem is NavigationViewItem { Tag: string tag })
            ShowPage(tag);
    }

    private void OnSignOutClick(object sender, RoutedEventArgs e) => _session.Logout();
<# if (tenants) { #>

    // The tenant the person works in: a name when they belong to one, a drop-down when they belong to several.
    private async Task ShowTenantsAsync()
    {
        var choices = await _session.TenantsAsync(_http);
        _showingTenants = true;
        try
        {
            TenantName.Text = choices.Count == 1 ? choices[0].Text : "";
            TenantName.Visibility = choices.Count == 1 ? Visibility.Visible : Visibility.Collapsed;
            TenantList.ItemsSource = choices;
            TenantList.SelectedItem = choices.FirstOrDefault(c => c.Current);
            TenantList.Visibility = choices.Count > 1 ? Visibility.Visible : Visibility.Collapsed;
        }
        finally
        {
            _showingTenants = false;
        }
    }

    // Choosing another tenant asks the API for a token for it; the session then raises Changed and the menu and the first screen are made again, so every screen reads the rows of the new tenant.
    private async void OnTenantChosen(object sender, SelectionChangedEventArgs e)
    {
        if (_showingTenants || TenantList.SelectedItem is not TenantChoice { Current: false } choice)
            return;
        try
        {
            if (await _session.SwitchTenantAsync(_http, choice.Id))
                return;
        }
        catch (HttpRequestException)
        {
        }
        await ShowTenantsAsync();
    }
<# } #>
}
<#
    }
    else
    {
#>
using <#= servicesNamespace #>;
using Microsoft.UI.Xaml.Controls;

namespace <#= appNamespace #>;

public sealed partial class MainPage : Page
{
    // The generated API. API_BASE_URL overrides the address (an Android emulator reaches the machine it runs on as 10.0.2.2, and a phone needs the machine's own address).
    private static readonly string ApiBaseUrl = Environment.GetEnvironmentVariable("API_BASE_URL") ?? "http://localhost:<#= Project.ApiPort #>";

    private readonly ApiClients _api = new(new HttpClient { BaseAddress = new Uri(ApiBaseUrl) });

    public MainPage()
    {
        InitializeComponent();
        AddScreens();
        NavView.SelectedItem = NavView.MenuItems[0];
        ShowPage(FirstScreen);
    }

    private void NavView_SelectionChanged(NavigationView sender, NavigationViewSelectionChangedEventArgs args)
    {
        if (args.SelectedItem is NavigationViewItem { Tag: string tag })
            ShowPage(tag);
    }
}
<#
    }
#>
