# Restriction checkboxes for TSX_Dashboard_v1.tt (see Docs/Reference.md section 3).
# One set of files for the whole database: the menu offers it on the database, the CLI runs it without -t.
DatabaseOnly=true
RequiresPrimaryKey=false
TableOnly=false
# No OutputName: the template writes its own paths (api/dashboardApi.ts, components/..., pages/DashboardPage.tsx) with @@@FILE markers.
# Whole-project generation (codegen generate): written only for a project with Dashboard=true.
Stacks=React
OutputFolder=src
InPlan=false
