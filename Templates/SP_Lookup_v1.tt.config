# Restriction checkboxes for SP_Lookup_v1.tt (see Docs/specs.md section 5.3).
# A Lookup returns the row's ID, so a primary key is required.
RequiresPrimaryKey=true
TableOnly=true
# This template also shows the display columns of every foreign-keyed table, so they must be looked up.
NeedsReferencedDisplayColumns=true
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Api,WinUI3
PlanTables=Entity
OutputRoot=Sql
InPlan=false
