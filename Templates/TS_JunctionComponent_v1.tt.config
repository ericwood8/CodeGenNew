# Restriction checkboxes for TS_JunctionComponent_v1.tt (see Docs/Reference.md section 3).
RequiresPrimaryKey=true
TableOnly=true
# Only offered for a many-to-many junction/bridge table (TableModel.IsJunctionTable).
RequiresJunctionTable=true
# The two-list screen shows the target table's display columns, so they must be looked up.
NeedsReferencedDisplayColumns=true
# No OutputName: the template writes its own paths (components/<table>-junction/...) with @@@FILE markers.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Angular
PlanTables=Junction
OutputFolder=src/app
