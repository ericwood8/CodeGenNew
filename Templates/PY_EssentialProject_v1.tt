<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PY_EssentialProject_v1.tt
    // Generates: requirements.txt, .env.example, .gitignore and README.md   (no table, no database: an essentials group; the output folder is the Python API's own folder)
    // The packages (FastAPI, uvicorn, SQLAlchemy 2.0, Pydantic 2 and the driver of the project's DatabaseProvider, by version range), the variables the API reads (no password is written), what a
    // Python project keeps out of version control, and the commands to install and run it. Settings: DatabaseProvider, ApiPort.
    // ==========================================================================================
    var dialect = Project.DatabaseDialect;
    string user = Project.DatabaseUser ?? "";
    string server = Project.DatabaseServer ?? "localhost";
    string portFlag = new string((char)45, 2) + "port";   // a template line may not hold two hyphens in a row (see TemplateDashTests)
    string driver = dialect switch
    {
        SqlDialect.PostgreSql => "psycopg[binary]>=3.2,<4",
        SqlDialect.MySql => "pymysql>=1.1,<2",
        SqlDialect.Sqlite => "",
        _ => "pyodbc>=5.1,<6"
    };
#>
@@@FILE requirements.txt@@@
fastapi>=0.115,<1
uvicorn>=0.30,<1
sqlalchemy>=2.0,<2.1
pydantic>=2.8,<3
<# if (Project.PythonTests) { #>
pytest>=8,<10
httpx>=0.27,<1
<# } #>
<#
    if (driver.Length > 0)
    {
#>
<#= driver #>
<#
    }
#>
@@@FILE .env.example@@@
# The API reads these from the environment (nothing loads this file for you: set them in your shell, your IDE or your host).
# DATABASE_URL replaces everything below, for example sqlite:///shop.db
# DATABASE_URL=
<#
    if (dialect == SqlDialect.PostgreSql)
    {
#>
PGHOST=<#= server #>
PGDATABASE=<#= Project.DatabaseName #>
PGUSER=<#= user #>
# the password: set PGPASSWORD in the environment, never in a file
<#
    }
    else if (dialect == SqlDialect.MySql)
    {
#>
MYSQL_HOST=<#= server #>
MYSQL_DATABASE=<#= Project.DatabaseName #>
MYSQL_USER=<#= user #>
# the password: set MYSQL_PWD in the environment, never in a file
<#
    }
    else if (dialect == SqlDialect.Sqlite)
    {
#>
DATABASE_FILE=<#= Project.DatabaseName #>
<#
    }
    else
    {
#>
DB_SERVER=<#= server #>
DB_NAME=<#= Project.DatabaseName #>
# empty DB_USER: Windows authentication; otherwise set DB_PASSWORD in the environment, never in a file
DB_USER=<#= user #>
<#
    }
#>
# the origins that may call the API from a browser (comma separated); blank: the front ends' dev servers
# CORS_ORIGINS=
<#
    if (Project.ApiAuth)
    {
#>
# sign-in (ApiAuth): the signing key, at least 32 characters; set it in the environment, never in a file
# Jwt__Key=
<#
        if (Project.UserTable is null)
        {
#>
# the one user who can sign in without a user table
# Bootstrap__AdminUserName=
# Bootstrap__AdminPassword=
<#
        }
    }
#>
@@@FILE .gitignore@@@
__pycache__/
*.pyc
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
*.log
@@@FILE README.md@@@
# <#= Project.ProjectTitle #> API (Python)

A FastAPI application over the <#= Project.DatabaseName #> database, generated by CodeGenNew: SQLAlchemy models (`app/models`), Pydantic schemas (`app/schemas`), routers (`app/routes`).

```
python -m venv .venv
.venv/Scripts/pip install -r requirements.txt     (on Linux and macOS: .venv/bin/pip)
uvicorn app.main:app <#= portFlag #> <#= Project.ApiPort #>
```

The interactive documentation is at `/docs`. The routes are the ones the other stacks of the project serve (`/api/<table>s`, `/search`, `/{id}`, `/{id}/clone`), so the React, Angular and Blazor front ends call it unchanged.
<#
    if (Project.ApiAuth)
    {
#>

## Sign-in

`POST /api/auth/login` takes `{ "userName", "password" }` and answers a bearer token; every other route needs `Authorization: Bearer <token>`. Set the signing key in the environment before you start (`Jwt__Key`, at least 32 characters; never in a file).
<#
        if (Project.UserTable is { } userTable)
        {
#>
The people who sign in are the rows of `<#= userTable #>`. Set a password with `NEW_PASSWORD='a long throwaway' python -m app.users set-password <name>`.
<#
        }
        else
        {
#>
The one user is `Bootstrap__AdminUserName` with `Bootstrap__AdminPassword` (environment variables).
<#
        }
    }
#>
