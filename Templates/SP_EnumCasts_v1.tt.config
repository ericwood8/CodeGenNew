# Restriction checkboxes for SP_EnumCasts_v1.tt (see Docs/specs.md section 5.3).
# One script for the whole database (PostgreSQL native enum types): the menu offers it on the database, the CLI runs it without -t.
DatabaseOnly=true
RequiresPrimaryKey=false
TableOnly=false
# No OutputName: the template writes its own path (EnumCasts.sql) with an @@@FILE marker.
