# Restriction checkboxes for SP_EnumCasts_v1.tt (see Docs/Reference.md section 3).
# One script for the whole database (PostgreSQL native enum types): the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# No OutputName: the template writes its own path (EnumCasts.sql) with an @@@FILE marker.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Api,WinUI3
OutputRoot=Sql
Dialects=PostgreSql
