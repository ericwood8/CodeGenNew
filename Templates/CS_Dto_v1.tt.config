# Restriction checkboxes for CS_Dto_v1.tt (see Docs/Reference.md section 3).
# A data class needs no key: any table or view can be read into one.
RequiresPrimaryKey=false
TableOnly=false
# Name the file like the class: Customer -> CustomerDto.cs
OutputName={Table}Dto.cs
# Whole-project generation (codegen generate): the project's Dtos=true adds the template to the plan for the tables whose API answers it.
Stacks=Api
PlanTables=Dto
OutputFolder=Dtos
InPlan=false
