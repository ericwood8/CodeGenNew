<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // RS_UserDirectory_v1.tt
    // Generates: src/users.rs   (the template writes its own path with an @@@FILE marker; the output folder is the Rust crate's folder)
    // The people who sign in, kept in one of the project's own tables (UserTable=Employee, UserNameColumn, PasswordHashColumn, UserOwnerColumn, UserRoleColumn, UserAdminColumn), for the Rust
    // API's sign-in (src/auth.rs, the Jwt group): find_user looks a sign-in name up, and command writes a hash (the same pbkdf2-sha256 text the ASP.NET API writes) for
    // set-password <name> (cargo run with the arguments after a double hyphen; the new password in the environment variable NEW_PASSWORD, at least 8 characters, never on the command line):
    // exit 0 done, 1 no such user, 2 usage. A row with no hash cannot sign in. A yes/no UserRoleColumn gives two roles (UserRoleWhenTrue, UserRoleWhenFalse); a text one is the role itself;
    // a true UserAdminColumn makes the person the AuthAdminRole. Every statement is fixed text for the database that was read.
    // Needs ApiAuth=true and UserTable. Which names and columns are acceptable is decided by UserTable.Resolve.
    // ==========================================================================================
    var (plan, problem) = UserTable.Resolve(Database, Project);
    if (problem != null)
        Error(problem);
    if (plan == null)
        return GenerationEnvironment.ToString();
    var (held, heldProblem) = PermissionTables.Resolve(Database, Project);
    if (heldProblem != null)
        Error(heldProblem);

    var di = DialectInfo.For(plan.Table.Dialect);
    string table = di.QuoteTable(plan.Table.SchemaName, plan.Table.DbTableName);
    string Q(ColumnModel c) => di.Quote(c.DbName);
    string Type(ColumnModel c) => RustTable.RustType(c, plan.Table.Dialect) ?? "String";
    string RawSql(string sql) => RustTable.Raw(sql);

    // the columns the sign-in reads, under fixed aliases
    var select = new List<string> { $"{Q(plan.UserName)} AS name", $"{Q(plan.PasswordHash)} AS hash" };
    if (plan.Owner != null) select.Add($"{Q(plan.Owner)} AS owner");
    if (plan.Role != null) select.Add($"{Q(plan.Role)} AS role");
    if (plan.Admin != null) select.Add($"{Q(plan.Admin)} AS admin");
    if (held != null)
        select.Add($"{Q(held.UserKey)} AS ukey");
    string find = $"SELECT {string.Join(", ", select)} FROM {table} WHERE {Q(plan.UserName)} = {di.Placeholder(1)} AND {Q(plan.PasswordHash)} IS NOT NULL AND {Q(plan.PasswordHash)} <> ''";
    string setPassword = $"UPDATE {table} SET {Q(plan.PasswordHash)} = {di.Placeholder(1)} WHERE {Q(plan.UserName)} = {di.Placeholder(2)}";

    string roleExpression = plan.Role == null ? "None"
        : plan.RoleIsFlag ? $"Some(if row.try_get::<Option<bool>, _>(\"role\")?.unwrap_or(false) {{ \"{plan.RoleWhenTrue}\" }} else {{ \"{plan.RoleWhenFalse}\" }}.to_string())"
        : $"row.try_get::<Option<{Type(plan.Role)}>, _>(\"role\")?";
    if (plan.Admin != null)
        roleExpression = $"if row.try_get::<Option<bool>, _>(\"admin\")?.unwrap_or(false) {{ Some(ADMIN_ROLE.to_string()) }} else {{ {roleExpression} }}";
    string ownerExpression = plan.Owner == null ? "None" : $"row.try_get::<Option<{Type(plan.Owner)}>, _>(\"owner\")?.map(i64::from)";

    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');

    Line("@@@FILE src/users.rs@@@");
    Line($"// The people who sign in: the rows of {plan.Table.TableName} ({plan.UserName.Name}, {plan.PasswordHash.Name}). A row whose {plan.UserName.Name} or {plan.PasswordHash.Name} is empty cannot sign in.");
    Line("// Written by RS_UserDirectory from the UserTable settings; regenerate it instead of editing it.");
    Line("use sqlx::Row;");
    Line();
    Line("use crate::auth::{ADMIN_ROLE, DirectoryUser, hash_password};");
    Line("use crate::support::Pool;");
    Line();
    Line($"const FIND: &str = {RawSql(find)};");
    Line($"const SET_PASSWORD: &str = {RawSql(setPassword)};");
    string tenantBinds = "";
    bool tenancy = held != null && TenantPlan.HasApiTenancy(Project);
    if (held != null)
    {
        string T(TableModel t) => di.QuoteTable(t.SchemaName, t.DbTableName);
        // a tenant column on the person's role rows or on the role table adds a condition on the tenant of the token, one more bound value each
        string Test(string alias, ColumnModel tenantColumn, int at) => tenantColumn.IsNullable ? $" AND ({alias}.{Q(tenantColumn)} = {di.Placeholder(at)} OR {alias}.{Q(tenantColumn)} IS NULL)" : $" AND {alias}.{Q(tenantColumn)} = {di.Placeholder(at)}";
        string tenantTests = "";
        int next = 2;
        if (held.UserRoleTenant != null) tenantTests += Test("ur", held.UserRoleTenant, next++);
        if (held.RoleTenant != null) tenantTests += Test("r", held.RoleTenant, next++);
        tenantBinds = string.Concat(Enumerable.Repeat(".bind(tenant)", next - 2));
        string permissionRoleJoin = held.RoleTenant == null ? "" : $" JOIN {T(held.Role)} r ON r.{Q(held.RoleKey)} = ur.{Q(held.UserRoleRole)}";
        string rolesSql = $"SELECT r.{Q(held.RoleName)} FROM {T(held.Role)} r JOIN {T(held.UserRole)} ur ON ur.{Q(held.UserRoleRole)} = r.{Q(held.RoleKey)} WHERE ur.{Q(held.UserRoleUser)} = {di.Placeholder(1)}{tenantTests}";
        string permissionsSql = $"SELECT DISTINCT p.{Q(held.PermissionName)} FROM {T(held.Permission)} p JOIN {T(held.RolePermission)} rp ON rp.{Q(held.RolePermissionPermission)} = p.{Q(held.PermissionKey)} JOIN {T(held.UserRole)} ur ON ur.{Q(held.UserRoleRole)} = rp.{Q(held.RolePermissionRole)}{permissionRoleJoin} WHERE ur.{Q(held.UserRoleUser)} = {di.Placeholder(1)}{tenantTests}";
        Line($"const ROLES: &str = {RawSql(rolesSql)};");
        Line($"const PERMISSIONS: &str = {RawSql(permissionsSql)};");
    }
    Line("const PASSWORD_VARIABLE: &str = \"NEW_PASSWORD\";");
    Line("pub const MINIMUM_PASSWORD_LENGTH: usize = 8;");
    Line();
    Line("pub async fn find_user(pool: &Pool, user_name: &str) -> Result<Option<DirectoryUser>, sqlx::Error> {");
    Line("    let Some(row) = sqlx::query(FIND).bind(user_name.trim()).fetch_optional(pool).await? else {");
    Line("        return Ok(None);");
    Line("    };");
    if (held != null && tenancy)
    {
        Line("    let (roles, permissions) = (Vec::new(), Vec::new());");
    }
    else if (held != null)
    {
        Line($"    let key: {Type(held.UserKey)} = row.try_get(\"ukey\")?;");
        Line("    let roles: Vec<String> = sqlx::query_scalar(ROLES).bind(key).fetch_all(pool).await?;");
        Line("    let permissions: Vec<String> = sqlx::query_scalar(PERMISSIONS).bind(key).fetch_all(pool).await?;");
    }
    Line("    Ok(Some(DirectoryUser {");
    Line("        user_name: row.try_get(\"name\")?,");
    Line("        password_hash: row.try_get(\"hash\")?,");
    Line($"        role: {roleExpression},");
    Line($"        owner_id: {ownerExpression},");
    if (held != null)
    {
        Line("        roles,");
        Line("        permissions,");
    }
    Line("    }))");
    Line("}");
    Line();
    if (tenancy)
    {
        Line("/// The names of the roles and permissions the person holds in the tenant given (none for a person in no tenant), read at sign-in and at a switch of tenant.");
        Line("pub async fn held_for(pool: &Pool, user_name: &str, tenant: Option<i32>) -> Result<(Vec<String>, Vec<String>), sqlx::Error> {");
        Line("    let Some(row) = sqlx::query(FIND).bind(user_name.trim()).fetch_optional(pool).await? else {");
        Line("        return Ok((Vec::new(), Vec::new()));");
        Line("    };");
        if (held!.PerTenant)
        {
            Line("    if tenant.is_none() {");
            Line("        return Ok((Vec::new(), Vec::new()));");
            Line("    }");
        }
        Line($"    let key: {Type(held!.UserKey)} = row.try_get(\"ukey\")?;");
        Line($"    let roles: Vec<String> = sqlx::query_scalar(ROLES).bind(key){tenantBinds}.fetch_all(pool).await?;");
        Line($"    let permissions: Vec<String> = sqlx::query_scalar(PERMISSIONS).bind(key){tenantBinds}.fetch_all(pool).await?;");
        Line("    Ok((roles, permissions))");
        Line("}");
        Line();
    }
    Line("/// Runs a command given as the arguments of the program (cargo run with the arguments after a double hyphen): Some(exit code) when the arguments named one, None to start the server.");
    Line("pub async fn command(args: &[String]) -> Option<i32> {");
    Line("    if args.first().is_none_or(|name| !name.eq_ignore_ascii_case(\"set-password\")) {");
    Line("        return None;");
    Line("    }");
    Line("    let password = std::env::var(PASSWORD_VARIABLE).unwrap_or_default();");
    Line("    if args.len() != 2 || password.is_empty() {");
    Line("        eprintln!(\"Usage: set-password <user name>   (the new password in the environment variable {PASSWORD_VARIABLE}, never on the command line)\");");
    Line("        return Some(2);");
    Line("    }");
    Line("    if password.chars().count() < MINIMUM_PASSWORD_LENGTH {");
    Line("        eprintln!(\"The password must have at least {MINIMUM_PASSWORD_LENGTH} characters.\");");
    Line("        return Some(2);");
    Line("    }");
    Line("    let pool = match crate::support::connect().await {");
    Line("        Ok(pool) => pool,");
    Line("        Err(error) => {");
    Line("            eprintln!(\"Cannot connect to the database: {error}\");");
    Line("            return Some(2);");
    Line("        }");
    Line("    };");
    Line("    let name = args[1].trim();");
    Line("    // hashing takes about a tenth of a second of the processor: it does not run on a thread that serves requests");
    Line("    let target = name.to_string();");
    Line("    let written = tokio::task::spawn_blocking(move || hash_password(&password)).await;");
    Line("    let Ok(hash) = written else {");
    Line("        return Some(2);");
    Line("    };");
    Line("    let result = sqlx::query(SET_PASSWORD).bind(hash).bind(target).execute(&pool).await;");
    Line("    match result {");
    Line("        Ok(done) if done.rows_affected() > 0 => {");
    Line("            println!(\"Password set for {name}.\");");
    Line("            Some(0)");
    Line("        }");
    Line("        Ok(_) => {");
    Line("            println!(\"There is no user named {name}.\");");
    Line("            Some(1)");
    Line("        }");
    Line("        Err(error) => {");
    Line("            eprintln!(\"The password was not set: {error}\");");
    Line("            Some(2)");
    Line("        }");
    Line("    }");
    Line("}");
    string people = RustPeopleWriter.File(Database, Project);   // src/people.rs: the first person, a new password and the members of a tenant over HTTP
    if (people.Length > 0)
    {
        Line("@@@FILE src/people.rs@@@");
        sb.Append(people);
    }
    Write(sb.ToString());
#>
