@@@FILE src/app/<#= componentsFolder #>/tenant-switcher/tenant-switcher.component.ts@@@
import { ChangeDetectionStrategy, Component, OnInit, inject } from '@angular/core';
import { HttpClient } from '@angular/common/http';
<# if (!controlFlow) { #>
import { NgFor, NgIf } from '@angular/common';
<# } #>
import { LoginResponse, TenantChoice } from '../../<#= modelsFolder #>/auth';
import { AuthService } from '../../<#= servicesFolder #>/auth.service';

/** The tenant the person works in, as a name, or as a drop-down when they belong to several; choosing one asks the API for a token for it (POST api/auth/switch-tenant) and starts the app again so every screen reads the rows of the new tenant. Shows nothing when the API has no tenants route. */
@Component({
  selector: 'app-tenant-switcher',
<# if (Project.AngularStandaloneFlag) { #>
  standalone: true,
<# } #>
  changeDetection: ChangeDetectionStrategy.<#= Project.AngularEagerStrategy #>, // plain properties change inside subscribe callbacks
  imports: [<#= controlFlow ? "" : "NgFor, NgIf" #>],
  templateUrl: './tenant-switcher.component.html',
  styles: ['.tenant { padding: 4px 8px; font-weight: 600; background: none; border: 1px solid #8886; border-radius: 4px; color: inherit; }']
})
export class TenantSwitcherComponent implements OnInit {
  private readonly http = inject(HttpClient);
  private readonly auth = inject(AuthService);

  choices: TenantChoice[] = [];

  ngOnInit(): void {
    this.http.get<TenantChoice[]>('api/auth/tenants').subscribe({
      next: (list) => { this.choices = list; },
      error: () => { this.choices = []; }
    });
  }

  choose(event: Event): void {
    const tenantId = Number((event.target as HTMLSelectElement).value);
    this.http.post<LoginResponse>('api/auth/switch-tenant', { tenantId }).subscribe({
      next: (response) => {
        this.auth.keep(response);
        this.reload();
      }
    });
  }

  protected reload(): void {
    window.location.assign('/');
  }
}
@@@FILE src/app/<#= componentsFolder #>/tenant-switcher/tenant-switcher.component.html@@@
<#= switcherHtml #>@@@FILE src/app/<#= componentsFolder #>/tenant-switcher/tenant-switcher.component.spec.ts@@@
import { ComponentFixture, TestBed } from '@angular/core/testing';
import { provideHttpClient } from '@angular/common/http';
import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
import { Router } from '@angular/router';
import { AuthService } from '../../<#= servicesFolder #>/auth.service';
import { TenantSwitcherComponent } from './tenant-switcher.component';

const two = [{ id: 1, text: 'Acme', role: 'Administrator', current: true }, { id: 2, text: 'Globex', role: 'Employee', current: false }];

describe('TenantSwitcherComponent', () => {
  let fixture: ComponentFixture<TenantSwitcherComponent>;
  let http: HttpTestingController;
  let reloaded: number;

  const open = (choices: unknown[] | null) => {
    fixture.detectChanges();
    const request = http.expectOne('api/auth/tenants');
    if (choices) { request.flush(choices); } else { request.flush(null, { status: <#= HttpStatus.NotFound #>, statusText: 'Not Found' }); }
    fixture.detectChanges();
    return fixture.nativeElement as HTMLElement;
  };

  beforeEach(async () => {
    sessionStorage.clear();
    reloaded = 0;
    await TestBed.configureTestingModule({
      imports: [TenantSwitcherComponent],
      providers: [provideHttpClient(), provideHttpClientTesting(), { provide: Router, useValue: {} }]
    }).compileComponents();
    http = TestBed.inject(HttpTestingController);
    fixture = TestBed.createComponent(TenantSwitcherComponent);
    (fixture.componentInstance as unknown as { reload: () => void }).reload = () => { reloaded++; };
  });

  afterEach(() => http.verify());

  it('shows the name of the only tenant the person belongs to, without a choice', () => {
    const page = open([two[0]]);
    expect(page.querySelector('span.tenant')?.textContent).toBe('Acme');
    expect(page.querySelector('select')).toBeNull();
  });

  it('offers a drop-down with the current tenant chosen when the person belongs to several', () => {
    const page = open(two);
    const select = page.querySelector('select') as HTMLSelectElement;
    expect(Array.from(select.options).map((o) => o.textContent)).toEqual(['Acme', 'Globex']);
    expect(select.options[0].selected).toBe(true);
  });

  it('asks for a token for the chosen tenant, keeps it and starts the app again', () => {
    const page = open(two);
    const select = page.querySelector('select') as HTMLSelectElement;
    select.value = '2';
    select.dispatchEvent(new Event('change'));

    const request = http.expectOne('api/auth/switch-tenant');
    expect(request.request.method).toBe('POST');
    expect(request.request.body).toEqual({ tenantId: 2 });
    request.flush({ token: 'def', user: { name: 'Pat', tenantId: 2 } });

    expect(TestBed.inject(AuthService).token).toBe('def');
    expect(reloaded).toBe(1);
  });

  it('shows nothing when the API has no tenants route', () => {
    const page = open(null);
    expect(page.querySelector('.tenant')).toBeNull();
  });
});
<# } #>
