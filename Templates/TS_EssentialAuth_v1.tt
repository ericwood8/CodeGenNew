<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // TS_EssentialAuth_v1.tt
    // Generates: the sign-in of an Angular app   (no table, no database: an essentials group, not ticked by default; Auth=true in the project turns it on)
    //   <ServicesFolder>/auth.service.ts      the session (token and user in sessionStorage, so the sign-in ends with the tab), login(), logout(), user, isLoggedIn;
    //   <ServicesFolder>/auth.interceptor.ts  adds Authorization: Bearer to every call to api/ and signs the person out when the API answers 401;
    //   <ServicesFolder>/auth.guard.ts        sends a person who is not signed in to /login;
    //   <ModelsFolder>/auth.ts                AuthUser and LoginResponse;
    //   <ComponentsFolder>/login/             the sign-in page.
    // The API answers POST api/auth/login with { token, expiresUtc, user: { name, ... } } (a 401 for a wrong password, a 429 for too many tries). The user table, password hashing and the first
    // administrator stay hand-written. With Auth=true the Config group adds the interceptor, TS_Screens puts the guard on every generated route and the Shell shows the user with Sign out.
    // Needs nothing but Angular and RxJS. Full notes: Docs/TemplateNotes/TS_EssentialAuth_v1.md
    // ==========================================================================================
    string servicesFolder = Project.ServicesFolder;
    string modelsFolder = Project.ModelsFolder;
    string componentsFolder = Project.ComponentsFolder;
    string storageKey = (Project.ProjectName ?? "app").ToLowerInvariant() + ".auth";
    bool controlFlow = Project.AngularControlFlow;
    string loginHtml = Project.AdaptAngularHtml(@"<div class=""login-container"">
  <h1>Sign in</h1>
  <form (ngSubmit)=""signIn()"" #loginForm=""ngForm"">
    <div class=""form-group"">
      <label for=""userName"">User name</label>
      <input id=""userName"" name=""userName"" type=""text"" [(ngModel)]=""userName"" autocomplete=""username"" required autofocus>
    </div>
    <div class=""form-group"">
      <label for=""password"">Password</label>
      <input id=""password"" name=""password"" type=""password"" [(ngModel)]=""password"" autocomplete=""current-password"" required>
    </div>
    <p class=""error"" role=""alert"" *ngIf=""message"">{{ message }}</p>
    <button type=""submit"" class=""btn"" [disabled]=""busy || !loginForm.form.valid"">Sign in</button>
  </form>
</div>
");
#>
@@@FILE src/app/<#= modelsFolder #>/auth.ts@@@
/** Who is signed in. The API sends at least the name; anything else it sends (a role, an employee id) is kept and can be read as `user['role']`. */
export interface AuthUser {
  name: string;
  role?: string;
  [key: string]: unknown;
}

/** What POST api/auth/login answers. */
export interface LoginResponse {
  token: string;
  /** When the token stops being good (UTC, ISO 8601); a session that is past it is dropped on the next visit. */
  expiresUtc?: string;
  user: AuthUser;
}
@@@FILE src/app/<#= servicesFolder #>/auth.service.ts@@@
import { Injectable, computed, inject, signal } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { Router } from '@angular/router';
import { Observable, tap } from 'rxjs';
import { AuthUser, LoginResponse } from '../<#= modelsFolder #>/auth';

const storageKey = '<#= storageKey #>';

/** The session saved by an earlier visit of this tab, unless it has expired or cannot be read. */
function restore(): LoginResponse | null {
  try {
    const saved = sessionStorage.getItem(storageKey);
    if (!saved) { return null; }
    const response = JSON.parse(saved) as LoginResponse;
    if (response.expiresUtc && new Date(response.expiresUtc).getTime() <= Date.now()) {
      sessionStorage.removeItem(storageKey);
      return null;
    }
    return response.token ? response : null;
  } catch {
    return null;
  }
}

@Injectable({ providedIn: 'root' })
export class AuthService {
  private readonly http = inject(HttpClient);
  private readonly router = inject(Router);
  private readonly session = signal<LoginResponse | null>(restore());

  readonly user = computed<AuthUser | null>(() => this.session()?.user ?? null);
  readonly isLoggedIn = computed(() => this.session() !== null);

  get token(): string | null {
    return this.session()?.token ?? null;
  }

  login(userName: string, password: string): Observable<LoginResponse> {
    return this.http.post<LoginResponse>('api/auth/login', { userName, password }).pipe(
      tap((response) => {
        this.session.set(response);
        // sessionStorage: the sign-in ends when the tab closes
        try { sessionStorage.setItem(storageKey, JSON.stringify(response)); } catch { /* storage unavailable: the sign-in lasts until the page is reloaded */ }
      })
    );
  }

  logout(): void {
    this.session.set(null);
    try { sessionStorage.removeItem(storageKey); } catch { /* nothing saved */ }
    this.router.navigate(['/login']);
  }
}
@@@FILE src/app/<#= servicesFolder #>/auth.interceptor.ts@@@
import { HttpErrorResponse, HttpInterceptorFn } from '@angular/common/http';
import { inject } from '@angular/core';
import { catchError, throwError } from 'rxjs';
import { AuthService } from './auth.service';

/** Sends the token with every call to the API, and signs the person out when the API says it is no longer good. */
export const authInterceptor: HttpInterceptorFn = (request, next) => {
  const auth = inject(AuthService);
  const isApiCall = request.url.startsWith('api/');
  const token = auth.token;

  if (isApiCall && token) {
    request = request.clone({ setHeaders: { Authorization: `Bearer ${token}` } });
  }

  return next(request).pipe(
    catchError((error: HttpErrorResponse) => {
      if (error.status === 401 && isApiCall && !request.url.endsWith('/auth/login')) {
        auth.logout();
      }
      return throwError(() => error);
    })
  );
};
@@@FILE src/app/<#= servicesFolder #>/auth.guard.ts@@@
import { inject } from '@angular/core';
import { CanActivateFn, Router } from '@angular/router';
import { AuthService } from './auth.service';

/** Lets a signed-in person through; anyone else goes to the sign-in page. */
export const authGuard: CanActivateFn = () => {
  const auth = inject(AuthService);
  return auth.isLoggedIn() ? true : inject(Router).createUrlTree(['/login']);
};
@@@FILE src/app/<#= componentsFolder #>/login/login.component.ts@@@
import { ChangeDetectionStrategy, Component, inject } from '@angular/core';
<# if (!controlFlow) { #>
import { NgIf } from '@angular/common';
<# } #>
import { FormsModule } from '@angular/forms';
import { Router } from '@angular/router';
import { AuthService } from '../../<#= servicesFolder #>/auth.service';

@Component({
  selector: 'app-login',
<# if (Project.AngularStandaloneFlag) { #>
  standalone: true,
<# } #>
  changeDetection: ChangeDetectionStrategy.<#= Project.AngularEagerStrategy #>, // plain properties change inside subscribe callbacks
  imports: [FormsModule<#= controlFlow ? "" : ", NgIf" #>],
  templateUrl: './login.component.html',
  styleUrl: './login.component.css'
})
export class LoginComponent {
  private readonly auth = inject(AuthService);
  private readonly router = inject(Router);

  userName = '';
  password = '';
  message = '';
  busy = false;

  signIn(): void {
    this.message = '';
    this.busy = true;
    this.auth.login(this.userName, this.password).subscribe({
      next: () => {
        this.busy = false;
        this.router.navigate(['/']);
      },
      error: (error) => {
        this.busy = false;
        this.password = '';
        if (error.status === 429) { this.message = 'Too many tries. Wait a minute and try again.'; }
        else if (error.status === 401) { this.message = 'The user name or password is not right.'; }
        else { this.message = 'Could not sign in right now.'; }
      }
    });
  }
}
@@@FILE src/app/<#= componentsFolder #>/login/login.component.html@@@
