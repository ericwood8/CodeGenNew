import { TestBed } from '@angular/core/testing';
import { provideHttpClient } from '@angular/common/http';
import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
import { Router } from '@angular/router';
import { AuthService } from './auth.service';

const storageKey = '<#= storageKey #>';
const response = { token: 'abc', expiresUtc: '2999-01-01T00:00:00Z', user: { name: 'Pat' } };

describe('AuthService', () => {
  let http: HttpTestingController;
  let navigated: unknown[][];

  beforeEach(() => {
    sessionStorage.clear();
    navigated = [];
    TestBed.configureTestingModule({
      providers: [provideHttpClient(), provideHttpClientTesting(), { provide: Router, useValue: { navigate: (commands: unknown[]) => { navigated.push(commands); return Promise.resolve(true); } } }]
    });
    http = TestBed.inject(HttpTestingController);
  });

  afterEach(() => http.verify());

  it('starts signed out', () => {
    const auth = TestBed.inject(AuthService);
    expect(auth.isLoggedIn()).toBe(false);
    expect(auth.token).toBeNull();
    expect(auth.user()).toBeNull();
  });

  it('signs in: posts the name and password, keeps the token and the user, and remembers them for the tab', () => {
    const auth = TestBed.inject(AuthService);
    auth.login('pat', 'secret').subscribe();
    const request = http.expectOne('api/auth/login');
    expect(request.request.method).toBe('POST');
    expect(request.request.body).toEqual({ userName: 'pat', password: 'secret' });
    request.flush(response);

    expect(auth.isLoggedIn()).toBe(true);
    expect(auth.token).toBe('abc');
    expect(auth.user()?.name).toBe('Pat');
    expect(JSON.parse(sessionStorage.getItem(storageKey) ?? 'null').token).toBe('abc');
  });

  it('stays signed out when the API refuses the sign-in', () => {
    const auth = TestBed.inject(AuthService);
    auth.login('pat', 'wrong').subscribe({ error: () => undefined });
    http.expectOne('api/auth/login').flush(null, { status: <#= HttpStatus.Unauthorized #>, statusText: 'Unauthorized' });

    expect(auth.isLoggedIn()).toBe(false);
    expect(sessionStorage.getItem(storageKey)).toBeNull();
  });

  it('signs out: forgets the session and goes to the sign-in page', () => {
    const auth = TestBed.inject(AuthService);
    auth.login('pat', 'secret').subscribe();
    http.expectOne('api/auth/login').flush(response);

    auth.logout();

    expect(auth.isLoggedIn()).toBe(false);
    expect(sessionStorage.getItem(storageKey)).toBeNull();
    expect(navigated).toEqual([['/login']]);
  });

  it('says whether the signed-in person has one of the roles', () => {
    const auth = TestBed.inject(AuthService);
    expect(auth.hasRole(['Manager'])).toBe(false);
    auth.login('pat', 'secret').subscribe();
    http.expectOne('api/auth/login').flush({ ...response, user: { name: 'Pat', role: 'Manager' } });

    expect(auth.hasRole(['Administrator', 'Manager'])).toBe(true);
    expect(auth.hasRole(['Administrator'])).toBe(false);
    expect(auth.hasRole([])).toBe(false);
  });

  it('picks up a session saved by an earlier visit of the tab', () => {
    sessionStorage.setItem(storageKey, JSON.stringify(response));
    const auth = TestBed.inject(AuthService);

    expect(auth.isLoggedIn()).toBe(true);
    expect(auth.user()?.name).toBe('Pat');
  });

  it('drops a session that has expired or cannot be read', () => {
    sessionStorage.setItem(storageKey, JSON.stringify({ ...response, expiresUtc: '2000-01-01T00:00:00Z' }));
    expect(TestBed.inject(AuthService).isLoggedIn()).toBe(false);
    expect(sessionStorage.getItem(storageKey)).toBeNull();

    TestBed.resetTestingModule();
    sessionStorage.setItem(storageKey, '{not json');
    TestBed.configureTestingModule({ providers: [provideHttpClient(), provideHttpClientTesting(), { provide: Router, useValue: {} }] });
    expect(TestBed.inject(AuthService).isLoggedIn()).toBe(false);
  });
});
@@@FILE src/app/<#= servicesFolder #>/auth.interceptor.spec.ts@@@
import { TestBed } from '@angular/core/testing';
import { HttpClient, provideHttpClient, withInterceptors } from '@angular/common/http';
import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
import { Router } from '@angular/router';
import { authInterceptor } from './auth.interceptor';

const storageKey = '<#= storageKey #>';

describe('authInterceptor', () => {
  let http: HttpTestingController;
  let client: HttpClient;
  let navigated: unknown[][];

  beforeEach(() => {
    sessionStorage.clear();
    sessionStorage.setItem(storageKey, JSON.stringify({ token: 'abc', user: { name: 'Pat' } }));
    navigated = [];
    TestBed.configureTestingModule({
      providers: [
        provideHttpClient(withInterceptors([authInterceptor])),
        provideHttpClientTesting(),
        { provide: Router, useValue: { navigate: (commands: unknown[]) => { navigated.push(commands); return Promise.resolve(true); } } }
      ]
    });
    http = TestBed.inject(HttpTestingController);
    client = TestBed.inject(HttpClient);
  });

  afterEach(() => http.verify());

  it('sends the token with a call to the API', () => {
    client.get('api/things').subscribe();
    expect(http.expectOne('api/things').request.headers.get('Authorization')).toBe('Bearer abc');
  });

  it('sends the token with a call to the OData routes too', () => {
    client.get('odata/things?$top=1').subscribe();
    expect(http.expectOne('odata/things?$top=1').request.headers.get('Authorization')).toBe('Bearer abc');
  });

  it('does not send the token anywhere else', () => {
    client.get('https://example.com/other').subscribe();
    expect(http.expectOne('https://example.com/other').request.headers.has('Authorization')).toBe(false);
  });

  it('signs the person out when the API answers 401', () => {
    client.get('api/things').subscribe({ error: () => undefined });
    http.expectOne('api/things').flush(null, { status: <#= HttpStatus.Unauthorized #>, statusText: 'Unauthorized' });

    expect(sessionStorage.getItem(storageKey)).toBeNull();
    expect(navigated).toEqual([['/login']]);
  });

  it('leaves a refused sign-in to the login page', () => {
    client.post('api/auth/login', {}).subscribe({ error: () => undefined });
    http.expectOne('api/auth/login').flush(null, { status: <#= HttpStatus.Unauthorized #>, statusText: 'Unauthorized' });

    expect(navigated).toEqual([]);
  });

  it('passes other errors on unchanged', () => {
    let status = 0;
    client.get('api/things').subscribe({ error: (error) => { status = error.status; } });
    http.expectOne('api/things').flush(null, { status: <#= HttpStatus.InternalServerError #>, statusText: 'Server Error' });

    expect(status).toBe(<#= HttpStatus.InternalServerError #>);
    expect(navigated).toEqual([]);
  });
});
@@@FILE src/app/<#= servicesFolder #>/auth.guard.spec.ts@@@
import { TestBed } from '@angular/core/testing';
import { provideHttpClient } from '@angular/common/http';
import { provideHttpClientTesting } from '@angular/common/http/testing';
import { ActivatedRouteSnapshot, RouterStateSnapshot, Router } from '@angular/router';
import { authGuard } from './auth.guard';

const storageKey = '<#= storageKey #>';
const login = { target: '/login' };

describe('authGuard', () => {
  const run = () => TestBed.runInInjectionContext(() => authGuard({} as ActivatedRouteSnapshot, {} as RouterStateSnapshot));

  beforeEach(() => {
    sessionStorage.clear();
    TestBed.configureTestingModule({
      providers: [provideHttpClient(), provideHttpClientTesting(), { provide: Router, useValue: { createUrlTree: (commands: string[]) => ({ target: commands[0] }) } }]
    });
  });

  it('sends a person who is not signed in to the sign-in page', () => {
    expect(run()).toEqual(login as never);
  });

  it('lets a signed-in person through', () => {
    sessionStorage.setItem(storageKey, JSON.stringify({ token: 'abc', user: { name: 'Pat' } }));
    expect(run()).toBe(true);
  });
});
