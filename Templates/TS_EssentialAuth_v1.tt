import { ComponentFixture, TestBed } from '@angular/core/testing';
import { provideHttpClient } from '@angular/common/http';
import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
import { Router } from '@angular/router';
import { LoginComponent } from './login.component';

describe('LoginComponent', () => {
  let component: LoginComponent;
  let fixture: ComponentFixture<LoginComponent>;
  let http: HttpTestingController;
  let navigated: unknown[][];

  beforeEach(async () => {
    sessionStorage.clear();
    navigated = [];
    await TestBed.configureTestingModule({
      imports: [LoginComponent],
      providers: [provideHttpClient(), provideHttpClientTesting(), { provide: Router, useValue: { navigate: (commands: unknown[]) => { navigated.push(commands); return Promise.resolve(true); } } }]
    }).compileComponents();
    http = TestBed.inject(HttpTestingController);
    fixture = TestBed.createComponent(LoginComponent);
    component = fixture.componentInstance;
    fixture.detectChanges();
  });

  afterEach(() => http.verify());

  const submit = (status: number<# if (tenants) { #>, tenant: number | null = null<# } #>) => {
    component.userName = 'pat';
    component.password = 'secret';
<# if (tenants) { #>
    component.tenant = tenant;
<# } #>
    component.signIn();
    const request = http.expectOne('api/auth/login');
    const body = request.request.body;
    if (status === <#= HttpStatus.Ok #>) { request.flush({ token: 'abc', user: { name: 'Pat' } }); }
    else { request.flush(null, { status, statusText: 'x' }); }
    return body;
  };

  it('should create', () => {
    expect(component).toBeTruthy();
  });

  it('goes to the first screen after a sign-in', () => {
    submit(<#= HttpStatus.Ok #>);
    expect(component.busy).toBe(false);
    expect(navigated).toEqual([['/']]);
  });

  it('says the name or password is wrong on a 401 and clears the password', () => {
    submit(<#= HttpStatus.Unauthorized #>);
    expect(component.message).toBe('The user name or password is not right.');
    expect(component.password).toBe('');
    expect(navigated).toEqual([]);
  });

  it('says to wait on a 429', () => {
    submit(<#= HttpStatus.TooManyRequests #>);
    expect(component.message).toBe('Too many tries. Wait a minute and try again.');
  });

  it('has a general message for anything else', () => {
    submit(<#= HttpStatus.InternalServerError #>);
    expect(component.message).toBe('Could not sign in right now.');
  });
<# if (tenants) { #>

  it('posts the tenant that is typed and nothing when the box is empty', () => {
    expect(submit(<#= HttpStatus.Ok #>, 2)).toEqual({ userName: 'pat', password: 'secret', tenantId: 2 });
    expect(submit(<#= HttpStatus.Ok #>)).toEqual({ userName: 'pat', password: 'secret' });
  });

  it('says the tenant is not one of theirs on a <#= HttpStatus.Forbidden #>', () => {
    submit(<#= HttpStatus.Forbidden #>, 3);
    expect(component.message).toBe('<#= TenantWords.SignInRefused #>');
    expect(navigated).toEqual([]);
  });
<# } #>
});
