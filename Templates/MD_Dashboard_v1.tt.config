# Restriction checkboxes for MD_Dashboard_v1.tt (see Docs/Reference.md section 3).
# One page for the whole database: the menu offers it on the database, the CLI runs it without -t.
DatabaseOnly=true
RequiresPrimaryKey=false
TableOnly=false
# No OutputName: the template writes its own path (Dashboard.md) with an @@@FILE marker.
# Whole-project generation (codegen generate): written only for a project with Dashboard=true.
Stacks=Api
OutputFolder=docs
InPlan=false
