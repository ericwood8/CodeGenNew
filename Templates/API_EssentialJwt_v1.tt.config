# Restriction checkboxes for API_EssentialJwt_v1.tt (see Docs/Reference.md section 3).
# One of the files an API can have: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`;
# a project that says ApiAuth=true gets it with every `codegen generate --essentials`.
Scope=None
Stacks=Api
EssentialsGroup=Jwt
EssentialsDefault=false
Description=Sign-in (ApiAuth=true): Apis/Auth.cs (POST /api/auth/login, JWT bearer wiring, the user directory, password hashing) and Apis/OwnerScope.cs
