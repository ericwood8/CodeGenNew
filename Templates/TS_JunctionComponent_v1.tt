<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string componentsFolder = Project.ComponentsFolder;
    string apiPrefix = "api";
    // ==========================================================================================

    // ==========================================================================================
    // TS_JunctionComponent_v1.tt
    // Generates the four files of an Angular standalone component in components/<table>-junction/ (css, html, spec.ts, ts; the paths are written by the template)
    // The two-list available/selected shuttle for a many-to-many junction table, calling the routes API_Junction writes.
    // Needs a table detected as a junction table (TableModel.IsJunctionTable).
    // Full notes: Docs/TemplateNotes/TS_JunctionComponent_v1.md


    if (!Model.IsJunctionTable)
        Error($"TS_JunctionComponent cannot generate from [{Model.SchemaName}].[{Model.TableName}]: it is not a many-to-many junction table - TableModel.IsJunctionTable is false.");
    if (!Model.HasReferencedDisplayColumns)
        Error("TS_JunctionComponent needs the target table's display columns; its .tt.config must say NeedsReferencedDisplayColumns=true.");

    var junction = Model.Junction!;   // the anchor and target sides, in Core
    string anchorTs = junction.AnchorTs;
    string targetTs = junction.TargetTs;
    string targetRole = junction.TargetRole;

    string baseName = BaseName(Model.TableName);
    string stem = baseName.ToLowerInvariant();
    string cls = baseName + "JunctionComponent";
    var displayColumns = junction.DisplayColumns.Select(LowerFirst).ToList(); // camelCase, matching TS_Model's JSON-casing convention

    var css = new StringBuilder();
    var html = new StringBuilder();
    var spec = new StringBuilder();
    var ts = new StringBuilder();
    void H(string s = "") => html.Append(s).Append('\n');
    void T(string s = "") => ts.Append(s).Append('\n');

    // ================= html
    H("<div class=\"main\">");
    H($"  <h1>{targetRole}</h1>");
    H("  <div class=\"shuttle-control\">");
    H("    <div class=\"shuttle-list\">");
    H("      <label>Available</label>");
    H("      <select multiple class=\"form-control\" size=\"10\" [(ngModel)]=\"availableSelectionIds\">");
    H("        <option *ngFor=\"let item of available\" [ngValue]=\"item.targetId\">{{ displayText(item) }}</option>");
    H("      </select>");
    H("    </div>");
    H("    <div class=\"shuttle-buttons\">");
    H("      <button class=\"btn\" (click)=\"addAll()\" title=\"Add all\">&gt;&gt;</button>");
    H("      <button class=\"btn\" (click)=\"addSelected()\" title=\"Add selected\">&gt;</button>");
    H("      <button class=\"btn\" (click)=\"removeSelected()\" title=\"Remove selected\">&lt;</button>");
    H("      <button class=\"btn\" (click)=\"removeAll()\" title=\"Remove all\">&lt;&lt;</button>");
    H("    </div>");
    H("    <div class=\"shuttle-list\">");
    H("      <label>Selected</label>");
    H("      <select multiple class=\"form-control\" size=\"10\" [(ngModel)]=\"selectedSelectionIds\">");
    H("        <option *ngFor=\"let item of selected\" [ngValue]=\"item.targetId\">{{ displayText(item) }}</option>");
    H("      </select>");
    H("    </div>");
    H("  </div>");
    H("</div>");

    // ================= ts
    T("import { ChangeDetectionStrategy, Component, Input, OnChanges, OnInit, SimpleChanges } from '@angular/core';");
    T("import { HttpClient } from '@angular/common/http';");
    T("import { CommonModule } from '@angular/common';");
    T("import { FormsModule } from '@angular/forms';");
    T();
    T($"export interface {baseName}JunctionItem {{");
    T($"  targetId: {targetTs};");
    T("  isSelected: boolean;");
    foreach (string d in displayColumns)
        T($"  {d}?: string;");
    T("}");
    T();
    T("@Component({");
    T($"  selector: 'app-{stem}-junction',");
    if (Project.AngularStandaloneFlag) T("  standalone: true,");
    T($"  changeDetection: ChangeDetectionStrategy.{Project.AngularEagerStrategy}, // plain properties change inside subscribe callbacks: keep eager checking when OnPush is the default (Angular 22)");
    T("  imports: [ CommonModule, FormsModule ],");
    T($"  templateUrl: './{stem}-junction.component.html',");
    T($"  styleUrl: './{stem}-junction.component.css'");
    T("})");
    T($"export class {cls} implements OnInit, OnChanges {{");
    T($"  @Input({{ required: true }}) anchorId!: {anchorTs};");
    T();
    T($"  available: {baseName}JunctionItem[] = [];");
    T($"  selected: {baseName}JunctionItem[] = [];");
    T($"  availableSelectionIds: {targetTs}[] = [];");
    T($"  selectedSelectionIds: {targetTs}[] = [];");
    T();
    T($"  private apiUrl = '{apiPrefix}/{stem.Pluralize()}/junction'; // Replace with your API URL");
    T();
    T("  constructor(private http: HttpClient) { }");
    T();
    T("  ngOnInit(): void {");
    T("    this.load();");
    T("  }");
    T();
    T("  // another anchor row: the lists are read again");
    T("  ngOnChanges(changes: SimpleChanges): void {");
    T("    if (changes['anchorId'] && !changes['anchorId'].firstChange) {");
    T("      this.load();");
    T("    }");
    T("  }");
    T();
    T("  private load(): void {");
    T($"    this.http.get<{baseName}JunctionItem[]>(`${{this.apiUrl}}/${{this.anchorId}}`).subscribe((rows) => {{");
    T("      this.available = rows.filter((r) => !r.isSelected);");
    T("      this.selected = rows.filter((r) => r.isSelected);");
    T("    });");
    T("  }");
    T();
    T($"  displayText(item: {baseName}JunctionItem): string {{");
    T($"    return [{string.Join(", ", displayColumns.Select(d => $"item.{d}"))}].filter((v) => !!v).join(' ');");
    T("  }");
    T();
    T("  addSelected(): void {");
    T("    this.link(this.available.filter((r) => this.availableSelectionIds.includes(r.targetId)));");
    T("  }");
    T();
    T("  addAll(): void {");
    T("    this.link(this.available);");
    T("  }");
    T();
    T("  removeSelected(): void {");
    T("    this.unlink(this.selected.filter((r) => this.selectedSelectionIds.includes(r.targetId)));");
    T("  }");
    T();
    T("  removeAll(): void {");
    T("    this.unlink(this.selected);");
    T("  }");
    T();
    T($"  private link(items: {baseName}JunctionItem[]): void {{");
    T("    for (const item of items) {");
    T("      this.http.post(`${this.apiUrl}/link`, { anchorId: this.anchorId, targetId: item.targetId }).subscribe(() => {");
    T("        this.available = this.available.filter((r) => r !== item);");
    T("        this.selected = [...this.selected, item];");
    T("      });");
    T("    }");
    T("    this.availableSelectionIds = [];");
    T("  }");
    T();
    T($"  private unlink(items: {baseName}JunctionItem[]): void {{");
    T("    for (const item of items) {");
    T("      this.http.post(`${this.apiUrl}/unlink`, { anchorId: this.anchorId, targetId: item.targetId }).subscribe(() => {");
    T("        this.selected = this.selected.filter((r) => r !== item);");
    T("        this.available = [...this.available, item];");
    T("      });");
    T("    }");
    T("    this.selectedSelectionIds = [];");
    T("  }");
    T("}");

    // ================= spec
    spec.Append("import { ComponentFixture, TestBed } from '@angular/core/testing';\nimport { provideHttpClient } from '@angular/common/http';\nimport { provideHttpClientTesting } from '@angular/common/http/testing';\n\n");
    spec.Append($"import {{ {cls} }} from './{stem}-junction.component';\n\n");
    spec.Append($"describe('{cls}', () => {{\n  let component: {cls};\n  let fixture: ComponentFixture<{cls}>;\n\n");
    spec.Append($"  beforeEach(async () => {{\n    await TestBed.configureTestingModule({{\n      imports: [{cls}],\n      providers: [provideHttpClient(), provideHttpClientTesting()]\n    }})\n    .compileComponents();\n\n");
    spec.Append($"    fixture = TestBed.createComponent({cls});\n    component = fixture.componentInstance;\n    component.anchorId = {(anchorTs == "string" ? "'00000000-0000-0000-0000-000000000000'" : "0")};\n    fixture.detectChanges();\n  }});\n\n");
    spec.Append("  it('should create', () => {\n    expect(component).toBeTruthy();\n  });\n});\n");

    var o = new StringBuilder();
    // outer line round each list, a line under every row, and the buttons on a shaded bar
    css.Append(".shuttle-control { display: flex; gap: 12px; align-items: center; }\n");
    css.Append(".shuttle-list select { min-width: 200px; border: 1px solid #8886; }\n");
    css.Append(".shuttle-list option { padding: 4px 6px; border-bottom: 1px solid #8884; }\n");
    css.Append(".shuttle-buttons { display: flex; flex-direction: column; gap: 8px; padding: 8px; background: #8883; border: 1px solid #8886; border-radius: 4px; }\n");
    css.Append(".shuttle-buttons button { font-weight: 700; }\n");
    o.Append($"@@@FILE {componentsFolder}/{stem}-junction/{stem}-junction.component.css@@@\n").Append(css);
    o.Append($"@@@FILE {componentsFolder}/{stem}-junction/{stem}-junction.component.html@@@\n").Append(Project.AdaptAngularHtml(html.ToString()));
    o.Append($"@@@FILE {componentsFolder}/{stem}-junction/{stem}-junction.component.spec.ts@@@\n").Append(Project.AdaptAngularSpec(spec.ToString()));
    o.Append($"@@@FILE {componentsFolder}/{stem}-junction/{stem}-junction.component.ts@@@\n").Append(ts);

    // The screen the menu opens (JunctionPlan in Core): a drop-down of the anchor's rows and the shuttle for the row picked.
    if (JunctionPlan.HasPage(Model, Project))
    {
        string linksClass = JunctionPlan.AngularClass(Model.TableName);
        string linksStem = JunctionPlan.AngularStem(Model.TableName);
        string anchorLabel = Labels.Words(BaseName(junction.AnchorRole));
        string anchorTsType = anchorTs;
        var lh = new StringBuilder();
        void LH(string s = "") => lh.Append(s).Append('\n');
        LH("<div class=\"main\">");
        LH($"  <h1>{JunctionPlan.Heading(Model)}</h1>");
        LH($"  <label>{anchorLabel}");
        LH($"    <select class=\"form-control\" aria-label=\"{anchorLabel}\" (change)=\"pick($any($event.target).selectedIndex)\">");
        LH($"      <option value=\"\">Choose a {anchorLabel.ToLowerInvariant()}</option>");
        LH("      <option *ngFor=\"let a of anchors\" [value]=\"a.id\">{{ a.name }}</option>");
        LH("    </select>");
        LH("  </label>");
        LH("  <p *ngIf=\"error\" role=\"alert\">{{ error }}</p>");
        LH($"  <app-{stem}-junction *ngIf=\"anchorId !== null\" [anchorId]=\"anchorId\"></app-{stem}-junction>");
        LH("</div>");
        var lt = new StringBuilder();
        void LT(string s = "") => lt.Append(s).Append('\n');
        LT("import { ChangeDetectionStrategy, Component, OnInit } from '@angular/core';");
        LT("import { HttpClient } from '@angular/common/http';");
        LT("import { CommonModule } from '@angular/common';");
        LT($"import {{ {cls} }} from '../{stem}-junction/{stem}-junction.component';");
        LT();
        LT("@Component({");
        LT($"  selector: 'app-{linksStem}',");
        if (Project.AngularStandaloneFlag) LT("  standalone: true,");
        LT($"  changeDetection: ChangeDetectionStrategy.{Project.AngularEagerStrategy}, // plain properties change inside subscribe callbacks: keep eager checking when OnPush is the default (Angular 22)");
        LT($"  imports: [ CommonModule, {cls} ],");
        LT($"  templateUrl: './{linksStem}.component.html'");
        LT("})");
        LT($"export class {linksClass} implements OnInit {{");
        LT($"  anchors: {{ id: {anchorTsType}; name: string }}[] = [];");
        LT($"  anchorId: {anchorTsType} | null = null;");
        LT("  error: string | null = null;");
        LT();
        LT("  constructor(private http: HttpClient) { }");
        LT();
        LT("  ngOnInit(): void {");
        LT($"    this.http.get<{{ id: {anchorTsType}; name: string }}[]>('{JunctionPlan.AnchorLookupRoute(Model).TrimStart('/')}').subscribe({{");
        LT("      next: (rows) => { this.anchors = rows; },");
        LT($"      error: () => {{ this.error = 'Failed to load the {anchorLabel.ToLowerInvariant().Pluralize()}.'; }}");
        LT("    });");
        LT("  }");
        LT();
        LT("  // index 0 is the \"Choose\" entry");
        LT("  pick(index: number): void {");
        LT("    this.anchorId = index > 0 ? this.anchors[index - 1].id : null;");
        LT("  }");
        LT("}");
        var ls = new StringBuilder();
        ls.Append("import { ComponentFixture, TestBed } from '@angular/core/testing';\nimport { provideHttpClient } from '@angular/common/http';\nimport { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';\n\n");
        ls.Append($"import {{ {linksClass} }} from './{linksStem}.component';\n\n");
        ls.Append($"describe('{linksClass}', () => {{\n  let fixture: ComponentFixture<{linksClass}>;\n\n");
        ls.Append($"  beforeEach(async () => {{\n    await TestBed.configureTestingModule({{\n      imports: [{linksClass}],\n      providers: [provideHttpClient(), provideHttpClientTesting()]\n    }})\n    .compileComponents();\n\n");
        ls.Append($"    fixture = TestBed.createComponent({linksClass});\n    fixture.detectChanges();\n  }});\n\n");
        ls.Append($"  it('asks for an anchor row before it shows the lists', () => {{\n    const http = TestBed.inject(HttpTestingController);\n    http.expectOne('{JunctionPlan.AnchorLookupRoute(Model).TrimStart('/')}').flush([{{ id: {(anchorTs == "string" ? "'a'" : "1")}, name: 'First' }}]);\n    fixture.detectChanges();\n    const text = fixture.nativeElement.textContent as string;\n    expect(text).toContain('{JunctionPlan.Heading(Model)}');\n    expect(text).toContain('First');\n    expect(text).not.toContain('Available');\n  }});\n}});\n");
        o.Append($"@@@FILE {componentsFolder}/{linksStem}/{linksStem}.component.html@@@\n").Append(Project.AdaptAngularHtml(lh.ToString()));
        o.Append($"@@@FILE {componentsFolder}/{linksStem}/{linksStem}.component.spec.ts@@@\n").Append(Project.AdaptAngularSpec(ls.ToString()));
        o.Append($"@@@FILE {componentsFolder}/{linksStem}/{linksStem}.component.ts@@@\n").Append(lt);
    }
    Write(o.ToString());
#>
