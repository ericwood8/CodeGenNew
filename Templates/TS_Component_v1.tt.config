# Restriction checkboxes for TS_Component_v1.tt (see Docs/Reference.md section 3).
# The screen edits rows by their primary key, taken as {id:int}, {id:guid} or {id} (a text key).
RequiresPrimaryKey=true
TableOnly=true
RequiredPrimaryKeyShape=SingleIntGuidOrText
# The drop-downs for foreign keys show the parent table's display column, so ask for it.
NeedsReferencedDisplayColumns=true
# No OutputName: the template writes its own paths (components/<table>/...) with @@@FILE markers.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Angular
PlanTables=ScreenForm
OutputFolder=src/app
