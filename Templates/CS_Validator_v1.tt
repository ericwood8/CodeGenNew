<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Globalization" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project. A project settings file (EntityNamespace, ValidatorNamespace, or ProjectName) overrides them.
    // ==========================================================================================
    string entityNamespace = Project.EntityNamespace ?? "MyApp.Common.Entities";
    string validatorNamespace = Project.ValidatorNamespace ?? "MyApp.Validators";

    // ==========================================================================================
    // CS_Validator_v1.tt
    // Generates: <TableName>Validator.cs   (see OutputName in CS_Validator_v1.tt.config)
    // A FluentValidation validator for the table's entity: AbstractValidator<Entity> with a rule per column that the schema says something about. Text that cannot be NULL must not be empty; text has
    // its maximum length; a whole number keeps to the range its name suggests or its CHECK constraint states; a decimal keeps to its CHECK range (a strict bound stays strict); a column with a CHECK
    // list allows only those values; a text column named like an email address, a phone number or a URL is checked for that shape, and a latitude or longitude for its degrees. Identity, computed,
    // audit and modified columns get no rule (the database or the repository sets them).
    // The consumer is yours: register the validators (services.AddValidatorsFromAssemblyContaining<...>()) and call them from an endpoint filter, the repository or a form; unlike the
    // [Required] / [StringLength] attributes of CS_Validation, nothing runs them for you. Needs the FluentValidation package, and the entity class (CS_Entity), so a primary key.
    // Full notes: Docs/TemplateNotes/CS_Validator_v1.md
    // ==========================================================================================

    if (Model.PrimaryKeyColumns.Count == 0)
    {
        Error($"CS_Validator needs a table with a primary key, but [{Model.SchemaName}].[{Model.TableName}] has none (the entity class is written for keyed tables).");
    }
    else
    {
        string Id(ColumnModel c) => c.CSharpName();
        string Str(string s) => "\"" + s.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";
        string Words(string name) => Labels.Words(name);
        // a number literal in the property's own type
        string Literal(ColumnModel c, double value) => c.SqlType switch
        {
            SqlDbType.Decimal or SqlDbType.Money or SqlDbType.SmallMoney => Num(value) + "m",
            SqlDbType.Float => Num(value).Contains('.') || Num(value).Contains('E') ? Num(value) : Num(value) + ".0",
            SqlDbType.Real => (Num(value).Contains('.') || Num(value).Contains('E') ? Num(value) : Num(value) + ".0") + "f",
            SqlDbType.BigInt => Num(value) + "L",
            SqlDbType.SmallInt => "(short)" + Num(value),
            SqlDbType.TinyInt => "(byte)" + Num(value),
            _ => Num(value)
        };

        var rules = new List<string>();
        var values = new List<string>();   // the allowed-value arrays, written above the constructor

        foreach (var c in Model.Columns.OrderBy(c => c.OrdinalPosition))
        {
            if (c.RuleOf(Project) is not { } rule)
                continue;

            var parts = new List<string>();
            string label = Words(c.Name);
            if (rule.Required)
                parts.Add(".NotEmpty()");
            if (rule.MaxLength > 0)
                parts.Add($".MaximumLength({rule.MaxLength})");
            if (rule.Choices is not null)
            {
                string array = c.Name.Replace("@", "") + "Values";
                values.Add($"    private static readonly string[] {array} = [{string.Join(", ", rule.Choices.Select(Str))}];");
                parts.Add($".Must(value => value is null || {array}.Contains(value)).WithMessage({Str(label + " must be one of: " + string.Join(", ", rule.Choices) + ".")})");
            }
            else if (rule.Shape == TextShape.Email)
            {
                parts.Add(".EmailAddress()");
            }
            else if (rule.Shape == TextShape.Phone)
            {
                parts.Add(".Matches(@\"^[0-9+()\\-.\\s]{3,25}$\").WithMessage(" + Str(label + " is not a phone number.") + ")");
            }
            else if (rule.Shape == TextShape.Url)
            {
                parts.Add(".Must(value => value is null || Uri.IsWellFormedUriString(value, UriKind.Absolute)).WithMessage(" + Str(label + " is not a URL.") + ")");
            }

            // a whole number or a latitude / longitude has both limits at once; a decimal's CHECK may state either, strictly or not
            bool bothLimits = c.IsIntegerColumn || c.Check is null;
            if (rule.HasRange && bothLimits)
            {
                parts.Add($".InclusiveBetween({Literal(c, rule.Min!.Value)}, {Literal(c, rule.Max!.Value)})");
            }
            else if (rule.HasRange)
            {
                if (rule.Min is { } min)
                    parts.Add($".{(rule.MinStrict ? "GreaterThan" : "GreaterThanOrEqualTo")}({Literal(c, min)})");
                if (rule.Max is { } max)
                    parts.Add($".{(rule.MaxStrict ? "LessThan" : "LessThanOrEqualTo")}({Literal(c, max)})");
            }

            rules.Add($"        RuleFor(x => x.{Id(c)}){string.Concat(parts)};");
        }

        var o = new StringBuilder();
        void L(string s = "") => o.Append(s).Append('\n');

        L("using FluentValidation;");
        L("using " + entityNamespace + ";");
        L();
        L("namespace " + validatorNamespace + ";");
        L();
        L("/// <summary> What the schema says about a " + Model.TableName + " row, as FluentValidation rules. </summary>");
        L("public class " + Model.TableName + "Validator : AbstractValidator<" + Model.TableName + ">");
        L("{");
        foreach (string v in values)
            L(v);
        if (values.Count > 0)
            L();
        L("    public " + Model.TableName + "Validator()");
        L("    {");
        foreach (string rule in rules)
            L(rule);
        L("    }");
        L("}");
        Write(o.ToString());
    }
#>
