namespace <#= viewModelNamespace #>;

/// <summary> One entry of a <#= table #>DetailDialog drop-down: an id plus the text to show for it. </summary>
public class <#= WinUI3Names.LookupOptionClass(table, "Detail", "int") #>
{
    public int Id { get; set; }
    public string Text { get; set; } = "";
}
<#
        // a drop-down over a parent whose key is not an int (a country or currency code, a GUID) has an option class of its own
        foreach (string optionKey in parents.Select(p => p.KeyCs).Where(k => k != "int").Distinct())
        {
#>

/// <summary> One entry of a <#= table #>DetailDialog drop-down whose ids are <#= optionKey #>: an id plus the text to show for it. </summary>
public class <#= WinUI3Names.LookupOptionClass(table, "Detail", optionKey) #>
{
    public <#= optionKey #> Id { get; set; }<#= optionKey == "string" ? " = \"\";" : "" #>
    public string Text { get; set; } = "";
}
<#
        }
#>

public partial class <#= table #>DetailViewModel : ObservableObject
{
    private readonly <#= contextType #> _context;
    private readonly <#= table #>Repo _repo;
    private readonly <#= table #>? _editing;

    public string DialogTitle => _editing is null ? "Add <#= title #>" : "Edit <#= title #>";
<#
        if (textKey)
        {
#>
    /// <summary> True when the row was read from the database: its key can no longer be changed. </summary>
    public bool IsExisting => _editing is not null;
<#
        }
#>

<#
        foreach (var p in parents.Where(p => !p.TypeAhead))
        {
#>
    public ObservableCollection<<#= WinUI3Names.LookupOptionClass(table, "Detail", p.KeyCs) #>> <#= WinUI3Names.OptionsProperty(p) #> { get; } = [];
<#
        }
        if (aheadParents.Count > 0)
        {
#>
    // A DbContext is not thread-safe: loading the dialog and the suggestions of a type-ahead take turns.
    private readonly System.Threading.SemaphoreSlim _gate = new(1, 1);

<#
        }
        foreach (var c in aheadColumns)
        {
#>
    /// <summary> What the <#= Labels.Column(c.Name) #> box shows: what was typed, or the name of the row that was picked. </summary>
    [ObservableProperty]
    private string _<#= char.ToLowerInvariant(c.Name[0]) #><#= c.Name[1..] #>Text = "";

<#
        }
        foreach (var p in aheadParents)
        {
#>
    /// <summary> The first few <#= p.Table #> rows whose text contains what was typed. </summary>
    public async Task<IReadOnlyList<<#= WinUI3Names.LookupOptionClass(table, "Detail", p.KeyCs) #>>> Suggest<#= p.BaseName #>Async(string text)
    {
        string wanted = text.Trim().ToLower();
        await _gate.WaitAsync();
        try
        {
            var found = await _context.Set<<#= p.Table #>>().AsNoTracking()
                .Where(r => r.<#= p.DisplayName #>.ToString()!.ToLower().Contains(wanted))
                .OrderBy(r => r.<#= p.DisplayName #>).Take(10)
                .Select(r => new { Id = r.<#= p.KeyName #>, Text = r.<#= p.DisplayName #> }).ToListAsync();
            return found.Select(r => new <#= WinUI3Names.LookupOptionClass(table, "Detail", p.KeyCs) #> { Id = r.Id, Text = r.Text?.ToString() ?? "" }).ToList();
        }
        finally { _gate.Release(); }
    }

<#
        }
#>

<#
        // The values the database lists for a column (a MySQL enum), shown as a drop-down.
        foreach (var c in shown.Where(c => c.HasChoices))
        {
#>
    public string[] <#= c.Name #>Choices { get; } = [<#= string.Join(", ", c.Choices!.Select(v => "\"" + ChoiceFormat.CSharp(v) + "\"")) #>];
<#
        }
#>

    [NotifyPropertyChangedFor(nameof(HasError))]
    [ObservableProperty]
    private string? _errorMessage;
    public bool HasError => ErrorMessage is not null;

<#
        foreach (var c in shown)
        {
            var value = form.ValueOf(c);
            string prop = c.Name;
            string fieldType = DesktopFormCode.FieldType(form, c);
#>
    [ObservableProperty]
    private <#= fieldType #> _<#= char.ToLowerInvariant(prop[0]) #><#= prop[1..] #><#= fieldType == "double" ? " = double.NaN" : "" #>;
<#
            if (value == ValueKind.Date)
            {
#>
    private TimeSpan _<#= char.ToLowerInvariant(prop[0]) #><#= prop[1..] #>Time; // the time of day a stored date-and-time had: the calendar edits only the date
<#
            }
        }
#>

    public <#= table #>DetailViewModel(<#= contextType #> context, <#= table #>? editing)
    {
        _context = context;
        _repo = new <#= table #>Repo(context);
        _editing = editing;
        // Add leaves every field at its default (null/blank); Edit fills them in from the row being edited.
        if (editing is not null)
        {
<#
        foreach (var c in shown)
            Write(DesktopFormCode.LoadLines(form, c));
#>
        }
    }

    // A table with no foreign-key lookups has nothing to load here - a plain, non-async Task.CompletedTask
    // avoids CS1998 ("this async method lacks 'await' operators"), found live: this method's body was always
    // empty-but-async for a parentless table.
<#
        if (parents.Count == 0)
        {
#>
    public Task LoadLookupsAsync() => Task.CompletedTask;
<#
        }
        else
        {
#>
<#
        if (aheadParents.Count > 0)
        {
#>
    public async Task LoadLookupsAsync()
    {
        await _gate.WaitAsync();
        try { await LoadLookupsCoreAsync(); }
        finally { _gate.Release(); }
    }

<#
        }
#>
    public async Task <#= aheadParents.Count > 0 ? "LoadLookupsCoreAsync" : "LoadLookupsAsync" #>()
    {
<#
        foreach (var p in parents)
        {
            var lookupColumnsForThisParent = shown.Where(c => form.LookupOf(c) is ForeignKeyModel fk && fk.ReferencedTable.EqualsIgnoreCase(p.Table)).ToList();
            if (p.TypeAhead)
            {
                // too many rows to read: only the row being edited is read, for the name the box shows
                foreach (var c in lookupColumnsForThisParent)
                {
#>
        if (_editing is not null)
        {
            <#= c.Name #> = _editing.<#= c.Name #>;
            if (_editing.<#= c.Name #> is <#= p.KeyCs #> <#= TemplateHelpers.LowerFirst(c.Name) #>Key)
                <#= c.Name #>Text = await _context.Set<<#= p.Table #>>().AsNoTracking().Where(r => r.<#= p.KeyName #> == <#= TemplateHelpers.LowerFirst(c.Name) #>Key).Select(r => r.<#= p.DisplayName #>.ToString()).FirstOrDefaultAsync() ?? "";
        }
<#
                }
                continue;
            }
#>
        <#= WinUI3Names.OptionsProperty(p) #>.Clear();
        foreach (var row in await _context.Set<<#= p.Table #>>().OrderBy(r => r.<#= p.DisplayName #>).ToListAsync())
            <#= WinUI3Names.OptionsProperty(p) #>.Add(new <#= WinUI3Names.LookupOptionClass(table, "Detail", p.KeyCs) #> { Id = row.<#= p.KeyName #>, Text = row.<#= p.DisplayName #>?.ToString() ?? "" });
<#
            if (lookupColumnsForThisParent.Count > 0)
            {
#>
        if (_editing is not null)
        {
<#
                foreach (var c in lookupColumnsForThisParent)
                {
#>
            <#= c.Name #> = _editing.<#= c.Name #>;
<#
                }
#>
        }
<#
            }
        }
#>
    }
<#
        }
#>

    /// <summary> Parses every text-backed field into the entity's real column type, sets ErrorMessage and
    /// returns false on the first bad or missing value, otherwise saves through <#= table #>Repo and returns true. </summary>
    public async Task<bool> SaveAsync()
    {
        ErrorMessage = null;
        var entity = _editing ?? new <#= table #>();

<#
        foreach (var c in shown)
            Write(DesktopFormCode.SaveLines(form, Project, c));
#>

<#
        if (textKey)
        {
#>
        if (_editing is null && await _repo.ExistsAsync(entity.<#= keyProp #>))
        {
            ErrorMessage = "A <#= title.ToLowerInvariant() #> with this <#= Labels.Column(keyColumn.Name).ToLowerInvariant() #> already exists.";
            return false;
        }

<#
        }
#>
        if (_editing is null)
            await _repo.AddAsync(entity);
        else
            await _repo.UpdateAsync(entity.<#= keyProp #>, entity);
        return true;
    }
}
