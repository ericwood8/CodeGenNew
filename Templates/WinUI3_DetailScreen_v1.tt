<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS -- the lines to change to use this template in your own project (namespaces, names,
    // folders, lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string viewNamespace = "TimeEntry.Desktop.Views";
    string viewModelNamespace = "TimeEntry.Desktop.ViewModels";
    string contextType = "TimeEntryContext";
    string contextNamespace = "TimeEntry.Common.Data";
    // Namespaces the generated files must "using" beyond the ones every file needs (Microsoft.UI.Xaml.*,
    // Microsoft.EntityFrameworkCore, System.Collections.ObjectModel, CommunityToolkit.Mvvm.ComponentModel).
    string[] usings = { };
    // Folders under the WinUI3 project root (where -o points) the generated files go in.
    string viewsFolder = "Views";
    string viewModelsFolder = "ViewModels";
    // A foreign key to one of these is a plain number box, not a drop-down (an enum/lookup parent, or a
    // parent whose own screen needs cascading drop-downs this template can't build).
    string[] noLookupParents =
    {
        "ClearanceType", "ExpenseType", "LeaveType", "OvertimeType", "SY_Display", "SY_ISOCountry",
        "SY_RequestStatusType", "SY_RequestType", "SY_ResponseType", "SY_Role", "DepartmentTeam", "ProjectTask"
    };
    // ==========================================================================================

    // ------------------------------------------------------------------------------------------
    // WinUI3_DetailScreen_v1.tt
    // Generates a WinUI3 ContentDialog for adding or editing ONE row of the table (the "detail" screen of a
    // master/detail pair -- see WinUI3_MasterScreen.tt, which opens this dialog, and WinUI3_DetailMasterScreen.tt,
    // the same idea plus child grids for tables that hang off this one):
    //     Views/<TableName>DetailDialog.xaml         one field per column, Save/Cancel
    //     Views/<TableName>DetailDialog.xaml.cs       wires PrimaryButtonClick to the ViewModel's SaveAsync
    //     ViewModels/<TableName>DetailViewModel.cs    loads drop-down options, validates, calls <TableName>Repo
    //
    // Column selection mirrors TS_Component.tt (its Angular add/edit form): every column except the primary
    // key, computed and identity columns. A foreign key becomes a ComboBox of the parent's rows (skipped for
    // a table listed in noLookupParents, which stays a plain number box); a bit column becomes a CheckBox.
    //
    // Field binding: WinUI3's compiled x:Bind cannot convert a TextBox's string Text to a numeric, date or
    // Guid property without a converter class this template cannot assume your project has, so every
    // TEXT-BOX-BACKED field (numbers, dates, plain text, Guid) is a STRING property on the ViewModel; SaveAsync
    // parses each one into the entity's real column type and reports the first bad value instead of throwing.
    // Dates are typed as plain text (yyyy-MM-dd), not a DatePicker, for the same reason (DatePicker.Date is a
    // DateTimeOffset, not a DateTime). A ComboBox's SelectedValue and a CheckBox's IsChecked DO bind straight
    // to an int?/bool? property -- WinUI3 does not need a converter for either of those.
    //
    // Data access: the entity's own CRUD goes through <TableName>Repo (generate it with CS_Repo first -- same
    // assumption WinUI3_JunctionEditor.tt makes about SP_Junction.tt); each drop-down's OPTIONS come straight
    // from the DbContext (context.Set<Parent>()), not that parent's own repository, so this template never has
    // to assume every foreign-keyed table also got a CS_Repo run against it.
    //
    // Requires a primary key that is a single, non-composite INT column (matches API_Crud.tt and CS_Repo's
    // GenericRepo<T>, whose GetById/UpdateAsync/DeleteAsync all take a plain int) and refuses a table shaped
    // like TimeEntryServer's "name/active" tables (a NOT NULL text Name plus a NOT NULL bit IsActive), whose
    // repository is a NameActiveRepo -- it has no GetAll for WinUI3_MasterScreen.tt to call, so the pair is
    // out of scope here the same way API_Crud.tt refuses them.
    //
    // What it does NOT do, so a screen that needs any of these stays hand-maintained: validation beyond "is
    // this well-formed" (uniqueness, cross-field rules), a file picker for a FilePathColumn, or opening from a
    // NavigationView/Frame -- that's WinUI3_MasterScreen.tt's job, or your own code, to wire up.
    //
    // ------------------------------------------------------------------------------------------

    bool IsDate(ColumnModel c) => c.SqlType is SqlDbType.Date or SqlDbType.DateTime or SqlDbType.DateTime2 or SqlDbType.SmallDateTime;
    bool IsNumber(ColumnModel c) => c.SqlType is SqlDbType.Int or SqlDbType.BigInt or SqlDbType.SmallInt or SqlDbType.TinyInt
        or SqlDbType.Decimal or SqlDbType.Money or SqlDbType.SmallMoney or SqlDbType.Float or SqlDbType.Real;
    bool IsGuid(ColumnModel c) => c.SqlType == SqlDbType.UniqueIdentifier;
    bool IsBit(ColumnModel c) => c.SqlType == SqlDbType.Bit;
    bool IsText(ColumnModel c) => c.SqlType is SqlDbType.Char or SqlDbType.VarChar or SqlDbType.NChar or SqlDbType.NVarChar;
    bool IsEditableType(ColumnModel c) => IsDate(c) || IsNumber(c) || IsGuid(c) || IsBit(c) || IsText(c);
    int Chars(ColumnModel c) => c.MaxLength is null ? 0 : (c.SqlType is SqlDbType.NChar or SqlDbType.NVarChar ? c.MaxLength.Value / 2 : c.MaxLength.Value);
    bool IsMultiline(ColumnModel c) => IsText(c) && Chars(c) >= 100;
    string Words(string s) => Regex.Replace(s.Replace('_', ' '), "(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])", " ").Trim();
    string Label(string columnName) => Words(Regex.Replace(Regex.Replace(columnName, "^SY_", ""), "Id$", ""));
    string UpperFirst(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];

    string CSharpNumericType(ColumnModel c) => c.SqlType switch
    {
        SqlDbType.Int => "int", SqlDbType.BigInt => "long", SqlDbType.SmallInt => "short", SqlDbType.TinyInt => "byte",
        SqlDbType.Money or SqlDbType.SmallMoney or SqlDbType.Decimal => "decimal",
        SqlDbType.Float => "double", SqlDbType.Real => "float", _ => "int"
    };

    var keyColumn = Model.PrimaryKeyColumns.Count == 1 ? Model.PrimaryKeyColumns[0] : null;
    bool isNameActive = Model.Columns.Any(c => c.IsStringColumn && !c.IsNullable && c.Name == "Name")
                      && Model.Columns.Any(c => c.SqlType == SqlDbType.Bit && !c.IsNullable && c.Name == "IsActive");

    if (keyColumn is null || keyColumn.SqlType != SqlDbType.Int)
    {
        Error($"WinUI3_DetailScreen needs a table with a single int primary key (CS_Repo's GenericRepo<T> takes a plain int id), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else if (isNameActive)
    {
        Error($"WinUI3_DetailScreen is for plain tables. [{Model.SchemaName}].[{Model.TableName}] has a Name and an IsActive column, so its repository is a NameActiveRepo (no GetAll for the paired master screen); write that screen by hand.");
    }
    else
    {
        string table = Model.TableName;
        string title = Words(table);
        string keyProp = keyColumn.Name;

        // GroupBy + First, not ToDictionary: a real table can have more than one FK constraint on the same
        // column pointing at the same parent (seen live against a second production database's dbo.Products
        // table, e.g. two separate constraints both named differently but both from DOIProductTypeID to
        // ProductTypes.ID) -- ToDictionary would throw on the duplicate key.
        var fkByColumn = Model.ForeignKeys.Where(f => f.ReferencingColumns.Count == 1)
            .GroupBy(f => f.ReferencingColumns[0], StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        var shown = Model.Columns
            .Where(c => !c.IsPrimaryKey && !c.IsComputed && !c.IsIdentity && IsEditableType(c))
            .OrderBy(c => c.OrdinalPosition)
            .ToList();

        // Only an int-typed foreign key becomes a drop-down: the ViewModel binds every lookup field as int?
        // (ComboBox.SelectedValue needs a concrete CLR type, and this project's foreign keys -- like CS_Repo's
        // GenericRepo<T> itself -- are assumed to be plain ints, never a Guid or natural-text key).
        ForeignKeyModel LookupOf(ColumnModel c) =>
            c.SqlType == SqlDbType.Int
            && fkByColumn.TryGetValue(c.Name, out var fk)
            && !noLookupParents.Contains(fk.ReferencedTable, StringComparer.OrdinalIgnoreCase)
            && fk.ReferencedDisplayColumns.Count > 0
                ? fk : null;

        var parents = shown.Select(c => LookupOf(c)).Where(fk => fk is not null)
            .GroupBy(fk => fk.ReferencedTable, StringComparer.OrdinalIgnoreCase).Select(g => g.First())
            .Select(fk => new
            {
                Table = fk.ReferencedTable,
                OptionsProp = fk.ReferencedTable + "Options",
                KeyProp = fk.ReferencedColumns[0],
                DisplayProp = fk.ReferencedDisplayColumns[0]
            }).ToList();
        var parentOf = parents.ToDictionary(p => p.Table, StringComparer.OrdinalIgnoreCase);

        if (!Model.HasReferencedDisplayColumns && parents.Count > 0)
            Error("WinUI3_DetailScreen needs the foreign-keyed tables' display columns for its drop-downs; its .tt.config must say NeedsReferencedDisplayColumns=true.");
#>
@@@FILE <#= viewsFolder #>/<#= table #>DetailDialog.xaml@@@
<ContentDialog
    x:Class="<#= viewNamespace #>.<#= table #>DetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer MinWidth="420" MaxHeight="560">
        <StackPanel Spacing="12">
            <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />
<#
        foreach (var c in shown)
        {
            var lookup = LookupOf(c);
            string prop = c.Name;
            string label = Label(c.Name);
            if (lookup is not null)
            {
                var p = parentOf[lookup.ReferencedTable];
#>
            <ComboBox Header="<#= label #>" ItemsSource="{x:Bind ViewModel.<#= p.OptionsProp #>}"
                      SelectedValuePath="Id" DisplayMemberPath="Text"
                      SelectedValue="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}" HorizontalAlignment="Stretch" />
<#
            }
            else if (IsBit(c))
            {
#>
            <CheckBox Content="<#= label #>" IsChecked="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}" />
<#
            }
            else if (IsDate(c))
            {
#>
            <TextBox Header="<#= label #>" Text="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}" PlaceholderText="yyyy-MM-dd" />
<#
            }
            else if (IsMultiline(c))
            {
#>
            <TextBox Header="<#= label #>" Text="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="80" MaxLength="<#= Chars(c) #>" />
<#
            }
            else
            {
                string maxLen = IsText(c) && Chars(c) > 0 ? $" MaxLength=\"{Chars(c)}\"" : "";
#>
            <TextBox Header="<#= label #>" Text="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"<#= maxLen #> />
<#
            }
        }
#>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
@@@FILE <#= viewsFolder #>/<#= table #>DetailDialog.xaml.cs@@@
using <#= viewModelNamespace #>;
using Microsoft.UI.Xaml.Controls;
<#
        foreach (string u in usings)
        {
#>
using <#= u #>;
<#
        }
#>

namespace <#= viewNamespace #>;

// Assumes nothing from CodeGenNew.App itself -- a plain ContentDialog, no shared house-style helper. If your
// project has its own dialog-convention helper (access keys, default-button focus, ...), apply it here the
// way CodeGenNew.App's own MainWindow.xaml.cs applies ContentDialogUx to its own dialogs.
public sealed partial class <#= table #>DetailDialog : ContentDialog
{
    public <#= table #>DetailViewModel ViewModel { get; }

    /// <param name="editing"> The row being edited, or null to add a new one. </param>
    public <#= table #>DetailDialog(<#= contextType #> context, <#= table #>? editing = null)
    {
        ViewModel = new <#= table #>DetailViewModel(context, editing);
        InitializeComponent();
        Loaded += async (_, _) => await ViewModel.LoadLookupsAsync();
    }

    // Validation failure keeps the dialog open instead of closing it -- see ViewModel.SaveAsync.
    private async void OnPrimaryButtonClick(ContentDialog sender, ContentDialogButtonClickEventArgs args)
    {
        var deferral = args.GetDeferral();
        try
        {
            if (!await ViewModel.SaveAsync())
                args.Cancel = true;
        }
        finally
        {
            deferral.Complete();
        }
    }
}
@@@FILE <#= viewModelsFolder #>/<#= table #>DetailViewModel.cs@@@
using System.Collections.ObjectModel;
using System.Threading.Tasks;
using <#= contextNamespace #>;
using CommunityToolkit.Mvvm.ComponentModel;
using Microsoft.EntityFrameworkCore;
<#
        foreach (string u in usings)
        {
#>
using <#= u #>;
<#
        }
#>

namespace <#= viewModelNamespace #>;

/// <summary> One entry of a <#= table #>DetailDialog drop-down: an id plus the text to show for it. </summary>
public class <#= table #>DetailLookupOption
{
    public int Id { get; set; }
    public string Text { get; set; } = "";
}

public partial class <#= table #>DetailViewModel : ObservableObject
{
    private readonly <#= contextType #> _context;
    private readonly <#= table #>Repo _repo;
    private readonly <#= table #>? _editing;

    public string DialogTitle => _editing is null ? "Add <#= title #>" : "Edit <#= title #>";

<#
        foreach (var p in parents)
        {
#>
    public ObservableCollection<<#= table #>DetailLookupOption> <#= p.OptionsProp #> { get; } = [];
<#
        }
#>

    [NotifyPropertyChangedFor(nameof(HasError))]
    [ObservableProperty]
    private string? _errorMessage;
    public bool HasError => ErrorMessage is not null;

<#
        foreach (var c in shown)
        {
            var lookup = LookupOf(c);
            string prop = c.Name;
            string fieldType = lookup is not null ? "int?" : IsBit(c) ? "bool?" : "string?";
#>
    [ObservableProperty]
    private <#= fieldType #> _<#= char.ToLowerInvariant(prop[0]) #><#= prop[1..] #>;
<#
        }
#>

    public <#= table #>DetailViewModel(<#= contextType #> context, <#= table #>? editing)
    {
        _context = context;
        _repo = new <#= table #>Repo(context);
        _editing = editing;
        // Add leaves every field at its default (null/blank); Edit fills them in from the row being edited.
        if (editing is not null)
        {
<#
        foreach (var c in shown)
        {
            var lookup = LookupOf(c);
            string prop = c.Name;
            if (lookup is not null || IsBit(c))
            {
#>
            <#= prop #> = editing.<#= prop #>;
<#
            }
            else if (IsDate(c))
            {
#>
            <#= prop #> = editing.<#= prop #><#= c.IsNullable ? "?.ToString(\"yyyy-MM-dd\")" : ".ToString(\"yyyy-MM-dd\")" #>;
<#
            }
            else
            {
#>
            <#= prop #> = editing.<#= prop #><#= c.IsNullable ? "?.ToString()" : ".ToString()" #>;
<#
            }
        }
#>
        }
    }

    public async Task LoadLookupsAsync()
    {
<#
        foreach (var p in parents)
        {
#>
        <#= p.OptionsProp #>.Clear();
        foreach (var row in await _context.Set<<#= p.Table #>>().OrderBy(r => r.<#= p.DisplayProp #>).ToListAsync())
            <#= p.OptionsProp #>.Add(new <#= table #>DetailLookupOption { Id = row.<#= p.KeyProp #>, Text = row.<#= p.DisplayProp #>?.ToString() ?? "" });
<#
        }
#>
    }

    /// <summary> Parses every text-backed field into the entity's real column type, sets ErrorMessage and
    /// returns false on the first bad or missing value, otherwise saves through <#= table #>Repo and returns true. </summary>
    public async Task<bool> SaveAsync()
    {
        ErrorMessage = null;
        var entity = _editing ?? new <#= table #>();

<#
        foreach (var c in shown)
        {
            var lookup = LookupOf(c);
            string prop = c.Name;
            string label = Label(c.Name);
            if (lookup is not null)
            {
                if (!c.IsNullable)
                {
#>
        if (<#= prop #> is null) { ErrorMessage = "<#= label #> is required."; return false; }
        entity.<#= prop #> = <#= prop #>.Value;
<#
                }
                else
                {
#>
        entity.<#= prop #> = <#= prop #>;
<#
                }
            }
            else if (IsBit(c))
            {
#>
        entity.<#= prop #> = <#= prop #><#= c.IsNullable ? "" : " ?? false" #>;
<#
            }
            else if (IsDate(c))
            {
#>
        if (string.IsNullOrWhiteSpace(<#= prop #>))
        {
<#
                if (!c.IsNullable)
                {
#>
            ErrorMessage = "<#= label #> is required."; return false;
<#
                }
                else
                {
#>
            entity.<#= prop #> = null;
<#
                }
#>
        }
        else if (!DateTime.TryParse(<#= prop #>, out var <#= prop #>Value)) { ErrorMessage = "<#= label #> is not a valid date."; return false; }
        else { entity.<#= prop #> = <#= prop #>Value; }
<#
            }
            else if (IsGuid(c))
            {
#>
        if (string.IsNullOrWhiteSpace(<#= prop #>))
        {
<#
                if (!c.IsNullable)
                {
#>
            ErrorMessage = "<#= label #> is required."; return false;
<#
                }
                else
                {
#>
            entity.<#= prop #> = null;
<#
                }
#>
        }
        else if (!Guid.TryParse(<#= prop #>, out var <#= prop #>Value)) { ErrorMessage = "<#= label #> is not a valid value."; return false; }
        else { entity.<#= prop #> = <#= prop #>Value; }
<#
            }
            else if (IsNumber(c))
            {
                string numType = CSharpNumericType(c);
#>
        if (string.IsNullOrWhiteSpace(<#= prop #>))
        {
<#
                if (!c.IsNullable)
                {
#>
            ErrorMessage = "<#= label #> is required."; return false;
<#
                }
                else
                {
#>
            entity.<#= prop #> = null;
<#
                }
#>
        }
        else if (!<#= numType #>.TryParse(<#= prop #>, out var <#= prop #>Value)) { ErrorMessage = "<#= label #> is not a valid number."; return false; }
        else { entity.<#= prop #> = <#= prop #>Value; }
<#
            }
            else // plain text
            {
                if (!c.IsNullable)
                {
#>
        if (string.IsNullOrWhiteSpace(<#= prop #>)) { ErrorMessage = "<#= label #> is required."; return false; }
        entity.<#= prop #> = <#= prop #>;
<#
                }
                else
                {
#>
        entity.<#= prop #> = string.IsNullOrWhiteSpace(<#= prop #>) ? null : <#= prop #>;
<#
                }
            }
        }
#>

        if (_editing is null)
            await _repo.AddAsync(entity);
        else
            await _repo.UpdateAsync(entity.<#= keyProp #>, entity);
        return true;
    }
}
<#
    }
#>
