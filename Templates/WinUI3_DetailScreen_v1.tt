<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // folders, lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string viewNamespace = "MyApp.Desktop.Views";
    string viewModelNamespace = "MyApp.Desktop.ViewModels";
    string contextType = "MyAppContext";
    string contextNamespace = "MyApp.Common.Data";
    // Namespaces the generated files must "using" beyond the ones every file needs (Microsoft.UI.Xaml.*,
    // Microsoft.EntityFrameworkCore, System.Collections.ObjectModel, CommunityToolkit.Mvvm.ComponentModel).
    string[] usings = { };
    // Folders under the WinUI3 project root (where -o points) the generated files go in.
    string viewsFolder = "Views";
    string viewModelsFolder = "ViewModels";
    // A foreign key to one of these is a plain number box, not a drop-down (an enum/lookup parent, or a
    // parent whose own screen needs cascading drop-downs this template can't build).
    string[] noLookupParents =
    {
        "ClearanceType", "ExpenseType", "LeaveType", "OvertimeType", "SY_Display", "SY_ISOCountry",
        "SY_RequestStatusType", "SY_RequestType", "SY_ResponseType", "SY_Role", "DepartmentTeam", "ProjectTask"
    };
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    viewNamespace = Project.ViewNamespace ?? viewNamespace;
    viewModelNamespace = Project.ViewModelNamespace ?? viewModelNamespace;
    contextType = Project.ContextName ?? contextType;
    contextNamespace = Project.ContextNamespace ?? contextNamespace;
    usings = Project.Usings ?? usings;
    viewsFolder = Project.ViewsFolder ?? viewsFolder;
    viewModelsFolder = Project.ViewModelsFolder ?? viewModelsFolder;
    // With a project chosen, which tables count as enums (no entity/repository/API of their own) comes from the project's
    // EnumTables, else from what the schema says about each table (LookupShape) - not from the lists above, which are
    // only used when no project is chosen.
    bool NoLookup(string table, LookupShape shape) => Project.NoLookup(table, shape) ?? noLookupParents.Contains(table, StringComparer.OrdinalIgnoreCase);
    // ==========================================================================================

    // ==========================================================================================
    // WinUI3_DetailScreen_v1.tt
    // Generates: Views/<Table>DetailDialog.xaml and .xaml.cs, ViewModels/<Table>DetailViewModel.cs (and CurrencyNumberFormatter when a money column exists)
    // A ContentDialog for adding or editing one row: a field per column on tabs (Main, Billing & Shipping, Notes), drop-downs for foreign keys and listed
    // values, a calendar picker for dates, number boxes limited by column name and type, currency boxes in the project's CurrencyCode, validation and Save/Cancel.
    // Full notes: Docs/TemplateNotes/WinUI3_DetailScreen_v1.md
    // ==========================================================================================

    // Every whole-number column (a foreign key to a lookup is handled before this) is edited in a number box, whose value is a double:
    // the ViewModel holds it as a double (NaN = blank) and the save converts it back, after checking it is whole and in range.
    bool UsesNumberBox(ColumnModel c) => c.IsIntegerColumn && !IsBit(c);
    // A currency column (money, or a decimal whose name says money) is also edited in a number box, formatted as currency in code-behind
    // (a NumberFormatter cannot be declared in XAML; CurrencyNumberFormatter.cs, written alongside, formats as currency and also reads a plain number), and converted back to a decimal rounded to the column's scale on save.
    bool UsesCurrencyBox(ColumnModel c) => c.IsCurrencyColumn && !c.IsIntegerColumn;
    int CurrencyDigits(ColumnModel c) => NumericClassifier.CurrencyDigits(c);
    // A decimal, float or real column that is not money (a percentage, a rate, a quantity, a weight) is edited in a number box too: its value is a double
    // (NaN = blank), limited to what the column can hold (NumericClassifier.DecimalRange), and converted back on save.
    bool UsesDecimalBox(ColumnModel c) => !c.IsCurrencyColumn && c.IsNumericColumn;
    int DecimalPlaces(ColumnModel c) => Math.Clamp(c.Scale ?? 2, 0, 8);
    string Words(string s) => Labels.Words(s);
    string Label(string columnName) => Words(Regex.Replace(Regex.Replace(columnName, "^SY_", ""), "Id$", ""));

    string CSharpNumericType(ColumnModel c) => c.SqlType switch
    {
        SqlDbType.Int => "int", SqlDbType.BigInt => "long", SqlDbType.SmallInt => "short", SqlDbType.TinyInt => "byte",
        SqlDbType.Money or SqlDbType.SmallMoney or SqlDbType.Decimal => "decimal",
        SqlDbType.Float => "double", SqlDbType.Real => "float", _ => "int"
    };

    var keyColumn = Model.PrimaryKeyColumns.Count == 1 ? Model.PrimaryKeyColumns[0] : null;
    bool isNameActive = Model.Columns.Any(c => c.IsStringColumn && !c.IsNullable && c.Name == "Name")
                      && Model.Columns.Any(c => c.IsBooleanColumn && !c.IsNullable && c.Name == "IsActive");

    if (keyColumn is null || !keyColumn.IsInt32Column)
    {
        Error($"WinUI3_DetailScreen needs a table with a single int primary key (CS_Repo's GenericRepo<T> takes a plain int id), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else if (isNameActive)
    {
        Error($"WinUI3_DetailScreen is for plain tables. [{Model.SchemaName}].[{Model.TableName}] has a Name and an IsActive column, so its repository is a NameActiveRepo (no GetAll for the paired master screen); write that screen by hand.");
    }
    else
    {
        string table = Model.TableName;
        string title = Words(table);
        string keyProp = keyColumn.Name;

        // GroupBy + First, not ToDictionary: a real table can have more than one FK constraint on the same
        // column pointing at the same parent (seen live against a second production database's dbo.Products
        // table, e.g. two separate constraints both named differently but both from DOIProductTypeID to
        // ProductTypes.ID) - ToDictionary would throw on the duplicate key.
        var fkByColumn = Model.ForeignKeys.Where(f => f.ReferencingColumns.Count == 1)
            .GroupBy(f => f.ReferencingColumns[0], StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        var shown = Model.Columns
            .Where(c => !c.IsPrimaryKey && !c.IsComputed && !c.IsIdentity && IsEditableType(c))
            .OrderBy(c => c.OrdinalPosition)
            .ToList();

        // A form with more than one kind of field is tabbed (Main / Billing & Shipping / Notes): see FormPages. A narrow table keeps its single column.
        var pages = FormPages.For(shown).Select(p => (Header: p.Header.Replace("&", "&amp;"), Columns: p.Columns)).ToList();
        bool tabbed = pages.Count > 1;

        // Only an int-typed foreign key becomes a drop-down: the ViewModel binds every lookup field as int?
        // (ComboBox.SelectedValue needs a concrete CLR type, and this project's foreign keys - like CS_Repo's
        // GenericRepo<T> itself - are assumed to be plain ints, never a Guid or natural-text key).
        ForeignKeyModel LookupOf(ColumnModel c) =>
            c.IsInt32Column
            && fkByColumn.TryGetValue(c.Name, out var fk)
            && !NoLookup(fk.ReferencedTable, fk.ReferencedLookupShape)
            && fk.ReferencedDisplayColumns.Count > 0
                ? fk : null;

        var parents = shown.Select(c => LookupOf(c)).Where(fk => fk is not null)
            .GroupBy(fk => fk.ReferencedTable, StringComparer.OrdinalIgnoreCase).Select(g => g.First())
            .Select(fk => new
            {
                Table = fk.ReferencedTable,
                OptionsProp = fk.ReferencedTable + "Options",
                KeyProp = fk.ReferencedColumns[0],
                DisplayProp = fk.ReferencedDisplayColumns[0]
            }).ToList();
        var parentOf = parents.ToDictionary(p => p.Table, StringComparer.OrdinalIgnoreCase);

        if (!Model.HasReferencedDisplayColumns && parents.Count > 0)
            Error("WinUI3_DetailScreen needs the foreign-keyed tables' display columns for its drop-downs; its .tt.config must say NeedsReferencedDisplayColumns=true.");
#>
@@@FILE <#= viewsFolder #>/<#= table #>DetailDialog.xaml@@@
<ContentDialog
    x:Class="<#= viewNamespace #>.<#= table #>DetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <!-- A ContentDialog's width is capped by these two theme resources (about 320-548 by default), NOT by its own
         MinWidth/MaxWidth or by anything inside it, which is why setting those has no effect. Raising the cap
         lets the ScrollViewer's own MinWidth below (and the content) decide the width, up to the window. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">320</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1400</x:Double>
    </ContentDialog.Resources>

<#
        if (tabbed)
        {
#>
    <StackPanel MinWidth="420" Spacing="12">
        <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />
        <TabView IsAddTabButtonVisible="False" TabWidthMode="SizeToContent" CanReorderTabs="False" CanDragTabs="False" SelectedIndex="0">
<#
        }
        else
        {
#>
    <!-- The error bar sits ABOVE the scrolling area: inside it, a validation message is out of sight whenever the person has scrolled down. -->
    <StackPanel Spacing="12">
        <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />
    <ScrollViewer MinWidth="420" MaxHeight="560">
        <StackPanel Spacing="12">
<#
        }
        foreach (var page in pages)
        {
            if (tabbed)
            {
#>
            <TabViewItem Header="<#= page.Header #>" IsClosable="False">
                <ScrollViewer Height="460">
                    <StackPanel Spacing="12" Padding="0,8,12,8">
<#
            }
        foreach (var c in page.Columns)
        {
            var lookup = LookupOf(c);
            string prop = c.Name;
            string label = Label(c.Name);
            if (lookup is not null)
            {
                var p = parentOf[lookup.ReferencedTable];
#>
            <ComboBox Header="<#= label #>" ItemsSource="{x:Bind ViewModel.<#= p.OptionsProp #>}"
                      SelectedValuePath="Id" DisplayMemberPath="Text"
                      SelectedValue="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}" />
<#
            }
            else if (c.HasChoices)
            {
#>
            <ComboBox Header="<#= label #>" ItemsSource="{x:Bind ViewModel.<#= prop #>Choices}"
                      SelectedItem="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}" />
<#
            }
            else if (UsesCurrencyBox(c))
            {
#>
            <NumberBox x:Name="<#= prop #>Box" Header="<#= label #>" Value="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"
                       <#= Project.MoneyLimitAttributes(table, c) #>ValidationMode="InvalidInputOverwritten" Width="180" HorizontalAlignment="Left" />
<#
            }
            else if (UsesDecimalBox(c))
            {
                var (decMin, decMax) = NumericClassifier.DecimalRange(c);
                int decDigits = Inv(decMax).Length + (c.SqlType == SqlDbType.Decimal ? DecimalPlaces(c) : 4);
                string decWidth = $" Width=\"{Math.Max(Math.Min(decDigits, 12) * 10 + 150, label.Length * 7 + 8)}\" HorizontalAlignment=\"Left\"";
#>
            <NumberBox x:Name="<#= prop #>Box" Header="<#= label #>" Value="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"
                       Minimum="<#= Inv(decMin) #>" Maximum="<#= Inv(decMax) #>" SmallChange="1" LargeChange="10"
                       SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten"<#= decWidth #> />
<#
            }
            else if (UsesNumberBox(c))
            {
                var range = Project.RangeFor(c)!.Value;
                // Narrow to the widest number the range allows (a month is two digits, a year four) plus what the box itself needs
                // around the text - two inline spin buttons, the clear ("x") button and padding, about 150 pixels; any less leaves
                // no visible room to type - and never narrower than the header text. The digits count at most nine, so a number box over a
                // whole int (a foreign key shown as a plain number) is not stretched across the dialog.
                int digits = Math.Max(range.Min.ToString().Length, range.Max.ToString().Length);
                string width = $" Width=\"{Math.Max(Math.Min(digits, 9) * 10 + 150, label.Length * 7 + 8)}\" HorizontalAlignment=\"Left\"";
#>
            <NumberBox Header="<#= label #>" Value="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"
                       Minimum="<#= range.Min #>" Maximum="<#= range.Max #>" SmallChange="1" LargeChange="<#= range.Max - range.Min >= 100 ? 10 : 1 #>"
                       SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten"<#= width #> />
<#
            }
            else if (IsBit(c))
            {
#>
            <CheckBox Content="<#= label #>?" IsChecked="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}" />
<#
            }
            else if (IsDate(c))
            {
#>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CalendarDatePicker Header="<#= label #>" Date="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"
                                    DateFormat="{}{month.integer}/{day.integer}/{year.full}" PlaceholderText="mm/dd/yyyy" Width="180" />
<#
                if (c.IsNullable)
                {
#>
                <Button Content="Clear" VerticalAlignment="Bottom" Click="OnClear<#= prop #>Click" />
<#
                }
#>
            </StackPanel>
<#
            }
            else if (IsMultiline(c))
            {
#>
            <TextBox Header="<#= label #>" Text="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="80" MaxLength="<#= Chars(c) #>" />
<#
            }
            else
            {
                string maxLen = IsText(c) && Chars(c) > 0 ? $" MaxLength=\"{Chars(c)}\"" : "";
#>
            <TextBox Header="<#= label #>" Text="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"<#= maxLen #> />
<#
            }
        }
            if (tabbed)
            {
#>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
<#
            }
        }
        if (tabbed)
        {
#>
        </TabView>
    </StackPanel>
<#
        }
        else
        {
#>
        </StackPanel>
    </ScrollViewer>
    </StackPanel>
<#
        }
#>
</ContentDialog>
@@@FILE <#= viewsFolder #>/<#= table #>DetailDialog.xaml.cs@@@
using <#= viewModelNamespace #>;
using Microsoft.UI.Xaml.Controls;
<#
        var currencyColumns = shown.Where(UsesCurrencyBox).ToList();
        foreach (string u in usings)
        {
#>
using <#= u #>;
<#
        }
#>

namespace <#= viewNamespace #>;

// Assumes nothing from CodeGenNew.App itself - a plain ContentDialog, no shared house-style helper. If your
// project has its own dialog-convention helper (access keys, default-button focus, ...), apply it here the
// way CodeGenNew.App's own MainWindow.xaml.cs applies ContentDialogUx to its own dialogs.
public sealed partial class <#= table #>DetailDialog : ContentDialog
{
    public <#= table #>DetailViewModel ViewModel { get; }
    private System.Threading.Tasks.Task _loading = System.Threading.Tasks.Task.CompletedTask;

    /// <param name="editing"> The row being edited, or null to add a new one. </param>
    public <#= table #>DetailDialog(<#= contextType #> context, <#= table #>? editing = null)
    {
        ViewModel = new <#= table #>DetailViewModel(context, editing);
        InitializeComponent();
<#
        foreach (var c in currencyColumns)
        {
#>
        <#= c.Name #>Box.NumberFormatter = new CurrencyNumberFormatter("<#= Project.CurrencyCode #>", <#= CurrencyDigits(c) #>);
<#
        }
#>
<#
        foreach (var c in shown.Where(c => UsesDecimalBox(c) && c.SqlType == SqlDbType.Decimal))
        {
#>
        <#= c.Name #>Box.NumberFormatter = new Windows.Globalization.NumberFormatting.DecimalFormatter
        {
            IntegerDigits = 1, FractionDigits = <#= DecimalPlaces(c) #>, IsGrouped = false,
            NumberRounder = new Windows.Globalization.NumberFormatting.IncrementNumberRounder { Increment = <#= Inv(Math.Pow(10, -DecimalPlaces(c))) #>, RoundingAlgorithm = Windows.Globalization.NumberFormatting.RoundingAlgorithm.RoundHalfUp }
        };
<#
        }
#>
        Loaded += (_, _) => _loading = ViewModel.LoadLookupsAsync();
    }

    // ShowAsync() returns the moment the dialog closes, which can be before the dialog's own LoadLookupsAsync() has finished. A DbContext is not thread-safe, so a
    // caller that is about to use the same context (reload the list, open another dialog) calls this instead and waits for that load first.
    public async System.Threading.Tasks.Task<ContentDialogResult> ShowAndWaitAsync()
    {
        var result = await ShowAsync();
        await _loading;
        return result;
    }

    // Validation failure keeps the dialog open instead of closing it - see ViewModel.SaveAsync.
    private async void OnPrimaryButtonClick(ContentDialog sender, ContentDialogButtonClickEventArgs args)
    {
        var deferral = args.GetDeferral();
        try
        {
            if (!await ViewModel.SaveAsync())
                args.Cancel = true;
        }
        finally
        {
            deferral.Complete();
        }
    }
<#
        foreach (var c in shown.Where(c => IsDate(c) && c.IsNullable))
        {
#>

    // CalendarDatePicker has no clear button of its own; a nullable date gets one beside it.
    private void OnClear<#= c.Name #>Click(object sender, RoutedEventArgs e) => ViewModel.<#= c.Name #> = null;
<#
        }
#>
}
@@@FILE <#= viewModelsFolder #>/<#= table #>DetailViewModel.cs@@@
<#
        if (parents.Count > 0)
        {
#>
using System.Collections.ObjectModel;
<#
        }
#>
using System.Threading.Tasks;
using <#= contextNamespace #>;
using CommunityToolkit.Mvvm.ComponentModel;
<#
        if (parents.Count > 0)
        {
#>
using Microsoft.EntityFrameworkCore;
<#
        }
        foreach (string u in usings)
        {
#>
using <#= u #>;
<#
        }
#>

namespace <#= viewModelNamespace #>;

/// <summary> One entry of a <#= table #>DetailDialog drop-down: an id plus the text to show for it. </summary>
public class <#= table #>DetailLookupOption
{
    public int Id { get; set; }
    public string Text { get; set; } = "";
}

public partial class <#= table #>DetailViewModel : ObservableObject
{
    private readonly <#= contextType #> _context;
    private readonly <#= table #>Repo _repo;
    private readonly <#= table #>? _editing;

    public string DialogTitle => _editing is null ? "Add <#= title #>" : "Edit <#= title #>";

<#
        foreach (var p in parents)
        {
#>
    public ObservableCollection<<#= table #>DetailLookupOption> <#= p.OptionsProp #> { get; } = [];
<#
        }
#>

<#
        // The values the database lists for a column (a MySQL enum), shown as a drop-down.
        foreach (var c in shown.Where(c => c.HasChoices))
        {
#>
    public string[] <#= c.Name #>Choices { get; } = [<#= string.Join(", ", c.Choices!.Select(v => "\"" + ChoiceFormat.CSharp(v) + "\"")) #>];
<#
        }
#>

    [NotifyPropertyChangedFor(nameof(HasError))]
    [ObservableProperty]
    private string? _errorMessage;
    public bool HasError => ErrorMessage is not null;

<#
        foreach (var c in shown)
        {
            var lookup = LookupOf(c);
            string prop = c.Name;
            string fieldType = lookup is not null ? "int?" : IsBit(c) ? "bool?" : (UsesNumberBox(c) || UsesCurrencyBox(c) || UsesDecimalBox(c)) ? "double" : IsDate(c) ? "DateTimeOffset?" : "string?";
#>
    [ObservableProperty]
    private <#= fieldType #> _<#= char.ToLowerInvariant(prop[0]) #><#= prop[1..] #><#= fieldType == "double" ? " = double.NaN" : "" #>;
<#
            if (IsDate(c))
            {
#>
    private TimeSpan _<#= char.ToLowerInvariant(prop[0]) #><#= prop[1..] #>Time; // the time of day a stored date-and-time had: the calendar edits only the date
<#
            }
        }
#>

    public <#= table #>DetailViewModel(<#= contextType #> context, <#= table #>? editing)
    {
        _context = context;
        _repo = new <#= table #>Repo(context);
        _editing = editing;
        // Add leaves every field at its default (null/blank); Edit fills them in from the row being edited.
        if (editing is not null)
        {
<#
        foreach (var c in shown)
        {
            var lookup = LookupOf(c);
            string prop = c.Name;
            if (lookup is not null)
            {
                // Deliberately NOT set here - see LoadLookupsAsync below. A ComboBox's SelectedValue binding
                // does not retroactively select an item once its ItemsSource is populated AFTER SelectedValue
                // was already assigned to a value with no match yet (a real, known WinUI3/UWP limitation, not
                // just a timing quirk): the box renders as if empty even though editing.{prop} is correct,
                // until the person types in it (found live clicking through a real running app, 2026-09-28).
            }
            else if (UsesCurrencyBox(c))
            {
#>
            <#= prop #> = <#= c.IsNullable ? $"editing.{prop}.HasValue ? (double)editing.{prop}.Value : double.NaN" : $"(double)editing.{prop}" #>;
<#
            }
            else if (UsesDecimalBox(c))
            {
#>
            <#= prop #> = <#= c.IsNullable ? $"editing.{prop}.HasValue ? (double)editing.{prop}.Value : double.NaN" : $"(double)editing.{prop}" #>;
<#
            }
            else if (UsesNumberBox(c))
            {
#>
            <#= prop #> = editing.<#= prop #><#= c.IsNullable ? " ?? double.NaN" : "" #>;
<#
            }
            else if (IsBit(c))
            {
#>
            <#= prop #> = editing.<#= prop #>;
<#
            }
            else if (IsDate(c))
            {
#>
            <#= prop #> = <#= c.IsNullable ? $"editing.{prop}.HasValue ? new DateTimeOffset(editing.{prop}.Value) : null" : $"new DateTimeOffset(editing.{prop})" #>;
            _<#= char.ToLowerInvariant(prop[0]) + prop[1..] #>Time = editing.<#= prop #><#= c.IsNullable ? "?.TimeOfDay ?? TimeSpan.Zero" : ".TimeOfDay" #>;
<#
            }
            else
            {
#>
            <#= prop #> = editing.<#= prop #><#= c.IsNullable ? "?.ToString()" : ".ToString()" #>;
<#
            }
        }
#>
        }
    }

    // A table with no foreign-key lookups has nothing to load here - a plain, non-async Task.CompletedTask
    // avoids CS1998 ("this async method lacks 'await' operators"), found live: this method's body was always
    // empty-but-async for a parentless table.
<#
        if (parents.Count == 0)
        {
#>
    public Task LoadLookupsAsync() => Task.CompletedTask;
<#
        }
        else
        {
#>
    public async Task LoadLookupsAsync()
    {
<#
        foreach (var p in parents)
        {
            var lookupColumnsForThisParent = shown.Where(c => LookupOf(c) is ForeignKeyModel fk && fk.ReferencedTable.EqualsIgnoreCase(p.Table)).ToList();
#>
        <#= p.OptionsProp #>.Clear();
        foreach (var row in await _context.Set<<#= p.Table #>>().OrderBy(r => r.<#= p.DisplayProp #>).ToListAsync())
            <#= p.OptionsProp #>.Add(new <#= table #>DetailLookupOption { Id = row.<#= p.KeyProp #>, Text = row.<#= p.DisplayProp #>?.ToString() ?? "" });
<#
            if (lookupColumnsForThisParent.Count > 0)
            {
#>
        if (_editing is not null)
        {
<#
                foreach (var c in lookupColumnsForThisParent)
                {
#>
            <#= c.Name #> = _editing.<#= c.Name #>;
<#
                }
#>
        }
<#
            }
        }
#>
    }
<#
        }
#>

    /// <summary> Parses every text-backed field into the entity's real column type, sets ErrorMessage and
    /// returns false on the first bad or missing value, otherwise saves through <#= table #>Repo and returns true. </summary>
    public async Task<bool> SaveAsync()
    {
        ErrorMessage = null;
        var entity = _editing ?? new <#= table #>();

<#
        foreach (var c in shown)
        {
            var lookup = LookupOf(c);
            string prop = c.Name;
            string label = Label(c.Name);
            if (lookup is not null)
            {
                if (!c.IsNullable)
                {
#>
        if (<#= prop #> is null) { ErrorMessage = "<#= label #> is required."; return false; }
