<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PY_TestCatalog_v1.tt
    // Generates: tests/conftest.py and tests/test_catalog.py   (whole-database; the output folder is the Python API's folder)
    // pytest tests of what PY_Routes writes for FacetTables. conftest.py is the one PY_TestApprovals writes (the application over a scratch database). test_catalog.py adds products and attributes of its own to each case and plays the facet counts, the alternatives within an attribute, the keyword over the attribute values, the ranges, paging and the refusals. The words are CatalogWords.
    // Written only for a project with PythonTests=true and a product table the tests can fill (CatalogTestPlan); not for SQL Server.
    // Full notes: Docs/TemplateNotes/API_RowShapes_v1.md
    // ==========================================================================================
    if (PythonCatalogTests.Applies(Database, Project))
    {
        Write("@@@FILE tests/conftest.py@@@\n" + PythonApprovalTests.Conftest(Project, Database.Dialect));
        Write("@@@FILE tests/test_catalog.py@@@\n" + PythonCatalogTests.File(Database, Project));
    }
#>
