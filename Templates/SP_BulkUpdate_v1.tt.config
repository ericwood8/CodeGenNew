# Restriction checkboxes for SP_BulkUpdate_v1.tt (see Docs/specs.md section 5.3).
# One script for the whole database: the menu offers it on the database, the CLI runs it without -t.
DatabaseOnly=true
RequiresPrimaryKey=false
TableOnly=false
# No OutputName: the template writes its own path (BulkUpdate.sql) with an @@@FILE marker.
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso (and its columns in BulkUpdateColumns).
Stacks=Api,WinUI3
OutputRoot=Sql
InPlan=false
Dialects=SqlServer
