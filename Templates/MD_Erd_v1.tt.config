# Restriction checkboxes for MD_Erd_v1.tt (see Docs/Reference.md section 3).
# One diagram for the whole database: the menu offers it on the database, the CLI runs it without -t.
DatabaseOnly=true
RequiresPrimaryKey=false
TableOnly=false
# No OutputName: the template writes its own path (ErDiagram.md) with an @@@FILE marker.
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso.
Stacks=Api
OutputFolder=docs
InPlan=false
