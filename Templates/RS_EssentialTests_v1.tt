const ADMIN_USER: &str = "test-admin";
const ISSUER: &str = "<#= projectName #>.Api";
const AUDIENCE: &str = "<#= projectName #>";
const ROLE_CLAIM: &str = <#= Str(Project.AuthRoleClaim) #>;
const OWNER_CLAIM: &str = <#= Str(Project.AuthOwnerClaim) #>;

