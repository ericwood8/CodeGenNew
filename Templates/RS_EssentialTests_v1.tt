/// What the router answered: the status and the body as text.
pub struct Reply {
    pub status: StatusCode,
    pub body: String,
}

impl Reply {
    /// The body as JSON (null when it is not).
    pub fn json(&self) -> Value {
        serde_json::from_str(&self.body).unwrap_or(Value::Null)
    }
}

/// Removes the scratch copy of the database (and SQLite's journal files) when the last client that uses it is gone.
/// Windows keeps the file locked while the connections close, so a copy that stays is removed by a later run.
struct Scratch(Option<std::path::PathBuf>);

impl Drop for Scratch {
    fn drop(&mut self) {
        if let Some(path) = &self.0 {
            for suffix in ["", "-wal", "-shm"] {
                let mut name = path.clone().into_os_string();
                name.push(suffix);
                let _ = std::fs::remove_file(name);
            }
        }
    }
}

/// The application over a scratch database, with the sign-in of a user (ApiAuth) when there is one. Cloning shares the database.
#[derive(Clone)]
pub struct Client {
    router: Router,
    pool: Pool,
    token: Option<String>,
    _scratch: Arc<Scratch>,
}

/// Says why a test did nothing; the test then passes, since a missing scratch database is not a failure of the code.
pub fn skip(reason: &str) {
    eprintln!("skipped: {reason}");
}

impl Client {
    /// Starts the application over a scratch database; None (after saying why) when there is none to use.
    pub async fn start() -> Option<Client> {
        dotenvy::dotenv().ok();
<#
        if (auth)
        {
#>
        // the key and the administrator are in the environment before the application reads them
        settings();
<#
        }
#>
        let (pool, scratch) = scratch_pool().await?;
        let <#= auth ? "mut " : "" #>client = Client { router: app(pool.clone(), None), pool, token: None, _scratch: Arc::new(scratch) };
<#
        if (auth)
        {
#>
        let (name, password) = match (std::env::var("<#= prefix #>_TEST_USER"), std::env::var("<#= prefix #>_TEST_PASSWORD")) {
            (Ok(name), Ok(password)) => (name, password),
<#
            if (userTable)
            {
#>
            _ => {
                skip("the sign-in reads the user table: set <#= prefix #>_TEST_USER and <#= prefix #>_TEST_PASSWORD to a user of the scratch database");
                return None;
            }
<#
            }
            else
            {
#>
            _ => (ADMIN_USER.to_string(), settings().1.clone()),
<#
            }
#>
        };
        let login = client.send(Method::POST, "/api/auth/login", Some(&serde_json::json!({ "userName": name, "password": password }))).await;
        assert_eq!(login.status, StatusCode::OK, "the sign-in: {}", login.body);
        client.token = login.json()["token"].as_str().map(str::to_string);
<#
        }
#>
        Some(client)
    }

    /// The same application and database with no sign-in.
    pub fn anonymous(&self) -> Client {
        Client { token: None, ..self.clone() }
    }

    /// The connection pool of the scratch database, for a test that adds or removes rows with SQL.
    pub fn pool(&self) -> Pool {
        self.pool.clone()
    }
<#
        if (auth)
        {
#>

    /// Starts the application over a scratch database without signing in (a user table has no administrator to sign in as); None (after saying why) when there is none to use.
    /// Its requests need a token: as_person.
    pub async fn start_signed_out() -> Option<Client> {
        dotenvy::dotenv().ok();
        settings();
        let (pool, scratch) = scratch_pool().await?;
        Some(Client { router: app(pool.clone(), None), pool, token: None, _scratch: Arc::new(scratch) })
    }

    /// The same application and database for someone who signed in with this role (a token made with the key of the run; no user needs to exist). The token names no owner.
    pub fn in_role(&self, role: &str) -> Client {
        self.token_for("role-test", role, None)
    }

    /// The same, for someone who signed in with this role and may act for this owner.
    pub fn in_owner(&self, role: &str, owner: i64) -> Client {
        self.token_for("role-test", role, Some(owner))
    }

    /// The same, for the person of the user table with this name (a token made with the key of the run, in an ordinary role).
    pub fn as_person(&self, name: &str) -> Client {
        self.token_for(name, "Member", None)
    }

    fn token_for(&self, name: &str, role: &str, owner: Option<i64>) -> Client {
        let (key, _) = settings();
        let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_secs() as i64);
        let mut claims = serde_json::json!({ "sub": name, "name": name, "iss": ISSUER, "aud": AUDIENCE, "iat": now, "nbf": now, "exp": now + 1800, ROLE_CLAIM: role });
        if let Some(owner) = owner {
            claims[OWNER_CLAIM] = serde_json::json!(owner.to_string());
        }
        let header = URL_SAFE_NO_PAD.encode(br#"{"alg":"HS256","typ":"JWT"}"#);
        let input = format!("{header}.{}", URL_SAFE_NO_PAD.encode(claims.to_string()));
        let mut mac = Hmac::<Sha256>::new_from_slice(key.as_bytes()).expect("a key of any length");
        mac.update(input.as_bytes());
        let token = format!("{input}.{}", URL_SAFE_NO_PAD.encode(mac.finalize().into_bytes()));
        Client { token: Some(token), ..self.clone() }
    }
<#
        }
#>

    pub async fn send(&self, method: Method, path: &str, body: Option<&Value>) -> Reply {
        self.send_text(method, path, body.map(|body| ("application/json", body.to_string()))).await
    }

    /// A request whose body is text of the given content type.
    pub async fn send_text(&self, method: Method, path: &str, body: Option<(&str, String)>) -> Reply {
        let mut request = Request::builder().method(method).uri(path);
        if let Some(token) = &self.token {
            request = request.header(header::AUTHORIZATION, format!("Bearer {token}"));
        }
        let mut request = match body {
            Some((content_type, text)) => request.header(header::CONTENT_TYPE, content_type).body(Body::from(text)),
            None => request.body(Body::empty()),
        }
        .expect("a request");
        // the sign-in counts wrong passwords per address, which a request that did not come through a socket must be given
        request.extensions_mut().insert(ConnectInfo(SocketAddr::from(([127, 0, 0, 1], 40000))));
        let response = self.router.clone().oneshot(request).await.expect("the router answers");
        let status = response.status();
        let bytes = axum::body::to_bytes(response.into_body(), usize::MAX).await.expect("the body of the answer");
        Reply { status, body: String::from_utf8_lossy(&bytes).into_owned() }
    }

    pub async fn get(&self, path: &str) -> Reply {
        self.send(Method::GET, path, None).await
    }

    pub async fn post(&self, path: &str, body: &Value) -> Reply {
        self.send(Method::POST, path, Some(body)).await
    }

    pub async fn post_empty(&self, path: &str) -> Reply {
        self.send(Method::POST, path, None).await
    }

    pub async fn post_text(&self, path: &str, content_type: &str, text: String) -> Reply {
        self.send_text(Method::POST, path, Some((content_type, text))).await
    }

    pub async fn put(&self, path: &str, body: &Value) -> Reply {
        self.send(Method::PUT, path, Some(body)).await
    }

    pub async fn delete(&self, path: &str) -> Reply {
        self.send(Method::DELETE, path, None).await
    }
}

