#>
/// The signing key and the bootstrap administrator's password of this run, made once and put in the environment before the first request reads them.
fn settings() -> &'static (String, String) {
    static SETTINGS: OnceLock<(String, String)> = OnceLock::new();
    SETTINGS.get_or_init(|| {
        let key = format!("{}{}", uuid::Uuid::new_v4().simple(), uuid::Uuid::new_v4().simple());
        let password = uuid::Uuid::new_v4().simple().to_string();
        // SAFETY: this runs once, before the program under test has read the environment, and nothing else here writes it
        unsafe {
            std::env::set_var("Jwt__Key", &key);
            std::env::set_var("Bootstrap__AdminUserName", ADMIN_USER);
            std::env::set_var("Bootstrap__AdminPassword", &password);
        }
        (key, password)
    })
}

<#
        }
        if (dialect == SqlDialect.Sqlite)
        {
#>
/// A copy of the SQLite file (DATABASE_FILE, else <#= Project.DatabaseName #>, relative to the crate's folder): the tests add and remove rows in the copy and the file itself is never written.
async fn scratch_pool() -> Option<(Pool, Scratch)> {
    use sqlx::sqlite::{SqliteConnectOptions, SqlitePoolOptions};
    let source = PathBuf::from(std::env::var("DATABASE_FILE").unwrap_or_else(|_| <#= Str(Project.DatabaseName ?? "") #>.to_string()));
    if !source.is_file() {
        skip(&format!("there is no database file {}: set DATABASE_FILE to the SQLite file the tests may copy", source.display()));
        return None;
    }
    static CLEANED: std::sync::Once = std::sync::Once::new();
    CLEANED.call_once(|| {
        for entry in std::fs::read_dir(std::env::temp_dir()).into_iter().flatten().flatten() {
            let old = entry.metadata().and_then(|m| m.modified()).ok().and_then(|t| t.elapsed().ok()).is_some_and(|age| age.as_secs() > 600);
            if old && entry.file_name().to_string_lossy().starts_with("<#= crate #>_test_") {
                let _ = std::fs::remove_file(entry.path());
            }
        }
    });
    let copy = std::env::temp_dir().join(format!("<#= crate #>_test_{}.db", uuid::Uuid::new_v4().simple()));
    std::fs::copy(&source, &copy).expect("a copy of the database file");
    let pool = SqlitePoolOptions::new().max_connections(5).connect_with(SqliteConnectOptions::new().filename(&copy)).await.expect("the scratch database opens");
    Some((pool, Scratch(Some(copy))))
}
<#
        }
        else if (dialect == SqlDialect.PostgreSql)
        {
#>
/// Connects to the scratch copy of the database named by <#= connectionVariable #> (a URL; the password only from PGPASSWORD). The tests add and remove rows there.
async fn scratch_pool() -> Option<(Pool, Scratch)> {
    use sqlx::postgres::{PgConnectOptions, PgPoolOptions};
    let Ok(url) = std::env::var("<#= connectionVariable #>") else {
        skip("set <#= connectionVariable #> to the URL of a scratch copy of the database (the tests add and remove rows)");
        return None;
    };
    let mut options: PgConnectOptions = url.parse().expect("<#= connectionVariable #> is a postgres:// URL");
    if let Ok(password) = std::env::var("PGPASSWORD") {
        options = options.password(&password);
    }
    let pool = PgPoolOptions::new().max_connections(5).connect_with(options).await.expect("the scratch database opens");
    Some((pool, Scratch(None)))
}
<#
        }
        else
        {
#>
/// Connects to the scratch copy of the database named by <#= connectionVariable #> (a URL; the password only from MYSQL_PWD). The tests add and remove rows there.
async fn scratch_pool() -> Option<(Pool, Scratch)> {
    use sqlx::mysql::{MySqlConnectOptions, MySqlPoolOptions};
    let Ok(url) = std::env::var("<#= connectionVariable #>") else {
        skip("set <#= connectionVariable #> to the URL of a scratch copy of the database (the tests add and remove rows)");
        return None;
    };
    let mut options: MySqlConnectOptions = url.parse().expect("<#= connectionVariable #> is a mysql:// URL");
    if let Ok(password) = std::env::var("MYSQL_PWD") {
        options = options.password(&password);
    }
    let pool = MySqlPoolOptions::new().max_connections(5).connect_with(options).await.expect("the scratch database opens");
    Some((pool, Scratch(None)))
}
<#
        }
#>

/// Text with a short random ending, cut to the column's length, so a unique index does not stop a second run.
pub fn unique(text: &str, max_length: usize) -> String {
    let tail: String = uuid::Uuid::new_v4().simple().to_string().chars().take(6).collect();
    if max_length == 0 {
        return format!("{text} {tail}");
    }
    let tail: String = tail.chars().take(max_length).collect();
    let room = max_length.saturating_sub(tail.chars().count() + 1);
    if room > 0 { format!("{} {tail}", text.chars().take(room).collect::<String>()) } else { tail }
}

/// A key for a table whose key the database does not number.
pub fn new_key(low: i64, high: i64) -> i64 {
    low + (uuid::Uuid::new_v4().as_u128() % (high - low).max(1) as u128) as i64
}

/// A key for a table whose key is text the person chooses: random capital letters and digits, as long as the column allows (up to 12).
pub fn new_code(length: usize) -> String {
    const ALPHABET: &[u8] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    let bytes = uuid::Uuid::new_v4().into_bytes();
    (0..length.clamp(1, 12)).map(|i| ALPHABET[bytes[i] as usize % ALPHABET.len()] as char).collect()
}

/// A key as one segment of a path: everything but letters, digits and - . _ ~ is written as %XX.
pub fn segment(key: &Value) -> String {
    let text = match key {
        Value::String(text) => text.clone(),
        other => other.to_string(),
    };
    text.bytes().map(|b| if b.is_ascii_alphanumeric() || b"-._~".contains(&b) { (b as char).to_string() } else { format!("%{b:02X}") }).collect()
}

/// The key property of every row of a JSON list (empty when the value is not a list).
pub fn keys_of(rows: &Value, key_property: &str) -> Vec<Value> {
    rows.as_array().map(|rows| rows.iter().map(|row| row[key_property].clone()).collect()).unwrap_or_default()
}

/// How many parents deep a body adds rows to empty parents.
const MAX_DEPTH: u8 = 4;

/// The key of the first row the parent's API lists, for a foreign key to point at. When the parent has no list route the fallback is used. When it has no rows, a row is added with
/// the parent's own body (`body`, from test_bodies.rs; the row stays in the scratch database); None (after saying why) when that cannot be done.
pub async fn parent_key(client: &Client, route: &str, key_property: &str, fallback: Value, body: Option<crate::test_bodies::Body<'_>>, depth: u8) -> Option<Value> {
    let reply = client.get(route).await;
    if !reply.status.is_success() {
        return Some(fallback);
    }
    if let Some(key) = reply.json().as_array().and_then(|rows| rows.first()).map(|row| row[key_property].clone()) {
        return Some(key);
    }
    let Some(body) = body.filter(|_| depth < MAX_DEPTH) else {
        skip(&format!("there is no row in {route} for a foreign key to point at"));
        return None;
    };
    let created = client.post(route, &body.await?).await;
    if !created.status.is_success() {
        skip(&format!("there is no row in {route} for a foreign key to point at, and adding one answered {}", created.status));
        return None;
    }
    let key = created.json()[key_property].clone();
    if key.is_null() {
        skip(&format!("the row added to {route} did not answer its key ({key_property})"));
        return None;
    }
    Some(key)
}
<#
    }
#>
