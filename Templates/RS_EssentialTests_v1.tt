    // ==========================================================================================
    // RS_EssentialTests_v1.tt
    // Generates: tests/api/test_support.rs   (no table, no database: an essentials group; the output folder is the Rust crate's own folder)
    // What the per-table RS_Test modules share: Client, which builds the crate's router (lib.rs app) over a scratch database and sends it requests in process (no port is opened), and its helpers.
    // The database is a scratch copy: for SQLite a temporary copy of the file (DATABASE_FILE, else the file the project names; the original is never written), for PostgreSQL and MySQL the URL in
    // <PROJECT>_TEST_CONNECTION (a scratch copy of the database; the password only from PGPASSWORD or MYSQL_PWD). With none of these a test prints why it did nothing and passes.
    // With ApiAuth=true the tests sign in as a bootstrap administrator made for the run (a user table has none: <PROJECT>_TEST_USER and <PROJECT>_TEST_PASSWORD name a real user) and can make a token
    // in any role. Writes nothing unless the project sets RustTests=true. Settings: RustTests, RustCrateName, DatabaseProvider, DatabaseName, ApiAuth.
    // Full notes: Docs/TemplateNotes/RS_Test_v1.md
    // ==========================================================================================
    if (Project.RustTests)
    {
        var dialect = Project.DatabaseDialect;
        string projectName = Project.ProjectName ?? "MyApp";
        string prefix = new string(projectName.ToUpperInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '_').ToArray());
        string connectionVariable = prefix + "_TEST_CONNECTION";
        string crate = Project.RustCrateName;
        bool auth = Project.ApiAuth;
        bool userTable = auth && Project.UserTable is not null;
        string Str(string text) => "\"" + text.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";
#>
@@@FILE tests/api/test_support.rs@@@
