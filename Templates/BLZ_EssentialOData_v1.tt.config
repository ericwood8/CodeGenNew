# Restriction checkboxes for BLZ_EssentialOData_v1.tt (see Docs/Reference.md section 3).
# One of the files the Blazor OData pages need: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`; OData=true ticks it.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Blazor
EssentialsGroup=OData
EssentialsDefault=false
Description=Services/ODataSupport.cs and wwwroot/css/odata.css: the OData query helper, the filter row and the client base of the Blazor OData pages (OData=true); needs the Support group
