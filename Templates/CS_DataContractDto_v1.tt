<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the line to change to use this template in your own project. A project settings file (DtoNamespace, or ProjectName for <ProjectName>.App.Dtos) overrides it.
    // ==========================================================================================
    string dtoNamespace = Project.DtoNamespace ?? "MyApp.Dtos";

    // ==========================================================================================
    // CS_DataContractDto_v1.tt
    // Generates: <TableName>Contract.cs   (see OutputName in CS_DataContractDto_v1.tt.config)
    // A [DataContract] class for one table, for a WCF or other DataContractSerializer service: a [DataMember] per column (IsRequired for a column that cannot be NULL) and four constructors that
    // fill it the same mechanical way: empty (text "", everything else the type's default), from a DataRow, from a data reader row (IDataRecord), and a copy of another instance. A NULL in a
    // DataRow or reader becomes null for a nullable column.
    // For a service that still speaks DataContract; a new API does better with CS_Dto and a JSON serializer. Does not write the service contract or the data access.
    // Full notes: Docs/TemplateNotes/CS_DataContractDto_v1.md
    // ==========================================================================================

    string Id(ColumnModel c) => c.IsCSharpReservedWordName ? "@" + c.Name : c.Name;
    string BaseType(ColumnModel c) => c.SqlType switch
    {
        SqlDbType.Int => "int",
        SqlDbType.BigInt => "long",
        SqlDbType.SmallInt => "short",
        SqlDbType.TinyInt => "byte",
        SqlDbType.Bit => "bool",
        SqlDbType.Decimal or SqlDbType.Money or SqlDbType.SmallMoney => "decimal",
        SqlDbType.Float => "double",
        SqlDbType.Real => "float",
        SqlDbType.Date or SqlDbType.DateTime or SqlDbType.DateTime2 or SqlDbType.SmallDateTime => "DateTime",
        SqlDbType.DateTimeOffset => "DateTimeOffset",
        SqlDbType.Time => "TimeSpan",
        SqlDbType.UniqueIdentifier => "Guid",
        SqlDbType.Char or SqlDbType.VarChar or SqlDbType.NChar or SqlDbType.NVarChar or SqlDbType.Text or SqlDbType.NText or SqlDbType.Xml => "string",
        SqlDbType.Binary or SqlDbType.VarBinary or SqlDbType.Image or SqlDbType.Timestamp => "byte[]",
        _ => "object"
    };
    string ClrType(ColumnModel c) => c.IsNullable && BaseType(c) != "object" ? BaseType(c) + "?" : BaseType(c);
    string Quote(string s) => "\"" + s.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";
    // the value of <source>["Column"] as the property's type
    string FromObject(ColumnModel c, string value) => BaseType(c) switch
    {
        "int" => $"Convert.ToInt32({value})",
        "long" => $"Convert.ToInt64({value})",
        "short" => $"Convert.ToInt16({value})",
        "byte" => $"Convert.ToByte({value})",
        "bool" => $"Convert.ToBoolean({value})",
        "decimal" => $"Convert.ToDecimal({value})",
        "double" => $"Convert.ToDouble({value})",
        "float" => $"Convert.ToSingle({value})",
        "DateTime" => $"Convert.ToDateTime({value})",
        "DateTimeOffset" => $"(DateTimeOffset){value}",
        "TimeSpan" => $"(TimeSpan){value}",
        "Guid" => $"(Guid){value}",
        "string" => $"Convert.ToString({value})!",
        "byte[]" => $"(byte[]){value}",
        _ => value
    };
    string Default(ColumnModel c) => !c.IsNullable && BaseType(c) == "string" ? " = \"\";" : !c.IsNullable && BaseType(c) == "byte[]" ? " = [];" : "";

    var columns = Model.Columns.OrderBy(c => c.OrdinalPosition).ToList();
    string className = Model.TableName + "Contract";

    var o = new StringBuilder();
    void L(string s = "") => o.Append(s).Append('\n');
    void ReadFrom(string source)
    {
        foreach (var c in columns)
        {
            string value = source + "[" + Quote(c.DbName) + "]";
            L("        " + Id(c) + " = " + (c.IsNullable ? $"{value} is DBNull ? null : {FromObject(c, value)}" : FromObject(c, value)) + ";");
        }
    }

    L("using System;");
    L("using System.Data;");
    L("using System.Runtime.Serialization;");
    L();
    L("namespace " + dtoNamespace + ";");
    L();
    L("/// <summary> One row of " + Model.QuotedName + " as a data contract. </summary>");
    L("[DataContract]");
    L("public class " + className);
    L("{");
    foreach (var c in columns)
    {
        L("    [DataMember" + (c.IsNullable ? "" : "(IsRequired = true)") + "]");
        L("    public " + ClrType(c) + " " + Id(c) + " { get; set; }" + Default(c));
        L();
    }
    L("    #region Constructors");
    L();
    L("    public " + className + "() { }");
    L();
    L("    public " + className + "(DataRow row)");
    L("    {");
    ReadFrom("row");
    L("    }");
    L();
    L("    public " + className + "(IDataRecord record)");
    L("    {");
    ReadFrom("record");
    L("    }");
    L();
    L("    /// <summary> A copy of another instance. </summary>");
    L("    public " + className + "(" + className + " other)");
    L("    {");
    foreach (var c in columns)
        L("        " + Id(c) + " = other." + Id(c) + ";");
    L("    }");
    L();
    L("    #endregion Constructors");
    L("}");
    Write(o.ToString());
#>
