# Restriction checkboxes for CS_DataContractDto_v1.tt (see Docs/Reference.md section 3).
# A data contract needs no key: any table or view can be one.
Requires=
# Name the file like the class: Customer -> CustomerContract.cs
OutputName={Table}Contract.cs
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso.
Stacks=Api
PlanTables=Dto
OutputFolder=Dtos
InPlan=false
