# Restriction checkboxes for UNO_Dashboard_v1.tt (see Docs/Reference.md section 3).
# One set of files for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# No OutputName: the template writes its own paths (Services/DashboardClient.cs, Views/...) with @@@FILE markers.
# Whole-project generation (codegen generate): written only for a project with Dashboard=true.
Stacks=Uno
InPlan=false
