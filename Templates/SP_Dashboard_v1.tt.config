# Restriction checkboxes for SP_Dashboard_v1.tt (see Docs/Reference.md section 3).
# One script for the whole database; the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# Whole-project generation (codegen generate): written only for a project with Dashboard=true.
Dialects=SqlServer,PostgreSql,MySql
Stacks=Api,WinUI3
OutputRoot=Sql
InPlan=false
