<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // BLZ_Test_v1.tt
    // Generates: <Table>PageTests.cs   (the output folder is the Blazor test project, OutputBlazorTests; the BLZ_EssentialTests group writes the project around it)
    // bUnit tests of the pages BLZ_Page writes for the table, over FakeApi (no server, no database): the REST page, and with OData=true a second class for the OData page. Each checks the heading, a row
    // the server returns, the Edit button opening the dialog, Save sending the row in a PUT and ?edit=<key> opening a row. A master-detail page also checks that each read-only child grid shows the
    // child rows of the row being edited. On the REST page it also checks the grid's own behaviour: a header sorts and flips, a search sends its box and Clear drops it, Next and Previous page, the Columns
    // list hides and restores a column, a Save the API refuses shows its sentence, Delete asks first and says when a row is in use, and Clone opens the copy; a child table listed in EditableChildren shows its rows in boxes of the form and sends them, added and removed ones too, with the row in the PUT. The row is GridTestRow's, the same one the React and Angular tests use; a table with no column to recognise a row by has the heading test only.
    // With Auth=true the test signs in first, as a role that may read and write the table. Writes nothing unless the project sets BlazorTests=true.
    // Full notes: Docs/TemplateNotes/BLZ_Test_v1.md
    // ==========================================================================================
    if (!Project.BlazorTests)
    {
    }
    else if (BlazorNames.Refusal(Model, Project) is { } reason)
    {
        Error($"BLZ_Test writes no test for [{Model.SchemaName}].[{Model.TableName}]: {reason}");
    }
    else
    {
        string ns = BlazorNames.Namespace(Project);
        // what the tests look for and with which values is BlazorTestPlan's (Core); this template writes the text
        var plan = BlazorTestPlan.For(Model, Project);
        var form = plan.Form;
        var row = plan.Row;
        string type = plan.Type;
        string title = plan.Title;
        string apiRoute = plan.ApiRoute;
        string set = plan.ODataSet;
        string keyText = plan.KeyText;
        string signIn = plan.SignIn;
        string parentKeyJson = plan.ParentKeyJson;
        var children = plan.Children;
        var editable = plan.Editable;
        string? sortName = plan.SortName;
        var search = plan.Search;
        var o = new System.Text.StringBuilder();
        o.Append($"using Bunit;\nusing Microsoft.AspNetCore.Components;\nusing Microsoft.Extensions.DependencyInjection;\nusing {ns}.Pages;\n\nnamespace {ns}.Tests;\n");

        // the tests of the grid itself, REST or OData: sorting, searching or the filter row, paging, the Columns list, a refused Save, Delete and Clone
        string GridTests(bool odata)
        {
            string keyUrl = apiRoute + "/" + keyText;   // a clone goes through the REST route on both pages
            string deleteUrl = (odata ? set : apiRoute) + "/" + keyText;
            string inUse = odata ? "Conflict" : "BadRequest";   // what each route answers for a row another table points at
            string edit = "page.FindAll(\"button\").First(b => b.TextContent.Trim() == \"Edit\").Click();";
            string paged = odata ? "FakeApi.ODataPage(Row, 45)" : "FakeApi.Page(Row, 45, 1, 20)";
            string nextAsked = odata ? "Uri.UnescapeDataString(r.Path).Contains(\"$skip=" + BlazorTestPlan.PageSize + "\")" : "r.Path.Contains(\"pageNumber=2\")";
            var t = new System.Text.StringBuilder();
            if (!odata && sortName is not null)
            {
                string sort = Uri.EscapeDataString(sortName);
                t.Append($$"""

    [TestMethod]
    public void Sorts_by_a_header_and_flips_the_direction_when_it_is_clicked_again()
    {
        var page = OpenWithRow();
        page.FindAll("button.sort").First().Click();
        page.WaitForAssertion(() => Assert.IsTrue(Api.Requests.Any(r => r.Path.Contains("sortBy={{sort}}&sortDir=asc"))));
        page.FindAll("button.sort").First().Click();
        page.WaitForAssertion(() => Assert.IsTrue(Api.Requests.Any(r => r.Path.Contains("sortBy={{sort}}&sortDir=desc"))));
    }

""");
            }
            if (!odata && search is not null)
            {
                string label = search.Label.Replace("\\", "\\\\").Replace("\"", "\\\"");
                string param = search.ParamName;
                t.Append($$"""

    [TestMethod]
    public void Searches_with_the_text_typed_and_Clear_drops_it()
    {
        var page = OpenWithRow();
        page.Find("[aria-label=\"Search by {{label}}\"]").Input("zz9");
        page.FindAll("button").First(b => b.TextContent.Trim() == "Search").Click();
        page.WaitForAssertion(() => Assert.IsTrue(Api.Requests.Any(r => r.Path.Contains("{{param}}=zz9"))));
        Api.Requests.Clear();
        page.FindAll("button").First(b => b.TextContent.Trim() == "Clear").Click();
        page.WaitForAssertion(() => Assert.IsTrue(Api.Requests.Any(r => r.Path.Contains("/search?") && !r.Path.Contains("{{param}}="))));
    }

""");
            }
            if (odata && plan.ODataSort is { } sortColumn)
            {
                string path = sortColumn.Property;
                t.Append($$"""

    [TestMethod]
    public void Sorts_by_a_header_flips_the_direction_and_Shift_click_adds_a_second_sort()
    {
        var page = OpenWithRow();
        var headers = page.FindAll("button.sort");
        string Last() => Uri.UnescapeDataString(Api.Requests.Last(r => r.Path.Contains("$orderby=")).Path);
        Api.Requests.Clear();
        headers.First(h => h.GetAttribute("title")!.Contains("sort by {{sortColumn.Caption}}.")).Click();
        page.WaitForAssertion(() => StringAssert.Contains(Last(), "$orderby={{path}},"));   // ascending is written without a word
        page.FindAll("button.sort").First(h => h.GetAttribute("title")!.Contains("sort by {{sortColumn.Caption}}.")).Click();
        page.WaitForAssertion(() => StringAssert.Contains(Last(), "{{path}} desc"));
        var other = page.FindAll("button.sort").FirstOrDefault(h => !h.GetAttribute("title")!.Contains("sort by {{sortColumn.Caption}}."));
        if (other is not null)
        {
            other.Click(new Microsoft.AspNetCore.Components.Web.MouseEventArgs { ShiftKey = true });
            page.WaitForAssertion(() => StringAssert.Contains(Last(), "{{path}} desc,"));
        }
    }

""");
            }
            if (odata && plan.ODataText is { } textColumn)
            {
                string label = textColumn.Caption.Replace("\\", "\\\\").Replace("\"", "\\\"");
                string contains = $"contains(tolower({textColumn.Property}),'zz9')";
                t.Append($$"""

    [TestMethod]
    public void Filters_by_the_text_typed_in_the_filter_row_and_Clear_drops_it()
    {
        var page = OpenWithRow();
        page.Find("[aria-label=\"Filter by {{label}}\"]").Input("ZZ9");
        page.FindAll("button").First(b => b.TextContent.Trim() == "Search").Click();
        page.WaitForAssertion(() => StringAssert.Contains(Uri.UnescapeDataString(Api.Requests.Last().Path), "$filter=" + "{{contains}}"));
        Api.Requests.Clear();
        page.FindAll("button").First(b => b.TextContent.Trim() == "Clear").Click();
        page.WaitForAssertion(() => Assert.IsTrue(Api.Requests.Any(r => r.Path.StartsWith("{{set}}?") && !Uri.UnescapeDataString(r.Path).Contains("zz9"))));
    }

""");
            }
            if (odata && plan.ODataNumber is { } numberColumn)
            {
                string label = numberColumn.Caption.Replace("\\", "\\\\").Replace("\"", "\\\"");
                t.Append($$"""

    [TestMethod]
    public void Filters_a_number_column_by_a_range_and_never_sends_text_that_is_not_a_number()
    {
        var page = OpenWithRow();
        page.Find("[aria-label=\"{{label}} from\"]").Input("5");
        page.Find("[aria-label=\"{{label}} to\"]").Input("9");
        page.FindAll("button").First(b => b.TextContent.Trim() == "Search").Click();
        page.WaitForAssertion(() => StringAssert.Contains(Uri.UnescapeDataString(Api.Requests.Last().Path), "$filter=" + "{{numberColumn.Property}} ge 5 and {{numberColumn.Property}} le 9"));
        Api.Requests.Clear();
        page.Find("[aria-label=\"{{label}} from\"]").Input("abc");
        page.FindAll("button").First(b => b.TextContent.Trim() == "Search").Click();
        page.WaitForAssertion(() => StringAssert.Contains(page.Markup, "is not a number"));
        Assert.IsFalse(Api.Requests.Any(r => r.Path.Contains("abc")), "text that is not a number is not sent");
    }

""");
            }
            if (odata && plan.ODataBoolean is { } flagColumn)
            {
                string label = flagColumn.Caption.Replace("\\", "\\\\").Replace("\"", "\\\"");
                t.Append($$"""

    [TestMethod]
    public void Filters_a_yes_or_no_column_by_the_choice_made()
    {
        var page = OpenWithRow();
        page.Find("select[aria-label=\"Filter by {{label}}\"]").Change("true");
        page.FindAll("button").First(b => b.TextContent.Trim() == "Search").Click();
        page.WaitForAssertion(() => StringAssert.Contains(Uri.UnescapeDataString(Api.Requests.Last().Path), "$filter=" + "{{flagColumn.Property}} eq true"));
    }

""");
            }
            if (odata && plan.ODataDate is { } dateColumn)
            {
                string label = dateColumn.Caption.Replace("\\", "\\\\").Replace("\"", "\\\"");
                t.Append($$"""

    [TestMethod]
    public void Filters_a_date_column_by_a_range_that_includes_the_last_day()
    {
        var page = OpenWithRow();
        page.Find("[aria-label=\"{{label}} from\"]").Change("2026-03-05");
        page.Find("[aria-label=\"{{label}} to\"]").Change("2026-03-09");
        page.FindAll("button").First(b => b.TextContent.Trim() == "Search").Click();
        page.WaitForAssertion(() => StringAssert.Contains(Uri.UnescapeDataString(Api.Requests.Last().Path), "$filter=" + "{{dateColumn.Property}} ge 2026-03-05 and {{dateColumn.Property}} lt 2026-03-10"));
    }

""");
            }
            if (odata && plan.ODataChoice is { } choiceColumn)
            {
                string label = choiceColumn.Caption.Replace("\\", "\\\\").Replace("\"", "\\\"");
                t.Append($$"""

    [TestMethod]
    public void Filters_a_column_whose_values_the_database_lists_by_the_value_picked()
    {
        var page = OpenWithRow();
        page.Find("select[aria-label=\"Filter by {{label}}\"]").Change("{{plan.ODataChoiceValue}}");
        page.FindAll("button").First(b => b.TextContent.Trim() == "Search").Click();
        page.WaitForAssertion(() => StringAssert.Contains(Uri.UnescapeDataString(Api.Requests.Last().Path), "$filter=" + "{{choiceColumn.Property}} eq '{{plan.ODataChoiceValue}}'"));
    }

""");
            }
            if (odata && plan.ODataParent is { } parentColumn)
            {
                string label = parentColumn.Caption.Replace("\\", "\\\\").Replace("\"", "\\\"");
                string lookupPath = BlazorNames.ApiRoute(parentColumn.Filter!.Parent!.Table) + "/lookup";
                t.Append($$"""

    [TestMethod]
    public void Filters_a_foreign_key_by_the_parent_row_picked_from_its_drop_down()
    {
        Api.Answer("{{lookupPath}}", "[{ \"id\": 7, \"name\": \"Harness Parent\", \"isActive\": true }]");
        var page = OpenWithRow();
        page.WaitForAssertion(() => StringAssert.Contains(page.Find("select[aria-label=\"Filter by {{label}}\"]").InnerHtml, "Harness Parent"));
        page.Find("select[aria-label=\"Filter by {{label}}\"]").Change("7");
        page.FindAll("button").First(b => b.TextContent.Trim() == "Search").Click();
        page.WaitForAssertion(() => StringAssert.Contains(Uri.UnescapeDataString(Api.Requests.Last().Path), "$filter=" + "{{parentColumn.Property}} eq 7"));
    }

""");
            }
            t.Append($$"""

    [TestMethod]
    public void Pages_forward_with_Next_and_the_first_page_has_no_Previous()
    {
        var page = Open({{paged}});
        page.WaitForAssertion(() => StringAssert.Contains(page.Markup, "Page 1 of 3"));
        Assert.IsTrue(page.FindAll("button").First(b => b.TextContent.Trim() == "Previous").HasAttribute("disabled"));
        page.FindAll("button").First(b => b.TextContent.Trim() == "Next").Click();
        page.WaitForAssertion(() => Assert.IsTrue(Api.Requests.Any(r => {{nextAsked}})));
    }

    [TestMethod]
    public void Hides_a_column_unticked_in_the_Columns_list_and_Reset_shows_it_again()
    {
        var page = OpenWithRow();
        int before = page.FindAll("thead th").Count;
        page.FindAll(".column-list input[type=checkbox]").First(i => i.HasAttribute("checked") && !i.HasAttribute("disabled")).Change(false);
        page.WaitForAssertion(() => Assert.AreEqual(before - 1, page.FindAll("thead th").Count));
        page.FindAll("button").First(b => b.TextContent.Trim() == "Reset").Click();
        page.WaitForAssertion(() => Assert.AreEqual(before, page.FindAll("thead th").Count));
    }

    [TestMethod]
    public void Shows_a_sentence_and_keeps_the_dialog_open_when_the_API_refuses_a_Save()
    {
        var page = OpenWithRow();
        {{edit}}
        page.WaitForAssertion(() => Assert.IsTrue(page.FindAll("[role=dialog] input").Any(i => i.GetAttribute("value") == "{{row!.Marker}}")));
        Api.FailWrite(HttpMethod.Put, "/{{keyText}}", System.Net.HttpStatusCode.BadRequest);
        page.Find("[role=dialog] button[type=submit]").Click();
        page.WaitForAssertion(() => StringAssert.Contains(page.Find("[role=dialog] [role=alert]").TextContent, "Some of the values are not acceptable!"));
        Api.FailWrite(HttpMethod.Put, "/{{keyText}}", System.Net.HttpStatusCode.InternalServerError);
        page.Find("[role=dialog] button[type=submit]").Click();
        page.WaitForAssertion(() => StringAssert.Contains(page.Find("[role=dialog] [role=alert]").TextContent, "Problem while saving!"));
    }

    [TestMethod]
    public void Deletes_a_row_only_after_the_person_confirms()
    {
        var page = OpenWithRow();
        page.FindAll("button").First(b => b.TextContent.Trim() == "Delete").Click();
        Assert.IsFalse(Api.Requests.Any(r => r.Method == HttpMethod.Delete), "no confirmation, no delete");
        JSInterop.Setup<bool>("confirm", _ => true).SetResult(true);
        page.FindAll("button").First(b => b.TextContent.Trim() == "Delete").Click();
        page.WaitForAssertion(() => Assert.IsTrue(Api.Requests.Any(r => r.Method == HttpMethod.Delete && r.Path == "{{deleteUrl}}")));
    }

    [TestMethod]
    public void Says_a_row_that_is_in_use_cannot_be_deleted()
    {
        var page = OpenWithRow();
        JSInterop.Setup<bool>("confirm", _ => true).SetResult(true);
        Api.FailWrite(HttpMethod.Delete, "/{{keyText}}", System.Net.HttpStatusCode.{{inUse}});
        page.FindAll("button").First(b => b.TextContent.Trim() == "Delete").Click();
        page.WaitForAssertion(() => StringAssert.Contains(page.Find("p.error").TextContent, "It cannot be deleted because it is in use!"));
    }

""");
            if (odata)
            {
                t.Append($$"""

    [TestMethod]
    public void Asks_only_for_the_columns_that_are_shown()
    {
        var page = OpenWithRow();
        string Select() => Uri.UnescapeDataString(Api.Requests.Last(r => r.Path.Contains("$select=")).Path);
        int before = Select().Length;
        page.FindAll(".column-list input[type=checkbox]").First(i => i.HasAttribute("checked") && !i.HasAttribute("disabled")).Change(false);
        page.WaitForAssertion(() => Assert.IsTrue(Select().Length < before, "a hidden column is left out of $select"));
    }

    [TestMethod]
    public void Says_a_value_already_exists_when_the_API_answers_a_conflict_to_a_Save()
    {
        var page = OpenWithRow();
        {{edit}}
        page.WaitForAssertion(() => Assert.IsTrue(page.FindAll("[role=dialog] input").Any(i => i.GetAttribute("value") == "{{row!.Marker}}")));
        Api.FailWrite(HttpMethod.Put, "/{{keyText}}", System.Net.HttpStatusCode.Conflict);
        page.Find("[role=dialog] button[type=submit]").Click();
        page.WaitForAssertion(() => StringAssert.Contains(page.Find("[role=dialog] [role=alert]").TextContent, "A row with this value already exists!"));
    }

""");
            }
            if (form.CanClone)
            {
                t.Append($$"""

    [TestMethod]
    public void Clones_a_row_and_opens_the_copy_in_the_dialog()
    {
        Api.AnswerWrite(HttpMethod.Post, "/{{keyText}}/clone", Row);
        var page = OpenWithRow();
        page.FindAll("button").First(b => b.TextContent.Trim() == "Clone").Click();
        page.WaitForAssertion(() => Assert.IsTrue(Api.Requests.Any(r => r.Method == HttpMethod.Post && r.Path == "{{keyUrl}}/clone")));
        page.WaitForAssertion(() => StringAssert.Contains(page.Find("[role=dialog]").TextContent, "Edit {{title}}"));
    }

""");
            }
            return t.ToString();
        }

        // a name / active page reads the whole list: a name box and an Active only check box narrow it, a duplicate name (409) is told in words, and Delete asks first
        string NameActiveTests() => $$"""

    [TestMethod]
    public void Narrows_the_list_with_the_name_box_and_Clear_brings_it_back()
    {
        var page = OpenWithRow();
        int before = Api.Requests.Count;
        page.Find("[aria-label=\"Search by Name\"]").Input("zz9-no-such-name");
        page.WaitForAssertion(() => StringAssert.Contains(page.Markup, "Nothing found."));
        Assert.HasCount(before, Api.Requests, "the list is narrowed on the page, without another call");
        page.FindAll("button").First(b => b.TextContent.Trim() == "Clear").Click();
        page.WaitForAssertion(() => StringAssert.Contains(page.Markup, "{{row!.Marker}}"));
    }

    [TestMethod]
    public void Says_a_name_already_exists_when_the_API_answers_a_conflict_to_a_Save()
    {
        var page = OpenWithRow();
        page.FindAll("button").First(b => b.TextContent.Trim() == "Edit").Click();
        page.WaitForAssertion(() => Assert.IsTrue(page.FindAll("[role=dialog] input").Any(i => i.GetAttribute("value") == "{{row!.Marker}}")));
        Api.FailWrite(HttpMethod.Put, "/{{keyText}}", System.Net.HttpStatusCode.Conflict);
        page.Find("[role=dialog] button[type=submit]").Click();
        page.WaitForAssertion(() => StringAssert.Contains(page.Find("[role=dialog] [role=alert]").TextContent, "with this name already exists!"));
    }

    [TestMethod]
    public void Deletes_a_row_only_after_the_person_confirms_and_says_when_it_is_in_use()
    {
        var page = OpenWithRow();
        page.FindAll("button").First(b => b.TextContent.Trim() == "Delete").Click();
        Assert.IsFalse(Api.Requests.Any(r => r.Method == HttpMethod.Delete), "no confirmation, no delete");
        JSInterop.Setup<bool>("confirm", _ => true).SetResult(true);
        Api.FailWrite(HttpMethod.Delete, "/{{keyText}}", System.Net.HttpStatusCode.BadRequest);
        page.FindAll("button").First(b => b.TextContent.Trim() == "Delete").Click();
        page.WaitForAssertion(() => StringAssert.Contains(page.Find("p.error").TextContent, "It cannot be deleted because it is in use!"));
    }

""";

        void Tests(bool odata)
        {
            string pageType = odata ? BlazorNames.ODataPageName(Model.TableName) : type + "Page";
            if (!odata && !form.IsNameActive && SingleRowPlan.Applies(Model, Project, "Blazor"))
            {
                // the page is a form: the heading, the blank form of an empty table and the form of the one row
                o.Append($"\n[TestClass]\npublic class {type}PageTests : PageTestContext\n{{\n");
                if (row is not null)
                    o.Append($"    private const string Row = \"\"\"{row.Json}\"\"\";\n\n");
                o.Append($"    private IRenderedComponent<{pageType}> Open(string list)\n    {{\n        Api.Answer(\"/search\", list);\n" + signIn + $"        return Render<{pageType}>();\n    }}\n\n");
                o.Append($"    [TestMethod]\n    public void Shows_the_heading_and_a_blank_form_while_the_table_has_no_row()\n    {{\n        var page = Open(FakeApi.Page(\"\", 0));\n        StringAssert.Contains(page.Markup, \"<h1>{title}</h1>\");\n        page.WaitForAssertion(() => StringAssert.Contains(page.Find(\"[role=dialog]\").TextContent, \"Add {title}\"));\n        Assert.AreEqual(0, page.FindAll(\"button\").Count(b => b.TextContent.Trim() is \"Add New\" or \"Delete\"));\n    }}\n");
                if (row is not null)
                {
                    o.Append($"\n    [TestMethod]\n    public void Opens_the_one_row_in_the_form_and_sends_it_in_a_PUT_on_Save()\n    {{\n");
                    o.Append("        var page = Open(FakeApi.Page(Row, 1));\n");
                    o.Append($"        page.WaitForAssertion(() => Assert.IsTrue(page.FindAll(\"[role=dialog] input\").Any(i => i.GetAttribute(\"value\") == \"{row.Marker}\")));\n");
                    o.Append("        page.Find(\"[role=dialog] button[type=submit]\").Click();\n");
                    o.Append($"        page.WaitForAssertion(() => Assert.IsTrue(Api.Requests.Any(r => r.Method == HttpMethod.Put && r.Body.Contains(\"{row.Marker}\"))));\n    }}\n");
                }
                o.Append("}\n");
                return;
            }
            string route = "/" + (odata && !Project.ODataReplacesScreens ? AngularNames.ODataRoute(Model.TableName) : ScreenNames.Route(Model.TableName));
            string listPath = odata ? set : form.IsNameActive ? apiRoute : "/search";
            string listAnswer = odata ? "FakeApi.ODataPage(Row, 1)" : form.IsNameActive ? "\"[\" + Row + \"]\"" : "FakeApi.Page(Row, 1)";
            string emptyAnswer = odata ? "FakeApi.ODataPage(\"\", 0)" : form.IsNameActive ? "\"[]\"" : "FakeApi.Page(\"\", 0)";
            string keyPath = (odata ? set : apiRoute) + "/" + keyText;
            o.Append($"\n[TestClass]\npublic class {type}{(odata ? "ODataPage" : "Page")}Tests : PageTestContext\n{{\n");
            if (row is not null)
                o.Append($"    private const string Row = \"\"\"{row.Json}\"\"\";\n\n");
            o.Append($"    private IRenderedComponent<{pageType}> Open({(row is not null ? "string? list = null" : "")})\n    {{\n");
            if (row is not null)
                o.Append($"        Api.Answer(\"{listPath}\", list ?? {listAnswer});\n" + (odata ? $"        Api.Answer(\"{keyPath}\", Row);\n" : "") + signIn);
            else
                o.Append($"        Api.Answer(\"{listPath}\", {emptyAnswer});\n" + signIn);
            o.Append($"        return Render<{pageType}>();\n    }}\n\n");
            if (row is not null)
                o.Append($"    private IRenderedComponent<{pageType}> OpenWithRow()\n    {{\n        var page = Open();\n        page.WaitForAssertion(() => StringAssert.Contains(page.Markup, \"{row.Marker}\"));\n        return page;\n    }}\n\n");
            o.Append($"    [TestMethod]\n    public void Shows_the_heading()\n    {{\n        var page = Open();\n        StringAssert.Contains(page.Markup, \"<h1>{title.Pluralize()}</h1>\");\n    }}\n");
            if (row is not null)
            {
                o.Append($"\n    [TestMethod]\n    public void Shows_a_row_the_server_returns() => OpenWithRow();\n");
                o.Append($"\n    [TestMethod]\n    public void Opens_the_{BlazorNames.Identifier(Model.TableName).ToLowerInvariant()}_dialog_from_the_Edit_button_of_a_row()\n    {{\n");
                o.Append("        var page = OpenWithRow();\n        page.FindAll(\"button\").First(b => b.TextContent.Trim() == \"Edit\").Click();\n");
                o.Append($"        page.WaitForAssertion(() => StringAssert.Contains(page.Find(\"[role=dialog]\").TextContent, \"Edit {title}\"));\n    }}\n");
                o.Append($"\n    [TestMethod]\n    public void Fills_the_dialog_with_the_row_and_sends_it_in_a_PUT_on_Save()\n    {{\n");
                o.Append("        var page = OpenWithRow();\n        page.FindAll(\"button\").First(b => b.TextContent.Trim() == \"Edit\").Click();\n");
                o.Append($"        page.WaitForAssertion(() => Assert.IsTrue(page.FindAll(\"[role=dialog] input\").Any(i => i.GetAttribute(\"value\") == \"{row.Marker}\")));\n");
                o.Append("        page.Find(\"[role=dialog] button[type=submit]\").Click();\n");
                o.Append($"        page.WaitForAssertion(() => Assert.IsTrue(Api.Requests.Any(r => r.Method == HttpMethod.Put && r.Body.Contains(\"{row.Marker}\"))));\n    }}\n");
                o.Append($"\n    [TestMethod]\n    public void Opens_the_row_named_by_the_edit_query_parameter()\n    {{\n");
                o.Append($"        Services.GetRequiredService<NavigationManager>().NavigateTo(\"{route}?edit={keyText}\");\n");
                o.Append($"        Api.Answer(\"{keyPath}\", Row);\n");
                o.Append("        var page = Open();\n        page.WaitForAssertion(() => StringAssert.Contains(page.Find(\"[role=dialog]\").TextContent, \"Edit " + title + "\"));\n    }\n");
                if (!form.IsNameActive && !odata)
                {
                    // the limits the web stacks write on a number, money or date box (Core's NumberBox, MoneyBox and NotFuture): a new row's box carries them, a stored value is not held to them
                    var checks = new List<string>();
                    var storedChecks = new List<string>();
                    foreach (var c in form.Columns)
                    {
                        string field = "[role=dialog] #" + form.FieldId(c);
                        var kind = form.KindOf(c);
                        if (kind is FieldKind.Number or FieldKind.TypedNumberKey)
                        {
                            var box = NumberBox.For(Model.TableName, c, Project);
                            if (box.Min is { } min) { checks.Add($"Assert.AreEqual(\"{min}\", page.Find(\"{field}\").GetAttribute(\"min\"));"); storedChecks.Add($"Assert.IsNull(page.Find(\"{field}\").GetAttribute(\"min\"));"); }
                            if (box.Max is { } max) checks.Add($"Assert.AreEqual(\"{max}\", page.Find(\"{field}\").GetAttribute(\"max\"));");
                        }
                        else if (kind == FieldKind.Money)
                        {
                            var money = MoneyBox.For(Model.TableName, c, Project);
                            if (money.Min is { } min) checks.Add($"Assert.AreEqual(\"{min}\", page.Find(\"{field}\").GetAttribute(\"min\"));");
                            if (money.Max is { } max) checks.Add($"Assert.AreEqual(\"{max}\", page.Find(\"{field}\").GetAttribute(\"max\"));");
                        }
                        else if (kind == FieldKind.Date && c.RuleOf(Project, Model.TableName) is { NotFuture: true })
                        {
                            checks.Add($"Assert.AreEqual(DateTime.Today.ToString(\"yyyy-MM-dd\"), page.Find(\"{field}\").GetAttribute(\"max\"));");
                            storedChecks.Add($"Assert.IsNull(page.Find(\"{field}\").GetAttribute(\"max\"));");
                        }
                    }
                    if (checks.Count > 0)
                    {
                        o.Append("\n    [TestMethod]\n    public void Limits_the_number_and_date_boxes_of_a_new_row_as_the_column_does()\n    {\n        var page = OpenWithRow();\n");
                        o.Append("        page.FindAll(\"button\").First(b => b.TextContent.Trim() == \"Add New\").Click();\n");
                        o.Append("        page.WaitForAssertion(() => StringAssert.Contains(page.Find(\"[role=dialog]\").TextContent, \"Add " + title + "\"));\n");
                        foreach (var check in checks)
                            o.Append("        " + check + "\n");
                        o.Append("    }\n");
                    }
                    if (storedChecks.Count > 0)
                    {
                        o.Append("\n    [TestMethod]\n    public void Does_not_limit_a_box_that_still_holds_the_stored_value()\n    {\n        var page = OpenWithRow();\n");
                        o.Append("        page.FindAll(\"button\").First(b => b.TextContent.Trim() == \"Edit\").Click();\n");
                        o.Append("        page.WaitForAssertion(() => StringAssert.Contains(page.Find(\"[role=dialog]\").TextContent, \"Edit " + title + "\"));\n");
                        foreach (var check in storedChecks)
                            o.Append("        " + check + "\n");
                        o.Append("    }\n");
                    }
                }
                o.Append(form.IsNameActive ? NameActiveTests() : GridTests(odata));
                foreach (var child in children)
                {
                    bool served = odata && ODataPlan.ServesByName(child.Table, Project);
                    string childPath = (served ? "/odata/" : "/api/") + child.ApiRoute;
                    string childRows = "[" + ChildTestRow.Json(child, parentKeyJson) + "]";
                    string answer = (served ? "{ \"value\": " + childRows + " }" : childRows).Replace("\\", "\\\\").Replace("\"", "\\\"");
                    o.Append($"\n    [TestMethod]\n    public void Shows_the_{BlazorNames.Identifier(child.Name).ToLowerInvariant()}_rows_of_the_row_in_the_dialog()\n    {{\n");
                    o.Append($"        Api.Answer(\"{childPath}\", \"{answer}\");\n");
                    o.Append("        var page = OpenWithRow();\n        page.FindAll(\"button\").First(b => b.TextContent.Trim() == \"Edit\").Click();\n");
                    o.Append("        page.WaitForAssertion(() => Assert.AreEqual(1, page.FindAll(\"[role=dialog] tbody tr\").Count));\n    }\n");
                }
            }
            if (!odata && row is not null)
            {
                foreach (var child in editable)
                {
                    string childPath = "/api/" + child.ApiRoute;
                    string answer = ("[" + ChildTestRow.Json(child, parentKeyJson) + "]").Replace("\\", "\\\\").Replace("\"", "\\\"");
                    string id = BlazorNames.Identifier(child.Name).ToLowerInvariant();
                    string words = Labels.Words(child.BaseName);
                    o.Append($$"""

    [TestMethod]
    public void Shows_the_{{id}}_rows_of_the_row_in_boxes_of_the_form()
    {
        Api.Answer("{{childPath}}", "{{answer}}");
        var page = OpenWithRow();
        page.FindAll("button").First(b => b.TextContent.Trim() == "Edit").Click();
        page.WaitForAssertion(() => Assert.AreEqual(1, page.FindAll("[role=dialog] fieldset.child-rows tbody tr").Count));
        Assert.IsTrue(page.FindAll("[role=dialog] fieldset.child-rows tbody tr input").Count > 0, "the row is made of boxes");
    }

    [TestMethod]
    public void Adds_and_removes_a_{{id}}_row_and_sends_the_rows_with_the_row_in_the_PUT()
    {
        Api.Answer("{{childPath}}", "{{answer}}");
        var page = OpenWithRow();
        page.FindAll("button").First(b => b.TextContent.Trim() == "Edit").Click();
        page.WaitForAssertion(() => Assert.AreEqual(1, page.FindAll("[role=dialog] fieldset.child-rows tbody tr").Count));

        page.FindAll("[role=dialog] fieldset.child-rows button").First(b => b.TextContent.Trim() == "Add {{words}}").Click();
        page.WaitForAssertion(() => Assert.AreEqual(2, page.FindAll("[role=dialog] fieldset.child-rows tbody tr").Count));
        page.FindAll("[role=dialog] fieldset.child-rows button").First(b => b.TextContent.Trim() == "Remove").Click();
        page.WaitForAssertion(() => Assert.AreEqual(1, page.FindAll("[role=dialog] fieldset.child-rows tbody tr").Count));
        page.FindAll("[role=dialog] fieldset.child-rows button").First(b => b.TextContent.Trim() == "Add {{words}}").Click();

        page.Find("[role=dialog] button[type=submit]").Click();
        page.WaitForAssertion(() => Assert.IsTrue(Api.Requests.Any(r => r.Method == HttpMethod.Put
            && System.Text.Json.Nodes.JsonNode.Parse(r.Body)!["{{child.JsonName}}"] is System.Text.Json.Nodes.JsonArray { Count: 2 })));
    }
""");
                }
            }
            o.Append("}\n");
        }

        if (LogTablePlan.For(Model, Project) is not null)
            o.Append(BlazorLogTests.Body(type, plan, title));   // a log table is only read: its tests do not add, change or delete a row
        else
        {
            Tests(false);
            if (ODataPlan.Serves(Model, Project) && !Model.IsNameActiveTable)
                Tests(true);
        }
        Write("@@@FILE " + type + "PageTests.cs@@@\n" + o);
    }
#>
