<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // MySQL has real stored procedures with its own syntax: CodeGenNew.Core's MySqlProcedures writes this one for a table read from MySQL.
    if (Model.Dialect == SqlDialect.MySql)
    {
        Write(MySqlProcedures.Insert(Model));
        return GenerationEnvironment.ToString();
    }
#>
<#
    // PostgreSQL has functions rather than stored procedures: CodeGenNew.Core's PostgresProcedures writes this one for a table read from PostgreSQL.
    if (Model.Dialect == SqlDialect.PostgreSql)
    {
        Write(PostgresProcedures.Insert(Model));
        return GenerationEnvironment.ToString();
    }
#>
<#
    // ==========================================================================================
    // SP_Insert_v1.tt
    // Generates: <TableName>_Insert.sql
    // Inserts one row with properly typed parameters and returns the new key (SCOPE_IDENTITY for an identity key; a composite or caller-supplied key is a
    // parameter). Computed columns are left out, create-date columns are set by rule, a new row is never born inactive, and strings are trimmed.
    // Needs a primary key. SQL Server procedure, PostgreSQL function or MySQL procedure, by the source database.
    // Full notes: Docs/TemplateNotes/SP_Insert_v1.md

    var insertableColumns = Model.Columns
        .Where(c => !c.IsComputed && !c.IsModifiedDateColumn && !c.IsModifiedUserColumn && !c.IsInactiveReasonColumn && !c.IsAdminFlagColumn)
        .Where(c => c != Model.InactiveDateColumn)
        .ToList();

    bool HasSingleIdentityPrimaryKey = Model.PrimaryKeyColumns.Count == 1 && Model.PrimaryKeyColumns[0].IsIdentity;
    var identityColumn = HasSingleIdentityPrimaryKey ? Model.PrimaryKeyColumns[0] : null;

    var parameterColumns = insertableColumns
        .Where(c => c != identityColumn && !c.IsCreateDateColumn && !c.IsLastChangedDateColumn && c != Model.ActiveColumn)
        .ToList();

    var autoTouchedOnInsertColumns = Model.Columns.Where(c => c.IsCreateDateColumn || c.IsLastChangedDateColumn).ToList();

    string ValueExpression(ColumnModel c) =>
        c.IsStringColumn ? $"LTRIM(RTRIM({c.ParameterName}))" : c.ParameterName;

    // A newly inserted row is always active, and never an admin: hardcode these rather than taking them
    // as parameters.
    var hardcodedInsertColumns = new List<(string Name, string Value)>();
    if (Model.HasActiveInactivePair && Model.ActiveColumn is not null)
    {
        bool isNegativePolarity = Model.ActiveColumn.Name.Contains("Inactive", StringComparison.OrdinalIgnoreCase);
        hardcodedInsertColumns.Add((Model.ActiveColumn.Name, isNegativePolarity ? "0" : "1"));
    }
    foreach (var adminCol in Model.Columns.Where(c => c.IsAdminFlagColumn))
        hardcodedInsertColumns.Add((adminCol.Name, adminCol.IsStringColumn ? "'False'" : "0"));

    // One combined (columnName, valueExpression) list drives both the INSERT column list and the
    // VALUES list, so the two can never drift out of sync and comma placement only has to be computed once.
    var insertPairs = parameterColumns.Select(c => (Name: c.Name, Value: ValueExpression(c)))
        .Concat(autoTouchedOnInsertColumns.Select(c => (Name: c.Name, Value: "GETDATE()")))
        .Concat(hardcodedInsertColumns)
        .ToList();
#>
CREATE OR ALTER PROCEDURE [<#= Model.SchemaName #>].[<#= Model.TableName #>_Insert]
(
<#
    for (int i = 0; i < parameterColumns.Count; i++)
    {
        var c = parameterColumns[i];
        // Non-identity primary key columns are required (no default). String columns default to '' and
        // money columns default to 0 rather than NULL - a caller who wants a true NULL can still pass
        // it explicitly; this just makes the friendlier default apply when the argument is omitted
        // entirely. Everything else (numeric/date/bit/etc.) defaults to NULL.
        string defaultClause = c.IsPrimaryKey ? "" : (c.IsStringColumn ? " = ''" : (c.IsMoneyColumn ? " = 0" : " = NULL"));
        string comma = (i < parameterColumns.Count - 1) ? "," : "";
#>
<#= c.ParameterName #> <#= c.SqlTypeDeclaration #><#= defaultClause #><#= comma #>
<#
    }
#>
)
AS
BEGIN
<#
    if (Model.HasStartEndDatePair && Model.StartDateColumn is not null && Model.EndDateColumn is not null)
    {
        var startCol = Model.StartDateColumn;
        var endCol = Model.EndDateColumn;
#>
	IF (<#= startCol.ParameterName #> IS NOT NULL AND <#= endCol.ParameterName #> IS NOT NULL
	    AND CAST(<#= startCol.ParameterName #> AS DATETIME) > CAST(<#= endCol.ParameterName #> AS DATETIME))
	BEGIN
		RAISERROR('[<#= startCol.Name #>] must not be later than [<#= endCol.Name #>].', 16, 1);
		RETURN;
	END

<#
    }
    if (Model.HasInOutDateTimePair && Model.InDateColumn is not null && Model.InTimeColumn is not null && Model.OutDateColumn is not null && Model.OutTimeColumn is not null)
    {
        var inDate = Model.InDateColumn;
        var inTime = Model.InTimeColumn;
        var outDate = Model.OutDateColumn;
        var outTime = Model.OutTimeColumn;
#>
	IF (<#= inDate.ParameterName #> IS NOT NULL AND <#= inTime.ParameterName #> IS NOT NULL AND <#= outDate.ParameterName #> IS NOT NULL AND <#= outTime.ParameterName #> IS NOT NULL
	    AND (CAST(<#= inDate.ParameterName #> AS DATETIME) > CAST(<#= outDate.ParameterName #> AS DATETIME)
	         OR (CAST(<#= inDate.ParameterName #> AS DATETIME) = CAST(<#= outDate.ParameterName #> AS DATETIME)
	             AND CAST(<#= inTime.ParameterName #> AS TIME) > CAST(<#= outTime.ParameterName #> AS TIME))))
	BEGIN
		RAISERROR('[<#= inDate.Name #>]/[<#= inTime.Name #>] must not be later than [<#= outDate.Name #>]/[<#= outTime.Name #>].', 16, 1);
		RETURN;
	END

<#
    }
#>
	INSERT INTO [<#= Model.SchemaName #>].[<#= Model.TableName #>]
	(
<#
    for (int i = 0; i < insertPairs.Count; i++)
    {
        string comma = (i < insertPairs.Count - 1) ? "," : "";
#>
		[<#= insertPairs[i].Name #>]<#= comma #>
<#
    }
#>
	)
	VALUES
	(
<#
    for (int i = 0; i < insertPairs.Count; i++)
    {
        string comma = (i < insertPairs.Count - 1) ? "," : "";
#>
		<#= insertPairs[i].Value #><#= comma #>
<#
    }
#>
	);

<#
    if (HasSingleIdentityPrimaryKey)
    {
#>
	SELECT CAST(SCOPE_IDENTITY() AS <#= identityColumn.SqlTypeDeclaration #>) AS [<#= identityColumn.Name #>];
<#
    }
    else
    {
#>
	SELECT @@ROWCOUNT AS RowsInserted;
<#
    }
#>
END
