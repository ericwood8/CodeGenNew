# Restriction checkboxes for API_TestUsage_v1.tt (see Docs/Reference.md section 3).
# One run for the whole database: the test class of the usage routes.
Scope=Database
# Whole-project generation (codegen generate): added by ApiTests=true when UsageTables is set. The files go to the test project, not the API.
Stacks=Api
OutputRoot=ApiTests
InPlan=false
