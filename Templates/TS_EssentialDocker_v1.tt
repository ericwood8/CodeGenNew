<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // TS_EssentialDocker_v1.tt
    // Generates: Dockerfile, nginx.conf.template and .dockerignore   (no table, no database: an essentials group; the output folder is the Angular app's own folder)
    // A container for the built Angular app: a Node stage runs npm install and npm run build, an nginx stage serves dist/frontend/browser (the application builder's output for the project named
    // frontend in angular.json). The generated services call relative /api paths, so nginx forwards /api/ to the container named by the API_UPSTREAM environment variable (default api:8080),
    // and any other path gets index.html for the router. Needs no package and no secret. Image tags are the ones current when this was written; change them there.
    // ==========================================================================================
    string fromBuild = new string('-', 2) + "from=build";   // a template line may not hold two hyphens in a row (see TemplateDashTests)
#>
@@@FILE Dockerfile@@@
FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY <#= fromBuild #> /app/dist/frontend/browser /usr/share/nginx/html
ENV API_UPSTREAM=api:8080
EXPOSE 80
@@@FILE nginx.conf.template@@@
upstream api_backend {
    server ${API_UPSTREAM};
    keepalive 16;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Compress text responses, the API's JSON lists included (text/html is always compressed once gzip is on).
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types application/javascript text/javascript text/css application/json image/svg+xml text/plain application/xml;

    # ng build puts an 8 character hash in the name of its js, css and font files, so a changed file has a new name and the old one can be cached for a year (unhashed files such as favicon.ico are not matched).
    location ~ "-[A-Z0-9]{8}\.(?:js|css|woff2?)$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html names the current bundle files, so the browser asks each time whether it changed (a 304 when it did not).
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location /api/ {
        proxy_pass http://api_backend;
        # HTTP/1.1 and an empty Connection header let nginx keep its connections to the API open (the upstream block above sets keepalive).
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
@@@FILE .dockerignore@@@
node_modules/
dist/
.angular/
Dockerfile
.dockerignore
.git/
*.log
