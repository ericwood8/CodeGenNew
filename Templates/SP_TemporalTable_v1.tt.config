# Restriction checkboxes for SP_TemporalTable_v1.tt (see Docs/Reference.md section 3).
# Needs a primary key (a temporal table must have one). It writes T-SQL, so a table read from another database is refused.
RequiresPrimaryKey=true
TableOnly=true
# Name the file like the table: Customer -> Customer_Temporal.sql
OutputName={Table}_Temporal.sql
# Whole-project generation (codegen generate): the tables the project's TemporalTables setting names (setting it adds the template to the plan; or name it in PlanAlso).
Stacks=Api,WinUI3
PlanTables=Temporal
OutputRoot=Sql
InPlan=false
Dialects=SqlServer
