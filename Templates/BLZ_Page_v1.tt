<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ parameter name="Variant" type="System.String" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // BLZ_Page_v1.tt
    // Generates: Pages/<Table>Page.razor   (the path is written by the template; point the output folder at the Blazor app's folder)
    // The Blazor counterpart of TSX_Page: a grid with Edit, Clone and Delete, Add New, a search bar with a box per searchable column, paging, sortable headers, and an add / edit form
    // (EditForm with the Input components) with a drop-down for each foreign key that has a lookup. Calls the table's BLZ_Client. A foreign key to the table itself stays a plain box and a column
    // with no input (binary) is left off the form; the form is one panel, not tabs.
    // BLZ_ODataPage is this template run with Variant=OData (its config says Base=BLZ_Page_v1.tt): the same page over the table's OData client (BLZ_ODataClient) instead of the REST one, with several sorts
    // (Shift-click adds a column) and a filter row under the headers; the REST page is not touched, unless ODataScreens=Replace gives its route to the OData page.
    // With Auth=true every page asks for a signed-in person (and, for a table with ReadRoles, one of its roles); with WriteRoles the buttons that change rows show only to the roles that may.
    // Full notes: Docs/TemplateNotes/BLZ_Page_v1.md
    // ==========================================================================================

    // a money column that is not a whole number is shown with the currency symbol in the grid
    string Symbol() => Project.CurrencySymbol;
    bool HasInput(ColumnModel c) => c.CSharpBase() is not ("byte[]" or "object");
    string Ident(string name) => BlazorNames.Identifier(name);
    bool odata = Variant == "OData";

    if (odata && !ODataPlan.Serves(Model, Project))
    {
        // the OData page is written for the tables the project serves as OData and for no other; a plan runs this template for every table, so it says nothing for the rest
    }
    else if (BlazorNames.Refusal(Model, Project) is { } reason)
    {
        Error($"BLZ_Page writes no screen for [{Model.SchemaName}].[{Model.TableName}]: {reason}");
    }
    else
    {
        var form = FormModel.For(Model, Project);   // what the screen is made of, decided in Core for every stack
        var keyColumn = form.KeyColumn!;
        string type = form.BaseName;
        string ns = BlazorNames.Namespace(Project);
        string title = form.Title;
        string key = keyColumn.CSharpName();
        bool textKey = form.TextKey;   // the key is a box on the form (typed on a new row, read-only on an existing one) and a column of the grid
        const int pageSize = 20;

        var searchFields = form.SearchFields.Select(f => (Column: f.Column!, f.ParamName, Field: "filter" + Ident(f.Name), f.Label)).ToList();

        var shown = form.Columns;

        var parents = form.Parents;

        var gridColumns = form.GridColumns;
        var sortable = form.SortableColumns;
        bool canClone = form.CanClone;

        bool usesMoneyBox = shown.Any(form.IsMoneyInput);

        string pageClass = odata ? BlazorNames.ODataPageName(Model.TableName) : type + "Page";
        string route = odata && !Project.ODataReplacesScreens ? AngularNames.ODataRoute(Model.TableName) : ScreenNames.Route(Model.TableName);
        // ODataScreens=Replace: the OData page has this REST page's route, so this one is not routable (two pages at one address would be ambiguous)
        bool replaced = !odata && Project.ODataReplacesScreens && ODataPlan.Serves(Model, Project);
        string clientType = odata ? BlazorNames.ODataClientName(Model.TableName) : type + "Client";
        string ExplainCall = odata ? "ExplainOData" : "Explain";   // the OData calls also carry the API's own words for a conflict
        var filterFields = odata ? ODataFilterFields.For(form) : null;   // the filter row's control of each grid column (null: none)

        // Auth=true: the page asks for a signed-in person (and, with ReadRoles, one of the roles); with WriteRoles only the roles that may write see Add New, Edit, Clone and Delete
        IReadOnlyList<string> readRoles = Project.Auth ? WriteRolePlan.ReadFor(Project, Model) : new List<string>();
        IReadOnlyList<string> writeRoles = Project.Auth ? WriteRolePlan.For(Project, Model) : new List<string>();
        bool gated = writeRoles.Count > 0;
        string RolesExpression(IReadOnlyList<string> roles) => "[" + WriteRolePlan.Literal(roles) + "]";
        // a button that changes rows: wrapped so that only a role that may write sees it
        string Gate(string indent, string markup) => gated ? $"{indent}@if (CanWrite)\n{indent}{{\n{indent}    {markup.Trim()}\n{indent}}}" : indent + markup.Trim();

        // The child tables: each is a read-only grid under the form while a row is edited (as the React page does). The whole child table is read and filtered here by this row's key.
        // The child must have a client of its own: a plain table with a usable key, not a name / active table (whose API has no plain list).
        var children = ChildGrid.For(Model, Project)
            .Where(g => g.KeyColumn is not null && g.KeyType is not null && !g.IsNameActive && !Project.NoRepositoryFor(g.Table, default))
            .Select(g =>
            {
                string childType = BlazorNames.TypeName(g.Table);
                var lookups = g.Lookups
                    .Select(l => (Column: l.ColumnName, Type: BlazorNames.TypeName(l.ParentTable), Field: BlazorNames.ChildLookupField(l.ParentTable),
                                  IdType: l.Column!.CSharpBase(), KeyProp: l.UsesLookupEndpoint ? "Id" : l.ParentKeyName, DisplayProp: l.UsesLookupEndpoint ? "Name" : l.ParentDisplayName,
                                  ItemType: l.UsesLookupEndpoint ? BlazorNames.LookupType(l.ParentTable) : BlazorNames.TypeName(l.ParentTable), Load: l.UsesLookupEndpoint ? "GetLookupAsync" : "GetAllAsync"))
                    .ToList();
                var columns = g.Link.ReferencingTableColumns
                    .Where(c => !g.HiddenColumns.Contains(c.Name, StringComparer.OrdinalIgnoreCase) && !c.IsCredentialColumn && HasInput(c))
                    .ToList();
                var childWriteRoles = Project.Auth ? WriteRolePlan.For(Project, g.Table) : new List<string>();
                bool servedChild = odata && ODataPlan.ServesByName(g.Table, Project);   // the OData page reads a served child's rows with a filter on the parent's key
                return new
                {
                    Link = g.Link,
                    Type = childType,
                    ClientType = servedChild ? BlazorNames.ODataClientName(g.Table) : childType + "Client",
                    Served = servedChild,
                    FkJson = JsonNames.Camel(g.ForeignKeyColumn!.Name),
                    WriteGate = childWriteRoles.Count > 0 ? "Session.HasRole(" + RolesExpression(childWriteRoles) + ")" : null,
                    Var = BlazorNames.ChildVariable(g),
                    Title = g.Title,
                    FkProp = g.ForeignKeyColumn!.CSharpName(),
                    KeyProp = g.KeyColumn!.CSharpName(),
                    Route = ScreenNames.Route(g.Table),
                    // Edit opens the child's own page, which exists unless the project's Screens setting leaves it out
                    HasPage = Project.Screens.Length == 0 || Project.Screens.Contains(g.Table, StringComparer.OrdinalIgnoreCase),
                    Lookups = lookups,
                    Columns = GridColumns.For(columns)
                };
            }).ToList();
        var childLookups = children.SelectMany(ch => ch.Lookups).GroupBy(l => l.Field).Select(g => g.First()).ToList();

        // A cell of a grid row: the lookup's name for a foreign key, yes / no, a date, money with its symbol, or the value.
        string Cell(ColumnModel c, string prop, string lookupCall)
        {
            var kind = GridCells.KindOf(c, lookupCall is not null);
            if (kind == CellKind.Lookup) return "@" + lookupCall;
            if (kind == CellKind.Boolean) return c.IsNullable ? $"@({prop} is null ? \"\" : {prop} == true ? \"Yes\" : \"No\")" : $"@({prop} ? \"Yes\" : \"No\")";
            if (kind == CellKind.Date) return $"@{prop}{(c.IsNullable ? "?" : "")}.ToString(\"yyyy-MM-dd\")";
            if (kind == CellKind.Money) return $"@Money({prop}, {NumericClassifier.CurrencyDigits(c)})";
            if (kind == CellKind.Decimal) return $"@{prop}{(c.IsNullable ? "?" : "")}.ToString(\"N2\")";
            return $"@{prop}";
        }

        var o = new StringBuilder();
        void L(string s = "") => o.Append(s.Replace("§T", type).Replace("§K", key).Replace("§N", title)).Append('\n');

        L($"@@@FILE Pages/{pageClass}.razor@@@");
        if (!replaced)
            L($"@page \"/{route}\"");
        L($"@using {ns}.Models");
        L($"@using {ns}.Services");
        if (usesMoneyBox)
            L($"@using {ns}.Components");
        if (Project.Auth)
            L(readRoles.Count > 0 ? $"@attribute [Authorize(Roles = \"{string.Join(",", readRoles)}\")]" : "@attribute [Authorize]");
        L($"@inject {clientType} Client");
        if (gated || children.Any(ch => ch.WriteGate is not null))
            L("@inject AuthSession Session");
        foreach (var p in parents)
            L($"@inject {p.BaseName}Client {BlazorNames.LookupField(p)}Client");
        foreach (var ch in children)
            L($"@inject {ch.ClientType} {ch.Var}Client");
        foreach (var l in childLookups)
            L($"@inject {l.Type}Client {l.Field}Client");
        L("@inject IJSRuntime Js");
        L("@inject NavigationManager Navigation");
        L();
        L($"<PageTitle>{title.Pluralize()}</PageTitle>");
        L();
        L($"<h1>{title.Pluralize()}</h1>");
        L(Gate("", "<button type=\"button\" @onclick=\"Add\">Add New §N</button>"));
        // the OData page has the filter row under the headers in place of the search boxes
        if (searchFields.Count > 0 && !odata)
        {
            L();
            L("<div class=\"search\">");
            foreach (var f in searchFields)
                L($"    <input type=\"text\" placeholder=\"Search by {f.Label}\" aria-label=\"Search by {f.Label}\" @bind=\"{f.Field}\" @bind:event=\"oninput\" />");
            L("    <button type=\"button\" @onclick=\"SearchAsync\">Search</button>");
            L("    <button type=\"button\" @onclick=\"ClearSearchAsync\">Clear</button>");
            L("</div>");
        }
        L();
        L("@if (message is not null && row is null)");
        L("{");
        L("    <p class=\"error\">@message</p>");
        L("}");
        L();
        L("<table>");
        L("    <thead>");
        L("        <tr>");
        foreach (var c in gridColumns)
        {
            string caption = GridCaption.For(c, Labels.Field(c));
            if (sortable.Contains(c) && odata)
                L($"            <th aria-sort=\"@AriaSort(\"{c.Name}\")\"><button type=\"button\" class=\"sort\" title=\"Click to sort by {caption}. Shift-click to add it to the sort.\" @onclick='(e) => SortAsync(\"{c.Name}\", e.ShiftKey)'>{caption} @Arrow(\"{c.Name}\")<span class=\"sort-order\" hidden=\"@(Place(\"{c.Name}\") is null)\">@Place(\"{c.Name}\")</span></button></th>");
            else if (sortable.Contains(c))
                L($"            <th><button type=\"button\" class=\"sort\" @onclick='() => SortAsync(\"{c.Name}\")'>{caption} @Arrow(\"{c.Name}\")</button></th>");
            else
                L($"            <th>{caption}</th>");
        }
        L("            <th>Actions</th>");
        L("        </tr>");
        if (odata && filterFields!.Any(f => f is not null))
        {
            // the filter row: a control per column by its kind (ODataFilterFields in Core, one rule for every stack); Enter in a box searches
            L("        <tr class=\"filter-row\">");
            for (int i = 0; i < gridColumns.Count; i++)
            {
                var f = filterFields![i];
                if (f is null) { L("            <td></td>"); continue; }
                string name = f.Name;
                string label = GridCaption.For(gridColumns[i], Labels.Field(gridColumns[i]));
                string typed = $"Typed(\"{name}\")";
                string control;
                switch (f.Kind)
                {
                    case ODataFilterKind.Text:
                        control = $"<input type=\"text\" placeholder=\"contains\" aria-label=\"Filter by {label}\" @bind='{typed}.Text' @bind:event=\"oninput\" @onkeyup=\"FilterKeyAsync\" />";
                        break;
                    case ODataFilterKind.Number:
                        control = $"<div class=\"range\"><input type=\"number\" step=\"any\" placeholder=\"from\" aria-label=\"{label} from\" @bind='{typed}.From' @bind:event=\"oninput\" @onkeyup=\"FilterKeyAsync\" /><input type=\"number\" step=\"any\" placeholder=\"to\" aria-label=\"{label} to\" @bind='{typed}.To' @bind:event=\"oninput\" @onkeyup=\"FilterKeyAsync\" /></div>";
                        break;
                    case ODataFilterKind.Date:
                        // the boxes hold the day as text (yyyy-MM-dd), so they are not bound as dates
                        control = $"<div class=\"range\"><input type=\"date\" title=\"{label} from\" aria-label=\"{label} from\" value=\"@{typed}.From\" @onchange='e => {typed}.From = e.Value?.ToString()' @onkeyup=\"FilterKeyAsync\" /><input type=\"date\" title=\"{label} to\" aria-label=\"{label} to\" value=\"@{typed}.To\" @onchange='e => {typed}.To = e.Value?.ToString()' @onkeyup=\"FilterKeyAsync\" /></div>";
                        break;
                    case ODataFilterKind.Boolean:
                        control = $"<select aria-label=\"Filter by {label}\" @bind='{typed}.Flag'><option value=\"\">Any</option><option value=\"true\">Yes</option><option value=\"false\">No</option></select>";
                        break;
                    case ODataFilterKind.Parent:
                        control = $"<select aria-label=\"Filter by {label}\" @bind='{typed}.Value'><option value=\"\">Any</option>@foreach (var parent in {BlazorNames.LookupField(f.Parent!)}) {{ <option value=\"@parent.{BlazorNames.KeyProperty(f.Parent!)}\">@parent.{BlazorNames.DisplayProperty(f.Parent!)}</option> }}</select>";
                        break;
                    default:
                        control = $"<select aria-label=\"Filter by {label}\" @bind='{typed}.Value'><option value=\"\">Any</option>" + string.Concat(f.Choices.Select(choice => $"<option value=\"{ChoiceFormat.Html(choice)}\">{ChoiceFormat.Html(choice)}</option>")) + "</select>";
                        break;
                }
                string empty = f.Nullable && f.Kind != ODataFilterKind.Boolean
                    ? $"<label class=\"empty-toggle\" title=\"Only the rows where {label} is empty\"><input type=\"checkbox\" @bind='{typed}.Empty' /> empty</label>"
                    : "";
                L($"            <td>{control}{empty}</td>");
            }
            L("            <td class=\"filter-actions\">");
            L("                <button type=\"button\" @onclick=\"SearchAsync\">Search</button>");
            L("                <button type=\"button\" @onclick=\"ClearSearchAsync\">Clear</button>");
            L("            </td>");
            L("        </tr>");
        }
        L("    </thead>");
        L("    <tbody>");
        L("        @foreach (var item in items)");
        L("        {");
        L("            <tr>");
        foreach (var c in gridColumns)
        {
            string prop = $"item.{c.CSharpName()}";
            var lookup = form.LookupOf(c);
            string cell = Cell(c, prop, lookup is not null ? $"Name{form.ParentOf(c)!.BaseName}({prop})" : null);
            L($"                <td>{cell}</td>");
        }
        L("                <td>");
        L(Gate("                    ", odata ? "<button type=\"button\" @onclick=\"() => OpenAsync(item)\">Edit</button>" : "<button type=\"button\" @onclick=\"() => Edit(item)\">Edit</button>"));
        if (canClone)
            L(Gate("                    ", "<button type=\"button\" @onclick=\"() => CloneAsync(item)\">Clone</button>"));
        L(Gate("                    ", "<button type=\"button\" @onclick=\"() => DeleteAsync(item)\">Delete</button>"));
        L("                </td>");
        L("            </tr>");
        L("        }");
        L("    </tbody>");
        L("</table>");
        L();
        L("<div class=\"paging\">");
        L("    <button type=\"button\" disabled=\"@(pageNumber <= 1)\" @onclick=\"() => LoadAsync(pageNumber - 1)\">Previous</button>");
        L("    <span>Page @pageNumber of @totalPages</span>");
        L("    <button type=\"button\" disabled=\"@(pageNumber >= totalPages)\" @onclick=\"() => LoadAsync(pageNumber + 1)\">Next</button>");
        L("</div>");
        L("<label class=\"page-size\">");
        L("    Rows per page");
        L("    <select @onchange=\"ChangePageSizeAsync\">");
        L("        @foreach (var size in PageSizeChoices)");
        L("        {");
        L("            <option value=\"@size\" selected=\"@(size == PageSize)\">@size</option>");
        L("        }");
        L("    </select>");
        L("</label>");
        L("@if (loaded && items.Count == 0)");
        L("{");
        L("    <p class=\"no-rows\">Nothing found.</p>");
        L("}");
        L();
        L("@if (row is not null)");
        L("{");
        L("    <div class=\"editor\" role=\"dialog\" aria-label=\"@(isNew ? \"Add\" : \"Edit\") §N\">");
        L("        <h2>@(isNew ? \"Add\" : \"Edit\") §N</h2>");
        L("        @if (message is not null)");
        L("        {");
        L("            <p class=\"error\" role=\"alert\">@message</p>");
        L("        }");
        L("        <EditForm Model=\"row\" OnValidSubmit=\"SaveAsync\">");
        foreach (var c in shown)
        {
            string id = form.FieldId(c);
            string label = Labels.Field(c);
            string bind = $"row.{c.CSharpName()}";
            string required = c.IsNullable ? "" : " required";
            string input;
            var kind = form.KindOf(c);
            if (kind == FieldKind.SystemStamp)
            {
                // who made the row and when it changed: the system writes it, so it is text, shown once the row exists
                string stampText = IsDate(c) ? $"@{bind}{(c.IsNullable ? "?" : "")}.ToString(\"g\")" : $"@{bind}";
                // a row from before the stamp existed says so instead of showing nothing
                if (form.IsGuardStamp(c))
                    stampText = IsDate(c) ? $"@({bind}{(c.IsNullable ? "?" : "")}.ToString(\"g\") ?? \"{GuardStamp.NotRecorded}\")" : $"@({bind} ?? \"{GuardStamp.NotRecorded}\")";
                L($"            @if (!isNew) {{ <div class=\"field\"><label for=\"{id}\">{label}</label><span id=\"{id}\">{stampText}</span></div> }}");
                continue;
            }
            if (kind == FieldKind.TypedKey)
            {
                // the key of a new row is typed; once the row exists it is read-only (the API does not change a key)
                string max = Chars(c) is > 0 and < 4000 ? $" maxlength=\"{Chars(c)}\"" : "";
                input = $"<InputText id=\"{id}\" @bind-Value=\"{bind}\"{max} readonly=\"@(!isNew)\" required />";
            }
            else if (kind == FieldKind.Lookup)
            {
                var p = form.ParentOf(c)!;
                string blank = c.IsNullable ? "<option value=\"\">None</option>" : c.CSharpBase() == "string" ? "<option value=\"\">Select</option>" : $"<option value=\"@(default({c.CSharpBase()}))\">Select</option>";
                input = $"<InputSelect id=\"{id}\" @bind-Value=\"{bind}\">{blank}@foreach (var parent in {BlazorNames.LookupField(p)}) {{ <option value=\"@parent.{BlazorNames.KeyProperty(p)}\">@parent.{BlazorNames.DisplayProperty(p)}</option> }}</InputSelect>";
            }
            else if (kind == FieldKind.Choices)
            {
                // A column whose values the database lists (a CHECK list, a MySQL enum) is a drop-down of them; the blank first entry keeps a new row from silently taking the first value.
                string choices = string.Join("", c.Choices!.Select(choice => $"<option value=\"{ChoiceFormat.Html(choice)}\">{ChoiceFormat.Html(choice)}</option>"));
                input = $"<InputSelect id=\"{id}\" @bind-Value=\"{bind}\"{required}><option value=\"\"></option>{choices}</InputSelect>";
            }
            else if (kind == FieldKind.Boolean)
            {
                input = c.IsNullable
                    ? $"<InputSelect id=\"{id}\" @bind-Value=\"{bind}\"><option value=\"\"></option><option value=\"true\">Yes</option><option value=\"false\">No</option></InputSelect>"
                    : $"<InputCheckbox id=\"{id}\" @bind-Value=\"{bind}\" />";
            }
            else if (kind == FieldKind.Date)
                input = $"<InputDate id=\"{id}\" @bind-Value=\"{bind}\"{required} />";
            else if (kind == FieldKind.Money)
                input = $"<CurrencyInput id=\"{id}\" @bind-Value=\"{bind}\" Digits=\"{NumericClassifier.CurrencyDigits(c)}\" Symbol=\"{Symbol()}\"{required} />";
            else if (kind == FieldKind.Number)
            {
                string width = Project.NumberBoxCharacters(c) is { } boxWidth ? $" style=\"width: {boxWidth}ch\"" : "";
                input = $"<InputNumber id=\"{id}\" @bind-Value=\"{bind}\"{width}{required} />";
            }
            else if (c.CSharpBase() == "string")
            {
                string max = Chars(c) is > 0 and < 4000 ? $" maxlength=\"{Chars(c)}\"" : "";
                input = IsMultiline(c)
                    ? $"<InputTextArea id=\"{id}\" @bind-Value=\"{bind}\"{max}{required} />"
                    : $"<InputText id=\"{id}\" @bind-Value=\"{bind}\"{max}{required} />";
            }
            else
                input = $"<input id=\"{id}\" @bind=\"{bind}\"{required} />";
            if (form.GuardOf(c) is { } guard)
            {
                // a guarded column is a control only for a person who may change it (the guards answer); everyone else sees its value as text and why
                string shown2 = c.IsBooleanColumn ? $"@({bind} == true ? \"Yes\" : \"No\")" : $"@{bind}";
                string note = ChoiceFormat.Html(guard.Note).Replace("@", "@@");
                input = $"@if (guards.GetValueOrDefault(\"{guard.Json}\")) {{ {input} }} else {{ <span id=\"{id}\">{shown2}</span> <small class=\"guard-note\">{note}</small> }}";
            }
            L($"            <div class=\"field\"><label for=\"{id}\">{label}{RequiredMark.Html(form.IsMarked(c))}</label>{input}</div>");
        }
        L("            <ValidationSummary />");
        L("            <div class=\"actions\">");
        L("                <button type=\"submit\">Save</button>");
        L("                <button type=\"button\" @onclick=\"Cancel\">Cancel</button>");
        L("            </div>");
        L("        </EditForm>");
        if (children.Count > 0)
        {
            L("        @if (!isNew)");
            L("        {");
            foreach (var ch in children)
            {
                L($"            <h3>{ch.Title}</h3>");
                L($"            @if ({ch.Var}Rows.Count == 0)");
                L("            {");
                L("                <p class=\"no-rows\">Nothing found.</p>");
                L("            }");
                L("            else");
                L("            {");
                L("                <table>");
                L("                    <thead>");
                L("                        <tr>");
                foreach (var c in ch.Columns)
                    L($"                            <th>{GridCaption.For(c, Labels.Field(c))}</th>");
                L("                            <th>Actions</th>");
                L("                        </tr>");
                L("                    </thead>");
                L("                    <tbody>");
                L($"                        @foreach (var line in {ch.Var}Rows)");
                L("                        {");
                L("                            <tr>");
                foreach (var c in ch.Columns)
                {
                    string prop = $"line.{c.CSharpName()}";
                    var l = ch.Lookups.FirstOrDefault(x => x.Column.EqualsIgnoreCase(c.Name));
                    L($"                                <td>{Cell(c, prop, l.Field is not null ? $"Name{l.Field}({prop})" : null)}</td>");
                }
                L("                                <td>");
                if (ch.HasPage)
                    L($"                                    <button type=\"button\" @onclick=\"() => Edit{ch.Var}(line)\">Edit</button>");
                if (ch.WriteGate is not null)
                    L($"                                    @if ({ch.WriteGate}) {{ <button type=\"button\" @onclick=\"() => Delete{ch.Var}(line)\">Delete</button> }}");
                else
                    L($"                                    <button type=\"button\" @onclick=\"() => Delete{ch.Var}(line)\">Delete</button>");
                L("                                </td>");
                L("                            </tr>");
                L("                        }");
                L("                    </tbody>");
                L("                </table>");
                L("            }");
            }
            L("        }");
        }
        L("    </div>");
        L("}");
        L();
        L("@code {");
        L($"    private int PageSize = {pageSize};");
        L("    private static readonly int[] PageSizeChoices = [10, 20, 50, 100];");
        L("    private bool loaded;   // true once a page has arrived, so \"Nothing found.\" is not shown while waiting");
        L("    private List<§T> items = [];");
        foreach (var p in parents)
            L($"    private List<{BlazorNames.ItemType(p)}> {BlazorNames.LookupField(p)} = [];");
        foreach (var ch in children)
            L($"    private List<{ch.Type}> {ch.Var}Rows = [];");
        foreach (var l in childLookups)
            L($"    private List<{l.ItemType}> {l.Field} = [];");
        L("    private §T? row;");
        L("    private bool isNew;");
        L("    private string? message;");
        if (form.Guards.Count > 0)
            L("    private Dictionary<string, bool> guards = new();   // which guarded columns the signed-in person may change (GET guards)");
        L("    private int pageNumber = 1;");
        L("    private int totalPages = 1;");
        if (odata)
        {
            L("    private List<(string Column, bool Descending)> sorts = [];   // a click sorts by the column, a Shift-click adds it as the next sort; kept in the browser under SortsKey");
            L($"    private const string SortsKey = \"{(Project.ProjectName ?? "MyApp").ToLowerInvariant()}.sorts.{pageClass.ToLowerInvariant()}\";");
            L($"    private static readonly string[] SortableColumns = [{string.Join(", ", gridColumns.Where(c => sortable.Contains(c)).Select(c => "\"" + c.Name + "\""))}];");
            L($"    private static readonly string[] SelectColumns = [{string.Join(", ", gridColumns.Select(c => "\"" + JsonNames.Camel(c.Name) + "\""))}];   // the grid asks for these and the key; a row is read whole when it is opened");
            L("    private readonly Dictionary<string, ColumnFilter> typed = new();   // what is in the controls of the filter row");
            L("    private List<string> applied = [];   // the conditions the last Search asked for, kept while paging");
            L("    private ColumnFilter Typed(string name) => typed.TryGetValue(name, out var filter) ? filter : typed[name] = new ColumnFilter();");
        }
        else
        {
            L("    private string? sortBy;");
            L("    private bool descending;");
        }
        if (gated)
            L($"    private bool CanWrite => Session.HasRole({RolesExpression(writeRoles)});   // WriteRoles: the roles that may add, change and delete rows");
        if (odata && filterFields!.Any(f => f is not null))
        {
            L("    private static readonly ODataFilterField[] FilterFields =");
            L("    [");
            foreach (var f in filterFields!.Where(f => f is not null))
                L($"        new(\"{f!.Name}\", \"{f.Property}\", ODataFilterKind.{f.Kind}, {(f.Nullable ? "true" : "false")}{(f.Literal is null ? "" : $", \"{f.Literal}\"")}),");
            L("    ];");
        }
        L("    // Opened from another page's grid (?edit=<id>&back=<that page>): open this row, and go back to that page when the form is saved or cancelled.");
        L("    [Parameter, SupplyParameterFromQuery(Name = \"edit\")] public string? EditId { get; set; }");
        L("    [Parameter, SupplyParameterFromQuery(Name = \"back\")] public string? Back { get; set; }");
        if (!odata)
            foreach (var f in searchFields)
                L($"    private string? {f.Field};");
        L();
        L("    protected override async Task OnInitializedAsync()");
        L("    {");
        foreach (var p in parents)
            L($"        try {{ {BlazorNames.LookupField(p)} = await {BlazorNames.LookupField(p)}Client.{BlazorNames.LoadCall(p)}(); }} catch (Exception ex) when (ex is ApiException or HttpRequestException) {{ }}");
        foreach (var l in childLookups)
            L($"        try {{ {l.Field} = await {l.Field}Client.{l.Load}(); }} catch (Exception ex) when (ex is ApiException or HttpRequestException) {{ }}");
        if (form.Guards.Count > 0)
            L("        try { guards = await Client.GetGuardsAsync(); } catch (Exception ex) when (ex is ApiException or HttpRequestException) { }");
        if (odata)
            L("        sorts = await SavedSorts.LoadAsync(Js, SortsKey, SortableColumns);");
        L("        await LoadAsync();");
        L(gated ? "        if (EditId is not null && CanWrite)" : "        if (EditId is not null)");
        L("        {");
        L("            try { " + (children.Count > 0 ? "await " : "") + "Edit(await Client.GetAsync(" + (keyColumn.CSharpBase() == "string" ? "EditId" : keyColumn.CSharpBase() + ".Parse(EditId)") + ")); }");
        L($"            catch (Exception ex) when (ex is ApiException or HttpRequestException or FormatException) {{ message = \"This {title.ToLowerInvariant()} no longer exists!\"; }}");
        L("        }");
        L("    }");
        if (!odata)
        {
            L();
            if (searchFields.Count > 0)
            {
                L("    private IReadOnlyDictionary<string, string?> Filters() => new Dictionary<string, string?>");
                L("    {");
                foreach (var f in searchFields)
                    L($"        [\"{f.ParamName}\"] = {f.Field},");
                L("    };");
            }
            else
            {
                L("    private IReadOnlyDictionary<string, string?> Filters() => new Dictionary<string, string?>();");
            }
        }
        L();
        L("    private async Task LoadAsync(int target = 1)");
        L("    {");
        L("        try");
        L("        {");
        L(odata ? "            var result = await Client.QueryPageAsync(new ODataPageQuery(target, PageSize, null, sorts, applied, SelectColumns));"
                : "            var result = await Client.GetPageAsync(target, PageSize, Filters(), sortBy, descending);");
        L("            // the last row of the last page was deleted, or rows were removed elsewhere: the page asked for is past the end, so show the last page there is");
        L("            if (result.Items.Count == 0 && result.TotalCount > 0 && target > 1)");
        L("            {");
        L("                await LoadAsync(Math.Max(result.TotalPages, 1));");
        L("                return;");
        L("            }");
        L("            items = result.Items;");
        L("            pageNumber = result.Page;");
        L("            totalPages = Math.Max(result.TotalPages, 1);");
        L("            loaded = true;");
        L("            message = null;");
        L("        }");
        if (odata)
            L("        catch (FormatException ex) { message = ex.Message; }   // a number, date or guid in the filter row that is not one is never sent");
        L($"        catch (Exception ex) when (ex is ApiException or HttpRequestException) {{ message = \"Failed to load {title.ToLowerInvariant().Pluralize()}.\"; }}");
        L("    }");
        if (odata)
        {
            if (filterFields!.Any(f => f is not null))
            {
                L();
                L("    private async Task SearchAsync()");
                L("    {");
                L("        row = null;");
                L("        try { applied = ODataFilters.ConditionsOf(FilterFields, typed); }");
                L("        catch (FormatException ex) { message = ex.Message; return; }");
                L("        await LoadAsync();");
                L("    }");
                L();
                L("    private async Task ClearSearchAsync()");
                L("    {");
                L("        typed.Clear();");
                L("        applied = [];");
                L("        await LoadAsync();");
                L("    }");
                L();
                L("    // Enter in a box of the filter row searches.");
                L("    private async Task FilterKeyAsync(KeyboardEventArgs args)");
                L("    {");
                L("        if (args.Key == \"Enter\") await SearchAsync();");
                L("    }");
            }
            L();
            L("    // A click sorts by the column (again: flips it); a Shift-click adds the column as the next sort (again: flips it, once more: takes it out).");
            L("    private async Task SortAsync(string column, bool shift)");
            L("    {");
            L("        int at = sorts.FindIndex(s => s.Column == column);");
            L("        if (shift)");
            L("        {");
            L("            if (at < 0) sorts.Add((column, false));");
            L("            else if (!sorts[at].Descending) sorts[at] = (column, true);");
            L("            else sorts.RemoveAt(at);");
            L("        }");
            L("        else");
            L("        {");
            L("            sorts = sorts.Count == 1 && at == 0 ? [(column, !sorts[0].Descending)] : [(column, false)];");
            L("        }");
            L("        await SavedSorts.SaveAsync(Js, SortsKey, sorts);");
            L("        await LoadAsync();");
            L("    }");
            L();
            L("    private string Arrow(string column) => sorts.FirstOrDefault(s => s.Column == column) is { Column: not null } sort ? (sort.Descending ? \"\\u25BC\" : \"\\u25B2\") : \"\";");
            L();
            L("    private string? AriaSort(string column) => sorts.FirstOrDefault(s => s.Column == column) is { Column: not null } sort ? (sort.Descending ? \"descending\" : \"ascending\") : null;");
            L();
            L("    // The place of the column in the sort (1, 2, ...) when the grid is sorted by more than one.");
            L("    private int? Place(string column) { int at = sorts.FindIndex(s => s.Column == column); return sorts.Count > 1 && at >= 0 ? at + 1 : null; }");
        }
        else
        {
            if (searchFields.Count > 0)
            {
                L();
                L("    private async Task SearchAsync()");
                L("    {");
                L("        row = null;");
                L("        await LoadAsync();");
                L("    }");
                L();
                L("    private async Task ClearSearchAsync()");
                L("    {");
                foreach (var f in searchFields)
                    L($"        {f.Field} = null;");
                L("        await LoadAsync();");
                L("    }");
            }
            L();
            L("    // Click a header to sort by it, click it again to flip the direction; the sort is kept while paging and searching.");
            L("    private async Task SortAsync(string column)");
            L("    {");
            L("        descending = sortBy == column && !descending;");
            L("        sortBy = column;");
            L("        await LoadAsync();");
            L("    }");
            L();
            L("    private string Arrow(string column) => sortBy != column ? \"\" : descending ? \"\\u25BC\" : \"\\u25B2\";");
        }
        foreach (var p in parents)
        {
            L();
            L($"    private string Name{p.BaseName}({p.Column.CSharpBase()}? id) => Convert.ToString({BlazorNames.LookupField(p)}.FirstOrDefault(p => Equals(p.{BlazorNames.KeyProperty(p)}, id))?.{BlazorNames.DisplayProperty(p)}) ?? \"\";");
        }
        foreach (var l in childLookups)
        {
            L();
            L($"    private string Name{l.Field}({l.IdType}? id) => Convert.ToString({l.Field}.FirstOrDefault(p => Equals(p.{l.KeyProp}, id))?.{l.DisplayProp}) ?? \"\";");
        }
        if (gridColumns.Any(c => c.IsMoneyAmount) || children.Any(ch => ch.Columns.Any(c => c.IsMoneyAmount)))
        {
            L();
            L("    // Money in the grid: the currency symbol, thousands separators and the column's decimals.");
            L($"    private static string Money(decimal? value, int digits) => value is null ? \"\" : (value < 0 ? \"-\" : \"\") + \"{Symbol()}\" + Math.Abs(value.Value).ToString(\"N\" + digits, System.Globalization.CultureInfo.InvariantCulture);");
            L("    private static string Money(double? value, int digits) => value is null ? \"\" : Money((decimal)value.Value, digits);");
        }
        L();
        var adds = Model.Columns.Where(c => !c.IsPrimaryKey && !c.IsNullable && !c.IsComputed && !c.IsIdentity)
            .Select(c => c.IsBooleanColumn && c.DatabaseDefaultSql is not null && c.DatabaseDefaultSql.Trim('(', ')', ' ') == "1" ? $"{c.CSharpName()} = true"
                : IsDate(c) ? $"{c.CSharpName()} = DateTime.Today" : null)
            .Where(s => s is not null).ToList();
        string addNew = adds.Count == 0 ? "new §T()" : $"new §T {{ {string.Join(", ", adds)} }}";
        if (odata)
        {
            L("    // The grid read only the columns it shows: the row is read whole before the form opens it.");
            L("    private async Task OpenAsync(§T item)");
            L("    {");
            L("        try { " + (children.Count > 0 ? "await " : "") + "Edit(await Client.GetAsync(item.§K)); }");
            L("        catch (Exception ex) when (ex is ApiException or HttpRequestException)");
            L("        {");
            L("            await LoadAsync(pageNumber);");
            L($"            message = \"This {title.ToLowerInvariant()} no longer exists!\";");
            L("        }");
            L("    }");
            L();
        }
        if (children.Count == 0)
        {
            L($"    private void Add() => Edit({addNew}, true);");
            L();
            L("    private void Edit(§T item, bool add = false)");
            L("    {");
            L("        row = add ? item : item.Copy();");
            L("        isNew = add;");
            L("        message = null;");
            L("    }");
        }
        else
        {
            L($"    private Task Add() => Edit({addNew}, true);");
            L();
            L("    private async Task Edit(§T item, bool add = false)");
            L("    {");
            L("        row = add ? item : item.Copy();");
            L("        isNew = add;");
            L("        message = null;");
            foreach (var ch in children)
                L($"        {ch.Var}Rows = [];");
            L("        if (!add) await LoadChildrenAsync();");
            L("    }");
            L();
            L("    // The child rows that point at the row being edited (the whole child table is read and filtered here).");
            L("    private async Task LoadChildrenAsync()");
            L("    {");
            L("        if (row is null) return;");
            L("        var rowKey = row.§K;");
            foreach (var ch in children)
                L(ch.Served
                    ? $"        try {{ {ch.Var}Rows = await {ch.Var}Client.GetWhereAsync(\"{ch.FkJson}\", rowKey); }} catch (Exception ex) when (ex is ApiException or HttpRequestException) {{ {ch.Var}Rows = []; }}"
                    : $"        try {{ {ch.Var}Rows = (await {ch.Var}Client.GetAllAsync()).Where(line => line.{ch.FkProp} == rowKey).ToList(); }} catch (Exception ex) when (ex is ApiException or HttpRequestException) {{ {ch.Var}Rows = []; }}");
            L("    }");
            foreach (var ch in children)
            {
                if (ch.HasPage)
                {
                    L();
                    L($"    // Edit opens the {ch.Title}'s own page on that row; saving or cancelling there comes back here with this {title} open again.");
                    L($"    private void Edit{ch.Var}({ch.Type} line)");
                    L("    {");
                    L($"        string back = \"/{ScreenNames.Route(Model.TableName)}?edit=\" + Uri.EscapeDataString(Convert.ToString(row!.§K)!);");
                    L($"        Navigation.NavigateTo(\"/{ch.Route}?edit=\" + Uri.EscapeDataString(Convert.ToString(line.{ch.KeyProp})!) + \"&back=\" + Uri.EscapeDataString(back));");
                    L("    }");
                }

                L();
                L($"    private async Task Delete{ch.Var}({ch.Type} line)");
                L("    {");
                L("        if (!await Js.InvokeAsync<bool>(\"confirm\", \"Are you sure you want to delete this?\")) return;");
                L("        try");
                L("        {");
                L($"            await {ch.Var}Client.DeleteAsync(line.{ch.KeyProp});");
                L("            await LoadChildrenAsync();");
                L("        }");
                L("        catch (ApiException ex) { message = ex." + ExplainCall + "(\"deleting\"); }");
                L("        catch (HttpRequestException) { message = \"Problem while deleting!\"; }");
                L("    }");
            }
        }
        L();
        L("    private void Cancel()");
        L("    {");
        L("        row = null;");
        L("        message = null;");
        L("        if (Back is not null) Navigation.NavigateTo(Back);");
        L("    }");
        L();
        L("    private async Task SaveAsync()");
        L("    {");
        L("        if (row is null) return;");
        L("        try");
        L("        {");
        L("            if (isNew) await Client.CreateAsync(row);");
        L("            else await Client.UpdateAsync(row.§K, row);");
        L("            row = null;");
        L("            await LoadAsync(pageNumber);");
        L("            if (Back is not null) Navigation.NavigateTo(Back);");
        L("        }");
        // a typed key can already be taken: the API answers 409
        if (textKey)
            L($"        catch (ApiException ex) when (ex.Status == {HttpStatus.Conflict}) {{ message = \"A {title.ToLowerInvariant()} with this {Labels.Column(keyColumn.Name).ToLowerInvariant()} already exists!\"; }}");
        L("        catch (ApiException ex) { message = ex." + ExplainCall + "(\"saving\"); }");
        L("        catch (HttpRequestException) { message = \"Problem while saving!\"; }");
        L("    }");
        L();
        L("    private async Task ChangePageSizeAsync(ChangeEventArgs args)");
        L("    {");
        L("        if (int.TryParse(args.Value?.ToString(), out int size) && PageSizeChoices.Contains(size))");
        L("        {");
        L("            PageSize = size;");
        L("            await LoadAsync(1);");
        L("        }");
        L("    }");
        L();
        L("    private async Task DeleteAsync(§T item)");
        L("    {");
        L("        if (!await Js.InvokeAsync<bool>(\"confirm\", \"Are you sure you want to delete this?\")) return;");
        L("        try");
        L("        {");
        L("            await Client.DeleteAsync(item.§K);");
        L("            await LoadAsync(pageNumber);");
        L("        }");
        L("        catch (ApiException ex)");
        L("        {");
        L("            message = ex." + ExplainCall + "(\"deleting\");");
        L($"            if (ex.Status == {HttpStatus.NotFound}) await LoadAsync(pageNumber);");
        L("        }");
        L("        catch (HttpRequestException) { message = \"Problem while deleting!\"; }");
        L("    }");
        if (canClone)
        {
            L();
            L("    // The API copies the row; the copy opens in the form so the person changes what differs.");
            L("    private async Task CloneAsync(§T item)");
            L("    {");
            L("        try");
            L("        {");
            L("            var copy = await Client.CloneAsync(item.§K);");
            L("            await LoadAsync(pageNumber);");
            L(children.Count > 0 ? "            await Edit(copy);" : "            Edit(copy);");
            L("        }");
            L("        catch (ApiException ex)");
            L("        {");
            L("            message = ex." + ExplainCall + "(\"cloning\");");
            L($"            if (ex.Status == {HttpStatus.NotFound}) await LoadAsync(pageNumber);");
            L("        }");
            L("        catch (HttpRequestException) { message = \"Problem while cloning!\"; }");
            L("    }");
        }
        L("}");
        Write(o.ToString());
    }
#>
