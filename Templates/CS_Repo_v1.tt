<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS -- the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string repositoryNamespace = "TimeEntry.Common.Repositories";
    string contextType = "TimeEntryContext";
    // Namespaces the generated file must "using" (for example "MyApp.Entities"; leave empty when the project supplies them through
    // global usings, as TimeEntryServer does). Each entry becomes a using line in the generated file.
    string[] usings = { };
    // Tables that get no repository: C# enums, other *Type lookup tables, and tables with no entity class.
    string[] noRepositoryTables =
    {
        "ClearanceType", "ExpenseType", "LeaveType", "OvertimeType", "SY_RequestStatusType", "SY_RequestType",
        "SY_ResponseType", "SY_Role", "SY_Display", "SY_ISOCountry", "SY_PerDiem", "sysdiagrams"
    };
    // A project settings file (Projects\<ProjectName>.config, chosen with --project or in the app) overrides the values above.
    contextType = Project.ContextName ?? contextType;
    repositoryNamespace = Project.RepoNamespace ?? repositoryNamespace;
    usings = Project.Usings ?? usings;
    // With a project chosen, which tables count as enums (no entity/repository/API of their own) comes from the project's
    // EnumTables, else from what the schema says about each table (LookupShape) -- not from the lists above, which are
    // only used when no project is chosen.
    bool NoRepository(string table, LookupShape shape) => Project.NoRepository(table, shape) ?? noRepositoryTables.Contains(table, StringComparer.OrdinalIgnoreCase);
    // ==========================================================================================

    // ------------------------------------------------------------------------------------------
    // CS_Repo_v1.tt
    // Generates: <TableName>Repo.cs   (see OutputName in CS_Repo_v1.tt.config)
    //
    // A repository class in the style of TimeEntryServer's TimeEntry.Common\Repositories\HolidayRepo.cs:
    //
    //     public class HolidayRepo : GenericRepo<Holiday>
    //     {
    //         public HolidayRepo(TimeEntryContext context) : base(context) { }
    //         ... extra queries ...
    //     }
    //
    // The shared plumbing (GenericRepo<T> / NameActiveRepo<T> and their interfaces) is written by hand once and is not
    // per-table, so this template only writes the thin per-table class on top of it:
    //   - Base class: a table with a NOT NULL text column called Name AND a NOT NULL bit column called IsActive uses
    //     NameActiveRepo<Entity> (which brings GetByName, GetAllActive and the duplicate-name check); any other table uses
    //     GenericRepo<Entity>. This is the same test CS_Entity uses to choose BaseNameActiveEntity / BaseEntity, and the
    //     entity has to derive from the matching base for the repo to compile.
    //   - Extra queries, only where the COLUMNS alone say what to write:
    //       * a name/active table that hangs off exactly one parent through a NOT NULL int foreign key (a "child" table:
    //         DepartmentTeam -> Department) gets  GetAllOf<Parent>(int id)  -- its active rows for that parent, by name;
    //       * a table with a NOT NULL text Name that is NOT name/active-based gets  GetByName(string name)  -- names starting
    //         with the text (Holiday);
    //       * every column that takes part in a UNIQUE index or constraint OTHER than the primary key
    //         (ColumnModel.IsInUniqueIndex -- the same signal SP_Clone.tt already uses to decide which columns need a
    //         caller-supplied override on copy) gets  HasDuplicate<Column>(value, excludeId)  -- does some OTHER row
    //         already have this value, the generalized shape of CityRepository.HasDuplicates in
    //         CodeGenPossibilities\AdvancedRepositoryPatterns (research folder). One column at a time:
    //         IsInUniqueIndex only says a column takes part in SOME unique index, not which other columns share a
    //         composite one, so a composite unique constraint gets one HasDuplicate per column rather than a single
    //         combined check;
    //       * every such column that is ALSO a string column gets  SuggestUnique<Column>(desired)  -- given a
    //         starting value (e.g. "New Account"), returns it unchanged if free, else the same value with a numeric
    //         suffix bumped until free ("New Account2", "New Account3", ...), for pre-filling an Add dialog with
    //         something that will actually save. The generalized shape of a real EnsureNameIsUnique/IsUniqueName
    //         helper pair in CodeGenPossibilities\SuggestUniqueName (research folder) that needed a per-entity-type
    //         switch statement in the hand-written codebase it came from; generating one column at a time from
    //         IsInUniqueIndex needs no switch at all. Same single-column scope and composite-index caveat as
    //         HasDuplicate<Column> above -- and the same caveat about NOT knowing whether a real project's
    //         constraint is actually scoped to a parent (e.g. unique per model, not globally) rather than table-wide;
    //       * a table with at least one searchable (string, non-audit) column gets SearchAsync(...) -- the same
    //         filter/pagination SP_Search.tt/SP_SearchCount.tt generate, called directly through the DbContext
    //         (CodeGenPossibilities\Pagination, research folder) so an in-process WinUI3 screen and the web API's
    //         API_Search.tt endpoint share one implementation instead of two.
    //   - No entity, no repo: a table listed in noRepositoryTables (the ones that are C# enums, the *Type lookup tables, and
    //     tables with no entity class) stops with an error instead of writing a class that cannot compile.
    //
    // What it does NOT do, so a repository that needs any of these stays hand-maintained: queries that Include navigation
    // properties (GetAllIncludeTeams, GetAllIncludeDropdowns) -- the entity's navigations are the developers' choice, and a
    // guess would not compile; lookups by a hand-picked column or order (GetAllOfTimesheet ordered by project).
    //
    // ------------------------------------------------------------------------------------------

    if (NoRepository(Model.TableName, Model.LookupShape))
    {
        Error($"CS_Repo writes no repository for [{Model.SchemaName}].[{Model.TableName}]: it is listed in noRepositoryTables "
              + "(an enum, a *Type lookup table, or a table with no entity class).");
    }
    else
    {
        string entity = (Model.IsCSharpReservedWordName ? "@" : "") + Model.TableName;

        // ---- C# type of a column (same mapping CS_Entity.tt/CS_Validation.tt use)
        string ClrType(ColumnModel c)
        {
            string t = c.SqlType switch
            {
                SqlDbType.Int => "int",
                SqlDbType.BigInt => "long",
                SqlDbType.SmallInt => "short",
                SqlDbType.TinyInt => "byte",
                SqlDbType.Bit => "bool",
                SqlDbType.Decimal or SqlDbType.Money or SqlDbType.SmallMoney => "decimal",
                SqlDbType.Float => "double",
                SqlDbType.Real => "float",
                SqlDbType.Date or SqlDbType.DateTime or SqlDbType.DateTime2 or SqlDbType.SmallDateTime => "DateTime",
                SqlDbType.DateTimeOffset => "DateTimeOffset",
                SqlDbType.Time => "TimeSpan",
                SqlDbType.UniqueIdentifier => "Guid",
                SqlDbType.Char or SqlDbType.VarChar or SqlDbType.NChar or SqlDbType.NVarChar or SqlDbType.Text or SqlDbType.NText or SqlDbType.Xml => "string",
                _ => "object"
            };
            return c.IsNullable ? t + "?" : t;
        }

        var nameColumn = Model.Columns.FirstOrDefault(c => c.IsStringColumn && !c.IsNullable && c.Name == "Name");
        var activeColumn = Model.Columns.FirstOrDefault(c => c.SqlType == SqlDbType.Bit && !c.IsNullable && c.Name == "IsActive");
        var searchableColumns = Model.SearchableColumns;
        bool nameActive = nameColumn is not null && activeColumn is not null;
        string baseRepo = nameActive ? "NameActiveRepo" : "GenericRepo";

        var o = new StringBuilder();
        void L(string s = "") => o.Append(s).Append('\n');

        var methods = new List<string[]>();

        if (nameActive)
        {
            // a child table: exactly one single-column foreign key to a table that has an entity (foreign keys to enum tables do not count)
            var childKeys = Model.ForeignKeys
                .Where(f => f.ReferencingColumns.Count == 1
                            && !NoRepository(f.ReferencedTable, f.ReferencedLookupShape))
                .Select(f => Model.Columns.First(c => c.Name.Equals(f.ReferencingColumns[0], StringComparison.OrdinalIgnoreCase)))
                .ToList();
            if (childKeys.Count == 1
                && childKeys[0].SqlType == SqlDbType.Int && !childKeys[0].IsNullable && !childKeys[0].IsPrimaryKey)
            {
                var fkColumn = childKeys[0];
                string parent = fkColumn.Name.EndsWith("Id", StringComparison.Ordinal) && fkColumn.Name.Length > 2 ? fkColumn.Name[..^2] : fkColumn.Name;
                methods.Add(new[]
                {
                    $"    public async Task<List<{entity}>> GetAllOf{parent}(int id)",
                    "    {",
                    "        return await _dbSet",
                    $"            .Where(t => t.{fkColumn.Name}.Equals(id) && t.IsActive) // only fetch active",
                    "            .OrderBy(d => d.Name) // order by name",
                    "            .ToListAsync();",
                    "    }"
                });
            }
        }
        else if (Model.Columns.Any(c => c.IsStringColumn && !c.IsNullable && c.Name == "Name"))
        {
            methods.Add(new[]
            {
                $"    public async Task<List<{entity}>> GetByName(string name)",
                "    {",
                "        return await _dbSet",
                "            .Where(d => d.Name.StartsWith(name))",
                "            .ToListAsync();",
                "    }"
            });
        }

        foreach (var c in Model.Columns.Where(c => c.IsInUniqueIndex))
        {
            string paramName = char.ToLowerInvariant(c.Name[0]) + c.Name[1..];
            if (paramName.IsCSharpReservedWord()) paramName = "@" + paramName;
            methods.Add(new[]
            {
                $"    public async Task<bool> HasDuplicate{c.Name}({ClrType(c)} {paramName}, int excludeId)",
                "    {",
                $"        return await _dbSet.AnyAsync(t => t.{c.Name} == {paramName} && t.{Model.PrimaryKeyColumns[0].Name} != excludeId);",
                "    }"
            });
        }

        foreach (var c in Model.Columns.Where(c => c.IsInUniqueIndex && c.IsStringColumn))
        {
            methods.Add(new[]
            {
                $"    public async Task<string> SuggestUnique{c.Name}(string desired)",
                "    {",
                "        string candidate = desired;",
                $"        for (int suffix = 2; await _dbSet.AnyAsync(t => t.{c.Name} == candidate); suffix++)",
                "            candidate = desired + suffix;",
                "        return candidate;",
                "    }"
            });
        }

        // Pagination (CodeGenPossibilities\Pagination, research folder): this repo method calls the same
        // generated <Table>_Search/<Table>_SearchCount pair directly through the DbContext, the identical
        // Database.SqlQueryRaw<T> call API_Search.tt's minimal-API endpoint makes, so WinUI3 (in-process)
        // and the web API (over HTTP) share one source of truth for "how do I search+page this table"
        // instead of two independently-maintained filter implementations. Returns a plain tuple, not a
        // PagedResult<T>-shaped record: API_Search.tt's own <TableName>SearchResult lives in a different,
        // independently-generated file this template cannot assume was ever run for this table.
        //
        // Always generated -- not gated on searchableColumns.Count > 0. Pagination and searchability are
        // separate concerns (SP_Search.tt's own header comment): a table with no searchable column (e.g. one
        // keyed only by ids/numbers) still grows without bound and still needs a paged GetAll, just with zero
        // filter parameters -- found live needing exactly this on such a table (2026-09-28).
        {
            string LowerFirst(string s) => s.Length == 0 ? s : char.ToLowerInvariant(s[0]) + s[1..];
            var filters = searchableColumns.Select(c => new { ParamName = LowerFirst(c.Name), c.Name }).ToList();
            // Filter params, then pageNumber/pageSize -- joined as ONE list so the comma placement is correct
            // whether there are zero filters or several (a naive "{paramList}, int pageNumber" would leave a
            // leading ", " when paramList is empty).
            var signatureParams = filters.Select(f => $"string? {f.ParamName} = null")
                .Append("int pageNumber = 1").Append("int pageSize = 100").ToList();
            // EXEC of a stored procedure on SQL Server, a function call on PostgreSQL (see SearchCall).
            var call = new SearchCall(Model, Model.TableName, filters.Select(f => f.Name), qualifyTypes: true);

            var body = new List<string>
            {
                $"    public async Task<(List<{entity}> Items, int TotalCount)> SearchAsync({string.Join(", ", signatureParams)})",
                "    {",
                "        var parameters = new[]",
                "        {"
            };
            foreach (var f in filters)
                body.Add("            " + call.TextParameter(f.Name, f.ParamName) + ",");
            body.Add("            " + call.IntParameter("PageNumber", "pageNumber") + ",");
            body.Add("            " + call.IntParameter("PageSize", "pageSize"));
            body.Add("        };");
            body.Add("");
            // Set<T>().FromSqlRaw(...), NOT Database.SqlQueryRaw<T>(...): SqlQueryRaw<T> builds an ad hoc
            // EF model for T on the fly and that model rejects any navigation property T has ("Navigations
            // are not supported when using 'SqlQuery'") -- it throws for any table with a foreign key, found
            // live running this exact generated code against a table with a parent lookup (2026-09-28).
            // FromSqlRaw uses the real, already-validated entity model (navigations and all), so it works
            // whether or not T has any.
            body.Add("        var items = await _context.Set<" + entity + ">()");
            body.Add($"            .FromSqlRaw(\"{call.SearchSql}\", parameters)");
            body.Add("            .ToListAsync();");
            body.Add("");
            // Explicitly typed (not "var ... = new[]"): with zero searchable columns this array has zero
            // elements, and an implicitly-typed array initializer with nothing in it is a compile error
            // (CS0826) -- found while testing pagination-without-search, the case that first makes this array
            // possibly empty.
            body.Add($"        var countParameters = new {call.ParameterNamespace}.{call.ParameterType}[]");
            body.Add("        {");
            for (int i = 0; i < filters.Count; i++)
            {
                var f = filters[i];
                string comma = i < filters.Count - 1 ? "," : "";
                body.Add("            " + call.TextParameter(f.Name, f.ParamName) + comma);
            }
            body.Add("        };");
            body.Add("");
            // .SingleAsync() (or any operator EF must COMPOSE the SQL for) throws InvalidOperationException
            // ("was called with non-composable SQL") against an EXEC call -- a stored-procedure call cannot be
            // wrapped in a derived-table subquery the way a plain SELECT can. Found live, running this exact
            // generated code for real: .ToListAsync() executes the EXEC as-is (no composition needed), then
            // .Single() enforces "exactly one row" in memory instead of in SQL.
            body.Add("        var totalCountRows = await _context.Database");
            body.Add($"            .SqlQueryRaw<int>(\"{call.CountSql}\", countParameters)");
            body.Add("            .ToListAsync();");
            body.Add("        int totalCount = totalCountRows.Single();");
            body.Add("");
            body.Add("        return (items, totalCount);");
            body.Add("    }");
            methods.Add(body.ToArray());
        }

        L($"namespace {repositoryNamespace};");
        L();
        if (usings.Length > 0)
        {
            foreach (string u in usings) L($"using {u};");
            L();
        }
        // partial: in a WinUI3/Windows App SDK project, the CsWinRT source generator scans every type for
        // WinRT-projected interfaces -- GenericRepo<T>/NameActiveRepo<T> both implement IDisposable (WinRT's
        // IClosable) -- and needs to add generated members onto the concrete (non-generic) class implementing
        // it, which it can only do if that class is declared partial. Without this, every generated repo in a
        // WinUI3 target project gets "Class {Table}Repo implements WinRT interfaces but ... isn't marked
        // partial" -- found live, building a real WinUI3 target project (2026-09-27).
        L($"public partial class {Model.TableName}Repo : {baseRepo}<{entity}>");
        L("{");
        L($"    public {Model.TableName}Repo({contextType} context) : base(context)");
        L("    {");
        L("    }");
        foreach (var method in methods)
        {
            L();
            foreach (string line in method) L(line);
        }
        L("}");
        Write(o.ToString());
    }
#>
