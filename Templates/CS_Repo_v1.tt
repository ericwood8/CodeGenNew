<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string repositoryNamespace = "MyApp.Common.Repositories";
    string contextType = "MyAppContext";
    // Namespaces the generated file must "using" (for example "MyApp.Entities"; leave empty when the project supplies them through
    // global usings). Each entry becomes a using line in the generated file.
    string[] usings = { };
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    contextType = Project.ContextName ?? contextType;
    repositoryNamespace = Project.RepoNamespace ?? repositoryNamespace;
    usings = Project.Usings ?? usings;
    // Which tables count as enums (no entity, repository or API of their own) comes from the project's EnumTables, else from the schema (LookupShape).
    bool NoRepository(string table, LookupShape shape) => Project.NoRepositoryFor(table, shape);
    // ==========================================================================================

    // ==========================================================================================
    // CS_Repo_v1.tt
    // Generates: <TableName>Repo.cs   (see OutputName in CS_Repo_v1.tt.config)
    // The thin per-table repository over the project's shared GenericRepo / NameActiveRepo base (written by hand once): the base is chosen like
    // CS_Entity chooses its base class, and the extra queries come only from what the columns say (GetByName, HasDuplicate<Column> for a unique
    // column, SearchAsync calling <Table>_Search, CloneAsync for a cloneable table). Needs a primary key.
    // Full notes: Docs/TemplateNotes/CS_Repo_v1.md
    // ==========================================================================================

    if (NoRepository(Model.TableName, Model.LookupShape))
    {
        Error($"CS_Repo writes no repository for [{Model.SchemaName}].[{Model.TableName}]: it is an enum or lookup table "
              + "(an enum, a *Type lookup table, or a table with no entity class).");
    }
    else
    {
        string entity = (Model.IsCSharpReservedWordName ? "@" : "") + Model.TableName;

        // ==== C# type of a column (same mapping CS_Entity.tt/CS_Validation.tt use)
        string ClrType(ColumnModel c) => c.CSharp();

        var searchableColumns = Model.SearchableColumns;
        var searchKeys = Model.SearchKeyColumns;
        // With AccessMode=Ef the search, the sort and the clone are LINQ over the context (CS_SearchQuery writes the query), not calls to the routines SP_Search and SP_Clone write.
        bool ef = Project.AccessModeFor(Model.Dialect) == AccessMode.Ef;
        bool nameActive = Model.IsNameActiveTable;
        // the base follows the key (KeyType): GenericRepo<Entity> for an int key, GenericRepo<Entity, string> / <Entity, Guid> / <Entity, long> for the others
        var keyType = Model.PrimaryKeyType;
        string baseRepo = nameActive ? $"NameActiveRepo<{entity}>" : keyType?.RepoBase(entity) ?? $"GenericRepo<{entity}>";
        string keyCSharp = keyType?.CSharp ?? "int";

        var o = new StringBuilder();
        void L(string s = "") => o.Append(s).Append('\n');

        var methods = new List<string[]>();

        if (nameActive)
        {
            // a child table: exactly one single-column foreign key to a table that has an entity (foreign keys to enum tables do not count)
            var childKeys = Model.ForeignKeys
                .Where(f => f.ReferencingColumns.Count == 1
                            && !NoRepository(f.ReferencedTable, f.ReferencedLookupShape))
                .Select(f => Model.Columns.First(c => c.Name.EqualsIgnoreCase(f.ReferencingColumns[0])))
                .ToList();
            if (childKeys.Count == 1
                && childKeys[0].IsInt32Column && !childKeys[0].IsNullable && !childKeys[0].IsPrimaryKey)
            {
                var fkColumn = childKeys[0];
                string parent = fkColumn.Name.EndsWith("Id", StringComparison.Ordinal) && fkColumn.Name.Length > 2 ? fkColumn.Name[..^2] : fkColumn.Name;
                methods.Add(new[]
                {
                    $"    public async Task<List<{entity}>> GetAllOf{parent}(int id)",
                    "    {",
                    "        return await _dbSet",
                    $"            .Where(t => t.{fkColumn.Name}.Equals(id) && t.IsActive) // only fetch active",
                    "            .OrderBy(d => d.Name) // order by name",
                    "            .ToListAsync();",
                    "    }"
                });
            }
        }
        else if (Model.HasRequiredNameColumn)
        {
            methods.Add(new[]
            {
                $"    public async Task<List<{entity}>> GetByName(string name)",
                "    {",
                "        return await _dbSet",
                "            .Where(d => d.Name.StartsWith(name))",
                "            .ToListAsync();",
                "    }"
            });
        }

        foreach (var c in Model.Columns.Where(c => c.IsInUniqueIndex))
        {
            string paramName = char.ToLowerInvariant(c.Name[0]) + c.Name[1..];
            if (paramName.IsCSharpReservedWord()) paramName = "@" + paramName;
            methods.Add(new[]
            {
                $"    public async Task<bool> HasDuplicate{c.Name}({ClrType(c)} {paramName}, {keyCSharp} excludeId)",
                "    {",
                $"        return await _dbSet.AnyAsync(t => t.{c.Name} == {paramName} && t.{Model.PrimaryKeyColumns[0].Name} != excludeId);",
                "    }"
            });
        }

        foreach (var c in Model.Columns.Where(c => c.IsInUniqueIndex && c.IsStringColumn))
        {
            methods.Add(new[]
            {
                $"    public async Task<string> SuggestUnique{c.Name}(string desired)",
                "    {",
                "        string candidate = desired;",
                $"        for (int suffix = 2; await _dbSet.AnyAsync(t => t.{c.Name} == candidate); suffix++)",
                "            candidate = desired + suffix;",
                "        return candidate;",
                "    }"
            });
        }

        // CloneAsync: the grids' Clone button (CloneShape says which tables get one). Calls <Table>_Clone (SP_Clone), or LINQ with AccessMode=Ef, and returns the new row's id; a unique text column gets a
        // free value from SuggestUnique<Column> above.
        if (CloneShape.CanClone(Model, Project))
            methods.Add((ef ? CloneEf.RepoMethod(Model, entity) : CloneCall.RepoMethod(Model, entity)).ToArray());

        // SearchAsync: the one search-and-page call WinUI3 (in process) and the web API share. It is LINQ with AccessMode=Ef (CS_SearchQuery), else a call of the <Table>_Search / _SearchCount routines
        // through the DbContext. It returns a plain tuple, not API_Search's <Table>SearchResult, which lives in a file this template cannot assume was generated.
        // Always written, even with no searchable column: a table keyed only by numbers still needs a paged list, with zero filters.
        {
            var filters = searchableColumns.Select(c => new { ParamName = CSharpIdentifier(LowerFirst(c.Name)), c.Name }).ToList();
            // One list of the filters, then the paging parameters, so no leading comma appears when there is no filter.
            var signatureParams = filters.Select(f => $"string? {f.ParamName} = null")
                .Append("int pageNumber = 1").Append("int pageSize = 100")
                // The grid's chosen sort: a column name (null = the default order) and the direction. The procedure compares the name with its own list of columns (SearchSort).
                .Append("string? sortColumn = null").Append("bool sortDescending = false")
                // one optional exact match per whole-number foreign key, after the older parameters so an existing call still lines up
                .Concat(searchKeys.Select(k => $"{k.CSharpBase()}? {CSharpIdentifier(LowerFirst(k.Name))} = null")).ToList();
            // a table in LogTables (EF search) also takes the first and the last day of the rows to list, after everything else so an existing call still lines up
            bool logRange = ef && !nameActive && LogTablePlan.For(Model, Project) is not null;
            if (logRange)
            {
                signatureParams.Add($"DateTime? {LogTable.FromParameter} = null");
                signatureParams.Add($"DateTime? {LogTable.ToParameter} = null");
            }
            if (nameActive)
            {
                // A table with a Name and an IsActive column has no search routine and no SearchQuery class: its rows are few, so the list is read whole and narrowed, sorted and cut into pages here
                // (the Active only box of its screen is activeOnly). The sort of a foreign key column is by its key, not by the parent's name.
                signatureParams.Add("bool activeOnly = false");
                var body = new List<string>
                {
                    $"    public async Task<(List<{entity}> Items, int TotalCount)> SearchAsync({string.Join(", ", signatureParams)})",
                    "    {",
                    "        var rows = (await GetAll()).AsEnumerable();"
                };
                foreach (var c in searchableColumns)
                {
                    string parameter = CSharpIdentifier(LowerFirst(c.Name));
                    body.Add($"        if (!string.IsNullOrWhiteSpace({parameter}))");
                    body.Add($"            rows = rows.Where(t => (t.{c.CSharpName()} ?? \"\").Contains({parameter}.Trim(), StringComparison.OrdinalIgnoreCase));");
                }
                foreach (var k in searchKeys)
                {
                    string parameter = CSharpIdentifier(LowerFirst(k.Name));
                    body.Add($"        if ({parameter} is not null)");
                    body.Add($"            rows = rows.Where(t => t.{k.CSharpName()} == {parameter});");
                }
                body.Add("        if (activeOnly)");
                body.Add("            rows = rows.Where(t => t.IsActive);");
                body.Add("        if (sortColumn is not null)");
                body.Add("        {");
                body.Add($"            object? Key({entity} t) => sortColumn switch");
                body.Add("            {");
                foreach (var c in Model.Columns.Where(SearchSort.IsSortable))
                    body.Add($"                \"{c.Name}\" => t.{c.CSharpName()},");
                body.Add("                _ => null");
                body.Add("            };");
                body.Add("            rows = sortDescending ? rows.OrderByDescending(Key) : rows.OrderBy(Key);");
                body.Add("        }");
                body.Add("        var all = rows.ToList();");
                body.Add("        int size = Math.Clamp(pageSize, 1, 1000);");
                body.Add("        var items = all.Skip((Math.Clamp(pageNumber, 1, int.MaxValue / size) - 1) * size).Take(size).ToList();");
                body.Add("        return (items, all.Count);");
                body.Add("    }");
                methods.Add(body.ToArray());
            }
            else if (ef)
            {
                string filterArguments = string.Concat(filters.Select(f => ", " + f.ParamName).Concat(searchKeys.Select(k => ", " + CSharpIdentifier(LowerFirst(k.Name)))))
                    + (logRange ? $", {LogTable.FromParameter}: {LogTable.FromParameter}, {LogTable.ToParameter}: {LogTable.ToParameter}" : "");
                string queryClass = Model.TableName + "SearchQuery";
                methods.Add(new[]
                {
                    $"    public async Task<(List<{entity}> Items, int TotalCount)> SearchAsync({string.Join(", ", signatureParams)})",
                    "    {",
                    $"        var query = {queryClass}.Filter(_dbSet{filterArguments});",
                    "        int totalCount = await query.CountAsync();",
                    "        int size = Math.Clamp(pageSize, 1, 1000);   // 0 or less is an error in the database, a huge page reads the whole table",
                    $"        var items = await {queryClass}.Sort(query, sortColumn, sortDescending)",
                    "            .Skip((Math.Clamp(pageNumber, 1, int.MaxValue / size) - 1) * size).Take(size).ToListAsync();",
                    "        return (items, totalCount);",
                    "    }"
                });
            }
            else
            {
            // EXEC of a stored procedure on SQL Server, a function call on PostgreSQL (see SearchCall).
            var call = new SearchCall(Model, Model.TableName, filters.Select(f => f.Name), qualifyTypes: true);

            var body = new List<string>
            {
                $"    public async Task<(List<{entity}> Items, int TotalCount)> SearchAsync({string.Join(", ", signatureParams)})",
                "    {",
                "        // the routine adds up (pageNumber - 1) * pageSize as a 32 bit number and fetches pageSize rows: keep both inside what it accepts",
                "        pageSize = Math.Clamp(pageSize, 1, 1000);",
                "        pageNumber = Math.Clamp(pageNumber, 1, int.MaxValue / pageSize);",
                "",
                "        var parameters = new[]",
                "        {"
            };
            foreach (var f in filters)
                body.Add("            " + call.TextParameter(f.Name, f.ParamName) + ",");
            body.Add("            " + call.IntParameter("PageNumber", "pageNumber") + ",");
            body.Add("            " + call.IntParameter("PageSize", "pageSize") + ",");
            body.Add("            " + call.SortColumnParameter("sortColumn") + ",");
            body.Add("            " + call.SortDescendingParameter("sortDescending") + (searchKeys.Count > 0 ? "," : ""));
            for (int i = 0; i < searchKeys.Count; i++)
                body.Add("            " + call.KeyParameter(searchKeys[i], CSharpIdentifier(LowerFirst(searchKeys[i].Name))) + (i < searchKeys.Count - 1 ? "," : ""));
            body.Add("        };");
            body.Add("");
            // Set<T>().FromSqlRaw, not Database.SqlQueryRaw<T>: SqlQueryRaw<T> builds an ad hoc EF model that rejects a navigation property, so it throws for any table with a foreign key;
            // FromSqlRaw uses the real entity model.
            body.Add("        var items = await _context.Set<" + entity + ">()");
            body.Add($"            .FromSqlRaw(\"{call.SearchSql}\", parameters)");
            body.Add("            .ToListAsync();");
            body.Add("");
            // Explicitly typed: an implicitly typed empty array initializer is a compile error (CS0826), and this array is empty when there is no filter.
            body.Add($"        var countParameters = new {call.ParameterNamespace}.{call.ParameterType}[]");
            body.Add("        {");
            var countArguments = filters.Select(f => call.TextParameter(f.Name, f.ParamName))
                .Concat(searchKeys.Select(k => call.KeyParameter(k, CSharpIdentifier(LowerFirst(k.Name))))).ToList();
            for (int i = 0; i < countArguments.Count; i++)
                body.Add("            " + countArguments[i] + (i < countArguments.Count - 1 ? "," : ""));
            body.Add("        };");
            body.Add("");
            // ToListAsync, then Single in memory: SingleAsync makes EF compose the SQL, which fails for an EXEC call (a stored-procedure call cannot be wrapped in a subquery).
            body.Add("        var totalCountRows = await _context.Database");
            body.Add($"            .SqlQueryRaw<int>(\"{call.CountSql}\", countParameters)");
            body.Add("            .ToListAsync();");
            body.Add("        int totalCount = totalCountRows.Single();");
            body.Add("");
            body.Add("        return (items, totalCount);");
            body.Add("    }");
            methods.Add(body.ToArray());
            }
        }

        L($"namespace {repositoryNamespace};");
        L();
        if (usings.Length > 0)
        {
            foreach (string u in usings) L($"using {u};");
            L();
        }
        // partial: a WinUI3 project's CsWinRT source generator adds members to a class that implements WinRT interfaces (GenericRepo and NameActiveRepo implement IDisposable, WinRT's IClosable),
        // and can only do that to a partial class.
        L($"public partial class {Model.TableName}Repo : {baseRepo}");
        L("{");
        L($"    public {Model.TableName}Repo({contextType} context) : base(context)");
        L("    {");
        L("    }");
        foreach (var method in methods)
        {
            L();
            foreach (string line in method) L(line);
        }
        L("}");
        Write(o.ToString());
    }
#>
