# Restriction checkboxes for PY_Validate_v1.tt (see Docs/Reference.md section 3).
# The routes are keyed by the primary key, so one single-column int, uniqueidentifier or text key is required.
RequiresPrimaryKey=true
TableOnly=true
RequiredPrimaryKeyShape=SingleIntGuidOrText
# A name/active table's repository is hand-maintained; it gets no generated API.
RequiresNotNameActiveTable=true
# No OutputName: the template writes its own path (app/validation/<table>.py) with an @@@FILE marker.
# Whole-project generation (codegen generate): written only for a project with ApiValidation=true (or that names the template in PlanAlso).
Stacks=Python
PlanTables=CrudApi
InPlan=false
