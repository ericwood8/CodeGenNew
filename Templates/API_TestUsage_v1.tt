<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string apiNamespace = "MyApp.ApiService.Apis";
    string contextType = "MyAppContext";
    string[] usings = { };   // namespaces the generated file must "using" (the context's)
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    contextType = Project.ContextName ?? contextType;
    apiNamespace = Project.ApiNamespace ?? apiNamespace;
    usings = Project.Usings ?? usings;
    // ==========================================================================================

    // ==========================================================================================
    // API_TestUsage_v1.tt
    // Generates: <Table>UsageApiTests.cs   (the test project; see OutputRoot in API_TestUsage_v1.tt.config)
    // The tests of the usage routes (UsageTables): a call without a sign-in is a 401, a role that is not the administrator's is a 403, the summary adds the events per month and kind (and can be limited
    // by kind and dates), another tenant's events are not in it, a platform administrator names the tenant and is the one who records usage, and nothing edits or deletes an event. Each test adds events of
    // its own and removes them again. Writes nothing without UsageTables, TenantTable, ApiAuth and ApiTests.
    // Full notes: Docs/TemplateNotes/API_Usage_v1.md
    // ==========================================================================================

    foreach (var table in ApiUsageTests.Tables(Database, Project))
        Write("@@@FILE " + table.Table.TableName + "UsageApiTests.cs@@@\n" + ApiUsageTests.ClassText(table, Project, UsagePlan.RollupFor(Database, Project, table)));
#>
