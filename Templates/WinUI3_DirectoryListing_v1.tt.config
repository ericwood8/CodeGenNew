# Restriction checkboxes for WinUI3_DirectoryListing_v1.tt (see Docs/Reference.md section 3).
# A page that lists the files of a folder: it needs no table and no database, so the menu offers it on no table and the CLI runs it without -S, -d or -t.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
# No OutputName: the template writes its own paths (Views/<Name>ListPage.xaml, ...) with @@@FILE markers.
Stacks=WinUI3
EssentialsGroup=DirectoryListing
Description=A page listing the files of a folder (sort, filter, add, open, rename, delete); optional
EssentialsDefault=false
