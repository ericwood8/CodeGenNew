# Restriction checkboxes for PY_Csv_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# The template writes its own path (app/routes/csv_files.py) with an @@@FILE marker.
OutputName=app/routes/csv_files.py
# Whole-project generation (codegen generate): for a project that sets ApiCsv=true (or names the template in PlanAlso).
Stacks=Python
InPlan=false
