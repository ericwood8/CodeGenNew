# Restriction checkboxes for BLZ_TestApprovals_v1.tt (see Docs/Reference.md section 3).
# One run for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
OutputName=ApprovalsPageTests.cs
# Whole-project generation (codegen generate): for a project that sets BlazorTests=true and RowApprovals (or names the template in PlanAlso). The file goes to the test project, not the Blazor app.
Stacks=Blazor
OutputRoot=BlazorTests
InPlan=false
