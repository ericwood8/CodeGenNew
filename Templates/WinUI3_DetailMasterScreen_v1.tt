    // finished or while a child dialog is still showing and loading. A DbContext is not thread-safe, so a caller that is about to use the same context (reload the
    // list, open another dialog) calls this instead: it also waits for that load and for any child dialog opened from here.
    public async System.Threading.Tasks.Task<ContentDialogResult> ShowAndWaitAsync()
    {
