    // The first click on Delete only asks ("Confirm?"); the second deletes the row and reloads the grid. Losing focus puts the label back.
    private async void On<#= child.Table #>DeleteClick(object sender, RoutedEventArgs e)
    {
        var button = (Button)sender;
        if (button.DataContext is not <#= table #>ChildGridRow { Entity: <#= child.Table #> entity })
            return;
        if (button.Content as string != "Confirm?")
        {
            button.Content = "Confirm?";
            return;
        }
        try
        {
            _context.Remove(entity);
            await _context.SaveChangesAsync();
            await ViewModel.LoadAsync();
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            _context.Entry(entity).State = Microsoft.EntityFrameworkCore.EntityState.Unchanged;
