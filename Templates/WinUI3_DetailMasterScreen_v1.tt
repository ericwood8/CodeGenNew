#>
            ErrorMessage = "<#= label #> is required."; return false;
<#
                }
                else
                {
#>
            entity.<#= prop #> = null;
<#
                }
#>
        }
        else { entity.<#= prop #> = Math.Round((decimal)<#= prop #>, <#= NumericClassifier.CurrencyDigits(c) #>); }
<#
            }
            else if (value == ValueKind.Decimal)
            {
                var (decMin, decMax) = NumericClassifier.DecimalRange(c);
                string decValue = c.SqlType == SqlDbType.Decimal ? $"Math.Round((decimal){prop}, {NumericClassifier.DecimalPlaces(c)})" : c.SqlType == SqlDbType.Real ? $"(float){prop}" : prop;
#>
        if (double.IsNaN(<#= prop #>))
        {
<#
                if (!c.IsNullable)
                {
#>
            ErrorMessage = "<#= label #> is required."; return false;
<#
                }
                else
                {
#>
            entity.<#= prop #> = null;
<#
                }
#>
        }
        else if (<#= prop #> < <#= Inv(decMin) #> || <#= prop #> > <#= Inv(decMax) #>) { ErrorMessage = "<#= label #> must be between <#= Inv(decMin) #> and <#= Inv(decMax) #>."; return false; }
        else { entity.<#= prop #> = <#= decValue #>; }
<#
            }
            else if (value == ValueKind.WholeNumber)
            {
                var range = Project.RangeFor(c)!.Value;
                string intType = NumericClassifier.NumericCSharpType(c);
#>
        if (double.IsNaN(<#= prop #>))
        {
<#
                if (!c.IsNullable)
                {
#>
            ErrorMessage = "<#= label #> is required."; return false;
<#
                }
                else
                {
#>
            entity.<#= prop #> = null;
<#
                }
#>
        }
        else if (<#= prop #> != Math.Floor(<#= prop #>)) { ErrorMessage = "<#= label #> must be a whole number."; return false; }
        else if (<#= prop #> < <#= range.Min #> || <#= prop #> > <#= range.Max #>) { ErrorMessage = "<#= label #> must be between <#= range.Min #> and <#= range.Max #>."; return false; }
        else { entity.<#= prop #> = (<#= intType #>)<#= prop #>; }
<#
            }
            else if (value == ValueKind.Boolean)
            {
#>
        entity.<#= prop #> = <#= prop #><#= c.IsNullable ? "" : " ?? false" #>;
<#
            }
            else if (value == ValueKind.Date)
            {
#>
        if (<#= prop #> is null)
        {
<#
                if (!c.IsNullable)
                {
#>
            ErrorMessage = "<#= label #> is required."; return false;
<#
                }
                else
                {
#>
            entity.<#= prop #> = null;
<#
                }
#>
        }
        else { entity.<#= prop #> = <#= prop #>.Value.Date + _<#= char.ToLowerInvariant(prop[0]) + prop[1..] #>Time; }
<#
            }
            else if (value == ValueKind.Guid)
            {
#>
        if (string.IsNullOrWhiteSpace(<#= prop #>))
        {
<#
                if (!c.IsNullable)
                {
#>
            ErrorMessage = "<#= label #> is required."; return false;
<#
                }
                else
                {
#>
            entity.<#= prop #> = null;
<#
                }
#>
        }
