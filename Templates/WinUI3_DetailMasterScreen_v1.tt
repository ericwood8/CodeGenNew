<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS -- the lines to change to use this template in your own project (namespaces, names,
    // folders, lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string viewNamespace = "TimeEntry.Desktop.Views";
    string viewModelNamespace = "TimeEntry.Desktop.ViewModels";
    string contextType = "TimeEntryContext";
    string contextNamespace = "TimeEntry.Common.Data";
    string[] usings = { };
    string viewsFolder = "Views";
    string viewModelsFolder = "ViewModels";
    string[] noLookupParents =
    {
        "ClearanceType", "ExpenseType", "LeaveType", "OvertimeType", "SY_Display", "SY_ISOCountry",
        "SY_RequestStatusType", "SY_RequestType", "SY_ResponseType", "SY_Role", "DepartmentTeam", "ProjectTask"
    };
    // ==========================================================================================

    // ------------------------------------------------------------------------------------------
    // WinUI3_DetailMasterScreen_v1.tt
    // WinUI3_DetailScreen.tt's own form (identical field-by-field: same column selection, same drop-down and
    // validation rules -- see that template for the reasoning) PLUS one read-only grid per table in
    // TableModel.ChildForeignKeys, so editing a row also shows the child rows that hang off it (e.g. a
    // Department's Teams, a TimeSheet's lines):
    //     Views/<TableName>DetailMasterDialog.xaml
    //     Views/<TableName>DetailMasterDialog.xaml.cs
    //     ViewModels/<TableName>DetailMasterViewModel.cs
    //
    // Per the project's own answer on this ("just have the generated code assume all are grids and the
    // developer can cut out what grids are not needed"): EVERY child table gets a grid, unconditionally --
    // this template does not try to guess which ones matter. Delete the <ChildTable>Rows section (XAML) and
    // its Load<ChildTable>Async call (ViewModel) for any you don't want.
    //
    // Why the child grids use EF Core's own metadata (_context.Model.FindEntityType) instead of column info
    // like every other field in this template family: TableModel.ChildForeignKeys only carries the child's
    // constraint and column NAMES (see CodeGenNew.Core.ChildForeignKeyModel) -- TableModel itself is built
    // for exactly ONE table per generation run, so this template never sees the child table's own column
    // list the way it sees this table's. EF's IEntityType.GetProperties() gives the same information back at
    // RUN time instead (scalar columns only, navigation properties excluded for free), so the grid can show
    // something useful without a second schema-introspection pass this architecture doesn't support. Column
    // order follows EF's own property order, and headers are the raw property name -- rename them by hand
    // once you know what a given child table looks like; this exists to get you unblocked, not to be final.
    // A child table whose foreign key back to this one spans more than one column is skipped (no grid).
    //
    // Only loaded when editing an existing row (a brand-new, unsaved row has no child rows yet); the child
    // sections show a "save first" message instead while adding.
    //
    // WinUI3_MasterScreen.tt always opens the OTHER dialog, <TableName>DetailDialog (WinUI3_DetailScreen.tt) --
    // point its OnAddClick/OnEditClick at <TableName>DetailMasterDialog by hand if you want the master screen
    // to open this one instead.
    //
    // Requires a primary key that is a single, non-composite INT column, refuses a "name/active" table (same
    // reasons as WinUI3_DetailScreen.tt), and requires at least one table in TableModel.ChildForeignKeys
    // (TableModel.HasAtLeastOneChildForeignKey) -- a table with none is exactly WinUI3_DetailScreen.tt's job.
    //
    // ------------------------------------------------------------------------------------------

    bool IsDate(ColumnModel c) => c.SqlType is SqlDbType.Date or SqlDbType.DateTime or SqlDbType.DateTime2 or SqlDbType.SmallDateTime;
    bool IsNumber(ColumnModel c) => c.SqlType is SqlDbType.Int or SqlDbType.BigInt or SqlDbType.SmallInt or SqlDbType.TinyInt
        or SqlDbType.Decimal or SqlDbType.Money or SqlDbType.SmallMoney or SqlDbType.Float or SqlDbType.Real;
    bool IsGuid(ColumnModel c) => c.SqlType == SqlDbType.UniqueIdentifier;
    bool IsBit(ColumnModel c) => c.SqlType == SqlDbType.Bit;
    bool IsText(ColumnModel c) => c.SqlType is SqlDbType.Char or SqlDbType.VarChar or SqlDbType.NChar or SqlDbType.NVarChar;
    bool IsEditableType(ColumnModel c) => IsDate(c) || IsNumber(c) || IsGuid(c) || IsBit(c) || IsText(c);
    int Chars(ColumnModel c) => c.MaxLength is null ? 0 : (c.SqlType is SqlDbType.NChar or SqlDbType.NVarChar ? c.MaxLength.Value / 2 : c.MaxLength.Value);
    bool IsMultiline(ColumnModel c) => IsText(c) && Chars(c) >= 100;
    string Words(string s) => Regex.Replace(s.Replace('_', ' '), "(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])", " ").Trim();
    string Label(string columnName) => Words(Regex.Replace(Regex.Replace(columnName, "^SY_", ""), "Id$", ""));
    string FieldVar(string name) => char.ToLowerInvariant(name[0]) + name[1..];

    string CSharpNumericType(ColumnModel c) => c.SqlType switch
    {
        SqlDbType.Int => "int", SqlDbType.BigInt => "long", SqlDbType.SmallInt => "short", SqlDbType.TinyInt => "byte",
        SqlDbType.Money or SqlDbType.SmallMoney or SqlDbType.Decimal => "decimal",
        SqlDbType.Float => "double", SqlDbType.Real => "float", _ => "int"
    };

    var keyColumn = Model.PrimaryKeyColumns.Count == 1 ? Model.PrimaryKeyColumns[0] : null;
    bool isNameActive = Model.Columns.Any(c => c.IsStringColumn && !c.IsNullable && c.Name == "Name")
                      && Model.Columns.Any(c => c.SqlType == SqlDbType.Bit && !c.IsNullable && c.Name == "IsActive");

    if (keyColumn is null || keyColumn.SqlType != SqlDbType.Int)
    {
        Error($"WinUI3_DetailMasterScreen needs a table with a single int primary key (CS_Repo's GenericRepo<T> takes a plain int id), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else if (isNameActive)
    {
        Error($"WinUI3_DetailMasterScreen is for plain tables. [{Model.SchemaName}].[{Model.TableName}] has a Name and an IsActive column, so its repository is a NameActiveRepo; write this screen by hand.");
    }
    else if (!Model.HasAtLeastOneChildForeignKey)
    {
        Error($"WinUI3_DetailMasterScreen needs at least one other table with a foreign key pointing back at [{Model.SchemaName}].[{Model.TableName}]; none was found -- use WinUI3_DetailScreen instead.");
    }
    else
    {
        string table = Model.TableName;
        string title = Words(table);
        string keyProp = keyColumn.Name;

        // GroupBy + First, not ToDictionary: a real table can have more than one FK constraint on the same
        // column pointing at the same parent (seen live against a second production database's dbo.Products
        // table) -- ToDictionary would throw on the duplicate key.
        var fkByColumn = Model.ForeignKeys.Where(f => f.ReferencingColumns.Count == 1)
            .GroupBy(f => f.ReferencingColumns[0], StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        var shown = Model.Columns
            .Where(c => !c.IsPrimaryKey && !c.IsComputed && !c.IsIdentity && IsEditableType(c))
            .OrderBy(c => c.OrdinalPosition)
            .ToList();

        ForeignKeyModel LookupOf(ColumnModel c) =>
            c.SqlType == SqlDbType.Int
            && fkByColumn.TryGetValue(c.Name, out var fk)
            && !noLookupParents.Contains(fk.ReferencedTable, StringComparer.OrdinalIgnoreCase)
            && fk.ReferencedDisplayColumns.Count > 0
                ? fk : null;

        var parents = shown.Select(c => LookupOf(c)).Where(fk => fk is not null)
            .GroupBy(fk => fk.ReferencedTable, StringComparer.OrdinalIgnoreCase).Select(g => g.First())
            .Select(fk => new
            {
                Table = fk.ReferencedTable,
                OptionsProp = fk.ReferencedTable + "Options",
                KeyProp = fk.ReferencedColumns[0],
                DisplayProp = fk.ReferencedDisplayColumns[0]
            }).ToList();
        var parentOf = parents.ToDictionary(p => p.Table, StringComparer.OrdinalIgnoreCase);

        if (!Model.HasReferencedDisplayColumns && parents.Count > 0)
            Error("WinUI3_DetailMasterScreen needs the foreign-keyed tables' display columns for its drop-downs; its .tt.config must say NeedsReferencedDisplayColumns=true.");

        // Skipped, not just the composite-key case: a child whose foreign key points at one of OUR columns
        // that isn't a plain int (almost always our own int primary key, but a child can reference any
        // unique column) -- the grid's filter below is EF.Property<int>, matching the int-only assumption
        // this whole template family makes about keys.
        // A raw internal id (the child's own primary key, or another foreign key on the child with no
        // resolvable display name) has no business meaning to a user looking at the grid -- hidden entirely.
        // A foreign key on the child that DOES have a resolvable display name (e.g. a SalesInvoice child row's
        // own CustomerId) is resolved to that name instead of shown as a raw number, the same way this
        // template's own parent drop-downs resolve a display name for THIS table's foreign keys. Found live:
        // a real user looking at the generated grid saw SalesInvoiceId/CustomerId/CustomerMonthlySummaryId next
        // to InvoiceDate and asked for exactly this (2026-09-29).
        var children = Model.ChildForeignKeys
            .Where(fk => fk.ReferencingColumns.Count == 1
                      && Model.Columns.Any(c => c.Name.Equals(fk.ReferencedColumns[0], StringComparison.OrdinalIgnoreCase) && c.SqlType == SqlDbType.Int))
            .Select(fk =>
            {
                string selfFkColumn = fk.ReferencingColumns[0];
                // Every OTHER foreign key on the child table -- not the one pointing back to this (parent)
                // table, which is handled separately below (it's always the same value for every row shown,
                // since the grid is already filtered to this one parent).
                var otherFks = fk.ReferencingTableForeignKeys
                    .Where(ofk => !(ofk.ReferencingColumns.Count == 1 && ofk.ReferencingColumns[0].Equals(selfFkColumn, StringComparison.OrdinalIgnoreCase)))
                    .ToList();
                var resolvable = otherFks
                    .Where(ofk => ofk.ReferencingColumns.Count == 1 && ofk.ReferencedDisplayColumns.Count > 0)
                    .Select(ofk => new
                    {
                        Column = ofk.ReferencingColumns[0],
                        ReferencedTable = ofk.ReferencedTable,
                        KeyProp = ofk.ReferencedColumns[0],
                        DisplayProp = ofk.ReferencedDisplayColumns[0],
                        LookupVar = FieldVar(fk.ReferencingTable) + ofk.ReferencedTable + "Names",
                        // "CustomerId" -> "Customer": the same Label() this template already uses for the
                        // parent form's own field headers (and WinUI3_MasterScreen.tt uses for its list grid's
                        // resolved-name column) -- a resolved column's NAME is known at generation time (unlike
                        // every other column in this grid, which is only discovered later via EF reflection),
                        // so it gets the same nicer header instead of the raw "...Id" property name.
                        Label = Label(ofk.ReferencingColumns[0])
                    }).ToList();

                // A List, not a HashSet: keeps the generated HideFrom<Table>Grid array in a fixed, predictable
                // order (self FK, then primary key, then unresolvable other FKs) instead of whatever order a
                // hash-based set happens to enumerate in, so regenerating the same table twice produces
                // identical output.
                var hideColumns = new List<string> { selfFkColumn };
                hideColumns.AddRange(fk.ReferencingPrimaryKeyColumns);
                hideColumns.AddRange(otherFks.SelectMany(o => o.ReferencingColumns).Except(resolvable.Select(r => r.Column), StringComparer.OrdinalIgnoreCase));
                hideColumns = hideColumns.Distinct(StringComparer.OrdinalIgnoreCase).ToList();

                return new
                {
                    Table = fk.ReferencingTable,
                    Var = FieldVar(fk.ReferencingTable),
                    FkColumn = selfFkColumn,
                    ParentKeyColumn = fk.ReferencedColumns[0],
                    HideColumns = hideColumns,
                    Resolvable = resolvable
                };
            }).ToList();
#>
@@@FILE <#= viewsFolder #>/<#= table #>DetailMasterDialog.xaml@@@
<ContentDialog
    x:Class="<#= viewNamespace #>.<#= table #>DetailMasterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer MinWidth="560" MaxHeight="680">
        <StackPanel Spacing="12">
            <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />
<#
        foreach (var c in shown)
        {
            var lookup = LookupOf(c);
            string prop = c.Name;
            string label = Label(c.Name);
            if (lookup is not null)
            {
                var p = parentOf[lookup.ReferencedTable];
#>
            <ComboBox Header="<#= label #>" ItemsSource="{x:Bind ViewModel.<#= p.OptionsProp #>}"
                      SelectedValuePath="Id" DisplayMemberPath="Text"
                      SelectedValue="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}" />
<#
            }
            else if (IsBit(c))
            {
#>
            <CheckBox Content="<#= label #>" IsChecked="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}" />
<#
            }
            else if (IsDate(c))
            {
#>
            <TextBox Header="<#= label #>" Text="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}" PlaceholderText="yyyy-MM-dd" />
<#
            }
            else if (IsMultiline(c))
            {
#>
            <TextBox Header="<#= label #>" Text="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="80" MaxLength="<#= Chars(c) #>" />
<#
            }
            else
            {
                string maxLen = IsText(c) && Chars(c) > 0 ? $" MaxLength=\"{Chars(c)}\"" : "";
#>
            <TextBox Header="<#= label #>" Text="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"<#= maxLen #> />
<#
            }
        }
#>

            <TextBlock Text="Save this <#= title #> first to add or see child rows below." FontStyle="Italic"
                       Visibility="{x:Bind ViewModel.IsAddModeVisibility}" />
<#
        foreach (var child in children)
        {
#>

            <TextBlock Text="<#= Words(child.Table) #>" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <!-- Boxed the same way as WinUI3_MasterScreen.tt's own grid: a line around the whole grid, a line
                 under the header, and a line under every row — see that template's 2026-09-27 styling note. -->
            <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="0,0,0,1" Padding="8">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.<#= child.Var #>ColumnHeaders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontWeight="SemiBold" Width="120" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.<#= child.Var #>Rows}" IsEnabled="False" MaxHeight="200" Padding="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Width="120" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
<#
        }
#>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
@@@FILE <#= viewsFolder #>/<#= table #>DetailMasterDialog.xaml.cs@@@
using <#= viewModelNamespace #>;
using Microsoft.UI.Xaml.Controls;
<#
        foreach (string u in usings)
        {
#>
using <#= u #>;
<#
        }
#>

namespace <#= viewNamespace #>;

// Assumes nothing from CodeGenNew.App itself -- a plain ContentDialog, no shared house-style helper.
public sealed partial class <#= table #>DetailMasterDialog : ContentDialog
{
    public <#= table #>DetailMasterViewModel ViewModel { get; }

    /// <param name="editing"> The row being edited, or null to add a new one (child grids only load for an existing row). </param>
    public <#= table #>DetailMasterDialog(<#= contextType #> context, <#= table #>? editing = null)
    {
        ViewModel = new <#= table #>DetailMasterViewModel(context, editing);
        InitializeComponent();
        Loaded += async (_, _) => await ViewModel.LoadAsync();
    }

    // Validation failure keeps the dialog open instead of closing it -- see ViewModel.SaveAsync.
    private async void OnPrimaryButtonClick(ContentDialog sender, ContentDialogButtonClickEventArgs args)
    {
        var deferral = args.GetDeferral();
        try
        {
            if (!await ViewModel.SaveAsync())
                args.Cancel = true;
        }
        finally
        {
            deferral.Complete();
        }
    }
}
@@@FILE <#= viewModelsFolder #>/<#= table #>DetailMasterViewModel.cs@@@
using System.Collections.Generic;
using System.Collections.ObjectModel;
using System.Threading.Tasks;
using <#= contextNamespace #>;
using CommunityToolkit.Mvvm.ComponentModel;
using Microsoft.EntityFrameworkCore;
using Microsoft.UI.Xaml;
<#
        foreach (string u in usings)
        {
#>
using <#= u #>;
<#
        }
#>

namespace <#= viewModelNamespace #>;

/// <summary> One entry of a <#= table #>DetailMasterDialog drop-down: an id plus the text to show for it. </summary>
public class <#= table #>DetailMasterLookupOption
{
    public int Id { get; set; }
    public string Text { get; set; } = "";
}

/// <summary> One row of a child grid: a display string per scalar EF property of the child entity (see this
/// template's header comment for why the columns are discovered at run time, via EF's own metadata, instead
/// of being known when the file was generated). </summary>
public class <#= table #>ChildGridRow
{
    public List<string> Cells { get; init; } = [];
}

public partial class <#= table #>DetailMasterViewModel : ObservableObject
{
    private readonly <#= contextType #> _context;
    private readonly <#= table #>Repo _repo;
    private readonly <#= table #>? _editing;

    public string DialogTitle => _editing is null ? "Add <#= title #>" : "Edit <#= title #>";
    public Visibility IsAddModeVisibility => _editing is null ? Visibility.Visible : Visibility.Collapsed;

<#
        foreach (var p in parents)
        {
#>
    public ObservableCollection<<#= table #>DetailMasterLookupOption> <#= p.OptionsProp #> { get; } = [];
<#
        }
        foreach (var child in children)
        {
#>
    public ObservableCollection<string> <#= child.Var #>ColumnHeaders { get; } = [];
    public ObservableCollection<<#= table #>ChildGridRow> <#= child.Var #>Rows { get; } = [];
<#
        }
#>

    [NotifyPropertyChangedFor(nameof(HasError))]
    [ObservableProperty]
    private string? _errorMessage;
    public bool HasError => ErrorMessage is not null;

<#
        foreach (var c in shown)
        {
            var lookup = LookupOf(c);
            string prop = c.Name;
            string fieldType = lookup is not null ? "int?" : IsBit(c) ? "bool?" : "string?";
#>
    [ObservableProperty]
    private <#= fieldType #> _<#= char.ToLowerInvariant(prop[0]) #><#= prop[1..] #>;
<#
        }
#>

    public <#= table #>DetailMasterViewModel(<#= contextType #> context, <#= table #>? editing)
    {
        _context = context;
        _repo = new <#= table #>Repo(context);
        _editing = editing;
        // Add leaves every field at its default (null/blank); Edit fills them in from the row being edited.
        if (editing is not null)
        {
<#
        foreach (var c in shown)
        {
            var lookup = LookupOf(c);
            string prop = c.Name;
            if (lookup is not null)
            {
                // Deliberately NOT set here -- see LoadAsync below. A ComboBox's SelectedValue binding does
                // not retroactively select an item once its ItemsSource is populated AFTER SelectedValue was
                // already assigned to a value with no match yet (a real, known WinUI3/UWP limitation, not
                // just a timing quirk): the box renders as if empty even though editing.{prop} is correct,
                // until the person types in it (found live clicking through a real running app, 2026-09-28).
            }
            else if (IsBit(c))
            {
#>
            <#= prop #> = editing.<#= prop #>;
<#
            }
            else if (IsDate(c))
            {
#>
            <#= prop #> = editing.<#= prop #><#= c.IsNullable ? "?.ToString(\"yyyy-MM-dd\")" : ".ToString(\"yyyy-MM-dd\")" #>;
<#
            }
            else
            {
#>
            <#= prop #> = editing.<#= prop #><#= c.IsNullable ? "?.ToString()" : ".ToString()" #>;
<#
            }
        }
#>
        }
    }

    /// <summary> Loads the drop-downs (always) and the child grids (only when editing an existing row --
    /// a brand-new row has no child rows yet). </summary>
    public async Task LoadAsync()
    {
<#
        foreach (var p in parents)
        {
            var lookupColumnsForThisParent = shown.Where(c => LookupOf(c) is ForeignKeyModel fk && fk.ReferencedTable.Equals(p.Table, StringComparison.OrdinalIgnoreCase)).ToList();
#>
        <#= p.OptionsProp #>.Clear();
        foreach (var row in await _context.Set<<#= p.Table #>>().OrderBy(r => r.<#= p.DisplayProp #>).ToListAsync())
            <#= p.OptionsProp #>.Add(new <#= table #>DetailMasterLookupOption { Id = row.<#= p.KeyProp #>, Text = row.<#= p.DisplayProp #>?.ToString() ?? "" });
<#
            if (lookupColumnsForThisParent.Count > 0)
            {
#>
        if (_editing is not null)
        {
<#
                foreach (var c in lookupColumnsForThisParent)
                {
#>
            <#= c.Name #> = _editing.<#= c.Name #>;
<#
                }
#>
        }
<#
            }
        }
        foreach (var child in children)
        {
#>
        await Load<#= child.Table #>Async();
<#
        }
#>
    }

<#
        foreach (var child in children)
        {
#>
    private async Task Load<#= child.Table #>Async()
    {
        <#= child.Var #>ColumnHeaders.Clear();
        <#= child.Var #>Rows.Clear();
        if (_editing is null)
            return; // no child rows to show until this <#= title #> has been saved once

<#
        foreach (var r in child.Resolvable)
        {
#>
        var <#= r.LookupVar #> = await _context.Set<<#= r.ReferencedTable #>>().ToDictionaryAsync(r => r.<#= r.KeyProp #>, r => r.<#= r.DisplayProp #>?.ToString() ?? "");
<#
        }
#>
        // <#= child.FkColumn #> (this grid's own filter column, always the same value here) and any internal id
        // column with no resolvable display name are left out entirely -- see the "children" comment above.
        var entityType = _context.Model.FindEntityType(typeof(<#= child.Table #>))!;
        var propertyNames = entityType.GetProperties().Select(p => p.Name)
            .Where(name => !HideFrom<#= child.Table #>Grid.Contains(name, StringComparer.OrdinalIgnoreCase)).ToList();
        foreach (string name in propertyNames)
            <#= child.Var #>ColumnHeaders.Add(HeaderLabelFor<#= child.Table #>Grid.TryGetValue(name, out string? label) ? label : name);

        var rows = await _context.Set<<#= child.Table #>>()
            .Where(c => EF.Property<int>(c, "<#= child.FkColumn #>") == _editing!.<#= child.ParentKeyColumn #>)
            .ToListAsync();
        foreach (var row in rows)
        {
            var cells = propertyNames.Select(name =>
            {
                object? raw = typeof(<#= child.Table #>).GetProperty(name)!.GetValue(row);
<#
        if (child.Resolvable.Count > 0)
        {
#>
                if (raw is int rawId)
                {
<#
            foreach (var r in child.Resolvable)
            {
#>
                    if (name == "<#= r.Column #>")
                        return <#= r.LookupVar #>.TryGetValue(rawId, out string? resolved<#= r.Column #>) ? resolved<#= r.Column #> : rawId.ToString();
<#
            }
#>
                }
<#
        }
#>
                return raw?.ToString() ?? "";
            }).ToList();
            <#= child.Var #>Rows.Add(new <#= table #>ChildGridRow { Cells = cells });
        }
    }

    private static readonly string[] HideFrom<#= child.Table #>Grid = [ <#= string.Join(", ", child.HideColumns.Select(c => $"\"{c}\"")) #> ];
    // A resolved column's header (e.g. "Customer" instead of "CustomerId") -- known at generation time, unlike
