    // "Number" is written # and "Percent"/"Percentage" %, as in the list screens' captions ("Item Number" -> "Item #").
    private static string SpacedHeader(string name)
    {
        string spaced = Regex.Replace(Regex.Replace(Regex.Replace(name, "^SY_", ""), "Id$", "").Replace('_', ' '),
            "(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])", " ").Trim();
        return string.Join(' ', spaced.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(word => word.ToLowerInvariant() switch
        {
            "number" or "num" => "#",
            "percentage" or "percent" or "pct" => "%",
            _ => word
