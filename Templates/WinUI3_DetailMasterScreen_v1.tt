<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // folders, lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string viewNamespace = "MyApp.Desktop.Views";
    string viewModelNamespace = "MyApp.Desktop.ViewModels";
    string contextType = "MyAppContext";
    string contextNamespace = "MyApp.Common.Data";
    string[] usings = { };
    string viewsFolder = "Views";
    string viewModelsFolder = "ViewModels";
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    viewNamespace = Project.ViewNamespace ?? viewNamespace;
    viewModelNamespace = Project.ViewModelNamespace ?? viewModelNamespace;
    contextType = Project.ContextName ?? contextType;
    contextNamespace = Project.ContextNamespace ?? contextNamespace;
    usings = Project.Usings ?? usings;
    viewsFolder = Project.ViewsFolder ?? viewsFolder;
    viewModelsFolder = Project.ViewModelsFolder ?? viewModelsFolder;
    // ==========================================================================================

    // ==========================================================================================
    // WinUI3_DetailMasterScreen_v1.tt
    // Generates: Views/<Table>DetailMasterDialog.xaml and .xaml.cs, ViewModels/<Table>DetailMasterViewModel.cs, Views/PaginationBar and CurrencyNumberFormatter
    // WinUI3_DetailScreen's form (same field, drop-down and validation rules) plus one sortable grid per child table, so editing a row also shows the
    // rows that hang off it; clicking one opens its own dialog. Needs a table with at least one child foreign key.
    // Full notes: Docs/TemplateNotes/WinUI3_DetailMasterScreen_v1.md
    // ==========================================================================================

    // Every whole-number column (a foreign key to a lookup is handled before this) is edited in a number box, whose value is a double:
    // the ViewModel holds it as a double (NaN = blank) and the save converts it back, after checking it is whole and in range.
    // A currency column (money, or a decimal whose name says money) is also edited in a number box, formatted as currency in code-behind
    // (a NumberFormatter cannot be declared in XAML; CurrencyNumberFormatter.cs, written alongside, formats as currency and also reads a plain number), and converted back to a decimal rounded to the column's scale on save.
    // A decimal, float or real column that is not money (a percentage, a rate, a quantity, a weight) is edited in a number box too: its value is a double
    // (NaN = blank), limited to what the column can hold (NumericClassifier.DecimalRange), and converted back on save.

    var form = FormModel.For(Model, Project);   // what the screen is made of, decided in Core for every stack
    var keyColumn = form.KeyColumn;
    bool isNameActive = form.IsNameActive;

    var keyType = form.KeyType;   // how the key travels: a text key is typed by the person on a new row and read-only afterwards
    if (keyColumn is null || keyType is null)
    {
        Error($"WinUI3_DetailMasterScreen needs a table with a single int, uniqueidentifier or text primary key (CS_Repo's GenericRepo<T, TKey> takes it as the id), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else if (isNameActive)
    {
        Error($"WinUI3_DetailMasterScreen is for plain tables. [{Model.SchemaName}].[{Model.TableName}] has a Name and an IsActive column, so its repository is a NameActiveRepo; write this screen by hand.");
    }
    else if (!Model.HasAtLeastOneChildForeignKey)
    {
        Error($"WinUI3_DetailMasterScreen needs at least one other table with a foreign key pointing back at [{Model.SchemaName}].[{Model.TableName}]; none was found - use WinUI3_DetailScreen instead.");
    }
    else
    {
        string table = Model.TableName;
        string title = form.Title;
        string keyProp = keyColumn.Name;
        bool textKey = form.TextKey;

        var shown = form.Columns;

        // A form with more than one kind of field is tabbed (Main / Billing & Shipping / Notes): see FormPages. A narrow table keeps its single column.
        var pages = form.Pages.Select(p => (Header: p.Header.Replace("&", "&amp;"), Columns: p.Columns)).ToList();
        bool tabbed = pages.Count > 1;

        var parents = form.Parents;
        // a parent with too many rows for a drop-down is found by typing: an AutoSuggestBox that asks the context for the rows whose text contains what was typed
        var aheadParents = parents.Where(p => p.TypeAhead).ToList();
        var aheadColumns = shown.Where(c => form.KindOf(c) == FieldKind.Lookup && form.ParentOf(c) is { TypeAhead: true }).ToList();

        if (!Model.HasReferencedDisplayColumns && parents.Count > 0)
            Error("WinUI3_DetailMasterScreen needs the foreign-keyed tables' display columns for its drop-downs; its .tt.config must say NeedsReferencedDisplayColumns=true.");

        // Skipped, not just the composite-key case: a child whose foreign key points at one of OUR columns
        // that isn't a plain int (almost always our own int primary key, but a child can reference any
        // unique column) - the grid's filter below is EF.Property<int>, matching the int-only assumption
        // this whole template family makes about keys.
        // A raw internal id (the child's own primary key, or another foreign key on the child with no
        // resolvable display name) has no business meaning to a user looking at the grid - hidden entirely.
        // A foreign key on the child that DOES have a resolvable display name (e.g. a SalesInvoice child row's
        // own CustomerId) is resolved to that name instead of shown as a raw number, the same way this
        // template's own parent drop-downs resolve a display name for THIS table's foreign keys. Found live:
        // a real user looking at the generated grid saw SalesInvoiceId/CustomerId/CustomerMonthlySummaryId next
        // to InvoiceDate and asked for exactly this (2026-09-29).
        // The child tables, decided in Core for every stack (ChildGrid): which ones get a grid, its heading and role, its key, and the foreign keys shown as names.
        var children = ChildGrid.For(Model, Project)
            // the grid's filter compares the parent's key, so that column must be a usable key
            .Where(g => Model.Columns.Any(c => c.Name.EqualsIgnoreCase(g.Link.ReferencedColumns[0]) && KeyType.Of(c) is not null))
            .Select(g =>
            {
                var fk = g.Link;
                string gridVar = TemplateHelpers.LowerFirst(g.Table + g.Role);
                var resolvable = g.Lookups.Select(l => new
                {
                    Column = l.ColumnName,
                    ReferencedTable = l.ParentTable,
                    KeyProp = l.ParentKeyName,
                    DisplayProp = l.ParentDisplayName,
                    KeyCs = l.ColumnKeyType?.CSharp ?? "int",   // the type of the id the child row holds
                    LookupVar = gridVar + l.ParentTable + "Names",
                    // "CustomerId" -> "Customer": a resolved column's name is known at generation time, so it gets a nicer header than the raw property name
                    Label = GridCaption.From(Labels.Column(l.ColumnName))
                }).ToList();
                // a drop-down per foreign key shown as a name: the names the rows have, picked from here; the grid holds every row of the child, so it filters them itself
                var filters = resolvable.Take(ChildGrid.MaxFilters)
                    .Select(r => new { r.Column, r.Label, All = "All " + r.Label.Pluralize(), Choices = gridVar + r.Column + "Choices", Prop = TemplateHelpers.UpperFirst(gridVar) + r.Column + "Filter" }).ToList();

                return new
                {
                    Table = fk.ReferencingTable,
                    HasChildren = fk.ReferencingTableHasChildren,
                    Title = g.Title,
                    Var = gridVar,
                    FkColumn = fk.ReferencingColumns[0],
                    ParentKeyColumn = fk.ReferencedColumns[0],
                    ParentKeyCs = Model.Columns.First(c => c.Name.EqualsIgnoreCase(fk.ReferencedColumns[0])).CSharpBase(),   // int, Guid or string: the type the grid's filter compares
                    // in a fixed order (this row's key, the child's own key, then the ids that are not named), so regenerating the same table twice gives identical output
                    HideColumns = g.HiddenColumns.ToList(),
                    Resolvable = resolvable,
                    Filters = filters,
                    // What the schema says about the child's columns: money shows as currency, long text goes last.
                    Currency = fk.ReferencingTableColumns.Where(c => c.IsMoneyAmount)
                        .Select(c => (Name: c.Name, Digits: NumericClassifier.CurrencyDigits(c))).ToList(),
                    LongText = fk.ReferencingTableColumns.Where(c => c.IsLongTextColumn).Select(c => c.Name).ToList(),
                    // The caption each child column gets (date columns lose "Date", yes/no columns end in "?", Number -> #, Percent -> %).
                    Captions = fk.ReferencingTableColumns.Select(c => (Name: c.Name, Caption: GridCaption.For(c, Labels.Column(c.Name)))).ToList()
                };
            }).ToList();
#>
@@@FILE <#= viewsFolder #>/<#= table #>DetailMasterDialog.xaml@@@
<ContentDialog
    x:Class="<#= viewNamespace #>.<#= table #>DetailMasterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <!-- A ContentDialog's width is capped by these two theme resources (about 320-548 by default), NOT by its own
         MinWidth/MaxWidth or by anything inside it, which is why setting those has no effect. Raising the cap
         lets the ScrollViewer's own MinWidth below (and the content) decide the width, up to the window. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">320</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1400</x:Double>
        <!-- every button's caption is bold -->
        <Style x:Key="BoldDialogButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="BoldAccentDialogButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
<#= form.Columns.Any(form.IsMarked) ? RequiredMark.XamlHeaderTemplate : "" #>    </ContentDialog.Resources>
    <!-- The two button styles are declared above and applied here: an attribute on the root element is read before the Resources element, so a StaticResource there is not found and the dialog fails to open. -->
    <ContentDialog.PrimaryButtonStyle>
        <StaticResource ResourceKey="BoldAccentDialogButton" />
    </ContentDialog.PrimaryButtonStyle>
    <ContentDialog.CloseButtonStyle>
        <StaticResource ResourceKey="BoldDialogButton" />
    </ContentDialog.CloseButtonStyle>

    <!-- The error bar sits ABOVE the scrolling area: inside it, a validation message is out of sight whenever the person has scrolled down. -->
    <StackPanel Spacing="12">
        <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />
    <ScrollViewer MinWidth="560" MaxHeight="620" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
        <!-- The bottom padding keeps the last row of a child grid from sitting on the very edge of the scrolling area, where it was cut off even when scrolled to the end. -->
        <StackPanel Spacing="12" Padding="0,0,0,24">
<#
        if (tabbed)
        {
#>
            <TabView IsAddTabButtonVisible="False" TabWidthMode="SizeToContent" CanReorderTabs="False" CanDragTabs="False" SelectedIndex="0">
<#
        }
        foreach (var page in pages)
        {
            if (tabbed)
            {
#>
                <TabViewItem Header="<#= page.Header #>" IsClosable="False">
                    <StackPanel Spacing="12" Padding="0,8,0,8">
<#
            }
        foreach (var c in page.Columns)
        {
            var kind = form.KindOf(c);
            var value = form.ValueOf(c);
            string prop = c.Name;
            string label = Labels.Column(c.Name);
            if (kind == FieldKind.SystemStamp)
            {
                // who made the row and when it changed: the system writes it, so it is text, not a box
#>
            <StackPanel Spacing="2">
                <TextBlock Text="<#= label #>" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.<#= prop #>, Mode=OneWay}" IsTextSelectionEnabled="True" />
            </StackPanel>
<#
                continue;
            }
            if (kind == FieldKind.Lookup)
            {
                var p = form.ParentOf(c)!;
                if (p.TypeAhead)
                {
#>
            <AutoSuggestBox<#= form.IsMarked(c) ? "" : " Header=\"" + label + "\"" #><#= RequiredMark.XamlAttributes(form.IsRequired(c), false) #> AutomationProperties.Name="<#= label #>" PlaceholderText="Type to find" DisplayMemberPath="Text" TextMemberPath="Text"
                            Text="{x:Bind ViewModel.<#= prop #>Text, Mode=TwoWay}" TextChanged="On<#= prop #>TextChanged" SuggestionChosen="On<#= prop #>Chosen">
<#
                    if (form.IsMarked(c))
                    {
                        // an AutoSuggestBox has no header template: the caption and its red asterisk are the header itself
#>
                <AutoSuggestBox.Header>
                    <TextBlock><Run Text="<#= label #>" /><Run Text=" <#= RequiredMark.Glyph #>" Foreground="Red" /></TextBlock>
                </AutoSuggestBox.Header>
<#
                    }
#>
            </AutoSuggestBox>
<#
                }
                else
                {
#>
            <ComboBox Header="<#= label #>"<#= RequiredMark.XamlAttributes(form.IsRequired(c), form.IsMarked(c)) #> ItemsSource="{x:Bind ViewModel.<#= WinUI3Names.OptionsProperty(p) #>}"
                      SelectedValuePath="Id" DisplayMemberPath="Text"
                      SelectedValue="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}" />
<#
                }
            }
            else if (kind == FieldKind.Choices)
            {
#>
            <ComboBox Header="<#= label #>"<#= RequiredMark.XamlAttributes(form.IsRequired(c), form.IsMarked(c)) #> ItemsSource="{x:Bind ViewModel.<#= prop #>Choices}"
                      SelectedItem="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}" />
<#
            }
            else if (kind == FieldKind.Money)
            {
#>
            <NumberBox x:Name="<#= prop #>Box" Header="<#= label #>"<#= RequiredMark.XamlAttributes(form.IsRequired(c), form.IsMarked(c)) #> Value="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"
                       <#= Project.MoneyLimitAttributes(table, c) #>ValidationMode="InvalidInputOverwritten" Width="180" HorizontalAlignment="Left" />
<#
            }
            else if (value == ValueKind.Decimal)
            {
                var (decMin, decMax) = NumericClassifier.DecimalRange(c);
                int decDigits = Inv(decMax).Length + (c.SqlType == SqlDbType.Decimal ? NumericClassifier.DecimalPlaces(c) : 4);
                string decWidth = $" Width=\"{Math.Max(Math.Min(decDigits, 12) * 10 + 150, label.Length * 7 + 8)}\" HorizontalAlignment=\"Left\"";
#>
            <NumberBox x:Name="<#= prop #>Box" Header="<#= label #>"<#= RequiredMark.XamlAttributes(form.IsRequired(c), form.IsMarked(c)) #> Value="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"
                       Minimum="<#= Inv(decMin) #>" Maximum="<#= Inv(decMax) #>" SmallChange="1" LargeChange="10"
                       SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten"<#= decWidth #> />
<#
            }
            else if (value == ValueKind.WholeNumber)
            {
                var range = Project.RangeFor(c)!.Value;
                // Narrow to the widest number the range allows (a month is two digits, a year four) plus what the box itself needs
                // around the text - two inline spin buttons, the clear ("x") button and padding, about 150 pixels; any less leaves
                // no visible room to type - and never narrower than the header text. The digits count at most nine, so a number box over a
                // whole int (a foreign key shown as a plain number) is not stretched across the dialog.
                int digits = Math.Max(range.Min.ToString().Length, range.Max.ToString().Length);
                string width = $" Width=\"{Math.Max(Math.Min(digits, 9) * 10 + 150, label.Length * 7 + 8)}\" HorizontalAlignment=\"Left\"";
#>
            <NumberBox Header="<#= label #>"<#= RequiredMark.XamlAttributes(form.IsRequired(c), form.IsMarked(c)) #> Value="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"
                       Minimum="<#= range.Min #>" Maximum="<#= range.Max #>" SmallChange="1" LargeChange="<#= range.Max - range.Min >= 100 ? 10 : 1 #>"
                       SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten"<#= width #> />
<#
            }
            else if (kind == FieldKind.Boolean)
            {
#>
            <CheckBox Content="<#= label #>?" IsChecked="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}" />
<#
            }
            else if (kind == FieldKind.Date)
            {
#>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CalendarDatePicker Header="<#= label #>"<#= RequiredMark.XamlAttributes(form.IsRequired(c), form.IsMarked(c)) #> Date="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"
                                    DateFormat="{}{month.integer}/{day.integer}/{year.full}" PlaceholderText="mm/dd/yyyy" Width="180" />
<#
                if (c.IsNullable)
                {
#>
                <Button Content="Clear" VerticalAlignment="Bottom" Click="OnClear<#= prop #>Click" />
<#
                }
#>
            </StackPanel>
<#
            }
            else if (kind == FieldKind.Multiline)
            {
#>
            <TextBox Header="<#= label #>"<#= RequiredMark.XamlAttributes(form.IsRequired(c), form.IsMarked(c)) #> Text="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="80" MaxLength="<#= Chars(c) #>" />
<#
            }
            else
            {
                string maxLen = IsText(c) && Chars(c) > 0 ? $" MaxLength=\"{Chars(c)}\"" : "";
                // the key of a new row is typed; once the row exists it is read-only (the API does not change a key)
                string readOnly = textKey && c.IsPrimaryKey ? " IsReadOnly=\"{x:Bind ViewModel.IsExisting}\"" : "";
#>
            <TextBox Header="<#= label #>"<#= RequiredMark.XamlAttributes(form.IsRequired(c), form.IsMarked(c)) #> Text="{x:Bind ViewModel.<#= prop #>, Mode=TwoWay}"<#= maxLen #><#= readOnly #> />
<#
            }
        }
            if (tabbed)
            {
#>
                    </StackPanel>
                </TabViewItem>
<#
            }
        }
        if (tabbed)
        {
#>
            </TabView>
<#
        }
#>

            <TextBlock Text="Save this <#= title #> first to add or see child rows below." FontStyle="Italic"
                       Visibility="{x:Bind ViewModel.IsAddModeVisibility}" />
<#
        foreach (var child in children)
        {
#>

            <TextBlock Text="<#= child.Title #>" Style="{ThemeResource BodyStrongTextBlockStyle}" />
<#
            if (child.Filters.Count > 0)
            {
#>
            <StackPanel Orientation="Horizontal" Spacing="8">
<#
                foreach (var f in child.Filters)
                {
#>
                <ComboBox AutomationProperties.Name="Filter <#= child.Title #> by <#= f.Label #>" MinWidth="180" ItemsSource="{x:Bind ViewModel.<#= TemplateHelpers.UpperFirst(f.Choices) #>}"
                          SelectedItem="{x:Bind ViewModel.<#= f.Prop #>, Mode=TwoWay}" />
<#
                }
#>
            </StackPanel>
<#
            }
#>
            <!-- Boxed the same way as WinUI3_MasterScreen.tt's own grid: a line around the whole grid, a line
                 under the header, and a line under every row — see that template's 2026-09-27 styling note.
                 Clicking a row opens that child row's own dialog (see On<#= child.Table #>ItemClick in the code-behind).
                 A click on a column header sorts the rows by it (again: flips the direction); a right-click on the grid offers Clear sort. -->
            <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="1" CornerRadius="4"
                    Background="Transparent" RightTapped="On<#= child.Table #>GridRightTapped">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="0,0,0,1" Padding="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.<#= child.Var #>ColumnHeaders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Text}" Tag="{Binding Column}" Click="On<#= child.Table #>HeaderClick" Width="120" Padding="0"
                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Actions" FontWeight="SemiBold" Width="120" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.<#= child.Var #>Rows}"
                              IsItemClickEnabled="True" ItemClick="On<#= child.Table #>ItemClick" MaxHeight="200" Padding="0">
                        <!-- A ListView sizes itself from the rows' content, but every row container has a 40 pixel minimum height; with shorter rows the grid came out
                             a fraction of a row too short and its last row was cut off. No minimum makes the rows and the grid agree. -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <!-- x:Bind to the string, not {Binding}: a classic Binding to an EMPTY string falls back to the row object
                                                 as its DataContext and prints that object's type name ("InvoiceSystem.App.") in the cell. -->
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{x:Bind}" Width="120" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Row-level Edit and Delete, like the master screens' grids. Delete asks to be clicked twice (a second ContentDialog cannot open over this one). -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" Width="120">
                                        <Button Content="Edit" FontWeight="Bold" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="8,2" Click="On<#= child.Table #>EditClick" />
                                        <Button Content="Delete" FontWeight="Bold" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="8,2" Click="On<#= child.Table #>DeleteClick" LostFocus="On<#= child.Table #>DeleteLostFocus" />
                                    </StackPanel>
                                  </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
<#
        }
#>
        </StackPanel>
    </ScrollViewer>
    </StackPanel>
</ContentDialog>
@@@FILE <#= viewsFolder #>/<#= table #>DetailMasterDialog.xaml.cs@@@
using <#= viewModelNamespace #>;
using Microsoft.UI.Xaml.Controls;
<#
        var currencyColumns = shown.Where(c => form.ValueOf(c) == ValueKind.Money).ToList();
        foreach (string u in usings)
        {
#>
using <#= u #>;
<#
        }
#>

namespace <#= viewNamespace #>;

// Assumes nothing from CodeGenNew.App itself - a plain ContentDialog, no shared house-style helper.
public sealed partial class <#= table #>DetailMasterDialog : ContentDialog
{
    private readonly <#= contextType #> _context; // for the child dialogs a clicked row opens
    public <#= table #>DetailMasterViewModel ViewModel { get; }
    private System.Threading.Tasks.Task _loading = System.Threading.Tasks.Task.CompletedTask;
    private System.Threading.Tasks.TaskCompletionSource? _drillDown; // set while a child dialog opened from this one is showing

    /// <param name="editing"> The row being edited, or null to add a new one (child grids only load for an existing row). </param>
    public <#= table #>DetailMasterDialog(<#= contextType #> context, <#= table #>? editing = null)
    {
        _context = context;
        ViewModel = new <#= table #>DetailMasterViewModel(context, editing);
        InitializeComponent();
<#
        foreach (var c in currencyColumns)
        {
#>
        <#= c.Name #>Box.NumberFormatter = new CurrencyNumberFormatter("<#= Project.CurrencyCode #>", <#= NumericClassifier.CurrencyDigits(c) #>);
<#
        }
#>
<#
        foreach (var c in shown.Where(c => form.ValueOf(c) == ValueKind.Decimal && c.SqlType == SqlDbType.Decimal))
        {
#>
        <#= c.Name #>Box.NumberFormatter = new Windows.Globalization.NumberFormatting.DecimalFormatter
        {
            IntegerDigits = 1, FractionDigits = <#= NumericClassifier.DecimalPlaces(c) #>, IsGrouped = false,
            NumberRounder = new Windows.Globalization.NumberFormatting.IncrementNumberRounder { Increment = <#= Inv(Math.Pow(10, -NumericClassifier.DecimalPlaces(c))) #>, RoundingAlgorithm = Windows.Globalization.NumberFormatting.RoundingAlgorithm.RoundHalfUp }
        };
<#
        }
#>
        Loaded += (_, _) => _loading = ViewModel.LoadAsync();
    }

    // ShowAsync() returns the moment the dialog closes (or hides itself to open a child row's dialog), which can be before the dialog's own LoadAsync() has
    // finished or while a child dialog is still showing and loading. A DbContext is not thread-safe, so a caller that is about to use the same context (reload the
