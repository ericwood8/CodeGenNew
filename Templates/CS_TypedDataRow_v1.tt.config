# Restriction checkboxes for CS_TypedDataRow_v1.tt (see Docs/Reference.md section 3).
# A typed DataTable needs no key: it declares one only when the table has one.
Requires=
# Name the file like the class: Customer -> CustomerDataTable.cs
OutputName={Table}DataTable.cs
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso.
Stacks=Api
PlanTables=Dto
OutputFolder=Dtos
InPlan=false
