# Restriction checkboxes for RS_Csv_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# The Rust stack reads PostgreSQL, MySQL and SQLite through sqlx; SQL Server is not supported.
Dialects=PostgreSql,MySql,Sqlite
# The template writes its own path (src/routes/csv_files.rs) with an @@@FILE marker.
OutputName=src/routes/csv_files.rs
# Whole-project generation (codegen generate): for a project that sets ApiCsv=true (or names the template in PlanAlso).
Stacks=Rust
InPlan=false
