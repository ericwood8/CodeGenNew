<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string apiNamespace = "TimeEntry.ApiService.Apis";
    string contextType = "TimeEntryContext";
    string connectionName = "DbConnectionString";   // the key under ConnectionStrings in appsettings.json
    string[] usings = { };                          // namespaces the generated file must "using" (the context's and the entities')
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    apiNamespace = Project.ApiNamespace ?? apiNamespace;
    contextType = Project.ContextName ?? contextType;
    usings = Project.Usings ?? usings;
    // ==========================================================================================

    // ==========================================================================================
    // API_Registration_v1.tt
    // Generates: ApiRegistration.cs   (see OutputName in API_Registration_v1.tt.config)
    // The part of a web API's Program.cs that used to list every table: AddGeneratedDbContext(builder.Configuration) and app.RegisterGeneratedApis(),
    // which registers the CRUD and search endpoints of every table that has an API. One file for the whole database; the provider call comes
    // from the context (CS_DbContext). Needs the project's namespaces (ApiNamespace, RepoNamespace, ContextNamespace, ...).
    // Full notes: Docs/TemplateNotes/API_Registration_v1.md

    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');
    var tables = Database.ApiTables(Project).OrderBy(t => t.TableName, StringComparer.OrdinalIgnoreCase).ToList();

    Line($"namespace {apiNamespace};");
    Line();
    foreach (string u in usings)
        Line($"using {u};");
    Line("using Microsoft.EntityFrameworkCore;");
    Line();
    Line("/// <summary> Generated by API_Registration: the database and one route group per table, so Program.cs lists nothing. </summary>");
    Line("public static class ApiRegistration");
    Line("{");
    Line("    public static IServiceCollection AddGeneratedDbContext(this IServiceCollection services, IConfiguration configuration) =>");
    Line($"        services.AddDbContext<{contextType}>(options => {contextType}.UseProvider(options, configuration.GetConnectionString(\"{connectionName}\")));");
    Line();
    Line("    public static void RegisterGeneratedApis(this WebApplication app)");
    Line("    {");
    foreach (var t in tables)
        Line($"        new {t.TableName}Api<{t.TableName}>().Register(app);");
    Line();
    foreach (var t in Database.SearchApiTables(Project).OrderBy(t => t.TableName, StringComparer.OrdinalIgnoreCase))
        Line($"        new {t.TableName}SearchApi<{t.TableName}>().Register(app);");
    Line("    }");
    Line("}");
    Write(sb.ToString());
#>
