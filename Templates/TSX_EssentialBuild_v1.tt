<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // TSX_EssentialBuild_v1.tt
    // Generates: package.json, vite.config.ts and tsconfig.json   (no table, no database: an essentials group)
    // The build files of a Vite + React + TypeScript app with the Vitest setup the generated page tests use. vite.config.ts proxies /api to the API (settings ApiPort, default 5080) and sets the
    // dev server's port (DevPort, default 5173). The package name comes from the project name.
    // ==========================================================================================
    string packageName = System.Text.RegularExpressions.Regex.Replace(Project.ProjectName ?? "my-app", "(?<=[a-z0-9])(?=[A-Z])", "-").ToLowerInvariant() + "-react";
#>
@@@FILE package.json@@@
{
  "name": "<#= packageName #>",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
@@@FILE vite.config.ts@@@
import { defineConfig } from 'vitest/config';
import react from '@vitejs/plugin-react';

// The API listens on http://localhost:<#= Project.ApiPort #>; the generated api modules call relative /api/... paths,
// so the dev server forwards them and the browser never makes a cross-origin request.
export default defineConfig({
  plugins: [react()],
  server: {
    port: <#= Project.DevPort("React") #>,
    proxy: {
      '/api': 'http://localhost:<#= Project.ApiPort #>',
    },
  },
  test: {
    environment: 'jsdom',
    globals: true,
    setupFiles: './src/setupTests.ts',
  },
});
@@@FILE tsconfig.json@@@
{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
