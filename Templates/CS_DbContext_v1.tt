<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string contextNamespace = "MyApp.Common.Data";
    string contextType = "MyAppContext";
    string connectionName = "DbConnectionString";   // the key under ConnectionStrings in appsettings.json
    string[] usings = { };                          // namespaces the generated file must "using" (the entities')
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    contextNamespace = Project.ContextNamespace ?? contextNamespace;
    contextType = Project.ContextName ?? contextType;
    usings = Project.Usings ?? usings;
    // ==========================================================================================

    // ==========================================================================================
    // CS_DbContext_v1.tt
    // Generates: <ContextName>.cs   (see OutputName in CS_DbContext_v1.tt.config)
    // The EF Core context for the whole database, written for the database the schema came from (SQL Server, PostgreSQL or MySQL): a DbSet per
    // table that has a primary key, both constructors, and the provider call in one place (UseProvider, also used by API_Registration).
    // A composite key gets HasKey in OnModelCreating, which then calls a partial OnModelCreatingPartial for hand-written additions.
    // With EfConfigurations=true OnModelCreating applies the <Table>Configuration classes of CS_EfConfiguration instead (they carry the composite keys), then calls OnModelCreatingPartial.
    // The class is partial; DbSetNames=Plural names the sets in the plural. The NuGet package the provider needs is named in the class comment.
    // Full notes: Docs/TemplateNotes/CS_DbContext_v1.md

    var provider = EfProviderInfo.For(Database.Dialect);
    string databaseKind = DialectInfo.For(Database.Dialect).Name;
    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');

    Line($"namespace {contextNamespace};");
    Line();
    foreach (string u in usings)
        Line($"using {u};");
    Line("using Microsoft.EntityFrameworkCore;");
    // an enum table has no entity class (CS_Enum writes an enum), so the context holds no set for it
    var contextTables = Database.ContextTables.Where(t => Project.NoRepository(t.TableName, t.LookupShape) != true).ToList();
    // PostgreSQL array, interval, range and geometric columns and MySQL spatial columns: the entity holds their text, and a converter per property says how the database stores it.
    var textColumns = contextTables.SelectMany(t => t.Columns.Where(c => TextConversion.Of(c) is not null).Select(c => (Table: t, Column: c))).ToList();
    var helpers = TextConversion.Helpers(textColumns.Select(x => x.Column));
    // One query filter per entity (EF allows one): SoftDeleteTables hides a flagged row from every read (the table's API reads the flagged rows with IgnoreQueryFilters), and TenantTable limits a tenant-owned table
    // to the caller's tenant (CurrentTenantId below); the tenant table itself shows only the caller's own tenant.
    var tenantOwned = TenantPlan.OwnedTables(Database, Project).ToDictionary(o => o.Table.TableName, o => o.Column, StringComparer.OrdinalIgnoreCase);
    var tenantTable = Project.ApiAuth ? TenantPlan.TenantTableOf(Database, Project) : null;
    var tenantKey = tenantTable is null ? null : TenantPlan.KeyOf(tenantTable);
    bool tenancy = tenantKey is not null;
    var people = tenancy ? TenantPlan.PeopleOf(Database, Project) : null;   // the user table shows a tenant only its own members
    // a tenant added in the WinUI3 app by a platform administrator makes them its first administrator, as the API does for a tenant created through its route
    var creatorMember = tenancy && TenantPlan.HasDesktopSignIn(Project) && Project.TenantMembership is not null ? TenantPlan.MembershipOf(Database, Project) : null;
    var creatorUser = creatorMember is null ? null : UserTable.Resolve(Database, Project).Item1;
    bool creators = creatorMember is not null && creatorUser is not null;
    var filterLines = new List<string>();
    foreach (var table in contextTables)
    {
        var conditions = new List<string>();
        if (SoftDeletePlan.For(table, Project) is { } soft)
            conditions.Add($"!e.{soft.Flag.CSharpName()}");
        if (tenancy && tenantOwned.TryGetValue(table.TableName, out var tenantColumn))
            conditions.Add($"e.{tenantColumn.CSharpName()} == CurrentTenantId");
        else if (tenancy && table == tenantTable)
            conditions.Add($"(e.{tenantKey!.CSharpName()} == CurrentTenantId || IsPlatform)");
        else if (tenancy && people is not null && table == people.User.Table)
            conditions.Add($"(IsPlatform || Set<{people.Membership.Table.TableName}>().Any(m => m.{people.Membership.User.CSharpName()} == e.{people.Key.CSharpName()} && m.{people.Membership.Tenant.CSharpName()} == CurrentTenantId))");
        if (conditions.Count > 0)
            filterLines.Add($"        modelBuilder.Entity<{table.TableName}>().HasQueryFilter(e => {string.Join(" && ", conditions)});");
    }
    if (Database.Dialect == SqlDialect.Sqlite || textColumns.Count > 0)
        Line("using Microsoft.EntityFrameworkCore.Storage.ValueConversion;");
    foreach (string u in helpers.Usings)
        Line($"using {u};");
    Line("using Microsoft.Extensions.Configuration;");
    Line();
    Line($"/// <summary> The EF Core context over the {Database.DatabaseName} database ({databaseKind}). Generated by CS_DbContext: add your own parts in another file of this partial class.");
    Line($"/// Needs the NuGet packages {provider.Package} and Microsoft.Extensions.Configuration.Json. </summary>");
    Line($"public partial class {contextType} : DbContext");
    Line("{");
    // The DbSet is named like its table, or in the plural with DbSetNames=Plural (a plural that another table already uses stays singular).
    string SetName(TableModel table)
    {
        if (!Project.PluralDbSets) return table.TableName;
        string plural = table.TableName.Pluralize();
        return Database.Tables.Any(t => t != table && t.TableName.EqualsIgnoreCase(plural)) ? table.TableName : plural;
    }
    foreach (var table in contextTables)
        Line($"    public DbSet<{table.TableName}> {SetName(table)} => Set<{table.TableName}>();");
    Line();
    Line($"    public {contextType}()");
    Line("    {");
    if (tenancy && TenantPlan.HasDesktopSignIn(Project))
        Line("        _tenant = DesktopTenantScope.Current;");
    Line("    }");
    Line();
    Line($"    public {contextType}(DbContextOptions<{contextType}> options) : base(options)");
    Line("    {");
    Line("    }");
    if (tenancy)
    {
        Line();
        Line("    private readonly ITenantScope? _tenant;");
        Line();
        Line($"    public {contextType}(DbContextOptions<{contextType}> options, ITenantScope tenant) : base(options) => _tenant = tenant;");
        Line();
        Line("    /// <summary> The tenant the caller works in (TenantTable); null for a caller in no tenant (a platform administrator) and for a context made without the scope, which then sees no tenant-owned row. </summary>");
        Line("    public int? CurrentTenantId => _tenant?.TenantId;");
        Line();
        Line("    /// <summary> Whether the caller is a platform administrator (the administrator role, working in no tenant): the tenant table shows them every tenant. </summary>");
        Line("    public bool IsPlatform => _tenant?.IsPlatform ?? false;");
        if (TenantPlan.HasDesktopSignIn(Project))
        {
            Line();
            Line("    // The app reads the database itself, so the context does what the API does on a write: a new row gets the tenant the person works in, and an update never moves a row to another tenant.");
            Line("    private static readonly Dictionary<Type, string> TenantColumns = new()");
            Line("    {");
            foreach (var (name, column) in tenantOwned.OrderBy(o => o.Key, StringComparer.OrdinalIgnoreCase))
                Line($"        [typeof({name})] = \"{column.CSharpName().TrimStart('@')}\",");
            Line("    };");
            Line();
            Line("    private void StampTenant()");
            Line("    {");
            Line("        if (CurrentTenantId is not int tenant)");
            Line("            return;");
            Line("        foreach (var entry in ChangeTracker.Entries())");
            Line("        {");
            Line("            if (!TenantColumns.TryGetValue(entry.Metadata.ClrType, out string? column))");
            Line("                continue;");
            Line("            if (entry.State == EntityState.Added)");
            Line("                entry.Property(column).CurrentValue = tenant;");
            Line("            else if (entry.State == EntityState.Modified)");
            Line("                entry.Property(column).IsModified = false;");
            Line("        }");
            Line("    }");
        }
        bool desktop = TenantPlan.HasDesktopSignIn(Project);
        if (desktop || people is not null)
        {
            Line();
            if (people is not null)
            {
                string person = people.User.Table.TableName, member = people.Membership.Table.TableName;
                Line("    // A person added inside a tenant belongs to it: the membership row is saved right after the person (the key is known then).");
                Line("    private List<" + person + "> AddedPeople() =>");
                Line("        CurrentTenantId is null ? [] : ChangeTracker.Entries<" + person + ">().Where(e => e.State == EntityState.Added).Select(e => e.Entity).ToList();");
                Line();
                Line("    // A person removed inside a tenant leaves it: the tenant's membership row goes in the same save (a person who belongs to another tenant too is refused by the foreign key).");
                Line("    private IQueryable<" + member + "> LeavingMembers()");
                Line("    {");
                Line("        var leaving = CurrentTenantId is null ? [] : ChangeTracker.Entries<" + person + ">().Where(e => e.State == EntityState.Deleted).Select(e => e.Entity." + people.Key.CSharpName() + ").ToList();");
                Line("        return Set<" + member + ">().IgnoreQueryFilters().Where(m => leaving.Contains(m." + people.Membership.User.CSharpName() + ") && m." + people.Membership.Tenant.CSharpName() + " == CurrentTenantId);");
                Line("    }");
                Line();
                Line("    private bool AttachPeople(List<" + person + "> people)");
                Line("    {");
                Line("        foreach (var person in people)");
                Line("            Set<" + member + ">().Add(new " + member + " { " + people.Membership.User.CSharpName() + " = person." + people.Key.CSharpName() + ", " + people.Membership.Tenant.CSharpName() + " = CurrentTenantId!.Value });");
                Line("        return people.Count > 0;");
                Line("    }");
                Line();
            }
            if (creators)
            {
                string tenantType = tenantTable!.TableName, memberType = creatorMember!.Table.TableName, userType = creatorUser!.Table.TableName;
                string roleAssign = creatorMember.Role is null ? "" : $", {creatorMember.Role.CSharpName()} = {CSharpText.Quote(Project.AuthAdminRole)}";
                Line("    // A tenant added in the app by a platform administrator: they become its first administrator (the person is found by the user name they signed in with).");
                Line("    private List<" + tenantType + "> AddedTenants() =>");
                Line("        IsPlatform ? ChangeTracker.Entries<" + tenantType + ">().Where(e => e.State == EntityState.Added).Select(e => e.Entity).ToList() : [];");
                Line();
                Line("    private IQueryable<int?> CreatorKeys()");
                Line("    {");
                Line("        string name = ((_tenant as DesktopTenantScope)?.UserName ?? \"\").Trim();");
                Line("        return Set<" + userType + ">().IgnoreQueryFilters().AsNoTracking().Where(u => name != \"\" && u." + creatorUser.UserName.CSharpName() + " == name).Select(u => (int?)u." + creatorUser.Table.PrimaryKeyColumns[0].CSharpName() + ");");
                Line("    }");
                Line();
                Line("    private bool AttachCreators(List<" + tenantType + "> tenants, int? person)");
                Line("    {");
                Line("        if (person is null)");
                Line("            return false;");
                Line("        foreach (var tenant in tenants)");
                Line("            Set<" + memberType + ">().Add(new " + memberType + " { " + creatorMember.User.CSharpName() + " = person.Value, " + creatorMember.Tenant.CSharpName() + " = tenant." + tenantKey!.CSharpName() + roleAssign + " });");
                Line("        return tenants.Count > 0;");
                Line("    }");
                Line();
            }
            // the membership rows of the people and of the creators are added together and saved once, after the rows they point to
            string Attached(bool asynchronous)
            {
                var calls = new List<string>();
                if (people is not null)
                    calls.Add("AttachPeople(people)");
                if (creators)
                    calls.Add(asynchronous ? "AttachCreators(tenants, tenants.Count > 0 ? await CreatorKeys().FirstOrDefaultAsync(cancellationToken) : null)" : "AttachCreators(tenants, tenants.Count > 0 ? CreatorKeys().FirstOrDefault() : null)");
                return calls.Count == 1 ? calls[0] : "(" + string.Join(" | ", calls) + ")";
            }
            Line("    public override int SaveChanges(bool acceptAllChangesOnSuccess)");
            Line("    {");
            if (desktop)
                Line("        StampTenant();");
            if (people is not null)
            {
                Line("        RemoveRange(LeavingMembers().ToList());");
                Line("        var people = AddedPeople();");
            }
            if (creators)
                Line("        var tenants = AddedTenants();");
            if (people is not null || creators)
            {
                Line("        int saved = base.SaveChanges(acceptAllChangesOnSuccess);");
                Line("        return " + Attached(false) + " ? saved + base.SaveChanges(acceptAllChangesOnSuccess) : saved;");
            }
            else
                Line("        return base.SaveChanges(acceptAllChangesOnSuccess);");
            Line("    }");
            Line();
            Line("    public override async Task<int> SaveChangesAsync(bool acceptAllChangesOnSuccess, CancellationToken cancellationToken = default)");
            Line("    {");
            if (desktop)
                Line("        StampTenant();");
            if (people is not null)
            {
                Line("        RemoveRange(await LeavingMembers().ToListAsync(cancellationToken));");
                Line("        var people = AddedPeople();");
            }
            if (creators)
                Line("        var tenants = AddedTenants();");
            if (people is not null || creators)
            {
                Line("        int saved = await base.SaveChangesAsync(acceptAllChangesOnSuccess, cancellationToken);");
                Line("        return " + Attached(true) + " ? saved + await base.SaveChangesAsync(acceptAllChangesOnSuccess, cancellationToken) : saved;");
            }
            else
                Line("        return await base.SaveChangesAsync(acceptAllChangesOnSuccess, cancellationToken);");
            Line("    }");
        }
    }
    if (Database.Dialect == SqlDialect.PostgreSql)
    {
        Line();
        Line("    // The columns are \"timestamp\" (no time zone), the counterpart of SQL Server's datetime; Npgsql would otherwise map a DateTime to");
        Line("    // \"timestamp with time zone\" and refuse any DateTime that is not UTC.");
        Line("    protected override void ConfigureConventions(ModelConfigurationBuilder configurationBuilder)");
        Line("    {");
        Line("        configurationBuilder.Properties<DateTime>().HaveColumnType(\"timestamp\");");
        Line("    }");
    }
    if (Database.Dialect == SqlDialect.Sqlite)
    {
        Line();
        Line("    // SQLite stores a decimal as text, a DateTimeOffset and a TimeSpan in forms it can neither order nor compare in SQL (ORDER BY on them fails), so they");
        Line("    // are stored as a double, a binary value and a tick count. A double holds the usual money amounts well enough; change the conversion if you need exact cents.");
        Line("    protected override void ConfigureConventions(ModelConfigurationBuilder configurationBuilder)");
        Line("    {");
        Line("        configurationBuilder.Properties<decimal>().HaveConversion<double>();");
        Line("        configurationBuilder.Properties<decimal?>().HaveConversion<double>();");
        Line("        configurationBuilder.Properties<DateTimeOffset>().HaveConversion<DateTimeOffsetToBinaryConverter>();");
        Line("        configurationBuilder.Properties<DateTimeOffset?>().HaveConversion<DateTimeOffsetToBinaryConverter>();");
        Line("        configurationBuilder.Properties<TimeSpan>().HaveConversion<TimeSpanToTicksConverter>();");
        Line("        configurationBuilder.Properties<TimeSpan?>().HaveConversion<TimeSpanToTicksConverter>();");
        Line("    }");
    }
    var composite = Database.CompositeKeyTables;
    if (Project.EfConfigurations)
    {
        Line();
        Line("    // The keys, columns and indexes of every table are in its <Table>Configuration (CS_EfConfiguration), found in this assembly.");
        Line("    // Extra model configuration of your own goes in OnModelCreatingPartial, in another part of this class, or in another IEntityTypeConfiguration.");
        Line("    protected override void OnModelCreating(ModelBuilder modelBuilder)");
        Line("    {");
        Line($"        modelBuilder.ApplyConfigurationsFromAssembly(typeof({contextType}).Assembly);");
        foreach (string filter in filterLines)
            Line(filter);
        Line("        OnModelCreatingPartial(modelBuilder);");
        Line("    }");
        Line();
        Line("    partial void OnModelCreatingPartial(ModelBuilder modelBuilder);");
    }
    else if (composite.Count > 0 || textColumns.Count > 0 || filterLines.Count > 0)
    {
        Line();
        if (filterLines.Count > 0)
            Line("    // SoftDeleteTables hides a flagged row and TenantTable limits a row to the caller's tenant, in every read; the API's deleted, restore and onboarding routes say IgnoreQueryFilters.");
        if (composite.Count > 0)
            Line("    // A composite primary key cannot be said with an attribute, so the key of each junction table is named here.");
        if (textColumns.Count > 0)
            Line("    // A column of an array, interval, range, geometric or spatial type is text in the entity; its converter (PgText or MySqlSpatial, below) turns the text into what the database stores.");
        Line("    // Extra model configuration of your own goes in OnModelCreatingPartial, in another part of this class.");
        Line("    protected override void OnModelCreating(ModelBuilder modelBuilder)");
        Line("    {");
        foreach (var table in composite)
            Line($"        modelBuilder.Entity<{table.TableName}>().HasKey(e => new {{ {string.Join(", ", table.PrimaryKeyColumns.Select(c => "e." + (c.IsCSharpReservedWordName ? "@" : "") + c.Name))} }});");
        foreach (var (table, column) in textColumns)
            Line($"        modelBuilder.Entity<{table.TableName}>().Property(e => e.{(column.IsCSharpReservedWordName ? "@" : "")}{column.Name}).HasConversion({TextConversion.Of(column)!.Expression}){(TextConversion.Of(column)!.ColumnType is { } columnType ? $".HasColumnType({CSharpText.Quote(columnType)})" : "")};");
        foreach (string filter in filterLines)
            Line(filter);
        Line("        OnModelCreatingPartial(modelBuilder);");
        Line("    }");
        Line();
        Line("    partial void OnModelCreatingPartial(ModelBuilder modelBuilder);");
    }
    Line();
    Line("    /// <summary> The one place the database provider is chosen; the API registration calls it too. </summary>");
    Line("    public static void UseProvider(DbContextOptionsBuilder options, string? connectionString)");
    Line("    {");
    if (Database.Dialect == SqlDialect.MySql)
    {
        Line("        // The password is not in appsettings.json: it comes from the MYSQL_PWD environment variable (the one the mysql client reads too).");
        Line("        var builder = new MySqlConnector.MySqlConnectionStringBuilder(connectionString);");
        Line("        if (string.IsNullOrEmpty(builder.Password))");
        Line("            builder.Password = Environment.GetEnvironmentVariable(\"MYSQL_PWD\") ?? \"\";");
        Line("        // A fixed server version, so the app does not open a connection while it builds the options; raise it if the SQL needs a newer feature.");
        Line($"        options.{provider.UseMethod}(builder.ConnectionString, new MySqlServerVersion(new Version(8, 0, 0)));");
    }
    else
    {
        if (Database.Dialect == SqlDialect.PostgreSql)
            Line("        // The password is not in appsettings.json: Npgsql reads the PGPASSWORD environment variable.");
        Line($"        options.{provider.UseMethod}(connectionString);");
    }
    Line("    }");
    Line();
    Line("    protected override void OnConfiguring(DbContextOptionsBuilder optionsBuilder)");
    Line("    {");
    Line("        if (!optionsBuilder.IsConfigured)");
    Line("        {");
    Line("            IConfigurationRoot configuration = new ConfigurationBuilder()");
    Line("                .SetBasePath(AppContext.BaseDirectory)");
    Line("                .AddJsonFile(\"appsettings.json\")");
    Line("                .Build();");
    Line($"            UseProvider(optionsBuilder, configuration.GetConnectionString(\"{connectionName}\"));");
    Line("        }");
    Line("    }");
    Line("}");
    if (tenancy)
    {
        Line();
        Line("/// <summary> The tenant the caller works in: the claim of their token in the API, the tenant they signed in to in the WinUI3 app. The context reads it to filter every tenant-owned table. Register your own to take the tenant from elsewhere (a host name). </summary>");
        Line("public interface ITenantScope");
        Line("{");
        Line("    int? TenantId { get; }");
        Line();
        Line("    /// <summary> A platform administrator: the administrator role, working in no tenant. They see and create tenants; every other table stays empty for them until they work in a tenant. </summary>");
        Line("    bool IsPlatform => false;");
        Line("}");
        if (TenantPlan.HasDesktopSignIn(Project))
        {
            Line();
            Line("/// <summary> The tenant the person works in the WinUI3 app: one scope for the whole app, which the window sets when someone signs in or switches tenant, so every context the pages make (<c>new " + contextType + "()</c>) reads it. </summary>");
            Line("public sealed class DesktopTenantScope : ITenantScope");
            Line("{");
            Line("    public static DesktopTenantScope Current { get; } = new();");
            Line();
            Line("    public int? TenantId { get; private set; }");
            Line();
            Line("    public bool IsPlatform { get; private set; }");
            Line();
            Line("    /// <summary> The user name the person signed in with. </summary>");
            Line("    public string? UserName { get; private set; }");
            Line();
            Line("    public void Use(int? tenantId, bool isPlatform, string? userName = null)");
            Line("    {");
            Line("        TenantId = tenantId;");
            Line("        IsPlatform = isPlatform;");
            Line("        UserName = userName;");
            Line("    }");
            Line("}");
        }
    }
    if (textColumns.Count > 0)
    {
        Line();
        Line(helpers.Source.ReplaceLineEndings("\n"));
    }
    Write(sb.ToString());
#>
