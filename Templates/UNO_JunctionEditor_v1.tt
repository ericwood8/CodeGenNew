<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // folders). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string viewNamespace = "MyApp.Views";
    string viewModelNamespace = "MyApp.ViewModels";
    string servicesNamespace = "MyApp.Services";   // the junction client (written here) and ApiClients (UNO_Screens)
    // Namespaces the generated files must "using" beyond the ones every file needs.
    string[] usings = { };
    // Folders under the Uno project root (where -o points) the generated files go in.
    string viewsFolder = "Views";
    string viewModelsFolder = "ViewModels";
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    viewNamespace = Project.ViewNamespace ?? viewNamespace;
    viewModelNamespace = Project.ViewModelNamespace ?? viewModelNamespace;
    if (Project.ViewNamespace is not null || Project.ProjectName is not null)
        servicesNamespace = UnoNames.ServicesNamespace(Project);
    usings = Project.Usings ?? usings;
    viewsFolder = Project.ViewsFolder ?? viewsFolder;
    viewModelsFolder = Project.ViewModelsFolder ?? viewModelsFolder;
    // ==========================================================================================

    // ==========================================================================================
    // UNO_JunctionEditor_v1.tt
    // Generates: Services/<Table>JunctionClient.cs, Views/<Table>JunctionEditor.xaml and .xaml.cs, ViewModels/<Table>JunctionEditorViewModel.cs
    // The Uno Platform twin of WinUI3_JunctionEditor: the two-list available/selected shuttle ContentDialog for editing one row's side of a many-to-many junction table, calling the routes
    // API_Junction writes (GET <route>/junction/{anchorId}, POST .../link and .../unlink) through a small client written here. Each move commits at once, so there is no Save. Open it
    // with new <Table>JunctionEditor(api, anchorId) { XamlRoot = XamlRoot } and ShowAsync(), from the page of the anchor table. Needs a table detected as a junction table (TableModel.IsJunctionTable).
    // Full notes: Docs/TemplateNotes/UNO_JunctionEditor_v1.md
    // ==========================================================================================

    if (!Model.IsJunctionTable)
        Error($"UNO_JunctionEditor cannot generate from [{Model.SchemaName}].[{Model.TableName}]: it is not a many-to-many junction table - TableModel.IsJunctionTable is false.");
    if (!Model.HasReferencedDisplayColumns)
        Error("UNO_JunctionEditor needs the target table's display columns; its .tt.config must say NeedsReferencedDisplayColumns=true.");

    var junction = Model.Junction!;   // the anchor and target sides, in Core
    string anchorType = junction.AnchorCs;
    string targetType = junction.TargetCs;
    string anchorRole = junction.AnchorRole;
    string targetRole = junction.TargetRole;
    string stem = Model.TableName;
    var displayColumns = junction.DisplayColumns;
    string DisplayExpr() => string.Join(" + \" \" + ", displayColumns.Select(d => d));
#>
@@@FILE Services/<#= stem #>JunctionClient.cs@@@
using System.Net.Http.Json;

namespace <#= servicesNamespace #>;

/// <summary> One row of GET <#= BlazorNames.ApiRoute(Model.TableName) #>/junction/{anchorId}: the <#= targetRole #> side of the association, and whether it is linked to the <#= anchorRole #> being edited. </summary>
public class <#= stem #>JunctionItem
{
<#
    foreach (string d in displayColumns)
    {
#>
    public string? <#= d #> { get; set; }
<#
    }
#>
    public <#= targetType #> TargetId { get; set; }
    public bool IsSelected { get; set; }

    public string DisplayText => <#= displayColumns.Count > 0 ? DisplayExpr() : "TargetId.ToString()" #>;
}

public record <#= stem #>JunctionLinkRequest(<#= anchorType #> AnchorId, <#= targetType #> TargetId);

public class <#= stem #>JunctionClient(HttpClient http)
{
    private const string Url = "<#= BlazorNames.ApiRoute(Model.TableName) #>/junction";

    public async Task<List<<#= stem #>JunctionItem>> GetAsync(<#= anchorType #> anchorId) => await (await http.GetAsync($"{Url}/{anchorId}")).ReadAsync<List<<#= stem #>JunctionItem>>();

    public async Task LinkAsync(<#= anchorType #> anchorId, <#= targetType #> targetId) => await (await http.PostAsJsonAsync($"{Url}/link", new <#= stem #>JunctionLinkRequest(anchorId, targetId))).EnsureSuccessAsync();

    public async Task UnlinkAsync(<#= anchorType #> anchorId, <#= targetType #> targetId) => await (await http.PostAsJsonAsync($"{Url}/unlink", new <#= stem #>JunctionLinkRequest(anchorId, targetId))).EnsureSuccessAsync();
}
@@@FILE <#= viewsFolder #>/<#= stem #>JunctionEditor.xaml@@@
<ContentDialog
    x:Class="<#= viewNamespace #>.<#= stem #>JunctionEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="<#= targetRole #> for this <#= anchorRole #>"
    PrimaryButtonText="Close"
    DefaultButton="Primary">

    <!-- Two side-by-side lists with <</</>/>> buttons (a "shuttle control" / "transfer list"): move rows between them to edit which <#= targetRole #> rows are linked to
         this <#= anchorRole #> row. Each click commits at once through the API, so there is no separate Save. -->
    <StackPanel Spacing="8">
        <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />
        <Grid ColumnSpacing="12" MinWidth="640">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Available" FontWeight="SemiBold" />
                <ListView x:Name="AvailableList" ItemsSource="{x:Bind ViewModel.Available}"
                          SelectionMode="Extended" Height="360"
                          DisplayMemberPath="DisplayText" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                <Button Content="&gt;&gt;" Click="OnAddAllClick" ToolTipService.ToolTip="Add all" HorizontalAlignment="Stretch" />
                <Button Content="&gt;" Click="OnAddClick" ToolTipService.ToolTip="Add selected" HorizontalAlignment="Stretch" />
                <Button Content="&lt;" Click="OnRemoveClick" ToolTipService.ToolTip="Remove selected" HorizontalAlignment="Stretch" />
                <Button Content="&lt;&lt;" Click="OnRemoveAllClick" ToolTipService.ToolTip="Remove all" HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Selected" FontWeight="SemiBold" />
                <ListView x:Name="SelectedList" ItemsSource="{x:Bind ViewModel.Selected}"
                          SelectionMode="Extended" Height="360"
                          DisplayMemberPath="DisplayText" />
            </StackPanel>
        </Grid>
    </StackPanel>
</ContentDialog>
@@@FILE <#= viewsFolder #>/<#= stem #>JunctionEditor.xaml.cs@@@
using System.Linq;
using <#= viewModelNamespace #>;
using <#= servicesNamespace #>;
using Microsoft.UI.Xaml.Controls;
<#
    foreach (string u in usings)
    {
#>
using <#= u #>;
<#
    }
#>

namespace <#= viewNamespace #>;

public sealed partial class <#= stem #>JunctionEditor : ContentDialog
{
    public <#= stem #>JunctionEditorViewModel ViewModel { get; }

    /// <param name="anchorId"> The key of the <#= anchorRole #> row whose <#= targetRole #> links are edited. </param>
    public <#= stem #>JunctionEditor(ApiClients api, <#= anchorType #> anchorId)
    {
        ViewModel = new <#= stem #>JunctionEditorViewModel(api.<#= stem #>Junction, anchorId);
        InitializeComponent();
        Loaded += async (_, _) => await ViewModel.LoadAsync();
    }

    private async void OnAddClick(object sender, RoutedEventArgs e) =>
        await ViewModel.LinkAsync(AvailableList.SelectedItems.Cast<<#= stem #>JunctionItem>().ToList());

    private async void OnRemoveClick(object sender, RoutedEventArgs e) =>
        await ViewModel.UnlinkAsync(SelectedList.SelectedItems.Cast<<#= stem #>JunctionItem>().ToList());

    private async void OnAddAllClick(object sender, RoutedEventArgs e) =>
        await ViewModel.LinkAsync(ViewModel.Available.ToList());

    private async void OnRemoveAllClick(object sender, RoutedEventArgs e) =>
        await ViewModel.UnlinkAsync(ViewModel.Selected.ToList());
}
@@@FILE <#= viewModelsFolder #>/<#= stem #>JunctionEditorViewModel.cs@@@
using System.Collections.Generic;
using System.Collections.ObjectModel;
using System.Linq;
using System.Threading.Tasks;
using <#= servicesNamespace #>;
using CommunityToolkit.Mvvm.ComponentModel;
<#
    foreach (string u in usings)
    {
#>
using <#= u #>;
<#
    }
#>

namespace <#= viewModelNamespace #>;

public partial class <#= stem #>JunctionEditorViewModel : ObservableObject
{
    private readonly <#= stem #>JunctionClient _client;
    private readonly <#= anchorType #> _anchorId;

    public ObservableCollection<<#= stem #>JunctionItem> Available { get; } = [];
    public ObservableCollection<<#= stem #>JunctionItem> Selected { get; } = [];

    [NotifyPropertyChangedFor(nameof(HasError))]
    [ObservableProperty]
    private string? _errorMessage;
    public bool HasError => ErrorMessage is not null;

    public <#= stem #>JunctionEditorViewModel(<#= stem #>JunctionClient client, <#= anchorType #> anchorId)
    {
        _client = client;
        _anchorId = anchorId;
    }

    public async Task LoadAsync()
    {
        ErrorMessage = null;
        Available.Clear();
        Selected.Clear();
        try
        {
            foreach (var row in await _client.GetAsync(_anchorId))
                (row.IsSelected ? Selected : Available).Add(row);
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Explain("loading");
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "The server could not be reached.";
        }
    }

    public async Task LinkAsync(IReadOnlyList<<#= stem #>JunctionItem> items)
    {
        foreach (var item in items)
        {
            if (!await TryAsync(() => _client.LinkAsync(_anchorId, item.TargetId)))
                return;
            if (Available.Remove(item))
                Selected.Add(item);
        }
    }

    public async Task UnlinkAsync(IReadOnlyList<<#= stem #>JunctionItem> items)
    {
        foreach (var item in items)
        {
            if (!await TryAsync(() => _client.UnlinkAsync(_anchorId, item.TargetId)))
                return;
            if (Selected.Remove(item))
                Available.Add(item);
        }
    }

    // A refused or failed call stops the move and says so in the dialog; the lists keep what is stored.
    private async Task<bool> TryAsync(Func<Task> call)
    {
        ErrorMessage = null;
        try
        {
            await call();
            return true;
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Explain("saving");
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "The server could not be reached.";
        }
        return false;
    }
}
