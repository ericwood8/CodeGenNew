    {
#>

    private IHttpContextAccessor? _http;

    /// <summary> The signed-in caller. </summary>
    protected System.Security.Claims.ClaimsPrincipal Caller => _http!.HttpContext!.User;

    /// <summary> The roles that may create, change and delete rows (the project's WriteRoles and TableWriteRoles, the administrator role among them); empty: any signed-in person. </summary>
    protected virtual IReadOnlyList<string> WriteRoles => [];

    /// <summary> The roles that may read rows (the project's ReadRoles and TableReadRoles, the administrator role among them); empty: any signed-in person. The lookup is not covered: drop-downs of other screens read it. </summary>
    protected virtual IReadOnlyList<string> ReadRoles => [];

    /// <summary> Runs after a create's or update's body is a row and before it is saved: <paramref name="row"/> may be corrected here (a column no caller may set takes its stored value) and a result refuses the write. <paramref name="isNew"/> is true for a create. The default accepts. </summary>
    protected virtual Task<IResult?> BeforeSaveAsync(<#= contextType #> context, TEntity row, bool isNew) => Task.FromResult<IResult?>(null);

    /// <summary> Runs before a row is deleted; a result refuses the delete. The default accepts. </summary>
    protected virtual Task<IResult?> BeforeDeleteAsync(<#= contextType #> context, int id) => Task.FromResult<IResult?>(null);
<#
    }
#>

    public override void Register(WebApplication app)
    {
        BreakIntoStrings(out string singular, out string plural, out string apiSubDir);
        _route = _apiSubDir;
<#= auth("        _http = app.Services.GetRequiredService<IHttpContextAccessor>();\n") #>

        app.MapGet(apiSubDir, ([FromServices] <#= contextType #> context) => GetAllAsync(context))
        .WithName($"Get{plural}")
        .WithOpenApi()
<#= reads("        ") #>        .Produces<IEnumerable<TEntity>>()
        .ProducesProblem(<#= HttpStatus.InternalServerError #>);

        app.MapGet(apiSubDir + "/active", ([FromServices] <#= contextType #> context) => GetAllActiveAsync(context))
        .WithName($"GetActive{plural}")
        .WithOpenApi()
<#= reads("        ") #>        .Produces<IEnumerable<TEntity>>()
        .ProducesProblem(<#= HttpStatus.InternalServerError #>);

        app.MapGet(apiSubDir + "/lookup", ([FromServices] <#= contextType #> context, [FromQuery] string? search, [FromQuery] string? ids, [FromQuery] int? take) => LookupAsync(context, search, ids, take))
        .WithName($"Get{plural}Lookup")
        .WithOpenApi()
        .Produces<IEnumerable<LookupItem>>()
        .ProducesProblem(<#= HttpStatus.InternalServerError #>);

        app.MapGet(apiSubDir + "/{id:int}", ([FromServices] <#= contextType #> context, int id) => GetByIdAsync(context, id))
        .WithName($"Get{singular}ById")
        .WithOpenApi()
<#= reads("        ") #>        .Produces<TEntity>()
        .ProducesProblem(<#= HttpStatus.NotFound #>)
        .ProducesProblem(<#= HttpStatus.InternalServerError #>);

<#
    if (children)
    {
#>
        (EditableChildren.Count > 0
            ? app.MapPost(apiSubDir, ([FromServices] <#= contextType #> context, HttpRequest request) => CreateWithChildrenAsync(context, request))
            : app.MapPost(apiSubDir, ([FromServices] <#= contextType #> context, [FromBody] TEntity newRow) => CreateAsync(context, newRow)))
<#
    }
    else
    {
#>
        app.MapPost(apiSubDir, ([FromServices] <#= contextType #> context, [FromBody] TEntity newRow) => CreateAsync(context, newRow))
<#
    }
#>
        .WithName($"Create{singular}")
        .WithOpenApi()
<#= roles("        ") #><#= validation("        .AddEndpointFilter<ValidationFilter<TEntity>>()\n") #>        .ProducesProblem(<#= HttpStatus.BadRequest #>)
        .ProducesProblem(<#= HttpStatus.Conflict #>)
        .ProducesProblem(<#= HttpStatus.InternalServerError #>);

<#
    if (children)
    {
#>
        (EditableChildren.Count > 0
            ? app.MapPut(apiSubDir + "/{id:int}", ([FromServices] <#= contextType #> context, int id, HttpRequest request) => UpdateWithChildrenAsync(context, id, request))
            : app.MapPut(apiSubDir + "/{id:int}", ([FromServices] <#= contextType #> context, int id, [FromBody] TEntity updatedRow) => UpdateAsync(context, id, updatedRow)))
<#
    }
    else
    {
#>
        app.MapPut(apiSubDir + "/{id:int}", ([FromServices] <#= contextType #> context, int id, [FromBody] TEntity updatedRow) => UpdateAsync(context, id, updatedRow))
<#
    }
#>
        .WithName($"Update{singular}")
        .WithOpenApi()
<#= roles("        ") #><#= validation("        .AddEndpointFilter<ValidationFilter<TEntity>>()\n") #>        .ProducesProblem(<#= HttpStatus.BadRequest #>)
        .ProducesProblem(<#= HttpStatus.NotFound #>)
        .ProducesProblem(<#= HttpStatus.Conflict #>)
        .ProducesProblem(<#= HttpStatus.InternalServerError #>);

        app.MapDelete(apiSubDir + "/{id:int}", ([FromServices] <#= contextType #> context, int id) => DeleteAsync(context, id))
        .WithName($"Delete{singular}")
        .WithOpenApi()
<#= roles("        ") #>        .ProducesProblem(<#= HttpStatus.BadRequest #>)
        .ProducesProblem(<#= HttpStatus.NotFound #>)
        .ProducesProblem(<#= HttpStatus.InternalServerError #>);

        // Find by name: a number in that place is an id (the int constraint wins), anything else is the start of a name; "active" is the active list's
        app.MapGet(apiSubDir + "/{name}", ([FromServices] <#= contextType #> context, string name) => FindByNameAsync(context, name))
        .WithName($"Get{plural}ByName")
        .WithOpenApi()
<#= reads("        ") #>        .Produces<IEnumerable<TEntity>>()
        .ProducesProblem(<#= HttpStatus.InternalServerError #>);
