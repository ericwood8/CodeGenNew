<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // API_EssentialCrudApi_v1.tt
    // Generates: Apis/CrudApi.cs   (no table, no database: an essentials group)
    // CrudApi<TEntity, TRepo>, the base of the per-table API classes API_Crud writes: it registers the five standard endpoints (list or one page of the list, get by id, create, update, delete,
    // clone for a table that can be cloned, and find by name for a table with a Name) and holds the one set of answers (201 with a Location, 400 when the id in the route and in the body disagree, 404, 400 for a row that is
    // in use). A generated class names its repository, its key and the column that lists newest first, and nothing else. NameActiveCrudApi<TEntity, TRepo> is the same for a table
    // with a Name and an IsActive column (its repository is a NameActiveRepo): the list, the active list, find by name, and the 409 problem for a duplicate name. Needs BaseApi (API_EssentialApiBase), the generic repository
    // (CS_EssentialBase), the NameActive group for NameActiveCrudApi and, when ApiValidation is on, ValidationFilter (API_EssentialProgram).
    // With Dtos=true, CrudApi gets an input and an output type (CrudApi<TEntity, TRepo, TInput, TOutput> for an int key): the create and update bodies bind the input, an update copies it onto the row that is
    // there (so the columns it leaves out keep their values), and every answer is the output type. CrudApi<TEntity, TRepo> keeps taking and answering the entity.
    // Full notes: Docs/TemplateNotes/API_EssentialCrudApi_v1.md
    // ==========================================================================================
    string projectName = Project.ProjectName ?? "MyApp";
    string apiNamespace = Project.ApiNamespace ?? projectName + ".Api.Apis";
    string entityNamespace = Project.EntityNamespace ?? projectName + ".Api.Entities";
    string repoNamespace = Project.RepoNamespace ?? projectName + ".Api.Repositories";
    string contextNamespace = Project.ContextNamespace ?? projectName + ".Api.Data";
    string contextType = Project.ContextName ?? "AppContext";
    string baseNameActiveEntity = Project.BaseNameActiveEntity ?? "BaseNameActiveEntity";
    string validation(string when) => Project.ApiValidation ? when : "";
    string auth(string when) => Project.ApiAuth ? when : "";
    // WriteRoles: the write routes refuse a role the table's WriteRoles does not list (RoleGate, written by the Jwt group)
    string roles(string indent) => Project.ApiAuth ? indent + ".RequireWriteRoles(WriteRoles)\n" : "";
    // ReadRoles: the list, one row, find by name and the active list refuse a role the table's ReadRoles does not list (the lookup stays open for the drop-downs of other screens)
    string reads(string indent) => Project.ApiAuth ? indent + ".RequireReadRoles(ReadRoles)\n" : "";
    // EditableChildren: a form saves the rows of some child tables together with the parent (ChildRows); written only when the project lists a child
    bool children = Project.EditableChildren.Length > 0;
    // Dtos: a table's API can take an input type and answer an output type (CS_DtoInput, CS_Dto) instead of its entity; the entity-typed classes below stay for a table that does not
    bool dtos = Project.Dtos;
    string input = dtos ? "TInput" : "TEntity";
    string output = dtos ? "TOutput" : "TEntity";
    string map(string row) => dtos ? $"ToOutput({row})" : row;
    string mapAll(string rows) => dtos ? $"{rows}.Select(ToOutput).ToList()" : rows;
    // the create and update handlers receive the entity's validator themselves, because the endpoint filter only sees a body of the entity type
    string validatorParameter = dtos && Project.ApiValidation ? ", [FromServices] IValidator<TEntity>? validator" : "";
    string validatorArgument = dtos && Project.ApiValidation ? ", validator" : "";
    // ListProtocol=Search: the list route takes the parameter names of the project's list protocol and answers { data, count }; the table's class says what the search box matches and what can be sorted
    bool listSearch = Project.ListSearchProtocol;
    int firstPage = Project.PageBase;
#>
@@@FILE Apis/CrudApi.cs@@@
