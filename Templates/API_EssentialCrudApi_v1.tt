    /// <summary> The lookup list of the rows: all of them, or with <paramref name="ids"/> the rows with those keys, or with <paramref name="search"/> (or <paramref name="take"/>) the first few whose text contains the search. </summary>
    private async Task<IResult> NarrowedLookupAsync(IQueryable<TEntity> rows, string? search, string? ids, int? take)
    {
        bool byIds = !string.IsNullOrWhiteSpace(ids);
        bool bySearch = !byIds && !string.IsNullOrWhiteSpace(search);
        if (bySearch && LookupText is null)
            return Results.Problem(statusCode: <#= HttpStatus.BadRequest #>, type: "<#= ProblemTypes.InvalidBody #>", title: "Cannot search", detail: "This lookup list cannot be searched.");

        if (byIds)
        {
            var key = Key;
            var inList = Expression.Call(typeof(Enumerable), nameof(Enumerable.Contains), [typeof(TKey)], Expression.Constant(LookupFilter.ParseKeys<TKey>(ids!)), key.Body);
            rows = rows.Where(Expression.Lambda<Func<TEntity, bool>>(inList, key.Parameters));
        }
        else if (bySearch)
        {
            var text = LookupText!;
            var lower = Expression.Call(text.Body, typeof(string).GetMethod(nameof(string.ToLower), Type.EmptyTypes)!);
            var contains = Expression.Call(lower, typeof(string).GetMethod(nameof(string.Contains), [typeof(string)])!, Expression.Constant(LookupFilter.Text(search!)));
            rows = rows.Where(Expression.Lambda<Func<TEntity, bool>>(contains, text.Parameters));
        }

        var items = LookupQuery(rows);
        if (!byIds && (bySearch || take is not null))
            items = items.Take(LookupFilter.Take(take));
        return Results.Ok(await items.ToListAsync());
    }

    private async Task<IResult> CloneRowAsync(<#= contextType #> context, TKey id)
    {
<#= auth("        if (await RefuseOtherOwnersAsync(context, id) is { } refused)\n            return refused;\n\n") #>        var repo = NewRepo(context);
        if (!await repo.ExistsAsync(id))
            return Results.NotFound(); // 404 error if there is no row to copy
        var newId = await CloneAsync(repo, id);
<#= auth("        if (await AfterCloneAsync(context, newId) is { } refusedClone)\n            return refusedClone;\n") #>        var copy = await repo.GetByIdAsync(newId);
        return Results.Created($"/api{_route}/{newId}", <#= dtos ? "copy is null ? null : ToOutput(copy)" : "copy" #>);
    }
