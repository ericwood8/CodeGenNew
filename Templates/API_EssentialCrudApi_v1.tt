    private async Task<IResult> GetAllAsync(<#= contextType #> context) => Results.Ok(await NewRepo(context).GetAll());

    private async Task<IResult> GetAllActiveAsync(<#= contextType #> context) => Results.Ok(await NewRepo(context).GetAllActive());

    /// <summary> Every row by name as { id, name, isActive }: only the key, the name and the flag are read; <see cref="LookupFilter"/> narrows it for a type-ahead. </summary>
    private async Task<IResult> LookupAsync(<#= contextType #> context, string? search, string? ids, int? take)
    {
        string keyName = context.Model.FindEntityType(typeof(TEntity))!.FindPrimaryKey()!.Properties[0].Name;
        IQueryable<TEntity> rows = context.Set<TEntity>().AsNoTracking();
        bool byIds = !string.IsNullOrWhiteSpace(ids);
        bool bySearch = !byIds && !string.IsNullOrWhiteSpace(search);
        if (byIds)
        {
            var keys = LookupFilter.ParseKeys<int>(ids!);
            rows = rows.Where(c => keys.Contains(EF.Property<int>(c, keyName)));
        }
        else if (bySearch)
        {
            string text = LookupFilter.Text(search!);
            rows = rows.Where(c => c.Name.ToLower().Contains(text));
        }

        var items = rows.OrderBy(c => c.Name).Select(c => new LookupItem(EF.Property<int>(c, keyName), c.Name, c.IsActive));
        return Results.Ok(await (!byIds && (bySearch || take is not null) ? items.Take(LookupFilter.Take(take)) : items).ToListAsync());
    }

    private async Task<IResult> GetByIdAsync(<#= contextType #> context, int id)
    {
        var row = await NewRepo(context).GetByIdAsync(id);
        return row != null ? Results.Ok(row) : Results.NotFound();
    }

    private async Task<IResult> FindByNameAsync(<#= contextType #> context, string name) => Results.Ok(await NewRepo(context).GetByName(name));

<#
    if (children)
    {
#>
    /// <summary> The child lists the project edits with the row (<c>ChildRows</c>); a create or update whose body holds a list saves it in the same transaction. </summary>
    protected virtual IReadOnlyList<ChildRows<int>> EditableChildren => [];

    private async Task<IResult> CreateWithChildrenAsync(<#= contextType #> context, HttpRequest request)
    {
        var (row, body, problem) = await ChildRowsSupport.ReadAsync<TEntity>(request);
        return problem ?? await CreateAsync(context, row!, body);
    }

    private async Task<IResult> UpdateWithChildrenAsync(<#= contextType #> context, int id, HttpRequest request)
    {
        var (row, body, problem) = await ChildRowsSupport.ReadAsync<TEntity>(request);
        return problem ?? await UpdateAsync(context, id, row!, body);
    }

<#
    }
#>
    private async Task<IResult> CreateAsync(<#= contextType #> context, TEntity newRow<#= children ? ", ChildBody? children = null" : "" #>)
    {
        if (string.IsNullOrWhiteSpace(newRow.Name))
            return Results.Problem(statusCode: <#= HttpStatus.BadRequest #>, type: "<#= ProblemTypes.NameRequired #>", title: "Name is required", detail: "The name cannot be empty.");

<#= auth("        if (await BeforeSaveAsync(context, newRow, true) is { } refusedSave)\n            return refusedSave;\n\n") #><#
    if (children)
    {
#>
        await using var transaction = children is null ? null : await context.Database.BeginTransactionAsync();
        if (!await NewRepo(context).AddAsync(newRow))
            return DuplicateName(newRow.Name);
        if (children is not null)
        {
            if (await ChildRowsSupport.SaveAsync(context, EditableChildren, KeyOf(newRow), children) is { } refusedLists)
                return refusedLists;
            await transaction!.CommitAsync();
        }
<#
    }
    else
    {
#>
        if (!await NewRepo(context).AddAsync(newRow))
            return DuplicateName(newRow.Name);
<#
    }
#>
        return Results.Created($"/api{_route}/{KeyOf(newRow)}", newRow);
    }

    private async Task<IResult> UpdateAsync(<#= contextType #> context, int id, TEntity updatedRow<#= children ? ", ChildBody? children = null" : "" #>)
    {
        if (KeyOf(updatedRow) != id)
            return Results.Problem(statusCode: <#= HttpStatus.BadRequest #>, type: "<#= ProblemTypes.InvalidId #>", title: "Invalid id", detail: "The id in the route and the id in the body disagree.");
        if (string.IsNullOrWhiteSpace(updatedRow.Name))
            return Results.Problem(statusCode: <#= HttpStatus.BadRequest #>, type: "<#= ProblemTypes.NameRequired #>", title: "Name is required", detail: "The name cannot be empty.");

        var repo = NewRepo(context);
        if (!await repo.ExistsAsync(id))
            return Results.NotFound();
<#= auth("        if (await BeforeSaveAsync(context, updatedRow, false) is { } refusedSave)\n            return refusedSave;\n") #><#
    if (children)
    {
#>
        await using var transaction = children is null ? null : await context.Database.BeginTransactionAsync();
        var saved = await repo.UpdateAsync(id, updatedRow);
        if (saved is null)
            return DuplicateName(updatedRow.Name); // null: another active row has that name
        if (children is not null)
        {
            if (await ChildRowsSupport.SaveAsync(context, EditableChildren, id, children) is { } refusedLists)
                return refusedLists;
            await transaction!.CommitAsync();
        }
        return Results.Ok(saved);
<#
    }
    else
    {
#>
        var saved = await repo.UpdateAsync(id, updatedRow);
        return saved is null ? DuplicateName(updatedRow.Name) : Results.Ok(saved); // null: another active row has that name
<#
    }
#>
    }

    private async Task<IResult> DeleteAsync(<#= contextType #> context, int id)
    {
<#= auth("        if (await BeforeDeleteAsync(context, id) is { } refusedDelete)\n            return refusedDelete;\n\n") #>        int result = await NewRepo(context).DeleteAsync(typeof(TEntity).Name, id);
        return result switch
        {
            0 => Results.Ok(),
            -1 => Results.NotFound(),
            _ => Results.Problem(statusCode: <#= HttpStatus.BadRequest #>, type: "<#= ProblemTypes.InUse #>", title: "In use", detail: "It cannot be deleted because it is in use.")
        };
    }

    private static IResult DuplicateName(string name) =>
        Results.Problem(statusCode: <#= HttpStatus.Conflict #>, type: "<#= ProblemTypes.DuplicateName #>", title: "Duplicate name", detail: $"An active row named '{name.Trim()}' already exists.");
}
