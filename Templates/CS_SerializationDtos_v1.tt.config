# Restriction checkboxes for CS_SerializationDtos_v1.tt (see Docs/Reference.md section 3).
# The three contracts need no key: a table without one has no XML attribute.
Requires=
# Name the file like the class: Customer -> CustomerSerializationDtos.cs
OutputName={Table}SerializationDtos.cs
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso.
Stacks=Api
PlanTables=Dto
OutputFolder=Dtos
InPlan=false
