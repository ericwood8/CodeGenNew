<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project. A project settings file (ApiNamespace, ContextName, or ProjectName) overrides them
    // ==========================================================================================
    string apiNamespace = Project.ApiNamespace ?? "MyApp.ApiService.Apis";
    string contextType = Project.ContextName ?? "MyAppContext";

    // ==========================================================================================
    // API_OData_v1.tt
    // Generates: OData.cs   (whole-database; the path is written by the template)
    // The tables ODataPlan selects (OData=true, ODataTables) served as OData v4 under /odata, next to the REST routes, which stay: GET /odata/<set> takes $filter, $orderby, $top, $skip,
    // $count, $select and $expand straight from the URL and reads the context, not the repositories; GET /odata/<set>/{key} (and /odata/<set>(key)), POST, PUT, PATCH and DELETE
    // write, except for a table in LogTables (an insert-only ledger), which has the two reads only (a write answers 405). The limits are ODataMaxTop, ODataPageSize and ODataExpandDepth; a bad query answers 400 problem details. A table whose REST routes enforce a rule these routes do not
    // yet apply (owner scope, change gates, guarded columns, the user table, DTOs) is left out and named in a comment below. The generated API project needs the Microsoft.AspNetCore.OData
    // package (the Program essentials write the reference when OData=true). Program.cs calls AddGeneratedOData() and app.MapODataEndpoints(). Full notes: Docs/TemplateNotes/API_OData_v1.md
    // ==========================================================================================

    var selection = ODataPlan.For(Database, Project);
    var tables = selection.Tables;
    if (tables.Count == 0)
        Error("API_OData found no table to serve: " + (selection.Refusals.Count == 0
            ? "none has an API of its own (a single int, uniqueidentifier or text key, not an enum or a name/active table)."
            : string.Join("; ", selection.Refusals.Select(r => r.Table + " " + r.Reason)) + "."));
    bool validate = Project.ApiValidation;
    // with ApiAuth a table whose rows belong to a person is scoped (OwnedTable: its own owner column, or through its parent) and a table with change gates or guarded columns runs them before a row is saved
    bool auth = Project.ApiAuth;
    // WriteRoles: the write routes of a table refuse a role its rules do not list (RoleGate, written by the Jwt group)
    string roleGate = auth ? ".RequireWriteRoles(rules.WriteRoles)" : "";
    // ReadRoles: the list and the read by key refuse a role the table's rules do not list
    string readGate = auth ? ".RequireReadRoles(rules.ReadRoles)" : "";
    // the list route is wrapped by the group's query filter, which cannot pass a problem result on: its handler refuses with an exception the OData middleware answers
    string listGate = auth ? "            if (!RoleGate.Allows(http.User, rules.ReadRoles))" + ((char)10) + "                throw new ODataRoleRefusedException();" + ((char)10) : "";
    var scopedTables = auth ? tables.Where(t => ODataPlan.IsScoped(t, Project)).ToList() : [];
    // a name/active table (a Name and an IsActive column) keeps the REST routes' rules: the name is required and trimmed and no two active rows share it
    var ruleTables = tables.Where(t => t.IsNameActiveTable || (auth && (ODataPlan.IsScoped(t, Project) || GatePlan.HasRules(Project, t) || WriteRolePlan.For(Project, t).Count > 0 || WriteRolePlan.ReadFor(Project, t).Count > 0))).ToList();

    string Names(IEnumerable<string> items) => string.Join(", ", items.Select(i => "\"" + i + "\""));

    // properties a PATCH may not change: the key, identity, computed and version columns
    IEnumerable<string> ReadOnlyProperties(TableModel table) =>
        table.Columns.Where(c => c.IsPrimaryKey || c.IsIdentity || c.IsComputed || c.IsRowVersionColumn).Select(c => c.CSharpName());
#>
