/// <summary> Generated by API_OData: the tables served as OData v4 under /odata (the REST routes under /api stay). </summary>
public static partial class ODataEndpoints
{
    /// <summary> Sets the columns no caller may set (who and when created or changed) on a row before it is saved; the generated code sets none. Implement it in another part of this class (a partial method with a body in your own file). </summary>
    static partial void Stamp<T>(DbContext context, T row, bool isNew) where T : class;

    private const int MaxTop = <#= Project.ODataMaxTop #>;
    private const int PageSize = <#= Project.ODataPageSize #>;
    private const int ExpandDepth = <#= Project.ODataExpandDepth #>;

    public static IServiceCollection AddGeneratedOData(this IServiceCollection services) =>
        services.AddOData(options => options.Select().Filter().OrderBy().Count().Expand().SetMaxTop(MaxTop).SetTimeZoneInfo(TimeZoneInfo.Utc));

    /// <summary> The model: one entity set per served table, named like its REST route, with the property names the JSON of the REST routes uses. A navigation to a table that is not served is left out. </summary>
    public static IEdmModel Model { get; } = BuildModel();

    private static IEdmModel BuildModel()
    {
        var builder = new ODataConventionModelBuilder();
<#
    foreach (var t in tables)
    {
        string entity = t.TableName;
        string key = t.PrimaryKeyColumns[0].CSharpName();
#>
        builder.EntityType<<#= entity #>>().HasKey(e => e.<#= key #>);
<#
        foreach (var c in t.Columns.Where(c => c.CSharpBase() == "object"))
        {
#>
        builder.EntityType<<#= entity #>>().Ignore(e => e.<#= c.CSharpName() #>);
<#
        }
        foreach (var c in t.Columns.Where(c => c.SqlType == SqlDbType.Date))
        {
#>
        builder.EntityType<<#= entity #>>().Property(e => e.<#= c.CSharpName() #>).AsDate();
<#
        }
#>
        builder.EntitySet<<#= entity #>>("<#= ODataNames.SetName(t.TableName) #>");
<#
    }
#>

        var served = new HashSet<Type> { <#= string.Join(", ", tables.Select(t => "typeof(" + t.TableName + ")")) #> };
        // no navigation leads into a table whose rows belong to a person: an $expand or a $filter through it would read the rows of every owner
        var scoped = new HashSet<Type> { <#= string.Join(", ", scopedTables.Select(t => "typeof(" + t.TableName + ")")) #> };
        builder.OnModelCreating = b =>
        {
            foreach (var type in b.StructuralTypes.ToList())
                foreach (var navigation in type.Properties.OfType<NavigationPropertyConfiguration>().ToList())
                    if (!served.Contains(navigation.RelatedClrType) || scoped.Contains(navigation.RelatedClrType))
                    {
                        // an entity set may already be bound through the navigation: take the binding away with it
                        foreach (var source in b.NavigationSources.ToList())
                            source.RemoveBinding(navigation);
                        type.RemoveProperty(navigation.PropertyInfo);
                    }
            foreach (var type in b.StructuralTypes.ToList())
                if (!served.Contains(type.ClrType))
                    b.RemoveStructuralType(type.ClrType);
            foreach (var type in b.StructuralTypes)
                foreach (var property in type.Properties)
                    property.Name = JsonNamingPolicy.CamelCase.ConvertName(property.PropertyInfo.Name);
        };
        return builder.GetEdmModel();
    }

    public static void MapODataEndpoints(this WebApplication app)
    {
        // a query the package refuses (an unknown property, $top over the limit, $expand too deep) is the caller's mistake, not a server failure
        app.Use(async (context, next) =>
        {
            try
            {
                await next();
            }
<#
    if (auth)
    {
#>
            catch (ODataRoleRefusedException) when (!context.Response.HasStarted)
            {
                await RoleGate.ReadRefusal().ExecuteAsync(context);
            }
<#
    }
#>
            catch (ODataException error) when (!context.Response.HasStarted && context.Request.Path.StartsWithSegments("<#= ODataNames.Prefix #>"))
            {
                await Results.Problem(statusCode: <#= HttpStatus.BadRequest #>, type: "<#= ProblemTypes.InvalidRequest #>", title: "Invalid OData request", detail: error.Message).ExecuteAsync(context);
            }
        });

        var odata = app.MapGroup("<#= ODataNames.Prefix #>")
            .WithODataResult()
            .WithODataModel(Model)
            .WithODataBaseAddressFactory(context => new Uri($"{context.Request.Scheme}://{context.Request.Host}<#= ODataNames.Prefix #>/"));
        var lists = odata.MapGroup("").AddODataQueryEndpointFilter(
            validation => { validation.MaxTop = MaxTop; validation.MaxExpansionDepth = ExpandDepth; validation.MaxNodeCount = 100; validation.AllowedQueryOptions = AllowedQueryOptions.Supported & ~AllowedQueryOptions.Apply; },
            query => { query.PageSize = PageSize; });

<#
    foreach (var t in tables)
    {
        var keyType = KeyType.Of(t)!;
        string set = ODataNames.SetName(t.TableName);
        string key = t.PrimaryKeyColumns[0].CSharpName();
#>
        MapSet<<#= t.TableName #>, <#= keyType.CSharp #>, <#= contextType #>>(odata, lists, "<#= set #>", "<#= key #>", "<#= keyType.RouteConstraint #>", <#= keyType.Kind == KeyKind.Text ? "true" : "false" #>, [<#= Names(ReadOnlyProperties(t)) #>], <#= ruleTables.Contains(t) ? "new " + t.TableName + "ODataRules()" : "new ODataRules<" + t.TableName + ", " + contextType + ">()" #><#= LogTablePlan.IsListed(t, Project) ? ", true" : "" #>);
<#
    }
#>

        app.MapODataServiceDocument("<#= ODataNames.Prefix #>/$document", Model);
        app.MapODataMetadata("<#= ODataNames.Prefix #>/$metadata", Model);
    }

    private static void MapSet<T, TKey, TContext>(RouteGroupBuilder odata, RouteGroupBuilder lists, string set, string keyProperty, string constraint, bool quoted, string[] readOnly, ODataRules<T, TContext> rules, bool logOnly = false)
        where T : class where TKey : notnull where TContext : DbContext
    {
        string keyName = JsonNamingPolicy.CamelCase.ConvertName(keyProperty);
        string slash = "/" + set + "/{id" + constraint + "}";
        string parens = "/" + set + (quoted ? "('{id}')" : "({id" + constraint + "})");
        var property = typeof(T).GetProperty(keyProperty)!;

        Func<HttpContext, Type, Microsoft.OData.UriParser.ODataPath> pathOf = (context, type) =>
        {
            var entitySet = Model.EntityContainer.FindEntitySet(set)!;
            object id = Convert.ChangeType(context.GetRouteValue("id")!, typeof(TKey) == typeof(Guid) ? typeof(string) : typeof(TKey), CultureInfo.InvariantCulture);
            if (typeof(TKey) == typeof(Guid))
                id = Guid.Parse((string)id);
            return new Microsoft.OData.UriParser.ODataPath(new EntitySetSegment(entitySet),
                new KeySegment([new KeyValuePair<string, object>(keyName, id)], entitySet.EntityType, entitySet));
        };

        // a table whose rows belong to a person lists only the rows of the owners the caller may act for
        lists.MapGet("/" + set, async (TContext context, HttpContext http) =>
        {
<#= listGate #>            var rows = context.Set<T>().AsNoTracking();
            return await OwnersAsync(http, rules) is { } owners ? rules.Scope(context, rows, owners) : rows;
        });

        foreach (string route in new[] { slash, parens })
        {
            odata.MapGet(route, async (TContext context, HttpContext http, TKey id) =>
            {
                if (await context.Set<T>().FindAsync(id) is not { } row)
                    return Results.NotFound();
                if (await RefuseOtherOwnersAsync(context, http, rules, row) is { } refused)
                    return refused;
                context.Entry(row).State = EntityState.Detached;
                return Results.Ok(row);
            })<#= readGate #>;

            if (logOnly)
                continue;

            odata.MapPut(route, async (TContext context, HttpContext http, TKey id, T body) =>
            {
                if (await context.Set<T>().FindAsync(id) is not { } row)
                    return Results.NotFound();
                if (await RefuseOtherOwnersAsync(context, http, rules, row) is { } refused)
                    return refused;
                if (property.GetValue(body) is { } sent && !sent.Equals(id) && !sent.Equals(property.PropertyType.IsValueType ? Activator.CreateInstance(property.PropertyType) : null))
                    return Results.Problem(statusCode: <#= HttpStatus.BadRequest #>, type: "<#= ProblemTypes.InvalidId #>", title: "Key mismatch", detail: "The key in the body is not the key in the address.");
                property.SetValue(body, id);
                // the row stays with an owner the caller may act for: it cannot be handed to anyone else
                if (await RefuseOtherOwnersAsync(context, http, rules, body) is { } refusedOwner)
                    return refusedOwner;
                if (await rules.BeforeSaveAsync(context, http.User, body, false) is { } refusedSave)
                    return refusedSave;
                context.Entry(row).CurrentValues.SetValues(body);
                Stamp(context, row, false);
                return await SaveAsync(context, () => Results.NoContent());
            })<#= roleGate #><#= validate ? ".AddEndpointFilter<ValidationFilter<T>>()" : "" #>;

            odata.MapPatch(route, async (TContext context, TKey id, Delta<T> delta, HttpContext http) =>
            {
                if (await context.Set<T>().FindAsync(id) is not { } row)
                    return Results.NotFound();
                if (await RefuseOtherOwnersAsync(context, http, rules, row) is { } refused)
                    return refused;
                var refusedNames = delta.GetChangedPropertyNames().Where(name => readOnly.Contains(name)).ToList();
                if (refusedNames.Count > 0)
                    return Results.Problem(statusCode: <#= HttpStatus.BadRequest #>, type: "<#= ProblemTypes.ChangeNotAllowed #>", title: "Change not allowed", detail: "These cannot be changed: " + string.Join(", ", refusedNames) + ".");
                delta.Patch(row);
                if (await RefuseOtherOwnersAsync(context, http, rules, row) is { } refusedOwner)
                {
                    context.ChangeTracker.Clear();
                    return refusedOwner;
                }
                if (await rules.BeforeSaveAsync(context, http.User, row, false) is { } refusedSave)
                {
                    context.ChangeTracker.Clear();
                    return refusedSave;
                }
                Stamp(context, row, false);
<#
    if (validate)
    {
#>
                if (http.RequestServices.GetService<IValidator<T>>() is { } validator)
                {
                    var result = await validator.ValidateAsync(row, http.RequestAborted);
                    if (!result.IsValid)
                    {
                        context.ChangeTracker.Clear();
                        return Results.ValidationProblem(result.ToDictionary());
                    }
                }
<#
    }
#>
                return await SaveAsync(context, () => Results.Ok(row));
            }).WithODataPathFactory(pathOf)<#= roleGate #>;

            odata.MapDelete(route, async (TContext context, HttpContext http, TKey id) =>
            {
                if (await context.Set<T>().FindAsync(id) is not { } row)
                    return Results.NotFound();
                if (await RefuseOtherOwnersAsync(context, http, rules, row) is { } refused)
                    return refused;
                context.Set<T>().Remove(row);
                return await SaveAsync(context, () => Results.NoContent());
            })<#= roleGate #>;
        }

        if (logOnly)
            return;

        odata.MapPost("/" + set, async (TContext context, HttpContext http, T row) =>
        {
            var entry = context.Entry(row);
            if (entry.Property(keyProperty).Metadata.ValueGenerated == ValueGenerated.OnAdd)
                property.SetValue(row, property.PropertyType.IsValueType ? Activator.CreateInstance(property.PropertyType) : null);
            if (property.GetValue(row) is string chosen)
            {
                if (string.IsNullOrWhiteSpace(chosen))
                    return Results.Problem(statusCode: <#= HttpStatus.BadRequest #>, type: "<#= ProblemTypes.KeyRequired #>", title: "Key is required", detail: "The key cannot be empty.");
                if (await context.Set<T>().FindAsync(chosen) is not null)
                    return Results.Problem(statusCode: <#= HttpStatus.Conflict #>, type: "<#= ProblemTypes.DuplicateKey #>", title: "Duplicate key", detail: $"A row with the key '{chosen}' already exists.");
            }
            if (await ClaimOwnerAsync(context, http, rules, row) is { } refused)
                return refused;
            if (await rules.BeforeSaveAsync(context, http.User, row, true) is { } refusedSave)
                return refusedSave;
            Stamp(context, row, true);
            context.Set<T>().Add(row);
            return await SaveAsync(context, () => Results.Created($"<#= ODataNames.Prefix #>/{set}/{property.GetValue(row)}", row));
        })<#= roleGate #><#= validate ? ".AddEndpointFilter<ValidationFilter<T>>()" : "" #>;
    }

    /// <summary> The owner ids the caller may reach in a table whose rows belong to a person; null when there is no restriction (the table has no owner, or the caller sees every owner). </summary>
    private static async Task<int[]?> OwnersAsync<T, TContext>(HttpContext http, ODataRules<T, TContext> rules) where T : class where TContext : DbContext
    {
<#
    if (auth)
    {
#>
        if (!rules.Owned)
            return null;
        var owners = await http.RequestServices.GetRequiredService<IOwnerScope>().VisibleOwnersAsync(http.User, http.RequestAborted);
        return owners?.ToArray();
<#
    }
    else
    {
#>
        await Task.CompletedTask;
        return null;
<#
    }
#>
    }

    private static async Task<int?> OwnerOfAsync<T, TContext>(TContext context, ODataRules<T, TContext> rules, T row) where T : class where TContext : DbContext =>
        rules.OwnerThroughParent ? await rules.ParentOwnerAsync(context, row) : rules.OwnerOf(row);

    /// <summary> Null when the caller may touch this row: 403 when it is another owner's. </summary>
    private static async Task<IResult?> RefuseOtherOwnersAsync<T, TContext>(TContext context, HttpContext http, ODataRules<T, TContext> rules, T row) where T : class where TContext : DbContext
    {
        if (await OwnersAsync(http, rules) is not { } owners)
            return null;
        return await OwnerOfAsync(context, rules, row) is { } owner && owners.Contains(owner) ? null : NotYours();
    }

    /// <summary> A new row goes under an owner the caller may act for: a caller who may act for one owner and left the owner blank creates it for that owner. </summary>
    private static async Task<IResult?> ClaimOwnerAsync<T, TContext>(TContext context, HttpContext http, ODataRules<T, TContext> rules, T row) where T : class where TContext : DbContext
    {
        if (await OwnersAsync(http, rules) is not { } owners)
            return null;
        if (!rules.OwnerThroughParent && rules.OwnerOf(row) == 0 && owners.Length == 1)
        {
            rules.SetOwner(row, owners[0]);
            return null;
        }
        return await OwnerOfAsync(context, rules, row) is { } owner && owners.Contains(owner) ? null : NotYours();
    }

    private static IResult NotYours() => Results.Problem(statusCode: <#= HttpStatus.Forbidden #>, type: "<#= ProblemTypes.NotYours #>", title: "Not your row", detail: "That row belongs to someone you may not act for.");

    private static async Task<IResult> SaveAsync(DbContext context, Func<IResult> done)
    {
        try
        {
            await context.SaveChangesAsync();
            return done();
        }
        catch (DbUpdateException error)
        {
            context.ChangeTracker.Clear();
            return ApiProblems.ToResult(error);
        }
    }
}
