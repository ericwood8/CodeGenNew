        string entity = t.TableName;
        var ownerColumn = ODataPlan.IsScoped(t, Project) ? OwnedTable.OwnerColumn(t, Project) : null;
        var ownerLink = ODataPlan.IsScoped(t, Project) ? OwnedTable.Through(t, Project) : null;
