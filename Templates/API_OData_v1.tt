/// <summary> What a table's OData routes add to the plain read and write: the owner scope (a table whose rows belong to a person) and the checks run before a row is saved (change gates and guarded columns). A class per
/// table that needs either is generated below; every other table uses this one, which scopes and checks nothing. </summary>
public class ODataRules<T, TContext> where T : class where TContext : DbContext
{
    /// <summary> True when the rows belong to a person: the routes then list, read and write only the rows of the owners the caller may act for. </summary>
    public virtual bool Owned => false;

    /// <summary> The roles that may create, change and delete rows (the project's WriteRoles and TableWriteRoles, the administrator role among them); empty: any signed-in person. </summary>
    public virtual IReadOnlyList<string> WriteRoles => [];

    /// <summary> The roles that may read rows (the project's ReadRoles and TableReadRoles, the administrator role among them); empty: any signed-in person. </summary>
    public virtual IReadOnlyList<string> ReadRoles => [];

    /// <summary> True when the owner is the owner of a parent row (the table has no owner column of its own). </summary>
    public virtual bool OwnerThroughParent => false;

    public virtual IQueryable<T> Scope(TContext context, IQueryable<T> rows, int[] owners) => rows;

    /// <summary> The owner a row names in its own owner column. </summary>
    public virtual int? OwnerOf(T row) => null;

    public virtual void SetOwner(T row, int owner) { }

    /// <summary> The owner of the parent row this row names; null when there is no such parent. </summary>
    public virtual Task<int?> ParentOwnerAsync(TContext context, T row) => Task.FromResult<int?>(null);

    /// <summary> Runs before a row is saved: <paramref name="row"/> may be corrected (a column the caller may not change takes its stored value) and a result refuses the write. </summary>
    public virtual Task<IResult?> BeforeSaveAsync(TContext context, ClaimsPrincipal caller, T row, bool isNew) => Task.FromResult<IResult?>(null);
}

<#
    foreach (var t in ruleTables)
