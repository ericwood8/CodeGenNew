        rows.Where(c => context.Set<<#= ownerLink.ParentTable #>>().Any(p => p.<#= ownerLink.ParentKey #> == c.<#= ownerLink.ForeignKey #> && owners.Contains(p.<#= ownerLink.ParentOwner #>)));

    public override async Task<int?> ParentOwnerAsync(<#= contextType #> context, <#= entity #> row) =>
        await context.Set<<#= ownerLink.ParentTable #>>().Where(p => p.<#= ownerLink.ParentKey #> == row.<#= ownerLink.ForeignKey #>).Select(p => (int?)p.<#= ownerLink.ParentOwner #>).FirstOrDefaultAsync();
