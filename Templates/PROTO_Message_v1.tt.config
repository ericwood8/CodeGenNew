# Restriction checkboxes for PROTO_Message_v1.tt (see Docs/Reference.md section 3).
# The key message needs the primary key; a composite key is fine.
RequiresPrimaryKey=true
TableOnly=true
# Name the file like the message: Customer -> Customer.proto
OutputName={Table}.proto
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso.
Stacks=Api
PlanTables=Entity
OutputFolder=Protos
InPlan=false
