# Restriction checkboxes for BLZ_JunctionTest_v1.tt (see Docs/Reference.md section 3).
Requires=PrimaryKey,JunctionTable
# Only for a many-to-many junction/bridge table (TableModel.IsJunctionTable), the tables BLZ_Junction writes a page for.
NeedsReferencedDisplayColumns=true
# No OutputName: the template writes its own path (<Table>JunctionPageTests.cs) with an @@@FILE marker.
# Whole-project generation (codegen generate): for a project that sets BlazorTests=true (or names the template in PlanAlso). The files go to the test project, not the Blazor app.
Stacks=Blazor
PlanTables=Junction
OutputRoot=BlazorTests
InPlan=false
