<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // API_UserDirectory_v1.tt
    // Generates: Apis/TableUserDirectory.cs   (see OutputName in API_UserDirectory_v1.tt.config)
    // The people who sign in, kept in one of the project's own tables (UserTable=Employee, UserNameColumn, PasswordHashColumn, UserOwnerColumn, UserRoleColumn): TableUserDirectory is the
    // IUserDirectory of the Jwt group's sign-in, AddTableUserDirectory() registers it (Program.cs calls it before AddGeneratedAuth), and UserCommands.TryRunAsync runs
    // the command set-password <name> (dotnet run with the arguments after a double hyphen; the new password in the environment variable NEW_PASSWORD), the one way a password hash is written. A row with no hash cannot sign in.
    // A yes/no UserRoleColumn gives two roles (UserRoleWhenTrue, UserRoleWhenFalse); a text one is the role itself; a true UserAdminColumn makes the person the AuthAdminRole. Which names and columns are acceptable is decided by UserTable.Resolve.
    // Needs ApiAuth=true (the Jwt group). Full notes: Docs/TemplateNotes/API_UserDirectory_v1.md
    // ==========================================================================================
    var (plan, problem) = UserTable.Resolve(Database, Project);
    if (problem != null)
        Error(problem);
    var (permissions, permissionProblem) = PermissionTables.Resolve(Database, Project);
    if (permissionProblem != null)
        Error(permissionProblem);
    if (plan == null)
        return GenerationEnvironment.ToString();

    string apiNamespace = Project.ApiNamespace ?? (Project.ProjectName ?? "MyApp") + ".Api.Apis";
    string contextType = Project.ContextName ?? "AppContext";
    string entity = plan.Table.TableName;

    string P(ColumnModel c) => c.Name;
    string roleExpression = plan.Role == null ? "null"
        : plan.RoleIsFlag ? $"row.Role == true ? \"{plan.RoleWhenTrue}\" : \"{plan.RoleWhenFalse}\""
        : "row.Role";
    string ownerExpression = plan.Owner == null ? "null" : plan.Owner.IsNullable ? "row.Owner" : "(int?)row.Owner";
    // an administrator is the AuthAdminRole whatever the role column says
    if (plan.Admin != null)
        roleExpression = "row.Admin == true ? AuthNames.AdminRole : (" + roleExpression + ")";

    // TenantTable: nobody works in a tenant yet when they sign in, so the user table is read without its query filter (the tenant one); a soft-deleted person still cannot sign in
    bool tenancy = Project.ApiAuth && TenantPlan.IsEnabled(Project);
    string filters = tenancy ? ".IgnoreQueryFilters()" : "";
    string notDeleted = tenancy && TableShapes.For(plan.Table, Project).SoftDelete is { } soft ? $".Where(u => !u.{soft.Flag.CSharpName()})" : "";

    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');

    Line($"namespace {apiNamespace};");
    Line();
    Line("using System.Security.Claims;");
    Line("using Microsoft.AspNetCore.Mvc;");
    Line("using Microsoft.EntityFrameworkCore;");
    Line();
    Line($"/// <summary> The <see cref=\"IUserDirectory\"/> of the sign-in: the people are the rows of {entity} ({P(plan.UserName)}, {P(plan.PasswordHash)}).");
    Line($"/// A row whose {P(plan.UserName)} or {P(plan.PasswordHash)} is empty cannot sign in. </summary>");
    Line("public class TableUserDirectory : IUserDirectory");
    Line("{");
    Line($"    private readonly {contextType} _context;");
    Line();
    Line($"    public TableUserDirectory({contextType} context) => _context = context;");
    Line();
    Line("    public async Task<DirectoryUser?> FindAsync(string userName, CancellationToken cancellationToken = default)");
    Line("    {");
    Line("        string name = userName.Trim();");
    Line($"        var row = await _context.Set<{entity}>(){filters}.AsNoTracking(){notDeleted}");
    Line($"            .Where(u => u.{P(plan.UserName)} == name && u.{P(plan.PasswordHash)} != null && u.{P(plan.PasswordHash)} != \"\")");
    Line("            .Select(u => new");
    Line("            {");
    Line($"                Name = u.{P(plan.UserName)},");
    Line($"                Hash = u.{P(plan.PasswordHash)},");
    Line($"                Role = {(plan.Role == null ? "(string?)null" : "u." + P(plan.Role))},");
    if (plan.Admin != null)
        Line($"                Admin = u.{P(plan.Admin)},");
    Line($"                Owner = {(plan.Owner == null ? "(int?)null" : "u." + P(plan.Owner))}");
    Line("            })");
    Line("            .FirstOrDefaultAsync(cancellationToken);");
    Line("        return row is null ? null : new DirectoryUser(row.Name!, row.Hash!, " + roleExpression + ", " + ownerExpression + ");");
    Line("    }");
    Line();
    Line("    /// <summary> Writes the hash of <paramref name=\"password\"/> for the person; false when there is no such person. </summary>");
    Line("    public async Task<bool> SetPasswordAsync(string userName, string password, CancellationToken cancellationToken = default)");
    Line("    {");
    Line("        string name = userName.Trim();");
    Line($"        var row = await _context.Set<{entity}>(){filters}{notDeleted}.FirstOrDefaultAsync(u => u.{P(plan.UserName)} == name, cancellationToken);");
    Line("        if (row is null)");
    Line("            return false;");
    Line($"        row.{P(plan.PasswordHash)} = PasswordService.Hash(password);");
    Line("        await _context.SaveChangesAsync(cancellationToken);");
    Line("        return true;");
    Line("    }");
    Line("}");
    Line();
    if (permissions is not null)
    {
        string Set(TableModel table, ColumnModel? tenantColumn) => $"context.Set<{table.TableName}>(){(tenantColumn is null ? "" : ".IgnoreQueryFilters()")}.AsNoTracking()";
        string InTenant(string alias, ColumnModel? tenantColumn) => tenantColumn is null ? "" : tenantColumn.IsNullable ? $" && ({alias}.{P(tenantColumn)} == tenantId || {alias}.{P(tenantColumn)} == null)" : $" && {alias}.{P(tenantColumn)} == tenantId";
        string roleJoin = permissions.RoleTenant is null ? "" : $" join r in {Set(permissions.Role, permissions.RoleTenant)} on ur.{P(permissions.UserRoleRole)} equals r.{P(permissions.RoleKey)}";
        Line("/// <summary> The role claims of a person (" + permissions.UserRole.TableName + ") and the permission claims those roles hold (" + permissions.RolePermission.TableName + "), so a role list entry <c>@name</c> is allowed for a person who holds that permission."
            + (permissions.PerTenant ? " Only the roles of the tenant given count. " : " ") + "A role or permission changed in the tables reaches a person at their next sign-in or tenant switch. </summary>");
        Line("public static class PermissionClaims");
        Line("{");
        Line("    public static async Task<List<Claim>> ForAsync(" + contextType + " context, string userName, int? tenantId, CancellationToken cancellationToken = default)");
        Line("    {");
        Line($"        var key = await context.Set<{entity}>(){filters}.AsNoTracking().Where(u => u.{P(plan.UserName)} == userName).Select(u => (int?)u.{P(permissions.UserKey)}).FirstOrDefaultAsync(cancellationToken);");
        Line("        if (key is null)");
        Line("            return [];");
        if (permissions.PerTenant)
        {
            Line("        if (tenantId is null)");
            Line("            return [];");
        }
        Line($"        var roles = await (from ur in {Set(permissions.UserRole, permissions.UserRoleTenant)} join r in {Set(permissions.Role, permissions.RoleTenant)} on ur.{P(permissions.UserRoleRole)} equals r.{P(permissions.RoleKey)}");
        Line($"                           where ur.{P(permissions.UserRoleUser)} == key{InTenant("ur", permissions.UserRoleTenant)}{InTenant("r", permissions.RoleTenant)} select r.{P(permissions.RoleName)}).Distinct().ToListAsync(cancellationToken);");
        Line($"        var held = await (from ur in {Set(permissions.UserRole, permissions.UserRoleTenant)}{roleJoin} join rp in {Set(permissions.RolePermission, null)} on ur.{P(permissions.UserRoleRole)} equals rp.{P(permissions.RolePermissionRole)}");
        Line($"                          join p in context.Set<{permissions.Permission.TableName}>().AsNoTracking() on rp.{P(permissions.RolePermissionPermission)} equals p.{P(permissions.PermissionKey)}");
        Line($"                          where ur.{P(permissions.UserRoleUser)} == key{InTenant("ur", permissions.UserRoleTenant)}{InTenant("r", permissions.RoleTenant)} select p.{P(permissions.PermissionName)}).Distinct().ToListAsync(cancellationToken);");
        Line("        return roles.Where(r => !string.IsNullOrEmpty(r)).Select(r => new Claim(AuthNames.RoleClaim, r!))");
        Line("            .Concat(held.Where(p => !string.IsNullOrEmpty(p)).Select(p => new Claim(AuthNames.PermissionClaim, p!))).ToList();");
        Line("    }");
        Line("}");
        Line();
        Line("/// <summary> Adds the claims of <see cref=\"PermissionClaims\"/> to the token at sign-in, for the tenant the person works in. </summary>");
        Line("public class PermissionLoginClaims(" + contextType + " context) : ITenantLoginClaims");
        Line("{");
        Line("    public async Task<LoginClaims> ForAsync(DirectoryUser user, int? tenantId, CancellationToken cancellationToken = default) =>");
        Line("        new(await PermissionClaims.ForAsync(context, user.UserName, tenantId, cancellationToken));");
        Line("}");
        Line();
    }
    Line("/// <summary> The registration Program.cs calls before AddGeneratedAuth, so the sign-in finds the table and not the single bootstrap administrator. </summary>");
    Line("public static class TableUserDirectoryRegistration");
    Line("{");
    Line("    public static IServiceCollection AddTableUserDirectory(this IServiceCollection services)");
    Line("    {");
    Line("        services.AddScoped<TableUserDirectory>();");
    Line("        services.AddScoped<IUserDirectory>(provider => provider.GetRequiredService<TableUserDirectory>());");
    if (permissions is not null)
        Line("        services.AddScoped<ITenantLoginClaims, PermissionLoginClaims>();");
    Line("        return services;");
    Line("    }");
    Line("}");
    Line();
    Line("/// <summary> The commands given as arguments to dotnet run (after the double hyphen), run once; the program then ends instead of starting the web server. </summary>");
    Line("public static class UserCommands");
    Line("{");
    Line("    public const string PasswordVariable = \"NEW_PASSWORD\";");
    Line("    public const int MinimumPasswordLength = 8;");
    Line();
    Line("    /// <summary> True when <paramref name=\"args\"/> named a command (it has run, and Environment.ExitCode says how it went); false to go on and start the server. </summary>");
    Line("    public static async Task<bool> TryRunAsync(string[] args, IServiceProvider services)");
    Line("    {");
    Line("        if (args.Length == 0 || !string.Equals(args[0], \"set-password\", StringComparison.OrdinalIgnoreCase))");
    Line("            return false;");
    Line();
    Line("        string? password = Environment.GetEnvironmentVariable(PasswordVariable);");
    Line("        if (args.Length != 2 || string.IsNullOrEmpty(password))");
    Line("        {");
    Line("            Console.Error.WriteLine($\"Usage: set-password <user name>   (the new password in the environment variable {PasswordVariable}, never on the command line)\");");
    Line("            Environment.ExitCode = 2;");
    Line("            return true;");
    Line("        }");
    Line("        if (password.Length < MinimumPasswordLength)");
    Line("        {");
    Line("            Console.Error.WriteLine($\"The password must have at least {MinimumPasswordLength} characters.\");");
    Line("            Environment.ExitCode = 2;");
    Line("            return true;");
    Line("        }");
    Line();
    Line("        using var scope = services.CreateScope();");
    Line("        bool found = await scope.ServiceProvider.GetRequiredService<TableUserDirectory>().SetPasswordAsync(args[1], password);");
    Line("        Console.WriteLine(found ? $\"Password set for {args[1].Trim()}.\" : $\"There is no user named {args[1].Trim()}.\");");
    Line("        Environment.ExitCode = found ? 0 : 1;");
    Line("        return true;");
    Line("    }");
    Line("}");

    // the first person of an empty table and a person's new password, over HTTP (the screens of the web front ends call them)
    string firstPerson = DesktopSignInCode.FirstPersonMethods(Database, Project, contextType, "PasswordService.Hash");
    var people = PeoplePlan.For(Database, Project);
    bool members = people is { HasMembers: true };
    if (firstPerson.Length > 0)
    {
        Line();
        Line("/// <summary> Adds the first person of an empty " + entity + " table, the administrator (and, with tenants, a member of the first active tenant). </summary>");
        Line("public static class FirstPersonSetup");
        Line("{");
        sb.Append(firstPerson.TrimStart('\n').Replace("§CTX", contextType));
        Line("}");
    }
    Line();
    Line("/// <summary> The body of POST /api/auth/first-person: the sign-in name and password of the first administrator. </summary>");
    Line("public record FirstPersonRequest(string UserName, string Password);");
    Line();
    Line("/// <summary> What GET /api/auth/first-person answers: whether the table is empty, so the sign-in offers to create the first administrator. </summary>");
    Line("public record FirstPersonState(bool Open);");
    Line();
    Line("/// <summary> The body of PUT /api/auth/password: whose password and the new one. </summary>");
    Line("public record PasswordChange(string UserName, string Password);");
    if (members)
    {
        Line();
        sb.Append(AspNetPeopleWriter.Records).Append('\n');
    }
    Line();
    Line("/// <summary> GET and POST /api/auth/first-person (no sign-in: nobody can sign in yet) and PUT /api/auth/password (an administrator for anyone, anyone else only their own). </summary>");
    Line("public static class UserEndpoints");
    Line("{");
    Line("    public static void MapUserEndpoints(this WebApplication app)");
    Line("    {");
    if (firstPerson.Length > 0)
    {
        Line("        app.MapGet(\"/api/auth/first-person\", async ([FromServices] " + contextType + " context, HttpContext http) =>");
        Line("            Results.Ok(new FirstPersonState(await FirstPersonSetup.NoPeopleAsync(context, http.RequestAborted))))");
        Line("        .AllowAnonymous()");
        Line("        .WithName(\"FirstPersonState\")");
        Line("        .Produces<FirstPersonState>();");
        Line();
        Line("        app.MapPost(\"/api/auth/first-person\", CreateFirstAsync)");
        Line("        .AllowAnonymous()");
        Line("        .WithName(\"CreateFirstPerson\")");
        Line($"        .Produces({HttpStatus.NoContent})");
        Line($"        .ProducesProblem({HttpStatus.BadRequest})");
        Line($"        .ProducesProblem({HttpStatus.Conflict});");
        Line();
    }
    Line("        app.MapPut(\"/api/auth/password\", SetPasswordAsync)");
    Line("        .WithName(\"SetPassword\")");
    Line($"        .Produces({HttpStatus.NoContent})");
    Line($"        .ProducesProblem({HttpStatus.BadRequest})");
    Line($"        .ProducesProblem({HttpStatus.Forbidden})");
    Line($"        .ProducesProblem({HttpStatus.NotFound});");
    if (members)
    {
        Line();
        sb.Append(AspNetPeopleWriter.Mappings(people!));
    }
    Line("    }");
    Line();
    if (firstPerson.Length > 0)
    {
        Line("    private static async Task<IResult> CreateFirstAsync([FromBody] FirstPersonRequest request, [FromServices] " + contextType + " context, HttpContext http)");
        Line("    {");
        Line("        if (string.IsNullOrWhiteSpace(request.UserName) || request.Password is null || request.Password.Length < UserCommands.MinimumPasswordLength)");
        Line($"            return Results.Problem(statusCode: {HttpStatus.BadRequest}, type: \"{ProblemTypes.FirstPersonInvalid}\", title: $\"The first person needs a user name and a password of at least {{UserCommands.MinimumPasswordLength}} characters\");");
        Line("        if (!await FirstPersonSetup.CreateFirstAsync(context, request.UserName, request.Password, http.RequestAborted))");
        Line($"            return Results.Problem(statusCode: {HttpStatus.Conflict}, type: \"{ProblemTypes.FirstPersonTaken}\", title: \"Someone has already been added\", detail: \"Sign in with that person.\");");
        Line("        return Results.NoContent();");
        Line("    }");
        Line();
    }
    Line("    private static async Task<IResult> SetPasswordAsync([FromBody] PasswordChange request, ClaimsPrincipal user, [FromServices] TableUserDirectory directory, HttpContext http)");
    Line("    {");
    Line("        if (string.IsNullOrWhiteSpace(request.UserName) || request.Password is null || request.Password.Length < UserCommands.MinimumPasswordLength)");
    Line($"            return Results.Problem(statusCode: {HttpStatus.BadRequest}, type: \"{ProblemTypes.PasswordInvalid}\", title: $\"The password needs a user name and at least {{UserCommands.MinimumPasswordLength}} characters\");");
    Line("        bool own = string.Equals(user.FindFirstValue(AuthNames.NameClaim), request.UserName.Trim(), StringComparison.OrdinalIgnoreCase);");
    Line("        if (!own && !user.IsInRole(AuthNames.AdminRole))");
    Line($"            return Results.Problem(statusCode: {HttpStatus.Forbidden}, type: \"{ProblemTypes.PasswordNotYours}\", title: \"Not your password\", detail: \"Only an administrator sets another person's password.\");");
    Line("        return await directory.SetPasswordAsync(request.UserName, request.Password, http.RequestAborted) ? Results.NoContent() : Results.NotFound();");
    Line("    }");
    if (members)
        sb.Append(AspNetPeopleWriter.Handlers(people!, contextType));
    Line("}");
    Write(sb.ToString());
#>
