# Restriction checkboxes for CS_DataShapesTest_v1.tt (see Docs/Reference.md section 3).
# Tests the classes CS_DataContractDto and CS_TypedDataRow write; they need no key.
# Name the file like the table: Customer -> CustomerDataShapesTests.cs
Requires=
OutputName={Table}DataShapesTests.cs
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso. The files go to the test project (ApiTests=true writes it), not the API.
Stacks=Api
PlanTables=Dto
OutputRoot=ApiTests
InPlan=false
