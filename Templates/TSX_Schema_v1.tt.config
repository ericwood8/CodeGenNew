# Restriction checkboxes for TSX_Schema_v1.tt (see Docs/Reference.md section 3).
RequiresPrimaryKey=true
TableOnly=true
# No OutputName: the template writes its own path (schemas/<table>.ts) with an @@@FILE marker.
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso.
Stacks=React
PlanTables=Entity
OutputFolder=src
InPlan=false
