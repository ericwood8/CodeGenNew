# Restriction checkboxes for API_Search_v1.tt (see Docs/specs.md section 5.3).
# Same restrictions SP_Search.tt itself has -- this template's generated code calls that procedure directly.
RequiresPrimaryKey=true
TableOnly=true
OutputName={Table}SearchApi.cs
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Api
PlanTables=Search
OutputFolder=Apis
