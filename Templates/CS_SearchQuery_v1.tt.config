# Restriction checkboxes for CS_SearchQuery_v1.tt (see Docs/Reference.md section 3).
# The query is over the table's entity, which needs a primary key.
RequiresPrimaryKey=true
TableOnly=true
# A foreign key sorts by its parent's display column, so those are looked up.
NeedsReferencedDisplayColumns=true
OutputName={Table}SearchQuery.cs
# Written only for a project that reaches the database through EF Core (AccessMode=Ef); the routines of SP_Search replace it otherwise.
AccessMode=Ef
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Api,WinUI3
PlanTables=Entity
OutputFolder=Repositories
