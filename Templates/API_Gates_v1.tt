<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string apiNamespace = "MyApp.ApiService.Apis";
    string contextType = "MyAppContext";
    string[] usings = { };   // namespaces the generated file must "using" (the context's)
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    contextType = Project.ContextName ?? contextType;
    apiNamespace = Project.ApiNamespace ?? apiNamespace;
    usings = Project.Usings ?? usings;
    // ==========================================================================================

    // ==========================================================================================
    // API_Gates_v1.tt
    // Generates: Gates.cs   (see OutputName in API_Gates_v1.tt.config)
    // The checks of the project's ChangeGates and GuardedColumns, one static class per table, called from that table's API (API_Crud) before a row is saved. A gate refuses a change
    // of a column (409 change-not-allowed) while its condition holds unless its exemption does; a guard lets only a person whose user-table row has a yes/no column set (or an administrator)
    // change a column (403 column-not-yours) and stamps who did it and when. GET <route>/guards answers which guarded columns the caller may change. Needs ApiAuth.
    // Registered by API_Registration; written only when the project names a rule (the plan adds it). A rule that does not fit the schema stops the run with the reason.
    // Full notes: Docs/TemplateNotes/API_Gates_v1.md
    // ==========================================================================================

    var plan = GatePlan.Resolve(Database, Project);
    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');
    string Q(string text) => CSharpText.Quote(text);

    if (plan.Problems.Count > 0)
    {
        Error(string.Join(" | ", plan.Problems));
    }
    else
    {
        Line($"namespace {apiNamespace};");
        Line();
        foreach (string u in usings)
            Line($"using {u};");
        Line("using System.Security.Claims;");
        Line("using Microsoft.EntityFrameworkCore;");
        Line();

        var tables = plan.Gates.Select(g => g.Table).Concat(plan.Guards.Select(g => g.Table)).Distinct().OrderBy(t => t.TableName, StringComparer.OrdinalIgnoreCase).ToList();
        foreach (var table in tables)
        {
            string entity = table.TableName;
            var key = table.PrimaryKeyColumns[0];
            var gates = plan.Gates.Where(g => g.Table == table).ToList();
            var guards = plan.Guards.Where(g => g.Table == table).ToList();

            Line($"/// <summary> The change gates and column guards of {entity} (the project's ChangeGates and GuardedColumns), checked before a row is saved. Generated by API_Gates. </summary>");
            Line($"public static class {entity}Gates");
            Line("{");
            Line($"    public static async Task<IResult?> CheckAsync({contextType} context, ClaimsPrincipal caller, {entity} row, bool isNew)");
            Line("    {");
            int block = 0;
            foreach (var guard in guards)
            {
                string column = guard.Column.CSharpName();
                var members = new List<string> { column };
                if (guard.StampBy is { } by) members.Add(by.CSharpName());
                if (guard.StampOn is { } on) members.Add(on.CSharpName());
                string stored = "stored" + (++block);
                string defaultTest = guard.Column.IsBooleanColumn ? $"row.{column} == true"
                    : guard.Column.IsStringColumn ? $"!string.IsNullOrEmpty(row.{column})"
                    : guard.Column.IsNullable ? $"(row.{column} ?? 0) != 0" : $"row.{column} != 0";
                Line($"        // guard {entity}.{guard.Column.Name}: only a person with {guard.UserTable.TableName}.{guard.By.Name} (or an administrator) changes it");
                Line("        {");
                Line($"            var {stored} = isNew ? null : await context.Set<{entity}>().AsNoTracking().Where(r => r.{key.CSharpName()} == row.{key.CSharpName()})");
                Line($"                .Select(r => new {{ {string.Join(", ", members.Select(m => "r." + m))} }}).FirstOrDefaultAsync();");
                Line($"            if (!isNew && {stored} is null)");
                Line("                return Results.NotFound();");
                Line($"            bool changed = isNew ? {defaultTest} : !Equals(row.{column}, {stored}!.{column});");
                Line($"            if (changed && !await May{column}Async(context, caller))");
                Line($"                return Results.Problem(statusCode: {HttpStatus.Forbidden}, type: {Q(ProblemTypes.ColumnNotYours)}, title: \"Not allowed\", detail: {Q($"Only a person with {Labels.Words(guard.By.Name)} set on {Labels.Words(guard.UserTable.TableName)} (or an administrator) may change {Labels.Words(guard.Column.Name)}.")});");
                if (guard.StampBy is not null || guard.StampOn is not null)
                {
                    Line("            if (changed)");
                    Line("            {");
                    if (guard.StampBy is { } stampBy)
                        Line($"                row.{stampBy.CSharpName()} = caller.FindFirstValue(AuthNames.NameClaim){(stampBy.IsNullable ? "" : " ?? \"\"")};");
                    if (guard.StampOn is { } stampOn)
                        Line($"                row.{stampOn.CSharpName()} = DateTime.Now;");
                    Line("            }");
                    Line("            else");
                    Line("            {");
                    if (guard.StampBy is { } keepBy)
                        Line($"                row.{keepBy.CSharpName()} = isNew ? default! : {stored}!.{keepBy.CSharpName()};");
                    if (guard.StampOn is { } keepOn)
                        Line($"                row.{keepOn.CSharpName()} = isNew ? default! : {stored}!.{keepOn.CSharpName()};");
                    Line("            }");
                }
                Line("        }");
                Line();
            }
            foreach (var gate in gates)
            {
                Line($"        if (await Gate{gate.Column.CSharpName()}Async(context, row, isNew) is {{ }} refused{gate.Column.CSharpName()})");
                Line($"            return refused{gate.Column.CSharpName()};");
            }
            Line();
            Line("        return null;");
            Line("    }");

            foreach (var gate in gates)
            {
                string column = gate.Column.CSharpName();
                string rowColumn = "row." + column;
                var parents = gate.When.Terms.Concat(gate.Unless?.Terms ?? []).Where(t => t.Via is not null).GroupBy(t => t.Via!.ReferencingColumns[0], StringComparer.OrdinalIgnoreCase).ToList();
                string TermTest(GateTerm term) => term.Via is null
                    ? GateCode.Test("row." + term.Column.CSharpName(), term)
                    : $"(parent_{term.Via.ReferencingColumns[0]} is not null && {GateCode.Test($"parent_{term.Via.ReferencingColumns[0]}.{term.Column.CSharpName()}", term)})";
                string to = GateCode.Test(rowColumn, gate.To);
                string when = GateCode.Predicate(gate.When, TermTest);
                string unless = gate.Unless is null ? "" : GateCode.Predicate(gate.Unless, TermTest);
                string toWords = gate.To.ValueWords();
                string message = gate.Message ?? $"{GateCode.Words(gate.Column)} cannot change to {toWords} while {gate.When.Words()}" + (gate.Unless is null ? "" : $" unless {gate.Unless.Words()}") + ".";

                Line();
                Line($"    // gate {entity}.{gate.Column.Name}: not to {toWords} while {gate.When.Words()}{(gate.Unless is null ? "" : " unless " + gate.Unless.Words())}");
                Line($"    private static async Task<IResult?> Gate{column}Async({contextType} context, {entity} row, bool isNew)");
                Line("    {");
                Line("        bool moves;");
                Line("        if (isNew)");
                Line("        {");
                if (gate.Start is { } start)
                {
                    Line($"            if ({rowColumn} != {GateCode.Literal(gate.Column, start)})");
                    Line($"                return Results.ValidationProblem(new Dictionary<string, string[]> {{ [{Q(JsonNames.Camel(gate.Column.Name))}] = [{Q($"A new {Labels.Words(entity)} always starts with {GateCode.Words(gate.Column)} = {start}.")}] }});");
                    Line("            moves = false;");
                }
                else
                    Line("            moves = true;");
                Line("        }");
                Line("        else");
                Line("        {");
                Line($"            var before = await context.Set<{entity}>().AsNoTracking().Where(r => r.{key.CSharpName()} == row.{key.CSharpName()}).Select(r => new {{ r.{column} }}).FirstOrDefaultAsync();");
                Line($"            moves = before is not null && !Equals(before.{column}, {rowColumn});");
                Line("        }");
                Line($"        if (moves && {to})");
                Line("        {");
                foreach (var parent in parents)
                {
                    var via = parent.First().Via!;
                    var holder = parent.First().Table;
                    var members = parent.Select(t => t.Column.CSharpName()).Distinct().Select(m => "p." + m);
                    string fk = via.ReferencingColumns[0];
                    var fkColumn = table.Columns.First(c => c.Name.EqualsIgnoreCase(fk));
                    string referenced = holder.Columns.First(c => c.Name.EqualsIgnoreCase(via.ReferencedColumns[0])).CSharpName();
                    Line($"            var parent_{fk} = await context.Set<{holder.TableName}>().AsNoTracking().Where(p => p.{referenced} == row.{fkColumn.CSharpName()})");
                    Line($"                .Select(p => new {{ {string.Join(", ", members)} }}).FirstOrDefaultAsync();");
                }
                Line($"            if (({when}){(unless.Length == 0 ? "" : $" && !({unless})")})");
                Line($"                return Results.Problem(statusCode: {HttpStatus.Conflict}, type: {Q(ProblemTypes.ChangeNotAllowed)}, title: \"Change not allowed\", detail: {Q(message)});");
                Line("        }");
                Line("        return null;");
                Line("    }");
            }

            // a clone is a new row made without the request's body: it starts the way a new row does and the guarded columns do not carry the source's value over
            string cloneKey = table.PrimaryKeyType?.CSharp ?? "int";
            Line();
            Line($"    /// <summary> Runs after {entity} was cloned: the copy starts as a new row does (the gated columns at their start, the guarded columns reset unless the caller may change them) and a gate that holds a new row removes the copy. </summary>");
            Line($"    public static async Task<IResult?> AfterCloneAsync({contextType} context, ClaimsPrincipal caller, {cloneKey} newId)");
            Line("    {");
            Line($"        var copy = await context.Set<{entity}>().FirstOrDefaultAsync(r => r.{key.CSharpName()} == newId);");
            Line("        if (copy is null)");
            Line("            return null;");
            foreach (var gate in gates.Where(g => g.Start is not null))
                Line($"        copy.{gate.Column.CSharpName()} = {GateCode.Literal(gate.Column, gate.Start!)};");
            foreach (var guard in guards)
            {
                string column = guard.Column.CSharpName();
                string notDefault = guard.Column.IsBooleanColumn ? $"copy.{column} == true"
                    : guard.Column.IsStringColumn ? $"!string.IsNullOrEmpty(copy.{column})"
                    : guard.Column.IsNullable ? $"(copy.{column} ?? 0) != 0" : $"copy.{column} != 0";
                Line($"        if ({notDefault})");
                Line("        {");
                Line($"            if (await May{column}Async(context, caller))");
                Line("            {");
                if (guard.StampBy is { } stampBy)
                    Line($"                copy.{stampBy.CSharpName()} = caller.FindFirstValue(AuthNames.NameClaim){(stampBy.IsNullable ? "" : " ?? \"\"")};");
                if (guard.StampOn is { } stampOn)
                    Line($"                copy.{stampOn.CSharpName()} = DateTime.Now;");
                Line("            }");
                Line("            else");
                Line("            {");
                Line($"                copy.{column} = default!;");
                if (guard.StampBy is { } clearBy)
                    Line($"                copy.{clearBy.CSharpName()} = default!;");
                if (guard.StampOn is { } clearOn)
                    Line($"                copy.{clearOn.CSharpName()} = default!;");
                Line("            }");
                Line("        }");
                if (guard.StampBy is not null || guard.StampOn is not null)
                {
                    Line("        else");
                    Line("        {");
                    if (guard.StampBy is { } emptyBy)
                        Line($"            copy.{emptyBy.CSharpName()} = default!;");
                    if (guard.StampOn is { } emptyOn)
                        Line($"            copy.{emptyOn.CSharpName()} = default!;");
                    Line("        }");
                }
            }
            Line("        await context.SaveChangesAsync();");
            foreach (var gate in gates)
            {
                Line($"        if (await Gate{gate.Column.CSharpName()}Async(context, copy, true) is {{ }} refused{gate.Column.CSharpName()})");
                Line("        {");
                Line("            context.Remove(copy);");
                Line("            await context.SaveChangesAsync();");
                Line($"            return refused{gate.Column.CSharpName()};");
                Line("        }");
            }
            Line("        return null;");
            Line("    }");
            foreach (var guard in guards)
            {
                var userPlan = UserTable.ResolveTable(guard.UserTable, Project).Plan!;
                string name = userPlan.UserName.CSharpName();
                string column = guard.Column.CSharpName();
                Line();
                Line($"    /// <summary> True when the caller is an administrator or has {guard.UserTable.TableName}.{guard.By.Name} set. </summary>");
                Line($"    public static async Task<bool> May{column}Async({contextType} context, ClaimsPrincipal caller)");
                Line("    {");
                Line("        if (caller.IsInRole(AuthNames.AdminRole))");
                Line("            return true;");
                Line("        string? name = caller.FindFirstValue(AuthNames.NameClaim);");
                Line("        if (string.IsNullOrEmpty(name))");
                Line("            return false;");
                Line($"        return await context.Set<{guard.UserTable.TableName}>().AsNoTracking().Where(u => u.{name} == name).Select(u => u.{guard.By.CSharpName()} == true).FirstOrDefaultAsync();");
                Line("    }");
            }
            Line("}");
            Line();
        }

        var guarded = tables.Where(t => plan.Guards.Any(g => g.Table == t)).ToList();
        Line("/// <summary> GET &lt;route&gt;/guards for every table with a guarded column: which of them the caller may change (the screens show the others as read-only). Generated by API_Gates. </summary>");
        Line("public static class GatesApi");
        Line("{");
        Line("    public static void Register(WebApplication app)");
        Line("    {");
        foreach (var table in guarded)
        {
            Line($"        app.MapGet({Q(ApiRequests.Route(table) + "/guards")}, async ({contextType} context, ClaimsPrincipal caller) => Results.Ok(new Dictionary<string, bool>");
            Line("        {");
            foreach (var guard in plan.Guards.Where(g => g.Table == table))
                Line($"            [{Q(JsonNames.Camel(guard.Column.Name))}] = await {table.TableName}Gates.May{guard.Column.CSharpName()}Async(context, caller),");
            Line("        })).RequireAuthorization();");
        }
        Line("    }");
        Line("}");
        Write(sb.ToString());
    }
#>
