<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // UNO_Client_v1.tt
    // Generates: Services/<Table>Client.cs   (the path is written by the template; point the output folder at the Uno app's folder)
    // The class the Uno screens read and write a table through, over the app's HttpClient: GetAll, GetLookup, Get, Create, Update, Delete, GetPage (search, paging, sort) and, for a
    // cloneable table, Clone. The calls are the Blazor client's (BLZ_Client): the same API, the same JSON. A table with a Name and an IsActive column has an API with no search and no paging, so its
    // GetPage reads the whole list and narrows, sorts and pages it in the client. A failed call throws ApiException with the HTTP status (Services/ApiSupport.cs,
    // the Support essentials group). ApiClients (UNO_Screens) holds one client per table over one HttpClient, whose BaseAddress is the API.
    // Full notes: Docs/TemplateNotes/UNO_Client_v1.md
    // ==========================================================================================

    if (UnoNames.Refusal(Model, Project) is { } reason)
    {
        Error($"UNO_Client writes no client for [{Model.SchemaName}].[{Model.TableName}]: {reason}");
    }
    else
    {
        string type = BlazorNames.TypeName(Model.TableName);
        Write($"@@@FILE Services/{type}Client.cs@@@\n" + ApiClientCode.Client(Model, Project, UnoNames.ModelsNamespace(Project), UnoNames.ServicesNamespace(Project), pagedHere: true));
    }
#>
