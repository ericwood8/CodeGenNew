# Restriction checkboxes for BLZ_EssentialGit_v1.tt (see Docs/Reference.md section 3).
# One of the files every Blazor app needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Blazor
EssentialsGroup=Git
Description=.gitignore: bin, obj and the editor folders
