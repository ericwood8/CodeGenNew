@@@FILE <#= componentsFolder #>/screen-with-strip/screen-with-strip.component.ts@@@
import { ChangeDetectionStrategy, Component, Type } from '@angular/core';
import { NgComponentOutlet } from '@angular/common';
import { ActivatedRoute } from '@angular/router';
import { DashboardStripComponent } from '../dashboard-strip/dashboard-strip.component';

// Hosts a table's screen with its strip of cards above it. The route's data names the table and the screen (see the routes TS_Screens writes).
@Component({
  selector: 'app-screen-with-strip',
<#= detection #><#= standalone #>  imports: [NgComponentOutlet, DashboardStripComponent],
  template: `<app-dashboard-strip [table]="table"></app-dashboard-strip><ng-container *ngComponentOutlet="screen"></ng-container>`
})
export class ScreenWithStripComponent {
  readonly table: string;
  readonly screen: Type<unknown>;

  constructor(route: ActivatedRoute) {
    this.table = route.snapshot.data['table'];
    this.screen = route.snapshot.data['screen'];
  }
}
