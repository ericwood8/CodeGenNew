.dash-error { color: #b00020; }
@@@FILE <#= componentsFolder #>/dashboard/dashboard.component.spec.ts@@@
import { TestBed } from '@angular/core/testing';
import { provideHttpClient } from '@angular/common/http';
import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
import { provideRouter } from '@angular/router';

import { DashboardComponent } from './dashboard.component';

describe('DashboardComponent', () => {
  it('shows a card for a count widget and the numbers of a breakdown', async () => {
    await TestBed.configureTestingModule({
      imports: [DashboardComponent],
      providers: [provideHttpClient(), provideHttpClientTesting(), provideRouter([])]
    }).compileComponents();

    const fixture = TestBed.createComponent(DashboardComponent);
    fixture.detectChanges();
    TestBed.inject(HttpTestingController).expectOne('api/dashboard').flush({
      widgets: [
        { id: 'a-count', kind: 'count', title: 'Customers', table: 'Customer', route: 'customer', points: [{ label: 'Customers', value: 51 }], rows: [] },
        { id: 'b-breakdown', kind: 'breakdown', title: 'Customers by Status', table: 'Customer', route: 'customer', points: [{ label: 'Active', value: 40 }, { label: 'Closed', value: 11 }], rows: [] }
      ]
    });
    fixture.detectChanges();

    const text = (fixture.nativeElement as HTMLElement).textContent ?? '';
    expect(text).toContain('Customers');
    expect(text).toContain('51');
    expect(text).toContain('Active');
    expect(text).toContain('40');
  });
});
