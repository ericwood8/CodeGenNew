@@@FILE <#= componentsFolder #>/dashboard-strip/dashboard-strip.component.ts@@@
import { ChangeDetectionStrategy, Component, Input, OnChanges } from '@angular/core';
import { CommonModule } from '@angular/common';
import { DashboardService, DashboardWidget } from '../../<#= servicesFolder #>/dashboard.service';
import { DashboardWidgetComponent } from '../dashboard-widget/dashboard-widget.component';

// The two or three cards of one table, above its grid. A failure shows nothing: the grid below is what the person came for.
@Component({
  selector: 'app-dashboard-strip',
<#= detection #><#= standalone #>  imports: [CommonModule, DashboardWidgetComponent],
  templateUrl: './dashboard-strip.component.html',
  styleUrl: './dashboard-strip.component.css'
})
export class DashboardStripComponent implements OnChanges {
  @Input({ required: true }) table = '';
  widgets: DashboardWidget[] = [];

  constructor(private service: DashboardService) { }

  ngOnChanges(): void {
    this.service.get(this.table).subscribe({
      next: (result) => (this.widgets = result.widgets),
      error: () => (this.widgets = [])
    });
  }
}
@@@FILE <#= componentsFolder #>/dashboard-strip/dashboard-strip.component.html@@@
