<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (folders).
    // ==========================================================================================
    string apiFolder = Project.ApiFolder;
    string modelsFolder = Project.ModelsFolder;
    // ==========================================================================================

    // ==========================================================================================
    // TSX_ODataApi_v1.tt
    // Generates: api/<table>ODataApi.ts for each table the project serves as OData (API_OData, ODataPlan) that has a React screen   (whole-database; the paths are written by the template, point the output folder at the React src folder)
    // A short module on createODataApi (api/odataClient.ts, written by TSX_EssentialOData): the entity set (/odata/<set>), the table's key, the search boxes (the table's SearchPlan filters), the header sorts
    // (a foreign key sorts by its parent's display column when the parent is served as OData too), the order without a sort and the display column of a drop-down, and the REST route a clone goes through.
    // It is the OData twin of TSX_Api: the same model (models/<table>), the same row JSON, another route. TSX_ODataPage (TSX_Page run as its OData form) is the page over it.
    // Full notes: Docs/TemplateNotes/TSX_ODataApi_v1.md
    // ==========================================================================================

    var selection = ODataPlan.For(Database, Project);
    if (selection.Tables.Count == 0)
        Error("TSX_ODataApi found no table served as OData: set OData=true (and ODataTables if only some tables are served).");
    // the tables a header may sort through (a foreign key sorts by its parent's display column): not a table whose rows belong to a person, which no navigation leads into
    var served = selection.Tables.Where(t => !ODataPlan.IsScoped(t, Project)).ToDictionary(t => t.TableName, StringComparer.OrdinalIgnoreCase);

    string Items(IEnumerable<string> items) => string.Join(", ", items.Select(i => "'" + i + "'"));

    var o = new StringBuilder();
    void L(string s = "") => o.Append(s).Append('\n');

    foreach (var table in selection.Tables)
    {
        var keyType = KeyType.Of(table)!;
        var plan = ODataScreenPlan.For(table, Project, served);
        string baseName = BaseName(table.TableName);
        string stem = baseName.ToLowerInvariant();
        string keyGeneric = keyType.Kind == KeyKind.Int ? "" : ", " + keyType.TypeScript;
        L($"@@@FILE {apiFolder}/{ReactNames.ODataApiFile(table.TableName)}.ts@@@");
        L("import { createODataApi } from './odataClient';");
        L($"import type {{ {baseName} }} from '../{modelsFolder}/{stem}';");
        L();
        L($"export const {ReactNames.ODataApiVar(table.TableName)} = createODataApi<{baseName}{keyGeneric}>('{plan.Set}', {{");
        L($"  key: '{plan.KeyProperty}',");
        L($"  filters: [{string.Join(", ", plan.Filters.Select(f => $"{{ key: '{f.Key}', property: '{f.Property}' }}"))}],");
        L($"  sorts: [{string.Join(", ", plan.Sorts.Select(s => $"{{ name: '{s.Name}', path: '{s.Path}' }}"))}],");
        L($"  defaultOrder: [{Items(plan.DefaultOrder)}],");
        if (plan.LookupName is not null)
            L($"  lookup: {{ name: '{plan.LookupName}'" + (plan.LookupActive is null ? "" : $", active: '{plan.LookupActive}'") + " },");
        L($"}}, '/api/{plan.Set}');");
    }
    Write(o.ToString());
#>
