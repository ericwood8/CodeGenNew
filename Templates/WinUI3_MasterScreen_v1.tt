<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS -- the lines to change to use this template in your own project (namespaces, names,
    // folders, lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string viewNamespace = "TimeEntry.Desktop.Views";
    string viewModelNamespace = "TimeEntry.Desktop.ViewModels";
    string contextType = "TimeEntryContext";
    string contextNamespace = "TimeEntry.Common.Data";
    // Namespaces the generated files must "using" beyond the ones every file needs.
    string[] usings = { };
    // Folders under the WinUI3 project root (where -o points) the generated files go in.
    string viewsFolder = "Views";
    // Tables whose Add/Edit dialog is a <Table>DetailMasterDialog (WinUI3_DetailMasterScreen.tt) rather than a plain
    // <Table>DetailDialog -- a list screen or a parent's child grid opens the one that exists.
    string[] detailMasterTables = { };
    string viewModelsFolder = "ViewModels";
    // A foreign key to one of these is shown as a plain id number, not resolved to the parent's name --
    // must match WinUI3_DetailScreen.tt's own noLookupParents so the grid and the form agree on which
    // columns are drop-downs.
    string[] noLookupParents =
    {
        "ClearanceType", "ExpenseType", "LeaveType", "OvertimeType", "SY_Display", "SY_ISOCountry",
        "SY_RequestStatusType", "SY_RequestType", "SY_ResponseType", "SY_Role", "DepartmentTeam", "ProjectTask"
    };
    // A project settings file (Projects\<ProjectName>.config, chosen with --project or in the app) overrides the values above.
    viewNamespace = Project.ViewNamespace ?? viewNamespace;
    viewModelNamespace = Project.ViewModelNamespace ?? viewModelNamespace;
    contextType = Project.ContextName ?? contextType;
    contextNamespace = Project.ContextNamespace ?? contextNamespace;
    usings = Project.Usings ?? usings;
    detailMasterTables = Project.DetailMasterTables ?? detailMasterTables;
    viewsFolder = Project.ViewsFolder ?? viewsFolder;
    viewModelsFolder = Project.ViewModelsFolder ?? viewModelsFolder;
    noLookupParents = Project.NoLookupParents ?? noLookupParents;
    // ==========================================================================================

    // ------------------------------------------------------------------------------------------
    // WinUI3_MasterScreen_v1.tt
    // Generates a WinUI3 Page listing every row of the table -- the "master" of a master/detail pair (see
    // WinUI3_DetailScreen.tt, which this page opens for Add/Edit, and WinUI3_DetailMasterScreen.tt, the
    // detail form's own master-of-its-children alternative):
    //     Views/<TableName>ListPage.xaml         a header row, a grid of rows, Add New / Edit / Delete
    //     Views/<TableName>ListPage.xaml.cs       opens <TableName>DetailDialog, confirms before deleting
    //     ViewModels/<TableName>ListViewModel.cs  loads rows via <TableName>Repo, resolves FK ids to names
    //
    // The grid's columns are exactly WinUI3_DetailScreen.tt's own field list (every column except the primary
    // key, computed and identity columns), so the two screens always agree on what a row looks like. A
    // foreign key column shows the parent's display column (looked up once per parent into a dictionary, the
    // same idea as TS_Component's "name of" methods) instead of the raw id -- unless it's listed in
    // noLookupParents, which shows the id number instead.
    //
    // Not a DataGrid: WinUI3 has none built in without a third-party package this template can't assume your
    // project has, so each row is a plain Grid of TextBlocks with the same column widths as the header, laid
    // out via a generic <TableName>ListRow.Cells list rather than one named XAML property per column -- the
    // only way to keep the number of columns generic (it depends on the table) while still using compiled
    // x:Bind. If you have Community Toolkit's DataGrid or WinUI's TreeView/ListView with grid-style headers
    // already, feel free to replace this with that.
    //
    // Requires a primary key that is a single, non-composite INT column and refuses a "name/active" table
    // (a NOT NULL text Name plus a NOT NULL bit IsActive) -- same restrictions and reasons as
    // WinUI3_DetailScreen.tt, since its repository (NameActiveRepo) has no GetAll for this page to call.
    //
    // What it does NOT do: sorting, or opening from a NavigationView/Frame -- add the Page to your own
    // navigation the way you would any other.
    //
    // Pagination (CodeGenPossibilities\Pagination, research folder): the grid always loads one page at a time
    // through CS_Repo.tt's SearchAsync instead of GetAll(), with a PaginationBar underneath. **Update
    // (2026-09-28):** pagination no longer requires a searchable column -- a table with none (e.g. a
    // monthly-summary table keyed only by ids/numbers) still gets it, found live needing exactly this;
    // pagination and searchability are separate concerns, and SearchAsync already accepts zero filter values.
    //
    // Search (CodeGenPossibilities\Search, research folder): when the table has a searchable column, a plain
    // TextBox per TableModel.SearchableColumns column (AutoSuggestBox was considered and declined -- it's
    // built for incremental single-query autocomplete, not several independent typed filter fields) plus a
    // Search button above the grid, calling ViewModel.LoadAsync() with PageNumber reset to 1. Bespoke per
    // table, like the add/edit form -- there is no shared "search bar" UserControl the way PaginationBar is,
    // since the field list differs per table. A blank field is sent as no filter for that column (every row),
    // not filtered on the empty string. A table with no searchable column gets no search UI at all, but still
    // pages through every row via the plain, unfiltered SearchAsync call.
    //
    // Unlike TS_Component.tt (a real, already-installed Angular Material dependency) there is no comparable
    // WinUI3 library already in a real target project to point at (no real WinUI3 project has ever been
    // checked the way TimeEntryUI/CriticalViewer were -- see Docs/specs.md's own note that none of the three
    // WinUI3 CRUD-screen templates have ever been compiled into a live WinUI3 project). Community Toolkit's
    // DataGrid (CommunityToolkit.WinUI.UI.Controls.DataGrid) is the project owner's chosen future grid
    // control, but swapping the ListView/Cells rendering for it is its own separate follow-up pass, not part
    // of this one -- this pass only adds a PaginationBar under the existing grid, exactly the same scope
    // split TSX_Page.tt/TS_Component.tt made.
    //
    // Grid/toolbar styling (2026-09-27, brushes fixed 2026-09-30): every WinUI3 grid (this page's own row
    // grid and WinUI3_DetailMasterScreen.tt's child grids) is boxed in a ControlStrokeColorSecondaryBrush
    // Border with a line under the header and under every row, so it reads as a table instead of loose rows
    // of text. The Add New/Refresh bar, the search bar, and the pagination bar all share one look -- a
    // SolidBackgroundFillColorSecondaryBrush Border with a matching ControlStrokeColorSecondaryBrush outline
    // -- so the three toolbars read as one family instead of plain unstyled StackPanels. Both are theme
    // resources, so they follow the app's light/dark theme automatically instead of a hardcoded color.
    // Originally used the Card* brushes (CardStrokeColorDefaultBrush/CardBackgroundFillColorDefaultBrush) --
    // switched away 2026-09-30 after a live user report of no visible shading at all: Card* is a near-
    // transparent tint meant to sit on top of another surface, and CardBackgroundFillColorDefault is
    // #B3FFFFFF in the Light theme dictionary (70%-opacity white), invisible over this page's own plain
    // white background. SolidBackgroundFillColorSecondary (#EEEEEE Light / #1C1C1C Dark) is fully opaque and
    // reads as real shading against a plain page background.
    //
    // PaginationBar is NOT generated by this template -- assumed to already exist in the target project's
    // Views folder, a plain, purely-presentational UserControl (all page-number/enabled-state computation
    // lives on the ViewModel, the same ObservableObject/[NotifyPropertyChangedFor] pattern this template
    // already uses for HasError). Referenced through its own "views:" xmlns prefix (viewNamespace), not
    // "local:" -- that prefix is already claimed by viewModelNamespace for <Table>ListRow's own DataTemplate
    // above; reusing it for PaginationBar too silently failed to resolve at compile time (WMC0001: Unknown
    // type 'PaginationBar' in XML namespace '...ViewModels'), found the first time this template was ever
    // compiled against a real WinUI3 project. Add Views/PaginationBar.xaml/.xaml.cs once per project:
    //
    //     <!-- PaginationBar.xaml -->
    //     <UserControl
    //         x:Class="TimeEntry.Desktop.Views.PaginationBar"
    //         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    //         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    //         <StackPanel Orientation="Horizontal" Spacing="8">
    //             <Button Content="Previous" Click="OnPreviousClick" IsEnabled="{x:Bind CanGoPrevious, Mode=OneWay}" />
    //             <TextBlock Text="{x:Bind PageLabel, Mode=OneWay}" VerticalAlignment="Center" />
    //             <Button Content="Next" Click="OnNextClick" IsEnabled="{x:Bind CanGoNext, Mode=OneWay}" />
    //         </StackPanel>
    //     </UserControl>
    //
    //     // PaginationBar.xaml.cs
    //     namespace TimeEntry.Desktop.Views;
    //
    //     public sealed partial class PaginationBar : UserControl
    //     {
    //         public static readonly DependencyProperty PageLabelProperty =
    //             DependencyProperty.Register(nameof(PageLabel), typeof(string), typeof(PaginationBar), new PropertyMetadata(""));
    //         public static readonly DependencyProperty CanGoPreviousProperty =
    //             DependencyProperty.Register(nameof(CanGoPrevious), typeof(bool), typeof(PaginationBar), new PropertyMetadata(false));
    //         public static readonly DependencyProperty CanGoNextProperty =
    //             DependencyProperty.Register(nameof(CanGoNext), typeof(bool), typeof(PaginationBar), new PropertyMetadata(false));
    //
    //         public string PageLabel { get => (string)GetValue(PageLabelProperty); set => SetValue(PageLabelProperty, value); }
    //         public bool CanGoPrevious { get => (bool)GetValue(CanGoPreviousProperty); set => SetValue(CanGoPreviousProperty, value); }
    //         public bool CanGoNext { get => (bool)GetValue(CanGoNextProperty); set => SetValue(CanGoNextProperty, value); }
    //
    //         public event RoutedEventHandler? PreviousClicked;
    //         public event RoutedEventHandler? NextClicked;
    //
    //         public PaginationBar() => InitializeComponent();
    //
    //         private void OnPreviousClick(object sender, RoutedEventArgs e) => PreviousClicked?.Invoke(this, e);
    //         private void OnNextClick(object sender, RoutedEventArgs e) => NextClicked?.Invoke(this, e);
    //     }
    //
    // ------------------------------------------------------------------------------------------

    bool IsDate(ColumnModel c) => c.SqlType is SqlDbType.Date or SqlDbType.DateTime or SqlDbType.DateTime2 or SqlDbType.SmallDateTime;
    bool IsNumber(ColumnModel c) => c.SqlType is SqlDbType.Int or SqlDbType.BigInt or SqlDbType.SmallInt or SqlDbType.TinyInt
        or SqlDbType.Decimal or SqlDbType.Money or SqlDbType.SmallMoney or SqlDbType.Float or SqlDbType.Real;
    bool IsGuid(ColumnModel c) => c.SqlType == SqlDbType.UniqueIdentifier;
    bool IsBit(ColumnModel c) => c.SqlType == SqlDbType.Bit;
    bool IsText(ColumnModel c) => c.SqlType is SqlDbType.Char or SqlDbType.VarChar or SqlDbType.NChar or SqlDbType.NVarChar;
    bool IsEditableType(ColumnModel c) => IsDate(c) || IsNumber(c) || IsGuid(c) || IsBit(c) || IsText(c);
    string Words(string s) => Regex.Replace(s.Replace('_', ' '), "(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])", " ").Trim();
    string Label(string columnName) => Words(Regex.Replace(Regex.Replace(columnName, "^SY_", ""), "Id$", ""));
    string FieldVar(string name) => char.ToLowerInvariant(name[0]) + name[1..];

    var keyColumn = Model.PrimaryKeyColumns.Count == 1 ? Model.PrimaryKeyColumns[0] : null;
    bool isNameActive = Model.Columns.Any(c => c.IsStringColumn && !c.IsNullable && c.Name == "Name")
                      && Model.Columns.Any(c => c.SqlType == SqlDbType.Bit && !c.IsNullable && c.Name == "IsActive");

    if (keyColumn is null || keyColumn.SqlType != SqlDbType.Int)
    {
        Error($"WinUI3_MasterScreen needs a table with a single int primary key (CS_Repo's GenericRepo<T> takes a plain int id), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else if (isNameActive)
    {
        Error($"WinUI3_MasterScreen is for plain tables. [{Model.SchemaName}].[{Model.TableName}] has a Name and an IsActive column, so its repository is a NameActiveRepo (no GetAll); write this screen by hand.");
    }
    else
    {
        string table = Model.TableName;
        string title = Words(table);
        // The dialog Add/Edit opens: the table's Detail-Master dialog when it has one (detailMasterTables), else its plain Detail dialog.
        string editDialog = table + (detailMasterTables.Contains(table, StringComparer.OrdinalIgnoreCase) ? "DetailMasterDialog" : "DetailDialog");
        string keyProp = keyColumn.Name;
        int pageSize = 20;
        // One TextBox + one ViewModel filter property per searchable column, in the same order as
        // Model.SearchableColumns (matching TS_Component.tt/TSX_Page.tt). Field/Prop follow the same
        // "_lowerFirst(Name)" -> "Name" ObservableProperty round-trip PageNumber/TotalPages already use, just
        // with a Filter suffix. SearchAsync's own parameters (CS_Repo.tt) are passed by name, not position, so
        // this list's order only affects the TextBoxes' left-to-right layout, not correctness. Empty for a
        // table with no searchable column -- canSearch below gates the search bar UI specifically;
        // pagination itself is unconditional (see the header comment's 2026-09-28 update).
        var searchFields = Model.SearchableColumns
            .Select(c => new { Field = FieldVar(c.Name) + "Filter", Prop = c.Name + "Filter", ParamName = FieldVar(c.Name), Label = Label(c.Name) })
            .ToList();
        bool canSearch = searchFields.Count > 0;
        int errorRow = canSearch ? 3 : 2;
        int gridRow = canSearch ? 4 : 3;

        // GroupBy + First, not ToDictionary: a real table can have more than one FK constraint on the same
        // column pointing at the same parent (seen live against a second production database's dbo.Products
        // table) -- ToDictionary would throw on the duplicate key.
        var fkByColumn = Model.ForeignKeys.Where(f => f.ReferencingColumns.Count == 1)
            .GroupBy(f => f.ReferencingColumns[0], StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        var shown = Model.Columns
            .Where(c => !c.IsPrimaryKey && !c.IsComputed && !c.IsIdentity && IsEditableType(c))
            .OrderBy(c => c.OrdinalPosition)
            .ToList();

        ForeignKeyModel LookupOf(ColumnModel c) =>
            c.SqlType == SqlDbType.Int
            && fkByColumn.TryGetValue(c.Name, out var fk)
            && !noLookupParents.Contains(fk.ReferencedTable, StringComparer.OrdinalIgnoreCase)
            && fk.ReferencedDisplayColumns.Count > 0
                ? fk : null;

        var parents = shown.Select(c => LookupOf(c)).Where(fk => fk is not null)
            .GroupBy(fk => fk.ReferencedTable, StringComparer.OrdinalIgnoreCase).Select(g => g.First())
            .Select(fk => new
            {
                Table = fk.ReferencedTable,
                NamesDictionary = FieldVar(fk.ReferencedTable) + "Names",
                KeyProp = fk.ReferencedColumns[0],
                DisplayProp = fk.ReferencedDisplayColumns[0]
            }).ToList();
        var parentOf = parents.ToDictionary(p => p.Table, StringComparer.OrdinalIgnoreCase);

        if (!Model.HasReferencedDisplayColumns && parents.Count > 0)
            Error("WinUI3_MasterScreen needs the foreign-keyed tables' display columns; its .tt.config must say NeedsReferencedDisplayColumns=true.");

        int columnCount = shown.Count + 1; // +1 for the Edit/Delete actions column
#>
@@@FILE <#= viewsFolder #>/<#= table #>ListPage.xaml@@@
<Page
    x:Class="<#= viewNamespace #>.<#= table #>ListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:<#= viewModelNamespace #>"
    xmlns:views="using:<#= viewNamespace #>">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
<#
        if (canSearch)
        {
#>
            <RowDefinition Height="Auto" />
<#
        }
#>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="<#= title.Pluralize() #>" Style="{ThemeResource TitleTextBlockStyle}" />

        <!-- Add New / Refresh bar, shaded to match the search bar below (same Border style). Uses
             SolidBackgroundFillColorSecondaryBrush/ControlStrokeColorSecondaryBrush, not the Card* brushes —
             Card* is a near-transparent "barely there" tint meant to sit on top of another surface, and on
             this page's own plain white/black background it rendered as no visible shading at all (confirmed
             against the WindowsAppSDK's own generic.xaml: CardBackgroundFillColorDefault is #B3FFFFFF in the
             Light dictionary: 70%-opacity white over an already-white page), found live (2026-09-30). -->
        <Border Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Add New" Click="OnAddClick" />
                <Button Content="Refresh" Click="OnRefreshClick" />
            </StackPanel>
        </Border>
<#
        if (canSearch)
        {
#>

        <!-- Search bar, shaded to match the Add New / Refresh bar above -->
        <Border Grid.Row="2" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
<#
            foreach (var f in searchFields)
            {
#>
                <TextBox Width="160" PlaceholderText="<#= f.Label #>" Text="{x:Bind ViewModel.<#= f.Prop #>, Mode=TwoWay}" />
<#
            }
#>
                <Button Content="Search" Click="OnSearchClick" />
            </StackPanel>
        </Border>
<#
        }
#>

        <InfoBar Grid.Row="<#= errorRow #>" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />

        <!-- Row 0 must stay "*" (not Auto): this Grid sits in the page's own last row, itself "*", so row 0
             needs a real bound to hand the ListView below — Auto here made the Border/ListView size to ALL
             of its content with nothing capping it, pushing the pagination row off the bottom of the window
             instead of leaving it visible ("as if the grid was not capped off"), found live (2026-09-30). -->
        <Grid Grid.Row="<#= gridRow #>" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header + rows, boxed in a line around the grid with a line between each row -->
            <Border Grid.Row="0" BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="0,0,0,1" Padding="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
<#
        for (int i = 0; i < columnCount; i++)
        {
#>
                                <ColumnDefinition Width="<#= i == columnCount - 1 ? "160" : "*" #>" />
<#
        }
#>
                            </Grid.ColumnDefinitions>
<#
        for (int i = 0; i < shown.Count; i++)
        {
#>
                            <TextBlock Grid.Column="<#= i #>" Text="<#= Label(shown[i].Name) #>" FontWeight="SemiBold" />
<#
        }
#>
                            <TextBlock Grid.Column="<#= shown.Count #>" Text="Actions" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="Single" Padding="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:<#= table #>ListRow">
                                <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="0,0,0,1" Padding="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
<#
        for (int i = 0; i < columnCount; i++)
        {
#>
                                            <ColumnDefinition Width="<#= i == columnCount - 1 ? "160" : "*" #>" />
<#
        }
#>
                                        </Grid.ColumnDefinitions>
<#
        for (int i = 0; i < shown.Count; i++)
        {
#>
                                        <TextBlock Grid.Column="<#= i #>" Text="{x:Bind Cells[<#= i #>]}" VerticalAlignment="Center" />
<#
        }
#>
                                        <StackPanel Grid.Column="<#= shown.Count #>" Orientation="Horizontal" Spacing="4">
                                            <Button Content="Edit" Tag="{x:Bind Id}" Click="OnEditClick" />
                                            <Button Content="Delete" Tag="{x:Bind Id}" Click="OnDeleteClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Pagination, shaded to match the Add New / Refresh and search bars -->
            <Border Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                <views:PaginationBar
                    PageLabel="{x:Bind ViewModel.PageLabel, Mode=OneWay}"
                    CanGoPrevious="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                    CanGoNext="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                    PreviousClicked="OnPreviousClick"
                    NextClicked="OnNextClick" />
            </Border>
        </Grid>
    </Grid>
</Page>
@@@FILE <#= viewsFolder #>/<#= table #>ListPage.xaml.cs@@@
using <#= viewModelNamespace #>;
using <#= contextNamespace #>;
using Microsoft.UI.Xaml.Controls;
<#
        foreach (string u in usings)
        {
#>
using <#= u #>;
<#
        }
#>

namespace <#= viewNamespace #>;

// Assumes nothing from CodeGenNew.App itself -- a plain Page, no shared house-style helper or navigation
// framework. Add it to your own NavigationView/Frame the way you would any other Page.
public sealed partial class <#= table #>ListPage : Page
{
    private readonly <#= contextType #> _context;
    public <#= table #>ListViewModel ViewModel { get; }

    public <#= table #>ListPage(<#= contextType #> context)
    {
        _context = context;
        ViewModel = new <#= table #>ListViewModel(context);
        InitializeComponent();
        Loaded += async (_, _) => await ViewModel.LoadAsync();
    }

    private async void OnAddClick(object sender, RoutedEventArgs e)
    {
        var dialog = new <#= editDialog #>(_context) { XamlRoot = XamlRoot };
        await dialog.ShowAsync();
        await ViewModel.LoadAsync();
    }

    // The XAML's own "Refresh" button (Click="OnRefreshClick") had no matching handler here at all -- a real,
    // always-present compile error for every table, found the first time this template was ever compiled
    // against a real WinUI3 project.
    private async void OnRefreshClick(object sender, RoutedEventArgs e) => await ViewModel.LoadAsync();

    private async void OnEditClick(object sender, RoutedEventArgs e)
    {
        int id = (int)((Button)sender).Tag;
        var entity = await _context.Set<<#= table #>>().FindAsync(id);
        if (entity is null)
            return;

        var dialog = new <#= editDialog #>(_context, entity) { XamlRoot = XamlRoot };
        await dialog.ShowAsync();
        await ViewModel.LoadAsync();
    }

    private async void OnDeleteClick(object sender, RoutedEventArgs e)
    {
        int id = (int)((Button)sender).Tag;
        var confirm = new ContentDialog
        {
            XamlRoot = XamlRoot,
            Title = "Delete <#= title #>?",
            Content = "This cannot be undone.",
            PrimaryButtonText = "Delete",
            CloseButtonText = "Cancel",
            DefaultButton = ContentDialogButton.Close
        };
        if (await confirm.ShowAsync() != ContentDialogResult.Primary)
            return;

        await ViewModel.DeleteAsync(id);
    }

    private async void OnPreviousClick(object sender, RoutedEventArgs e) => await ViewModel.PreviousPageAsync();

    private async void OnNextClick(object sender, RoutedEventArgs e) => await ViewModel.NextPageAsync();
<#
        if (canSearch)
        {
#>

    private async void OnSearchClick(object sender, RoutedEventArgs e)
    {
        ViewModel.PageNumber = 1;
        await ViewModel.LoadAsync();
    }
<#
        }
#>
}
@@@FILE <#= viewModelsFolder #>/<#= table #>ListViewModel.cs@@@
using System.Collections.Generic;
using System.Collections.ObjectModel;
using System.Threading.Tasks;
using <#= contextNamespace #>;
using CommunityToolkit.Mvvm.ComponentModel;
<#
        if (parents.Count > 0)
        {
#>
using Microsoft.EntityFrameworkCore;
<#
        }
        foreach (string u in usings)
        {
#>
using <#= u #>;
<#
        }
#>

namespace <#= viewModelNamespace #>;

/// <summary> One row of <#= table #>ListPage's grid: the row's id (for the Edit/Delete buttons) plus one
/// display string per WinUI3_DetailScreen.tt field, in the same order as the page's header. </summary>
public class <#= table #>ListRow
{
    public int Id { get; init; }
    public List<string> Cells { get; init; } = [];
}

public partial class <#= table #>ListViewModel : ObservableObject
{
    private readonly <#= contextType #> _context;
    private readonly <#= table #>Repo _repo;

    public ObservableCollection<<#= table #>ListRow> Rows { get; } = [];

    [NotifyPropertyChangedFor(nameof(HasError))]
    [ObservableProperty]
    private string? _errorMessage;
    public bool HasError => ErrorMessage is not null;

    private const int PageSize = <#= pageSize #>;

    [NotifyPropertyChangedFor(nameof(CanGoPrevious))]
    [NotifyPropertyChangedFor(nameof(CanGoNext))]
    [NotifyPropertyChangedFor(nameof(PageLabel))]
    [ObservableProperty]
    private int _pageNumber = 1;

    [NotifyPropertyChangedFor(nameof(CanGoPrevious))]
    [NotifyPropertyChangedFor(nameof(CanGoNext))]
    [NotifyPropertyChangedFor(nameof(PageLabel))]
    [ObservableProperty]
    private int _totalPages = 1;

    public bool CanGoPrevious => PageNumber > 1;
    public bool CanGoNext => PageNumber < TotalPages;
    public string PageLabel => $"Page {PageNumber} of {TotalPages}";
<#
        foreach (var f in searchFields)
        {
#>

    [ObservableProperty]
    private string _<#= f.Field #> = "";
<#
        }
#>

    public <#= table #>ListViewModel(<#= contextType #> context)
    {
        _context = context;
        _repo = new <#= table #>Repo(context);
    }

    public async Task LoadAsync()
    {
        ErrorMessage = null;
        Rows.Clear();

<#
        foreach (var p in parents)
        {
#>
        var <#= p.NamesDictionary #> = await _context.Set<<#= p.Table #>>().ToDictionaryAsync(r => r.<#= p.KeyProp #>, r => r.<#= p.DisplayProp #>?.ToString() ?? "");
<#
        }
#>

<#
        string filterArgs = string.Concat(searchFields.Select(f => $"{f.ParamName}: string.IsNullOrWhiteSpace({f.Prop}) ? null : {f.Prop}, "));
#>
        var (rows, totalCount) = await _repo.SearchAsync(<#= filterArgs #>pageNumber: PageNumber, pageSize: PageSize);
        TotalPages = totalCount == 0 ? 0 : (int)Math.Ceiling(totalCount / (double)PageSize);

        foreach (var e in rows)
        {
            var cells = new List<string>();
<#
        foreach (var c in shown)
        {
            var lookup = LookupOf(c);
            string prop = c.Name;
            string varName = FieldVar(prop);
            if (lookup is not null)
            {
                var p = parentOf[lookup.ReferencedTable];
                if (c.IsNullable)
                {
#>
            cells.Add(e.<#= prop #> is int <#= varName #>Id && <#= p.NamesDictionary #>.TryGetValue(<#= varName #>Id, out var <#= varName #>Name) ? <#= varName #>Name : "");
<#
                }
                else
                {
#>
            cells.Add(<#= p.NamesDictionary #>.TryGetValue(e.<#= prop #>, out var <#= varName #>Name) ? <#= varName #>Name : e.<#= prop #>.ToString());
<#
                }
            }
            else if (IsBit(c))
            {
                if (c.IsNullable)
                {
#>
            cells.Add(e.<#= prop #> switch { true => "Yes", false => "No", null => "" });
<#
                }
                else
                {
#>
            cells.Add(e.<#= prop #> ? "Yes" : "No");
<#
                }
            }
            else if (IsDate(c))
            {
#>
            cells.Add(e.<#= prop #><#= c.IsNullable ? "?.ToString(\"MM/dd/yyyy\") ?? \"\"" : ".ToString(\"MM/dd/yyyy\")" #>);
<#
            }
            else if (IsText(c))
            {
#>
            cells.Add(e.<#= prop #><#= c.IsNullable ? " ?? \"\"" : "" #>);
<#
            }
            else // number or Guid
            {
#>
            cells.Add(e.<#= prop #><#= c.IsNullable ? "?.ToString() ?? \"\"" : ".ToString()" #>);
<#
            }
        }
#>
            Rows.Add(new <#= table #>ListRow { Id = e.<#= keyProp #>, Cells = cells });
        }
    }

    public async Task DeleteAsync(int id)
    {
        ErrorMessage = null;
        int result = await _repo.DeleteAsync("<#= table #>", id);
        if (result == 0)
            await LoadAsync();
        else if (result == -1)
            ErrorMessage = "This row no longer exists."; // avoids guessing singular/plural from a table name like "Products"
        else
            ErrorMessage = "This row cannot be deleted because it is in use.";
    }

    public async Task PreviousPageAsync()
    {
        if (!CanGoPrevious) return;
        PageNumber--;
        await LoadAsync();
    }

    public async Task NextPageAsync()
    {
        if (!CanGoNext) return;
        PageNumber++;
        await LoadAsync();
    }
}
