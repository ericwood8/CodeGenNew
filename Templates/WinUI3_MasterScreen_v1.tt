<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS -- the lines to change to use this template in your own project (namespaces, names,
    // folders, lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string viewNamespace = "TimeEntry.Desktop.Views";
    string viewModelNamespace = "TimeEntry.Desktop.ViewModels";
    string contextType = "TimeEntryContext";
    string contextNamespace = "TimeEntry.Common.Data";
    // Namespaces the generated files must "using" beyond the ones every file needs.
    string[] usings = { };
    // Folders under the WinUI3 project root (where -o points) the generated files go in.
    string viewsFolder = "Views";
    string viewModelsFolder = "ViewModels";
    // A foreign key to one of these is shown as a plain id number, not resolved to the parent's name --
    // must match WinUI3_DetailScreen.tt's own noLookupParents so the grid and the form agree on which
    // columns are drop-downs.
    string[] noLookupParents =
    {
        "ClearanceType", "ExpenseType", "LeaveType", "OvertimeType", "SY_Display", "SY_ISOCountry",
        "SY_RequestStatusType", "SY_RequestType", "SY_ResponseType", "SY_Role", "DepartmentTeam", "ProjectTask"
    };
    // ==========================================================================================

    // ------------------------------------------------------------------------------------------
    // WinUI3_MasterScreen_v1.tt
    // Generates a WinUI3 Page listing every row of the table -- the "master" of a master/detail pair (see
    // WinUI3_DetailScreen.tt, which this page opens for Add/Edit, and WinUI3_DetailMasterScreen.tt, the
    // detail form's own master-of-its-children alternative):
    //     Views/<TableName>ListPage.xaml         a header row, a grid of rows, Add New / Edit / Delete
    //     Views/<TableName>ListPage.xaml.cs       opens <TableName>DetailDialog, confirms before deleting
    //     ViewModels/<TableName>ListViewModel.cs  loads rows via <TableName>Repo, resolves FK ids to names
    //
    // The grid's columns are exactly WinUI3_DetailScreen.tt's own field list (every column except the primary
    // key, computed and identity columns), so the two screens always agree on what a row looks like. A
    // foreign key column shows the parent's display column (looked up once per parent into a dictionary, the
    // same idea as TS_Component's "name of" methods) instead of the raw id -- unless it's listed in
    // noLookupParents, which shows the id number instead.
    //
    // Not a DataGrid: WinUI3 has none built in without a third-party package this template can't assume your
    // project has, so each row is a plain Grid of TextBlocks with the same column widths as the header, laid
    // out via a generic <TableName>ListRow.Cells list rather than one named XAML property per column -- the
    // only way to keep the number of columns generic (it depends on the table) while still using compiled
    // x:Bind. If you have Community Toolkit's DataGrid or WinUI's TreeView/ListView with grid-style headers
    // already, feel free to replace this with that.
    //
    // Requires a primary key that is a single, non-composite INT column and refuses a "name/active" table
    // (a NOT NULL text Name plus a NOT NULL bit IsActive) -- same restrictions and reasons as
    // WinUI3_DetailScreen.tt, since its repository (NameActiveRepo) has no GetAll for this page to call.
    //
    // What it does NOT do: paging or sorting (loads every row, like TS_Component.tt), search, or opening from
    // a NavigationView/Frame -- add the Page to your own navigation the way you would any other.
    //
    // ------------------------------------------------------------------------------------------

    bool IsDate(ColumnModel c) => c.SqlType is SqlDbType.Date or SqlDbType.DateTime or SqlDbType.DateTime2 or SqlDbType.SmallDateTime;
    bool IsNumber(ColumnModel c) => c.SqlType is SqlDbType.Int or SqlDbType.BigInt or SqlDbType.SmallInt or SqlDbType.TinyInt
        or SqlDbType.Decimal or SqlDbType.Money or SqlDbType.SmallMoney or SqlDbType.Float or SqlDbType.Real;
    bool IsGuid(ColumnModel c) => c.SqlType == SqlDbType.UniqueIdentifier;
    bool IsBit(ColumnModel c) => c.SqlType == SqlDbType.Bit;
    bool IsText(ColumnModel c) => c.SqlType is SqlDbType.Char or SqlDbType.VarChar or SqlDbType.NChar or SqlDbType.NVarChar;
    bool IsEditableType(ColumnModel c) => IsDate(c) || IsNumber(c) || IsGuid(c) || IsBit(c) || IsText(c);
    string Words(string s) => Regex.Replace(s.Replace('_', ' '), "(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])", " ").Trim();
    string Label(string columnName) => Words(Regex.Replace(Regex.Replace(columnName, "^SY_", ""), "Id$", ""));
    string FieldVar(string name) => char.ToLowerInvariant(name[0]) + name[1..];

    var keyColumn = Model.PrimaryKeyColumns.Count == 1 ? Model.PrimaryKeyColumns[0] : null;
    bool isNameActive = Model.Columns.Any(c => c.IsStringColumn && !c.IsNullable && c.Name == "Name")
                      && Model.Columns.Any(c => c.SqlType == SqlDbType.Bit && !c.IsNullable && c.Name == "IsActive");

    if (keyColumn is null || keyColumn.SqlType != SqlDbType.Int)
    {
        Error($"WinUI3_MasterScreen needs a table with a single int primary key (CS_Repo's GenericRepo<T> takes a plain int id), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else if (isNameActive)
    {
        Error($"WinUI3_MasterScreen is for plain tables. [{Model.SchemaName}].[{Model.TableName}] has a Name and an IsActive column, so its repository is a NameActiveRepo (no GetAll); write this screen by hand.");
    }
    else
    {
        string table = Model.TableName;
        string title = Words(table);
        string keyProp = keyColumn.Name;

        // GroupBy + First, not ToDictionary: a real table can have more than one FK constraint on the same
        // column pointing at the same parent (seen live against ProvidenceOgas.dbo.Products) -- ToDictionary
        // would throw on the duplicate key.
        var fkByColumn = Model.ForeignKeys.Where(f => f.ReferencingColumns.Count == 1)
            .GroupBy(f => f.ReferencingColumns[0], StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        var shown = Model.Columns
            .Where(c => !c.IsPrimaryKey && !c.IsComputed && !c.IsIdentity && IsEditableType(c))
            .OrderBy(c => c.OrdinalPosition)
            .ToList();

        ForeignKeyModel LookupOf(ColumnModel c) =>
            c.SqlType == SqlDbType.Int
            && fkByColumn.TryGetValue(c.Name, out var fk)
            && !noLookupParents.Contains(fk.ReferencedTable, StringComparer.OrdinalIgnoreCase)
            && fk.ReferencedDisplayColumns.Count > 0
                ? fk : null;

        var parents = shown.Select(c => LookupOf(c)).Where(fk => fk is not null)
            .GroupBy(fk => fk.ReferencedTable, StringComparer.OrdinalIgnoreCase).Select(g => g.First())
            .Select(fk => new
            {
                Table = fk.ReferencedTable,
                NamesDictionary = FieldVar(fk.ReferencedTable) + "Names",
                KeyProp = fk.ReferencedColumns[0],
                DisplayProp = fk.ReferencedDisplayColumns[0]
            }).ToList();
        var parentOf = parents.ToDictionary(p => p.Table, StringComparer.OrdinalIgnoreCase);

        if (!Model.HasReferencedDisplayColumns && parents.Count > 0)
            Error("WinUI3_MasterScreen needs the foreign-keyed tables' display columns; its .tt.config must say NeedsReferencedDisplayColumns=true.");

        int columnCount = shown.Count + 1; // +1 for the Edit/Delete actions column
#>
@@@FILE <#= viewsFolder #>/<#= table #>ListPage.xaml@@@
<Page
    x:Class="<#= viewNamespace #>.<#= table #>ListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:<#= viewModelNamespace #>">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="<#= title #>s" Style="{ThemeResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Add New" Click="OnAddClick" />
            <Button Content="Refresh" Click="OnRefreshClick" />
        </StackPanel>

        <InfoBar Grid.Row="2" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />

        <Grid Grid.Row="3" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
<#
        for (int i = 0; i < columnCount; i++)
        {
#>
                    <ColumnDefinition Width="<#= i == columnCount - 1 ? "160" : "*" #>" />
<#
        }
#>
                </Grid.ColumnDefinitions>
<#
        for (int i = 0; i < shown.Count; i++)
        {
#>
                <TextBlock Grid.Column="<#= i #>" Text="<#= Label(shown[i].Name) #>" FontWeight="SemiBold" />
<#
        }
#>
                <TextBlock Grid.Column="<#= shown.Count #>" Text="Actions" FontWeight="SemiBold" />
            </Grid>

            <!-- Rows -->
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:<#= table #>ListRow">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
<#
        for (int i = 0; i < columnCount; i++)
        {
#>
                                <ColumnDefinition Width="<#= i == columnCount - 1 ? "160" : "*" #>" />
<#
        }
#>
                            </Grid.ColumnDefinitions>
<#
        for (int i = 0; i < shown.Count; i++)
        {
#>
                            <TextBlock Grid.Column="<#= i #>" Text="{x:Bind Cells[<#= i #>]}" VerticalAlignment="Center" />
<#
        }
#>
                            <StackPanel Grid.Column="<#= shown.Count #>" Orientation="Horizontal" Spacing="4">
                                <Button Content="Edit" Tag="{x:Bind Id}" Click="OnEditClick" />
                                <Button Content="Delete" Tag="{x:Bind Id}" Click="OnDeleteClick" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
@@@FILE <#= viewsFolder #>/<#= table #>ListPage.xaml.cs@@@
using <#= viewModelNamespace #>;
using <#= contextNamespace #>;
using Microsoft.UI.Xaml.Controls;
<#
        foreach (string u in usings)
        {
#>
using <#= u #>;
<#
        }
#>

namespace <#= viewNamespace #>;

// Assumes nothing from CodeGenNew.App itself -- a plain Page, no shared house-style helper or navigation
// framework. Add it to your own NavigationView/Frame the way you would any other Page.
public sealed partial class <#= table #>ListPage : Page
{
    private readonly <#= contextType #> _context;
    public <#= table #>ListViewModel ViewModel { get; }

    public <#= table #>ListPage(<#= contextType #> context)
    {
        _context = context;
        ViewModel = new <#= table #>ListViewModel(context);
        InitializeComponent();
        Loaded += async (_, _) => await ViewModel.LoadAsync();
    }

    private async void OnAddClick(object sender, RoutedEventArgs e)
    {
        var dialog = new <#= table #>DetailDialog(_context) { XamlRoot = XamlRoot };
        await dialog.ShowAsync();
        await ViewModel.LoadAsync();
    }

    private async void OnEditClick(object sender, RoutedEventArgs e)
    {
        int id = (int)((Button)sender).Tag;
        var entity = await _context.Set<<#= table #>>().FindAsync(id);
        if (entity is null)
            return;

        var dialog = new <#= table #>DetailDialog(_context, entity) { XamlRoot = XamlRoot };
        await dialog.ShowAsync();
        await ViewModel.LoadAsync();
    }

    private async void OnDeleteClick(object sender, RoutedEventArgs e)
    {
        int id = (int)((Button)sender).Tag;
        var confirm = new ContentDialog
        {
            XamlRoot = XamlRoot,
            Title = "Delete <#= title #>?",
            Content = "This cannot be undone.",
            PrimaryButtonText = "Delete",
            CloseButtonText = "Cancel",
            DefaultButton = ContentDialogButton.Close
        };
        if (await confirm.ShowAsync() != ContentDialogResult.Primary)
            return;

        await ViewModel.DeleteAsync(id);
    }
}
@@@FILE <#= viewModelsFolder #>/<#= table #>ListViewModel.cs@@@
using System.Collections.Generic;
using System.Collections.ObjectModel;
using System.Threading.Tasks;
using <#= contextNamespace #>;
using CommunityToolkit.Mvvm.ComponentModel;
using Microsoft.EntityFrameworkCore;
<#
        foreach (string u in usings)
        {
#>
using <#= u #>;
<#
        }
#>

namespace <#= viewModelNamespace #>;

/// <summary> One row of <#= table #>ListPage's grid: the row's id (for the Edit/Delete buttons) plus one
/// display string per WinUI3_DetailScreen.tt field, in the same order as the page's header. </summary>
public class <#= table #>ListRow
{
    public int Id { get; init; }
    public List<string> Cells { get; init; } = [];
}

public partial class <#= table #>ListViewModel : ObservableObject
{
    private readonly <#= contextType #> _context;
    private readonly <#= table #>Repo _repo;

    public ObservableCollection<<#= table #>ListRow> Rows { get; } = [];

    [NotifyPropertyChangedFor(nameof(HasError))]
    [ObservableProperty]
    private string? _errorMessage;
    public bool HasError => ErrorMessage is not null;

    public <#= table #>ListViewModel(<#= contextType #> context)
    {
        _context = context;
        _repo = new <#= table #>Repo(context);
    }

    public async Task LoadAsync()
    {
        ErrorMessage = null;
        Rows.Clear();

<#
        foreach (var p in parents)
        {
#>
        var <#= p.NamesDictionary #> = await _context.Set<<#= p.Table #>>().ToDictionaryAsync(r => r.<#= p.KeyProp #>, r => r.<#= p.DisplayProp #>?.ToString() ?? "");
<#
        }
#>

        foreach (var e in await _repo.GetAll())
        {
            var cells = new List<string>();
<#
        foreach (var c in shown)
        {
            var lookup = LookupOf(c);
            string prop = c.Name;
            string varName = FieldVar(prop);
            if (lookup is not null)
            {
                var p = parentOf[lookup.ReferencedTable];
                if (c.IsNullable)
                {
#>
            cells.Add(e.<#= prop #> is int <#= varName #>Id && <#= p.NamesDictionary #>.TryGetValue(<#= varName #>Id, out var <#= varName #>Name) ? <#= varName #>Name : "");
<#
                }
                else
                {
#>
            cells.Add(<#= p.NamesDictionary #>.TryGetValue(e.<#= prop #>, out var <#= varName #>Name) ? <#= varName #>Name : e.<#= prop #>.ToString());
<#
                }
            }
            else if (IsBit(c))
            {
                if (c.IsNullable)
                {
#>
            cells.Add(e.<#= prop #> switch { true => "Yes", false => "No", null => "" });
<#
                }
                else
                {
#>
            cells.Add(e.<#= prop #> ? "Yes" : "No");
<#
                }
            }
            else if (IsDate(c))
            {
#>
            cells.Add(e.<#= prop #><#= c.IsNullable ? "?.ToString(\"MM/dd/yyyy\") ?? \"\"" : ".ToString(\"MM/dd/yyyy\")" #>);
<#
            }
            else if (IsText(c))
            {
#>
            cells.Add(e.<#= prop #><#= c.IsNullable ? " ?? \"\"" : "" #>);
<#
            }
            else // number or Guid
            {
#>
            cells.Add(e.<#= prop #><#= c.IsNullable ? "?.ToString() ?? \"\"" : ".ToString()" #>);
<#
            }
        }
#>
            Rows.Add(new <#= table #>ListRow { Id = e.<#= keyProp #>, Cells = cells });
        }
    }

    public async Task DeleteAsync(int id)
    {
        ErrorMessage = null;
        int result = await _repo.DeleteAsync("<#= table #>", id);
        if (result == 0)
            await LoadAsync();
        else if (result == -1)
            ErrorMessage = "This row no longer exists."; // avoids guessing singular/plural from a table name like "Products"
        else
            ErrorMessage = "This row cannot be deleted because it is in use.";
    }
}
<#
    }
#>
