<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // folders, lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string viewNamespace = "MyApp.Desktop.Views";
    string viewModelNamespace = "MyApp.Desktop.ViewModels";
    string contextType = "MyAppContext";
    string contextNamespace = "MyApp.Common.Data";
    // Namespaces the generated files must "using" beyond the ones every file needs.
    string[] usings = { };
    // Folders under the WinUI3 project root (where -o points) the generated files go in.
    string viewsFolder = "Views";
    string viewModelsFolder = "ViewModels";
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    viewNamespace = Project.ViewNamespace ?? viewNamespace;
    viewModelNamespace = Project.ViewModelNamespace ?? viewModelNamespace;
    contextType = Project.ContextName ?? contextType;
    contextNamespace = Project.ContextNamespace ?? contextNamespace;
    usings = Project.Usings ?? usings;
    viewsFolder = Project.ViewsFolder ?? viewsFolder;
    viewModelsFolder = Project.ViewModelsFolder ?? viewModelsFolder;
    // ==========================================================================================

    // ==========================================================================================
    // WinUI3_MasterScreen_v1.tt
    // Generates: Views/<Table>ListPage.xaml and .xaml.cs, ViewModels/<Table>ListViewModel.cs, Views/PaginationBar
    // A page listing the table's rows: sortable headers, search bar, paging, Add New and Edit / Clone / Delete per row, resolving foreign keys to the
    // parent's display column. A plain Grid of TextBlocks (WinUI3 has no built-in DataGrid) with the same widths as the header. Opens <Table>DetailDialog
    // (WinUI3_DetailScreen) or <Table>DetailMasterDialog (WinUI3_DetailMasterScreen) for Add and Edit.
    // A table with a NOT NULL Name and a NOT NULL IsActive column reads through its repository's SearchAsync, which pages the whole list in memory (CS_Repo); its search bar has an Active only check box
    // besides the text boxes, and it has no Clone button.
    // Full notes: Docs/TemplateNotes/WinUI3_MasterScreen_v1.md
    // ==========================================================================================


    var form = FormModel.For(Model, Project);   // what the screen is made of, decided in Core for every stack
    var keyColumn = form.KeyColumn;
    bool isNameActive = form.IsNameActive;

    var keyType = form.KeyType;   // how the key travels: its C# type (int, long, Guid or string) is the type of the row id and of the Edit / Delete buttons' Tag
    if (keyColumn is null || keyType is null)
    {
        Error($"WinUI3_MasterScreen needs a table with a single int, uniqueidentifier or text primary key (CS_Repo's GenericRepo<T, TKey> takes it as the id), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else
    {
        string table = Model.TableName;
        string title = form.Title;
        // The dialog Add and Edit open: the Detail-Master dialog when DatabaseModel.IsDetailMaster says the table has one, else the plain Detail dialog.
        string editDialog = table + (DatabaseModel.IsDetailMaster(Model, Project) ? "DetailMasterDialog" : "DetailDialog");
        string keyProp = keyColumn.Name;
        string keyCs = keyType.CSharp;
        bool textKey = form.TypedKey;   // the key is a column of the grid: the person typed it and it means something
        int pageSize = 20;
        // One TextBox and one view-model filter property per searchable column (and per typed key). SearchAsync takes them by name,
        // so the order only sets the boxes' left-to-right layout. Without any, canSearch hides the search bar; paging is always on.
        var searchFields = DesktopGridCode.SearchBoxes(form);
        // a drop-down of the parent's rows per whole-number foreign key: an exact match on the key (the first entry, "All", is no filter)
        var searchKeys = DesktopGridCode.KeyFilters(form);
        bool canSearch = searchFields.Count > 0 || searchKeys.Count > 0 || isNameActive;   // a name / active table's search bar also has the Active only check box
        int errorRow = canSearch ? 3 : 2;
        int gridRow = canSearch ? 4 : 3;

        // At most 20 columns, no long text (see GridColumns for when multi-line text is let in).
        var shown = form.GridColumns;

        var parents = form.ParentsOf(shown);
        // a parent with too many rows for a drop-down is found by typing: the filter is an AutoSuggestBox that asks the context for the rows whose text contains what was typed, and the grid reads
        // only the names of the rows it shows
        var aheadParents = parents.Where(p => p.TypeAhead).ToList();
        var aheadKeys = searchKeys.Where(k => k.Parent.TypeAhead).ToList();
        bool anyAhead = aheadParents.Count > 0 || aheadKeys.Count > 0;

        if (!Model.HasReferencedDisplayColumns && parents.Count > 0)
            Error("WinUI3_MasterScreen needs the foreign-keyed tables' display columns; its .tt.config must say NeedsReferencedDisplayColumns=true.");

        int columnCount = shown.Count + 1; // +1 for the Edit/Delete actions column
        // A header sorts the grid unless its column is binary or long text (SearchSort.IsSortable).
        var sortableShown = shown.Where(SearchSort.IsSortable).ToList();
        // A Clone button for the tables CloneShape allows (CS_Repo writes CloneAsync for the same ones).
        bool canClone = CloneShape.CanClone(Model, Project);
        string SortButtonName(ColumnModel c) => "SortHeader" + c.Name;
#>
@@@FILE <#= viewsFolder #>/<#= table #>ListPage.xaml@@@
<Page
    x:Class="<#= viewNamespace #>.<#= table #>ListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:<#= viewModelNamespace #>"
    xmlns:views="using:<#= viewNamespace #>">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
<#
        if (canSearch)
        {
#>
            <RowDefinition Height="Auto" />
<#
        }
#>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="<#= title.Pluralize() #>" Style="{ThemeResource TitleTextBlockStyle}" />

        <!-- Add New / Refresh bar, shaded like the search and paging bars. The Card* brushes are a near-transparent tint
             for sitting on another surface and show no shading on a plain page background, so these use the Solid* ones. -->
        <Border Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Add New" Click="OnAddClick" />
                <Button Content="Refresh" Click="OnRefreshClick" />
            </StackPanel>
        </Border>
<#
        if (canSearch)
        {
#>

        <!-- Search bar -->
        <Border Grid.Row="2" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
            <!-- Up to eight boxes (TableModel.MaxSearchFields); they wrap in a narrow window. -->
            <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="168" ItemHeight="40">
<#
            foreach (var f in searchFields)
            {
#>
                <TextBox Width="160" PlaceholderText="<#= f.Label #>" Text="{x:Bind ViewModel.<#= f.Prop #>, Mode=TwoWay}" />
<#
            }
            foreach (var k in searchKeys)
            {
                if (k.Parent.TypeAhead)
                {
#>
                <AutoSuggestBox Width="160" AutomationProperties.Name="Filter by <#= k.Label #>" PlaceholderText="All <#= k.Label.Pluralize() #>" DisplayMemberPath="Name" TextMemberPath="Name"
                                Text="{x:Bind ViewModel.<#= k.Prop #>Text, Mode=TwoWay}" TextChanged="On<#= k.Prop #>TextChanged" SuggestionChosen="On<#= k.Prop #>Chosen" />
<#
                }
                else
                {
#>
                <ComboBox Width="160" AutomationProperties.Name="Filter by <#= k.Label #>" ItemsSource="{x:Bind ViewModel.<#= k.Choices #>}" DisplayMemberPath="Name"
                          SelectedItem="{x:Bind ViewModel.<#= k.Prop #>, Mode=TwoWay}" SelectionChanged="OnKeyFilterChanged" />
<#
                }
            }
            if (isNameActive)
            {
#>
                <CheckBox Content="Active only" IsChecked="{x:Bind ViewModel.ActiveOnly, Mode=TwoWay}" />
<#
            }
#>
                <Button Content="Search" Click="OnSearchClick" />
            </VariableSizedWrapGrid>
        </Border>
<#
        }
#>

        <InfoBar Grid.Row="<#= errorRow #>" Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />

        <!-- Row 0 must be "*", not Auto: with Auto the ListView sizes to all its rows and pushes the paging bar out of the window. -->
        <Grid Grid.Row="<#= gridRow #>" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header + rows, boxed in a line around the grid with a line between each row -->
            <Border Grid.Row="0" BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="1" CornerRadius="4"
                    Background="Transparent" RightTapped="OnGridRightTapped">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header: a click sorts by the column (again: flips the direction); a right-click on the grid offers Clear sort. -->
                    <Border Grid.Row="0" BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="0,0,0,1" Padding="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
<#
        for (int i = 0; i < columnCount; i++)
        {
#>
                                <ColumnDefinition Width="<#= i == columnCount - 1 ? (canClone ? "250" : "175") : "*" #>" />
<#
        }
#>
                            </Grid.ColumnDefinitions>
<#
        for (int i = 0; i < shown.Count; i++)
        {
            if (sortableShown.Contains(shown[i]))
            {
#>
                            <Button x:Name="<#= SortButtonName(shown[i]) #>" Grid.Column="<#= i #>" Content="<#= GridCaption.For(shown[i], Labels.Column(shown[i].Name)) #>" Tag="<#= shown[i].Name #>"
                                    Click="OnSortHeaderClick" FontWeight="SemiBold" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" />
<#
            }
            else
            {
#>
                            <TextBlock Grid.Column="<#= i #>" Text="<#= GridCaption.For(shown[i], Labels.Column(shown[i].Name)) #>" FontWeight="SemiBold" />
<#
            }
        }
#>
                            <TextBlock Grid.Column="<#= shown.Count #>" Text="Actions" FontWeight="SemiBold" />
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="Single" Padding="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:<#= table #>ListRow">
                                <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="0,0,0,1" Padding="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
<#
        for (int i = 0; i < columnCount; i++)
        {
#>
                                            <ColumnDefinition Width="<#= i == columnCount - 1 ? (canClone ? "250" : "175") : "*" #>" />
<#
        }
#>
                                        </Grid.ColumnDefinitions>
<#
        for (int i = 0; i < shown.Count; i++)
        {
#>
                                        <TextBlock Grid.Column="<#= i #>" Text="{x:Bind Cells[<#= i #>]}" VerticalAlignment="Center" />
<#
        }
#>
                                        <StackPanel Grid.Column="<#= shown.Count #>" Orientation="Horizontal" Spacing="4">
                                            <Button Content="Edit" FontWeight="Bold" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Tag="{x:Bind Id}" Click="OnEditClick" />
<#
        if (canClone)
        {
#>
                                            <Button Content="Clone" FontWeight="Bold" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Tag="{x:Bind Id}" Click="OnCloneClick" />
<#
        }
#>
                                            <Button Content="Delete" FontWeight="Bold" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Tag="{x:Bind Id}" Click="OnDeleteClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Pagination -->
            <Border Grid.Row="1" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                <views:PaginationBar
                    PageLabel="{x:Bind ViewModel.PageLabel, Mode=OneWay}"
                    CanGoPrevious="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                    CanGoNext="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                    PageSize="{x:Bind ViewModel.PageSize, Mode=OneWay}"
                    PreviousClicked="OnPreviousClick"
                    NextClicked="OnNextClick"
                    PageSizeChanged="OnPageSizeChanged" />
            </Border>

            <views:BusyOverlay Grid.RowSpan="2" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
@@@FILE <#= viewsFolder #>/<#= table #>ListPage.xaml.cs@@@
using <#= viewModelNamespace #>;
using <#= contextNamespace #>;
using Microsoft.UI.Xaml.Controls;
<#
        foreach (string u in usings)
        {
#>
using <#= u #>;
<#
        }
#>

namespace <#= viewNamespace #>;

// A plain Page: add it to your own NavigationView or Frame.
public sealed partial class <#= table #>ListPage : Page
{
    private readonly <#= contextType #> _context;
    public <#= table #>ListViewModel ViewModel { get; }

    public <#= table #>ListPage(<#= contextType #> context)
    {
        _context = context;
        ViewModel = new <#= table #>ListViewModel(context);
        InitializeComponent();
        Loaded += async (_, _) =>
        {
            await ViewModel.LoadAsync();
            ShowSortMarks();
        };
    }

    // The database sorts (SearchAsync); the sort is kept when paging or searching, and a change goes back to page 1.
    private async void OnSortHeaderClick(object sender, RoutedEventArgs e)
    {
        ViewModel.SortBy((string)((Button)sender).Tag);
        await ViewModel.LoadAsync();
        ShowSortMarks();
    }

    // A right-click on the grid offers Clear sort, which also forgets the saved sort.
    private void OnGridRightTapped(object sender, Microsoft.UI.Xaml.Input.RightTappedRoutedEventArgs e)
    {
        var clear = new MenuFlyoutItem { Text = "Clear sort", IsEnabled = ViewModel.HasSort };
        clear.Click += async (_, _) =>
        {
            ViewModel.ClearSort();
            await ViewModel.LoadAsync();
            ShowSortMarks();
        };
        var flyout = new MenuFlyout();
        flyout.Items.Add(clear);
        flyout.ShowAt((FrameworkElement)sender, e.GetPosition((FrameworkElement)sender));
        e.Handled = true;
    }

    // The sorted column's header shows an arrow after its caption.
    private void ShowSortMarks()
    {
<#
        foreach (var c in sortableShown)
        {
#>
        <#= SortButtonName(c) #>.Content = "<#= GridCaption.For(c, Labels.Column(c.Name)) #>" + ViewModel.SortMark("<#= c.Name #>");
<#
        }
#>
    }

    private async void OnAddClick(object sender, RoutedEventArgs e)
    {
        var dialog = new <#= editDialog #>(_context) { XamlRoot = XamlRoot };
        await dialog.ShowAndWaitAsync();
        await ViewModel.LoadAsync();
    }

    private async void OnRefreshClick(object sender, RoutedEventArgs e) => await ViewModel.LoadAsync();

    private async void OnEditClick(object sender, RoutedEventArgs e)
    {
        <#= keyCs #> id = (<#= keyCs #>)((Button)sender).Tag;
        var entity = await _context.Set<<#= table #>>().FindAsync(id);
        if (entity is null)
            return;

        var dialog = new <#= editDialog #>(_context, entity) { XamlRoot = XamlRoot };
        await dialog.ShowAndWaitAsync();
        await ViewModel.LoadAsync();
    }

<#
        if (canClone)
        {
#>
    // Clone copies the row (CloneAsync) and opens the copy in the edit dialog, so the person changes what differs.
    private async void OnCloneClick(object sender, RoutedEventArgs e)
    {
        <#= keyCs #> id = (<#= keyCs #>)((Button)sender).Tag;
        int? newId = await ViewModel.CloneAsync(id);
        await ViewModel.LoadAsync();
        if (newId is null)
            return;

        var copy = await _context.Set<<#= table #>>().FindAsync(newId.Value);
        if (copy is null)
            return;

        var dialog = new <#= editDialog #>(_context, copy) { XamlRoot = XamlRoot };
        await dialog.ShowAndWaitAsync();
        await ViewModel.LoadAsync();
    }

<#
        }
#>
    private async void OnDeleteClick(object sender, RoutedEventArgs e)
    {
        <#= keyCs #> id = (<#= keyCs #>)((Button)sender).Tag;
        var confirm = new ContentDialog
        {
            XamlRoot = XamlRoot,
            Title = "Delete <#= title #>?",
            Content = "This cannot be undone.",
            PrimaryButtonText = "Delete",
            CloseButtonText = "Cancel",
            DefaultButton = ContentDialogButton.Close
        };
        if (await confirm.ShowAsync() != ContentDialogResult.Primary)
            return;

        await ViewModel.DeleteAsync(id);
    }

    private async void OnPreviousClick(object sender, RoutedEventArgs e) => await ViewModel.PreviousPageAsync();

    private async void OnNextClick(object sender, RoutedEventArgs e) => await ViewModel.NextPageAsync();

    private async void OnPageSizeChanged(object? sender, int size) => await ViewModel.ChangePageSizeAsync(size);
<#
        if (canSearch)
        {
#>

    private async void OnSearchClick(object sender, RoutedEventArgs e)
    {
        ViewModel.PageNumber = 1;
        await ViewModel.LoadAsync();
    }
<#
        if (searchKeys.Count > 0)
        {
#>

    // Picking a parent searches at once; the first selection, made while the page is loading for the first time, is not a search.
    private async void OnKeyFilterChanged(object sender, SelectionChangedEventArgs e)
    {
        if (!ViewModel.HasLoaded)
            return;
        ViewModel.PageNumber = 1;
        await ViewModel.LoadAsync();
    }
<#
        foreach (var k in aheadKeys)
        {
#>

    // Typing in the <#= k.Label #> box clears the filter and lists the rows containing the text; picking one filters the grid to it.
    private async void On<#= k.Prop #>TextChanged(AutoSuggestBox sender, AutoSuggestBoxTextChangedEventArgs args)
    {
        if (args.Reason != AutoSuggestionBoxTextChangeReason.UserInput)
            return;
        sender.ItemsSource = string.IsNullOrWhiteSpace(sender.Text) ? null : await ViewModel.Suggest<#= k.Prop #>Async(sender.Text);
        if (ViewModel.<#= k.Prop #> is not null)
        {
            ViewModel.<#= k.Prop #> = null;
            ViewModel.PageNumber = 1;
            await ViewModel.LoadAsync();
        }
    }

    private async void On<#= k.Prop #>Chosen(AutoSuggestBox sender, AutoSuggestBoxSuggestionChosenEventArgs args)
    {
        ViewModel.<#= k.Prop #> = (<#= table #>KeyChoice)args.SelectedItem;
        ViewModel.PageNumber = 1;
        await ViewModel.LoadAsync();
    }
<#
        }
        }
#>
<#
        }
#>
}
@@@FILE <#= viewModelsFolder #>/<#= table #>ListViewModel.cs@@@
using System.Collections.Generic;
using System.Collections.ObjectModel;
using System.Threading.Tasks;
using <#= contextNamespace #>;
using CommunityToolkit.Mvvm.ComponentModel;
<#
        if (parents.Count > 0 || searchKeys.Count > 0)
        {
#>
using Microsoft.EntityFrameworkCore;
<#
        }
        foreach (string u in usings)
        {
#>
using <#= u #>;
<#
        }
#>

namespace <#= viewModelNamespace #>;

/// <summary> One row of <#= table #>ListPage's grid: the id (for the Edit, Clone and Delete buttons) and one display string per header, in order. </summary>
public class <#= table #>ListRow
{
    public <#= keyCs #> Id { get; init; }<#= keyCs == "string" ? " = \"\";" : "" #>
    public List<string> Cells { get; init; } = [];
}

<#
        if (searchKeys.Count > 0)
        {
#>
/// <summary> One entry of a parent drop-down in the search bar: the parent's key, or none for "All". </summary>
public sealed record <#= table #>KeyChoice(object? Id, string Name);

<#
        }
#>
public partial class <#= table #>ListViewModel : ViewModelBase
{
    private readonly <#= contextType #> _context;
    private readonly <#= table #>Repo _repo;

    public ObservableCollection<<#= table #>ListRow> Rows { get; } = [];

    /// <summary> The page sizes the person can pick under the grid (PaginationBar). </summary>
    public static readonly int[] PageSizeChoices = [10, 20, 50, 100];

    [ObservableProperty]
    private int _pageSize = <#= pageSize #>;

    [NotifyPropertyChangedFor(nameof(CanGoPrevious))]
    [NotifyPropertyChangedFor(nameof(CanGoNext))]
    [NotifyPropertyChangedFor(nameof(PageLabel))]
    [ObservableProperty]
    private int _pageNumber = 1;

    [NotifyPropertyChangedFor(nameof(CanGoPrevious))]
    [NotifyPropertyChangedFor(nameof(CanGoNext))]
    [NotifyPropertyChangedFor(nameof(PageLabel))]
    [ObservableProperty]
    private int _totalPages = 1;

    public bool CanGoPrevious => PageNumber > 1;
    public bool CanGoNext => PageNumber < TotalPages;
    [NotifyPropertyChangedFor(nameof(PageLabel))]
    [ObservableProperty]
    private int _totalRows;

    // false until the first page has been read, so "Nothing found." is not shown while waiting
    [NotifyPropertyChangedFor(nameof(PageLabel))]
    [ObservableProperty]
    private bool _hasLoaded;

    public string PageLabel => !HasLoaded ? "" : TotalRows == 0 ? "Nothing found." : $"Page {PageNumber} of {TotalPages} ({TotalRows} rows)";
<#
        foreach (var f in searchFields)
        {
#>

    [ObservableProperty]
    private string _<#= f.Field #> = "";
<#
        }
        if (isNameActive)
        {
#>

    /// <summary> Only the rows whose IsActive is true. </summary>
    [ObservableProperty]
    private bool _activeOnly;
<#
        }
        foreach (var k in searchKeys)
        {
            if (k.Parent.TypeAhead)
            {
#>

    [ObservableProperty]
    private <#= table #>KeyChoice? _<#= k.Field #>;

    /// <summary> What the <#= k.Label #> box shows: what was typed, or the name of the row that was picked. </summary>
    [ObservableProperty]
    private string _<#= k.Field #>Text = "";

    /// <summary> The first few <#= k.Parent.Table #> rows whose text contains what was typed in the <#= k.Label #> box. </summary>
    public async Task<IReadOnlyList<<#= table #>KeyChoice>> Suggest<#= k.Prop #>Async(string text)
    {
        string wanted = text.Trim().ToLower();
        await _gate.WaitAsync();
        try
        {
            var found = await _context.Set<<#= k.Parent.Table #>>().AsNoTracking()
                .Where(r => r.<#= k.Parent.DisplayName #>.ToString()!.ToLower().Contains(wanted))
                .OrderBy(r => r.<#= k.Parent.DisplayName #>).Take(10)
                .Select(r => new { Id = r.<#= k.Parent.KeyName #>, Text = r.<#= k.Parent.DisplayName #> }).ToListAsync();
            return found.Select(r => new <#= table #>KeyChoice(r.Id, r.Text?.ToString() ?? "")).ToList();
        }
        finally { _gate.Release(); }
    }
<#
            }
            else
            {
#>

    public ObservableCollection<<#= table #>KeyChoice> <#= k.Choices #> { get; } = [];

    [ObservableProperty]
    private <#= table #>KeyChoice? _<#= k.Field #>;
<#
            }
        }
#>

    // The grid's sort: a column name (null = the default order) and the direction. It is remembered between runs (GridSortStore) until Clear sort.
    private const string GridKey = "<#= table #>";
    private static readonly string[] SortableColumns = [<#= string.Join(", ", sortableShown.Select(c => "\"" + c.Name + "\"")) #>];
    private string? _sortColumn;
    private bool _sortDescending;

    public bool HasSort => _sortColumn is not null;

    public <#= table #>ListViewModel(<#= contextType #> context)
    {
        _context = context;
        _repo = new <#= table #>Repo(context);
        var saved = GridSortStore.Load(GridKey, SortableColumns);
        _sortColumn = saved?.Column;
        _sortDescending = saved?.Descending ?? false;
    }

    /// <summary> A click on a column header: another column sorts ascending, the sorted column flips its direction. The caller reloads (page 1). </summary>
    public void SortBy(string column)
    {
        if (_sortColumn == column)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortColumn = column;
            _sortDescending = false;
        }
        PageNumber = 1;
        GridSortStore.Save(GridKey, new GridSortEntry(_sortColumn, _sortDescending));
    }

    /// <summary> Back to the default order, and forget the saved sort. The caller reloads (page 1). </summary>
    public void ClearSort()
    {
        _sortColumn = null;
        _sortDescending = false;
        PageNumber = 1;
        GridSortStore.Save(GridKey, null);
    }

    /// <summary> The arrow shown after the caption of the sorted column's header. </summary>
    public string SortMark(string column) => _sortColumn == column ? (_sortDescending ? " ▼" : " ▲") : "";

<#
        if (anyAhead)
        {
#>
    // A DbContext is not thread-safe: a load and the suggestions of a type-ahead take turns.
    private System.Threading.SemaphoreSlim _gate => ContextGate;

    public Task LoadAsync() => RunBusyAsync(async () =>
    {
        await _gate.WaitAsync();
        try { await LoadCoreAsync(); }
        finally { _gate.Release(); }
    });

<#
        }
        else
        {
#>
    public Task LoadAsync() => RunBusyAsync(LoadCoreAsync);

<#
        }
#>
    public async Task LoadCoreAsync()
    {
        ErrorMessage = null;
        Rows.Clear();

<#
        foreach (var p in parents)
        {
            if (p.TypeAhead)
            {
#>
        Dictionary<<#= p.KeyCs #>, string> <#= WinUI3Names.NamesDictionary(p) #> = [];   // too many rows to read: filled below with the names of the rows this page shows
<#
            }
            else
            {
#>
        var <#= WinUI3Names.NamesDictionary(p) #> = await _context.Set<<#= p.Table #>>().ToDictionaryAsync(r => r.<#= p.KeyName #>, r => r.<#= p.DisplayName #>?.ToString() ?? "");
<#
            }
        }
#>

<#
        string filterArgs = string.Concat(searchFields.Select(f => $"{CSharpIdentifier(f.ParamName)}: string.IsNullOrWhiteSpace({f.Prop}) ? null : {f.Prop}, "))
            + string.Concat(searchKeys.Select(k => k.Convert is null
                ? $"{CSharpIdentifier(k.ParamName)}: ({k.Type}?){k.Prop}?.Id, "
                : $"{CSharpIdentifier(k.ParamName)}: {k.Prop}?.Id is null ? null : Convert.{k.Convert}({k.Prop}.Id), "));   // a whole-number key is boxed as the parent's own type: convert it to this column's
        if (isNameActive)
            filterArgs += "activeOnly: ActiveOnly, ";
        foreach (var k in searchKeys.Where(k => !k.Parent.TypeAhead))
        {
#>
        if (<#= k.Choices #>.Count == 0)
        {
            // the parent's rows by name, after "All": picking one filters the grid to the rows that point at it
            var <#= k.Choices #>Names = await _context.Set<<#= k.Parent.Table #>>().ToDictionaryAsync(r => r.<#= k.Parent.KeyName #>, r => r.<#= k.Parent.DisplayName #>?.ToString() ?? "");
            <#= k.Choices #>.Add(new <#= table #>KeyChoice(null, "All <#= k.Label.Pluralize() #>"));
            foreach (var choice in <#= k.Choices #>Names.OrderBy(n => n.Value, StringComparer.CurrentCultureIgnoreCase))
                <#= k.Choices #>.Add(new <#= table #>KeyChoice(choice.Key, choice.Value));
            <#= k.Prop #> ??= <#= k.Choices #>[0];
        }
<#
        }
#>
        var (rows, totalCount) = await _repo.SearchAsync(<#= filterArgs #>pageNumber: PageNumber, pageSize: PageSize, sortColumn: _sortColumn, sortDescending: _sortDescending);
        TotalPages = totalCount == 0 ? 0 : (int)Math.Ceiling(totalCount / (double)PageSize);
        if (rows.Count == 0 && totalCount > 0 && PageNumber > TotalPages)
        {
            // the last row of the last page was deleted: show the last page there is
            PageNumber = TotalPages;
            (rows, totalCount) = await _repo.SearchAsync(<#= filterArgs #>pageNumber: PageNumber, pageSize: PageSize, sortColumn: _sortColumn, sortDescending: _sortDescending);
        }
        TotalRows = totalCount;
        HasLoaded = true;
<#
        foreach (var p in aheadParents)
        {
            var own = shown.Where(c => form.ParentOf(c) == p).ToList();
            string ids = own.Select(c => $"rows.Select(r => r.{c.Name}).OfType<{p.KeyCs}>()").Aggregate((a, b) => $"{a}.Concat({b})");
#>
        {
            var ids = <#= ids #>.Distinct().ToList();
            <#= WinUI3Names.NamesDictionary(p) #> = (await _context.Set<<#= p.Table #>>().AsNoTracking().Where(r => ids.Contains(r.<#= p.KeyName #>))
                .Select(r => new { Id = r.<#= p.KeyName #>, Text = r.<#= p.DisplayName #> }).ToListAsync()).ToDictionary(r => r.Id, r => r.Text?.ToString() ?? "");
        }
<#
        }
#>

        foreach (var e in rows)
        {
            List<string> cells =
            [
<#
        foreach (var c in shown)
            Write(DesktopGridCode.CellLines(form, Project, c));
#>
            ];
            Rows.Add(new <#= table #>ListRow { Id = e.<#= keyProp #>, Cells = cells });
        }
    }

    public async Task DeleteAsync(<#= keyCs #> id)
    {
        ErrorMessage = null;
        int result = await _repo.DeleteAsync("<#= table #>", id);
        if (result == 0)
            await LoadAsync();
        else if (result == -1)
            ErrorMessage = "This row no longer exists."; // avoids guessing singular/plural from a table name like "Products"
        else
            ErrorMessage = "This row cannot be deleted because it is in use.";
    }

<#
        if (canClone)
        {
#>
    /// <summary> Copies the row and returns the new row's id, or null with ErrorMessage set when the copy failed. </summary>
    public async Task<int?> CloneAsync(int id)
    {
        ErrorMessage = null;
        try
        {
            return await _repo.CloneAsync(id);
        }
        catch (Exception ex)
        {
            ErrorMessage = "The row could not be cloned: " + ex.Message;
            return null;
        }
    }

<#
        }
#>
    /// <summary> The person picked another page size under the grid: the first page is read again with it. </summary>
    public async Task ChangePageSizeAsync(int size)
    {
        if (size == PageSize) return;
        PageSize = size;
        PageNumber = 1;
        await LoadAsync();
    }

    public async Task PreviousPageAsync()
    {
        if (!CanGoPrevious) return;
        PageNumber--;
        await LoadAsync();
    }

    public async Task NextPageAsync()
    {
        if (!CanGoNext) return;
        PageNumber++;
        await LoadAsync();
    }
}
<#
    }
#>
