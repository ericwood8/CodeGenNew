# Restriction checkboxes for TS_People_v1.tt (see Docs/Reference.md section 3).
# One set of files for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# No OutputName: the template writes its own paths (the people service and the members screen with its test) with @@@FILE markers.
# Whole-project generation (codegen generate): written only for a project with Auth=true, ApiAuth and a UserTable.
Stacks=Angular
InPlan=false
