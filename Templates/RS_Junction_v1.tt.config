# Restriction checkboxes for RS_Junction_v1.tt (see Docs/Reference.md section 3).
Requires=PrimaryKey,JunctionTable
# Only offered for a many-to-many junction/bridge table (TableModel.IsJunctionTable).
# The list shows the target table's display columns, so they must be looked up.
NeedsReferencedDisplayColumns=true
# The Rust stack reads PostgreSQL, MySQL and SQLite through sqlx; SQL Server is not supported.
Dialects=PostgreSql,MySql,Sqlite
# No OutputName: the template writes its own path (src/routes/<table>_junction.rs) with an @@@FILE marker.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Rust
PlanTables=Junction
