<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // UNO_EssentialAuth_v1.tt
    // Generates: Services/AuthSession.cs, Views/LoginPage.xaml and Views/LoginPage.xaml.cs   (written once and kept; a replacing run refreshes them; Auth=true ticks the group)
    // The sign-in of the Uno app. The API half is ApiAuth=true (the Jwt group): POST /api/auth/login answers { token, expiresUtc, user: { name, role, ownerId } }.
    //   Services/AuthSession.cs   AuthSession (the token and user, kept in memory so the sign-in ends with the app; Login, Logout, HasRole), LoginException and AuthHandler (sends
    //                             Authorization: Bearer <token> with every call and signs the person out when the API answers 401);
    //   Views/LoginPage.xaml(.cs) the sign-in page, with the messages "The user name or password is not right.", "Too many tries. Wait a minute and try again." and "Could not sign in right now.".
    // MainPage.xaml(.cs) (the App group), MainPage.Screens.cs and Services/ApiClients.cs (UNO_Screens) are written for Auth=true to show the page until someone is signed in and to leave out
    // the screens the role may not read. With TenantTable and TenantMembership the sign-in also has a Tenant box (the key of a tenant the person belongs to; empty: the first one) and the message
    // of TenantWords.SignInRefused for a 403. Full notes: Docs/TemplateNotes/UNO_EssentialAuth_v1.md
    // ==========================================================================================
    string servicesNamespace = UnoNames.ServicesNamespace(Project);
    string viewNamespace = Project.ViewNamespace ?? Project.AppNamespace + ".Views";
    bool tenants = TenantPlan.HasSignInBox(Project);   // TenantTable and TenantMembership: the sign-in has a box for the tenant to work in
#>
@@@FILE Services/AuthSession.cs@@@
using System.Net;
using System.Net.Http.Json;
using System.Text.Json;

namespace <#= servicesNamespace #>;

/// <summary> Who is signed in: the name, the role and the owner id<#= tenants ? " and tenant" : "" #> the API sent. </summary>
public record SessionUser(string Name, string? Role, int? OwnerId<#= tenants ? ", int? TenantId = null" : "" #>);
<# if (tenants) { #>

/// <summary> One tenant of the signed-in person (GET api/auth/tenants): the name to show, the role in it and whether the token works in it now. </summary>
public record TenantChoice(int Id, string Text, string? Role, bool Current);
<# } #>

/// <summary> What POST api/auth/login answers. </summary>
public record SessionData(string Token, DateTime? ExpiresUtc, SessionUser User);

/// <summary> A sign-in the API refused: the status says why (<#= HttpStatus.Unauthorized #> a wrong name or password, <#= HttpStatus.TooManyRequests #> too many tries). </summary>
public class LoginException(int status) : Exception($"The sign-in answered {status}.")
{
    public int Status => status;
}

public class AuthSession
{
    private static readonly JsonSerializerOptions Web = new(JsonSerializerDefaults.Web);

    public SessionData? Data { get; private set; }
    public string? Token => Data?.Token;
    public SessionUser? User => Data?.User;
    public bool IsSignedIn => Data is not null;

    /// <summary> Raised when someone signs in or out, so the main page draws its menu again. It can be raised from a call's thread. </summary>
    public event Action? Changed;

<# if (tenants) { #>
    /// <summary> Signs in; with a tenant (the key of one the person belongs to) the token works in that tenant, else in the first one. A refused sign-in throws <see cref="LoginException"/>. </summary>
    public async Task LoginAsync(HttpClient http, string userName, string password, int? tenantId = null)
    {
        var response = tenantId is { } tenant
            ? await http.PostAsJsonAsync("/api/auth/login", new { userName, password, tenantId = tenant })
            : await http.PostAsJsonAsync("/api/auth/login", new { userName, password });
<# } else { #>
    /// <summary> Signs in; a refused sign-in throws <see cref="LoginException"/>. </summary>
    public async Task LoginAsync(HttpClient http, string userName, string password)
    {
        var response = await http.PostAsJsonAsync("/api/auth/login", new { userName, password });
<# } #>
        if (!response.IsSuccessStatusCode)
            throw new LoginException((int)response.StatusCode);
        Data = await response.Content.ReadFromJsonAsync<SessionData>(Web) ?? throw new LoginException((int)HttpStatusCode.InternalServerError);
        Changed?.Invoke();
    }

<# if (tenants) { #>
    /// <summary> The tenants the signed-in person belongs to; none when the API has no tenants route. </summary>
    public async Task<List<TenantChoice>> TenantsAsync(HttpClient http)
    {
        try { return await http.GetFromJsonAsync<List<TenantChoice>>("/api/auth/tenants", Web) ?? []; }
        catch (Exception ex) when (ex is HttpRequestException or JsonException)
        {
            return [];
        }
    }

    /// <summary> Asks the API for a token that works in another tenant of the person and keeps it; the main page then draws its menu again. False when the API refuses. </summary>
    public async Task<bool> SwitchTenantAsync(HttpClient http, int tenantId)
    {
        var response = await http.PostAsJsonAsync("/api/auth/switch-tenant", new { tenantId });
        if (!response.IsSuccessStatusCode || await response.Content.ReadFromJsonAsync<SessionData>(Web) is not { } data)
            return false;
        Data = data;
        Changed?.Invoke();
        return true;
    }

<# } #>
    public void Logout()
    {
        Data = null;
        Changed?.Invoke();
    }

    /// <summary> Whether the signed-in person's role is one of <paramref name="roles"/>. </summary>
    public bool HasRole(IEnumerable<string> roles) => User?.Role is { } role && roles.Contains(role);
}

/// <summary> Sends the token with every call to the API and signs the person out when the API answers <#= HttpStatus.Unauthorized #> to a call that carried one. </summary>
public class AuthHandler : DelegatingHandler
{
    private readonly AuthSession session;

    public AuthHandler(AuthSession session)
    {
        this.session = session;
        InnerHandler = new HttpClientHandler();
    }

    protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
    {
        string? token = session.Token;
        if (token is not null)
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        var response = await base.SendAsync(request, cancellationToken);
        if (response.StatusCode == HttpStatusCode.Unauthorized && token is not null)
            session.Logout();
        return response;
    }
}
@@@FILE Views/LoginPage.xaml@@@
<UserControl
    x:Class="<#= viewNamespace #>.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock Text="Sign in" Style="{ThemeResource TitleTextBlockStyle}" />
            <InfoBar x:Name="Problem" Severity="Error" IsOpen="False" IsClosable="False" />
            <TextBox x:Name="UserNameBox" Header="User name" />
            <PasswordBox x:Name="PasswordBoxField" Header="Password" KeyDown="OnPasswordKeyDown" />
<# if (tenants) { #>
            <NumberBox x:Name="TenantBox" Header="<#= TenantWords.SignInLabel #>" Description="<#= TenantWords.SignInHint #>" Minimum="1" SpinButtonPlacementMode="Hidden" />
<# } #>
            <Button x:Name="SignInButton" Content="Sign in" Style="{ThemeResource AccentButtonStyle}" Click="OnSignInClick" />
        </StackPanel>
    </Grid>
</UserControl>
@@@FILE Views/LoginPage.xaml.cs@@@
using <#= servicesNamespace #>;
using Microsoft.UI.Xaml.Controls;

namespace <#= viewNamespace #>;

public sealed partial class LoginPage : UserControl
{
    private readonly HttpClient _http;
    private readonly AuthSession _session;

    public LoginPage(HttpClient http, AuthSession session)
    {
        _http = http;
        _session = session;
        InitializeComponent();
    }

    private async void OnSignInClick(object sender, RoutedEventArgs e) => await SignInAsync();

    private async void OnPasswordKeyDown(object sender, Microsoft.UI.Xaml.Input.KeyRoutedEventArgs e)
    {
        if (e.Key == Windows.System.VirtualKey.Enter)
            await SignInAsync();
    }

    private async Task SignInAsync()
    {
        SignInButton.IsEnabled = false;
        Problem.IsOpen = false;
        try
        {
<# if (tenants) { #>
            await _session.LoginAsync(_http, UserNameBox.Text.Trim(), PasswordBoxField.Password, int.TryParse(TenantBox.Text.Trim(), out int tenant) ? tenant : null);
<# } else { #>
            await _session.LoginAsync(_http, UserNameBox.Text.Trim(), PasswordBoxField.Password);
<# } #>
        }
        catch (LoginException ex)
        {
            Show(ex.Status switch
            {
                <#= HttpStatus.Unauthorized #> => "The user name or password is not right.",
                <#= HttpStatus.TooManyRequests #> => "Too many tries. Wait a minute and try again.",
<# if (tenants) { #>
                <#= HttpStatus.Forbidden #> => "<#= TenantWords.SignInRefused #>",
<# } #>
                _ => "Could not sign in right now."
            });
        }
        catch (HttpRequestException)
        {
            Show("Could not sign in right now.");
        }
        finally
        {
            SignInButton.IsEnabled = true;
        }
    }

    private void Show(string message)
    {
        Problem.Message = message;
        Problem.IsOpen = true;
        PasswordBoxField.Password = "";
    }
}
