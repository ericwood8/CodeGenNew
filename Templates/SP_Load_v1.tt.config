# Restriction checkboxes for SP_Load_v1.tt (see Docs/Reference.md section 3).
# "Already loaded" is decided by primary key, so one is required.
RequiresPrimaryKey=true
TableOnly=true
# This template generates from the table's actual rows, so the schema provider must read them (small tables only).
NeedsRowData=true
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Api,WinUI3
PlanTables=Enum
OutputRoot=Sql
InPlan=false
# The routines are written for the three databases that have them; a SQLite project reaches the database through EF (AccessMode=Ef) instead.
Dialects=SqlServer,PostgreSql,MySql
