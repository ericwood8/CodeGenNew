# Restriction checkboxes for UNO_EssentialProject_v1.tt (see Docs/Reference.md section 3).
# One of the files every Uno app needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
Scope=None
Stacks=Uno
EssentialsGroup=Project
Description=the .csproj, global.json, Directory.Build.props, GlobalUsings.cs, the Windows manifests, the desktop and browser entry points and launchSettings.json
Needs=Services/ApiClients.cs
