# Restriction checkboxes for WinUI3_Test_v1.tt (see Docs/Reference.md section 3).
# MSTest tests of the view model a WinUI3 dialog is written with: the dialog edits a row by its primary key.
# No OutputName: the template writes its own path (<Table>DetailViewModelTests.cs) with an @@@FILE marker.
Requires=PrimaryKey,SingleKey
NeedsReferencedDisplayColumns=true
# Whole-project generation (codegen generate): for a project that sets DesktopTests=true (or names the template in PlanAlso). The files go to the test project, not the app.
Stacks=WinUI3
PlanTables=ScreenDialog
OutputRoot=WinUI3Tests
InPlan=false
