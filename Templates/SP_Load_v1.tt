<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // MySQL has real stored procedures with its own syntax: CodeGenNew.Core's MySqlProcedures writes this one for a table read from MySQL.
    if (Model.Dialect == SqlDialect.MySql)
    {
        Write(MySqlProcedures.Load(Model));
        return GenerationEnvironment.ToString();
    }
#>
<#
    // PostgreSQL has functions rather than stored procedures: CodeGenNew.Core's PostgresProcedures writes this one for a table read from PostgreSQL.
    if (Model.Dialect == SqlDialect.PostgreSql)
    {
        Write(PostgresProcedures.Load(Model));
        return GenerationEnvironment.ToString();
    }
#>
<#
    // ==========================================================================================
    // SP_Load_v1.tt
    // Generates: <TableName>_Load.sql   (the "seed data load")
    // Reads the table's current rows at generation time (NeedsRowData in the .tt.config) and writes a routine that puts the same rows into another
    // database: the small reference tables (status codes, enum tables) a fresh database needs. Read-only against the source; review and run it yourself.
    // Full notes: Docs/TemplateNotes/SP_Load_v1.md

    if (!Model.HasRowData)
        throw new System.InvalidOperationException("SP_Load.tt needs the table's rows; its .tt.config must say NeedsRowData=true.");

    bool IsRowVersion(ColumnModel c) =>
        c.SqlTypeDeclaration.Equals("timestamp", System.StringComparison.OrdinalIgnoreCase) ||
        c.SqlTypeDeclaration.Equals("rowversion", System.StringComparison.OrdinalIgnoreCase);

    // Loaded columns: everything assignable, minus an unwanted modified-date/modified-user column.
    var loadColumns = Model.Columns.Where(c => !c.IsComputed && !IsRowVersion(c) && !c.IsModifiedDateColumn && !c.IsModifiedUserColumn).ToList();
    var identityColumn = loadColumns.FirstOrDefault(c => c.IsIdentity);

    string columnList = string.Join(", ", loadColumns.Select(c => $"[{c.Name}]"));
    string table = $"[{Model.SchemaName}].[{Model.TableName}]";
    int RowIndex(ColumnModel c) => Model.Columns.IndexOf(c);

    string ValueFor(object?[] row, ColumnModel c) =>
        (c.IsCreateDateColumn || c.IsLastChangedDateColumn) ? "GETDATE()" : SqlLiteral.Format(c, row[RowIndex(c)]);
#>
CREATE OR ALTER PROCEDURE [<#= Model.SchemaName #>].[<#= Model.TableName #>_Load]
-- Loads the <#= Model.Rows.Count #> row(s) of <#= table #> that existed when this was generated. Safe to run repeatedly: a row
-- whose primary key is already present is left alone. Load tables that this one refers to first.
AS
BEGIN
	SET NOCOUNT ON;
	SET XACT_ABORT ON;

	-- Join the caller's transaction if there is one; otherwise own this one.
	DECLARE @blnOwnsTransaction BIT = CASE WHEN @@TRANCOUNT = 0 THEN 1 ELSE 0 END;

	BEGIN TRY
		IF @blnOwnsTransaction = 1
			BEGIN TRANSACTION;
<#
    if (Model.Rows.Count == 0)
    {
#>

		-- <#= table #> had no rows when this procedure was generated, so there is nothing to load.
<#
    }
    else
    {
        if (identityColumn is not null)
        {
#>

		SET IDENTITY_INSERT <#= table #> ON;
<#
        }
        foreach (var row in Model.Rows)
        {
            string keyMatch = string.Join(" AND ", Model.PrimaryKeyColumns.Select(pk => $"[{pk.Name}] = {SqlLiteral.Format(pk, row[RowIndex(pk)])}"));
            string values = string.Join(", ", loadColumns.Select(c => ValueFor(row, c)));
#>

		IF NOT EXISTS (SELECT 1 FROM <#= table #> WHERE <#= keyMatch #>)
			INSERT INTO <#= table #>(<#= columnList #>)
			  VALUES (<#= values #>);
<#
        }
        if (identityColumn is not null)
        {
#>

		SET IDENTITY_INSERT <#= table #> OFF;
<#
        }
    }
#>

		IF @blnOwnsTransaction = 1
			COMMIT TRANSACTION;

		RETURN 0;
	END TRY
	BEGIN CATCH
<#
    if (identityColumn is not null)
    {
#>
		SET IDENTITY_INSERT <#= table #> OFF;
<#
    }
#>
		IF @blnOwnsTransaction = 1 AND @@TRANCOUNT > 0
			ROLLBACK TRANSACTION;
		THROW;
	END CATCH;
END
