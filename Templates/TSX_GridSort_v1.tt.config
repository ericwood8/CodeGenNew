# Restriction checkboxes for TSX_GridSort_v1.tt (see Docs/Reference.md section 3).
# Support code for every React grid; it does not depend on a table. The menu offers it on the database, the CLI runs it without -t.
DatabaseOnly=true
RequiresPrimaryKey=false
TableOnly=false
# No OutputName: the template writes its own path (components/gridSort.tsx) with an @@@FILE marker.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=React
OutputFolder=src
