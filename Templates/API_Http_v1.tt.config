# Restriction checkboxes for API_Http_v1.tt (see Docs/Reference.md section 3).
# Requests for the tables API_Crud writes an API for (a single whole-number key).
RequiresPrimaryKey=true
TableOnly=true
# Name the file like the table: Customer -> Customer.http
OutputName={Table}.http
# Whole-project generation (codegen generate): for a project that sets ApiHttp=true (or names the template in PlanAlso).
Stacks=Api
PlanTables=Api
OutputFolder=http
InPlan=false
