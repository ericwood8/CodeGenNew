# Restriction checkboxes for SP_Save_v1.tt (see Docs/Reference.md section 3).
# Save decides insert-vs-update by looking the row up by primary key, so a primary key is required.
RequiresPrimaryKey=true
TableOnly=true
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Api,WinUI3
PlanTables=Entity
OutputRoot=Sql
InPlan=false
