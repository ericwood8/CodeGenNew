<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ parameter name="Variant" type="System.String" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    // Folders under the React app's src folder (where -o points) that the generated files go in.
    string pagesFolder = Project.PagesFolder;
    string componentsFolder = Project.ComponentsFolder;
    string modelsFolder = Project.ModelsFolder;
    string apiFolder = Project.ApiFolder;
    // ==========================================================================================

    // ==========================================================================================
    // TSX_Page_v1.tt
    // Generates: pages/<Table>Page.tsx plus its test file (the paths are written by the template; point the output folder at the React src folder)
    // The React counterpart of TS_Component, as one function component: a grid with Edit, Clone and Delete, Add New, a search bar with a box per
    // searchable column, paging, sortable headers, and a modal add/edit form with the same field, drop-down, date and number rules.
    // Plain semantic HTML with no invented class names; styling comes from the app's own stylesheet. Does not write a detail grid (TSX_DetailMasterPage does).
    // TSX_ODataPage is this template run with Variant=OData (its config says Base=TSX_Page_v1.tt): the same page over the table's OData api module (TSX_ODataApi) instead of the REST one, with several sorts
    // (Shift-click adds a column), a filter row under the headers and a grid that reads only the columns it shows; the REST page is not touched.
    // A Columns button above the grid shows or hides each column of the table (ChosenGridColumns in Core; the helpers are components/gridColumns.tsx, TSX_GridColumns): the choice is kept in the browser, and an OData page asks only for the shown columns.
    // Full notes: Docs/TemplateNotes/TSX_Page_v1.md
    // ==========================================================================================

    // A decimal, float or real column that is not money (a percentage, a rate, a quantity, a weight) is limited to what the column can hold (a percentage to 0-100).

    var form = FormModel.For(Model, Project);   // what the screen is made of, decided in Core for every stack
    var keyColumn = form.KeyColumn;
    var keyType = form.KeyType;   // how the key travels: a number, or a string for a uniqueidentifier or a text key
    if (Variant == "OData" && !ODataPlan.Serves(Model, Project))
    {
        // the OData page is written for the tables the project serves as OData and for no other; a plan runs this template for every table, so it says nothing for the rest
    }
    else if (Variant == "OData" && DatabaseModel.IsDetailMaster(Model, Project))
    {
        Error($"TSX_ODataPage writes no page for [{Model.SchemaName}].[{Model.TableName}]: a master-detail table has TSX_ODataDetailMasterPage.");
    }
    else if (Project.NoApiFor(Model.TableName, Model.LookupShape))
    {
        Error($"TSX_Page writes no screen for [{Model.SchemaName}].[{Model.TableName}]: it is an enum or excluded by the NoApiTables setting (an enum, a *Type lookup table, or a table with no entity class), so there is no API for it to show.");
    }
    else if (keyColumn is null || keyType is null)
    {
        Error($"TSX_Page needs a table with a single int, uniqueidentifier or text primary key (the routes take the id as {{id:int}}, {{id:guid}} or {{id}}), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else
    {
        string baseName = form.BaseName;
        string stem = form.Stem;
        bool odata = Variant == "OData";
        // WriteRoles with the sign-in: only the roles that may write see Add New, Edit, Clone and Delete (the API refuses the others with a 403 anyway)
        IReadOnlyList<string> writeRoles = Project.Auth ? WriteRolePlan.For(Project, Model) : new List<string>();
        bool gated = writeRoles.Count > 0;
        string Gate(string jsx) => gated ? "{canWrite && " + jsx + "}" : jsx;
        bool nameActive = form.IsNameActive;   // a Name and an IsActive column: the whole list is read, narrowed by a name box and an Active only check box on the page, with no paging or sort
        string problemCall = odata ? "problemText" : "problemDetail";   // reads the API's own words from a problem answer
        string pageName = odata ? baseName + "ODataPage" : baseName + "Page";
        string apiVar = odata ? ReactNames.ODataApiVar(Model.TableName) : ReactNames.ApiVar(Model.TableName);
        string apiFile = odata ? ReactNames.ODataApiFile(Model.TableName) : ReactNames.ApiFile(Model.TableName);
        string gridId = odata ? stem + "-odata" : stem;   // the grid's saved sort is kept under this key
        // The Columns list: the grid starts with the columns GridColumns picks and offers every column of the form; a name / active list is short and has no such list.
        var chosen = ChosenGridColumns.For(form);
        bool chooseColumns = !nameActive;
        var columnList = chooseColumns ? chosen.Offered : chosen.Initial;   // the columns the grid has a header and a cell for, in order; a hidden one is not drawn
        var odataFilters = odata ? columnList.Select(c => c.Filter).ToList() : null;   // the filter row's control of each of those columns (null: none)
        string Shown(ColumnModel c, string jsx) => chooseColumns ? "{show('" + c.Name + "') && " + jsx + "}" : jsx;   // JSX that is drawn only while its column is chosen
        string variable = form.Variable;        // holiday
        string listName = variable.Pluralize();        // holidays
        string setList = ReactNames.SetList(listName);  // setHolidays
        string keyProp = JsonNames.Camel(keyColumn.Name);         // holidayId
        string keyTs = keyType.TypeScript;
        string emptyKey = keyType.TypeScriptEmpty;     // "no key yet": the API assigns the real one (a text key is typed by the person, so a new row starts with '')
        bool textKey = form.TextKey;   // the key is a box on the form (typed on a new row, read-only on an existing one) and a column of the grid
        string title = form.Title;                // Time Sheet
        bool hasName = form.HasName; // just for showError's message wording below
        const int pageSize = 20;
        // Same order as Model.SearchableColumns (not "Name first" like the form fields below) - matches
        // TSX_Api.tt's own filters object property order exactly. Empty for a table with no searchable
        // column - canSearch below gates the search bar UI specifically; pagination itself is unconditional
        // (see the header comment's 2026-09-28 update).
        // The Search list protocol (ListProtocol=Search) has one search box for the whole table; the server decides which columns it matches.
        bool listSearch = Project.ListSearchProtocol;
        var searchFields = form.WebSearchFields;
        // a drop-down of the parent's rows per whole-number foreign key: an exact match on the key (the OData page has its own filter row)
        IReadOnlyList<SearchKeyField> searchKeys = Variant == "OData" ? [] : form.SearchKeys;
        bool canSearch = !form.IsNameActive && (searchFields.Count > 0 || searchKeys.Count > 0) && (Variant != "OData" || listSearch);   // the OData page has the filter row; only the one box of the Search list protocol stays above the grid

        var shown = form.Columns;

        var parents = form.Parents;
        // a parent with too many rows for a drop-down is found by typing (components/TypeAhead.tsx), in the form and in the OData filter row
        bool Ahead(FormParent p) => p.TypeAhead;
        bool FilterAhead(ODataFilterField? f) => f is { Kind: ODataFilterKind.Parent } && Ahead(f.Parent!);
        string NamesOf(FormParent p) => p.Variable + "NameCache";
        bool anyBox = shown.Any(c => form.KindOf(c) == FieldKind.Lookup && Ahead(form.ParentOf(c)!)) || searchKeys.Any(k => Ahead(k.Parent)) || (odataFilters?.Any(FilterAhead) ?? false);

        var gridColumns = form.GridColumns;
        IReadOnlyList<ColumnModel> sortableColumns = nameActive ? [] : columnList.Where(c => c.Sortable).Select(c => c.Column).ToList();
        bool canClone = form.CanClone;
        var formPages = form.Pages;
        bool tabbed = form.IsTabbed;

        var ts = new StringBuilder();
        void T(string s = "") => ts.Append(s).Append('\n');

        // ================= imports
        T("import { useEffect, useState } from 'react';");
        T("import type { FormEvent } from 'react';");
        T("import { useNavigate, useSearchParams } from 'react-router-dom';");
        T($"import type {{ {baseName} }} from '../{modelsFolder}/{stem}';");
        T($"import {{ {apiVar} }} from '../{apiFolder}/{apiFile}';");
        if (gated) T($"import {{ useAuth }} from '../{apiFolder}/auth';");
        T($"import {{ ApiError }} from '../{apiFolder}/client';");
        if (!nameActive) T($"import {{ PaginationBar }} from '../{componentsFolder}/PaginationBar';");
        if (shown.Any(form.IsMoneyInput))
            T($"import {{ CurrencyInput }} from '../{componentsFolder}/CurrencyInput';");
        if (nameActive)
        {
            if (odata) T($"import {{ problemText }} from '../{apiFolder}/odataClient';");
        }
        else if (odata)
        {
            T($"import {{ GridMenu }} from '../{componentsFolder}/gridSort';");
            T($"import type {{ GridSort }} from '../{componentsFolder}/gridSort';");
            T($"import {{ {(odataFilters!.Any(f => f is not null) ? "FilterCell, " : "")}ODataSortHeader, conditionsOf, loadSorts, nextSorts, saveSorts }} from '../{componentsFolder}/odataScreen';");
            T($"import type {{ ColumnFilter{(odataFilters!.Any(f => f is not null) ? ", ColumnFilterField" : "")} }} from '../{componentsFolder}/odataScreen';");
            T($"import {{ problemText }} from '../{apiFolder}/odataClient';");
        }
        else
        {
            T($"import {{ GridMenu, SortHeader, loadSort, nextSort, saveSort }} from '../{componentsFolder}/gridSort';");
            T($"import type {{ GridSort }} from '../{componentsFolder}/gridSort';");
        }
        if (chooseColumns)
        {
            T($"import {{ ColumnPicker, loadColumns, {(odata ? "onlyShown, " : "")}saveColumns{(columnList.Any(c => c.Cut) ? ", shortText" : "")} }} from '../{componentsFolder}/gridColumns';");
            T($"import type {{ GridColumn }} from '../{componentsFolder}/gridColumns';");
        }
        if (parents.Any(Ahead)) T($"import {{ {(anyBox ? "TypeAheadBox, " : "")}useLookupNames }} from '../{componentsFolder}/TypeAhead';");
        foreach (var p in parents.Where(p => !p.IsSelf))
        {
            if (!p.UsesLookupEndpoint) T($"import type {{ {p.BaseName} }} from '../{modelsFolder}/{p.ModelFile}';");
            T($"import {{ {ReactNames.ApiVar(p.Table)} }} from '../{apiFolder}/{ReactNames.ApiFile(p.Table)}';");
        }
        T();
        if (parents.Any(p => p.UsesLookupEndpoint && !Ahead(p)))
        {
            T("// one row of GET <route>/lookup: the key, the text to show and whether the row is active");
            T("type Lookup<K extends number | string = number> = { id: K; name: string; isActive?: boolean | null };");
            T();
        }
        if (nameActive)
        {
            if (!odata)
            {
                T("// the detail of a problem-details answer (a 409 for a duplicate name says which name), or nothing when the error is not one");
                T("const problemDetail = (error: unknown): string | undefined => {");
                T("  if (!(error instanceof ApiError)) return undefined;");
                T("  try {");
                T("    const body = JSON.parse(error.message) as { detail?: unknown };");
                T("    return typeof body.detail === 'string' ? body.detail : undefined;");
                T("  } catch {");
                T("    return undefined;");
                T("  }");
                T("};");
            }
        }
        else
        {
        T($"const initialPageSize = {pageSize};");
        T("const pageSizeChoices = [10, 20, 50, 100]; // the page sizes the person can pick under the grid");
        T($"const gridKey = '{gridId}'; // the grid's saved sort is kept in the browser under this key (see components/gridSort.tsx)");
        T($"const sortableColumns = [{string.Join(", ", sortableColumns.Select(c => "'" + c.Name + "'"))}]; // the columns whose header sorts the grid");
        if (odata)
        {
            var filterList = odataFilters!.Where(f => f is not null).Select(f => f!).ToList();
            if (filterList.Count > 0)
            {
                T("const filterFields: ColumnFilterField[] = [");
                foreach (var f in filterList)
                {
                    string literal = f.Literal is null ? "" : $", literal: '{f.Literal}'";
                    T($"  {{ name: '{f.Name}', property: '{f.Property}', kind: '{f.Kind.ToString().ToLowerInvariant()}', nullable: {(f.Nullable ? "true" : "false")}{literal} }},");
                }
                T("];");
            }
            else
                T("const filterFields: never[] = [];");
            T($"const columnProperty: Record<string, string> = {{ {string.Join(", ", columnList.Select(c => $"'{c.Name}': '{c.Property}'"))} }}; // the property of each column; the grid asks for the chosen ones and the key, and a row is read whole when it is opened");
        }
        T($"const columnList: GridColumn[] = [{string.Join(", ", columnList.Select(c => $"{{ name: '{c.Name}', label: '{c.Label.Replace("\\", "\\\\").Replace("'", "\\'")}' }}"))}]; // the columns the Columns list offers");
        T($"const initialColumns = [{string.Join(", ", columnList.Where(c => c.Initial).Select(c => "'" + c.Name + "'"))}]; // the columns the grid starts with");
        T("const columnNames = columnList.map((column) => column.name);");
        }
        T();
        T($"export function {pageName}() {{");
        T($"  const [{listName}, {setList}] = useState<{baseName}[]>([]);");
        foreach (var p in parents)
        {
            if (Ahead(p))
                T($"  const {NamesOf(p)} = useLookupNames<{p.KeyTs}>((query) => {ReactNames.ApiVar(p.Table)}.getLookup(query)); // the names of {p.BaseName} rows, asked for as the page shows them (too many rows for a drop-down)");
            else
                T($"  const [{ReactNames.ParentList(p)}, {ReactNames.SetList(ReactNames.ParentList(p))}] = useState<{p.ItemType}[]>([]);");
        }
        T($"  const [selectedRow, setSelectedRow] = useState<{baseName} | null>(null);");
        if (form.Guards.Count > 0) T("  const [guards, setGuards] = useState<Record<string, boolean>>({}); // which guarded columns the signed-in person may change (GET guards)");
        // a typed key is set on a new row too, so the key can no longer say whether the row is new: `adding` does
        if (textKey) T("  const [adding, setAdding] = useState(false); // true while the form holds a new row, whose key the person types");
        if (tabbed)
        {
            T("  const [tab, setTab] = useState(0); // the form tab showing");
            T("  // A required field on a tab that is not showing blocks the submit without a visible message: show the tab that holds the first invalid field.");
            T("  const revealInvalidTab = (event: { currentTarget: HTMLButtonElement }) => {");
            T("    const panel = event.currentTarget.form?.querySelector(':invalid')?.closest('[role=\"tabpanel\"]');");
            T("    if (panel) setTab(Number(panel.getAttribute('data-tab')));");
            T("  };");
        }
        string filterInit = string.Join(", ", searchFields.Select(f => f.ParamName).Concat(searchKeys.Select(k => k.ParamName)).Select(n => $"{n}: ''"));
        if (canSearch) T($"  const [filters, setFilters] = useState({{ {filterInit} }});");
        if (nameActive)
        {
            T("  const [searchText, setSearchText] = useState('');");
            T("  const [activeOnly, setActiveOnly] = useState(false);");
        }
        else
        {
            T("  const [page, setPage] = useState(1);");
            T("  const [totalPages, setTotalPages] = useState(1);");
            T("  const [pageSize, setPageSize] = useState(initialPageSize);");
        }
        T("  const [loaded, setLoaded] = useState(false); // true once a page has arrived, so \"Nothing found.\" is not shown while waiting");
        T("  const [error, setError] = useState<string | null>(null);");
        if (nameActive)
        {
        }
        else if (odata)
        {
            T("  const [chosen, setChosen] = useState<string[]>(() => loadColumns(gridKey, columnNames, initialColumns)); // the columns shown; kept in the browser");
            T("  const show = (name: string) => chosen.includes(name);");
            T("  const [sorts, setSorts] = useState<GridSort[]>(() => loadSorts(gridKey, sortableColumns.filter((name) => chosen.includes(name))));");
            T("  const [columnFilters, setColumnFilters] = useState<Record<string, ColumnFilter>>({});");
        }
        else
        {
            T("  const [chosen, setChosen] = useState<string[]>(() => loadColumns(gridKey, columnNames, initialColumns)); // the columns shown; kept in the browser");
            T("  const show = (name: string) => chosen.includes(name);");
            T("  const [sort, setSort] = useState<GridSort | null>(() => loadSort(gridKey, sortableColumns.filter((name) => chosen.includes(name))));");
        }
        T("  // Opened from another page's grid (?edit=<id>&back=<that page>): open this row, and go back to that page when the form is saved or cancelled.");
        T("  const [searchParams] = useSearchParams();");
        T("  const navigate = useNavigate();");
        T("  const backTo = searchParams.get('back');");
        if (gated)
        {
            T("  const { hasRole } = useAuth();");
            T($"  const canWrite = hasRole([{WriteRolePlan.Literal(writeRoles, (char)39)}]); // WriteRoles: the roles that may add, change and delete rows");
        }
        T();
        // The sort (like the filters) is read from state by default; a change passes its new value explicitly because state is not updated yet.
        if (nameActive)
        {
            T("  const load = () => {");
            T($"    {apiVar}.getAll().then((result) => {{");
        }
        else if (odata)
        {
            T($"  const load = (targetPage: number = 1, over: {{ {(canSearch ? "filters?: typeof filters; " : "")}sorts?: GridSort[]; columnFilters?: Record<string, ColumnFilter>; columns?: string[]; size?: number }} = {{}}) => {{");
            T($"    {apiVar}.queryPage({{");
            T("      pageNumber: targetPage,");
            T("      pageSize: over.size ?? pageSize,");
            if (canSearch) T("      filters: over.filters ?? filters,");
            T("      sorts: over.sorts ?? sorts,");
            T("      conditions: conditionsOf(filterFields, over.columnFilters ?? columnFilters),");
            T("      select: (over.columns ?? chosen).map((name) => columnProperty[name]),");
            T("    }).then((result) => {");
            T("      // the last row of the last page was deleted, or rows were removed elsewhere: the page asked for is past the end, so show the last page there is");
            T("      if (result.items.length === 0 && result.totalCount > 0 && targetPage > 1) { load(result.totalPages, over); return; }");
        }
        else
        {
        T($"  const load = (targetPage: number = 1{(canSearch ? ", filterValues: typeof filters = filters" : "")}, sortValue: GridSort | null = sort, sizeValue: number = pageSize) => {{");
        T($"    {apiVar}.getPage(targetPage, sizeValue, {(canSearch ? "filterValues" : "{}")}, sortValue).then((result) => {{");
        T("      // the last row of the last page was deleted, or rows were removed elsewhere: the page asked for is past the end, so show the last page there is");
        T($"      if (result.items.length === 0 && result.totalCount > 0 && targetPage > 1) {{ load(result.totalPages{(canSearch ? ", filterValues" : "")}, sortValue, sizeValue); return; }}");
        }
        T(nameActive ? $"      {setList}(result);" : $"      {setList}(result.items);");
        if (!nameActive)
        {
            T("      setPage(result.page);");
            T("      setTotalPages(result.totalPages);");
        }
        T("      setLoaded(true);");
        T($"    }}).catch(() => setError('Failed to load {Labels.Words(baseName).ToLowerInvariant().Pluralize()}.'));");
        T("  };");
        if (nameActive)
        {
            T();
            T("  // The whole list is here: the name box and the Active only check box narrow it without another call.");
            T($"  const visibleRows = {listName}.filter((row) => (!activeOnly || row.isActive) && (row.name ?? '').toLowerCase().includes(searchText.trim().toLowerCase()));");
        }
        T();
        T("  useEffect(() => {");
        T("    load();");
        foreach (var p in parents.Where(p => !Ahead(p)))
            T($"    {ReactNames.ApiVar(p.Table)}.{p.LoadMethod}().then({ReactNames.SetList(ReactNames.ParentList(p))}).catch(() => {{}});");
        if (form.Guards.Count > 0) T($"    {apiVar}.getGuards().then(setGuards).catch(() => {{}});");
        T("    const openId = searchParams.get('edit');");
        T($"    if (openId) {apiVar}.getById({(keyType.Kind == KeyKind.Int ? "Number(openId)" : "openId")}).then(edit).catch(() => setError('This {Labels.Words(baseName).ToLowerInvariant()} no longer exists!'));");
        T("  }, []);");
        T();
        T($"  const submit = async ({variable}: {baseName}): Promise<void> => {{");
        T("    setError(null);");
        T($"    try {{");
        if (textKey)
        {
            T("      if (adding) {");
            T($"        await {apiVar}.create({variable});");
            T("      } else {");
            T($"        await {apiVar}.update({variable}.{keyProp}!, {variable});");
            T("      }");
        }
        else
        {
            T($"      if ({variable}.{keyProp}) {{");
            T($"        await {apiVar}.update({variable}.{keyProp}, {variable});");
            T("      } else {");
            T($"        {variable}.{keyProp} = {emptyKey};");
            T($"        await {apiVar}.create({variable});");
            T("      }");
        }
        T("      setSelectedRow(null);");
        T("      load(page);");
        T("      if (backTo) navigate(backTo);");
        T("    } catch (err) {");
        T("      showError('saving', err);");
        T("    }");
        T("  };");
        T();
        T("  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {");
        T("    event.preventDefault();");
        T("    if (selectedRow) void submit(selectedRow);");
        T("  };");
        T();
        T($"  const remove = async (id: {keyTs}): Promise<void> => {{");
        T("    if (!confirm('Are you sure you want to delete this?')) return;");
        T("    try {");
        T($"      await {apiVar}.delete(id);");
        T("      load(page); // read the page again: the total, the rows that move up and the last page all change");
        T("    } catch (err) {");
        T($"      if (err instanceof ApiError && {(odata ? $"(err.status === {HttpStatus.BadRequest} || err.status === {HttpStatus.Conflict})" : $"err.status === {HttpStatus.BadRequest}")}) {{");
        T("        setError('It cannot be deleted because it is in use!');");
        T($"      }} else if (err instanceof ApiError && err.status === {HttpStatus.NotFound}) {{");
        T("        setError('It no longer exists!');");
        T("        load(page);");
        T("      } else {");
        T("        setError('Problem while deleting!');");
        T("      }");
        T("    }");
        T("  };");
        if (canClone)
        {
            // Clone copies the row on the server and returns the copy: it is in the grid, and open in the form at once so the person changes what differs.
            T();
            T($"  const clone = async (id: {keyTs}): Promise<void> => {{");
            T("    try {");
            T($"      const copy = await {apiVar}.clone(id);");
            T("      load(page);");
            T("      edit(copy);");
            T("    } catch (err) {");
            T($"      if (err instanceof ApiError && err.status === {HttpStatus.NotFound}) {{");
            T("        setError('It no longer exists!');");
            T("        load(page);");
            T("      } else {");
            T("        setError('Problem while cloning!');");
            T("      }");
            T("    }");
            T("  };");
        }
        T();
        // add(): every required property gets a starting value
        var adds = form.NewRowTypeScript;
        T("  const add = () => {");
        if (tabbed) T("    setTab(0);");
        if (textKey) T("    setAdding(true);");
        T(adds.Count == 0 ? "    setSelectedRow({});" : $"    setSelectedRow({{ {string.Join(", ", adds)} }});");
        T("  };");
        T();
        T($"  const edit = ({variable}: {baseName}) => {{");
        if (tabbed) T("    setTab(0);");
        if (textKey) T("    setAdding(false);");
        T($"    const row = {{ ...{variable} }};");
        var dateColumns = form.DateColumns;   // a stamp keeps the timestamp the API sent
        if (dateColumns.Count > 0)
        {
            T("    // the date box wants yyyy-MM-dd; the API sends a full timestamp");
            foreach (var c in dateColumns)
            {
                string prop = $"row.{JsonNames.Camel(c.Name)}";
                if (c.IsNullable) T($"    if ({prop}) {{ {prop} = {prop}.substring(0, 10); }}");
                else T($"    {prop} = {prop}.substring(0, 10);");
            }
        }
        T("    setSelectedRow(row);");
        T("  };");
        T();
        T("  const cancel = () => {");
        T("    setSelectedRow(null);");
        T("    if (backTo) navigate(backTo);");
        T("  };");
        if (nameActive)
        {
            T();
            T("  const clearSearch = () => {");
            T("    setSearchText('');");
            T("    setActiveOnly(false);");
            T("  };");
        }
        else if (odata)
        {
            T();
            T("  const search = () => {");
            T("    setSelectedRow(null);");
            T("    load(1);");
            T("  };");
            T();
            T("  const clearSearch = () => {");
            if (canSearch)
            {
                T($"    const cleared = {{ {filterInit} }};");
                T("    setFilters(cleared);");
            }
            T("    setColumnFilters({});");
            T($"    load(1, {{ {(canSearch ? "filters: cleared, " : "")}columnFilters: {{}} }});");
            T("  };");
            T();
            T("  // A click on a header sorts by the column (again: flips it); a Shift-click adds the column as the next sort (again: flips it, once more: takes it out). The sorts are saved and kept when paging and filtering; a change goes back to page 1.");
            T("  const sortBy = (column: string, shift: boolean) => {");
            T("    const next = nextSorts(sorts, column, shift);");
            T("    setSorts(next);");
            T("    saveSorts(gridKey, next);");
            T("    load(1, { sorts: next });");
            T("  };");
            T();
            T("  const clearSort = () => {");
            T("    setSorts([]);");
            T("    saveSorts(gridKey, []);");
            T("    load(1, { sorts: [] });");
            T("  };");
            T();
            T("  // The grid read only the columns it shows: the row is read whole before the form opens it.");
            T($"  const open = ({variable}: {baseName}) => {{");
            T($"    {apiVar}.getById({variable}.{keyProp}!).then(edit).catch(() => setError('This {Labels.Words(baseName).ToLowerInvariant()} no longer exists!'));");
            T("  };");
            T();
            T("  // Showing or hiding a column: the choice is kept, a sort or a filter on a column that is no longer shown is dropped, and the page is read again with the columns that are shown.");
            T("  const chooseColumns = (next: string[]) => {");
            T("    setChosen(next);");
            T("    saveColumns(gridKey, next, initialColumns);");
            T("    const keptSorts = sorts.filter((s) => next.includes(s.column));");
            T("    if (keptSorts.length !== sorts.length) {");
            T("      setSorts(keptSorts);");
            T("      saveSorts(gridKey, keptSorts);");
            T("    }");
            T("    const keptFilters = onlyShown(columnFilters, next);");
            T("    setColumnFilters(keptFilters);");
            T("    load(page, { sorts: keptSorts, columnFilters: keptFilters, columns: next });");
            T("  };");
        }
        else
        {
        if (canSearch)
        {
            T();
            T("  const search = () => {");
            T("    setSelectedRow(null);");
            T("    load(1);");
            T("  };");
            T();
            T("  const clearSearch = () => {");
            T($"    const cleared = {{ {filterInit} }};");
            T("    setFilters(cleared);");
            T("    load(1, cleared);");
            T("  };");
        }
        // Click a column header to sort by it, click it again to flip the direction; the right-click menu clears the sort. The sort is saved (gridSort.tsx) and
        // kept when paging and when the filters change; a change goes back to page 1.
        T();
        T("  const sortBy = (column: string) => {");
        T("    const next = nextSort(sort, column);");
        T("    setSort(next);");
        T("    saveSort(gridKey, next);");
        T($"    load(1{(canSearch ? ", filters" : "")}, next);");
        T("  };");
        T();
        T("  const clearSort = () => {");
        T("    setSort(null);");
        T("    saveSort(gridKey, null);");
        T($"    load(1{(canSearch ? ", filters" : "")}, null);");
        T("  };");
        if (chooseColumns)
        {
            T();
            T("  // Showing or hiding a column: the choice is kept, and a sort on a column that is no longer shown is dropped. The rows are whole, so nothing else is read again.");
            T("  const chooseColumns = (next: string[]) => {");
            T("    setChosen(next);");
            T("    saveColumns(gridKey, next, initialColumns);");
            T("    if (sort && !next.includes(sort.column)) clearSort();");
            T("  };");
        }
        }
        var parentsShownInGrid = columnList.Select(c => c.Column).Where(c => form.CellOf(c) == CellKind.Lookup).Select(c => form.ParentOf(c)!.NameMethod).ToHashSet();
        foreach (var p in parents.Where(p => parentsShownInGrid.Contains(p.NameMethod)))
        {
            T();
            T($"  // the name to show in place of a {p.BaseName} id");
            T($"  const {p.NameMethod} = (id?: {p.KeyTs}): string => {{");
            T(Ahead(p) ? $"    return {NamesOf(p)}.name(id);" : $"    return {ReactNames.ParentList(p)}.find((p) => p.{p.KeyJson} === id)?.{p.DisplayJson} ?? '';");
            T("  };");
        }
        T();
        T("  const showError = (action: string, err: unknown) => {");
        T($"    if (err instanceof ApiError && err.status === {HttpStatus.BadRequest}) {{ setError({(hasName ? "'Name is bad or has special characters!'" : "'Some of the values are not acceptable!'")}); }}");
        T($"    else if (err instanceof ApiError && err.status === {HttpStatus.NotFound}) {{ setError('This {Labels.Words(baseName).ToLowerInvariant()} no longer exists!'); load(page); }}");
        // a typed key can already be taken: the API answers 409
        if (textKey) T($"    else if (err instanceof ApiError && err.status === {HttpStatus.Conflict}) {{ setError('A {Labels.Words(baseName).ToLowerInvariant()} with this {Labels.Column(keyColumn.Name).ToLowerInvariant()} already exists!'); }}");
        if ((odata || nameActive) && !textKey) T($"    else if (err instanceof ApiError && err.status === {HttpStatus.Conflict}) {{ setError({problemCall}(err) ?? 'A row with this value already exists!'); }}");
        T("    else { setError('Problem while ' + action + '!'); }");
        T("  };");
        T();

        // ================= render
        T("  return (");
        T("    <div className=\"rail\">");
        T($"      <h1>{title.Pluralize()}</h1>");
        T("      " + Gate("<button type=\"button\" onClick={add}>Add New</button>"));
        if (nameActive)
        {
            T();
            T("      <div>");
            T("        <input type=\"text\" placeholder=\"Search by Name\" aria-label=\"Search by Name\" value={searchText} onChange={(event) => setSearchText(event.target.value)} />");
            T("        <label className=\"active-only\"><input type=\"checkbox\" checked={activeOnly} onChange={(event) => setActiveOnly(event.target.checked)} /> Active only</label>");
            T("        <button type=\"button\" onClick={clearSearch}>Clear</button>");
            T("      </div>");
        }
        if (canSearch)
        {
            T();
            T("      <div>");
            foreach (var f in searchFields)
            {
                T("        <input");
                T("          type=\"text\"");
                string searchLabel = listSearch ? "Search" : $"Search by {f.Label}";
                T($"          placeholder=\"{searchLabel}\"");
                T($"          aria-label=\"{searchLabel}\"");
                T($"          value={{filters.{f.ParamName}}}");
                T($"          onChange={{(event) => setFilters({{ ...filters, {f.ParamName}: event.target.value }})}}");
                if (odata) T("          onKeyUp={(event) => { if (event.key === 'Enter') search(); }}");
                T("        />");
            }
            foreach (var k in searchKeys)
            {
                if (Ahead(k.Parent))
                {
                    T($"        <TypeAheadBox<{k.Parent.KeyTs}>");
                    T($"          label=\"Filter by {k.Label}\"");
                    T($"          placeholder=\"All {k.Label.Pluralize()}\"");
                    T($"          value={{filters.{k.ParamName}}}");
                    T($"          names={{{NamesOf(k.Parent)}}}");
                    T($"          find={{(query) => {ReactNames.ApiVar(k.Parent.Table)}.getLookup(query)}}");
                    T($"          onChange={{(id) => {{ const next = {{ ...filters, {k.ParamName}: id === null ? '' : String(id) }}; if (next.{k.ParamName} !== filters.{k.ParamName}) {{ setFilters(next); load(1, next); }} }}}}");
                    T("        />");
                    continue;
                }
                T($"        <select aria-label=\"Filter by {k.Label}\" value={{filters.{k.ParamName}}} onChange={{(event) => {{ const next = {{ ...filters, {k.ParamName}: event.target.value }}; setFilters(next); load(1, next); }}}}>");
                T($"          <option value=\"\">All {k.Label.Pluralize()}</option>");
                T($"          {{{ReactNames.ParentList(k.Parent)}.map((p) => <option key={{p.{k.Parent.KeyJson}}} value={{p.{k.Parent.KeyJson}}}>{{p.{k.Parent.DisplayJson}}}</option>)}}");
                T("        </select>");
            }
            if (!odata)
            {
                T("        <button type=\"button\" onClick={search}>Search</button>");
                T("        <button type=\"button\" onClick={clearSearch}>Clear</button>");
            }
            T("      </div>");
        }
        if (chooseColumns)
        {
            T();
            T("      <ColumnPicker columns={columnList} chosen={chosen} initial={initialColumns} onChange={chooseColumns} />");
        }
        T();
        T("      {error && !selectedRow && <p>{error}</p>}"); // while the dialog is open the error shows inside it
        T();
        if (!nameActive) T(odata ? "      <GridMenu sort={sorts[0] ?? null} onClear={clearSort}>" : "      <GridMenu sort={sort} onClear={clearSort}>");
        T("      <table>");
        T("        <thead>");
        T("          <tr>");
        foreach (var column in columnList)
        {
            var c = column.Column;
            string header;
            if (sortableColumns.Contains(c) && odata)
                header = $"<ODataSortHeader label=\"{column.Caption}\" column=\"{c.Name}\" sorts={{sorts}} onSort={{sortBy}} />";
            else if (sortableColumns.Contains(c))
                header = $"<SortHeader label=\"{column.Caption}\" column=\"{c.Name}\" sort={{sort}} onSort={{sortBy}} />";
            else
                header = $"<th>{column.Caption}</th>";
            T("            " + Shown(c, header));
        }
        T("            <th>Actions</th>");
        T("          </tr>");
        if (odata && !nameActive)
        {
            // the filter row: one control per column by its kind, an "empty" check box for a column that can be empty, Search and Clear at the end
            T("          <tr className=\"filter-row\">");
            int fieldIndex = 0;
            for (int i = 0; i < columnList.Count; i++)
            {
                var gc = columnList[i].Column;
                var f = odataFilters![i];
                if (f is null) { T("            " + Shown(gc, "<td />")); continue; }
                string label = columnList[i].Label.Replace("\"", "&quot;");
                string pick = FilterAhead(f)
                    ? $" pick={{<TypeAheadBox<{f.Parent!.KeyTs}> label=\"Filter by {label}\" placeholder=\"Any\" value={{columnFilters['{f.Name}']?.value}} names={{{NamesOf(f.Parent!)}}} find={{(query) => {ReactNames.ApiVar(f.Parent!.Table)}.getLookup(query)}} onChange={{(id) => setColumnFilters({{ ...columnFilters, '{f.Name}': {{ ...columnFilters['{f.Name}'], value: id ?? undefined }} }})}} />}}"
                    : "";
                string options = f.Kind switch
                {
                    ODataFilterKind.Parent when FilterAhead(f) => "",
                    ODataFilterKind.Parent => $" options={{{ReactNames.ParentList(f.Parent!)}.map((p) => ({{ value: p.{f.Parent!.KeyJson}!, label: String(p.{f.Parent!.DisplayJson} ?? '') }}))}}",
                    ODataFilterKind.Choice => " options={[" + string.Join(", ", f.Choices.Select(choice => { string js = choice.Replace("\\", "\\\\").Replace("'", "\\'"); return $"{{ value: '{js}', label: '{js}' }}"; })) + "]}",
                    _ => ""
                };
                T("            " + Shown(gc, $"<FilterCell field={{filterFields[{fieldIndex}]}} label=\"{label}\" value={{columnFilters['{f.Name}'] ?? {{}}}} onChange={{(value) => setColumnFilters({{ ...columnFilters, '{f.Name}': value }})}} onSearch={{search}}{options}{pick} />"));
                fieldIndex++;
            }
            T("            <td>");
            T("              <button type=\"button\" title=\"Show the rows that match the filters\" onClick={search}>Search</button>");
            T("              <button type=\"button\" title=\"Remove every filter\" onClick={clearSearch}>Clear</button>");
            T("            </td>");
            T("          </tr>");
        }
        T("        </thead>");
        T("        <tbody>");
        T($"          {{{(nameActive ? "visibleRows" : listName)}.map(({variable}) => (");
        T($"            <tr key={{{variable}.{keyProp}}}>");
        foreach (var column in columnList)
        {
            var c = column.Column;
            string prop = $"{variable}.{JsonNames.Camel(c.Name)}";
            var cellKind = form.CellOf(c);
            string cell;
            // A nullable column's value may be undefined: optional chaining keeps a strict (noUncheckedIndexedAccess/strictNullChecks) build compiling.
            if (cellKind == CellKind.Lookup) cell = $"{{{form.ParentOf(c)!.NameMethod}({prop})}}";
            else if (cellKind == CellKind.Boolean) cell = $"{{{prop} ? 'Yes' : 'No'}}";
            else if (cellKind == CellKind.Date) cell = $"{{{prop}{(c.IsNullable ? "?" : "")}.substring(0, 10)}}";
            else if (cellKind == CellKind.DateTime) cell = $"{{{prop}{(c.IsNullable ? "?" : "")}.substring(0, 16).replace('T', ' ')}}";
            else if (cellKind == CellKind.Money) { int d = NumericClassifier.CurrencyDigits(c); cell = $"{{{prop}{(c.IsNullable ? "?" : "")}.toLocaleString(undefined, {{ style: 'currency', currency: '{Project.CurrencyCode}', minimumFractionDigits: {Math.Min(2, d)}, maximumFractionDigits: {d} }})}}"; }
            else if (cellKind == CellKind.Decimal) cell = $"{{{prop}{(c.IsNullable ? "?" : "")}.toFixed(2)}}";
            else cell = column.Cut ? $"{{shortText({prop})}}" : $"{{{prop}}}";
            T("              " + Shown(c, $"<td>{cell}</td>"));
        }
        T("              <td>");
        T("                " + Gate($"<button type=\"button\" onClick={{() => {(odata && !nameActive ? "open" : "edit")}({variable})}}>Edit</button>"));
        if (canClone)
            T("                " + Gate($"<button type=\"button\" onClick={{() => void clone({variable}.{keyProp}!)}}>Clone</button>"));
        T("                " + Gate($"<button type=\"button\" onClick={{() => void remove({variable}.{keyProp}!)}}>Delete</button>"));
        T("              </td>");
        T("            </tr>");
        T("          ))}");
        T("        </tbody>");
        T("      </table>");
        if (!nameActive) T("      </GridMenu>");
        T();
        if (!nameActive)
        {
        T("      <PaginationBar");
        T("        page={page}");
        T("        totalPages={totalPages}");
        T("        onPrevious={() => load(page - 1)}");
        T("        onNext={() => load(page + 1)}");
        T("      />");
        T("      <label className=\"page-size\">");
        T("        Rows per page");
        T($"        <select value={{pageSize}} onChange={{(event) => {{ const size = Number(event.target.value); setPageSize(size); {(odata ? "load(1, { size })" : $"load(1{(canSearch ? ", filters" : "")}, sort, size)")}; }}}}>");
        T("          {pageSizeChoices.map((size) => <option key={size} value={size}>{size}</option>)}");
        T("        </select>");
        T("      </label>");
        }
        T($"      {{loaded && {(nameActive ? "visibleRows" : listName)}.length === 0 && <p className=\"no-rows\">Nothing found.</p>}}");
        T();
        // The add/edit form is a modal <dialog> (native, no library): it opens over the page, wherever the grid is scrolled to, and Escape cancels it.
        T("      {selectedRow && (");
        T("        <dialog");
        T("          ref={(el) => { if (el && !el.open) el.showModal(); }}");
        T("          onCancel={(event) => { event.preventDefault(); cancel(); }}");
        T("        >");
        T("          {error && <p role=\"alert\">{error}</p>}");
        T($"          <h2>{{{(textKey ? "adding ? 'Add' : 'Edit'" : $"selectedRow.{keyProp} ? 'Edit' : 'Add'")}}} {title}</h2>");
        T("          <form onSubmit={handleSubmit}>");
        if (tabbed)
        {
            T("            <div role=\"tablist\">");
            for (int i = 0; i < formPages.Count; i++)
                T($"              <button type=\"button\" role=\"tab\" aria-selected={{tab === {i}}} style={{{{ fontWeight: tab === {i} ? 'bold' : 'normal' }}}} onClick={{() => setTab({i})}}>{formPages[i].Header.Replace("&", "&amp;")}</button>");
            T("            </div>");
        }
        for (int pageIndex = 0; pageIndex < formPages.Count; pageIndex++)
        {
        if (tabbed) T($"            <div role=\"tabpanel\" data-tab=\"{pageIndex}\" hidden={{tab !== {pageIndex}}}>");
        foreach (var c in formPages[pageIndex].Columns)
        {
            string id = form.FieldId(c);
            string prop = JsonNames.Camel(c.Name);
            var kind = form.KindOf(c);
            if (kind == FieldKind.SystemStamp)
            {
                // who made the row and when it changed: the system writes it, so it is text, shown once the row exists
                string stampValue = c.IsDateColumn ? $"{{selectedRow.{prop} ? new Date(selectedRow.{prop}).toLocaleString() : ''}}" : $"{{selectedRow.{prop} ?? ''}}";
                // a row from before the stamp existed says so instead of showing nothing
                if (form.IsGuardStamp(c))
                    stampValue = c.IsDateColumn ? $"{{selectedRow.{prop} ? new Date(selectedRow.{prop}).toLocaleString() : '{GuardStamp.NotRecorded}'}}" : $"{{selectedRow.{prop} || '{GuardStamp.NotRecorded}'}}";
                T($"            {{{(textKey ? "!adding" : $"selectedRow.{keyProp}")} && (");
                T("              <>");
                T("                <label htmlFor=\"" + id + "\">" + Labels.Field(c) + "</label>");
                T($"                <span id=\"{id}\">{stampValue}</span>");
                T("              </>");
                T("            )}");
                continue;
            }
            T("            <label htmlFor=\"" + id + "\">" + Labels.Field(c) + RequiredMark.Jsx(form.IsMarked(c)) + "</label>");
            // a guarded column is a control only for a person who may change it (the guards answer); everyone else sees its value as text and why
            var guard = form.GuardOf(c);
            if (guard is not null)
            {
                T($"            {{guards['{guard.Json}'] ? (");
                T("              <>");
            }
            if (kind == FieldKind.TypedKey)
            {
                // the key of a new row is typed; once the row exists it is read-only (the API does not change a key)
                T($"            <input");
                T($"              id=\"{id}\"");
                T("              type=\"text\"");
                T($"              aria-label=\"{Labels.Field(c)}\"");
                T($"              value={{selectedRow.{prop} ?? ''}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value }})}}");
                if (Chars(c) > 0) T($"              maxLength={{{Chars(c)}}}");
                T("              readOnly={!adding}");
                T($"              placeholder=\"{Labels.Placeholder(c)}\"");
                T("              required");
                T("            />");
            }
            else if (kind == FieldKind.Lookup)
            {
                var p = form.ParentOf(c)!;
                if (Ahead(p))
                {
                    T($"            <TypeAheadBox<{p.KeyTs}>");
                    T($"              id=\"{id}\"");
                    T($"              label=\"{Labels.Field(c)}\"");
                    T($"              value={{selectedRow.{prop}}}");
                    T($"              names={{{NamesOf(p)}}}");
                    T($"              find={{(query) => {ReactNames.ApiVar(p.Table)}.getLookup(query)}}");
                    T($"              onChange={{(key) => setSelectedRow({{ ...selectedRow, {prop}: {(c.IsNullable ? "key ?? undefined" : (p.KeyTs == "number" ? "key ?? 0" : "key ?? ''"))} }})}}");
                    if (!c.IsNullable) T("              required");
                    T("            />");
                }
                else
                {
                // A blank choice means "none": undefined for a nullable column (0 would be a key that does not exist); a required column starts blank too (0 shows as blank, and
                // the browser's required check then refuses it) instead of looking like the first parent is chosen while the row still holds 0.
                string numeric = p.KeyTs == "number"
                    ? (c.IsNullable ? "event.target.value === '' ? undefined : Number(event.target.value)" : "Number(event.target.value)")
                    : (c.IsNullable ? "event.target.value || undefined" : "event.target.value");
                string blankTest = p.KeyTs == "number" && !c.IsNullable ? "||" : "??";
                T($"            <select");
                T($"              id=\"{id}\"");
                T($"              aria-label=\"{Labels.Field(c)}\"");
                T($"              value={{selectedRow.{prop} {blankTest} ''}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: {numeric} }})}}");
                if (!c.IsNullable) T("              required");
                T("            >");
                T("              <option value=\"\"></option>");
                T($"              {{{ReactNames.ParentList(p)}.map((p) => (");
                T($"                <option key={{p.{p.KeyJson}}} value={{p.{p.KeyJson}}}>{{p.{p.DisplayJson}}}</option>");
                T("              ))}");
                T("            </select>");
                }
            }
            else if (kind == FieldKind.Choices)
            {
                // A column whose values the database lists (a MySQL enum) is a drop-down of them; the blank first entry keeps a new row from silently taking the first value.
                T($"            <select");
                T($"              id=\"{id}\"");
                T($"              aria-label=\"{Labels.Field(c)}\"");
                T($"              value={{selectedRow.{prop} ?? ''}}");
                T(c.IsNullable ? $"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value || undefined }})}}" : $"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value }})}}");
                if (!c.IsNullable) T("              required");
                T("            >");
                T("              <option value=\"\"></option>");
                foreach (string choice in c.Choices!)
                    T($"              <option value=\"{ChoiceFormat.Html(choice)}\">{ChoiceFormat.Html(choice)}</option>");
                T("            </select>");
            }
            else if (kind == FieldKind.Boolean)
            {
                T($"            <input");
                T($"              id=\"{id}\"");
                T("              type=\"checkbox\"");
                T($"              aria-label=\"{Labels.Field(c)}\"");
                T($"              checked={{!!selectedRow.{prop}}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.checked }})}}");
                T("            />");
            }
            else if (kind == FieldKind.Date)
            {
                // A nullable date has a Clear button beside it (the date box's own clear is easy to miss, and WinUI3's calendar has a Clear button too).
                if (c.IsNullable) T("            <div style={{ display: 'flex', gap: 8 }}>");
                T($"            <input");
                T($"              id=\"{id}\"");
                T("              type=\"date\"");
                T($"              aria-label=\"{Labels.Field(c)}\"");
                T(c.IsNullable ? $"              value={{selectedRow.{prop} ?? ''}}" : $"              value={{selectedRow.{prop}}}");
                T(c.IsNullable ? $"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value || undefined }})}}" : $"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value }})}}");
                if (!c.IsNullable) T("              required");
                T("            />");
                if (c.IsNullable)
                {
                    T($"            <button type=\"button\" onClick={{() => setSelectedRow({{ ...selectedRow, {prop}: undefined }})}}>Clear</button>");
                    T("            </div>");
                }
            }
            else if (kind == FieldKind.Money)
            {
                // the money box shows $1,234.50 and takes the plain number; the limits are the column's CHECK constraint, or 0 for a column the project lists as never negative
                var money = MoneyBox.For(Model.TableName, c, Project);
                T($"            <CurrencyInput");
                T($"              id=\"{id}\"");
                T($"              label=\"{Labels.Field(c)}\"");
                T($"              value={{selectedRow.{prop}}}");
                T($"              onChange={{(value) => setSelectedRow({{ ...selectedRow, {prop}: value ?? {(c.IsNullable ? "undefined" : "0")} }})}}");
                T($"              digits={{{money.Digits}}}");
                T($"              currency=\"{money.Currency}\"");
                if (money.Min is { } lo) T($"              min={{{lo}}}");
                if (money.Max is { } hi) T($"              max={{{hi}}}");
                if (!c.IsNullable) T("              required");
                T("            />");
            }
            else if (kind == FieldKind.Number)
            {
                var box = NumberBox.For(Model.TableName, c, Project);
                T($"            <input");
                T($"              id=\"{id}\"");
                T("              type=\"number\"");
                T($"              aria-label=\"{Labels.Field(c)}\"");
                if (box.Characters is { } boxWidth) T($"              style={{{{ width: '{boxWidth}ch' }}}}");
                if (box.Step is { } step) T($"              step=\"{step}\"");
                // A whole-number column carries the limits its name and SQL type imply (a month 1-12, a year MinYear-MaxYear, ...).
                if (box.Min is { } min) T($"              min=\"{min}\"");
                if (box.Max is { } max) T($"              max=\"{max}\"");
                T($"              value={{selectedRow.{prop}}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: Number(event.target.value) }})}}");
                T($"              placeholder=\"{Labels.Placeholder(c)}\"");
                if (!c.IsNullable) T("              required");
                T("            />");
            }
            else if (kind == FieldKind.Multiline)
            {
                T($"            <textarea");
                T($"              id=\"{id}\"");
                T($"              aria-label=\"{Labels.Field(c)}\"");
                T($"              value={{selectedRow.{prop}}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value }})}}");
                T($"              maxLength={{{Chars(c)}}}");
                T($"              placeholder=\"{Labels.Placeholder(c)}\"");
                if (!c.IsNullable) T("              required");
                T("            />");
            }
            else
            {
                T($"            <input");
                T($"              id=\"{id}\"");
                T($"              type=\"{c.InputType(Project, Model.TableName)}\"");
                if (c.InputPattern(Project, Model.TableName) is { Length: > 0 } pattern) T("              " + pattern);
                T($"              aria-label=\"{Labels.Field(c)}\"");
                T($"              value={{selectedRow.{prop}}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value }})}}");
                if (IsText(c) && Chars(c) > 0) T($"              maxLength={{{Chars(c)}}}");
                T($"              placeholder=\"{Labels.Placeholder(c)}\"");
                if (!c.IsNullable) T("              required");
                T("            />");
            }
            if (guard is not null)
            {
                T("              </>");
                T("            ) : (");
                T("              <>");
                T($"                <span id=\"{id}\">{{selectedRow.{prop}{(c.IsBooleanColumn ? " ? 'Yes' : 'No'" : "")}}}</span> <small style={{{{ marginLeft: 8 }}}}>{ChoiceFormat.Html(guard.Note)}</small>");
                T("              </>");
                T("            )}");
            }
        }
        if (tabbed) T("            </div>");
        }
        T();
        T("            <div className=\"form-buttons\">");
        T(tabbed ? "              <button type=\"submit\" onClick={revealInvalidTab}>Submit</button>" : "              <button type=\"submit\">Submit</button>");
        T("              <button type=\"button\" onClick={cancel}>Cancel</button>");
        T("            </div>");
        T("          </form>");
        T("        </dialog>");
        T("      )}");
        T("    </div>");
        T("  );");
        T("}");

        // ================= test
        var test = new StringBuilder();
        void S(string s = "") => test.Append(s).Append('\n');
        // the Columns list tests (further down) need a column whose caption and words are its own, so a test can tell its header and its check box from the others
        bool Own(ChosenColumn c) => columnList.Count(other => other.Caption == c.Caption) == 1 && columnList.Count(other => other.Label == c.Label) == 1;
        string Js(string text) => text.Replace("\\", "\\\\").Replace("'", "\\'");
        bool initialCountOk = columnList.Count(c => c.Initial) >= 2;   // the last shown column cannot be cleared
        var cleared = chooseColumns && initialCountOk ? columnList.FirstOrDefault(c => c.Initial && Own(c)) : null;
        var ticked = chooseColumns ? columnList.FirstOrDefault(c => !c.Initial && Own(c)) : null;
        var sortedColumn = chooseColumns && initialCountOk ? columnList.FirstOrDefault(c => c.Initial && c.Sortable && Own(c)) : null;
        bool columnTests = cleared is not null || ticked is not null || sortedColumn is not null;
        S(textKey || odata || nameActive || form.Guards.Count > 0 || columnTests ? "import { fireEvent, render, screen } from '@testing-library/react';" : "import { render, screen } from '@testing-library/react';");
        S("import { MemoryRouter } from 'react-router-dom';");
        S("import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';");
        S($"import {{ {pageName} }} from '../{pageName}';");
        S($"import {{ {apiVar} }} from '../../{apiFolder}/{apiFile}';");
        if (gated) S($"import {{ setSession }} from '../../{apiFolder}/auth';");
        foreach (var p in parents.Where(p => !p.IsSelf))
            S($"import {{ {ReactNames.ApiVar(p.Table)} }} from '../../{apiFolder}/{ReactNames.ApiFile(p.Table)}';");
        S();
        S($"describe('{pageName}', () => {{");
        S("  beforeEach(() => {");
        S(nameActive ? $"    vi.spyOn({apiVar}, 'getAll').mockResolvedValue([]);" : $"    vi.spyOn({apiVar}, '{(odata ? "queryPage" : "getPage")}').mockResolvedValue({{ items: [], page: 1, pageSize: {pageSize}, totalCount: 0, totalPages: 0 }});");
        foreach (var p in parents)
            S($"    vi.spyOn({ReactNames.ApiVar(p.Table)}, '{p.LoadMethod}').mockResolvedValue([]);");
        S("  });");
        S();
        S("  afterEach(() => {");
        S("    vi.restoreAllMocks();");
        if (gated) S("    setSession(null);");
        S("  });");
        S();
        S($"  it('renders the {title} heading', async () => {{");
        S($"    render(<MemoryRouter><{pageName} /></MemoryRouter>);");
        S($"    expect(await screen.findByText('{title.Pluralize()}')).toBeInTheDocument();");
        S("  });");
        if (gated)
        {
            string allowed = writeRoles.Count > 1 ? writeRoles[1] : writeRoles[0];
            S();
            S("  it('shows Add New to a role that may write', async () => {");
            S($"    setSession({{ token: 'abc', user: {{ name: 'Pat', role: '{allowed}' }} }});");
            S($"    render(<MemoryRouter><{pageName} /></MemoryRouter>);");
            S($"    expect(await screen.findByText('Add New')).toBeInTheDocument();");
            S("  });");
            S();
            S("  it('hides Add New from a role that may not write', async () => {");
            S("    setSession({ token: 'abc', user: { name: 'Pat', role: 'NoSuchRole' } });");
            S($"    render(<MemoryRouter><{pageName} /></MemoryRouter>);");
            S($"    await screen.findByText('{title.Pluralize()}');");
            S($"    expect(screen.queryByText('Add New')).toBeNull();");
            S("  });");
        }
        if (form.Guards.Count > 0 && !nameActive)
        {
            // a guarded column is a control for a person the guards answer yes for, and text with the reason for everyone else
            var guard0 = form.Guards[0];
            string note = guard0.Note.Replace("\\", "\\\\").Replace("'", "\\'");
            string guardKey = textKey ? $"{keyProp}: '{ApiSampleValues.KeyText(keyColumn)}'" : $"{keyProp}: 1";
            string guardRow = "{ " + string.Join(", ", new[] { guardKey }.Concat(adds.Where(a => !a.StartsWith(keyProp + ":")))) + " }";
            string listCall = odata ? "queryPage" : "getPage";
            string guardLabel = Labels.Field(Model.Columns.First(c => c.Name.EqualsIgnoreCase(guard0.Column)));
            foreach (bool mayChange in new[] { false, true })
            {
                S();
                S(mayChange
                    ? $"  it('shows the guarded {guard0.Json} column as a control to a person who may change it', async () => {{"
                    : $"  it('shows the guarded {guard0.Json} column as text with the reason to a person who may not change it', async () => {{");
                S("    HTMLDialogElement.prototype.showModal = function () { this.setAttribute('open', ''); };");
                if (gated) S($"    setSession({{ token: 'abc', user: {{ name: 'Pat', role: '{(writeRoles.Count > 1 ? writeRoles[1] : writeRoles[0])}' }} }});");
                S($"    vi.spyOn({apiVar}, '{listCall}').mockResolvedValue({{ items: [{guardRow}], page: 1, pageSize: {pageSize}, totalCount: 1, totalPages: 1 }});");
                S($"    vi.spyOn({apiVar}, 'getGuards').mockResolvedValue({{ {guard0.Json}: {(mayChange ? "true" : "false")} }});");
                S($"    render(<MemoryRouter><{pageName} /></MemoryRouter>);");
                S("    fireEvent.click(await screen.findByText('Edit'));");
                S($"    expect(await screen.findByText('Edit {title}')).toBeInTheDocument();");
                S(mayChange
                    ? $"    expect(await screen.findByLabelText('{guardLabel}')).toBeInTheDocument();"
                    : $"    expect(await screen.findByText('{note}')).toBeInTheDocument();");
                S("  });");
            }
        }
        if (textKey)
        {
            // the key is typed on a new row and read-only on an existing one; jsdom has no showModal, so the test gives the dialog one that just opens it
            string sampleKey = ApiSampleValues.KeyText(keyColumn);
            string sampleRow = "{ " + string.Join(", ", adds.Select((a, i) => i == 0 ? $"{keyProp}: '{sampleKey}'" : a)) + " }";
            S();
            S($"  it('lets the person type the key of a new {Labels.Words(baseName).ToLowerInvariant()} and does not let them change it afterwards', async () => {{");
            S("    HTMLDialogElement.prototype.showModal = function () { this.setAttribute('open', ''); };");
            S($"    vi.spyOn({apiVar}, '{(odata ? "queryPage" : "getPage")}').mockResolvedValue({{ items: [{sampleRow}], page: 1, pageSize: {pageSize}, totalCount: 1, totalPages: 1 }});");
            S($"    render(<MemoryRouter><{pageName} /></MemoryRouter>);");
            S($"    fireEvent.click(await screen.findByText('Add New'));");
            S($"    expect(await screen.findByText('Add {title}')).toBeInTheDocument();");
            S($"    expect(screen.getByLabelText('{Labels.Field(keyColumn)}')).not.toHaveAttribute('readonly');");
            S("    fireEvent.click(screen.getByText('Cancel'));");
            S("    fireEvent.click(await screen.findByText('Edit'));");
            S($"    expect(await screen.findByText('Edit {title}')).toBeInTheDocument();");
            S($"    expect(screen.getByLabelText('{Labels.Field(keyColumn)}')).toHaveAttribute('readonly');");
            S("  });");
        }
        if (nameActive)
        {
            S();
            S("  it('narrows the list by name and by active', async () => {");
            S($"    vi.spyOn({apiVar}, 'getAll').mockResolvedValue([{{ {keyProp}: 1, name: 'Alpha', isActive: true }}, {{ {keyProp}: 2, name: 'Alphabet', isActive: false }}, {{ {keyProp}: 3, name: 'Beta', isActive: true }}] as never);");
            S($"    render(<MemoryRouter><{pageName} /></MemoryRouter>);");
            S("    expect(await screen.findByText('Beta')).toBeInTheDocument();");
            S("    fireEvent.change(screen.getByLabelText('Search by Name'), { target: { value: 'alpha' } });");
            S("    expect(screen.queryByText('Beta')).toBeNull();");
            S("    expect(screen.getByText('Alphabet')).toBeInTheDocument();");
            S("    fireEvent.click(screen.getByLabelText(/Active only/));");
            S("    expect(screen.queryByText('Alphabet')).toBeNull();");
            S("    expect(screen.getByText('Alpha')).toBeInTheDocument();");
            S("    fireEvent.click(screen.getByText('Clear'));");
            S("    expect(screen.getByText('Beta')).toBeInTheDocument();");
            S("  });");
        }
        else if (odata)
        {
            var sortable = gridColumns.FirstOrDefault(c => sortableColumns.Contains(c));
            S();
            S("  it('asks the server for the first page with the columns the grid shows', async () => {");
            S($"    render(<MemoryRouter><{pageName} /></MemoryRouter>);");
            S($"    await screen.findByText('{title.Pluralize()}');");
            S($"    expect({apiVar}.queryPage).toHaveBeenCalledWith(expect.objectContaining({{ pageNumber: 1, pageSize: {pageSize}, select: expect.arrayContaining(['{JsonNames.Camel(gridColumns[0].Name)}']) }}));");
            S("  });");
            if (sortable is not null)
            {
                string sortLabel = GridCaption.For(sortable, Labels.Field(sortable));
                S();
                S("  it('sorts by a header on a click and adds a second column on a Shift-click', async () => {");
                S("    localStorage.clear();");
                S($"    render(<MemoryRouter><{pageName} /></MemoryRouter>);");
                S($"    fireEvent.click(await screen.findByRole('button', {{ name: '{sortLabel}' }}));");
                S($"    expect({apiVar}.queryPage).toHaveBeenLastCalledWith(expect.objectContaining({{ pageNumber: 1, sorts: [{{ column: '{sortable.Name}', descending: false }}] }}));");
                S($"    fireEvent.click(await screen.findByRole('button', {{ name: /^{System.Text.RegularExpressions.Regex.Escape(sortLabel)}/ }}), {{ shiftKey: true }});");
                S($"    expect({apiVar}.queryPage).toHaveBeenLastCalledWith(expect.objectContaining({{ sorts: [{{ column: '{sortable.Name}', descending: true }}] }}));");
                S("    localStorage.clear();");
                S("  });");
            }
            if (columnList.Where(c => c.Initial).Select(c => c.Filter).FirstOrDefault(f => f is { Kind: ODataFilterKind.Text }) is { } textFilter)
            {
                string filterLabel = Labels.Field(gridColumns.First(c => c.Name == textFilter.Name));
                S();
                S("  it('sends what was typed in the filter row when Search is pressed', async () => {");
                S($"    render(<MemoryRouter><{pageName} /></MemoryRouter>);");
                S($"    fireEvent.change(await screen.findByLabelText('Filter by {filterLabel}'), {{ target: {{ value: 'ab' }} }});");
                S("    fireEvent.click(screen.getByText('Search'));");
                S($"    expect({apiVar}.queryPage).toHaveBeenLastCalledWith(expect.objectContaining({{ pageNumber: 1, conditions: [{{ kind: 'contains', property: '{textFilter.Property}', text: 'ab' }}] }}));");
                S("  });");
            }
        }
        if (chooseColumns)
        {
            // the Columns list: a column cleared leaves the grid (and the $select of an OData page), a column ticked joins it, a sort on a hidden column is dropped, Reset puts the starting columns back
            string storageKey = "gridColumns:" + gridId;
            string select(ChosenColumn c, bool has) => odata ? $"    expect({apiVar}.queryPage).toHaveBeenLastCalledWith(expect.objectContaining({{ select: expect.{(has ? "arrayContaining" : "not.arrayContaining")}(['{c.Property}']) }}));" : "";
            void Headers()
            {
                S("    const headers = () => screen.getAllByRole('columnheader').map((header) => header.textContent ?? '');");
            }
            if (cleared is not null)
            {
                S();
                S("  it('hides a column the person clears, keeps the choice and brings it back on Reset', async () => {");
                S("    localStorage.clear();");
                S($"    render(<MemoryRouter><{pageName} /></MemoryRouter>);");
                S($"    await screen.findByText('{title.Pluralize()}');");
                Headers();
                S($"    expect(headers()).toContain('{Js(cleared.Caption)}');");
                S($"    fireEvent.click(screen.getByLabelText('{Js(cleared.Label)}'));");
                S($"    expect(headers()).not.toContain('{Js(cleared.Caption)}');");
                S($"    expect(JSON.parse(localStorage.getItem('{storageKey}') ?? 'null')).not.toContain('{Js(cleared.Name)}');");
                if (odata) S(select(cleared, false));
                S("    fireEvent.click(screen.getByText('Reset'));");
                S($"    expect(headers()).toContain('{Js(cleared.Caption)}');");
                S($"    expect(localStorage.getItem('{storageKey}')).toBeNull();");
                S("    localStorage.clear();");
                S("  });");
            }
            if (ticked is not null)
            {
                S();
                S("  it('shows a column the grid does not start with when the person ticks it', async () => {");
                S("    localStorage.clear();");
                S($"    render(<MemoryRouter><{pageName} /></MemoryRouter>);");
                S($"    await screen.findByText('{title.Pluralize()}');");
                Headers();
                S($"    expect(headers()).not.toContain('{Js(ticked.Caption)}');");
                S($"    fireEvent.click(screen.getByLabelText('{Js(ticked.Label)}'));");
                S($"    expect(headers()).toContain('{Js(ticked.Caption)}');");
                if (odata) S(select(ticked, true));
                S("    localStorage.clear();");
                S("  });");
            }
            if (sortedColumn is not null)
            {
                S();
                S("  it('drops the sort of a column that is then hidden', async () => {");
                S("    localStorage.clear();");
                S($"    render(<MemoryRouter><{pageName} /></MemoryRouter>);");
                S($"    fireEvent.click(await screen.findByRole('button', {{ name: '{Js(sortedColumn.Caption)}' }}));");
                S(odata
                    ? $"    expect({apiVar}.queryPage).toHaveBeenLastCalledWith(expect.objectContaining({{ sorts: [{{ column: '{sortedColumn.Name}', descending: false }}] }}));"
                    : $"    expect({apiVar}.getPage).toHaveBeenLastCalledWith(1, {pageSize}, expect.anything(), {{ column: '{sortedColumn.Name}', descending: false }});");
                S($"    fireEvent.click(screen.getByLabelText('{Js(sortedColumn.Label)}'));");
                S(odata
                    ? $"    expect({apiVar}.queryPage).toHaveBeenLastCalledWith(expect.objectContaining({{ sorts: [] }}));"
                    : $"    expect({apiVar}.getPage).toHaveBeenLastCalledWith(1, {pageSize}, expect.anything(), null);");
                S("    localStorage.clear();");
                S("  });");
            }
        }
        S("});");

        var o = new StringBuilder();
        o.Append($"@@@FILE {pagesFolder}/{pageName}.tsx@@@\n").Append(nameActive ? ts.ToString().Replace("load(page)", "load()") : ts.ToString());
        o.Append($"@@@FILE {pagesFolder}/__tests__/{pageName}.test.tsx@@@\n").Append(test);
        Write(o.ToString());
    }
#>
