<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string apiNamespace = "MyApp.ApiService.Apis";
    string contextType = "MyAppContext";
    // Namespaces the generated file must "using" (for example "MyApp.Entities"; leave empty when the project supplies them through
    // global usings). Each entry becomes a using line in the generated file.
    string[] usings = { };
    // Tables that have no repository (and so no API): C# enums, other *Type lookup tables, tables with no entity class.
    string[] noRepositoryTables =
    {
        "ClearanceType", "ExpenseType", "LeaveType", "OvertimeType", "SY_RequestStatusType", "SY_RequestType",
        "SY_ResponseType", "SY_Role", "SY_Display", "SY_ISOCountry", "SY_PerDiem", "sysdiagrams"
    };
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    contextType = Project.ContextName ?? contextType;
    apiNamespace = Project.ApiNamespace ?? apiNamespace;
    usings = Project.Usings ?? usings;
    // With a project chosen, which tables count as enums (no entity/repository/API of their own) comes from the project's
    // EnumTables, else from what the schema says about each table (LookupShape) - not from the lists above, which are
    // only used when no project is chosen.
    bool NoRepository(string table, LookupShape shape) => Project.NoRepository(table, shape) ?? noRepositoryTables.Contains(table, StringComparer.OrdinalIgnoreCase);
    // ==========================================================================================

    // ==========================================================================================
    // API_Crud_v1.tt
    // Generates: <TableName>Api.cs   (see OutputName in API_Crud_v1.tt.config)
    // A minimal-API class for one table: GET all, GET one, POST, PUT and DELETE over the table's repository (<Entity>Repo from CS_Repo).
    // Needs a single int primary key (the routes are {id:int}); a name/active table or a table with no repository stops with an error.
    // Does not write the entity, its DbSet or the registration line (CS_Entity, CS_DbContext and API_Registration do), nor any business rule.
    // Full notes: Docs/TemplateNotes/API_Crud_v1.md
    // ==========================================================================================

    var keyColumn = Model.PrimaryKeyColumns.Count == 1 ? Model.PrimaryKeyColumns[0] : null;
    bool supported = keyColumn is not null && keyColumn.IsInt32Column
                     && !NoRepository(Model.TableName, Model.LookupShape);
    if (NoRepository(Model.TableName, Model.LookupShape))
    {
        Error($"API_Crud writes no API for [{Model.SchemaName}].[{Model.TableName}]: it is listed in noRepositoryTables (an enum, a *Type lookup table, or a table with no entity class), so it has no repository for the handlers to use.");
    }
    else if (Model.Columns.Any(c => c.IsStringColumn && !c.IsNullable && c.Name == "Name")
             && Model.Columns.Any(c => c.IsBooleanColumn && !c.IsNullable && c.Name == "IsActive"))
    {
        supported = false;
        Error($"API_Crud is for plain tables. [{Model.SchemaName}].[{Model.TableName}] has a Name and an IsActive column, so its repository is a NameActiveRepo and its API needs duplicate-name checks and trimming; write that API by hand.");
    }
    else if (!supported)
    {
        Error($"API_Crud needs a table with a single int primary key, but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "no primary key." : Model.PrimaryKeyColumns.Count > 1
                    ? "a composite primary key (" + string.Join(", ", Model.PrimaryKeyColumns.Select(c => c.Name)) + ")."
                    : $"a {Model.PrimaryKeyColumns[0].SqlTypeDeclaration} primary key."));
    }

    string usingLines = string.Concat(usings.Select(u => $"using {u};\n"));

    // A table with a database-assigned int key and a clone routine gets POST <route>/{id}/clone (CloneShape; CS_Repo writes CloneAsync for the same tables).
    bool canClone = supported && CloneShape.CanClone(Model, Project);

    string entity = Model.TableName;
    string keyProperty = keyColumn?.Name ?? "";

    // ==== the column GetAll sorts by (see above)
    bool IsSortableDate(ColumnModel c) =>
        c.SqlType is SqlDbType.Date or SqlDbType.DateTime or SqlDbType.DateTime2 or SqlDbType.SmallDateTime;
    var sortColumn = Model.Columns
        .Where(c => IsSortableDate(c) && !c.IsNullable && !c.IsComputed && !c.IsAuditColumn
                    && !c.IsCreateDateColumn && !c.IsModifiedDateColumn && !c.IsLastChangedDateColumn)
        .OrderBy(c => c.OrdinalPosition)
        .FirstOrDefault();

    if (supported)
    {
#>
namespace <#= apiNamespace #>;

<#= usingLines #>using Microsoft.EntityFrameworkCore;
using static Microsoft.AspNetCore.Http.TypedResults;

/// <summary> One page of <#= entity #> rows, in the shape the search endpoints answer with. </summary>
public record <#= entity #>Page(IReadOnlyList<<#= entity #>> Items, int Page, int PageSize, int TotalCount, int TotalPages);

public class <#= entity #>Api<T> : BaseApi<T> where T : class
{
    // the most rows one page may hold; a larger pageSize is lowered to this
    private const int MaxPageSize = 1000;

    public override void Register(WebApplication app)
    {
        BreakIntoStrings(out string singular, out string plural, out string _apiSubDir);

        // Get all
        app.MapGet(_apiSubDir, GetAll)
       .WithName($"Get{plural}")
       .WithOpenApi()
       .Produces<IEnumerable<T>>()
       .Produces<<#= entity #>Page>()
       .ProducesProblem(400)
       .ProducesProblem(404)
       .ProducesProblem(500);

        // Get by ID
        app.MapGet(_apiSubDir + "/{id:int}", GetById)
        .WithName($"Get{singular}ById")
        .WithOpenApi()
        .Produces<T>()
        .ProducesProblem(404)
        .ProducesProblem(500);

        // Create new
        app.MapPost(_apiSubDir, CreateRow)
        .WithName($"Create{singular}")
        .WithOpenApi()
<#
        if (Project.ApiValidation)
        {
#>
        .AddEndpointFilter<ValidationFilter<<#= entity #>>>()
<#
        }
#>
        .ProducesProblem(500);

        // Update existing
        app.MapPut(_apiSubDir + "/{id:int}", UpdateRow)
        .WithName($"Update{singular}")
        .WithOpenApi()
<#
        if (Project.ApiValidation)
        {
#>
        .AddEndpointFilter<ValidationFilter<<#= entity #>>>()
<#
        }
#>
        .ProducesProblem(400)
        .ProducesProblem(404)
        .ProducesProblem(500);

        // Delete
        app.MapDelete(_apiSubDir + "/{id:int}", DeleteRow)
        .WithName($"Delete{singular}")
        .WithOpenApi()
        .ProducesProblem(404)
        .ProducesProblem(500);
<#
        if (canClone)
        {
#>

        // Clone: copy a row into a new one and return it (the grids' Clone button opens the copy in the edit form)
        app.MapPost(_apiSubDir + "/{id:int}/clone", CloneRow)
        .WithName($"Clone{singular}")
        .WithOpenApi()
        .ProducesProblem(404)
        .ProducesProblem(500);
<#
        }
#>
    }

    /// <summary>
    /// Every row as a plain array (drop-downs and small tables use this), or, when pageNumber or pageSize is given, one page of them with the total:
    /// the table's route with pageNumber=2 and pageSize=50 in the query string. The page is ordered like the array and by the key, so pages do not overlap; a big table is read a page at a time.
    /// </summary>
    private static async Task<IResult> GetAll([FromServices] <#= contextType #> context, [FromQuery] int? pageNumber = null, [FromQuery] int? pageSize = null)
    {
        if (pageNumber is not null || pageSize is not null)
        {
            // 0 or less is an error inside the database (FETCH NEXT 0 ROWS) and a huge size reads the whole table: keep it between 1 and MaxPageSize
            int size = Math.Clamp(pageSize ?? 100, 1, MaxPageSize);
            int number = pageNumber ?? 1;
            if (number < 1)
                return Results.Problem(statusCode: 400, title: "Invalid page", detail: "pageNumber must be 1 or greater.");
            if ((long)(number - 1) * size > int.MaxValue)
                return Results.Problem(statusCode: 400, title: "Invalid page", detail: "pageNumber is too large for that pageSize.");

            IQueryable<<#= entity #>> all = context.Set<<#= entity #>>().AsNoTracking();
            int totalCount = await all.CountAsync();
            var page = await <#= sortColumn is not null ? "all.OrderByDescending(c => c." + sortColumn.Name + ").ThenBy(c => c." + keyProperty + ")" : "all.OrderBy(c => c." + keyProperty + ")" #>
                .Skip((number - 1) * size).Take(size).ToListAsync();
            return Ok(new <#= entity #>Page(page, number, size, totalCount, totalCount == 0 ? 0 : (int)Math.Ceiling(totalCount / (double)size)));
        }

        <#= entity #>Repo repo = new(context);
<#
        if (sortColumn is not null)
        {
#>
        var rows = await repo.GetAllOrderByDescending(c => c.<#= sortColumn.Name #>);
<#
        }
        else
        {
#>
        var rows = await repo.GetAll();
<#
        }
#>
        return Ok(rows);
    }

    private static async Task<IResult> GetById([FromServices] <#= contextType #> context, int id)
    {
        <#= entity #>Repo repo = new(context);
        var row = await repo.GetByIdAsync(id);
        return row != null ? Results.Ok(row) : Results.NotFound();
    }

    private static async Task<IResult> CreateRow([FromServices] <#= contextType #> context, [FromBody] <#= entity #> newRow)
    {
        <#= entity #>Repo repo = new(context);
        await repo.AddAsync(newRow);
        return Results.Created($"/api{_apiSubDir}/{newRow.<#= keyProperty #>}", newRow);
    }

    private static async Task<IResult> UpdateRow([FromServices] <#= contextType #> context, int id, [FromBody] <#= entity #> updatedRow)
    {
        if (updatedRow.<#= keyProperty #> != id)
            return Results.BadRequest(); // 400 error if the id in the URL and the id in the body disagree

        <#= entity #>Repo repo = new(context);
        if (!await repo.ExistsAsync(id))
            return Results.NotFound(); // 404 error if there is no row with that id
        var postUpdate = await repo.UpdateAsync(id, updatedRow);
        return Results.Ok(postUpdate);
    }

    private static async Task<IResult> DeleteRow([FromServices] <#= contextType #> context, int id)
    {
        <#= entity #>Repo repo = new(context);
        var successNum = await repo.DeleteAsync("<#= entity #>", id);
        if (successNum == 0)
            return Results.Ok();
        else if (successNum == -1)
            return Results.NotFound(); // cannot delete because does not exist
        else
            return Results.BadRequest(); // cannot delete because "in use"
    }
<#
        if (canClone)
        {
#>

    private static async Task<IResult> CloneRow([FromServices] <#= contextType #> context, int id)
    {
        <#= entity #>Repo repo = new(context);
        if (!await repo.ExistsAsync(id))
            return Results.NotFound(); // 404 error if there is no row to copy
        int newId = await repo.CloneAsync(id);
        var copy = await repo.GetByIdAsync(newId);
        return Results.Created($"/api{_apiSubDir}/{newId}", copy);
    }
<#
        }
#>
}
<#
    }
#>
