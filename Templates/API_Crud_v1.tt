<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string apiNamespace = "MyApp.ApiService.Apis";
    string contextType = "MyAppContext";
    // Namespaces the generated file must "using" (for example "MyApp.Entities"; leave empty when the project supplies them through
    // global usings). Each entry becomes a using line in the generated file.
    string[] usings = { };
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    contextType = Project.ContextName ?? contextType;
    apiNamespace = Project.ApiNamespace ?? apiNamespace;
    usings = Project.Usings ?? usings;
    // Which tables count as enums (no entity, repository or API of their own) comes from the project's EnumTables, else from the schema (LookupShape).
    bool NoRepository(string table, LookupShape shape) => Project.NoRepositoryFor(table, shape);
    // ==========================================================================================

    // ==========================================================================================
    // API_Crud_v1.tt
    // Generates: <TableName>Api.cs   (see OutputName in API_Crud_v1.tt.config)
    // A short class on CrudApi (Apis/CrudApi.cs, written by API_EssentialCrudApi) for one table: it names the table's repository (<Entity>Repo from CS_Repo), its key and the date column the list comes newest
    // first by, and says whether the table can be cloned, found by name or looked up (GET <route>/lookup answers { id, name, isActive }: only the key and the display column are read) (GET <route>/{name}, for a table with a Name). The five endpoints (GET all or one page, GET one, POST, PUT, DELETE, and POST clone) and their answers are in CrudApi, written once.
    // A table with a NOT NULL Name and a NOT NULL IsActive column (its repository is a NameActiveRepo) gets a class on NameActiveCrudApi (the same file): the name is trimmed and checked, a second active row with
    // the same name is a 409 problem, and the list, the active list (GET <route>/active) and find by name are its routes. It names its repository and key only.
    // Needs a single int primary key (the routes are {id:int}); a table with no repository stops with an error.
    // Does not write the entity, its DbSet or the registration line (CS_Entity, CS_DbContext and API_Registration do), nor any business rule.
    // Full notes: Docs/TemplateNotes/API_Crud_v1.md
    // ==========================================================================================

    // the key's C# type, route and kind come from KeyType (Core): an int, a bigint, a uniqueidentifier or a text key
    var keyColumn = Model.PrimaryKeyColumns.Count == 1 ? Model.PrimaryKeyColumns[0] : null;
    var keyType = Model.PrimaryKeyType;
    bool supported = keyType is not null && !NoRepository(Model.TableName, Model.LookupShape)
                     && (!Model.IsNameActiveTable || keyColumn!.IsInt32Column);   // a Name and IsActive table stays int-keyed
    if (NoRepository(Model.TableName, Model.LookupShape))
    {
        Error($"API_Crud writes no API for [{Model.SchemaName}].[{Model.TableName}]: it is an enum or lookup table (an enum, a *Type lookup table, or a table with no entity class), so it has no repository for the handlers to use.");
    }
    else if (!supported)
    {
        Error($"API_Crud needs a table with a single int, uniqueidentifier or text primary key (a Name and IsActive table needs an int one), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "no primary key." : Model.PrimaryKeyColumns.Count > 1
                    ? "a composite primary key (" + string.Join(", ", Model.PrimaryKeyColumns.Select(c => c.Name)) + ")."
                    : $"a {Model.PrimaryKeyColumns[0].SqlTypeDeclaration} primary key."));
    }

    // Dtos: the API takes <Table>Input (CS_DtoInput) and answers <Table>Dto (CS_Dto) in the DtoNamespace; DtoShape is the one rule the DTO templates ask too
    bool dtos = supported && !Model.IsNameActiveTable && DtoShape.Uses(Model, Project);
    if (dtos)
        usings = usings.Append(Project.DtoNamespace ?? "MyApp.Dtos").ToArray();

    string usingLines = string.Concat(usings.Select(u => $"using {u};\n"));

    // A table with a Name and an IsActive column: NameActiveRepo is its repository, NameActiveCrudApi its base (no clone, no search; CloneShape leaves it out).
    bool nameActive = supported && Model.IsNameActiveTable;

    // A table with a database-assigned int key and a clone routine gets POST <route>/{id}/clone (CloneShape; CS_Repo writes CloneAsync for the same tables).
    bool canClone = supported && !nameActive && CloneShape.CanClone(Model, Project);

    bool canFindByName = supported && Model.CanFindByName;

    string entity = Model.TableName;
    string keyProperty = keyColumn?.Name ?? "";
    string keyCSharp = keyType?.CSharp ?? "int";
    // the int key keeps the original two-argument base and the non-generic LookupItem; any other key names its type
    string apiBase = nameActive ? "NameActiveCrudApi" : "CrudApi";
    string keyArgument = nameActive || keyCSharp == "int" ? "" : ", " + keyCSharp;
    // an API with an input and an output type names both after its repository (and its key, unless it is an int)
    string dtoArguments = dtos ? $", {Model.TableName}Input, {Model.TableName}Dto" : "";
    string lookupItem = keyCSharp == "int" ? "LookupItem" : "LookupItem<" + keyCSharp + ">";

    // ApiAuth with WriteRoles or TableWriteRoles: the roles that may write this table (empty: any signed-in person)
    IReadOnlyList<string> writeRoles = supported ? WriteRolePlan.For(Project, Model) : new List<string>();
    IReadOnlyList<string> readRoles = supported ? WriteRolePlan.ReadFor(Project, Model) : new List<string>();

    // ApiAuth with OwnedTables: a caller reaches only the rows of the owners the IOwnerScope allows (the owner column; a Name and IsActive table is never scoped)
    var ownerColumn = supported && !nameActive ? OwnedTable.OwnerColumn(Model, Project) : null;
    bool ownerUnusable = supported && !nameActive && OwnedTable.IsListedButUnusable(Model, Project);
    // a table with no owner column of its own, hanging off an owned table (the detail rows of a time sheet), belongs to the owner of its parent row
    var ownerLink = supported && !nameActive ? OwnedTable.Through(Model, Project) : null;
    string ownerUsing = ownerLink is not null && !usings.Contains("Microsoft.EntityFrameworkCore") ? "using Microsoft.EntityFrameworkCore;\n" : "";

    // EditableChildren: the child tables a form of this table saves in the same request (EditableChild, the one rule the Angular screen asks too)
    var editableChildren = supported ? EditableChild.Of(Model, Project) : [];

    // ListProtocol=Search: the one search box matches SearchBox's columns and the grid sorts by SearchPlan's (the same names the Columns protocol sorts by)
    bool listSearch = supported && !nameActive && Project.ListSearchProtocol;
    var searchNavigations = listSearch ? EntityNavigations.Of(Model, fk => Project.NoNavigation(fk.ReferencedTable, fk.ReferencedLookupShape) ?? false) : new List<EntityNavigation>();
    var searchPlan = listSearch ? SearchPlan.For(Model, searchNavigations) : null;
    var searchTerms = listSearch ? SearchBox.For(Model, Project, searchNavigations) : new List<SearchBoxTerm>();

    // ==== the column GetAll sorts by (see above)
    bool IsSortableDate(ColumnModel c) =>
        c.SqlType is SqlDbType.Date or SqlDbType.DateTime or SqlDbType.DateTime2 or SqlDbType.SmallDateTime;
    var sortColumn = nameActive ? null : Model.Columns
        .Where(c => IsSortableDate(c) && !c.IsNullable && !c.IsComputed && !c.IsAuditColumn
                    && !c.IsAuditDateColumn)
        .OrderBy(c => c.OrdinalPosition)
        .FirstOrDefault();

    // GET <route>/lookup answers { id, name, isActive } (only the key, the display column and the flag are read) for a table with a display column (DisplayColumnSelector); a Name and IsActive table always has one.
    var displayColumn = supported && !nameActive ? Model.DisplayColumns.FirstOrDefault() : null;   // the column the screens' drop-downs show (ForeignKeyModel.ReferencedDisplayColumns[0])
    var activeColumn = Model.Columns.FirstOrDefault(c => c.IsBooleanColumn && !c.IsNullable && c.Name == "IsActive");
    string lookupName = displayColumn is null ? ""
        : displayColumn.IsStringColumn ? $"c.{displayColumn.Name}" + (displayColumn.IsNullable ? " ?? \"\"" : "")
        : displayColumn.IsNullable ? $"c.{displayColumn.Name} == null ? \"\" : c.{displayColumn.Name}.ToString()!"
        : $"c.{displayColumn.Name}.ToString()";

    // The user table (UserTable with ApiAuth): its API never sends or takes the password hash, lets only an administrator change the administrator and role columns, keeps a sign-in name unique
    // and keeps the last administrator (UserTable, API_UserDirectory).
    // ChangeGates and GuardedColumns (API_Gates): the table's checks run before a row is saved.
    bool hasGates = supported && GatePlan.HasRules(Project, Model);
    var userPlan = supported ? UserTable.PlanOf(Model, Project) : null;
    var userAdmin = userPlan?.Admin;
    var userRole = userPlan?.Role;
    var userGuarded = new[] { userAdmin, userRole }.Where(c => c is not null).Select(c => c!).ToList();
    string userKey = keyProperty;
    string userName = userPlan?.UserName.CSharpName() ?? "";
    string userHash = userPlan?.PasswordHash.CSharpName() ?? "";
    string userActive = activeColumn?.CSharpName() ?? "";
    string UserDefault(ColumnModel c) => c.IsBooleanColumn ? "false" : c.IsNullable ? "null" : "\"\"";
    string UserIsAdmin(string row, string? active = null) => userAdmin is null ? "false" : $"{row}.{userAdmin.CSharpName()} == true" + (activeColumn is null ? "" : $" && {row}.{active ?? userActive}");
    string userStoredMembers = string.Join(", ", new[] { $"Hash = u.{userHash}" }
        .Concat(userGuarded.Select(c => $"{c.CSharpName()} = u.{c.CSharpName()}"))
        .Concat(userAdmin is not null && activeColumn is not null ? new[] { $"Active = u.{userActive}" } : Array.Empty<string>()));

    if (supported)
    {
#>
namespace <#= apiNamespace #>;

<#= usingLines #><#= ownerUsing #>using System.Linq.Expressions;

/// <summary> The API of <#= entity #>: the endpoints and their answers are <#= nameActive ? "NameActiveCrudApi's (a Name and IsActive table: the duplicate-name rule)" : "CrudApi's" #> (Apis/CrudApi.cs, the CrudApi essentials group); this class says which repository and key it uses. </summary>
public class <#= entity #>Api : <#= apiBase #><<#= entity #>, <#= entity #>Repo<#= keyArgument #><#= dtoArguments #>>
{
    protected override <#= entity #>Repo NewRepo(<#= contextType #> context) => new(context);
<#
        if (dtos)
        {
#>

    protected override <#= entity #>Dto ToOutput(<#= entity #> row) => <#= entity #>Mapping.ToDto(row)!;

    protected override <#= entity #> ToEntity(<#= entity #>Input input) => input.ToEntity();

    protected override void Apply(<#= entity #>Input input, <#= entity #> row) => input.ApplyTo(row);
<#
        }
#>

    protected override Expression<Func<<#= entity #>, <#= keyCSharp #>>> Key => c => c.<#= keyProperty #>;
<#
        if (writeRoles.Count > 0)
        {
#>

    // WriteRoles: only these roles (and the administrator) create, change, delete and clone rows; any signed-in person reads.
    protected override IReadOnlyList<string> WriteRoles => [<#= WriteRolePlan.Literal(writeRoles) #>];
<#
        }
        if (readRoles.Count > 0)
        {
#>

    // ReadRoles: only these roles (and the administrator) read rows; the lookup stays open for the drop-downs of other screens.
    protected override IReadOnlyList<string> ReadRoles => [<#= WriteRolePlan.Literal(readRoles) #>];
<#
        }
        if (ownerColumn is not null)
        {
#>

    protected override Expression<Func<<#= entity #>, int>>? Owner => c => c.<#= ownerColumn.Name #>;
<#
        }
        else if (ownerLink is not null)
        {
#>

    // ApiAuth: the rows belong to the owner of their <#= ownerLink.ParentTable #> (<#= ownerLink.ParentOwner #>), so a caller reaches only the rows under a parent of an owner they may act for.
    protected override bool OwnedThroughParent => true;

    protected override IQueryable<<#= entity #>> ScopeThroughParent(<#= contextType #> context, IQueryable<<#= entity #>> rows, int[] owners) =>
        rows.Where(c => context.Set<<#= ownerLink.ParentTable #>>().Any(p => p.<#= ownerLink.ParentKey #> == c.<#= ownerLink.ForeignKey #> && owners.Contains(p.<#= ownerLink.ParentOwner #>)));

    protected override async Task<int?> ParentOwnerAsync(<#= contextType #> context, <#= entity #> row) =>
        await context.Set<<#= ownerLink.ParentTable #>>().Where(p => p.<#= ownerLink.ParentKey #> == row.<#= ownerLink.ForeignKey #>).Select(p => (int?)p.<#= ownerLink.ParentOwner #>).FirstOrDefaultAsync();
<#
        }
        else if (ownerUnusable)
        {
#>

    // OwnedTables names this table, but it has no NOT NULL whole-number column named <#= Project.OwnerColumn #> (OwnerColumn), so its rows are not scoped to the signed-in person.
<#
        }
        if (editableChildren.Count > 0)
        {
#>

    protected override IReadOnlyList<ChildRows<<#= keyCSharp #>>> EditableChildren =>
    [
<#
            foreach (var child in editableChildren)
            {
#>
        new ChildRows<<#= keyCSharp #>, <#= child.ReferencingTable #>>("<#= EditableChild.JsonName(child) #>", c => c.<#= child.ReferencingPrimaryKeyColumns[0] #>, c => c.<#= child.ReferencingColumns[0] #>),
<#
            }
#>
    ];
<#
        }
        if (sortColumn is not null)
        {
#>

    protected override Expression<Func<<#= entity #>, DateTime>> NewestFirst => c => c.<#= sortColumn.Name #>;
<#
        }
        if (listSearch && searchTerms.Count > 0)
        {
#>

    protected override IQueryable<<#= entity #>> SearchRows(IQueryable<<#= entity #>> rows, string text) =>
        rows.Where(t => <#= string.Join("\n            || ", searchTerms.Select(term => searchTerms.Count > 1 ? "(" + term.Condition("t", "text") + ")" : term.Condition("t", "text"))) #>);
<#
        }
        if (listSearch && searchPlan!.Sorts.Count > 0)
        {
#>

    protected override IOrderedQueryable<<#= entity #>>? SortRows(IQueryable<<#= entity #>> rows, string column, bool descending)
    {
        switch (column.ToLowerInvariant())
        {
<#
            foreach (var sort in searchPlan.Sorts)
            {
                string path = sort.ParentPath is { } parent ? "t." + parent.Replace(".", "!.") : "t." + sort.Column.CSharpName();
#>
            case "<#= sort.Name.ToLowerInvariant().Replace("\\", "\\\\").Replace("\"", "\\\"") #>":
                return descending ? rows.OrderByDescending(t => <#= path #>) : rows.OrderBy(t => <#= path #>);
<#
            }
#>
            default:
                return null;
        }
    }
<#
        }
        if (displayColumn is not null)
        {
#>

    protected override bool CanLookup => true;

    protected override IQueryable<<#= lookupItem #>> LookupQuery(IQueryable<<#= entity #>> rows) =>
        rows.OrderBy(c => <#= lookupName #>).Select(c => new <#= lookupItem #>(c.<#= keyProperty #>, <#= lookupName #>, <#= activeColumn is null ? "null" : "c." + activeColumn.Name #>));

    protected override Expression<Func<<#= entity #>, string>>? LookupText => c => <#= lookupName #>;
<#
        }
        if (canFindByName)
        {
#>

    protected override bool CanFindByName => true;

    protected override Task<List<<#= entity #>>> FindByNameAsync(<#= entity #>Repo repo, string name) => repo.GetByName(name);
<#
        }
        // the audit dates no caller sets: a create date the database does not default and the last-changed date on a new row, the modified and last-changed dates on a changed one
        var stampOnNew = Model.Columns.Where(c => !c.IsComputed && c.IsDateColumn && (c.IsLastChangedDateColumn || (c.IsCreateDateColumn && c.DatabaseDefaultSql is null))).ToList();
        var stampOnChange = Model.Columns.Where(c => !c.IsComputed && c.IsDateColumn && (c.IsModifiedDateColumn || c.IsLastChangedDateColumn)).ToList();
        string Now(ColumnModel c) => c.CSharpBase() == "DateTimeOffset" ? "DateTimeOffset.Now" : "LocalNow";
        if (!nameActive && (stampOnNew.Count > 0 || stampOnChange.Count > 0))
        {
#>

    protected override void Stamp(<#= entity #> row, bool isNew)
    {
<#
            if (stampOnNew.Count > 0 && stampOnChange.Count > 0)
            {
#>
        if (isNew)
        {
<#
                foreach (var c in stampOnNew)
                {
#>
            row.<#= c.CSharpName() #> = <#= Now(c) #>;
<#
                }
#>
        }
        else
        {
<#
                foreach (var c in stampOnChange)
                {
#>
            row.<#= c.CSharpName() #> = <#= Now(c) #>;
<#
                }
#>
        }
<#
            }
            else
            {
                var only = stampOnNew.Count > 0 ? stampOnNew : stampOnChange;
#>
        if (<#= stampOnNew.Count > 0 ? "isNew" : "!isNew" #>)
        {
<#
                foreach (var c in only)
                {
#>
            row.<#= c.CSharpName() #> = <#= Now(c) #>;
<#
                }
#>
        }
<#
            }
#>
    }
<#
        }
        if (canClone)
        {
#>

    protected override bool CanClone => true;

    protected override Task<int> CloneAsync(<#= entity #>Repo repo, int id) => repo.CloneAsync(id);
<#
        }
        if (userPlan is not null)
        {
#>

    // The user table: the password hash is in no answer or body (the entity ignores it; set-password changes it)<#= userGuarded.Count == 0 ? "" : ", only an administrator changes " + string.Join(" or ", userGuarded.Select(c => c.CSharpName())) #>,
    // a sign-in name is used by one person<#= userAdmin is null ? "" : " and the last administrator stays" #>.
    protected override async Task<IResult?> BeforeSaveAsync(<#= contextType #> context, <#= entity #> row, bool isNew)
    {
        var stored = isNew ? null : await context.Set<<#= entity #>>().AsNoTracking().Where(u => u.<#= userKey #> == row.<#= userKey #>)
            .Select(u => new { <#= userStoredMembers #> }).FirstOrDefaultAsync();
        if (!isNew && stored is null)
            return Results.NotFound();

        row.<#= userHash #> = stored?.Hash<#= userPlan.PasswordHash.IsNullable ? "" : " ?? \"\"" #>;
<#
            if (userGuarded.Count > 0)
            {
#>
        if (!Caller.IsInRole(AuthNames.AdminRole))
        {
<#
                foreach (var g in userGuarded)
                {
#>
            if (isNew)
                row.<#= g.CSharpName() #> = <#= UserDefault(g) #>;
            else if (!Equals(row.<#= g.CSharpName() #>, stored!.<#= g.CSharpName() #>))
                return Results.Problem(statusCode: <#= HttpStatus.Forbidden #>, type: "<#= ProblemTypes.ColumnNotYours #>", title: "Not allowed", detail: "Only an administrator may change <#= g.CSharpName() #>.");
<#
                }
#>
        }

<#
            }
#>
        if (row.<#= userName #> is { } login)
        {
            row.<#= userName #> = login = login.Trim();
            if (login.Length > 0 && await context.Set<<#= entity #>>().AsNoTracking().AnyAsync(u => u.<#= userName #> == login && u.<#= userKey #> != row.<#= userKey #>))
                return Results.Problem(statusCode: <#= HttpStatus.Conflict #>, type: "<#= ProblemTypes.DuplicateValue #>", title: "Duplicate value", detail: "Another person already signs in with that name.");
        }
<#
            if (userAdmin is not null)
            {
#>

        if (stored is not null && <#= UserIsAdmin("stored", "Active") #> && !(<#= UserIsAdmin("row") #>)
            && !await context.Set<<#= entity #>>().AsNoTracking().AnyAsync(u => u.<#= userKey #> != row.<#= userKey #> && <#= UserIsAdmin("u") #>))
            return LastAdministrator();
<#
            }
#>
        return null;
    }
<#
            if (userAdmin is not null)
            {
#>

    protected override async Task<IResult?> BeforeDeleteAsync(<#= contextType #> context, <#= keyCSharp #> id)
    {
        var users = context.Set<<#= entity #>>().AsNoTracking();
        if (await users.AnyAsync(u => u.<#= userKey #> == id && <#= UserIsAdmin("u") #>) && !await users.AnyAsync(u => u.<#= userKey #> != id && <#= UserIsAdmin("u") #>))
            return LastAdministrator();
        return null;
    }

    private static IResult LastAdministrator() => Results.Problem(statusCode: <#= HttpStatus.UnprocessableEntity #>, type: "<#= ProblemTypes.LastAdministrator #>", title: "Last administrator", detail: "There must be at least one active administrator.");
<#
            }
        }
        if (hasGates)
        {
#>

    // The project's ChangeGates and GuardedColumns for this table (API_Gates writes <#= entity #>Gates).
    protected override Task<IResult?> BeforeSaveAsync(<#= contextType #> context, <#= entity #> row, bool isNew) => <#= entity #>Gates.CheckAsync(context, Caller, row, isNew);
<#
            if (canClone)
            {
#>

    // A copy starts the way a new row does: the gated columns at their start, a guarded column reset unless the caller may change it.
    protected override Task<IResult?> AfterCloneAsync(<#= contextType #> context, <#= keyCSharp #> newId) => <#= entity #>Gates.AfterCloneAsync(context, Caller, newId);
<#
            }
        }
#>
}
<#
    }
#>
