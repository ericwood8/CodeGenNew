# Restriction checkboxes for API_Dashboard_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t.
DatabaseOnly=true
RequiresPrimaryKey=false
TableOnly=false
OutputName=DashboardApi.cs
# Whole-project generation (codegen generate): written only for a project with Dashboard=true.
Stacks=Api
OutputFolder=Apis
InPlan=false
