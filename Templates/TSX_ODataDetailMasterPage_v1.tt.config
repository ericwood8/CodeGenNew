# TSX_DetailMasterPage_v1.tt run as its OData form (see Base and Variant in TemplateConfig). Opt in with OData=true and a React stack; written only for the master-detail tables the project serves as OData.
Base=TSX_DetailMasterPage_v1.tt
Variant=OData
RequiresPrimaryKey=true
TableOnly=true
RequiredPrimaryKeyShape=SingleIntGuidOrText
RequiresChildTables=true
NeedsReferencedDisplayColumns=true
Stacks=React
PlanTables=ScreenDetailMaster
OutputFolder=src
InPlan=false
