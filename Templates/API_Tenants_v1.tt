<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string apiNamespace = "MyApp.ApiService.Apis";
    string contextType = "MyAppContext";
    string[] usings = { };   // namespaces the generated file must "using" (the context's)
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    contextType = Project.ContextName ?? contextType;
    apiNamespace = Project.ApiNamespace ?? apiNamespace;
    usings = Project.Usings ?? usings;
    // ==========================================================================================

    // ==========================================================================================
    // API_Tenants_v1.tt
    // Generates: Tenants.cs   (see OutputName in API_Tenants_v1.tt.config)
    // The sign-in and routes of a multi-tenant API (TenantTable, with ApiAuth and AccessMode=Ef). TenantLoginClaims puts the tenant the person works in into the token (from the membership table, or from the tenant
    // column of the user table); with TenantMembership, GET /api/auth/tenants lists the person's tenants and POST /api/auth/switch-tenant gives a token for another one; POST <tenants>/onboard creates a tenant (and
    // makes a person its first administrator) for a platform administrator. The scope the context reads (ITenantScope) and the query filters are written by CS_DbContext, the stamping of the tenant column by CrudApi.
    // Full notes: Docs/TemplateNotes/API_Tenants_v1.md
    // ==========================================================================================

    var problems = TenantPlan.Problems(Database, Project);
    if (problems.Count > 0)
    {
        Error(string.Join(" | ", problems));
    }
    else if (TenantPlan.IsEnabled(Project))
    {
        Write("namespace " + apiNamespace + ";" + "\n\n");
        Write(TenantWriter.File(Database, Project, contextType, usings));
    }
#>
