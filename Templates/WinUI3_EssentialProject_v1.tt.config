# Restriction checkboxes for WinUI3_EssentialProject_v1.tt (see Docs/specs.md section 5.3).
# One of the files every WinUI 3 app needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=WinUI3
EssentialsGroup=Project
Description=The .csproj, app.manifest, appsettings.json (connection string, no password) and GlobalUsings.cs
