# Restriction checkboxes for API_Junction_v1.tt (see Docs/specs.md section 5.3).
RequiresPrimaryKey=true
TableOnly=true
# Only offered for a many-to-many junction/bridge table (TableModel.IsJunctionTable).
RequiresJunctionTable=true
# The GET endpoint shows the target table's display columns, so they must be looked up.
NeedsReferencedDisplayColumns=true
OutputName={Table}JunctionApi.cs
# Writes T-SQL (or C# that EXECs a stored procedure): refused for a table read from PostgreSQL.
SqlServerOnly=true
