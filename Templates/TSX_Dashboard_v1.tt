<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (folders).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string apiFolder = Project.ApiFolder;               // under the React app's src folder (where -o points)
    string componentsFolder = Project.ComponentsFolder;
    string pagesFolder = Project.PagesFolder;
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    // ==========================================================================================

    // ==========================================================================================
    // TSX_Dashboard_v1.tt
    // Generates: api/dashboardApi.ts, components/DashboardWidgetView.tsx, components/dashboard.css, pages/DashboardPage.tsx and, with DashboardStrip=true, components/DashboardStrip.tsx
    // The dashboard page of a React front end, drawn from what GET /api/dashboard returns (API_Dashboard): cards, bar lists, a sparkline and a list of recent rows, all written by the
    // template, so no chart package is added. Every chart has the same numbers beside it as text, and no meaning is carried by colour alone. TSX_Screens adds the menu entry and, for the
    // strip, wraps each table's page.
    // Full notes: Docs/TemplateNotes/TSX_Dashboard_v1.md
    // ==========================================================================================

    bool strip = Project.DashboardStrip;
#>
@@@FILE <#= apiFolder #>/dashboardApi.ts@@@
import { request } from './client';

export interface DashboardPoint {
  label: string | null;
  value: number | null;
}

export interface DashboardRow {
  label: string | null;
  detail: string | null;
}

export type DashboardKind = 'count' | 'childCount' | 'money' | 'topBy' | 'breakdown' | 'trend' | 'ratio' | 'status' | 'recent';

export interface DashboardWidget {
  id: string;
  kind: DashboardKind;
  title: string;
  table: string;
  route: string;
  points: DashboardPoint[];
  rows: DashboardRow[];
}

export interface DashboardResult {
  widgets: DashboardWidget[];
}

export const dashboardApi = {
  // Every widget of the dashboard page, or with a table the cards of that table's strip.
  get: (table?: string): Promise<DashboardResult> =>
    request<DashboardResult>(table ? `/api/dashboard?table=${encodeURIComponent(table)}` : '/api/dashboard'),
};
@@@FILE <#= componentsFolder #>/dashboard.css@@@
.dash-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; margin: 12px 0; }
.dash-card, .dash-panel { padding: 12px 16px; border: 1px solid #8886; border-radius: 6px; background: #8881; }
.dash-card h3, .dash-panel h3 { margin: 0 0 8px; font-size: 1rem; }
.dash-card a, .dash-panel a { color: inherit; text-decoration: none; }
.dash-card a:hover, .dash-panel a:hover { text-decoration: underline; }
.dash-card dl { display: flex; flex-wrap: wrap; gap: 4px 20px; margin: 0; }
.dash-card dt { font-size: 0.85rem; opacity: 0.8; }
.dash-card dd { margin: 0 0 4px; font-size: 1.6rem; font-weight: 700; }
.dash-bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
.dash-bars li { display: grid; grid-template-columns: minmax(80px, 30%) 1fr auto; align-items: center; gap: 8px; }
.dash-track { display: block; height: 10px; border-radius: 5px; background: #8883; }
.dash-fill { display: block; height: 100%; border-radius: 5px; background: currentColor; opacity: 0.55; }
.dash-value { font-variant-numeric: tabular-nums; font-weight: 600; }
.dash-spark { width: 100%; height: 56px; }
.dash-spark polyline { fill: none; stroke: currentColor; stroke-width: 2; vector-effect: non-scaling-stroke; }
.dash-recent { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
.dash-recent li { display: flex; justify-content: space-between; gap: 12px; }
.dash-panel details { margin-top: 8px; }
.dash-panel summary { cursor: pointer; font-size: 0.85rem; opacity: 0.8; }
.dash-strip { margin-bottom: 12px; }
.dash-error { color: #b00020; }
@@@FILE <#= componentsFolder #>/DashboardWidgetView.tsx@@@
import { Link } from 'react-router-dom';
import type { DashboardWidget } from '../<#= apiFolder #>/dashboardApi';
import './dashboard.css';

const numberFormat = new Intl.NumberFormat(undefined, { maximumFractionDigits: 2 });
const format = (value: number | null): string => (value === null ? '' : numberFormat.format(value));

// A line over the points of a trend, scaled to a 200 by 48 box; the numbers are in the table under it.
function sparkPoints(values: number[]): string {
  if (values.length === 0) return '';
  const max = Math.max(...values, 0);
  const min = Math.min(...values, 0);
  const span = max - min || 1;
  const step = values.length > 1 ? 200 / (values.length - 1) : 0;
  return values.map((v, i) => `${(i * step).toFixed(1)},${(46 - ((v - min) / span) * 44).toFixed(1)}`).join(' ');
}

function Title({ widget }: { widget: DashboardWidget }) {
  return <h3>{widget.route ? <Link to={`/${widget.route}`}>{widget.title}</Link> : widget.title}</h3>;
}

// One widget: a card (count, childCount, money, ratio, status), a bar list (topBy, breakdown), a trend or the recent rows.
export function DashboardWidgetView({ widget }: { widget: DashboardWidget }) {
  const points = widget.points;
  switch (widget.kind) {
    case 'topBy':
    case 'breakdown': {
      const largest = Math.max(...points.map((p) => p.value ?? 0), 1);
      return (
        <section className="dash-panel" aria-label={widget.title}>
          <Title widget={widget} />
          {points.length === 0 ? <p>No data.</p> : (
            <ol className="dash-bars">
              {points.map((p) => (
                <li key={p.label}>
                  <span>{p.label}</span>
                  <span className="dash-track" aria-hidden="true"><span className="dash-fill" style={{ width: `${((p.value ?? 0) / largest) * 100}%` }} /></span>
                  <span className="dash-value">{format(p.value)}</span>
                </li>
              ))}
            </ol>
          )}
        </section>
      );
    }
    case 'trend':
      return (
        <section className="dash-panel" aria-label={widget.title}>
          <Title widget={widget} />
          {points.length === 0 ? <p>No data.</p> : (
            <>
              <svg className="dash-spark" viewBox="0 0 200 48" preserveAspectRatio="none" role="img" aria-label={`${widget.title}: ${points.map((p) => `${p.label} ${format(p.value)}`).join(', ')}`}>
                <polyline points={sparkPoints(points.map((p) => p.value ?? 0))} />
              </svg>
              <details>
                <summary>Show the numbers</summary>
                <table>
                  <tbody>
                    {points.map((p) => <tr key={p.label}><td>{p.label}</td><td>{format(p.value)}</td></tr>)}
                  </tbody>
                </table>
              </details>
            </>
          )}
        </section>
      );
    case 'recent':
      return (
        <section className="dash-panel" aria-label={widget.title}>
          <Title widget={widget} />
          {widget.rows.length === 0 ? <p>No rows.</p> : (
            <ul className="dash-recent">
              {widget.rows.map((r, i) => <li key={i}><span>{r.label}</span><span>{r.detail}</span></li>)}
            </ul>
          )}
        </section>
      );
    default:
      return (
        <section className="dash-card" aria-label={widget.title}>
          <Title widget={widget} />
          <dl>
            {points.map((p) => (
              <div key={p.label}>
                <dt>{p.label}</dt>
                <dd>{format(p.value)}</dd>
              </div>
            ))}
          </dl>
        </section>
      );
  }
}

export function isCard(widget: DashboardWidget): boolean {
  return ['count', 'childCount', 'money', 'ratio', 'status'].includes(widget.kind);
}
@@@FILE <#= pagesFolder #>/DashboardPage.tsx@@@
import { useEffect, useState } from 'react';
import { dashboardApi } from '../<#= apiFolder #>/dashboardApi';
import type { DashboardResult } from '../<#= apiFolder #>/dashboardApi';
import { DashboardWidgetView, isCard } from '../<#= componentsFolder #>/DashboardWidgetView';

export function DashboardPage() {
  const [data, setData] = useState<DashboardResult | null>(null);
  const [error, setError] = useState<string | null>(null);

  const load = () => {
    setError(null);
    dashboardApi.get().then(setData).catch(() => setError('Failed to load the dashboard.'));
  };

  useEffect(load, []);

  const cards = data?.widgets.filter(isCard) ?? [];
  const others = data?.widgets.filter((w) => !isCard(w)) ?? [];

  return (
    <div>
      <h2>Dashboard</h2>
      <button type="button" onClick={load}>Refresh</button>
      {error && <p className="dash-error" role="alert">{error}</p>}
      {data && data.widgets.length === 0 && <p>The schema suggests nothing to show.</p>}
      <div className="dash-grid">{cards.map((w) => <DashboardWidgetView key={w.id} widget={w} />)}</div>
      <div className="dash-grid">{others.map((w) => <DashboardWidgetView key={w.id} widget={w} />)}</div>
    </div>
  );
}
<#
    if (strip)
    {
#>
@@@FILE <#= componentsFolder #>/DashboardStrip.tsx@@@
import { useEffect, useState } from 'react';
import { dashboardApi } from '../<#= apiFolder #>/dashboardApi';
import type { DashboardWidget } from '../<#= apiFolder #>/dashboardApi';
import { DashboardWidgetView } from './DashboardWidgetView';

// The two or three cards of one table, above its grid. A failure shows nothing: the grid below is what the person came for.
export function DashboardStrip({ table }: { table: string }) {
  const [widgets, setWidgets] = useState<DashboardWidget[]>([]);

  useEffect(() => {
    dashboardApi.get(table).then((result) => setWidgets(result.widgets)).catch(() => setWidgets([]));
  }, [table]);

  if (widgets.length === 0) return null;
  return <div className="dash-grid dash-strip">{widgets.map((w) => <DashboardWidgetView key={w.id} widget={w} />)}</div>;
}
<#
    }
#>
