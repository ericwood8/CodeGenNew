<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (folders).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string apiFolder = Project.ApiFolder;               // under the React app's src folder (where -o points)
    string componentsFolder = Project.ComponentsFolder;
    string pagesFolder = Project.PagesFolder;
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    // ==========================================================================================

    // ==========================================================================================
    // TSX_Dashboard_v1.tt
    // Generates: api/dashboardApi.ts, components/DashboardWidgetView.tsx, components/dashboard.css, pages/DashboardPage.tsx and, with DashboardStrip=true, components/DashboardStrip.tsx, plus their tests under __tests__
    // The dashboard page of a React front end, drawn from what GET /api/dashboard returns (API_Dashboard): cards, bar lists, a sparkline and a list of recent rows, all written by the
    // template, so no chart package is added. Every chart has the same numbers beside it as text, and no meaning is carried by colour alone. TSX_Screens adds the menu entry and, for the
    // strip, wraps each table's page. Each file has a Vitest test beside it (__tests__): the widget kinds, the page (cards first, empty, failure, Refresh) and the strip.
    // Full notes: Docs/TemplateNotes/TSX_Dashboard_v1.md
    // ==========================================================================================

    bool strip = Project.DashboardStrip;
#>
@@@FILE <#= apiFolder #>/dashboardApi.ts@@@
import { request } from './client';

<#= DashboardWire.TypeScript(2) #>
export const dashboardApi = {
  // Every widget of the dashboard page, or with a table the cards of that table's strip.
  get: (table?: string): Promise<DashboardResult> =>
    request<DashboardResult>(table ? `/api/dashboard?table=${encodeURIComponent(table)}` : '/api/dashboard'),
};
@@@FILE <#= componentsFolder #>/dashboard.css@@@
<#= DashboardWire.Css("", true, ".dash-panel-wide") #>.dash-strip { margin-bottom: 12px; }
.dash-error { color: #b00020; }
@@@FILE <#= componentsFolder #>/DashboardWidgetView.tsx@@@
import { Link } from 'react-router-dom';
import type { DashboardWidgetData } from '../<#= apiFolder #>/dashboardApi';
import './dashboard.css';

const numberFormat = new Intl.NumberFormat(undefined, { maximumFractionDigits: 2 });
const moneyFormat = new Intl.NumberFormat(undefined, { style: 'currency', currency: '<#= Project.CurrencyCode #>' });
const formatter = (widget: DashboardWidgetData) => (value: number | null): string =>
  (value === null ? '' : (widget.isMoney ? moneyFormat : numberFormat).format(value));

// A line over the points of a trend, scaled to a <#= DashboardWire.SparkWidth #> by <#= DashboardWire.SparkHeight #> box; the numbers are in the table under it.
function sparkPoints(values: number[]): string {
  if (values.length === 0) return '';
  const max = Math.max(...values, 0);
  const min = Math.min(...values, 0);
  const span = max - min || 1;
  const step = values.length > 1 ? <#= DashboardWire.SparkWidth #> / (values.length - 1) : 0;
  return values.map((v, i) => `${(i * step).toFixed(1)},${(<#= DashboardWire.SparkHeight - 2 #> - ((v - min) / span) * <#= DashboardWire.SparkHeight - 4 #>).toFixed(1)}`).join(' ');
}

function Title({ widget }: { widget: DashboardWidgetData }) {
  return <h3>{widget.route ? <Link to={`/${widget.route}`}>{widget.title}</Link> : widget.title}</h3>;
}

// One widget: a card (count, childCount, money, ratio, status), a bar list (topBy, breakdown), a trend or the recent rows.
export function DashboardWidgetView({ widget }: { widget: DashboardWidgetData }) {
  const points = widget.points;
  const format = formatter(widget);
  switch (widget.kind) {
    case 'topBy':
    case 'breakdown': {
      const largest = Math.max(...points.map((p) => p.value ?? 0), 1);
      return (
        <section className="dash-panel" aria-label={widget.title}>
          <Title widget={widget} />
          {points.length === 0 ? <p>No data.</p> : (
            <ol className="dash-bars">
              {points.map((p) => (
                <li key={p.label}>
                  <span>{p.label}</span>
                  <span className="dash-track" aria-hidden="true"><span className="dash-fill" style={{ width: `${((p.value ?? 0) / largest) * 100}%` }} /></span>
                  <span className="dash-value">{format(p.value)}</span>
                </li>
              ))}
            </ol>
          )}
        </section>
      );
    }
    case 'trend':
      return (
        <section className="dash-panel" aria-label={widget.title}>
          <Title widget={widget} />
          {points.length === 0 ? <p>No data.</p> : (
            <>
              <svg className="dash-spark" viewBox="0 0 <#= DashboardWire.SparkWidth #> <#= DashboardWire.SparkHeight #>" preserveAspectRatio="none" role="img" aria-label={`${widget.title}: ${points.map((p) => `${p.label} ${format(p.value)}`).join(', ')}`}>
                <polyline points={sparkPoints(points.map((p) => p.value ?? 0))} />
              </svg>
              <details>
                <summary>Show the numbers</summary>
                <table>
                  <tbody>
                    {points.map((p) => <tr key={p.label}><td>{p.label}</td><td>{format(p.value)}</td></tr>)}
                  </tbody>
                </table>
              </details>
            </>
          )}
        </section>
      );
    case 'recent':
      return (
        <section className="dash-panel dash-panel-wide" aria-label={widget.title}>
          <Title widget={widget} />
          {widget.rows.length === 0 ? <p>No rows.</p> : (
            <ul className="dash-recent">
              {widget.rows.map((r, i) => <li key={i}><span>{r.label}</span><span>{r.detail}</span></li>)}
            </ul>
          )}
        </section>
      );
    default:
      return (
        <section className="dash-card" aria-label={widget.title}>
          <Title widget={widget} />
          <dl>
            {points.map((p) => (
              <div key={p.label}>
                <dt>{p.label}</dt>
                <dd>{format(p.value)}</dd>
              </div>
            ))}
          </dl>
        </section>
      );
  }
}

export function isCard(widget: DashboardWidgetData): boolean {
  return <#= DashboardWire.CardKindsTypeScript #>.includes(widget.kind);
}
@@@FILE <#= pagesFolder #>/DashboardPage.tsx@@@
import { useEffect, useState } from 'react';
import { dashboardApi } from '../<#= apiFolder #>/dashboardApi';
import type { DashboardResult } from '../<#= apiFolder #>/dashboardApi';
import { DashboardWidgetView, isCard } from '../<#= componentsFolder #>/DashboardWidgetView';

export function DashboardPage() {
  const [data, setData] = useState<DashboardResult | null>(null);
  const [error, setError] = useState<string | null>(null);

  const load = () => {
    setError(null);
    dashboardApi.get().then(setData).catch(() => setError('Failed to load the dashboard.'));
  };

  useEffect(load, []);

  const cards = data?.widgets.filter(isCard) ?? [];
  const others = data?.widgets.filter((w) => !isCard(w)) ?? [];

  return (
    <div>
      <h2>Dashboard</h2>
      <button type="button" onClick={load}>Refresh</button>
      {error && <p className="dash-error" role="alert">{error}</p>}
      {data && data.widgets.length === 0 && <p>The schema suggests nothing to show.</p>}
      <div className="dash-grid">{cards.map((w) => <DashboardWidgetView key={w.id} widget={w} />)}</div>
      <div className="dash-grid">{others.map((w) => <DashboardWidgetView key={w.id} widget={w} />)}</div>
    </div>
  );
}
@@@FILE <#= componentsFolder #>/__tests__/DashboardWidgetView.test.tsx@@@
import { render, screen } from '@testing-library/react';
import { MemoryRouter } from 'react-router-dom';
import { describe, expect, it } from 'vitest';
import { DashboardWidgetView, isCard } from '../DashboardWidgetView';
import type { DashboardWidgetData } from '../../<#= apiFolder #>/dashboardApi';

const widget = (changes: Partial<DashboardWidgetData>): DashboardWidgetData =>
  ({ id: 'w1', kind: 'count', title: 'Customers', table: 'Customer', route: 'customers', isMoney: false, points: [], rows: [], ...changes });

const show = (w: DashboardWidgetData) => render(<MemoryRouter><DashboardWidgetView widget={w} /></MemoryRouter>);

const money = new Intl.NumberFormat(undefined, { style: 'currency', currency: '<#= Project.CurrencyCode #>' });

describe('DashboardWidgetView', () => {
  it('shows a card as its title, linked to the table page, with its numbers', () => {
    show(widget({ points: [{ label: 'Rows', value: 42 }] }));
    expect(screen.getByRole('link', { name: 'Customers' })).toHaveAttribute('href', '/customers');
    expect(screen.getByText('Rows')).toBeInTheDocument();
    expect(screen.getByText('42')).toBeInTheDocument();
  });

  it('shows the title as plain text when the widget has no page', () => {
    show(widget({ route: '', points: [{ label: 'Rows', value: 1 }] }));
    expect(screen.getByRole('heading', { name: 'Customers' })).toBeInTheDocument();
    expect(screen.queryByRole('link')).not.toBeInTheDocument();
  });

  it('formats a money card with the project currency', () => {
    show(widget({ kind: 'money', isMoney: true, points: [{ label: 'Total', value: 1234.5 }] }));
    expect(screen.getByText(money.format(1234.5))).toBeInTheDocument();
  });

  it('draws a ranking as a list with every number beside its bar', () => {
    show(widget({ kind: 'topBy', title: 'Top customers', points: [{ label: 'Acme', value: 30 }, { label: 'Zenith', value: 10 }] }));
    expect(screen.getAllByRole('listitem')).toHaveLength(2);
    expect(screen.getByText('Acme')).toBeInTheDocument();
    expect(screen.getByText('30')).toBeInTheDocument();
    expect(screen.getByText('10')).toBeInTheDocument();
  });

  it('says there is no data for a ranking or a trend without points', () => {
    show(widget({ kind: 'breakdown', title: 'By status' }));
    expect(screen.getByText('No data.')).toBeInTheDocument();
  });

  it('gives a trend a labelled line and the numbers as text', () => {
    show(widget({ kind: 'trend', title: 'Sales by month', points: [{ label: '2026-01', value: 5 }, { label: '2026-02', value: 8 }] }));
    expect(screen.getByRole('img', { name: /Sales by month/ })).toBeInTheDocument();
    expect(screen.getByText('Show the numbers')).toBeInTheDocument();
    expect(screen.getByText('2026-02')).toBeInTheDocument();
    expect(screen.getByText('8')).toBeInTheDocument();
  });

  it('lists the recent rows, or says there are none', () => {
    const { unmount } = show(widget({ kind: 'recent', title: 'Latest', rows: [{ label: 'INV-1', detail: '2026-02-03' }] }));
    expect(screen.getByText('INV-1')).toBeInTheDocument();
    expect(screen.getByText('2026-02-03')).toBeInTheDocument();
    unmount();
    show(widget({ kind: 'recent', title: 'Latest' }));
    expect(screen.getByText('No rows.')).toBeInTheDocument();
  });

  it('counts the number kinds as cards and the lists and charts as panels', () => {
    expect(isCard(widget({ kind: 'count' }))).toBe(true);
    expect(isCard(widget({ kind: 'status' }))).toBe(true);
    expect(isCard(widget({ kind: 'topBy' }))).toBe(false);
    expect(isCard(widget({ kind: 'trend' }))).toBe(false);
    expect(isCard(widget({ kind: 'recent' }))).toBe(false);
  });
});
@@@FILE <#= pagesFolder #>/__tests__/DashboardPage.test.tsx@@@
import { fireEvent, render, screen } from '@testing-library/react';
import { MemoryRouter } from 'react-router-dom';
import { afterEach, describe, expect, it, vi } from 'vitest';
import { dashboardApi } from '../../<#= apiFolder #>/dashboardApi';
import type { DashboardWidgetData } from '../../<#= apiFolder #>/dashboardApi';
import { DashboardPage } from '../DashboardPage';

const widget = (changes: Partial<DashboardWidgetData>): DashboardWidgetData =>
  ({ id: 'w1', kind: 'count', title: 'Customers', table: 'Customer', route: 'customers', isMoney: false, points: [{ label: 'Rows', value: 3 }], rows: [], ...changes });

const open = () => render(<MemoryRouter><DashboardPage /></MemoryRouter>);

describe('DashboardPage', () => {
  afterEach(() => vi.restoreAllMocks());

  it('shows the cards first and the lists and charts after them', async () => {
    vi.spyOn(dashboardApi, 'get').mockResolvedValue({ widgets: [widget({ id: 'a', kind: 'topBy', title: 'Top customers' }), widget({ id: 'b', title: 'Customers' })] });
    const { container } = open();
    expect(await screen.findByLabelText('Customers')).toBeInTheDocument();
    const grids = container.querySelectorAll('.dash-grid');
    expect(grids).toHaveLength(2);
    expect(grids[0].querySelector('.dash-card')).not.toBeNull();
    expect(grids[1].querySelector('.dash-panel')).not.toBeNull();
  });

  it('says so when the schema suggests nothing to show', async () => {
    vi.spyOn(dashboardApi, 'get').mockResolvedValue({ widgets: [] });
    open();
    expect(await screen.findByText('The schema suggests nothing to show.')).toBeInTheDocument();
  });

  it('shows a sentence when the dashboard cannot be loaded', async () => {
    vi.spyOn(dashboardApi, 'get').mockRejectedValue(new Error('down'));
    open();
    expect(await screen.findByRole('alert')).toHaveTextContent('Failed to load the dashboard.');
  });

  it('asks again when Refresh is pressed', async () => {
    const get = vi.spyOn(dashboardApi, 'get').mockResolvedValue({ widgets: [widget({})] });
    open();
    await screen.findByLabelText('Customers');
    fireEvent.click(screen.getByRole('button', { name: 'Refresh' }));
    await vi.waitFor(() => expect(get).toHaveBeenCalledTimes(2));
  });
});
