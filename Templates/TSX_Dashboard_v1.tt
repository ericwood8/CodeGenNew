@@@FILE <#= componentsFolder #>/__tests__/DashboardStrip.test.tsx@@@
import { render, screen } from '@testing-library/react';
import { MemoryRouter } from 'react-router-dom';
import { afterEach, describe, expect, it, vi } from 'vitest';
import { dashboardApi } from '../../<#= apiFolder #>/dashboardApi';
import { DashboardStrip } from '../DashboardStrip';

describe('DashboardStrip', () => {
  afterEach(() => vi.restoreAllMocks());

  it('asks for the cards of its table and shows them above the grid', async () => {
    const get = vi.spyOn(dashboardApi, 'get').mockResolvedValue({
      widgets: [{ id: 'a', kind: 'count', title: 'Customers', table: 'Customer', route: 'customers', isMoney: false, points: [{ label: 'Rows', value: 3 }], rows: [] }]
    });
    render(<MemoryRouter><DashboardStrip table="Customer" /></MemoryRouter>);
    expect(await screen.findByLabelText('Customers')).toBeInTheDocument();
    expect(get).toHaveBeenCalledWith('Customer');
  });

  it('shows nothing when the dashboard cannot be read', async () => {
    const get = vi.spyOn(dashboardApi, 'get').mockRejectedValue(new Error('down'));
    const { container } = render(<MemoryRouter><DashboardStrip table="Customer" /></MemoryRouter>);
    await vi.waitFor(() => expect(get).toHaveBeenCalled());
    expect(container).toBeEmptyDOMElement();
  });
});
