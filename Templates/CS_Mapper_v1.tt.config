# Restriction checkboxes for CS_Mapper_v1.tt (see Docs/Reference.md section 3).
# Copies an entity to its transfer class and back: the entity needs a primary key.
RequiresPrimaryKey=true
TableOnly=false
# Name the file like the class: Customer -> CustomerMapping.cs
OutputName={Table}Mapping.cs
# Whole-project generation (codegen generate): the project's Dtos=true adds the template to the plan for the tables whose API answers it.
Stacks=Api
PlanTables=Dto
OutputFolder=Dtos
InPlan=false
