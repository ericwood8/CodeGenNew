# Restriction checkboxes for MD_Bruno_v1.tt (see Docs/Reference.md section 3).
# One collection for the whole database: the menu offers it on the database, the CLI runs it without -t.
DatabaseOnly=true
RequiresPrimaryKey=false
TableOnly=false
# No OutputName: the template writes its own paths (bruno.json, environments/Local.bru, <Table>/<Request>.bru) with @@@FILE markers.
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso.
Stacks=Api
OutputFolder=collections/bruno
InPlan=false
