# Restriction checkboxes for RS_TestBodies_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t. Writes nothing unless the project sets RustTests=true.
Scope=Database
# The Rust stack reads PostgreSQL, MySQL and SQLite through sqlx; SQL Server is not supported.
Dialects=PostgreSql,MySql,Sqlite
# No OutputName: the template writes its own paths (tests/api/...) with @@@FILE markers.
# Whole-project generation (codegen generate): for a project that sets RustTests=true (or names the template in PlanAlso).
Stacks=Rust
InPlan=false
