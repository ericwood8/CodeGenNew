<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // UNO_Dashboard_v1.tt
    // Generates: Services/DashboardClient.cs, Views/DashboardWidgetViews.cs and Views/DashboardPage.cs
    // The dashboard page of the Uno app, built in code from what GET /api/dashboard returns (API_Dashboard), so one file draws every kind of widget: cards, bar lists, a sparkline and a list
    // of recent rows, with no chart package. Every chart has its numbers beside it as text. The drawing is WinUI3_DashboardPage's; the data comes through DashboardClient (the same contract
    // as BLZ_Dashboard's) instead of a context. UNO_Screens adds the menu entry, makes the dashboard the first screen and holds the client. There is no strip above each list page (DashboardStrip)
    // on Uno. With Auth=true the page asks for a signed-in person; the API leaves out the widgets of tables the role may not read.
    // Full notes: Docs/TemplateNotes/UNO_Dashboard_v1.md
    // ==========================================================================================
    string viewNamespace = Project.ViewNamespace ?? (Project.ProjectName is not null ? UnoNames.Namespace(Project) + ".Views" : "MyApp.Views");
    string viewsFolder = Project.ViewsFolder ?? "Views";
    string servicesNamespace = UnoNames.ServicesNamespace(Project);
#>
@@@FILE Services/DashboardClient.cs@@@
using System.Net.Http.Json;

namespace <#= servicesNamespace #>;

<#= DashboardWire.CSharp() #>
public class DashboardClient(HttpClient http)
{
    public async Task<DashboardResult> GetAsync() => await (await http.GetAsync("/api/dashboard")).ReadAsync<DashboardResult>();
}
@@@FILE <#= viewsFolder #>/DashboardWidgetViews.cs@@@
using System;
using System.Collections.Generic;
using System.Linq;
using <#= servicesNamespace #>;
using Microsoft.UI;
using Microsoft.UI.Text;
using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;
using Microsoft.UI.Xaml.Media;
using Microsoft.UI.Xaml.Shapes;
using Windows.UI;

namespace <#= viewNamespace #>;

// Draws one widget of the dashboard as plain controls. The numbers are always text: a bar or a line is an extra, never the only way to read a value.
internal static class DashboardWidgetViews
{
    private static readonly System.Globalization.CultureInfo Culture = System.Globalization.CultureInfo.CurrentCulture;

    public static bool IsCard(DashboardWidgetData widget) => widget.Kind is <#= DashboardWire.CardKindsCSharp #>;

    private static string Format(double? value, bool money) => value is null ? "" : value.Value.ToString(money ? "C2" : "#,##0.##", Culture);

    private static Brush ThemeBrush(string key, Color fallback) =>
        Application.Current.Resources.TryGetValue(key, out var found) && found is Brush brush ? brush : new SolidColorBrush(fallback);

    public static UIElement Build(DashboardWidgetData widget, Action<string>? navigate)
    {
        var body = new StackPanel { Spacing = 6 };
        body.Children.Add(TitleOf(widget, navigate));
        switch (widget.Kind)
        {
            case "topBy":
            case "breakdown":
                AddBars(body, widget);
                break;
            case "trend":
                AddTrend(body, widget);
                break;
            case "recent":
                AddRecent(body, widget);
                break;
            default:
                AddCard(body, widget);
                break;
        }

        return new Border
        {
            Child = body,
            Padding = new Thickness(12),
            CornerRadius = new CornerRadius(4),
            BorderThickness = new Thickness(1),
            Background = ThemeBrush("SolidBackgroundFillColorSecondaryBrush", Color.FromArgb(0x20, 0x80, 0x80, 0x80)),
            BorderBrush = ThemeBrush("ControlStrokeColorSecondaryBrush", Color.FromArgb(0x40, 0x80, 0x80, 0x80)),
            MinWidth = 260,
            MaxWidth = widget.Kind == "recent" ? 880 : 420
        };
    }

    private static UIElement TitleOf(DashboardWidgetData widget, Action<string>? navigate)
    {
        // UNO_Screens tags a screen with the table's name, so the widget's table is where a click goes.
        if (navigate is null || string.IsNullOrEmpty(widget.Route))
            return new TextBlock { Text = widget.Title, FontWeight = FontWeights.SemiBold, TextWrapping = TextWrapping.Wrap };

        var link = new HyperlinkButton { Content = widget.Title, Padding = new Thickness(0), FontWeight = FontWeights.SemiBold };
        link.Click += (_, _) => navigate(widget.Table);
        return link;
    }

    private static void AddCard(StackPanel body, DashboardWidgetData widget)
    {
        var wrap = new StackPanel { Orientation = Orientation.Horizontal, Spacing = 20 };
        foreach (var point in widget.Points)
        {
            var one = new StackPanel();
            one.Children.Add(new TextBlock { Text = point.Label, Style = (Style)Application.Current.Resources["CaptionTextBlockStyle"] });
            one.Children.Add(new TextBlock { Text = Format(point.Value, widget.IsMoney), FontSize = 26, FontWeight = FontWeights.Bold });
            wrap.Children.Add(one);
        }

        body.Children.Add(wrap);
    }

    private static void AddBars(StackPanel body, DashboardWidgetData widget)
    {
        if (widget.Points.Count == 0)
        {
            body.Children.Add(new TextBlock { Text = "No data." });
            return;
        }

        double largest = Math.Max(widget.Points.Max(p => p.Value ?? 0), 1);
        foreach (var point in widget.Points)
        {
            double share = Math.Clamp((point.Value ?? 0) / largest, 0, 1);
            var row = new Grid { ColumnSpacing = 8 };
            row.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(110) });
            row.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
            row.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
            row.Children.Add(new TextBlock { Text = point.Label, TextTrimming = TextTrimming.CharacterEllipsis });

            var track = new Grid { Height = 10, VerticalAlignment = VerticalAlignment.Center };
            track.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(Math.Max(share, 0.001), GridUnitType.Star) });
            track.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(Math.Max(1 - share, 0.001), GridUnitType.Star) });
            var fill = new Border { CornerRadius = new CornerRadius(5), Background = ThemeBrush("AccentFillColorDefaultBrush", Colors.SteelBlue) };
            track.Children.Add(fill);
            Grid.SetColumn(track, 1);
            row.Children.Add(track);

            var value = new TextBlock { Text = Format(point.Value, widget.IsMoney), FontWeight = FontWeights.SemiBold };
            Grid.SetColumn(value, 2);
            row.Children.Add(value);
            body.Children.Add(row);
        }
    }

    private static void AddTrend(StackPanel body, DashboardWidgetData widget)
    {
        if (widget.Points.Count == 0)
        {
            body.Children.Add(new TextBlock { Text = "No data." });
            return;
        }

        var values = widget.Points.Select(p => p.Value ?? 0).ToList();
        double max = Math.Max(values.Max(), 0), min = Math.Min(values.Min(), 0), span = max - min == 0 ? 1 : max - min;
        double step = values.Count > 1 ? <#= DashboardWire.SparkWidth #>.0 / (values.Count - 1) : 0;
        var line = new Polyline { Stroke = ThemeBrush("TextFillColorPrimaryBrush", Colors.Gray), StrokeThickness = 2 };
        for (int i = 0; i < values.Count; i++)
            line.Points.Add(new Windows.Foundation.Point(i * step, <#= DashboardWire.SparkHeight - 2 #> - ((values[i] - min) / span) * <#= DashboardWire.SparkHeight - 4 #>));
        body.Children.Add(new Canvas { Width = <#= DashboardWire.SparkWidth #>, Height = <#= DashboardWire.SparkHeight #>, Children = { line } });

        var numbers = new Expander { Header = "Show the numbers", HorizontalAlignment = HorizontalAlignment.Stretch };
        var list = new StackPanel();
        foreach (var point in widget.Points)
            list.Children.Add(new TextBlock { Text = $"{point.Label}   {Format(point.Value, widget.IsMoney)}" });
        numbers.Content = list;
        body.Children.Add(numbers);
    }

    private static void AddRecent(StackPanel body, DashboardWidgetData widget)
    {
        if (widget.Rows.Count == 0)
            body.Children.Add(new TextBlock { Text = "No rows." });
        foreach (var row in widget.Rows)
        {
            var line = new Grid { ColumnSpacing = 12 };
            line.ColumnDefinitions.Add(new ColumnDefinition { Width = new GridLength(1, GridUnitType.Star) });
            line.ColumnDefinitions.Add(new ColumnDefinition { Width = GridLength.Auto });
            line.Children.Add(new TextBlock { Text = row.Label, TextTrimming = TextTrimming.CharacterEllipsis });
            var detail = new TextBlock { Text = row.Detail, TextWrapping = TextWrapping.NoWrap };
            Grid.SetColumn(detail, 1);
            line.Children.Add(detail);
            body.Children.Add(line);
        }
    }
}
@@@FILE <#= viewsFolder #>/DashboardPage.cs@@@
using System;
using System.Linq;
using <#= servicesNamespace #>;
using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;

namespace <#= viewNamespace #>;

// The dashboard: cards first, then the lists and charts, each a widget of the API's dashboard answer. Refresh reads it again.
public sealed class DashboardPage : Page
{
    private readonly DashboardClient _client;
    private readonly Action<string>? _navigate;
    private readonly StackPanel _cards = new() { Orientation = Orientation.Horizontal, Spacing = 12 };
    private readonly ContentControl _others = new();
    private readonly TextBlock _message = new();

    public DashboardPage(DashboardClient client, Action<string>? navigate = null)
    {
        _client = client;
        _navigate = navigate;
        var refresh = new Button { Content = "Refresh" };
        refresh.Click += async (_, _) => await LoadAsync();

        var cardScroller = new ScrollViewer { Content = _cards, HorizontalScrollBarVisibility = ScrollBarVisibility.Auto, VerticalScrollBarVisibility = ScrollBarVisibility.Disabled, HorizontalScrollMode = ScrollMode.Enabled };
        var panel = new StackPanel { Spacing = 12, Padding = new Thickness(16) };
        panel.Children.Add(new TextBlock { Text = "Dashboard", Style = (Style)Application.Current.Resources["TitleTextBlockStyle"] });
        panel.Children.Add(refresh);
        panel.Children.Add(_message);
        panel.Children.Add(cardScroller);
        panel.Children.Add(_others);
        Content = new ScrollViewer { Content = panel };

        Loaded += async (_, _) => await LoadAsync();
    }

    private async System.Threading.Tasks.Task LoadAsync()
    {
        _message.Text = "";
        try
        {
            var result = await _client.GetAsync();
            _cards.Children.Clear();
            foreach (var widget in result.Widgets.Where(DashboardWidgetViews.IsCard))
                _cards.Children.Add(DashboardWidgetViews.Build(widget, _navigate));

            var wrap = new VariableSizedWrapGrid { Orientation = Orientation.Horizontal, ItemWidth = 440 };
            foreach (var widget in result.Widgets.Where(w => !DashboardWidgetViews.IsCard(w)))
            {
                var view = DashboardWidgetViews.Build(widget, _navigate);
                if (widget.Kind == "recent")
                    VariableSizedWrapGrid.SetColumnSpan((FrameworkElement)view, 2);
                wrap.Children.Add(view);
            }
            _others.Content = wrap;
            if (result.Widgets.Count == 0)
                _message.Text = "The schema suggests nothing to show.";
        }
        catch (ApiException ex)
        {
            _message.Text = ex.Explain("loading the dashboard");
        }
        catch (HttpRequestException)
        {
            _message.Text = "The server could not be reached.";
        }
    }
}
