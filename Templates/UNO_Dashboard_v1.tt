<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // UNO_Dashboard_v1.tt
    // Generates: Services/DashboardClient.cs, Views/DashboardWidgetViews.cs, Views/DashboardPage.cs and, with DashboardStrip=true, Views/DashboardStrip.cs
    // The dashboard page of the Uno app, built in code from what GET /api/dashboard returns (API_Dashboard), so one file draws every kind of widget: cards, bar lists, a sparkline and a list
    // of recent rows, with no chart package. Every chart has its numbers beside it as text. The drawing is WinUI3_DashboardPage's; the data comes through DashboardClient (the same contract
    // as BLZ_Dashboard's) instead of a context. UNO_Screens adds the menu entry, makes the dashboard the first screen and holds the client. UNO_Screens puts the strip above each list page of a table that has cards
    // (DashboardStrip); the API answers GET /api/dashboard?table=. With Auth=true the page asks for a signed-in person; the API leaves out the widgets of tables the role may not read.
    // Full notes: Docs/TemplateNotes/UNO_Dashboard_v1.md
    // ==========================================================================================
    string viewNamespace = Project.ViewNamespace ?? (Project.ProjectName is not null ? UnoNames.Namespace(Project) + ".Views" : "MyApp.Views");
    string viewsFolder = Project.ViewsFolder ?? "Views";
    string servicesNamespace = UnoNames.ServicesNamespace(Project);
#>
@@@FILE Services/DashboardClient.cs@@@
using System.Net.Http.Json;

namespace <#= servicesNamespace #>;

<#= DashboardWire.CSharp() #>
public class DashboardClient(HttpClient http)
{
    <#= DashboardWire.ClientGetCSharp #>
}
@@@FILE <#= viewsFolder #>/DashboardWidgetViews.cs@@@
<#= DesktopDashboardCode.WidgetViews(viewNamespace, servicesNamespace, "UNO_Screens", "the dashboard") #>@@@FILE <#= viewsFolder #>/DashboardPage.cs@@@
using System;
using System.Linq;
using <#= servicesNamespace #>;
using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;

namespace <#= viewNamespace #>;

// The dashboard: cards first, then the lists and charts, each a widget of the API's dashboard answer. Refresh reads it again.
public sealed class DashboardPage : Page
{
    private readonly DashboardClient _client;
    private readonly Action<string>? _navigate;
    private readonly StackPanel _cards = new() { Orientation = Orientation.Horizontal, Spacing = 12 };
    private readonly ContentControl _others = new();
    private readonly TextBlock _message = new();

    public DashboardPage(DashboardClient client, Action<string>? navigate = null)
    {
        _client = client;
        _navigate = navigate;
        var refresh = new Button { Content = "Refresh" };
        refresh.Click += async (_, _) => await LoadAsync();

        var cardScroller = new ScrollViewer { Content = _cards, HorizontalScrollBarVisibility = ScrollBarVisibility.Auto, VerticalScrollBarVisibility = ScrollBarVisibility.Disabled, HorizontalScrollMode = ScrollMode.Enabled };
        var panel = new StackPanel { Spacing = 12, Padding = new Thickness(16) };
        panel.Children.Add(new TextBlock { Text = "Dashboard", Style = (Style)Application.Current.Resources["TitleTextBlockStyle"] });
        panel.Children.Add(refresh);
        panel.Children.Add(_message);
        panel.Children.Add(cardScroller);
        panel.Children.Add(_others);
        Content = new ScrollViewer { Content = panel };

        Loaded += async (_, _) => await LoadAsync();
    }

    private async System.Threading.Tasks.Task LoadAsync()
    {
        _message.Text = "";
        try
        {
            var result = await _client.GetAsync();
            _cards.Children.Clear();
            foreach (var widget in result.Widgets.Where(DashboardWidgetViews.IsCard))
                _cards.Children.Add(DashboardWidgetViews.Build(widget, _navigate));

            var wrap = new VariableSizedWrapGrid { Orientation = Orientation.Horizontal, ItemWidth = 440 };
            foreach (var widget in result.Widgets.Where(w => !DashboardWidgetViews.IsCard(w)))
            {
                var view = DashboardWidgetViews.Build(widget, _navigate);
                if (widget.Kind == "recent")
                    VariableSizedWrapGrid.SetColumnSpan((FrameworkElement)view, 2);
                wrap.Children.Add(view);
            }
            _others.Content = wrap;
            if (result.Widgets.Count == 0)
                _message.Text = "The schema suggests nothing to show.";
        }
        catch (ApiException ex)
        {
            _message.Text = ex.Explain("loading the dashboard");
        }
        catch (HttpRequestException)
        {
            _message.Text = "The server could not be reached.";
        }
    }
}
<#
    if (Project.DashboardStrip)
    {
#>
@@@FILE <#= viewsFolder #>/DashboardStrip.cs@@@
<#= DesktopDashboardCode.StripFile(viewNamespace, $"using {servicesNamespace};\n", "", "    private readonly DashboardClient _client;\n", "DashboardClient client, string table", "        _client = client;\n",
        "            var result = await _client.GetAsync(_table);\n") #><#
    }
#>
