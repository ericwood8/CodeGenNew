# TS_Component_v1.tt run as its OData form (see Base and Variant in TemplateConfig). Opt in with OData=true and an Angular stack; written only for the tables the project serves as OData.
Base=TS_Component_v1.tt
Variant=OData
Requires=PrimaryKey,SingleKey
NeedsReferencedDisplayColumns=true
Stacks=Angular
PlanTables=ScreenForm
OutputFolder=src/app
InPlan=false
