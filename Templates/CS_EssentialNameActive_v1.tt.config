# Restriction checkboxes for CS_EssentialNameActive_v1.tt (see Docs/Reference.md section 3).
# One of the files every app of a stack needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Api,WinUI3
EssentialsGroup=NameActive
Description=BaseNameActiveEntity, INameActiveRepo and NameActiveRepo: the base classes of a table with a Name and an IsActive column (duplicate-name rule)
Needs=Data/{Context}.cs
