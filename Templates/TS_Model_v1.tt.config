# Restriction checkboxes for TS_Model_v1.tt (see Docs/Reference.md section 3).
# The interface has an optional key property; needs a single-column primary key (any type) -- not composite.
RequiresPrimaryKey=true
TableOnly=true
RequiredPrimaryKeyShape=SingleColumn
# No OutputName: the template writes its own path (models/<table>.ts) with an @@@FILE marker.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=React,Angular
PlanTables=Entity
OutputFolder.React=src
OutputFolder.Angular=src/app
