# Restriction checkboxes for TS_Model_v1.tt (see Docs/specs.md section 5.3).
# The interface has an optional key property; needs a single-column primary key (any type) -- not composite.
RequiresPrimaryKey=true
TableOnly=true
RequiredPrimaryKeyShape=SingleColumn
# No OutputName: the template writes its own path (models/<table>.ts) with an @@@FILE marker.
