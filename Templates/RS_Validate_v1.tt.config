# Restriction checkboxes for RS_Validate_v1.tt (see Docs/Reference.md section 3).
# The routes are keyed by the primary key, so one single-column int, uniqueidentifier or text key is required.
Requires=PrimaryKey,SingleKey
# The Rust stack reads PostgreSQL, MySQL and SQLite through sqlx; SQL Server is not supported.
Dialects=PostgreSql,MySql,Sqlite
# No OutputName: the template writes its own path (src/validation/<table>.rs) with an @@@FILE marker.
# Whole-project generation (codegen generate): written only for a project with ApiValidation=true.
Stacks=Rust
PlanTables=PythonRustApi
InPlan=false
