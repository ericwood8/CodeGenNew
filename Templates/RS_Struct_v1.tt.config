# Restriction checkboxes for RS_Struct_v1.tt (see Docs/Reference.md section 3).
# The routes are keyed by the primary key, so one single-column int, uniqueidentifier or text key is required.
RequiresPrimaryKey=true
TableOnly=true
RequiredPrimaryKeyShape=SingleIntGuidOrText
# A name/active table's repository is hand-maintained; it gets no generated API.
RequiresNotNameActiveTable=true
# The Rust stack reads PostgreSQL, MySQL and SQLite through sqlx; SQL Server is not supported.
Dialects=PostgreSql,MySql,Sqlite
# No OutputName: the template writes its own path (src/models/<table>.rs) with an @@@FILE marker.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Rust
PlanTables=CrudApi
