# Restriction checkboxes for CS_Entity_v1.tt (see Docs/Reference.md section 3).
# The class needs a key: [Key] for a single-column primary key, or the DbContext's HasKey for a composite one.
RequiresPrimaryKey=true
TableOnly=true
# Name the file like the class: E_DonateLeave -> E_DonateLeave.cs
OutputName={Table}.cs
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Api,WinUI3
PlanTables=Context
OutputFolder=Entities
