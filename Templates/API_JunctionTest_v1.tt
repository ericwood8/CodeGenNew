<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // API_JunctionTest_v1.tt
    // Generates: <TableName>JunctionApiTests.cs   (see OutputName in API_JunctionTest_v1.tt.config; goes to the test project, OutputApiTests)
    // An MSTest class for the junction routes API_Junction writes (GET <route>/junction/{anchorId}, POST .../link and .../unlink), run in process over a scratch database like API_Test: the list names
    // every row of the target with whether it is linked, a link and an unlink move that flag, repeating either changes nothing more, a target that is not there cannot be linked, and with ApiAuth a call
    // without a token is a 401 and a role the table's write rule does not list is a 403. The two rows to link are the first rows of the two sides' APIs, or rows added with the sides' own test bodies.
    // Writes for a many-to-many junction table whose two sides both have an API; the project must set ApiTests=true. The fixture and the project file come from the Tests essentials group.
    // Full notes: Docs/TemplateNotes/API_Test_v1.md
    // ==========================================================================================

    var junction = Model.Junction;
    bool HasApi(ForeignKeyModel fk) => fk.ReferencedColumns.Count == 1 && !Project.NoApiFor(fk.ReferencedTable, fk.ReferencedLookupShape);
    if (!Model.IsJunctionTable || junction is null)
    {
        Error($"API_JunctionTest writes tests for a many-to-many junction table, and [{Model.SchemaName}].[{Model.TableName}] is not one.");
    }
    else if (!HasApi(junction.AnchorForeignKey) || !HasApi(junction.TargetForeignKey))
    {
        Error($"API_JunctionTest needs an API for both sides of [{Model.TableName}] ({junction.AnchorRole} and {junction.TargetRole}) to take the rows to link from.");
    }
    else
    {
        string projectName = Project.ProjectName ?? "MyApp";
        string route = BlazorNames.ApiRoute(Model.TableName);
        var writeRoles = WriteRolePlan.For(Project, Model);
        string anchorJson = ApiSampleValues.Json(JsonNames.Camel(junction.AnchorForeignKey.ReferencedColumns[0]));
        string targetJson = ApiSampleValues.Json(JsonNames.Camel(junction.TargetForeignKey.ReferencedColumns[0]));
        bool IsText(ColumnModel c) => c.SqlType is not (SqlDbType.Int or SqlDbType.BigInt or SqlDbType.SmallInt or SqlDbType.TinyInt);
        string Existing(string role, string keyJson, ColumnModel c) =>
            $"await ApiFixture.{(IsText(c) ? "ExistingCodeAsync" : "ExistingKeyAsync")}({ApiSampleValues.Json(BlazorNames.ApiRoute(role))}, {keyJson}, {(IsText(c) ? "\"\"" : "1")}, {ApiSampleValues.Json(role)})";
        string keyType(ColumnModel c) => IsText(c) ? "string" : "long";
        string absentTarget = junction.TargetColumn.SqlType switch
        {
            SqlDbType.Int or SqlDbType.BigInt or SqlDbType.SmallInt => "int.MaxValue",
            SqlDbType.UniqueIdentifier => "Guid.NewGuid()",
            _ => ""
        };
        string[] shown = [.. junction.DisplayColumns.Select(c => ApiSampleValues.Json(JsonNames.Camel(c)))];
#>
namespace <#= projectName #>.Api.Tests;

[TestClass]
public class <#= Model.TableName #>JunctionApiTests
{
    private const string Route = "<#= route #>";

    /// <summary> The keys of a row of the anchor (<#= junction.AnchorRole #>) and of one of the target (<#= junction.TargetRole #>): the first row of each API, or a row added with the table's own body. </summary>
    private static async Task<(<#= keyType(junction.AnchorColumn) #> Anchor, <#= keyType(junction.TargetColumn) #> Target)> APairAsync() =>
        (<#= Existing(junction.AnchorRole, anchorJson, junction.AnchorColumn) #>, <#= Existing(junction.TargetRole, targetJson, junction.TargetColumn) #>);

    /// <summary> Whether the target is linked to the anchor, as the junction list says; null when the list does not have the target. </summary>
    private static async Task<bool?> IsLinkedAsync(HttpClient client, <#= keyType(junction.AnchorColumn) #> anchor, <#= keyType(junction.TargetColumn) #> target)
    {
        using var response = await client.GetAsync($"{Route}/junction/{Uri.EscapeDataString(anchor.ToString()!)}");
        Assert.AreEqual(HttpStatusCode.OK, response.StatusCode, await response.Content.ReadAsStringAsync());
        var items = (await response.Content.ReadFromJsonAsync<JsonArray>())!;
        var item = items.FirstOrDefault(i => i!["targetId"]!.ToString() == target.ToString());
        return item is null ? null : item["isSelected"]!.GetValue<bool>();
    }

    private static async Task AssertLinkedAsync(HttpClient client, <#= keyType(junction.AnchorColumn) #> anchor, <#= keyType(junction.TargetColumn) #> target, bool expected, string message)
    {
        bool? state = await IsLinkedAsync(client, anchor, target);
        Assert.IsNotNull(state, "the target is in the list");
        if (expected)
            Assert.IsTrue(state.Value, message);
        else
            Assert.IsFalse(state.Value, message);
    }

    private static object Link(<#= keyType(junction.AnchorColumn) #> anchor, <#= keyType(junction.TargetColumn) #> target) => new { anchorId = anchor, targetId = target };

    [TestMethod]
    public async Task A_target_can_be_linked_and_unlinked_and_either_can_be_repeated()
    {
        ApiFixture.RequireDatabase();
        var client = ApiFixture.Client;
        var (anchor, target) = await APairAsync();
        using var first = await client.PostAsJsonAsync($"{Route}/junction/unlink", Link(anchor, target));
        await AssertLinkedAsync(client, anchor, target, false, "the target is not linked");
        try
        {
            for (int i = 0; i < 2; i++)
            {
                using var linked = await client.PostAsJsonAsync($"{Route}/junction/link", Link(anchor, target));
                Assert.AreEqual(HttpStatusCode.OK, linked.StatusCode, await linked.Content.ReadAsStringAsync());
                await AssertLinkedAsync(client, anchor, target, true, "the target is linked");
            }
        }
        finally
        {
            for (int i = 0; i < 2; i++)
            {
                using var unlinked = await client.PostAsJsonAsync($"{Route}/junction/unlink", Link(anchor, target));
                Assert.AreEqual(HttpStatusCode.OK, unlinked.StatusCode, await unlinked.Content.ReadAsStringAsync());
                await AssertLinkedAsync(client, anchor, target, false, "the target is not linked");
            }
        }
    }

    [TestMethod]
    public async Task The_list_names_every_target_with_its_display_columns()
    {
        ApiFixture.RequireDatabase();
        var (anchor, target) = await APairAsync();
        using var response = await ApiFixture.Client.GetAsync($"{Route}/junction/{Uri.EscapeDataString(anchor.ToString()!)}");
        Assert.AreEqual(HttpStatusCode.OK, response.StatusCode, await response.Content.ReadAsStringAsync());
        var items = (await response.Content.ReadFromJsonAsync<JsonArray>())!;
        var item = items.FirstOrDefault(i => i!["targetId"]!.ToString() == target.ToString());
        Assert.IsNotNull(item, "the target is in the list");
<#
        if (shown.Length > 0)
        {
#>
        foreach (string column in new[] { <#= string.Join(", ", shown) #> })
            Assert.IsTrue(item!.AsObject().ContainsKey(column), "the item has " + column);
<#
        }
#>
        Assert.IsTrue(item!["isSelected"]!.GetValueKind() is System.Text.Json.JsonValueKind.True or System.Text.Json.JsonValueKind.False, "isSelected is a flag");
    }
<#
        if (absentTarget.Length > 0)
        {
#>

    [TestMethod]
    public async Task A_row_that_is_not_there_cannot_be_linked()
    {
        ApiFixture.RequireDatabase();
        var (anchor, _) = await APairAsync();
        var link = new { anchorId = anchor, targetId = <#= absentTarget #> };
        using var refused = await ApiFixture.Client.PostAsJsonAsync($"{Route}/junction/link", link);
        if (refused.IsSuccessStatusCode)
        {
            using var undone = await ApiFixture.Client.PostAsJsonAsync($"{Route}/junction/unlink", link);
        }
        Assert.IsFalse(refused.IsSuccessStatusCode, "a link to a row that is not there is refused: " + (int)refused.StatusCode);
    }
<#
        }
        if (Project.ApiAuth)
        {
#>

    [TestMethod]
    public async Task Without_a_token_the_junction_answers_401()
    {
        ApiFixture.RequireDatabase();
        var (anchor, target) = await APairAsync();
        using var nobody = ApiFixture.Anonymous();
        using var list = await nobody.GetAsync($"{Route}/junction/{Uri.EscapeDataString(anchor.ToString()!)}");
        Assert.AreEqual(HttpStatusCode.Unauthorized, list.StatusCode);
        using var link = await nobody.PostAsJsonAsync($"{Route}/junction/link", Link(anchor, target));
        Assert.AreEqual(HttpStatusCode.Unauthorized, link.StatusCode);
        using var unlink = await nobody.PostAsJsonAsync($"{Route}/junction/unlink", Link(anchor, target));
        Assert.AreEqual(HttpStatusCode.Unauthorized, unlink.StatusCode);
    }
<#
            if (writeRoles.Count > 0)
            {
#>

    [TestMethod]
    public async Task A_role_the_write_rule_does_not_list_cannot_link()
    {
        ApiFixture.RequireDatabase();
        var (anchor, target) = await APairAsync();
        using var other = ApiFixture.ClientInRole("NoSuchRole");
        foreach (string action in new[] { "link", "unlink" })
        {
            using var reply = await other.PostAsJsonAsync($"{Route}/junction/{action}", Link(anchor, target));
            Assert.AreEqual(HttpStatusCode.Forbidden, reply.StatusCode, action);
            Assert.AreEqual("<#= ProblemTypes.RoleNotAllowed #>", (await reply.Content.ReadFromJsonAsync<JsonObject>())!["type"]!.GetValue<string>());
        }
    }
<#
            }
        }
#>
}
<#
    }
#>
