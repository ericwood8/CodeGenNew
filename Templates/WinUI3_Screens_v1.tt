<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string windowNamespace = "MyApp.Desktop";            // the namespace of MainWindow
    string viewNamespace = "MyApp.Desktop.Views";        // the namespace of the list pages (WinUI3_MasterScreen)
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    viewNamespace = Project.ViewNamespace ?? viewNamespace;
    windowNamespace = Project.ViewNamespace is not null || Project.ProjectName is not null ? Project.AppNamespace : windowNamespace;
    // The screens and their order come from the project's Screens setting (see DatabaseModel).
    // ==========================================================================================

    // ==========================================================================================
    // WinUI3_Screens_v1.tt
    // Generates: MainWindow.Screens.cs   (see OutputName in WinUI3_Screens_v1.tt.config)
    // The other half of the partial MainWindow: the menu entries and the switch that shows a screen, in menu order from the project's Screens setting.
    // MainWindow.xaml keeps an empty NavigationView and MainWindow.xaml.cs stays hand-written. A master-detail screen whose child table has no screen gets
    // a WARNING comment at the top.
    // Full notes: Docs/TemplateNotes/WinUI3_Screens_v1.md

    var screens = Database.ScreenTables(Project, "WinUI3");
    foreach (string name in Database.UnknownScreens(Project))
        Error($"The Screens setting lists '{name}', which is not a table of the database with a single-column primary key.");
    if (screens.Count == 0)
        Error("WinUI3_Screens found no table to list: no table has an API and a search endpoint, and the project's Screens setting is empty.");

    // With Dashboard=true the dashboard is the first screen; with DashboardStrip=true each table that has cards shows them above its list page.
    bool dashboard = Project.Dashboard;
    var stripTables = Project.DashboardStrip ? DashboardPlan.Build(Database, Project).StripTables.Where(name => screens.Any(t => t.TableName.EqualsIgnoreCase(name))).ToHashSet(StringComparer.OrdinalIgnoreCase) : new HashSet<string>();

    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');

    Line($"using {viewNamespace};");
    if (dashboard || stripTables.Count > 0)
    {
        Line("using System.Linq;");
        Line("using Microsoft.UI.Xaml;");
    }
    Line("using Microsoft.UI.Xaml.Controls;");
    Line();
    Line($"namespace {windowNamespace};");
    Line();
    Line("// Generated by WinUI3_Screens: the screens in menu order. Change the list with the Screens project setting and regenerate.");
    Line("public sealed partial class MainWindow");
    Line("{");
    Line($"    private const string FirstScreen = \"{(dashboard ? "Dashboard" : screens[0].TableName)}\";");
    Line();
    Line("    private void AddScreens()");
    Line("    {");
    if (dashboard)
        Line("        NavView.MenuItems.Add(new NavigationViewItem { Content = \"Dashboard\", Tag = \"Dashboard\" });");
    foreach (var t in screens)
        Line($"        NavView.MenuItems.Add(new NavigationViewItem {{ Content = \"{ScreenNames.Label(t.TableName)}\", Tag = \"{t.TableName}\" }});");
    Line("    }");
    Line();
    if (dashboard)
    {
        Line("    // Selecting the menu entry shows its page, so a widget's link goes through the menu.");
        Line("    private void GoTo(string tag)");
        Line("    {");
        Line("        var item = NavView.MenuItems.OfType<NavigationViewItem>().FirstOrDefault(i => (string)i.Tag == tag);");
        Line("        if (item is not null)");
        Line("            NavView.SelectedItem = item;");
        Line("    }");
        Line();
    }
    if (stripTables.Count > 0)
    {
        Line("    // A table's strip of cards above its list page.");
        Line("    private static UIElement WithStrip(string table, UIElement page)");
        Line("    {");
        Line("        var host = new Grid();");
        Line("        host.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });");
        Line("        host.RowDefinitions.Add(new RowDefinition { Height = new GridLength(1, GridUnitType.Star) });");
        Line("        host.Children.Add(new DashboardStrip(table));");
        Line("        Grid.SetRow((FrameworkElement)page, 1);");
        Line("        host.Children.Add(page);");
        Line("        return host;");
        Line("    }");
        Line();
    }
    Line("    private void ShowPage(string tag)");
    Line("    {");
    Line("        MainContent.Content = tag switch");
    Line("        {");
    if (dashboard)
        Line("            \"Dashboard\" => new DashboardPage(GoTo),");
    foreach (var t in screens)
        Line(stripTables.Contains(t.TableName)
            ? $"            \"{t.TableName}\" => WithStrip(\"{t.TableName}\", new {t.TableName}ListPage(_context)),"
            : $"            \"{t.TableName}\" => new {t.TableName}ListPage(_context),");
    Line("            _ => MainContent.Content");
    Line("        };");
    Line("    }");
    Line("}");
    Write(sb.ToString());
#>
