<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string windowNamespace = "MyApp.Desktop";            // the namespace of MainWindow
    string viewNamespace = "MyApp.Desktop.Views";        // the namespace of the list pages (WinUI3_MasterScreen)
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    viewNamespace = Project.ViewNamespace ?? viewNamespace;
    windowNamespace = Project.ViewNamespace is not null || Project.ProjectName is not null ? Project.AppNamespace : windowNamespace;
    // The screens and their order come from the project's Screens setting (see DatabaseModel).
    // ==========================================================================================

    // ==========================================================================================
    // WinUI3_Screens_v1.tt
    // Generates: MainWindow.Screens.cs   (see OutputName in WinUI3_Screens_v1.tt.config)
    // The other half of the partial MainWindow: the menu entries and the switch that shows a screen, in menu order from the project's Screens setting.
    // MainWindow.xaml keeps an empty NavigationView and MainWindow.xaml.cs stays hand-written. A master-detail screen whose child table has no screen gets
    // a WARNING comment at the top.
    // Full notes: Docs/TemplateNotes/WinUI3_Screens_v1.md

    var screens = Database.ScreenTables(Project, "WinUI3");
    foreach (string name in Database.UnknownScreens(Project))
        Error($"The Screens setting lists '{name}', which is not a table of the database with a single-column primary key.");
    if (screens.Count == 0)
        Error("WinUI3_Screens found no table to list: no table has an API and a search endpoint, and the project's Screens setting is empty.");

    // With Dashboard=true the dashboard is the first screen; with DashboardStrip=true each table that has cards shows them above its list page.
    bool approvals = ApprovalScreens.For(Database, Project).Count > 0;   // the approvals page is the last screen (WinUI3_Approvals writes the page and its service)
    bool dashboard = Project.Dashboard;
    var stripTables = Project.DashboardStrip ? DashboardPlan.Build(Database, Project).StripTables.Where(name => screens.Any(t => t.TableName.EqualsIgnoreCase(name))).ToHashSet(StringComparer.OrdinalIgnoreCase) : new HashSet<string>();

    var junctions = JunctionPlan.Tables(Database, Project);   // a page for each many-to-many junction table, after the screens
    // administrators manage who works in the current tenant on the members page, the last screen
    bool members = DesktopMembersCode.Applies(Database, Project);
    string membersLine = $"        if (DesktopSession.HasRole([{CSharpText.Quote(Project.AuthAdminRole)}]))\n            NavView.MenuItems.Add(new NavigationViewItem {{ Content = \"{MemberWords.Menu}\", Tag = \"Members\" }});";
    // administrators see the plan, the status and the limits of their tenant on the subscription page (WinUI3_Subscription)
    bool subscription = DesktopSubscriptionCode.Applies(Database, Project);
    string subscriptionLine = $"        if (DesktopSession.HasRole([{CSharpText.Quote(Project.AuthAdminRole)}]))\n            NavView.MenuItems.Add(new NavigationViewItem {{ Content = \"{SubscriptionScreenWords.Menu}\", Tag = \"Subscription\" }});";
    // FeatureScreens names the flag that hides the screen of a table: the app reads the flags itself (WinUI3_Features) and the page for the administrator of a tenant switches them
    bool features = FeatureScreenCode.DesktopReads(Database, Project);
    bool featuresPage = FeatureScreenCode.DesktopHasPage(Database, Project);
    string featuresLine = $"        if (DesktopSession.HasRole([{CSharpText.Quote(Project.AuthAdminRole)}]))\n            NavView.MenuItems.Add(new NavigationViewItem {{ Content = \"{FeatureScreenWords.Menu}\", Tag = \"Features\" }});";
    // the administrator sees the sessions and tokens of TokenTables (WinUI3_Tokens)
    var tokenPages = TokenDesktopCode.DesktopPages(Database, Project);
    var usagePages = UsageScreens.DesktopPages(Database, Project);   // the administrator sees the usage of the tenant (WinUI3_Usage)
    bool roleMenu = TenantPlan.HasDesktopRoles(Project) || features || tokenPages.Count > 0 || usagePages.Count > 0;
    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');

    Line($"using {viewNamespace};");
    if (dashboard || stripTables.Count > 0 || roleMenu)
    {
        Line("using System.Linq;");
        Line("using Microsoft.UI.Xaml;");
    }
    Line("using Microsoft.UI.Xaml.Controls;");
    Line();
    Line($"namespace {windowNamespace};");
    Line();
    Line("// Generated by WinUI3_Screens: the screens in menu order. Change the list with the Screens project setting and regenerate.");
    Line("public sealed partial class MainWindow");
    Line("{");
    if (roleMenu)
    {
        // the screens and the roles that may read each (none listed: any signed-in person); the menu holds only the ones the signed-in role may read
        var menu = ScreenMenu.For(Project, screens, new List<TableModel>(), junctions, approvals)
            .Select(m => (Tag: m.Kind switch { ScreenMenuKind.Dashboard => "Dashboard", ScreenMenuKind.Approvals => "Approvals", ScreenMenuKind.Screen => m.Table!.TableName, _ => m.Table!.TableName + "Links" }, m.Label, m.Roles,
                Feature: m.Kind == ScreenMenuKind.Screen ? FeatureScreens.FlagOf(Project, m.Table!.TableName) : null))
            .ToList();
        Line(features ? "    private static readonly (string Tag, string Label, string[]? Roles, string? Feature)[] Screens =" : "    private static readonly (string Tag, string Label, string[]? Roles)[] Screens =");
        Line("    [");
        foreach (var e in menu)
            Line($"        (\"{e.Tag}\", \"{e.Label}\", {(e.Roles.Count == 0 ? "null" : "[" + WriteRolePlan.Literal(e.Roles) + "]")}{(features ? ", " + (e.Feature is null ? "null" : CSharpText.Quote(e.Feature)) : "")}),");
        Line("    ];");
        Line();
        Line("    // The first screen in the menu, which is the first the signed-in role may read.");
        Line("    private string FirstScreen => (NavView.MenuItems.FirstOrDefault() as NavigationViewItem)?.Tag as string ?? \"\";");
        Line();
        Line("    private void AddScreens()");
        Line("    {");
        Line("        NavView.MenuItems.Clear();");
        Line(features ? "        foreach (var (tag, label, roles, feature) in Screens)" : "        foreach (var (tag, label, roles) in Screens)");
        Line("        {");
        Line(features ? "            if ((roles is null || DesktopSession.HasRole(roles)) && (feature is null || DesktopFeatures.Enabled(feature)))" : "            if (roles is null || DesktopSession.HasRole(roles))");
        Line("                NavView.MenuItems.Add(new NavigationViewItem { Content = label, Tag = tag });");
        Line("        }");
        if (members)
            Line(membersLine);
        if (subscription)
            Line(subscriptionLine);
        if (featuresPage)
            Line(featuresLine);
        foreach (var tokenPage in tokenPages)
            Line($"        if (DesktopSession.HasRole([{CSharpText.Quote(Project.AuthAdminRole)}]))\n            NavView.MenuItems.Add(new NavigationViewItem {{ Content = \"{tokenPage.Label}\", Tag = \"{tokenPage.Name}\" }});");
        foreach (var usagePage in usagePages)
            Line($"        if (DesktopSession.HasRole([{CSharpText.Quote(Project.AuthAdminRole)}]))\n            NavView.MenuItems.Add(new NavigationViewItem {{ Content = \"{usagePage.Label}\", Tag = \"{usagePage.Name}\" }});");
        Line("    }");
    }
    else
    {
        Line($"    private const string FirstScreen = \"{(dashboard ? "Dashboard" : screens[0].TableName)}\";");
        Line();
        Line("    private void AddScreens()");
        Line("    {");
        if (dashboard)
            Line("        NavView.MenuItems.Add(new NavigationViewItem { Content = \"Dashboard\", Tag = \"Dashboard\" });");
        foreach (var t in screens)
            Line($"        NavView.MenuItems.Add(new NavigationViewItem {{ Content = \"{ScreenNames.Label(t.TableName)}\", Tag = \"{t.TableName}\" }});");
        foreach (var t in junctions)
            Line($"        NavView.MenuItems.Add(new NavigationViewItem {{ Content = \"{JunctionPlan.Label(t.TableName)}\", Tag = \"{t.TableName}Links\" }});");
        if (approvals)
            Line($"        NavView.MenuItems.Add(new NavigationViewItem {{ Content = \"{ApprovalWords.Title}\", Tag = \"Approvals\" }});");
        if (members)
            Line(membersLine);
        if (subscription)
            Line(subscriptionLine);
        Line("    }");
    }
    Line();
    if (dashboard)
    {
        Line("    // Selecting the menu entry shows its page, so a widget's link goes through the menu.");
        Line("    private void GoTo(string tag)");
        Line("    {");
        Line("        var item = NavView.MenuItems.OfType<NavigationViewItem>().FirstOrDefault(i => (string)i.Tag == tag);");
        Line("        if (item is not null)");
        Line("            NavView.SelectedItem = item;");
        Line("    }");
        Line();
    }
    if (stripTables.Count > 0)
    {
        Line("    // A table's strip of cards above its list page.");
        Line("    private static UIElement WithStrip(string table, UIElement page)");
        Line("    {");
        Line("        var host = new Grid();");
        Line("        host.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });");
        Line("        host.RowDefinitions.Add(new RowDefinition { Height = new GridLength(1, GridUnitType.Star) });");
        Line("        host.Children.Add(new DashboardStrip(table));");
        Line("        Grid.SetRow((FrameworkElement)page, 1);");
        Line("        host.Children.Add(page);");
        Line("        return host;");
        Line("    }");
        Line();
    }
    Line("    private void ShowPage(string tag)");
    Line("    {");
    Line("        MainContent.Content = tag switch");
    Line("        {");
    if (dashboard)
        Line("            \"Dashboard\" => new DashboardPage(GoTo),");
    foreach (var t in screens)
        Line(SingleRowPlan.Applies(t, Project, "WinUI3")
            ? $"            \"{t.TableName}\" => new {t.TableName}Page(_context),"   // the table's one row as a form (WinUI3_SingleRowScreen)
            : stripTables.Contains(t.TableName)
                ? $"            \"{t.TableName}\" => WithStrip(\"{t.TableName}\", new {t.TableName}ListPage(_context)),"
                : $"            \"{t.TableName}\" => new {t.TableName}ListPage(_context),");
    foreach (var t in junctions)
        Line($"            \"{t.TableName}Links\" => new {DesktopJunctionPage.PageName(t.TableName)}(_context),");
    if (approvals)
        Line("            \"Approvals\" => new ApprovalsPage(new ApprovalService(_context), ApprovalService.Tables),");
    if (members)
        Line($"            \"Members\" => new {DesktopMembersCode.PageName}(_context),");
    if (subscription)
        Line("            \"Subscription\" => new SubscriptionPage(_context),");
    if (featuresPage)
        Line("            \"Features\" => new FeaturesPage(_context),");
    foreach (var tokenPage in tokenPages)
        Line($"            \"{tokenPage.Name}\" => new {TokenDesktopCode.PageClass(tokenPage)}(_context),");
    foreach (var usagePage in usagePages)
        Line($"            \"{usagePage.Name}\" => new {usagePage.PageClass}(_context),");
    Line("            _ => MainContent.Content");
    Line("        };");
    Line("    }");
    Line("}");
    Write(sb.ToString());
#>
