<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // MySQL has real stored procedures with its own syntax: CodeGenNew.Core's MySqlProcedures writes this one for a table read from MySQL.
    if (Model.Dialect == SqlDialect.MySql)
    {
        Write(MySqlProcedures.Delete(Model));
        return GenerationEnvironment.ToString();
    }
#>
<#
    // PostgreSQL has functions rather than stored procedures: CodeGenNew.Core's PostgresProcedures writes this one for a table read from PostgreSQL.
    if (Model.Dialect == SqlDialect.PostgreSql)
    {
        Write(PostgresProcedures.Delete(Model));
        return GenerationEnvironment.ToString();
    }
#>
<#
    // ==========================================================================================
    // SP_Delete_v1.tt
    // Generates: <TableName>_Delete.sql
    // Attempts the DELETE and reports: 0 deleted, -1 blocked by a foreign key elsewhere, -2 failed for another database reason. No
    // dependency pre-check: the database's own constraints refuse it natively and fast. Needs a primary key (single, composite or GUID) and a table.
    // Writes a SQL Server procedure (blocked = error 547, read from @@ERROR), a PostgreSQL function (foreign_key_violation) or a MySQL procedure
    // (error 1451), by the source database; the last two come from CodeGenNew.Core's PostgresProcedures and MySqlProcedures.
    // Full notes: Docs/TemplateNotes/SP_Delete_v1.md

    var pkColumns = Model.PrimaryKeyColumns;
    string whereClause = string.Join(" AND ", pkColumns.Select(pk => $"[{pk.Name}] = {pk.ParameterName}"));
#>
CREATE OR ALTER PROCEDURE [<#= Model.SchemaName #>].[<#= Model.TableName #>_Delete]
(
<#
    for (int i = 0; i < pkColumns.Count; i++)
    {
        var pk = pkColumns[i];
        string comma = (i < pkColumns.Count - 1) ? "," : "";
#>
<#= pk.ParameterName #> <#= pk.SqlTypeDeclaration #><#= comma #>
<#
    }
#>
)
AS
BEGIN
	DECLARE @lngReturn INT;

	DELETE FROM [<#= Model.SchemaName #>].[<#= Model.TableName #>] WHERE (<#= whereClause #>);

	DECLARE @lngDeleteError INT = @@ERROR;
	IF @lngDeleteError = <#= SqlErrorCodes.SqlServerForeignKeyViolation #>
		SELECT @lngReturn = <#= DeleteResult.BlockedByForeignKey #>;
	ELSE IF @lngDeleteError <> 0
		SELECT @lngReturn = <#= DeleteResult.Failed #>;
	ELSE
		SELECT @lngReturn = <#= DeleteResult.Deleted #>;

	RETURN IsNull(@lngReturn, 0);
END
