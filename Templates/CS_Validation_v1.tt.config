# Restriction checkboxes for CS_Validation_v1.tt (see Docs/specs.md section 5.3).
# Unlike CS_Entity.tt, this does NOT require a single-column key -- a validation buddy class has no
# [Key]/Fluent-API concern, so even a composite-key table's columns can still be validated.
RequiresPrimaryKey=true
TableOnly=true
# Name the file like the class + "Validation": E_DonateLeave -> E_DonateLeaveValidation.cs
OutputName={Table}Validation.cs
