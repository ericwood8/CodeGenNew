<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    // Folders under the Angular app root (where -o points) that the generated files go in; a component goes in a folder of its
    // own inside componentsFolder, so its imports climb two levels (../../models/...).
    string componentsFolder = Project.ComponentsFolder;
    string servicesFolder = Project.ServicesFolder;
    string modelsFolder = Project.ModelsFolder;
    // Tables that have no API (C# enums, other *Type lookup tables, tables with no entity): no screen is written for them.
    string[] noApiTables =
    {
        "ClearanceType", "ExpenseType", "LeaveType", "OvertimeType", "SY_RequestStatusType", "SY_RequestType",
        "SY_ResponseType", "SY_Role", "SY_Display", "SY_ISOCountry", "SY_PerDiem", "sysdiagrams"
    };
    // A foreign key to one of these is a plain number/text box, not a drop-down.
    string[] noLookupParents =
    {
        "ClearanceType", "ExpenseType", "LeaveType", "OvertimeType", "SY_Display", "SY_ISOCountry",
        "SY_RequestStatusType", "SY_RequestType", "SY_ResponseType", "SY_Role", "DepartmentTeam", "ProjectTask"
    };
    // A foreign key to this table is left off the screen (a styling id no one edits).
    string hiddenParent = "SY_Display";
    // Parents whose interface lives in another table's model file: table -> file name (without .ts).
    var modelFileOf = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["DepartmentTeam"] = "department",
        ["ProjectTask"] = "project"
    };
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    modelFileOf = Project.ModelFileOverrides ?? modelFileOf;
    bool IsHiddenParent(string table) => Project.HiddenParents is { } hidden ? hidden.Contains(table, StringComparer.OrdinalIgnoreCase) : table.Equals(hiddenParent, StringComparison.OrdinalIgnoreCase);
    // With a project chosen, which tables count as enums (no entity/repository/API of their own) comes from the project's
    // EnumTables, else from what the schema says about each table (LookupShape) - not from the lists above, which are
    // only used when no project is chosen.
    bool NoApi(string table, LookupShape shape) => Project.NoApi(table, shape) ?? noApiTables.Contains(table, StringComparer.OrdinalIgnoreCase);
    bool NoLookup(string table, LookupShape shape) => Project.NoLookup(table, shape) ?? noLookupParents.Contains(table, StringComparer.OrdinalIgnoreCase);
    // ==========================================================================================

    // ==========================================================================================
    // TS_Component_v1.tt
    // Generates the four files of an Angular standalone component in components/<table>/ (css, html, spec.ts, ts; the paths are written by the template, point the output folder at src/app)
    // A grid of the table's rows with Edit, Clone and Delete, Add New, a search row with a box per searchable column, paging, sortable headers and an
    // add/edit form (tabs when the table has billing/shipping or note fields), with drop-downs for foreign keys and listed values, a date box and number limits.
    // Imports the model and service (TS_Model, TS_Service). Does not write a detail grid (TS_DetailMasterComponent does).
    // Full notes: Docs/TemplateNotes/TS_Component_v1.md
    // ==========================================================================================

    string BaseName(string table) => Regex.Replace(Regex.Replace(table, "^E_", ""), "^SY_", "");
    string LowerFirst(string s) => s.Length == 0 ? s : char.ToLowerInvariant(s[0]) + s[1..];
    string UpperFirst(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    string Words(string s) => Regex.Replace(s.Replace('_', ' '), "(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])", " ").Trim();
    string Camel(string name)
    {
        if (string.IsNullOrEmpty(name) || !char.IsUpper(name[0])) return name;
        var chars = name.ToCharArray();
        for (int i = 0; i < chars.Length; i++)
        {
            if (i == 1 && !char.IsUpper(chars[i])) break;
            bool hasNext = i + 1 < chars.Length;
            if (i > 0 && hasNext && !char.IsUpper(chars[i + 1])) break;
            chars[i] = char.ToLowerInvariant(chars[i]);
        }
        return new string(chars);
    }
    bool IsDate(ColumnModel c) => c.SqlType is SqlDbType.Date or SqlDbType.DateTime or SqlDbType.DateTime2 or SqlDbType.SmallDateTime;
    bool IsNumber(ColumnModel c) => c.SqlType is SqlDbType.Int or SqlDbType.BigInt or SqlDbType.SmallInt or SqlDbType.TinyInt
        or SqlDbType.Decimal or SqlDbType.Money or SqlDbType.SmallMoney or SqlDbType.Float or SqlDbType.Real;
    // A decimal, float or real column that is not money (a percentage, a rate, a quantity, a weight) is limited to what the column can hold (a percentage to 0-100).
    bool IsPlainDecimal(ColumnModel c) => !c.IsIntegerColumn && !c.IsCurrencyColumn && c.SqlType is SqlDbType.Decimal or SqlDbType.Float or SqlDbType.Real;
    string Inv(double d) => d.ToString("0.########", System.Globalization.CultureInfo.InvariantCulture);
    bool IsText(ColumnModel c) => c.SqlType is SqlDbType.Char or SqlDbType.VarChar or SqlDbType.NChar or SqlDbType.NVarChar;
    int Chars(ColumnModel c) => c.MaxLength is null ? 0 : (c.SqlType is SqlDbType.NChar or SqlDbType.NVarChar ? c.MaxLength.Value / 2 : c.MaxLength.Value);
    bool IsMultiline(ColumnModel c) => IsText(c) && Chars(c) >= 100;
    string Label(string columnName)
    {
        string s = Regex.Replace(Regex.Replace(columnName, "^SY_", ""), "Id$", "");
        return Words(s);
    }

    var keyColumn = Model.PrimaryKeyColumns.Count == 1 ? Model.PrimaryKeyColumns[0] : null;
    if (NoApi(Model.TableName, Model.LookupShape))
    {
        Error($"TS_Component writes no screen for [{Model.SchemaName}].[{Model.TableName}]: it is listed in noApiTables (an enum, a *Type lookup table, or a table with no entity class), so there is no API for it to show.");
    }
    else if (keyColumn is null || keyColumn.SqlType is not (SqlDbType.Int or SqlDbType.UniqueIdentifier))
    {
        Error($"TS_Component needs a table with a single int or uniqueidentifier primary key (the routes take the id as {{id:int}} or {{id:guid}}), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else if (Model.IsNameActiveTable)
    {
        Error($"TS_Component assumes a plain getAll()-style API. [{Model.SchemaName}].[{Model.TableName}] has a Name and an IsActive column, so its repository is a NameActiveRepo and its real API is always hand-maintained (and commonly has no plain getAll() at all); write this screen by hand.");
    }
    else
    {
        string baseName = BaseName(Model.TableName);
        string stem = baseName.ToLowerInvariant();
        string variable = LowerFirst(baseName);        // holiday
        string listName = variable.Pluralize();        // holidays
        string keyProp = Camel(keyColumn.Name);        // holidayId
        string keyTs = keyColumn.SqlType == SqlDbType.Int ? "number" : "string";                       // a uniqueidentifier key travels as a string
        string emptyKey = keyColumn.SqlType == SqlDbType.Int ? "0" : "'00000000-0000-0000-0000-000000000000'"; // "no key yet": the API assigns the real one
        string title = Words(baseName);                // Time Sheet
        bool hasName = Model.Columns.Any(c => c.IsStringColumn && c.Name == "Name"); // just for showError's message wording below
        int pageSize = 20;
        // Same order as Model.SearchableColumns (not "Name first" like the form fields below) - getPage's
        // filter parameters are positional (TS_Service.tt), so this list's order must match its exactly.
        // Empty for a table with no searchable column - canSearch below gates the search bar UI specifically;
        // pagination itself is unconditional (see the header comment's 2026-09-28 update).
        var searchFields = Model.SearchableColumns
            .Select(c => new { ParamName = LowerFirst(c.Name), c.Name, Label = Label(c.Name) })
            .ToList();
        bool canSearch = searchFields.Count > 0;

        var fkByColumn = Model.ForeignKeys.Where(f => f.ReferencingColumns.Count == 1)
            .GroupBy(f => f.ReferencingColumns[0], StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        // ==== the columns on the screen: Name first, then table order
        var shown = Model.Columns
            .Where(c => !c.IsPrimaryKey && !c.IsComputed && !c.IsIdentity
                        && !(fkByColumn.TryGetValue(c.Name, out var hfk) && IsHiddenParent(hfk.ReferencedTable)))
            .OrderBy(c => c.Name == "Name" ? 0 : 1).ThenBy(c => c.OrdinalPosition)
            .ToList();

        // ==== lookups: one list + one "name of" method per distinct parent table
        ForeignKeyModel LookupOf(ColumnModel c) =>
            fkByColumn.TryGetValue(c.Name, out var fk)
            && !NoLookup(fk.ReferencedTable, fk.ReferencedLookupShape)
            && fk.ReferencedDisplayColumns.Count > 0
                ? fk : null;
        var parents = shown.Select(c => LookupOf(c)).Where(fk => fk is not null)
            .GroupBy(fk => fk.ReferencedTable, StringComparer.OrdinalIgnoreCase).Select(g => g.First())
            .Select(fk =>
            {
                string parentBase = BaseName(fk.ReferencedTable);
                bool self = fk.ReferencedTable.Equals(Model.TableName, StringComparison.OrdinalIgnoreCase);
                return new
                {
                    Table = fk.ReferencedTable,
                    Type = parentBase,
                    ModelFile = modelFileOf.TryGetValue(fk.ReferencedTable, out var mf) ? mf : parentBase.ToLowerInvariant(),
                    Service = parentBase + "Service",
                    ServiceVar = LowerFirst(parentBase) + "Service",
                    ServiceFile = parentBase.ToLowerInvariant() + ".service",
                    List = LowerFirst(parentBase).Pluralize(),
                    NameMethod = LowerFirst(parentBase) + "Name",
                    KeyProp = Camel(fk.ReferencedColumns[0]),
                    IdType = Model.Columns.First(col => col.Name.Equals(fk.ReferencingColumns[0], StringComparison.OrdinalIgnoreCase)).SqlType == SqlDbType.UniqueIdentifier ? "string" : "number",
                    DisplayProp = Camel(fk.ReferencedDisplayColumns[0]),
                    Self = self
                };
            }).ToList();
        var parentOf = parents.ToDictionary(p => p.Table, StringComparer.OrdinalIgnoreCase);

        // ==== naming on the page
        string Id(ColumnModel c) => variable + UpperFirst(Camel(c.Name));   // holidayName
        string PlaceholderFor(ColumnModel c) => "Enter " + Label(c.Name).ToLowerInvariant();
        string LabelOf(ColumnModel c) => c.SqlType == SqlDbType.Bit ? Label(c.Name) + "?" : Label(c.Name);
        var gridColumns = shown.Where(c => !IsMultiline(c)).ToList();
        // long text is left out of the grid to keep it readable - unless that would leave nothing to show but the buttons
        if (gridColumns.Count == 0) gridColumns = shown.ToList();
        // The grid shows at most 20 columns and never a long text column (a Notes column, ...): see GridColumns.
        gridColumns = gridColumns.ForGrid();
        // A grid column's header sorts the grid unless it is long text or binary (SearchSort.IsSortable; long text never is in a grid anyway).
        var sortableColumns = gridColumns.Where(SearchSort.IsSortable).ToList();
        // A Clone button beside Edit and Delete for the tables CloneShape allows (the service has clone(id), API_Crud / CS_Repo write the server side).
        bool canClone = CloneShape.CanClone(Model, Project);
        // The form is tabbed (Main / Billing & Shipping / Notes) when it has more than one kind of field: see FormPages.
        var formPages = FormPages.For(shown);
        bool tabbed = formPages.Count > 1;

        var css = new StringBuilder(); // stays empty
        var html = new StringBuilder();
        var spec = new StringBuilder();
        var ts = new StringBuilder();
        void H(string s = "") => html.Append(s).Append('\n');
        void T(string s = "") => ts.Append(s).Append('\n');

        // ================= html
        H("<main class=\"main\">");
        H("    <div class=\"content\">");
        H("      <div class=\"left-side\">");
        H("<div>");
        H("    <!-- Heading -->");
        H($"    <h1>{title.Pluralize()}</h1>");
        H($"    <button (click)=\"add()\" class=\"btn\">Add New {title}</button>");
        if (canSearch)
        {
            H();
            H("    <!-- Search -->");
            H("    <div class=\"form-group form-group-search dept\">");
            foreach (var f in searchFields)
                H($"        <input type=\"text\" class=\"form-control\" placeholder=\"Search by {f.Label}\" [(ngModel)]=\"filters.{f.ParamName}\" />");
            H("        <button class=\"btn btn-outline-secondary\" type=\"button\" (click)=\"search()\"> Search </button>");
            H("        <button class=\"btn btn-outline-secondary\" type=\"button\" (click)=\"clearSearch()\"> Clear </button>");
            H("    </div>");
        }
        H();
        H("    <!-- Grid -->");
        // A right-click on the grid opens a small menu with Clear sort; a click on a sortable header sorts by it (again: flips the direction).
        H("    <table (contextmenu)=\"openSortMenu($event)\">");
        H("        <thead>");
        H("            <tr>");
        foreach (var c in gridColumns)
        {
            if (sortableColumns.Contains(c))
                H($"                <th [attr.aria-sort]=\"ariaSort('{c.Name}')\"><button type=\"button\" class=\"sort-header\" (click)=\"sortBy('{c.Name}')\">{GridCaption.For(c, LabelOf(c))}{{{{ sortMark('{c.Name}') }}}}</button></th>");
            else
                H($"                <th>{GridCaption.For(c, LabelOf(c))}</th>");
        }
        H("                <th>Actions</th>");
        H("            </tr>");
        H("        </thead>");
        H("        <tbody>");
        H($"            <tr *ngFor=\"let {variable} of {listName}\">");
        foreach (var c in gridColumns)
        {
            string prop = $"{variable}.{Camel(c.Name)}";
            var lookup = LookupOf(c);
            string cell;
            if (lookup is not null) cell = $"{{{{ {parentOf[lookup.ReferencedTable].NameMethod}({prop}) }}}}";
            else if (c.SqlType == SqlDbType.Bit) cell = $"{{{{ {prop} ? \"Yes\" : \"No\" }}}}";
            else if (IsDate(c)) cell = $"{{{{ {prop} | date:'MM/dd/yyyy' }}}}";
            else if (c.IsCurrencyColumn && !c.IsIntegerColumn) { int d = NumericClassifier.CurrencyDigits(c); cell = $"{{{{ {prop} | currency:'{Project.CurrencyCode}':'symbol':'1.{d}-{d}' }}}}"; }
            else if (c.SqlType is SqlDbType.Decimal or SqlDbType.Money or SqlDbType.SmallMoney) cell = $"{{{{ {prop} | number:'1.2-2' }}}}";
            else cell = $"{{{{ {prop} }}}}";
            H($"                <td>{cell}</td>");
        }
        H("                <td>");
        H($"                    <button (click)=\"edit({variable})\" class=\"btn-action\">Edit</button>");
        if (canClone)
            H($"                    <button (click)=\"clone({variable}.{keyProp}!)\" class=\"btn-action\">Clone</button>");
        H($"                    <button (click)=\"delete({variable}.{keyProp}!)\" class=\"btn-action delete\">Delete</button>");
        H("                </td>");
        H("            </tr>");
        H("        </tbody>");
        H("    </table>");
        H("    <ul *ngIf=\"sortMenu\" class=\"sort-menu\" role=\"menu\" [style.left.px]=\"sortMenu.x\" [style.top.px]=\"sortMenu.y\">");
        H("        <li role=\"none\"><button type=\"button\" role=\"menuitem\" [disabled]=\"!sort\" (click)=\"clearSort()\">Clear sort</button></li>");
        H("    </ul>");
        H();
        H("    <mat-paginator");
        H("        [length]=\"totalCount\"");
        H("        [pageSize]=\"pageSize\"");
        H("        [pageIndex]=\"pageIndex\"");
        H("        (page)=\"onPageChange($event)\">");
        H("    </mat-paginator>");
        H();
        H("    <!-- Add/Edit Form -->");
        // The add/edit form is a modal <dialog> (native, no library): it opens over the page, wherever the grid is scrolled to, and Escape cancels it.
        H("    <dialog *ngIf=\"selectedRow\" #editDialog class=\"form-container\" (cancel)=\"$event.preventDefault(); cancel()\">");
        H($"        <h2>{{{{selectedRow.{keyProp} ? 'Edit' : 'Add'}}}} {title}</h2>");
        H($"        <form id=\"{variable}Form\" (ngSubmit)=\"submit(selectedRow)\">");
        if (tabbed)
        {
            H("            <div role=\"tablist\" class=\"form-tabs\">");
            for (int i = 0; i < formPages.Count; i++)
                H($"                <button type=\"button\" role=\"tab\" [attr.aria-selected]=\"activeTab === {i}\" [style.font-weight]=\"activeTab === {i} ? 'bold' : 'normal'\" (click)=\"activeTab = {i}\">{formPages[i].Header.Replace("&", "&amp;")}</button>");
            H("            </div>");
        }
        for (int pageIndex = 0; pageIndex < formPages.Count; pageIndex++)
        {
        if (tabbed) H($"            <div role=\"tabpanel\" [hidden]=\"activeTab !== {pageIndex}\">");
        foreach (var c in formPages[pageIndex].Columns)
        {
            string id = Id(c);
            string model = $"selectedRow.{Camel(c.Name)}";
            string req = c.IsNullable ? "" : " required";
            var lookup = LookupOf(c);
            H("            <div class=\"form-group\">");
            H($"                <label for=\"{id}\">{LabelOf(c)}</label>");
            if (lookup is not null)
            {
                var p = parentOf[lookup.ReferencedTable];
                H($"                <select id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{req}>");
                if (c.IsNullable) H("                    <option [ngValue]=\"null\"></option>");
                H($"                    <option *ngFor=\"let p of {p.List}\" [ngValue]=\"p.{p.KeyProp}\">{{{{p.{p.DisplayProp}}}}}</option>");
                H("                </select>");
            }
            else if (c.HasChoices)
            {
                // A column whose values the database lists (a MySQL enum) is a drop-down of them.
                H($"                <select id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{req}>");
                H(c.IsNullable ? "                    <option [ngValue]=\"null\"></option>" : "                    <option value=\"\"></option>");
                foreach (string choice in c.Choices!)
                    H($"                    <option value=\"{ChoiceFormat.Html(choice)}\">{ChoiceFormat.Html(choice)}</option>");
                H("                </select>");
            }
            else if (c.SqlType == SqlDbType.Bit)
            {
                H($"                <input type=\"checkbox\" id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\">");
            }
            else if (IsDate(c))
            {
                // A nullable date has a Clear button on the same line, like WinUI3's calendar.
                if (c.IsNullable) H("                <div class=\"date-with-clear\">");
                H($"                <input type=\"date\" id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{req}>");
                if (c.IsNullable)
                {
                    H($"                <button type=\"button\" class=\"btn-action\" (click)=\"{model} = undefined\">Clear</button>");
                    H("                </div>");
                }
            }
            else if (IsNumber(c))
            {
                string step = c.SqlType is SqlDbType.Decimal && (c.Scale ?? 0) > 0 ? " step=\"" + "0." + new string('0', c.Scale!.Value - 1) + "1\""
                            : c.SqlType is SqlDbType.Money or SqlDbType.SmallMoney ? " step=\"0.01\""
                            : c.SqlType is SqlDbType.Float or SqlDbType.Real ? " step=\"any\"" : "";
                // A whole-number column carries the limits its name and SQL type imply (a month 1-12, a year MinYear-MaxYear, ...).
                string range = Project.RangeFor(c) is { } r ? $" min=\"{r.Min}\" max=\"{r.Max}\""
                    : IsPlainDecimal(c) ? $" min=\"{Inv(NumericClassifier.DecimalRange(c).Min)}\" max=\"{Inv(NumericClassifier.DecimalRange(c).Max)}\""
                    : c.IsCurrencyColumn && !c.IsIntegerColumn && Project.IsNonNegative(Model.TableName, c.Name) ? " min=\"0\"" : "";
                H($"                <input type=\"number\" id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{step}{range} placeholder=\"{PlaceholderFor(c)}\"{req}>");
            }
            else if (IsMultiline(c))
            {
                H($"                <textarea id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\" maxlength=\"{Chars(c)}\" placeholder=\"{PlaceholderFor(c)}\"{req}></textarea>");
            }
            else
            {
                string max = IsText(c) && Chars(c) > 0 ? $" maxlength=\"{Chars(c)}\"" : "";
                H($"                <input type=\"text\" id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{max} placeholder=\"{PlaceholderFor(c)}\"{req}>");
            }
            H("            </div>");
        }
        if (tabbed) H("            </div>");
        }
        H();
        H("            <button type=\"submit\" class=\"btn\">Submit</button>");
        H("            <button type=\"button\" (click)=\"cancel()\" class=\"btn btn-outline\">Cancel</button>");
        H("        </form>");
        H("    </dialog>");
        H("</div>");
        H("</div>");
        H("</div>");
        H("</main>");

        // ================= spec
        string cls = baseName + "Component";
        spec.Append("import { ComponentFixture, TestBed } from '@angular/core/testing';\nimport { provideHttpClient } from '@angular/common/http';\nimport { provideHttpClientTesting } from '@angular/common/http/testing';\nimport { provideRouter } from '@angular/router';\nimport { provideNoopAnimations } from '@angular/platform-browser/animations';\n");
        spec.Append("\n");
        spec.Append($"import {{ {cls} }} from './{stem}.component';\n\n");
        spec.Append($"describe('{cls}', () => {{\n  let component: {cls};\n  let fixture: ComponentFixture<{cls}>;\n\n");
        // the screen's service needs an HttpClient; the testing one never touches the network. mat-paginator
        // needs animations provided (even as the no-op stub) or TestBed throws.
        spec.Append($"  beforeEach(async () => {{\n    await TestBed.configureTestingModule({{\n      imports: [{cls}],\n      providers: [provideHttpClient(), provideHttpClientTesting(), provideNoopAnimations(), provideRouter([])]\n    }})\n    .compileComponents();\n\n");
        spec.Append($"    fixture = TestBed.createComponent({cls});\n    component = fixture.componentInstance;\n    fixture.detectChanges();\n  }});\n\n");
        spec.Append("  it('should create', () => {\n    expect(component).toBeTruthy();\n  });\n});\n");

        // ================= ts
        T("import { ChangeDetectionStrategy, Component, ElementRef, HostListener, ViewChild } from '@angular/core';");
        T("import { GridSort, loadSort, nextSort, saveSort } from '../../grid-sort';");
        T("import { ActivatedRoute, Router } from '@angular/router';");
        T($"import {{ {baseName} }} from '../../{modelsFolder}/{stem}';");
        T($"import {{ {baseName}Service }} from '../../{servicesFolder}/{stem}.service';");
        foreach (var p in parents.Where(p => !p.Self))
        {
            T($"import {{ {p.Type} }} from '../../{modelsFolder}/{p.ModelFile}';");
            T($"import {{ {p.Service} }} from '../../{servicesFolder}/{p.ServiceFile}';");
        }
        T("import { CommonModule } from '@angular/common';");
        T("import { FormsModule } from '@angular/forms';");
        T("import { MatPaginatorModule, PageEvent } from '@angular/material/paginator';");
        T();
        T("@Component({");
        T($"  selector: 'app-{stem}',");
        if (Project.AngularStandaloneFlag) T("  standalone: true,");
        T($"  changeDetection: ChangeDetectionStrategy.{Project.AngularEagerStrategy}, // plain properties change inside subscribe callbacks: keep eager checking when OnPush is the default (Angular 22)");
        T("  imports: [ CommonModule, FormsModule, MatPaginatorModule ],");
        T($"  templateUrl: './{stem}.component.html',");
        T($"  styleUrl: './{stem}.component.css'");
        T("})");
        T($"export class {cls} {{");
        T($"  {listName}: {baseName}[] = [];");
        foreach (var p in parents.Where(p => !p.Self))
            T($"  {p.List}: {p.Type}[] = [];");
        T($"  selectedRow: {baseName} | null = null;");
        if (tabbed) T("  activeTab = 0; // the form tab showing");
        T("  // The edit form is a modal <dialog> that is only in the page while a row is being edited: open it as soon as it is rendered.");
        T("  @ViewChild('editDialog') set editDialog(element: ElementRef<HTMLDialogElement> | undefined) {");
        T("    if (element && !element.nativeElement.open) element.nativeElement.showModal();");
        T("  }");
        T("  private backTo: string | null = null; // set when another page's grid opened this row (?edit=<id>&back=<that page>)");
        if (canSearch) T($"  filters = {{ {string.Join(", ", searchFields.Select(f => $"{f.ParamName}: ''"))} }};");
        T($"  pageSize = {pageSize};");
        T("  pageIndex = 0;"); // mat-paginator is 0-based; the API's pageNumber is 1-based
        T("  totalCount = 0;");
        T($"  readonly gridKey = '{stem}'; // the grid's saved sort is kept in the browser under this key (see grid-sort.ts)");
        T($"  readonly sortableColumns = [{string.Join(", ", sortableColumns.Select(c => "'" + c.Name + "'"))}]; // the columns whose header sorts the grid");
        T("  sort: GridSort | null = loadSort(this.gridKey, this.sortableColumns);");
        T("  sortMenu: { x: number; y: number } | null = null; // the right-click menu (Clear sort), where it is open");
        T();
        var ctorArgs = new List<string> { $"private {variable}Service: {baseName}Service" };
        ctorArgs.AddRange(parents.Where(p => !p.Self).Select(p => $"private {p.ServiceVar}: {p.Service}"));
        ctorArgs.Add("private router: Router");
        ctorArgs.Add("private route: ActivatedRoute");
        T($"  constructor({string.Join(", ", ctorArgs)}) {{ }}");
        T();
        T("  ngOnInit(): void {");
        T("    // Opened from another page's grid (?edit=<id>&back=<that page>): open this row, and go back to that page when the form is saved or cancelled.");
        T("    const params = this.route.snapshot.queryParamMap;");
        T("    this.backTo = params.get('back');");
        T("    const openId = params.get('edit');");
        T($"    if (openId) this.{variable}Service.getById({(keyColumn.SqlType == SqlDbType.Int ? "Number(openId)" : "openId")}).subscribe((row) => this.edit(row));");
        T("    this.load();");
        foreach (var p in parents.Where(p => !p.Self))
            T($"    this.{p.ServiceVar}.getAll().subscribe((data) => {{ this.{p.List} = data; }});");
        T("  }");
        T();
        {
            string filterArgs = string.Concat(searchFields.Select(f => $", this.filters.{f.ParamName}"));
            T("  private load(): void {");
            T($"    this.{variable}Service.getPage(this.pageIndex + 1, this.pageSize{filterArgs}, this.sort?.column, this.sort?.descending).subscribe((result) => {{");
            T($"      this.{listName} = result.items;");
            T("      this.totalCount = result.totalCount;");
            T("    });");
            T("  }");
            T();
            T("  onPageChange(event: PageEvent): void {");
            T("    this.pageIndex = event.pageIndex;");
            T("    this.load();");
            T("  }");
            // Click a column header to sort by it, click it again to flip the direction; the right-click menu clears the sort. The sort is saved (grid-sort.ts),
            // kept when paging and when the filters change, and applied by the server; a change goes back to page 1.
            T();
            T("  sortBy(column: string): void {");
            T("    this.sort = nextSort(this.sort, column);");
            T("    saveSort(this.gridKey, this.sort);");
            T("    this.pageIndex = 0;");
            T("    this.load();");
            T("  }");
            T();
            T("  clearSort(): void {");
            T("    this.sort = null;");
            T("    saveSort(this.gridKey, null);");
            T("    this.sortMenu = null;");
            T("    this.pageIndex = 0;");
            T("    this.load();");
            T("  }");
            T();
            T("  openSortMenu(event: MouseEvent): void {");
            T("    event.preventDefault();");
            T("    this.sortMenu = { x: event.clientX, y: event.clientY };");
            T("  }");
            T();
            T("  @HostListener('document:click')");
            T("  @HostListener('document:keydown.escape')");
            T("  closeSortMenu(): void {");
            T("    this.sortMenu = null;");
            T("  }");
            T();
            T("  sortMark(column: string): string {");
            T("    return this.sort?.column === column ? (this.sort.descending ? ' \\u25BC' : ' \\u25B2') : '';");
            T("  }");
            T();
            T("  ariaSort(column: string): 'ascending' | 'descending' | null {");
            T("    return this.sort?.column === column ? (this.sort.descending ? 'descending' : 'ascending') : null;");
            T("  }");
        }
        T();
        T($"  submit({variable}: {baseName}): void {{");
        T($"    if ({variable}.{keyProp}) {{");
        T($"      this.{variable}Service.update({variable}.{keyProp}, {variable}).subscribe({{");
        T("        next: () => {");
        T("          console.log(\"Updated successfully!\");");
        T("          this.load();");
        T("          this.goBack();");
        T("        },");
        T("        error: (error) => this.showError(\"updating\", error)");
        T("      });");
        T("    }");
        T("    else {");
        T($"      {variable}.{keyProp} = {emptyKey};");
        T($"      this.{variable}Service.create({variable}).subscribe({{");
        T("        next: () => { this.load(); this.goBack(); },");
        T("        error: (error) => this.showError(\"adding\", error)");
        T("      });");
        T("    }");
        T("    this.selectedRow = null;");
        T("  }");
        T();
        T($"  delete(id: {keyTs}): void {{");
        T("    if (confirm(\"Are you sure you want to delete this?\")) {");
        T($"      this.{variable}Service.delete(id).subscribe({{");
        T("        next: () => {");
        T("          console.log(\"Deleted successfully!\");");
        T($"          this.{listName} = this.{listName}.filter((p) => p.{keyProp} !== id);");
        T("        },");
        T("        error: (error) => {");
        T("          if (error.status == 400) { alert(\"It cannot be deleted because it is in use!\"); }");
        T("          else if (error.status == 404) { alert(\"It no longer exists!\"); this.load(); }");
        T("          else { alert(\"Problem while deleting! \" + error.message); }");
        T("        }");
        T("      });");
        T("    }");
        T("  }");
        if (canClone)
        {
            // Clone copies the row on the server and returns the copy: it is in the grid, and open in the form at once so the person changes what differs.
            T();
            T($"  clone(id: {keyTs}): void {{");
            T($"    this.{variable}Service.clone(id).subscribe({{");
            T("      next: (copy) => {");
            T("        this.load();");
            T("        this.edit(copy);");
            T("      },");
            T("      error: (error) => {");
            T("        if (error.status == 404) { alert(\"It no longer exists!\"); this.load(); }");
            T("        else { alert(\"Problem while cloning! \" + error.message); }");
            T("      }");
            T("    });");
            T("  }");
        }
        T();
        // add(): every required property gets a starting value
        var adds = new List<string>();
        foreach (var c in Model.Columns.Where(c => !c.IsPrimaryKey && !c.IsNullable && !c.IsComputed && !c.IsIdentity))
        {
            string value;
            if (c.SqlType == SqlDbType.Bit) value = c.DatabaseDefaultSql is not null && c.DatabaseDefaultSql.Trim('(', ')', ' ') == "1" ? "true" : "false";
            else if (IsDate(c)) value = "new Date().toISOString().substring(0, 10)";
            else if (IsNumber(c)) value = "0";
            else value = "''";
            adds.Add($"{Camel(c.Name)}: {value}");
        }
        T("  add(): void {");
        if (tabbed) T("    this.activeTab = 0;");
        T(adds.Count == 0 ? "    this.selectedRow = { };" : $"    this.selectedRow = {{ {string.Join(", ", adds)} }};");
        T("  }");
        T();
        T($"  edit({variable}: {baseName}): void {{");
        if (tabbed) T("    this.activeTab = 0;");
        T($"    this.selectedRow = {{ ...{variable} }};");
        var dateColumns = shown.Where(IsDate).ToList();
        if (dateColumns.Count > 0)
        {
            T("    // the date box wants yyyy-MM-dd; the API sends a full timestamp");
            foreach (var c in dateColumns)
            {
                string prop = $"this.selectedRow.{Camel(c.Name)}";
                if (c.IsNullable) T($"    if ({prop}) {{ {prop} = {prop}.substring(0, 10); }}");
                else T($"    {prop} = {prop}.substring(0, 10);");
            }
        }
        T("  }");
        T();
        T("  cancel(): void {");
        T("    this.selectedRow = null;");
        T("    this.goBack();");
        T("  }");
        T();
        T("  // Back to the page whose grid opened this row, if any.");
        T("  private goBack(): void {");
        T("    if (this.backTo) this.router.navigateByUrl(this.backTo);");
        T("  }");
        if (canSearch)
        {
            T();
            T("  search(): void {");
            T("    this.selectedRow = null;");
            T("    this.pageIndex = 0;");
            T("    this.load();");
            T("  }");
            T();
            T("  clearSearch(): void {");
            foreach (var f in searchFields)
                T($"    this.filters.{f.ParamName} = '';");
            T("    this.pageIndex = 0;");
            T("    this.load();");
            T("  }");
        }
        foreach (var p in parents)
        {
            T();
            T($"  // the name to show in place of a {p.Type} id");
            T($"  {p.NameMethod}(id?: {p.IdType}): string {{");
            T($"    return this.{p.List}.find((p) => p.{p.KeyProp} === id)?.{p.DisplayProp} ?? '';");
            T("  }");
        }
        T();
        T("  private showError(action: string, error: any): void {");
        T($"    if (error.status == 400) {{ alert(\"{(hasName ? "Name is bad or has special characters!" : "Some of the values are not acceptable!")}\"); }}");
        T($"    else if (error.status == 404) {{ alert(\"This {Words(baseName).ToLowerInvariant()} no longer exists!\"); this.load(); }}");
        T("    else { alert(\"Problem while \" + action + \"! \" + error.message); }");
        T("  }");
        T("}");

        var o = new StringBuilder();
        o.Append($"@@@FILE {componentsFolder}/{stem}/{stem}.component.css@@@\n").Append(GridSortStyles.Css);
        o.Append($"@@@FILE {componentsFolder}/{stem}/{stem}.component.html@@@\n").Append(Project.AdaptAngularHtml(html.ToString()));
        o.Append($"@@@FILE {componentsFolder}/{stem}/{stem}.component.spec.ts@@@\n").Append(Project.AdaptAngularSpec(spec.ToString()));
        o.Append($"@@@FILE {componentsFolder}/{stem}/{stem}.component.ts@@@\n").Append(ts);
        Write(o.ToString());
    }
#>
