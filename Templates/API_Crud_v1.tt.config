# Restriction checkboxes for API_Crud_v1.tt (see Docs/Reference.md section 3).
# The routes are keyed by the primary key ({id:int}), so one is required and must be a single int column.
RequiresPrimaryKey=true
TableOnly=true
RequiredPrimaryKeyShape=SingleInt
# Name the generated file like the existing hand-kept API files: E_DonateLeave -> E_DonateLeaveApi.cs
OutputName={Table}Api.cs
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Api
PlanTables=AspNetApi
OutputFolder=Apis
