# Restriction checkboxes for API_Crud_v1.tt (see Docs/specs.md section 5.3).
# The routes are keyed by the primary key ({id:int}), so one is required; the template itself further insists on a single int key.
RequiresPrimaryKey=true
TableOnly=true
# Name the generated file like the existing hand-kept API files: E_DonateLeave -> E_DonateLeaveApi.cs
OutputName={Table}Api.cs
