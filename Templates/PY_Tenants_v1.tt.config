# Restriction checkboxes for PY_Tenants_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# The template writes its own path (app/routes/tenancy.py) with an @@@FILE marker.
OutputName=app/routes/tenancy.py
# Whole-project generation (codegen generate): written only for a project with TenantTable and ApiAuth.
Stacks=Python
InPlan=false
