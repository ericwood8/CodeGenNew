# Restriction checkboxes for RS_Routes_v1.tt (see Docs/Reference.md section 3).
# The routes are keyed by the primary key, so one single-column int key is required.
RequiresPrimaryKey=true
TableOnly=true
RequiredPrimaryKeyShape=SingleInt
# A name/active table's repository is hand-maintained; it gets no generated API.
RequiresNotNameActiveTable=true
# The repository sorts a foreign key by its parent's display column and the clone needs the table's columns, so ask for the parents' display columns.
NeedsReferencedDisplayColumns=true
# The Rust stack reads PostgreSQL, MySQL and SQLite through sqlx; SQL Server is not supported.
Dialects=PostgreSql,MySql,Sqlite
# No OutputName: the template writes its own path (src/routes/<table>.rs) with an @@@FILE marker.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Rust
PlanTables=Api
