<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // UNO_Usage_v1.tt
    // Generates: Views/<Table>SummaryPage.xaml and Views/<Table>SummaryPage.xaml.cs for every table of UsageTables   (the template writes its own paths with @@@FILE markers)
    // The usage page of an Uno app that signs in (Auth=true, ApiAuth, UsageTables with TenantTable), for the administrator: the months and kinds the API adds up, with a filter on the kind.
    // The text is UsageDesktopCode in Core. UNO_Screens lists the page.
    // Full notes: Docs/TemplateNotes/API_Usage_v1.md
    // ==========================================================================================
    string servicesNamespace = UnoNames.ServicesNamespace(Project);
    string viewNamespace = Project.ViewNamespace ?? Project.AppNamespace + ".Views";
    foreach (var page in UsageScreens.Pages(Database, Project))
    {
#>
@@@FILE Views/<#= page.PageClass #>.xaml@@@
<#= UsageDesktopCode.Xaml(viewNamespace, page) #>
@@@FILE Views/<#= page.PageClass #>.xaml.cs@@@
<#= UsageDesktopCode.UnoPage(viewNamespace, servicesNamespace, page) #>
<#
    }
#>
