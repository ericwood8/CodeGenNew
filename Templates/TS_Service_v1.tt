<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    // Folders under the Angular app root (where -o points) that the generated files go in.
    string servicesFolder = Project.ServicesFolder;
    string modelsFolder = Project.ModelsFolder;
    string apiPrefix = "api";
    // Tables that have no API (C# enums, other *Type lookup tables, tables with no entity): no service is written for them.
    string[] noApiTables =
    {
        "ClearanceType", "ExpenseType", "LeaveType", "OvertimeType", "SY_RequestStatusType", "SY_RequestType",
        "SY_ResponseType", "SY_Role", "SY_Display", "SY_ISOCountry", "SY_PerDiem", "sysdiagrams"
    };
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    // With a project chosen, which tables count as enums (no entity/repository/API of their own) comes from the project's
    // EnumTables, else from what the schema says about each table (LookupShape) - not from the lists above, which are
    // only used when no project is chosen.
    bool NoApi(string table, LookupShape shape) => Project.NoApi(table, shape) ?? noApiTables.Contains(table, StringComparer.OrdinalIgnoreCase);
    // ==========================================================================================

    // ==========================================================================================
    // TS_Service_v1.tt
    // Generates: services/<table>.service.ts   (an Angular injectable; the path is written by the template, point the output folder at src/app)
    // The HttpClient wrapper for one table's API with the same method names on every service (getAll, getPage, getById, create, update, delete,
    // findByName for a table with a Name column, clone for a cloneable table), so a component never has to remember which one a table uses.
    // Imports the model from models/<table>. Folder names come from the project's ServicesFolder and ModelsFolder.
    // Full notes: Docs/TemplateNotes/TS_Service_v1.md
    // ==========================================================================================

    string Words(string s) => System.Text.RegularExpressions.Regex.Replace(s, "(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])", " ");

    var keyColumn = Model.PrimaryKeyColumns.Count == 1 ? Model.PrimaryKeyColumns[0] : null;
    if (NoApi(Model.TableName, Model.LookupShape))
    {
        Error($"TS_Service writes no service for [{Model.SchemaName}].[{Model.TableName}]: it is listed in noApiTables (an enum, a *Type lookup table, or a table with no entity class), so it has no API to call.");
    }
    else if (keyColumn is null || !(keyColumn.IsInt32Column || keyColumn.IsGuidColumn))
    {
        Error($"TS_Service needs a table with a single int or uniqueidentifier primary key (the routes take the id as {{id:int}} or {{id:guid}}), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else if (Model.IsNameActiveTable)
    {
        Error($"TS_Service assumes a plain getAll()-style API. [{Model.SchemaName}].[{Model.TableName}] has a Name and an IsActive column, so its repository is a NameActiveRepo and its real API is always hand-maintained (and commonly has no plain getAll() at all); write this service by hand.");
    }
    else
    {
        string baseName = BaseName(Model.TableName);
        string keyTs = keyColumn.IsInt32Column ? "number" : "string";   // a uniqueidentifier key travels as a string
        string stem = baseName.ToLowerInvariant();
        string variable = LowerFirst(baseName);
        string lowerWords = Words(baseName).ToLowerInvariant();
        bool hasName = Model.Columns.Any(c => c.IsStringColumn && c.Name == "Name");
        // Pagination: getPage always exists, once SP_Search.tt/API_Search.tt do; pagination and searchability are separate concerns.
        // Search: filters is simply empty for a table with no searchable column.
        var filters = Model.SearchableColumns.Select(c => new { ParamName = LowerFirst(c.Name), c.Name }).ToList();

        var o = new StringBuilder();
        void L(string s = "") => o.Append(s).Append('\n');

        L($"@@@FILE {servicesFolder}/{stem}.service.ts@@@");
        L("import { Injectable } from '@angular/core';");
        L("import { HttpClient, HttpParams } from '@angular/common/http';");
        L("import { Observable } from 'rxjs';");
        L($"import {{ {baseName} }} from '../{modelsFolder}/{stem}';");
        L();
        L($"export interface {baseName}PagedResult {{");
        L($"    items: {baseName}[];");
        L("    page: number;");
        L("    pageSize: number;");
        L("    totalCount: number;");
        L("    totalPages: number;");
        L("}");
        L();
        L("@Injectable({");
        L("    providedIn: 'root',");
        L("})");
        L($"export class {baseName}Service {{");
        L($"    private apiUrl = '{apiPrefix}/{stem.Pluralize()}'; // Replace with your API URL");
        L();
        L("    constructor(private http: HttpClient) { }");
        L();
        L($"    // Get all {lowerWords.Pluralize()}");
        L($"    getAll(): Observable<{baseName}[]> {{");
        L($"        return this.http.get<{baseName}[]>(this.apiUrl);");
        L("    }");
        L();
        L($"    // Get a {lowerWords} by ID");
        L($"    getById(id: {keyTs}): Observable<{baseName}> {{");
        L($"        return this.http.get<{baseName}>(`${{this.apiUrl}}/${{id}}`);");
        L("    }");
        L();
        L($"    // Create a new {lowerWords}");
        L($"    create({variable}: {baseName}): Observable<{baseName}> {{");
        L($"        return this.http.post<{baseName}>(this.apiUrl, {variable});");
        L("    }");
        L();
        L($"    // Update a {lowerWords}");
        L($"    update(id: {keyTs}, {variable}: {baseName}): Observable<{baseName}> {{");
        L($"        return this.http.put<{baseName}>(`${{this.apiUrl}}/${{id}}`, {variable});");
        L("    }");
        L();
        L($"    // Delete a {lowerWords}");
        L($"    delete(id: {keyTs}): Observable<void> {{");
        L("        return this.http.delete<void>(`${this.apiUrl}/${id}`);");
        L("    }");
        // clone(id): copy a row into a new one and get the copy back (POST api/<route>/{id}/clone, API_Crud); only for the tables CloneShape says can be cloned.
        if (CloneShape.CanClone(Model, Project))
        {
            L();
            L($"    // Copy a {lowerWords} into a new one and return the copy");
            L($"    clone(id: {keyTs}): Observable<{baseName}> {{");
            L($"        return this.http.post<{baseName}>(`${{this.apiUrl}}/${{id}}/clone`, null);");
            L("    }");
        }
        if (hasName)
        {
            L();
            L("    // Find by Name");
            L($"    findByName(name: string): Observable<{baseName}[]> {{");
            L($"        return this.http.get<{baseName}[]>(`${{this.apiUrl}}/${{name}}`);");
            L("    }");
        }
        {
            string filterParams = string.Concat(filters.Select(f => $", {f.ParamName}?: string"));
            L();
            L($"    // Get one page of {lowerWords.Pluralize()}, optionally filtered by any combination of the searchable columns");
            // sortBy / sortDescending: the grid's chosen sort (a column name, "asc" or "desc"); left out of the request when there is none (the default order).
            L($"    getPage(pageNumber: number, pageSize: number{filterParams}, sortBy?: string, sortDescending?: boolean): Observable<{baseName}PagedResult> {{");
            L("        let params = new HttpParams().set('pageNumber', pageNumber).set('pageSize', pageSize);");
            foreach (var f in filters)
                L($"        if ({f.ParamName}) {{ params = params.set('{f.ParamName}', {f.ParamName}); }}");
            L("        if (sortBy) { params = params.set('sortBy', sortBy).set('sortDir', sortDescending ? 'desc' : 'asc'); }");
            L($"        return this.http.get<{baseName}PagedResult>(`${{this.apiUrl}}/search`, {{ params }});");
            L("    }");
        }
        L("}");
        Write(o.ToString());
    }
#>
