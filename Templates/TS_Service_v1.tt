<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    // Folders under the Angular app root (where -o points) that the generated files go in.
    string servicesFolder = Project.ServicesFolder;
    string modelsFolder = Project.ModelsFolder;
    string apiPrefix = "api";
    // ==========================================================================================

    // ==========================================================================================
    // TS_Service_v1.tt
    // Generates: services/<table>.service.ts   (an Angular injectable; the path is written by the template, point the output folder at src/app)
    // A short class on CrudService / NamedCrudService (services/crud.service.ts, written by TS_EssentialCrud): the route, and getPage with the table's own search boxes as typed parameters.
    // The calls every service has (getAll, getById, create, update, delete, clone, searchPage, and findByName for a table with a Name column) are the base's, so a component never has to remember which one a table uses.
    // A table with a Name and an IsActive column is on NameActiveCrudService (adds getAllActive, GET <route>/active) and has no getPage: its API (NameActiveCrudApi) answers the whole list.
    // Imports the model from models/<table>. Folder names come from the project's ServicesFolder and ModelsFolder.
    // Full notes: Docs/TemplateNotes/TS_Service_v1.md
    // ==========================================================================================


    var keyColumn = Model.PrimaryKeyColumns.Count == 1 ? Model.PrimaryKeyColumns[0] : null;
    var keyType = KeyType.Of(Model);   // how the key travels: a number, or a string for a uniqueidentifier or a text key
    if (Project.NoApiFor(Model.TableName, Model.LookupShape))
    {
        Error($"TS_Service writes no service for [{Model.SchemaName}].[{Model.TableName}]: it is an enum or excluded by the NoApiTables setting (an enum, a *Type lookup table, or a table with no entity class), so it has no API to call.");
    }
    else if (keyColumn is null || keyType is null)
    {
        Error($"TS_Service needs a table with a single int, uniqueidentifier or text primary key (the routes take the id as {{id:int}}, {{id:guid}} or {{id}}), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else
    {
        string baseName = BaseName(Model.TableName);
        string keyTs = keyType.TypeScript;
        string stem = baseName.ToLowerInvariant();
        string variable = LowerFirst(baseName);
        string lowerWords = Labels.Words(baseName).ToLowerInvariant();
        // Pagination: getPage always exists, once SP_Search.tt/API_Search.tt do; pagination and searchability are separate concerns.
        // Search: filters is simply empty for a table with no searchable column.
        // The Search list protocol (ListProtocol=Search) has one search box for the whole table; the server decides which columns it matches.
        var filters = Project.ListSearchProtocol
            ? new[] { new { ParamName = "search", Name = "search" } }.ToList()
            : Model.SearchableColumns.Concat(Model.SearchKeyColumns.Where(c => c.IsStringColumn)).OrderBy(c => c.OrdinalPosition).Select(c => new { ParamName = LowerFirst(c.Name), c.Name }).ToList();
        // a table in LogTables also takes the first and the last day of the rows to list
        if (!Project.ListSearchProtocol && LogTablePlan.For(Model, Project) is not null)
            filters.AddRange(new[] { new { ParamName = LogTable.FromParameter, Name = LogTable.FromParameter }, new { ParamName = LogTable.ToParameter, Name = LogTable.ToParameter } });

        var o = new StringBuilder();
        void L(string s = "") => o.Append(s).Append('\n');

        // The five calls, clone and the page request are crud.service.ts's (TS_EssentialCrud); this class names the route and keeps the typed calls that are the table's own.
        bool nameActive = Model.IsNameActiveTable;
        string serviceBase = nameActive ? "NameActiveCrudService" : Model.CanFindByName ? "NamedCrudService" : "CrudService";
        string baseClass = serviceBase + "<" + baseName + (keyType.Kind == KeyKind.Int ? "" : ", " + keyTs) + ">";
        L($"@@@FILE {servicesFolder}/{stem}.service.ts@@@");
        L("import { Injectable } from '@angular/core';");
        L("import { HttpClient } from '@angular/common/http';");
        bool guarded = GatePlan.GuardsOf(Project, Model).Count > 0;
        if (!Model.IsNameActiveTable || guarded) L("import { Observable } from 'rxjs';");
        L($"import {{ {baseName} }} from '../{modelsFolder}/{stem}';");
        L(nameActive ? $"import {{ {serviceBase} }} from './crud.service';" : $"import {{ {serviceBase}, PagedResult }} from './crud.service';");
        L();
        if (!nameActive)
        {
            L($"export type {baseName}PagedResult = PagedResult<{baseName}>;");
            L();
        }
        var queue = QueuePlan.For(Model, Project);
        if (queue is not null)
        {
            L("export interface QueueStats {");
            L("    pending: number;");
            L("    claimed: number;");
            L("    done: number;");
            L("    failed: number;");
            L($"    oldestPendingId?: {keyTs} | null;");
            L("    oldestPendingOn?: string | null;");
            L("}");
            L();
        }
        L("@Injectable({");
        L("    providedIn: 'root',");
        L("})");
        L($"export class {baseName}Service extends {baseClass} {{");
        L("    constructor(http: HttpClient) {");
        L($"        super(http, '{apiPrefix}/{stem.Pluralize()}'); // Replace with your API URL");
        L("    }");
        if (!nameActive)
        {
            string filterParams = string.Concat(filters.Select(f => $", {f.ParamName}?: string"));
            L();
            L($"    // Get one page of {lowerWords.Pluralize()}, optionally filtered by any combination of the searchable columns");
            // sortBy / sortDescending: the grid's chosen sort (a column name, "asc" or "desc"); left out of the request when there is none (the default order).
            L($"    getPage(pageNumber: number, pageSize: number{filterParams}, sortBy?: string, sortDescending?: boolean): Observable<{baseName}PagedResult> {{");
            L($"        return this.searchPage({{ pageNumber, pageSize, filters: {{ {string.Join(", ", filters.Select(f => f.ParamName))} }}, sortBy, sortDescending }});".Replace("{  }", "{}"));
            L("    }");
        }
        if (queue is not null)
        {
            L();
            L("    // a work queue: the counts by status with the oldest pending row, and a failed row put back to pending (QueueTables)");
            L("    getQueueStats(): Observable<QueueStats> {");
            L("        return this.http.get<QueueStats>(`${this.apiUrl}/stats`);");
            L("    }");
            L();
            L($"    retry(id: {keyTs}): Observable<{baseName}> {{");
            L($"        return this.http.post<{baseName}>(`${{this.apiUrl}}/${{id}}/retry`, null);");
            L("    }");
        }
        if (guarded)
        {
            L();
            L("    // Which guarded columns the signed-in person may change (the screen shows the others as text), by the column's JSON name");
            L("    getGuards(): Observable<Record<string, boolean>> {");
            L("        return this.http.get<Record<string, boolean>>(`${this.apiUrl}/guards`);");
            L("    }");
        }
        L("}");
        Write(o.ToString());
    }
#>
