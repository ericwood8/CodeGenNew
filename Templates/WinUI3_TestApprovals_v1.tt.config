# Restriction checkboxes for WinUI3_TestApprovals_v1.tt (see Docs/Reference.md section 3).
# One run for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
OutputName=ApprovalServiceTests.cs
# Whole-project generation (codegen generate): for a project that sets DesktopTests=true and RowApprovals (or names the template in PlanAlso). The file goes to the test project, not the app.
Stacks=WinUI3
OutputRoot=WinUI3Tests
InPlan=false
