# Restriction checkboxes for FS_Rop_v1.tt (see Docs/Reference.md section 3).
# One file for the whole project: no table and no database, only the project settings. Run it by hand: codegen -T FS_Rop.tt --project <name> -o <folder>
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
# No OutputName: the template writes its own path (Rop.fs) with an @@@FILE marker.
