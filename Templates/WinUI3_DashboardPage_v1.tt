<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, folders).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string viewNamespace = "MyApp.Desktop.Views";
    string contextType = "MyAppContext";
    string contextNamespace = "MyApp.Common.Data";
    string repositoryNamespace = "MyApp.Common.Repositories";
    string[] usings = { };
    string viewsFolder = "Views";   // under the WinUI3 project root (where -o points)
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    viewNamespace = Project.ViewNamespace ?? viewNamespace;
    contextType = Project.ContextName ?? contextType;
    contextNamespace = Project.ContextNamespace ?? contextNamespace;
    repositoryNamespace = Project.RepoNamespace ?? repositoryNamespace;
    usings = Project.Usings ?? usings;
    viewsFolder = Project.ViewsFolder ?? viewsFolder;
    // ==========================================================================================

    // ==========================================================================================
    // WinUI3_DashboardPage_v1.tt
    // Generates: Views/DashboardWidgetViews.cs, Views/DashboardPage.cs and, with DashboardStrip=true, Views/DashboardStrip.cs
    // The dashboard page of the desktop app, built in code from what DashboardData (CS_Dashboard) returns, so one file draws every kind of widget: cards, bar lists, a sparkline and a list of
    // recent rows, with no chart package. Every chart has its numbers beside it as text. The page and the strip read the database through a context of their own, so a page still loading
    // when the person moves on never shares a context with the next screen. WinUI3_Screens adds the menu entry and, for the strip, puts it above each table's list page.
    // Full notes: Docs/TemplateNotes/WinUI3_DashboardPage_v1.md
    // ==========================================================================================

    bool strip = Project.DashboardStrip;
    string usingLines = string.Concat(usings.Select(u => $"using {u};\n"));
#>
@@@FILE <#= viewsFolder #>/DashboardWidgetViews.cs@@@
<#= DesktopDashboardCode.WidgetViews(viewNamespace, repositoryNamespace, "WinUI3_Screens", "DashboardData") #>@@@FILE <#= viewsFolder #>/DashboardPage.cs@@@
using System;
using System.Linq;
using <#= contextNamespace #>;
using <#= repositoryNamespace #>;
using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;
<#= usingLines #>
namespace <#= viewNamespace #>;

// The dashboard: cards first, then the lists and charts, each a widget of DashboardData. Refresh reads the database again.
public sealed class DashboardPage : Page
{
    private readonly Action<string>? _navigate;
    private readonly StackPanel _cards = new() { Orientation = Orientation.Horizontal, Spacing = 12 };
    private readonly ContentControl _others = new();
    private readonly TextBlock _message = new();

    public DashboardPage(Action<string>? navigate = null)
    {
        _navigate = navigate;
        var refresh = new Button { Content = "Refresh" };
        refresh.Click += async (_, _) => await LoadAsync();

        var cardScroller = new ScrollViewer { Content = _cards, HorizontalScrollBarVisibility = ScrollBarVisibility.Auto, VerticalScrollBarVisibility = ScrollBarVisibility.Disabled, HorizontalScrollMode = ScrollMode.Enabled };
        var panel = new StackPanel { Spacing = 12, Padding = new Thickness(16) };
        panel.Children.Add(new TextBlock { Text = "Dashboard", Style = (Style)Application.Current.Resources["TitleTextBlockStyle"] });
        panel.Children.Add(refresh);
        panel.Children.Add(_message);
        panel.Children.Add(cardScroller);
        panel.Children.Add(_others);
        Content = new ScrollViewer { Content = panel };

        Loaded += async (_, _) => await LoadAsync();
    }

    private async System.Threading.Tasks.Task LoadAsync()
    {
        _message.Text = "";
        try
        {
            using var context = new <#= contextType #>();
            var result = await DashboardData.LoadAsync(context);
            _cards.Children.Clear();
            foreach (var widget in result.Widgets.Where(DashboardWidgetViews.IsCard))
                _cards.Children.Add(DashboardWidgetViews.Build(widget, _navigate));

            var wrap = new VariableSizedWrapGrid { Orientation = Orientation.Horizontal, ItemWidth = 440 };
            foreach (var widget in result.Widgets.Where(w => !DashboardWidgetViews.IsCard(w)))
            {
                var view = DashboardWidgetViews.Build(widget, _navigate);
                if (widget.Kind == "recent")
                    VariableSizedWrapGrid.SetColumnSpan((FrameworkElement)view, 2);
                wrap.Children.Add(view);
            }
            _others.Content = wrap;
            if (result.Widgets.Count == 0)
                _message.Text = "The schema suggests nothing to show.";
        }
        catch (Exception ex)
        {
            _message.Text = "Failed to load the dashboard: " + ex.Message;
        }
    }
}
<#
    if (strip)
    {
#>
@@@FILE <#= viewsFolder #>/DashboardStrip.cs@@@
<#= DesktopDashboardCode.StripFile(viewNamespace, $"using {contextNamespace};\nusing {repositoryNamespace};\n", usingLines, "", "string table", "",
        $"            using var context = new {contextType}();\n            var result = await DashboardData.LoadAsync(context, _table);\n") #><#
    }
#>
