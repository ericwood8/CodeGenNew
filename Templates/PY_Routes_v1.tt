<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PY_Routes_v1.tt
    // Generates: app/routes/<table>.py   (the template writes its own path with an @@@FILE marker; the output folder is the Python API's folder)
    // The FastAPI router of a table with the contract every stack of the project keeps (so the React, Angular, Blazor and desktop front ends need no change): GET /api/<plural> (all rows), GET /{id},
    // POST (201 with a Location header and the new row), PUT /{id} (400 when the id in the body differs, 404 for no such row), DELETE /{id} (200, 404, or 400 when the row is in use),
    // POST /{id}/clone (201 and the copy, a cloneable table), GET /lookup ({ id, name, isActive } of every row, or with ids, search and take the rows a type-ahead asks for; a table with a display column) and GET /search with the filters, pageNumber, pageSize, sortBy and sortDir (a table with a search endpoint).
    // With ApiValidation=true the create and update routes run the table's validate (PY_Validate) and answer 400 with the problems.
    // With ApiAuth=true (the Jwt group's app/auth.py) a table listed in OwnedTables shows and changes only the rows of the owners the caller may act for (403 for another owner's row, the same
    // rule as the ASP.NET API), a table that hangs off an owned table is scoped through its parent, and the user table (UserTable) never shows or takes its password hash (PythonTable leaves it out of
    // the schema), lets only an administrator change the administrator and role columns (403), keeps a sign-in name unique (409) and keeps the last administrator (422).
    // A table the project lists in LogTables (an insert-only ledger, LogTablePlan) gets the reading routes only (a POST, PUT or DELETE answers 405, there is no clone), its search takes
    // from and to (the first and the last day, both included) on the timestamp and lists newest first when no sort is chosen: the rules of the ASP.NET API.
    // Full notes: Docs/TemplateNotes/PY_Routes_v1.md
    // ==========================================================================================

    var t = PythonTable.Of(Model, Project);
    bool search = Model.HasSearchApiOfAnyKey(Project);
    bool validate = Project.ApiValidation;
    string key = t.Key.Name;
    var kt = KeyType.Of(Model)!;   // how the key travels: int, UUID or str, in the path, the body and the Location header
    string keyType = kt.Python;
    bool textKey = kt.Kind == KeyKind.Text;
    bool guidKey = kt.Kind == KeyKind.Guid;
    var logStamp = t.LogStamp;
    bool log = logStamp is not null;
    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');
    string Str(string text) => PythonNames.Str(text);

    // ApiAuth: who owns a row, and what the user table guards
    bool auth = Project.ApiAuth;
    var ownerColumn = auth ? OwnedTable.OwnerColumn(Model, Project) : null;
    var ownerLink = auth ? OwnedTable.Through(Model, Project) : null;
    var userPlan = auth ? UserTable.PlanOf(Model, Project) : null;
    // a table with a Name and an IsActive column (NameActivePlan): the list is by name, GET active and GET {name} are added, a name is trimmed, may not be empty and may not be that of another active row
    var nameActive = NameActivePlan.For(Model, Project);
    string idPath = nameActive is null ? "{id}" : "{id:int}";   // a name in that place is the start of a name, not a key
    // TenantTable (PY_Tenants, app/routes/tenancy.py): a tenant-owned table shows and changes only the rows of the caller's tenant (another tenant's row is a 404) and stamps the caller's tenant on create and update;
    // the tenant table shows the caller's own tenant (a platform administrator every one), only a platform administrator creates one and nobody deletes one
    bool tenancy = PythonTenantWriter.Applies(Project);
    var tenantOwned = tenancy ? TenantPlan.OwnedBy(Model, Project) : null;
    bool tenantTable = tenancy && TenantPlan.IsTenantTable(Model, Project);
    // ReadRoles and WriteRoles: the routes refuse a role the table's rules do not list (the administrator role is always listed); the lookup stays open
    var readRoles = WriteRolePlan.ReadFor(Project, Model);
    var writeRoles = WriteRolePlan.For(Project, Model);
    string RoleTuple(IReadOnlyList<string> roles) => "(" + string.Join(", ", roles.Select(Str)) + (roles.Count == 1 ? "," : "") + ")";
    string readDepends = readRoles.Count > 0 ? ", dependencies=[Depends(require_roles(READ_ROLES, False))]" : "";
    string writeDepends = writeRoles.Count > 0 ? ", dependencies=[Depends(require_roles(WRITE_ROLES, True))]" : "";
    PythonField? FieldOf(ColumnModel? column) => column is null ? null : t.SchemaFields.FirstOrDefault(f => f.Column.Name.EqualsIgnoreCase(column.Name));
    var ownerField = FieldOf(ownerColumn);
    var tenantField = FieldOf(tenantOwned?.Column);
    bool tenanted = tenantField is not null || tenantTable;
    string ParentName(string name) => PythonNames.Ident(PythonNames.Snake(name));
    string parentClass = ownerLink is null ? "" : PythonNames.Pascal(ScreenNames.BaseName(ownerLink.ParentTable));
    string parentModule = ownerLink is null ? "" : PythonNames.Snake(ownerLink.ParentTable);
    var linkField = ownerLink is null ? null : t.SchemaFields.FirstOrDefault(f => f.Column.Name.EqualsIgnoreCase(ownerLink.ForeignKey));
    bool scoped = ownerField is not null || (ownerColumn is null && linkField is not null);
    // ChangeGates and GuardedColumns (PY_Gates): checked before a row is saved, a copy starts like a new row, and GET /guards says which guarded columns the caller may change
    bool gated = auth && GatePlan.HasRules(Project, Model);
    var guardHints = gated ? GatePlan.GuardsOf(Project, Model) : [];
    var nameField = FieldOf(userPlan?.UserName);
    var adminField = FieldOf(userPlan?.Admin);
    var guarded = new[] { FieldOf(userPlan?.Admin), FieldOf(userPlan?.Role) }.Where(f => f is not null).Select(f => f!).ToList();
    var activeField = t.ActiveField;
    string AdminTest(string row) => adminField is null ? "False" : $"bool({row}.{adminField.Name})" + (activeField is null ? "" : $" and bool({row}.{activeField.Name})");
    string DefaultOf(PythonField f) => f.Annotation == "bool" ? "False" : f.IsNullable ? "None" : "\"\"";

    // a name/active list is by name, any other by key
    string OrderColumn = nameActive is null ? $"{t.Class}.{key}" : $"{t.Class}.{FieldOf(nameActive.Name)!.Name}";
    // the statement limited to the caller's tenant, and the 404 for another tenant's row
    string TenantFilter(string statement) => tenantTable
        ? $"    {statement} = only_own_tenant({statement}, {t.Class}.{key}, user)"
        : $"    {statement} = only_tenant({statement}, {t.Class}.{tenantField!.Name}, user)";
    string TenantRefusal(string row) => tenantTable ? $"    refuse_other_tenant_row({row}.{key}, user)" : $"    refuse_other_tenant({row}.{tenantField!.Name}, user)";

    Line($"@@@FILE app/routes/{t.Module}.py@@@");
    var clonedDates = new[] { "datetime", "date" }.Where(w => t.Clone?.Any(c => c.Value.StartsWith(w + ".")) == true
        || t.StampedOnNew.Concat(t.StampedOnChange).Any(f => PythonTable.Now(f).StartsWith(w + "."))).ToList();
    if (log && search)
        clonedDates = ["date", "datetime", "time", "timedelta"];
    if (clonedDates.Count > 0)
        Line($"from datetime import {string.Join(", ", clonedDates)}");
    if (textKey)
        Line("from urllib.parse import quote");
    bool uuidFilter = search && t.KeyFilters.Any(k => k.Field.Annotation == "UUID");
    if (guidKey)
        Line("from uuid import UUID, uuid4");
    else if (uuidFilter)
        Line("from uuid import UUID");
    if (clonedDates.Count > 0 || textKey || guidKey || uuidFilter)
        Line();
    bool castsEnum = search && t.Filters.Any(f => f.Field.Column.DbCastType is not null);
    var sqlalchemy = new List<string> { "select" };
    if (search || userPlan is not null || nameActive is not null)
        sqlalchemy.Add("func");
    bool castsLookup = t.LookupName is { } castName && castName.Annotation != "str";
    if (castsEnum || castsLookup)
    {
        sqlalchemy.Add("cast");
        sqlalchemy.Add("String");
    }
    Line("from fastapi import " + string.Join(", ", new[] { "APIRouter", "Depends" }.Concat(search ? ["Query"] : []).Concat(log ? [] : ["Response"])));
    if (tenantTable)
        Line("from pydantic import BaseModel, ConfigDict, Field");
    Line($"from sqlalchemy import {string.Join(", ", sqlalchemy.OrderBy(s => s, StringComparer.Ordinal))}");
    if (!log)
        Line("from sqlalchemy.exc import IntegrityError");
    Line("from sqlalchemy.orm import Session");
    Line();
    var authNames = new List<string>();
    if (scoped || userPlan is not null || gated || tenanted)
        authNames.AddRange(new[] { "CurrentUser", "require_user" });
    if (scoped)
        authNames.AddRange(new[] { "not_yours", "visible_owners" });
    if (readRoles.Count > 0 || writeRoles.Count > 0)
        authNames.Add("require_roles");
    if (auth && authNames.Count > 0)
        Line("from app.auth import " + string.Join(", ", authNames.OrderBy(n => n, StringComparer.Ordinal)));
    if (gated)
    {
        var gateNames = new List<string> { $"after_clone_{t.Module}", $"check_{t.Module}" };
        foreach (var hint in guardHints)
            gateNames.Add($"may_{t.Module}_{t.SchemaFields.First(f => f.Column.Name.EqualsIgnoreCase(hint.Column)).Name}");
        Line("from app.gates import " + string.Join(", ", gateNames.OrderBy(n => n, StringComparer.Ordinal)));
    }
    Line("from app.db import get_session");
    if (tenanted)
    {
        var tenancyNames = tenantTable
            ? new List<string> { "attach_admin", "attach_creator", "is_platform", "never_deleted", "only_own_tenant", "only_platform", "refuse_other_tenant_row" }
            : new List<string> { "only_tenant", "refuse_other_tenant", "require_tenant" };
        Line("from app.routes.tenancy import " + string.Join(", ", tenancyNames.OrderBy(n => n, StringComparer.Ordinal)));
    }
    Line($"from app.models.{t.Module} import {t.Class}");
    if (ownerLink is not null)
        Line($"from app.models.{parentModule} import {parentClass}");
    Line($"from app.schemas.{t.Module} import {t.Schema}");
    var support = new List<string> { "ApiError" };
    if (search)
        support.Add("Page");
    if (search || t.LookupName is not null || nameActive is not null)
        support.Add("contains");
    if (t.LookupName is not null)
    {
        support.Add("lookup_take");
        support.Add("parse_keys");
    }
    if (t.CloneOverrides.Count > 0)
        support.Add("suggest_free");
    Line($"from app.support import {string.Join(", ", support.OrderBy(s => s, StringComparer.Ordinal))}");
    if (validate && !log)
        Line($"from app.validation.{t.Module} import validate");
    Line();
    Line("router = APIRouter()");
    if (readRoles.Count > 0)
        Line($"READ_ROLES = {RoleTuple(readRoles)}");
    if (writeRoles.Count > 0)
        Line($"WRITE_ROLES = {RoleTuple(writeRoles)}");
    Line($"IN_USE = \"The database refused the row (a missing parent row, or a value that must be unique).\"");
    Line();

    string userParameter = scoped || userPlan is not null || gated || tenanted ? ", user: CurrentUser = Depends(require_user)" : "";
    if (scoped)
    {
        // who owns a row: its own owner column, or the owner of the parent row it belongs to (a schema object has the same attribute names as the row)
        Line();
        Line($"def owner_of(session: Session, row) -> int | None:");
        if (ownerField is not null)
            Line($"    return row.{ownerField.Name}");
        else
            Line($"    return session.scalar(select({parentClass}.{ParentName(ownerLink!.ParentOwner)}).where({parentClass}.{ParentName(ownerLink.ParentKey)} == row.{linkField!.Name}))");
        Line();
        Line();
        Line($"def refuse_other_owners(session: Session, user: CurrentUser, row) -> None:");
        Line("    owners = visible_owners(user)");
        Line("    if owners is not None and owner_of(session, row) not in owners:");
        Line("        raise not_yours()");
        Line();
        Line();
        Line("def only_owned(statement, user: CurrentUser):");
        Line("    owners = visible_owners(user)");
        if (ownerField is not null)
            Line($"    return statement if owners is None else statement.where({t.Class}.{ownerField.Name}.in_(owners))");
        else
            Line($"    return statement if owners is None else statement.where({t.Class}.{linkField!.Name}.in_(select({parentClass}.{ParentName(ownerLink!.ParentKey)}).where({parentClass}.{ParentName(ownerLink.ParentOwner)}.in_(owners))))");
        Line();
    }
    if (userPlan is not null)
    {
        Line();
        if (adminField is not null)
        {
            Line($"def is_administrator(row) -> bool:");
            Line($"    return {AdminTest("row")}");
            Line();
            Line();
            Line($"def other_administrators(session: Session, key) -> bool:");
            Line($"    others = select(func.count()).select_from({t.Class}).where({t.Class}.{t.Key.Name} != key, {t.Class}.{adminField.Name}.is_(True)" + (activeField is null ? "" : $", {t.Class}.{activeField.Name}.is_(True)") + ")");
            Line("    return (session.scalar(others) or 0) > 0");
            Line();
            Line();
            Line("def last_administrator() -> ApiError:");
            Line($"    return ApiError({HttpStatus.UnprocessableEntity}, \"Last administrator\", problem_type=\"{ProblemTypes.LastAdministrator}\", detail=\"There must be at least one active administrator.\")");
            Line();
            Line();
        }
        Line($"def guard_user_row(session: Session, user: CurrentUser, body: {t.Schema}, current: {t.Class} | None) -> None:");
        Line("    \"\"\"What the user table allows: only an administrator changes the administrator and role columns, a sign-in name is used by one person and the last administrator stays.\"\"\"");
        if (guarded.Count > 0)
        {
            Line("    if not user.is_admin:");
            foreach (var g in guarded)
            {
                string same = g.Annotation == "bool" ? $"bool(body.{g.Name}) != bool(current.{g.Name})" : $"(body.{g.Name} or \"\") != (current.{g.Name} or \"\")";
                Line("        if current is None:");
                Line($"            body.{g.Name} = {DefaultOf(g)}");
                Line($"        elif {same}:");
                Line($"            raise ApiError({HttpStatus.Forbidden}, \"Not allowed\", problem_type=\"{ProblemTypes.ColumnNotYours}\", detail=\"Only an administrator may change {g.Column.Name}.\")");
            }
        }
        if (nameField is not null)
        {
            Line($"    login = body.{nameField.Name}");
            Line("    if login is not None:");
            Line($"        body.{nameField.Name} = login = login.strip()");
            Line($"        if login and (session.scalar(select(func.count()).select_from({t.Class}).where({t.Class}.{nameField.Name} == login, {t.Class}.{t.Key.Name} != body.{t.Key.Name})) or 0) > 0:");
            Line($"            raise ApiError({HttpStatus.Conflict}, \"Duplicate value\", problem_type=\"{ProblemTypes.DuplicateValue}\", detail=\"Another person already signs in with that name.\")");
        }
        if (adminField is not null)
            Line($"    if current is not None and is_administrator(current) and not is_administrator(body) and not other_administrators(session, body.{t.Key.Name}):\n        raise last_administrator()");
        Line();
        Line();
    }

    if (nameActive is not null)
    {
        var nameCol = FieldOf(nameActive.Name)!;
        var activeCol = FieldOf(nameActive.Active)!;
        Line();
        Line($"def check_name(session: Session, body: {t.Schema}, key=None{(tenanted ? ", user: CurrentUser = None" : "")}) -> None:");
        Line("    \"\"\"The name rules: a name is trimmed, may not be empty and may not be that of another active row" + (tenantField is not null ? " of the caller's tenant" : "") + ".\"\"\"");
        Line($"    body.{nameCol.Name} = body.{nameCol.Name}.strip()");
        Line($"    if not body.{nameCol.Name}:");
        Line($"        raise ApiError({HttpStatus.BadRequest}, {Str(NameActiveWords.RequiredTitle)}, problem_type=\"{ProblemTypes.NameRequired}\", detail={Str(NameActiveWords.RequiredDetail)})");
        Line($"    if body.{activeCol.Name}:");
        Line($"        statement = select(func.count()).select_from({t.Class}).where({t.Class}.{nameCol.Name} == body.{nameCol.Name}, {t.Class}.{activeCol.Name}.is_(True))");
        Line("        if key is not None:");
        Line($"            statement = statement.where({t.Class}.{key} != key)");
        if (tenantField is not null)
            Line($"        statement = only_tenant(statement, {t.Class}.{tenantField.Name}, user)");
        Line("        if (session.scalar(statement) or 0) > 0:");
        Line($"            raise ApiError({HttpStatus.Conflict}, {Str(NameActiveWords.DuplicateTitle)}, problem_type=\"{ProblemTypes.DuplicateName}\", detail=f{Str(NameActiveWords.DuplicateDetailFormat.Replace("{0}", "{body." + nameCol.Name + "}"))})");
        Line();
        Line();
    }

    if (search)
    {
        Line("# The columns a grid may sort by, by the lower-case name it sends.");
        Line("SORTS = {");
        foreach (var s in t.Sorts)
            Line($"    {Str(s.Name)}: {t.Class}.{s.Field.Name},");
        Line("}");
        Line("MAX_PAGE_SIZE = 1000");
        Line();
    }

    Line();
    Line($"@router.get(\"{t.Route}\", response_model=list[{t.Schema}]{readDepends})");
    Line($"def get_all(session: Session = Depends(get_session){userParameter}):");
    if (scoped || tenanted)
    {
        Line($"    statement = select({t.Class})");
        if (scoped)
            Line("    statement = only_owned(statement, user)");
        if (tenanted)
            Line(TenantFilter("statement"));
        Line($"    return session.scalars(statement.order_by({OrderColumn})).all()");
    }
    else
        Line($"    return session.scalars(select({t.Class}).order_by({OrderColumn})).all()");
    Line();

    if (nameActive is not null)
    {
        // before the route with the key in its path
        Line();
        Line($"@router.get(\"{t.Route}/active\", response_model=list[{t.Schema}]{readDepends})");
        Line($"def get_all_active(session: Session = Depends(get_session){userParameter}):");
        Line($"    statement = select({t.Class}).where({t.Class}.{FieldOf(nameActive.Active)!.Name}.is_(True))");
        if (tenanted)
            Line(TenantFilter("statement"));
        Line($"    return session.scalars(statement.order_by({OrderColumn})).all()");
        Line();
    }

    if (guardHints.Count > 0)
    {
        // before the route with the key in its path, which would read "guards" as a key
        Line();
        Line($"@router.get(\"{t.Route}/guards\")");
        Line("def guards(session: Session = Depends(get_session), user: CurrentUser = Depends(require_user)):");
        Line("    \"\"\"Which guarded columns the caller may change, by the column's JSON name (the screens show the others as read-only).\"\"\"");
        Line("    return {");
        foreach (var hint in guardHints)
            Line($"        {Str(hint.Json)}: may_{t.Module}_{t.SchemaFields.First(f => f.Column.Name.EqualsIgnoreCase(hint.Column)).Name}(session, user),");
        Line("    }");
        Line();
    }

    if (t.LookupName is { } lookupName)
    {
        // before the route with the key in its path, which would read "lookup" as a key
        string activeColumn = t.LookupActive is { } lookupActive ? $"{t.Class}.{lookupActive.Name}" : "None";
        string nameText = lookupName.Annotation == "str" ? "name or \"\"" : "\"\" if name is None else str(name)";
        Line();
        Line($"@router.get(\"{t.Route}/lookup\")");
        string keyConvert = guidKey ? "UUID" : textKey ? "str" : "int";
        string nameColumn = lookupName.Annotation == "str" ? $"{t.Class}.{lookupName.Name}" : $"cast({t.Class}.{lookupName.Name}, String)";
        Line($"def lookup(search: str | None = None, ids: str | None = None, take: int | None = None, session: Session = Depends(get_session){userParameter}):");
        Line("    \"\"\"Every row as { id, name, isActive }, ordered by name: what the drop-downs and the name columns of other screens read.");
        Line("    With ids, only the rows with those keys; with search (or take), the first few rows whose name contains the text.\"\"\"");
        Line($"    statement = select({t.Class}.{key}, {t.Class}.{lookupName.Name}" + (t.LookupActive is null ? "" : $", {activeColumn}") + $").order_by({t.Class}.{lookupName.Name})");
        Line("    by_ids = ids is not None and ids.strip() != \"\"");
        Line("    by_search = not by_ids and search is not None and search.strip() != \"\"");
        Line("    if by_ids:");
        Line($"        statement = statement.where({t.Class}.{key}.in_(parse_keys(ids, {keyConvert})))");
        Line("    elif by_search:");
        Line($"        statement = statement.where(contains({nameColumn}, search.strip()))");
        if (scoped)
            Line("    statement = only_owned(statement, user)");
        if (tenanted)
            Line(TenantFilter("statement"));
        Line("    if not by_ids and (by_search or take is not None):");
        Line("        statement = statement.limit(lookup_take(take))");
        Line("    rows = session.execute(statement).all()");
        Line($"    return [{{\"id\": row_id, \"name\": {nameText}, \"isActive\": {(t.LookupActive is null ? "None" : "active")}}} for row_id, name{(t.LookupActive is null ? "" : ", active")} in rows]");
        Line();
    }

    if (search)
    {
        Line();
        Line($"@router.get(\"{t.Route}/search\", response_model=Page[{t.Schema}]{readDepends})");
        Line("def search(");
        Line("    session: Session = Depends(get_session),");
        if (userParameter.Length > 0)
            Line("    user: CurrentUser = Depends(require_user),");
        Line("    page_number: int = Query(1, alias=\"pageNumber\"),");
        Line("    page_size: int = Query(100, alias=\"pageSize\"),");
        Line("    sort_by: str | None = Query(None, alias=\"sortBy\"),");
        Line("    sort_dir: str | None = Query(None, alias=\"sortDir\"),");
        foreach (var f in t.Filters)
            Line($"    {f.Field.Name}: str | None = Query(None, alias=\"{f.Query}\"),");
        foreach (var k in t.KeyFilters)
            Line($"    {k.Field.Name}: {k.Field.Annotation} | None = Query(None, alias=\"{k.Query}\"),");
        if (log)
        {
            Line($"    range_from: date | None = Query(None, alias=\"{LogTable.FromParameter}\"),");
            Line($"    range_to: date | None = Query(None, alias=\"{LogTable.ToParameter}\"),");
        }
        Line("):");
        Line("    if page_number < 1:");
        Line($"        raise ApiError({HttpStatus.BadRequest}, \"pageNumber must be 1 or greater.\")");
        Line("    page_size = max(1, min(page_size, MAX_PAGE_SIZE))");
        Line(scoped ? $"    statement = only_owned(select({t.Class}), user)" : $"    statement = select({t.Class})");
    if (tenanted)
        Line(TenantFilter("statement"));
        foreach (var f in t.Filters)
        {
            string column = f.Field.Column.DbCastType is not null ? $"cast({t.Class}.{f.Field.Name}, String)" : $"{t.Class}.{f.Field.Name}";
            Line($"    if {f.Field.Name}:");
            Line($"        statement = statement.where(contains({column}, {f.Field.Name}))");
        }
        foreach (var k in t.KeyFilters)
        {
            Line(k.Field.Annotation == "str" ? $"    if {k.Field.Name}:" : $"    if {k.Field.Name} is not None:");
            Line($"        statement = statement.where({t.Class}.{k.Field.Name} == {k.Field.Name})");
        }
        if (log)
        {
            // SQLite keeps a date and time as text, and a value without a fraction sorts before the same value with one, so both sides go through datetime() there
            bool sqlite = Model.Dialect == SqlDialect.Sqlite;
            string Side(string expression) => sqlite ? $"func.datetime({expression})" : expression;
            Line("    # the first and the last day, both included");
            Line("    if range_from is not None:");
            Line($"        statement = statement.where({Side($"{t.Class}.{logStamp!.Name}")} >= {Side("datetime.combine(range_from, time.min)")})");
            Line("    if range_to is not None:");
            Line($"        statement = statement.where({Side($"{t.Class}.{logStamp!.Name}")} < {Side("datetime.combine(range_to + timedelta(days=1), time.min)")})");
        }
        Line("    total_count = session.scalar(select(func.count()).select_from(statement.subquery())) or 0");
        Line($"    default_order = [{string.Join(", ", t.DefaultOrder.Select(f => $"{t.Class}.{f.Name}" + (log ? ".desc()" : "")))}]");
        Line("    column = SORTS.get(sort_by.lower()) if sort_by and len(sort_by) <= 64 else None");
        Line("    if column is not None:");
        Line("        statement = statement.order_by(column.desc() if (sort_dir or \"\").lower() == \"desc\" else column.asc(), *default_order)");
        Line("    else:");
        Line("        statement = statement.order_by(*default_order)");
        Line("    items = session.scalars(statement.offset((page_number - 1) * page_size).limit(page_size)).all()");
        Line("    total_pages = 0 if total_count == 0 else (total_count + page_size - 1) // page_size");
        Line($"    return Page[{t.Schema}](items=items, page=page_number, page_size=page_size, total_count=total_count, total_pages=total_pages)");
        Line();
    }

    Line();
    Line($"@router.get(\"{t.Route}/{idPath}\", response_model={t.Schema}{readDepends})");
    Line($"def get_by_id(id: {keyType}, session: Session = Depends(get_session){userParameter}):");
    Line($"    row = session.get({t.Class}, id)");
    Line("    if row is None:");
    Line($"        raise ApiError({HttpStatus.NotFound}, \"Not found.\")");
    if (scoped)
        Line("    refuse_other_owners(session, user, row)");
    if (tenanted)
        Line(TenantRefusal("row"));
    Line("    return row");
    if (!log)   // a log table has no write routes
    {
    Line();
    Line();
    Line($"@router.post(\"{t.Route}\", response_model={t.Schema}, status_code={HttpStatus.Created}{writeDepends})");
    Line($"def create(body: {t.Schema}, response: Response, session: Session = Depends(get_session){userParameter}):");
    if (tenantTable)
    {
        Line("    if not is_platform(user):");
        Line("        raise only_platform()");
    }
    if (tenantField is not null)
        Line("    require_tenant(user)");
    if (validate)
        Line("    validate(body)");
    if (scoped)
    {
        Line("    owners = visible_owners(user)");
        Line("    if owners is not None:");
        if (ownerField is not null)
        {
            Line("        # a caller who may act for one owner and left the owner blank creates the row for that owner");
            Line($"        if body.{ownerField.Name} == 0 and len(owners) == 1:");
            Line($"            body.{ownerField.Name} = owners[0]");
        }
        Line("        if owner_of(session, body) not in owners:");
        Line("            raise not_yours()");
    }
    if (userPlan is not null)
        Line("    guard_user_row(session, user, body, None)");
    if (gated)
        Line($"    check_{t.Module}(session, user, body, None)");
    if (textKey)
    {
        // a text key is chosen by the person: a blank one is refused and one that exists is a conflict (the answers the ASP.NET API gives)
        Line($"    if not body.{key}.strip():");
        Line($"        raise ApiError({HttpStatus.BadRequest}, \"Key is required\")");
        Line($"    if session.get({t.Class}, body.{key}) is not None:");
        Line($"        raise ApiError({HttpStatus.Conflict}, \"Duplicate key\")");
    }
    if (nameActive is not null)
        Line(tenanted ? "    check_name(session, body, None, user)" : "    check_name(session, body)");
    Line($"    row = {t.Class}(**body.columns())");
    if (tenantField is not null)
        Line($"    row.{tenantField.Name} = user.tenant_id");
    foreach (var f in t.StampedOnNew)
        Line($"    row.{f.Name} = {PythonTable.Now(f)}");
    if (guidKey)
    {
        // a new row is posted with the empty GUID: the API assigns the real one
        Line($"    if row.{key} == UUID(int=0):");
        Line($"        row.{key} = uuid4()");
    }
    Line("    session.add(row)");
    Line("    try:");
    Line("        session.commit()");
    Line("    except IntegrityError:");
    Line("        session.rollback()");
    Line($"        raise ApiError({HttpStatus.BadRequest}, IN_USE)");
    Line("    session.refresh(row)");
    if (tenantTable)
        Line($"    attach_creator(session, user, row.{key})");
    Line(textKey
        ? $"    response.headers[\"Location\"] = f\"{t.Route}/{{quote(row.{key}, safe='')}}\""
        : $"    response.headers[\"Location\"] = f\"{t.Route}/{{row.{key}}}\"");
    Line("    return row");
    if (tenantTable)
    {
        // POST <tenants>/onboard: the tenant and, when the project has a membership table, the person who becomes its first administrator, saved together
        Line();
        Line();
        Line("class OnboardRequest(BaseModel):");
        Line("    model_config = ConfigDict(populate_by_name=True)");
        Line();
        Line($"    tenant: {t.Schema}");
        Line("    admin_id: int | None = Field(None, alias=\"adminId\")");
        Line();
        Line();
        Line($"@router.post(\"{t.Route}/onboard\", response_model={t.Schema}, status_code={HttpStatus.Created}{writeDepends})");
        Line($"def onboard(request: OnboardRequest, response: Response, session: Session = Depends(get_session){userParameter}):");
        Line("    if not is_platform(user):");
        Line("        raise only_platform()");
        Line("    body = request.tenant");
        if (validate)
            Line("    validate(body)");
        if (nameActive is not null)
            Line("    check_name(session, body, None, user)");
        Line($"    row = {t.Class}(**body.columns())");
        foreach (var f in t.StampedOnNew)
            Line($"    row.{f.Name} = {PythonTable.Now(f)}");
        Line("    session.add(row)");
        Line("    try:");
        Line("        session.flush()");
        Line($"        attach_admin(session, request.admin_id, row.{key})");
        Line("        session.commit()");
        Line("    except IntegrityError:");
        Line("        session.rollback()");
        Line($"        raise ApiError({HttpStatus.BadRequest}, IN_USE)");
        Line("    except ApiError:");
        Line("        session.rollback()");
        Line("        raise");
        Line("    session.refresh(row)");
        Line($"    response.headers[\"Location\"] = f\"{t.Route}/{{row.{key}}}\"");
        Line("    return row");
    }
    Line();
    Line();
    Line($"@router.put(\"{t.Route}/{idPath}\", response_model={t.Schema}{writeDepends})");
    Line($"def update(id: {keyType}, body: {t.Schema}, session: Session = Depends(get_session){userParameter}):");
    Line($"    if body.{key} != id:");
    Line($"        raise ApiError({HttpStatus.BadRequest}, \"The id in the URL and the id in the body differ.\")");
    Line($"    row = session.get({t.Class}, id)");
    Line("    if row is None:");
    Line($"        raise ApiError({HttpStatus.NotFound}, \"Not found.\")");
    if (tenanted)
        Line(TenantRefusal("row"));
    if (scoped)
    {
        Line("    refuse_other_owners(session, user, row)");
        Line("    # the row stays with an owner the caller may act for: it cannot be handed to anyone else");
        Line("    owners = visible_owners(user)");
        Line("    if owners is not None and owner_of(session, body) not in owners:");
        Line("        raise not_yours()");
    }
    if (userPlan is not null)
        Line("    guard_user_row(session, user, body, row)");
    if (validate)
        Line("    validate(body, row)  # a value the update leaves as it is stays unjudged");
    if (gated)
        Line($"    check_{t.Module}(session, user, body, row)");
    if (nameActive is not null)
        Line(tenanted ? "    check_name(session, body, id, user)" : "    check_name(session, body, id)");
    Line("    for name, value in body.changes().items():");
    Line("        setattr(row, name, value)");
    if (tenantField is not null)
        Line($"    row.{tenantField.Name} = user.tenant_id   # a row never moves to another tenant");
    foreach (var f in t.StampedOnChange)
        Line($"    row.{f.Name} = {PythonTable.Now(f)}");
    Line("    try:");
    Line("        session.commit()");
    Line("    except IntegrityError:");
    Line("        session.rollback()");
    Line($"        raise ApiError({HttpStatus.BadRequest}, IN_USE)");
    Line("    session.refresh(row)");
    Line("    return row");
    Line();
    Line();
    Line($"@router.delete(\"{t.Route}/{idPath}\"{writeDepends})");
    Line($"def delete(id: {keyType}, session: Session = Depends(get_session){userParameter}):");
    if (tenantTable)
        Line("    raise never_deleted()");
    Line($"    row = session.get({t.Class}, id)");
    Line("    if row is None:");
    Line($"        raise ApiError({HttpStatus.NotFound}, \"Not found.\")");
    if (scoped)
        Line("    refuse_other_owners(session, user, row)");
    if (tenantField is not null)
        Line(TenantRefusal("row"));
    if (adminField is not null)
        Line($"    if is_administrator(row) and not other_administrators(session, row.{t.Key.Name}):\n        raise last_administrator()");
    Line("    session.delete(row)");
    Line("    try:");
    Line("        session.commit()");
    Line("    except IntegrityError:");
    Line("        session.rollback()");
    Line($"        raise ApiError({HttpStatus.BadRequest}, \"It cannot be deleted because it is in use.\")");
    Line($"    return Response(status_code={HttpStatus.Ok})");

    if (t.Clone is { } cloned && !tenantTable)
    {
        Line();
        Line();
        Line($"@router.post(\"{t.Route}/{{id}}/clone\", response_model={t.Schema}, status_code={HttpStatus.Created}{writeDepends})");
        Line($"def clone_row(id: {keyType}, response: Response, session: Session = Depends(get_session){userParameter}):");
        Line("    \"\"\"Copies a row into a new one and returns it. A unique text column gets a free value so the copy can be saved.\"\"\"");
        Line($"    source = session.get({t.Class}, id)");
        Line("    if source is None:");
        Line($"        raise ApiError({HttpStatus.NotFound}, \"Not found.\")");
        if (scoped)
            Line("    refuse_other_owners(session, user, source)");
        if (tenantField is not null)
            Line(TenantRefusal("source"));
        Line($"    row = {t.Class}(");
        foreach (var (field, value) in cloned)
            Line($"        {field.Name}={value},");
        Line("    )");
        if (userPlan is not null && guarded.Count > 0)
        {
            Line("    if not user.is_admin:");
            foreach (var g in guarded)
                Line($"        row.{g.Name} = {DefaultOf(g)}");
        }
        if (tenantField is not null)
            Line($"    row.{tenantField.Name} = user.tenant_id");
        Line("    session.add(row)");
        Line("    session.commit()");
        Line("    session.refresh(row)");
        if (gated)
            Line($"    after_clone_{t.Module}(session, user, row)");
        Line($"    response.headers[\"Location\"] = f\"{t.Route}/{{row.{key}}}\"");
        Line("    return row");
    }
    }
    if (nameActive is not null)
    {
        // after the routes with a key (a number there is a key) and the fixed ones
        Line();
        Line();
        Line($"@router.get(\"{t.Route}/{{name}}\", response_model=list[{t.Schema}]{readDepends})");
        Line($"def find_by_name(name: str, session: Session = Depends(get_session){userParameter}):");
        Line("    \"\"\"The active rows whose name contains the text.\"\"\"");
        Line($"    statement = select({t.Class}).where(contains({t.Class}.{FieldOf(nameActive.Name)!.Name}, name), {t.Class}.{FieldOf(nameActive.Active)!.Name}.is_(True))");
        if (tenanted)
            Line(TenantFilter("statement"));
        Line($"    return session.scalars(statement.order_by({OrderColumn})).all()");
    }
    Write(sb.ToString());
#>
