# Restriction checkboxes for BLZ_Client_v1.tt (see Docs/Reference.md section 3).
# The client calls api/<table>s/{id}, with the primary key taken as {id:int} or {id:guid}.
RequiresPrimaryKey=true
TableOnly=true
RequiredPrimaryKeyShape=SingleIntOrGuid
RequiresNotNameActiveTable=true
# No OutputName: the template writes its own path (Services/<Table>Client.cs) with an @@@FILE marker.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Blazor
PlanTables=Api
