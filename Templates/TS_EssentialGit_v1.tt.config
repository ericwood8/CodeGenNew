# Restriction checkboxes for TS_EssentialGit_v1.tt (see Docs/specs.md section 5.3).
# One of the files every app of a stack needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Angular
EssentialsGroup=Git
Description=.gitignore: node_modules, dist, the Angular CLI cache
