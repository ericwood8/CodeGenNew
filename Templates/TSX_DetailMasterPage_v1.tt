<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string pagesFolder = Project.PagesFolder;
    string componentsFolder = Project.ComponentsFolder;
    string modelsFolder = Project.ModelsFolder;
    string apiFolder = Project.ApiFolder;
    string apiPrefix = "/api";
    // ==========================================================================================

    // ==========================================================================================
    // TSX_DetailMasterPage_v1.tt
    // Generates: pages/<Table>DetailMasterPage.tsx plus its test file (the paths are written by the template; point the output folder at the React src folder)
    // TSX_Page's grid, search, paging and modal add/edit form, plus one read-only grid per child table under the form while a row is edited. A child the project lists in EditableChildren
    // (Department.DepartmentTeam) is an editable table inside the form instead, saved with the row in one request (EditableChild in Core, the rule the API's create and update use too).
    // The React counterpart of TS_DetailMasterComponent. Needs a table with at least one child foreign key.
    // Full notes: Docs/TemplateNotes/TSX_DetailMasterPage_v1.md
    // ==========================================================================================

    // A decimal, float or real column that is not money (a percentage, a rate, a quantity, a weight) is limited to what the column can hold (a percentage to 0-100).

    var form = FormModel.For(Model, Project);   // what the screen is made of, decided in Core for every stack
    var keyColumn = form.KeyColumn;
    var keyType = form.KeyType;   // how the key travels: a number, or a string for a uniqueidentifier or a text key
    if (Project.NoApiFor(Model.TableName, Model.LookupShape))
    {
        Error($"TSX_DetailMasterPage writes no screen for [{Model.SchemaName}].[{Model.TableName}]: it is an enum or excluded by the NoApiTables setting (an enum, a *Type lookup table, or a table with no entity class), so there is no API for it to show.");
    }
    else if (keyColumn is null || keyType is null)
    {
        Error($"TSX_DetailMasterPage needs a table with a single int, uniqueidentifier or text primary key (the routes take the id as {{id:int}}, {{id:guid}} or {{id}}), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else if (!Model.HasAtLeastOneChildForeignKey)
    {
        Error($"TSX_DetailMasterPage needs at least one other table with a foreign key pointing back at [{Model.SchemaName}].[{Model.TableName}]; none was found - use TSX_Page instead.");
    }
    else if (Model.IsNameActiveTable)
    {
        Error($"TSX_DetailMasterPage assumes a plain getAll()-style API. [{Model.SchemaName}].[{Model.TableName}] has a Name and an IsActive column, so its repository is a NameActiveRepo and its real API is always hand-maintained (and commonly has no plain getAll() at all); write this screen by hand.");
    }
    else
    {
        string baseName = form.BaseName;
        string stem = form.Stem;
        string variable = form.Variable;
        string listName = variable.Pluralize();
        string setList = ReactNames.SetList(listName);
        string keyProp = JsonNames.Camel(keyColumn.Name);
        string keyTs = keyType.TypeScript;
        string emptyKey = keyType.TypeScriptEmpty;     // "no key yet": the API assigns the real one (a text key is typed by the person, so a new row starts with '')
        bool textKey = form.TextKey;   // the key is a box on the form (typed on a new row, read-only on an existing one) and a column of the grid
        // a text key is put in a link as a query value, so a character such as & or # cannot end it early
        string keyInLink = textKey ? $"encodeURIComponent(selectedRow?.{JsonNames.Camel(keyColumn.Name)} ?? '')" : $"selectedRow?.{JsonNames.Camel(keyColumn.Name)}";
        string title = form.Title;
        bool hasName = form.HasName; // just for showError's message wording below
        const int pageSize = 20;
        // The same paging and search bar as TSX_Page: one text box per searchable column (Model.SearchableColumns), paged by the API's /search endpoint.
        // The Search list protocol (ListProtocol=Search) has one search box for the whole table; the server decides which columns it matches.
        bool listSearch = Project.ListSearchProtocol;
        var searchFields = form.WebSearchFields;
        bool canSearch = searchFields.Count > 0;
        // The route of a table's own page ("SalesInvoice" -> "sales-invoice"): the hand-written App.tsx has one route per generated page, named this way.
        string selfRoute = ScreenNames.Route(Model.TableName);

        var shown = form.Columns;

        var parents = form.Parents;

        // The child tables, decided in Core for every stack (ChildGrid): which ones get a grid, its heading and role, its key, and the foreign keys shown as names.
        var children = ChildGrid.For(Model, Project);


        // EditableChildren: the child tables whose rows are added, changed and removed inside this form and sent with it in one request (EditableChild, the rule the API's create and update use too);
        // every other child keeps its read-only grid under the form
        var gridChildren = children.Where(g => !g.IsEditable).ToList();
        var editableChildren = children.Where(g => g.IsEditable).ToList();
        string ChildInput(ChildGrid child, ColumnModel c)
        {
            string childVar = child.Variable, method = child.Name;
            string prop = JsonNames.Camel(c.Name);
            string aria = $"aria-label=\"{GridCaption.For(c, Labels.Field(c))}\"";
            string req = c.IsNullable ? "" : " required";
            string change(string value) => $"change{method}(row, {{ {prop}: {value} }})";
            string number = "event.target.value === '' ? null : Number(event.target.value)";
            if (child.EditLookupOf(c) is not null)
                return $"<select {aria} value={{row.{prop} ?? ''}} onChange={{(event) => {change(IsNumber(c) ? number : "event.target.value || null")}}}{req}><option value=\"\"></option>{{({childVar}Options['{prop}'] ?? []).map((p) => <option key={{p.id}} value={{p.id}}>{{p.name}}</option>)}}</select>";
            if (c.HasChoices)
                return $"<select {aria} value={{row.{prop} ?? ''}} onChange={{(event) => {change(c.IsNullable ? "event.target.value || null" : "event.target.value")}}}{req}><option value=\"\"></option>{string.Concat(c.Choices!.Select(choice => $"<option value=\"{ChoiceFormat.Html(choice)}\">{ChoiceFormat.Html(choice)}</option>"))}</select>";
            if (c.IsBooleanColumn)
                return $"<input type=\"checkbox\" {aria} checked={{!!row.{prop}}} onChange={{(event) => {change("event.target.checked")}}} />";
            if (IsDate(c))
                return $"<input type=\"date\" {aria} value={{row.{prop} ?? ''}} onChange={{(event) => {change("event.target.value || null")}}}{req} />";
            if (child.IsMoneyInput(c))
            {
                var money = child.MoneyBoxOf(c);
                return $"<CurrencyInput label=\"{GridCaption.For(c, Labels.Field(c))}\" value={{row.{prop}}} onChange={{(value) => {change("value ?? " + (c.IsNullable ? "null" : "0"))}}} digits={{{money.Digits}}} currency=\"{money.Currency}\""
                       + (money.Min is { } lo ? $" min={{{lo}}}" : "") + (money.Max is { } hi ? $" max={{{hi}}}" : "") + $"{req} />";
            }
            if (IsNumber(c))
                return $"<input type=\"number\" {aria} value={{row.{prop} ?? ''}} onChange={{(event) => {change(number)}}}{child.NumberBoxOf(c).Jsx}{req} />";
            string max = IsText(c) && Chars(c) > 0 ? $" maxLength={{{Chars(c)}}}" : "";
            return $"<input type=\"text\" {aria} value={{row.{prop} ?? ''}} onChange={{(event) => {change("event.target.value")}}}{max}{req} />";
        }
        var gridColumns = form.GridColumns;
        var sortableColumns = form.SortableColumns;
        bool canClone = form.CanClone;
        var formPages = form.Pages;
        bool tabbed = form.IsTabbed;

        var ts = new StringBuilder();
        void T(string s = "") => ts.Append(s).Append('\n');

        // ================= imports
        T("import { useEffect, useState } from 'react';");
        T("import type { FormEvent } from 'react';");
        T("import { useNavigate, useSearchParams } from 'react-router-dom';");
        T($"import type {{ {baseName} }} from '../{modelsFolder}/{stem}';");
        T($"import {{ {ReactNames.ApiVar(Model.TableName)} }} from '../{apiFolder}/{ReactNames.ApiFile(Model.TableName)}';");
        T($"import {{ ApiError, request }} from '../{apiFolder}/client';");
        T($"import {{ PaginationBar }} from '../{componentsFolder}/PaginationBar';");
        if (shown.Any(form.IsMoneyInput) || editableChildren.Any(ch => ch.EditColumns.Any(c => ch.IsMoneyInput(c))))
            T($"import {{ CurrencyInput }} from '../{componentsFolder}/CurrencyInput';");
        T($"import {{ GridMenu, SortHeader, loadSort, nextSort, saveSort{(gridChildren.Count > 0 ? ", sortRows" : "")} }} from '../{componentsFolder}/gridSort';");
        T($"import type {{ GridSort }} from '../{componentsFolder}/gridSort';");
        foreach (var p in parents.Where(p => !p.IsSelf))
        {
            if (!p.UsesLookupEndpoint) T($"import type {{ {p.BaseName} }} from '../{modelsFolder}/{p.ModelFile}';");
            T($"import {{ {ReactNames.ApiVar(p.Table)} }} from '../{apiFolder}/{ReactNames.ApiFile(p.Table)}';");
        }
        T();
        if (parents.Any(p => p.UsesLookupEndpoint))
        {
            T("// one row of GET <route>/lookup: the key, the text to show and whether the row is active");
            T("type Lookup<K extends number | string = number> = { id: K; name: string; isActive?: boolean | null };");
            T();
        }
        T($"const initialPageSize = {pageSize};");
        T("const pageSizeChoices = [10, 20, 50, 100]; // the page sizes the person can pick under the grid");
        T($"const gridKey = '{stem}'; // the grid's saved sort is kept in the browser under this key (see components/gridSort.tsx)");
        T($"const sortableColumns = [{string.Join(", ", sortableColumns.Select(c => "'" + c.Name + "'"))}]; // the columns whose header sorts the grid");
        T();
        if (gridChildren.Count > 0)
        {
            var allCurrency = gridChildren.SelectMany(ch => ch.MoneyColumns).GroupBy(m => m.Name).Select(g => g.First()).ToList();
            var allLongText = gridChildren.SelectMany(ch => ch.LongTextJson).Distinct().ToList();
            T("// Child grids show whatever keys the API returns; these helpers caption them, leave out long text, limit them to 20 and format money and dates.");
            T("const childCurrencyDigits: Record<string, number> = { " + string.Join(", ", allCurrency.Select(m => m.Name + ": " + m.Digits)) + " };");
            var allCaptions = gridChildren.SelectMany(ch => ch.Captions).GroupBy(m => m.Name).Select(g => g.First()).ToList();
            T("const childCaptions: Record<string, string> = { " + string.Join(", ", allCaptions.Select(m => m.Name + ": '" + m.Caption.Replace("'", "\'") + "'")) + " };");
            T("const childLongTextColumns: string[] = [" + string.Join(", ", allLongText.Select(n => "'" + n + "'")) + "];");
            T();
            foreach (var child in gridChildren)
            {
                T($"const {child.Variable}Hidden: string[] = [" + string.Join(", ", child.HiddenJson.Select(n => "'" + n + "'")) + "];");
            }
            T();
            T("function orderColumns(keys: string[], hidden: string[]): string[] {");
            T("  // Only the child table's own columns: the API also sends each navigation property (customer, customerMonthlySummary, ...), which is not a column.");
            T($"  return keys.filter((k) => k in childCaptions && !hidden.includes(k) && !childLongTextColumns.includes(k)).slice(0, {GridColumns.MaxColumns});");
            T("}");
            T();
            T("function caption(key: string): string {");
            T("  if (key in childCaptions) return childCaptions[key];");
            T("  const spaced = key.replace(/Id$/, '').replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/([A-Z])([A-Z][a-z])/g, '$1 $2');");
            T("  return spaced.split(' ').filter(Boolean).map((w) => {");
            T("    const l = w.toLowerCase();");
            T("    return l === 'number' || l === 'num' ? '#' : l === 'percentage' || l === 'percent' || l === 'pct' ? '%' : w.charAt(0).toUpperCase() + w.slice(1);");
            T("  }).join(' ');");
            T("}");
            T();
            T("function formatChildCell(value: unknown, key: string, names?: Record<string, string>): string {");
            T("  if (value === null || value === undefined) return '';");
            T("  if (names) return names[String(value)] ?? String(value);");
            T("  if (typeof value === 'boolean') return value ? 'Yes' : 'No';");
            T("  if (typeof value === 'number' && key in childCurrencyDigits) {");
            T("    const d = childCurrencyDigits[key];");
            T("    return value.toLocaleString(undefined, { style: 'currency', currency: '" + Project.CurrencyCode + "', minimumFractionDigits: d, maximumFractionDigits: d });");
            T("  }");
            T("  // A date-and-time string from the API (2026-09-27T00:00:00) shows as its date only.");
            T("  return typeof value === 'string' ? value.replace(/^(\\d{4}-\\d{2}-\\d{2})T.*$/, '$1') : String(value);");
            T("}");
            T();
        }
        T($"export function {baseName}DetailMasterPage() {{");
        T($"  const [{listName}, {setList}] = useState<{baseName}[]>([]);");
        foreach (var p in parents)
            T($"  const [{ReactNames.ParentList(p)}, {ReactNames.SetList(ReactNames.ParentList(p))}] = useState<{p.ItemType}[]>([]);");
        T($"  const [selectedRow, setSelectedRow] = useState<{baseName} | null>(null);");
        // a typed key is set on a new row too, so the key can no longer say whether the row is new: `adding` does
        if (textKey) T("  const [adding, setAdding] = useState(false); // true while the form holds a new row, whose key the person types");
        if (tabbed)
        {
            T("  const [tab, setTab] = useState(0); // the form tab showing");
            T("  // A required field on a tab that is not showing blocks the submit without a visible message: show the tab that holds the first invalid field.");
            T("  const revealInvalidTab = (event: { currentTarget: HTMLButtonElement }) => {");
            T("    const panel = event.currentTarget.form?.querySelector(':invalid')?.closest('[role=\"tabpanel\"]');");
            T("    if (panel) setTab(Number(panel.getAttribute('data-tab')));");
            T("  };");
        }
        string filterInit = string.Join(", ", searchFields.Select(f => $"{f.ParamName}: ''"));
        if (canSearch) T($"  const [filters, setFilters] = useState({{ {filterInit} }});");
        T("  const [page, setPage] = useState(1);");
        T("  const [totalPages, setTotalPages] = useState(1);");
        T("  const [pageSize, setPageSize] = useState(initialPageSize);");
        T("  const [loaded, setLoaded] = useState(false); // true once a page has arrived, so \"Nothing found.\" is not shown while waiting");
        T("  const [error, setError] = useState<string | null>(null);");
        T("  const [sort, setSort] = useState<GridSort | null>(() => loadSort(gridKey, sortableColumns));");
        T("  // Opened from another page's grid (?edit=<id>&back=<that page>): open this row, and go back to that page when the form is saved or cancelled.");
        T("  const [searchParams] = useSearchParams();");
        T("  const navigate = useNavigate();");
        T("  const backTo = searchParams.get('back');");
        foreach (var child in gridChildren)
        {
            T($"  const [{child.Variable}Rows, set{child.Name}Rows] = useState<any[]>([]);");
            T($"  const [{child.Variable}Columns, set{child.Name}Columns] = useState<string[]>([]);");
            T($"  const [{child.Variable}Sort, set{child.Name}Sort] = useState<GridSort | null>(() => loadSort(gridKey + '.{child.Variable}'));");
            if (child.Lookups.Count > 0)
                T($"  const [{child.Variable}Names, set{child.Name}Names] = useState<Record<string, Record<string, string>>>({{}});");
        }
        foreach (var child in editableChildren)
        {
            // the rows of the form's own child list: plain objects the inputs edit, sent with the row (withChildren below)
            T($"  const [{child.Variable}Rows, set{child.Name}Rows] = useState<any[]>([]);");
            if (child.EditColumns.Any(c => child.EditLookupOf(c) is not null))
                T($"  const [{child.Variable}Options, set{child.Name}Options] = useState<Record<string, {{ id: any; name: string }}[]>>({{}});");
        }
        T();
        // The sort (like the filters) is read from state by default; a change passes its new value explicitly because state is not updated yet.
        T($"  const load = (targetPage: number = 1{(canSearch ? ", filterValues: typeof filters = filters" : "")}, sortValue: GridSort | null = sort, sizeValue: number = pageSize) => {{");
        T($"    {ReactNames.ApiVar(Model.TableName)}.getPage(targetPage, sizeValue, {(canSearch ? "filterValues" : "{}")}, sortValue).then((result) => {{");
        T("      // the last row of the last page was deleted, or rows were removed elsewhere: the page asked for is past the end, so show the last page there is");
        T($"      if (result.items.length === 0 && result.totalCount > 0 && targetPage > 1) {{ load(result.totalPages{(canSearch ? ", filterValues" : "")}, sortValue, sizeValue); return; }}");
        T($"      {setList}(result.items);");
        T("      setPage(result.page);");
        T("      setTotalPages(result.totalPages);");
        T("      setLoaded(true);");
        T($"    }}).catch(() => setError('Failed to load {Labels.Words(baseName).ToLowerInvariant().Pluralize()}.'));");
        T("  };");
        T();
        T("  useEffect(() => {");
        T("    load();");
        foreach (var p in parents)
            T($"    {ReactNames.ApiVar(p.Table)}.{p.LoadMethod}().then({ReactNames.SetList(ReactNames.ParentList(p))}).catch(() => {{}});");
        foreach (var child in editableChildren)
            foreach (var c in child.EditColumns)
                if (child.EditLookupOf(c) is { } lookup)
                    T($"    request<any[]>('{apiPrefix}/{ScreenNames.ApiRoute(lookup.ReferencedTable)}/lookup').then((items) => set{child.Name}Options((options) => ({{ ...options, {JsonNames.Camel(c.Name)}: items.map((i) => ({{ id: i['id'], name: String(i['name'] ?? '') }})) }}))).catch(() => {{}});");
        T("    const openId = searchParams.get('edit');");
        T($"    if (openId) {ReactNames.ApiVar(Model.TableName)}.getById({(keyType.Kind == KeyKind.Int ? "Number(openId)" : "openId")}).then(edit).catch(() => setError('This {Labels.Words(baseName).ToLowerInvariant()} no longer exists!'));");
        T("  }, []);");
        T();
        // The child lists of EditableChildren go in the body of the save with the row; the API makes each child table match its list.
        string body = editableChildren.Count > 0 ? $"withChildren({variable})" : variable;
        if (editableChildren.Count > 0)
        {
            T($"  const withChildren = (row: {baseName}): {baseName} => ({{ ...row, {string.Join(", ", editableChildren.Select(ch => $"{ch.JsonName}: {ch.Variable}Rows"))} }}) as {baseName};");
            T();
        }
        T($"  const submit = async ({variable}: {baseName}): Promise<void> => {{");
        T("    setError(null);");
        T($"    try {{");
        if (textKey)
        {
            T("      if (adding) {");
            T($"        await {ReactNames.ApiVar(Model.TableName)}.create({body});");
            T("      } else {");
            T($"        await {ReactNames.ApiVar(Model.TableName)}.update({variable}.{keyProp}!, {body});");
            T("      }");
        }
        else
        {
            T($"      if ({variable}.{keyProp}) {{");
            T($"        await {ReactNames.ApiVar(Model.TableName)}.update({variable}.{keyProp}, {body});");
            T("      } else {");
            T($"        {variable}.{keyProp} = {emptyKey};");
            T($"        await {ReactNames.ApiVar(Model.TableName)}.create({body});");
            T("      }");
        }
        T("      setSelectedRow(null);");
        T("      load(page);");
        T("      if (backTo) navigate(backTo);");
        T("    } catch (err) {");
        T("      showError('saving', err);");
        T("    }");
        T("  };");
        T();
        T("  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {");
        T("    event.preventDefault();");
        T("    if (selectedRow) void submit(selectedRow);");
        T("  };");
        T();
        T($"  const remove = async (id: {keyTs}): Promise<void> => {{");
        T("    if (!confirm('Are you sure you want to delete this?')) return;");
        T("    try {");
        T($"      await {ReactNames.ApiVar(Model.TableName)}.delete(id);");
        T("      load(page); // read the page again: the total, the rows that move up and the last page all change");
        T("    } catch (err) {");
        T("      if (err instanceof ApiError && err.status === 400) {");
        T("        setError('It cannot be deleted because it is in use!');");
        T("      } else if (err instanceof ApiError && err.status === 404) {");
        T("        setError('It no longer exists!');");
        T("        load(page);");
        T("      } else {");
        T("        setError('Problem while deleting!');");
        T("      }");
        T("    }");
        T("  };");
        if (canClone)
        {
            // Clone copies the row on the server and returns the copy: it is in the grid, and open in the form at once so the person changes what differs.
            T();
            T($"  const clone = async (id: {keyTs}): Promise<void> => {{");
            T("    try {");
            T($"      const copy = await {ReactNames.ApiVar(Model.TableName)}.clone(id);");
            T("      load(page);");
            T("      edit(copy);");
            T("    } catch (err) {");
            T("      if (err instanceof ApiError && err.status === 404) {");
            T("        setError('It no longer exists!');");
            T("        load(page);");
            T("      } else {");
            T("        setError('Problem while cloning!');");
            T("      }");
            T("    }");
            T("  };");
        }
        T();
        var adds = form.NewRowTypeScript;
        T("  const add = () => {");
        if (tabbed) T("    setTab(0);");
        if (textKey) T("    setAdding(true);");
        T(adds.Count == 0 ? "    setSelectedRow({});" : $"    setSelectedRow({{ {string.Join(", ", adds)} }});");
        foreach (var child in children)
        {
            T($"    set{child.Name}Rows([]);");
            if (!child.IsEditable) T($"    set{child.Name}Columns([]);");
        }
        T("  };");
        T();
        T($"  const edit = ({variable}: {baseName}) => {{");
        if (tabbed) T("    setTab(0);");
        if (textKey) T("    setAdding(false);");
        T($"    const row = {{ ...{variable} }};");
        var dateColumns = form.DateColumns;   // a stamp keeps the timestamp the API sent
        if (dateColumns.Count > 0)
        {
            T("    // the date box wants yyyy-MM-dd; the API sends a full timestamp");
            foreach (var c in dateColumns)
            {
                string prop = $"row.{JsonNames.Camel(c.Name)}";
                if (c.IsNullable) T($"    if ({prop}) {{ {prop} = {prop}.substring(0, 10); }}");
                else T($"    {prop} = {prop}.substring(0, 10);");
            }
        }
        T("    setSelectedRow(row);");
        foreach (var child in children)
            T($"    load{child.Name}({variable}.{keyProp}!);");
        T("  };");
        T();
        T("  const cancel = () => {");
        T("    setSelectedRow(null);");
        T("    if (backTo) navigate(backTo);");
        T("  };");
        if (canSearch)
        {
            T();
            T("  const search = () => {");
            T("    setSelectedRow(null);");
            T("    load(1);");
            T("  };");
            T();
            T("  const clearSearch = () => {");
            T($"    const cleared = {{ {filterInit} }};");
            T("    setFilters(cleared);");
            T("    load(1, cleared);");
            T("  };");
        }
        // Click a column header to sort by it, click it again to flip the direction; the right-click menu clears the sort. The sort is saved (gridSort.tsx) and
        // kept when paging and when the filters change; a change goes back to page 1.
        T();
        T("  const sortBy = (column: string) => {");
        T("    const next = nextSort(sort, column);");
        T("    setSort(next);");
        T("    saveSort(gridKey, next);");
        T($"    load(1{(canSearch ? ", filters" : "")}, next);");
        T("  };");
        T();
        T("  const clearSort = () => {");
        T("    setSort(null);");
        T("    saveSort(gridKey, null);");
        T($"    load(1{(canSearch ? ", filters" : "")}, null);");
        T("  };");
        foreach (var p in parents)
        {
            T();
            T($"  // the name to show in place of a {p.BaseName} id");
            T($"  const {p.NameMethod} = (id?: {p.KeyTs}): string => {{");
            T($"    return {ReactNames.ParentList(p)}.find((p) => p.{p.KeyJson} === id)?.{p.DisplayJson} ?? '';");
            T("  };");
        }
        foreach (var child in editableChildren)
        {
            var editColumns = child.EditColumns;
            var childDates = editColumns.Where(IsDate).ToList();
            var defaults = new List<string>();
            foreach (var c in editColumns.Where(c => !c.IsNullable))
            {
                if (child.EditLookupOf(c) is not null) defaults.Add($"{JsonNames.Camel(c.Name)}: null");
                else if (c.IsBooleanColumn) defaults.Add($"{JsonNames.Camel(c.Name)}: {(c.DatabaseDefaultSql is not null && c.DatabaseDefaultSql.Trim('(', ')', ' ') == "1" ? "true" : "false")}");
                else if (IsDate(c)) defaults.Add($"{JsonNames.Camel(c.Name)}: new Date().toISOString().substring(0, 10)");
                else if (IsNumber(c)) defaults.Add($"{JsonNames.Camel(c.Name)}: 0");
                else defaults.Add($"{JsonNames.Camel(c.Name)}: ''");
            }
            T();
            T($"  // {child.Title} are part of this form: the rows that point at the row being edited are read once, edited here and sent with the row under '{child.JsonName}'.");
            T("  // The API makes the table match the list: a row with its key is changed, a row without one is added, a row left out is removed.");
            T($"  const load{child.Name} = (parentId: {keyTs}) => {{");
            T($"    request<any[]>('{apiPrefix}/{child.ApiRoute}').then((rows) => {{");
            T($"      set{child.Name}Rows(rows.filter((r) => r['{child.ForeignKeyJson}'] === parentId).map((r) => ({{ ...r{string.Concat(childDates.Select(c => $", {JsonNames.Camel(c.Name)}: r['{JsonNames.Camel(c.Name)}']?.substring(0, 10) ?? null"))} }})));");
            T("    }).catch(() => {});");
            T("  };");
            T();
            T($"  const add{child.Name} = () => set{child.Name}Rows((rows) => [...rows, {{ {string.Join(", ", defaults)} }}]);");
            T();
            T($"  const change{child.Name} = (row: any, values: Record<string, unknown>) => set{child.Name}Rows((rows) => rows.map((r) => (r === row ? {{ ...r, ...values }} : r)));");
            T();
            T($"  const remove{child.Name} = (row: any) => set{child.Name}Rows((rows) => rows.filter((r) => r !== row));");
        }
        foreach (var child in gridChildren)
        {
            T();
            T($"  // {child.Title} rows whose {child.ForeignKeyJson} matches the row being edited - the whole table is loaded and");
            T("  // filtered client-side (same no-paging simplification TSX_Page.tt's own grid makes), and the columns");
            T("  // shown are whatever keys the first row actually has, since this template never sees the child's own schema.");
            T($"  const load{child.Name} = (parentId: {keyTs}) => {{");
            T($"    request<any[]>('{apiPrefix}/{child.ApiRoute}').then((rows) => {{");
            T($"      const filtered = rows.filter((r) => r['{child.ForeignKeyJson}'] === parentId);");
            T($"      set{child.Name}Rows(filtered);");
            T($"      set{child.Name}Columns(filtered.length > 0 ? orderColumns(Object.keys(filtered[0]), {child.Variable}Hidden) : []);");
            foreach (var lookup in child.Lookups)
                T($"      request<any[]>('{apiPrefix}/{lookup.WebRoute}').then((items) => set{child.Name}Names((names) => ({{ ...names, {lookup.ColumnJson}: Object.fromEntries(items.map((i) => [String(i['{lookup.WebKey}']), String(i['{lookup.WebDisplay}'] ?? '')])) }}))).catch(() => {{}});");
            T("    }).catch(() => {});");
            T("  };");
            // The child grid holds all its rows, so a click on a header sorts them here (no trip to the server); the sort is saved like the main grid's.
            T();
            T($"  const sort{child.Name}By = (column: string) => {{");
            T($"    const next = nextSort({child.Variable}Sort, column);");
            T($"    set{child.Name}Sort(next);");
            T($"    saveSort(gridKey + '.{child.Variable}', next);");
            T("  };");
            T();
            T($"  const clear{child.Name}Sort = () => {{");
            T($"    set{child.Name}Sort(null);");
            T($"    saveSort(gridKey + '.{child.Variable}', null);");
            T("  };");
            if (child.KeyJson is not null)
            {
                T();
                T($"  // Edit opens the {child.Title}'s own page on that row; saving or cancelling there comes back here with this {title} open again.");
                T($"  const edit{child.Name} = (row: any) => {{");
                string childKeyInLink = child.KeyIsText ? $"encodeURIComponent(row['{child.KeyJson}'])" : $"row['{child.KeyJson}']";
                T($"    navigate(`/{child.PageRoute}?edit=${{{childKeyInLink}}}&back=${{encodeURIComponent(`/{selfRoute}?edit=${{{keyInLink}}}`)}}`);");
                T("  };");
                T();
                T($"  const delete{child.Name} = async (row: any): Promise<void> => {{");
                T("    if (!confirm('Are you sure you want to delete this?')) return;");
                T("    try {");
                T($"      await request<void>(`{apiPrefix}/{child.ApiRoute}/${{{(child.KeyIsText ? $"encodeURIComponent(row['{child.KeyJson}'])" : $"row['{child.KeyJson}']")}}}`, {{ method: 'DELETE' }});");
                T($"      load{child.Name}(selectedRow!.{keyProp}!);");
                T("    } catch (err) {");
                T("      setError(err instanceof ApiError && err.status === 400 ? 'It cannot be deleted because it is in use!' : 'Problem while deleting!');");
                T("    }");
                T("  };");
            }
        }
        T();
        T("  const showError = (action: string, err: unknown) => {");
        T($"    if (err instanceof ApiError && err.status === 400) {{ setError({(hasName ? "'Name is bad or has special characters!'" : "'Some of the values are not acceptable!'")}); }}");
        T($"    else if (err instanceof ApiError && err.status === 404) {{ setError('This {Labels.Words(baseName).ToLowerInvariant()} no longer exists!'); load(page); }}");
        // a typed key can already be taken: the API answers 409
        if (textKey) T($"    else if (err instanceof ApiError && err.status === 409) {{ setError('A {Labels.Words(baseName).ToLowerInvariant()} with this {Labels.Column(keyColumn.Name).ToLowerInvariant()} already exists!'); }}");
        T("    else { setError('Problem while ' + action + '!'); }");
        T("  };");
        T();

        // ================= render
        T("  return (");
        T("    <div className=\"rail\">");
        T($"      <h1>{title.Pluralize()}</h1>");
        T("      <button type=\"button\" onClick={add}>Add New " + title + "</button>");
        if (canSearch)
        {
            T();
            T("      <div>");
            foreach (var f in searchFields)
            {
                T("        <input");
                T("          type=\"text\"");
                string searchLabel = listSearch ? "Search" : $"Search by {f.Label}";
                T($"          placeholder=\"{searchLabel}\"");
                T($"          aria-label=\"{searchLabel}\"");
                T($"          value={{filters.{f.ParamName}}}");
                T($"          onChange={{(event) => setFilters({{ ...filters, {f.ParamName}: event.target.value }})}}");
                T("        />");
            }
            T("        <button type=\"button\" onClick={search}>Search</button>");
            T("        <button type=\"button\" onClick={clearSearch}>Clear</button>");
            T("      </div>");
        }
        T();
        T("      {error && !selectedRow && <p>{error}</p>}"); // while the dialog is open the error shows inside it
        T();
        T("      <GridMenu sort={sort} onClear={clearSort}>");
        T("      <table>");
        T("        <thead>");
        T("          <tr>");
        foreach (var c in gridColumns)
        {
            if (sortableColumns.Contains(c))
                T($"            <SortHeader label=\"{GridCaption.For(c, Labels.Field(c))}\" column=\"{c.Name}\" sort={{sort}} onSort={{sortBy}} />");
            else
                T($"            <th>{GridCaption.For(c, Labels.Field(c))}</th>");
        }
        T("            <th>Actions</th>");
        T("          </tr>");
        T("        </thead>");
        T("        <tbody>");
        T($"          {{{listName}.map(({variable}) => (");
        T($"            <tr key={{{variable}.{keyProp}}}>");
        foreach (var c in gridColumns)
        {
            string prop = $"{variable}.{JsonNames.Camel(c.Name)}";
            var cellKind = form.CellOf(c);
            string cell;
            // A nullable column's value may be undefined: optional chaining keeps a strict (noUncheckedIndexedAccess/strictNullChecks) build compiling.
            if (cellKind == CellKind.Lookup) cell = $"{{{form.ParentOf(c)!.NameMethod}({prop})}}";
            else if (cellKind == CellKind.Boolean) cell = $"{{{prop} ? 'Yes' : 'No'}}";
            else if (cellKind == CellKind.Date) cell = $"{{{prop}{(c.IsNullable ? "?" : "")}.substring(0, 10)}}";
            else if (cellKind == CellKind.Money) { int d = NumericClassifier.CurrencyDigits(c); cell = $"{{{prop}{(c.IsNullable ? "?" : "")}.toLocaleString(undefined, {{ style: 'currency', currency: '{Project.CurrencyCode}', minimumFractionDigits: {Math.Min(2, d)}, maximumFractionDigits: {d} }})}}"; }
            else if (cellKind == CellKind.Decimal) cell = $"{{{prop}{(c.IsNullable ? "?" : "")}.toFixed(2)}}";
            else cell = $"{{{prop}}}";
            T($"              <td>{cell}</td>");
        }
        T("              <td>");
        T($"                <button type=\"button\" onClick={{() => edit({variable})}}>Edit</button>");
        if (canClone)
            T($"                <button type=\"button\" onClick={{() => void clone({variable}.{keyProp}!)}}>Clone</button>");
        T($"                <button type=\"button\" onClick={{() => void remove({variable}.{keyProp}!)}}>Delete</button>");
        T("              </td>");
        T("            </tr>");
        T("          ))}");
        T("        </tbody>");
        T("      </table>");
        T("      </GridMenu>");
        T();
        T("      <PaginationBar");
        T("        page={page}");
        T("        totalPages={totalPages}");
        T("        onPrevious={() => load(page - 1)}");
        T("        onNext={() => load(page + 1)}");
        T("      />");
        T("      <label className=\"page-size\">");
        T("        Rows per page");
        T($"        <select value={{pageSize}} onChange={{(event) => {{ const size = Number(event.target.value); setPageSize(size); load(1{(canSearch ? ", filters" : "")}, sort, size); }}}}>");
        T("          {pageSizeChoices.map((size) => <option key={size} value={size}>{size}</option>)}");
        T("        </select>");
        T("      </label>");
        T($"      {{loaded && {listName}.length === 0 && <p className=\"no-rows\">Nothing found.</p>}}");
        T();
        // The add/edit form is a modal <dialog> (native, no library): it opens over the page, wherever the grid is scrolled to, and Escape cancels it.
        T("      {selectedRow && (");
        T("        <dialog");
        T("          ref={(el) => { if (el && !el.open) el.showModal(); }}");
        T("          onCancel={(event) => { event.preventDefault(); cancel(); }}");
        T("        >");
        T("          {error && <p role=\"alert\">{error}</p>}");
        T($"          <h2>{{{(textKey ? "adding ? 'Add' : 'Edit'" : $"selectedRow.{keyProp} ? 'Edit' : 'Add'")}}} {title}</h2>");
        T("          <form onSubmit={handleSubmit}>");
        if (tabbed)
        {
            T("            <div role=\"tablist\">");
            for (int i = 0; i < formPages.Count; i++)
                T($"              <button type=\"button\" role=\"tab\" aria-selected={{tab === {i}}} style={{{{ fontWeight: tab === {i} ? 'bold' : 'normal' }}}} onClick={{() => setTab({i})}}>{formPages[i].Header.Replace("&", "&amp;")}</button>");
            T("            </div>");
        }
        for (int pageIndex = 0; pageIndex < formPages.Count; pageIndex++)
        {
        if (tabbed) T($"            <div role=\"tabpanel\" data-tab=\"{pageIndex}\" hidden={{tab !== {pageIndex}}}>");
        foreach (var c in formPages[pageIndex].Columns)
        {
            string id = form.FieldId(c);
            string prop = JsonNames.Camel(c.Name);
            var kind = form.KindOf(c);
            if (kind == FieldKind.SystemStamp)
            {
                // who made the row and when it changed: the system writes it, so it is text, shown once the row exists
                string stampValue = c.IsDateColumn ? $"{{selectedRow.{prop} ? new Date(selectedRow.{prop}).toLocaleString() : ''}}" : $"{{selectedRow.{prop} ?? ''}}";
                T($"            {{{(textKey ? "!adding" : $"selectedRow.{keyProp}")} && (");
                T("              <>");
                T("                <label htmlFor=\"" + id + "\">" + Labels.Field(c) + "</label>");
                T($"                <span id=\"{id}\">{stampValue}</span>");
                T("              </>");
                T("            )}");
                continue;
            }
            T("            <label htmlFor=\"" + id + "\">" + Labels.Field(c) + "</label>");
            if (kind == FieldKind.TypedKey)
            {
                // the key of a new row is typed; once the row exists it is read-only (the API does not change a key)
                T($"            <input");
                T($"              id=\"{id}\"");
                T("              type=\"text\"");
                T($"              aria-label=\"{Labels.Field(c)}\"");
                T($"              value={{selectedRow.{prop} ?? ''}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value }})}}");
                if (Chars(c) > 0) T($"              maxLength={{{Chars(c)}}}");
                T("              readOnly={!adding}");
                T($"              placeholder=\"{Labels.Placeholder(c)}\"");
                T("              required");
                T("            />");
            }
            else if (kind == FieldKind.Lookup)
            {
                var p = form.ParentOf(c)!;
                // A blank choice means "none": undefined for a nullable column (0 would be a key that does not exist); a required column starts blank too (0 shows as blank, and
                // the browser's required check then refuses it) instead of looking like the first parent is chosen while the row still holds 0.
                string numeric = p.KeyTs == "number"
                    ? (c.IsNullable ? "event.target.value === '' ? undefined : Number(event.target.value)" : "Number(event.target.value)")
                    : (c.IsNullable ? "event.target.value || undefined" : "event.target.value");
                string blankTest = p.KeyTs == "number" && !c.IsNullable ? "||" : "??";
                T($"            <select");
                T($"              id=\"{id}\"");
                T($"              aria-label=\"{Labels.Field(c)}\"");
                T($"              value={{selectedRow.{prop} {blankTest} ''}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: {numeric} }})}}");
                if (!c.IsNullable) T("              required");
                T("            >");
                T("              <option value=\"\"></option>");
                T($"              {{{ReactNames.ParentList(p)}.map((p) => (");
                T($"                <option key={{p.{p.KeyJson}}} value={{p.{p.KeyJson}}}>{{p.{p.DisplayJson}}}</option>");
                T("              ))}");
                T("            </select>");
            }
            else if (kind == FieldKind.Choices)
            {
                // A column whose values the database lists (a MySQL enum) is a drop-down of them; the blank first entry keeps a new row from silently taking the first value.
                T($"            <select");
                T($"              id=\"{id}\"");
                T($"              aria-label=\"{Labels.Field(c)}\"");
                T($"              value={{selectedRow.{prop} ?? ''}}");
                T(c.IsNullable ? $"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value || undefined }})}}" : $"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value }})}}");
                if (!c.IsNullable) T("              required");
                T("            >");
                T("              <option value=\"\"></option>");
                foreach (string choice in c.Choices!)
                    T($"              <option value=\"{ChoiceFormat.Html(choice)}\">{ChoiceFormat.Html(choice)}</option>");
                T("            </select>");
            }
            else if (kind == FieldKind.Boolean)
            {
                T($"            <input");
                T($"              id=\"{id}\"");
                T("              type=\"checkbox\"");
                T($"              aria-label=\"{Labels.Field(c)}\"");
                T($"              checked={{!!selectedRow.{prop}}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.checked }})}}");
                T("            />");
            }
            else if (kind == FieldKind.Date)
            {
                // A nullable date has a Clear button beside it (the date box's own clear is easy to miss, and WinUI3's calendar has a Clear button too).
                if (c.IsNullable) T("            <div style={{ display: 'flex', gap: 8 }}>");
                T($"            <input");
                T($"              id=\"{id}\"");
                T("              type=\"date\"");
                T($"              aria-label=\"{Labels.Field(c)}\"");
                T(c.IsNullable ? $"              value={{selectedRow.{prop} ?? ''}}" : $"              value={{selectedRow.{prop}}}");
                T(c.IsNullable ? $"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value || undefined }})}}" : $"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value }})}}");
                if (!c.IsNullable) T("              required");
                T("            />");
                if (c.IsNullable)
                {
                    T($"            <button type=\"button\" onClick={{() => setSelectedRow({{ ...selectedRow, {prop}: undefined }})}}>Clear</button>");
                    T("            </div>");
                }
            }
            else if (kind == FieldKind.Money)
            {
                // the money box shows $1,234.50 and takes the plain number; the limits are the column's CHECK constraint, or 0 for a column the project lists as never negative
                var money = MoneyBox.For(Model.TableName, c, Project);
                T($"            <CurrencyInput");
                T($"              id=\"{id}\"");
                T($"              label=\"{Labels.Field(c)}\"");
                T($"              value={{selectedRow.{prop}}}");
                T($"              onChange={{(value) => setSelectedRow({{ ...selectedRow, {prop}: value ?? {(c.IsNullable ? "undefined" : "0")} }})}}");
                T($"              digits={{{money.Digits}}}");
                T($"              currency=\"{money.Currency}\"");
                if (money.Min is { } lo) T($"              min={{{lo}}}");
                if (money.Max is { } hi) T($"              max={{{hi}}}");
                if (!c.IsNullable) T("              required");
                T("            />");
            }
            else if (kind == FieldKind.Number)
            {
                var box = NumberBox.For(Model.TableName, c, Project);
                T($"            <input");
                T($"              id=\"{id}\"");
                T("              type=\"number\"");
                T($"              aria-label=\"{Labels.Field(c)}\"");
                if (box.Characters is { } boxWidth) T($"              style={{{{ width: '{boxWidth}ch' }}}}");
                if (box.Step is { } step) T($"              step=\"{step}\"");
                // A whole-number column carries the limits its name and SQL type imply (a month 1-12, a year MinYear-MaxYear, ...).
                if (box.Min is { } min) T($"              min=\"{min}\"");
                if (box.Max is { } max) T($"              max=\"{max}\"");
                T($"              value={{selectedRow.{prop}}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: Number(event.target.value) }})}}");
                T($"              placeholder=\"{Labels.Placeholder(c)}\"");
                if (!c.IsNullable) T("              required");
                T("            />");
            }
            else if (kind == FieldKind.Multiline)
            {
                T($"            <textarea");
                T($"              id=\"{id}\"");
                T($"              aria-label=\"{Labels.Field(c)}\"");
                T($"              value={{selectedRow.{prop}}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value }})}}");
                T($"              maxLength={{{Chars(c)}}}");
                T($"              placeholder=\"{Labels.Placeholder(c)}\"");
                if (!c.IsNullable) T("              required");
                T("            />");
            }
            else
            {
                T($"            <input");
                T($"              id=\"{id}\"");
                T("              type=\"text\"");
                T($"              aria-label=\"{Labels.Field(c)}\"");
                T($"              value={{selectedRow.{prop}}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value }})}}");
                if (IsText(c) && Chars(c) > 0) T($"              maxLength={{{Chars(c)}}}");
                T($"              placeholder=\"{Labels.Placeholder(c)}\"");
                if (!c.IsNullable) T("              required");
                T("            />");
            }
        }
        if (tabbed) T("            </div>");
        }
        foreach (var child in editableChildren)
        {
            // the child's rows are part of the form: Submit saves them with the row, in one request
            var editColumns = child.EditColumns;
            T();
            T("            <fieldset>");
            T($"              <legend>{child.Title}</legend>");
            if (EditableChild.UsesCards(child.Link))
            {
                // too many columns for one table: each row is a block of labelled fields that wrap, so no box is squeezed
                T($"              {{{child.Variable}Rows.map((row, index) => (");
                T("                <div key={index} style={{ border: '1px solid #8886', borderRadius: 6, padding: '4px 12px 12px', marginBottom: 12 }}>");
                T("                  <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>");
                T($"                    <strong>{Labels.Words(BaseName(child.Table))} {{index + 1}}</strong>");
                T($"                    <button type=\"button\" onClick={{() => remove{child.Name}(row)}}>Remove</button>");
                T("                  </div>");
                T("                  <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(11rem, 1fr))', gap: '0 12px' }}>");
                foreach (var c in editColumns)
                    T($"                    <label style={{{{ display: 'flex', flexDirection: 'column'{(IsMultiline(c) ? ", gridColumn: '1 / -1'" : "")} }}}}><span>{GridCaption.For(c, Labels.Field(c))}</span>{ChildInput(child, c)}</label>");
                T("                  </div>");
                T("                </div>");
                T("              ))}");
                T($"              <button type=\"button\" onClick={{add{child.Name}}}>Add {Labels.Words(BaseName(child.Table))}</button>");
                T("            </fieldset>");
                continue;
            }
            T("              <table>");
            T("                <thead>");
            T("                  <tr>" + string.Concat(editColumns.Select(c => $"<th>{GridCaption.For(c, Labels.Field(c))}</th>")) + "<th></th></tr>");
            T("                </thead>");
            T("                <tbody>");
            T($"                  {{{child.Variable}Rows.map((row, index) => (");
            T("                    <tr key={index}>");
            foreach (var c in editColumns)
                T($"                      <td>{ChildInput(child, c)}</td>");
            T($"                      <td><button type=\"button\" onClick={{() => remove{child.Name}(row)}}>Remove</button></td>");
            T("                    </tr>");
            T("                  ))}");
            T("                </tbody>");
            T("              </table>");
            T($"              <button type=\"button\" onClick={{add{child.Name}}}>Add {Labels.Words(BaseName(child.Table))}</button>");
            T("            </fieldset>");
        }
        T();
        T("            <div className=\"form-buttons\">");
        T(tabbed ? "              <button type=\"submit\" onClick={revealInvalidTab}>Submit</button>" : "              <button type=\"submit\">Submit</button>");
        T("              <button type=\"button\" onClick={cancel}>Cancel</button>");
        T("            </div>");
        T("          </form>");
        T();
        if (gridChildren.Count > 0)
            T("          {/* Child grids: TableModel.ChildForeignKeys, one per table, columns discovered at run time */}");
        foreach (var child in gridChildren)
        {
            // the child grids show once the row is saved (a typed key is set on a new row too, so `adding` says which)
            T(textKey ? "          {!adding ? (" : $"          {{selectedRow.{keyProp} ? (");
            T("            <div>");
            T($"              <h3>{child.Title}</h3>");
            T($"              <GridMenu sort={{{child.Variable}Sort}} onClear={{clear{child.Name}Sort}}>");
            T("              <table>");
            T("                <thead>");
            T($"                  <tr>{{{child.Variable}Columns.map((col) => <SortHeader key={{col}} label={{caption(col)}} column={{col}} sort={{{child.Variable}Sort}} onSort={{sort{child.Name}By}} />)}}{(child.KeyJson is not null ? "<th>Actions</th>" : "")}</tr>");
            T("                </thead>");
            T("                <tbody>");
            T($"                  {{sortRows({child.Variable}Rows, {child.Variable}Sort{(child.Lookups.Count > 0 ? $", {child.Variable}Names[{child.Variable}Sort?.column ?? '']" : "")}).map((row, index) => (");
            // Clicking a row, or its Edit button, opens that row on its own page.
            T(child.KeyJson is not null ? $"                    <tr key={{index}} onClick={{() => edit{child.Name}(row)}} style={{{{ cursor: 'pointer' }}}}>" : "                    <tr key={index}>");
            // A date-and-time string from the API (2026-09-27T00:00:00) shows as its date only.
            T("                      {" + child.Variable + "Columns.map((col) => <td key={col}>{formatChildCell(row[col], col" + (child.Lookups.Count > 0 ? ", " + child.Variable + "Names[col]" : "") + ")}</td>)}");
            if (child.KeyJson is not null)
            {
                T("                      <td>");
                T($"                        <button type=\"button\" onClick={{(event) => {{ event.stopPropagation(); edit{child.Name}(row); }}}}>Edit</button>");
                T($"                        <button type=\"button\" onClick={{(event) => {{ event.stopPropagation(); void delete{child.Name}(row); }}}}>Delete</button>");
                T("                      </td>");
            }
            T("                    </tr>");
            T("                  ))}");
            T("                </tbody>");
            T("              </table>");
            T("              </GridMenu>");
            T("            </div>");
            T("          ) : (");
            T($"            <p><em>Save this {title} first to see its {child.Title} rows.</em></p>");
            T("          )}");
        }
        T("        </dialog>");
        T("      )}");
        T("    </div>");
        T("  );");
        T("}");

        // ================= test
        var test = new StringBuilder();
        void S(string s = "") => test.Append(s).Append('\n');
        S(textKey || editableChildren.Count > 0 ? "import { fireEvent, render, screen } from '@testing-library/react';" : "import { render, screen } from '@testing-library/react';");
        S("import { MemoryRouter } from 'react-router-dom';");
        S("import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';");
        S($"import {{ {baseName}DetailMasterPage }} from '../{baseName}DetailMasterPage';");
        S($"import {{ {ReactNames.ApiVar(Model.TableName)} }} from '../../{apiFolder}/{ReactNames.ApiFile(Model.TableName)}';");
        foreach (var p in parents.Where(p => !p.IsSelf))
            S($"import {{ {ReactNames.ApiVar(p.Table)} }} from '../../{apiFolder}/{ReactNames.ApiFile(p.Table)}';");
        S();
        S($"describe('{baseName}DetailMasterPage', () => {{");
        S("  beforeEach(() => {");
        S($"    vi.spyOn({ReactNames.ApiVar(Model.TableName)}, 'getPage').mockResolvedValue({{ items: [], page: 1, pageSize: {pageSize}, totalCount: 0, totalPages: 0 }});");
        foreach (var p in parents)
            S($"    vi.spyOn({ReactNames.ApiVar(p.Table)}, '{p.LoadMethod}').mockResolvedValue([]);");
        S("  });");
        S();
        S("  afterEach(() => {");
        S("    vi.restoreAllMocks();");
        S("  });");
        S();
        S($"  it('renders the {title} heading', async () => {{");
        S($"    render(<MemoryRouter><{baseName}DetailMasterPage /></MemoryRouter>);");
        S($"    expect(await screen.findByText('{title.Pluralize()}')).toBeInTheDocument();");
        S("  });");
        if (textKey)
        {
            // the key is typed on a new row and read-only on an existing one, and the child grids wait for the row to be saved; jsdom has no showModal, so the test gives the dialog one that just opens it
            string sampleKey = ApiSampleValues.KeyText(keyColumn);
            string sampleRow = "{ " + string.Join(", ", adds.Select((a, i) => i == 0 ? $"{keyProp}: '{sampleKey}'" : a)) + " }";
            S();
            S($"  it('lets the person type the key of a new {Labels.Words(baseName).ToLowerInvariant()}, does not let them change it afterwards, and shows the child grids only for a saved row', async () => {{");
            S("    HTMLDialogElement.prototype.showModal = function () { this.setAttribute('open', ''); };");
            S($"    vi.spyOn({ReactNames.ApiVar(Model.TableName)}, 'getPage').mockResolvedValue({{ items: [{sampleRow}], page: 1, pageSize: {pageSize}, totalCount: 1, totalPages: 1 }});");
            S($"    render(<MemoryRouter><{baseName}DetailMasterPage /></MemoryRouter>);");
            S($"    fireEvent.click(await screen.findByText('Add New {title}'));");
            S($"    expect(await screen.findByText('Add {title}')).toBeInTheDocument();");
            S($"    expect(screen.getByLabelText('{Labels.Field(keyColumn)}')).not.toHaveAttribute('readonly');");
            if (gridChildren.Count > 0)
                S($"    expect(screen.getAllByText(/Save this {title} first/)).toHaveLength({gridChildren.Count});");   // one note per child grid
            S("    fireEvent.click(screen.getByText('Cancel'));");
            S("    fireEvent.click(await screen.findByText('Edit'));");
            S($"    expect(await screen.findByText('Edit {title}')).toBeInTheDocument();");
            S($"    expect(screen.getByLabelText('{Labels.Field(keyColumn)}')).toHaveAttribute('readonly');");
            if (gridChildren.Count > 0)
                S($"    expect(screen.queryAllByText(/Save this {title} first/)).toHaveLength(0);");
            S("  });");
        }
        foreach (var child in editableChildren)
        {
            // the rows of an editable child list are part of the form: they can be added and removed before the row is saved; jsdom has no showModal, so the test gives the dialog one that just opens it
            S();
            S($"  it('adds and removes {child.Title.ToLowerInvariant()} rows in the form', async () => {{");
            S("    HTMLDialogElement.prototype.showModal = function () { this.setAttribute('open', ''); };");
            S($"    render(<MemoryRouter><{baseName}DetailMasterPage /></MemoryRouter>);");
            S($"    fireEvent.click(await screen.findByText('Add New {title}'));");
            S($"    fireEvent.click(await screen.findByText('Add {Labels.Words(BaseName(child.Table))}'));");
            S($"    fireEvent.click(screen.getByText('Add {Labels.Words(BaseName(child.Table))}'));");
            S("    expect(screen.getAllByText('Remove')).toHaveLength(2);");
            S("    fireEvent.click(screen.getAllByText('Remove')[0]);");
            S("    expect(screen.getAllByText('Remove')).toHaveLength(1);");
            S("  });");
        }
        S("});");

        var o = new StringBuilder();
        o.Append($"@@@FILE {pagesFolder}/{baseName}DetailMasterPage.tsx@@@\n").Append(ts);
        o.Append($"@@@FILE {pagesFolder}/__tests__/{baseName}DetailMasterPage.test.tsx@@@\n").Append(test);
        Write(o.ToString());
    }
#>
