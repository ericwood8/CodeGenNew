<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS -- the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string pagesFolder = "pages";
    string modelsFolder = "models";
    string apiFolder = "api";
    string apiPrefix = "/api";
    // Tables that have no API (C# enums, other *Type lookup tables, tables with no entity class): no screen is written for them.
    string[] noApiTables =
    {
        "ClearanceType", "ExpenseType", "LeaveType", "OvertimeType", "SY_RequestStatusType", "SY_RequestType",
        "SY_ResponseType", "SY_Role", "SY_Display", "SY_ISOCountry", "SY_PerDiem", "sysdiagrams"
    };
    // A foreign key to one of these is a plain number/text box, not a drop-down.
    string[] noLookupParents =
    {
        "ClearanceType", "ExpenseType", "LeaveType", "OvertimeType", "SY_Display", "SY_ISOCountry",
        "SY_RequestStatusType", "SY_RequestType", "SY_ResponseType", "SY_Role", "DepartmentTeam", "ProjectTask"
    };
    // A foreign key to this table is left off the screen (a styling id no one edits).
    string hiddenParent = "SY_Display";
    // Parents whose interface lives in another table's model file: table -> file name (without .ts).
    var modelFileOf = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["DepartmentTeam"] = "department",
        ["ProjectTask"] = "project"
    };
    // ==========================================================================================

    // ------------------------------------------------------------------------------------------
    // TSX_DetailMasterPage_v1.tt
    // TSX_Page_v1.tt's own grid + add/edit form -- identical field selection, lookups, error-as-state and
    // rail/no-invented-classes rules, see that template for the reasoning -- PLUS one read-only grid per table
    // in TableModel.ChildForeignKeys, shown under the form while editing an existing row. The React counterpart
    // of TS_DetailMasterComponent.tt, closing the same gap TSX_Page.tt's own header comment names explicitly
    // ("not written: a detail grid").
    //
    // Per the same answer that shaped WinUI3_DetailMasterScreen.tt/TS_DetailMasterComponent.tt ("just have the
    // generated code assume all are grids and the developer can cut out what grids are not needed"): EVERY
    // table in ChildForeignKeys gets a grid, unconditionally.
    //
    // A child grid calls the child table's API directly (request<any[]>('/api/<child>s'), filtering client-side
    // by the foreign key column) instead of importing a generated <Child>Api module the way every other lookup
    // in this template does -- same reason TS_DetailMasterComponent.tt's own header comment gives: TableModel is
    // built for exactly one table per generation run, so this template never sees the child table's own column
    // list or knows what its generated (or hand-written) api module looks like. Rows are loosely typed (any[]);
    // columns are whatever keys the first loaded row has (Object.keys), discovered at run time rather than
    // generation time -- the same "read the shape at run time, not generation time" idea the Angular and WinUI3
    // families already use for this exact gap.
    //
    // Only loaded once the row being edited has a real key (a brand-new, unsaved row has no child rows yet);
    // the child sections show a "save first" message instead while adding.
    //
    // Requires a primary key that is a single int or uniqueidentifier column (same as TSX_Page.tt) and at
    // least one table in TableModel.ChildForeignKeys (TableModel.HasAtLeastOneChildForeignKey) -- a table with
    // none is exactly what TSX_Page.tt is for.
    //
    // ------------------------------------------------------------------------------------------

    string BaseName(string table) => Regex.Replace(Regex.Replace(table, "^E_", ""), "^SY_", "");
    string LowerFirst(string s) => s.Length == 0 ? s : char.ToLowerInvariant(s[0]) + s[1..];
    string UpperFirst(string s) => s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
    string Words(string s) => Regex.Replace(s.Replace('_', ' '), "(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])", " ").Trim();
    string Camel(string name)
    {
        if (string.IsNullOrEmpty(name) || !char.IsUpper(name[0])) return name;
        var chars = name.ToCharArray();
        for (int i = 0; i < chars.Length; i++)
        {
            if (i == 1 && !char.IsUpper(chars[i])) break;
            bool hasNext = i + 1 < chars.Length;
            if (i > 0 && hasNext && !char.IsUpper(chars[i + 1])) break;
            chars[i] = char.ToLowerInvariant(chars[i]);
        }
        return new string(chars);
    }
    bool IsDate(ColumnModel c) => c.SqlType is SqlDbType.Date or SqlDbType.DateTime or SqlDbType.DateTime2 or SqlDbType.SmallDateTime;
    bool IsNumber(ColumnModel c) => c.SqlType is SqlDbType.Int or SqlDbType.BigInt or SqlDbType.SmallInt or SqlDbType.TinyInt
        or SqlDbType.Decimal or SqlDbType.Money or SqlDbType.SmallMoney or SqlDbType.Float or SqlDbType.Real;
    bool IsText(ColumnModel c) => c.SqlType is SqlDbType.Char or SqlDbType.VarChar or SqlDbType.NChar or SqlDbType.NVarChar;
    int Chars(ColumnModel c) => c.MaxLength is null ? 0 : (c.SqlType is SqlDbType.NChar or SqlDbType.NVarChar ? c.MaxLength.Value / 2 : c.MaxLength.Value);
    bool IsMultiline(ColumnModel c) => IsText(c) && Chars(c) >= 100;
    string Label(string columnName)
    {
        string s = Regex.Replace(Regex.Replace(columnName, "^SY_", ""), "Id$", "");
        return Words(s);
    }
    string ApiRoute(string table) => BaseName(table).ToLowerInvariant().Pluralize();

    var keyColumn = Model.PrimaryKeyColumns.Count == 1 ? Model.PrimaryKeyColumns[0] : null;
    if (noApiTables.Contains(Model.TableName, StringComparer.OrdinalIgnoreCase))
    {
        Error($"TSX_DetailMasterPage writes no screen for [{Model.SchemaName}].[{Model.TableName}]: it is listed in noApiTables (an enum, a *Type lookup table, or a table with no entity class), so there is no API for it to show.");
    }
    else if (keyColumn is null || keyColumn.SqlType is not (SqlDbType.Int or SqlDbType.UniqueIdentifier))
    {
        Error($"TSX_DetailMasterPage needs a table with a single int or uniqueidentifier primary key (the routes take the id as {{id:int}} or {{id:guid}}), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else if (!Model.HasAtLeastOneChildForeignKey)
    {
        Error($"TSX_DetailMasterPage needs at least one other table with a foreign key pointing back at [{Model.SchemaName}].[{Model.TableName}]; none was found -- use TSX_Page instead.");
    }
    else if (Model.IsNameActiveTable)
    {
        Error($"TSX_DetailMasterPage assumes a plain getAll()-style API. [{Model.SchemaName}].[{Model.TableName}] has a Name and an IsActive column, so its repository is a NameActiveRepo and its real API is always hand-maintained (and commonly has no plain getAll() at all -- see TimeEntryServer's real DepartmentTeamApi.cs); write this screen by hand.");
    }
    else
    {
        string baseName = BaseName(Model.TableName);
        string stem = baseName.ToLowerInvariant();
        string variable = LowerFirst(baseName);
        string listName = variable.Pluralize();
        string setList = "set" + UpperFirst(listName);
        string keyProp = Camel(keyColumn.Name);
        string keyTs = keyColumn.SqlType == SqlDbType.Int ? "number" : "string";
        string emptyKey = keyColumn.SqlType == SqlDbType.Int ? "0" : "'00000000-0000-0000-0000-000000000000'";
        string title = Words(baseName);
        bool hasName = Model.Columns.Any(c => c.IsStringColumn && c.Name == "Name");

        var fkByColumn = Model.ForeignKeys.Where(f => f.ReferencingColumns.Count == 1)
            .GroupBy(f => f.ReferencingColumns[0], StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        var shown = Model.Columns
            .Where(c => !c.IsPrimaryKey && !c.IsComputed && !c.IsIdentity
                        && !(fkByColumn.TryGetValue(c.Name, out var hfk) && hfk.ReferencedTable.Equals(hiddenParent, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(c => c.Name == "Name" ? 0 : 1).ThenBy(c => c.OrdinalPosition)
            .ToList();

        ForeignKeyModel LookupOf(ColumnModel c) =>
            fkByColumn.TryGetValue(c.Name, out var fk)
            && !noLookupParents.Contains(fk.ReferencedTable, StringComparer.OrdinalIgnoreCase)
            && fk.ReferencedDisplayColumns.Count > 0
                ? fk : null;
        var parents = shown.Select(c => LookupOf(c)).Where(fk => fk is not null)
            .GroupBy(fk => fk.ReferencedTable, StringComparer.OrdinalIgnoreCase).Select(g => g.First())
            .Select(fk =>
            {
                string parentBase = BaseName(fk.ReferencedTable);
                bool self = fk.ReferencedTable.Equals(Model.TableName, StringComparison.OrdinalIgnoreCase);
                string pList = LowerFirst(parentBase).Pluralize();
                return new
                {
                    Table = fk.ReferencedTable,
                    Type = parentBase,
                    ModelFile = modelFileOf.TryGetValue(fk.ReferencedTable, out var mf) ? mf : parentBase.ToLowerInvariant(),
                    ApiVar = LowerFirst(parentBase) + "Api",
                    ApiFile = parentBase.ToLowerInvariant() + "Api",
                    List = pList,
                    SetList = "set" + UpperFirst(pList),
                    NameMethod = LowerFirst(parentBase) + "Name",
                    KeyProp = Camel(fk.ReferencedColumns[0]),
                    IdType = Model.Columns.First(col => col.Name.Equals(fk.ReferencingColumns[0], StringComparison.OrdinalIgnoreCase)).SqlType == SqlDbType.UniqueIdentifier ? "string" : "number",
                    DisplayProp = Camel(fk.ReferencedDisplayColumns[0]),
                    Self = self
                };
            }).ToList();
        var parentOf = parents.ToDictionary(p => p.Table, StringComparer.OrdinalIgnoreCase);

        var children = Model.ChildForeignKeys
            .Where(fk => fk.ReferencingColumns.Count == 1 && !noApiTables.Contains(fk.ReferencingTable, StringComparer.OrdinalIgnoreCase))
            .Select(fk => new
            {
                Table = fk.ReferencingTable,
                Title = Words(BaseName(fk.ReferencingTable)),
                Var = LowerFirst(BaseName(fk.ReferencingTable)),
                MethodName = BaseName(fk.ReferencingTable),
                Route = ApiRoute(fk.ReferencingTable),
                FkProp = Camel(fk.ReferencingColumns[0])
            }).ToList();

        string Id(ColumnModel c) => stem + "-" + Camel(c.Name).ToLowerInvariant();
        string PlaceholderFor(ColumnModel c) => "Enter " + Label(c.Name).ToLowerInvariant();
        string LabelOf(ColumnModel c) => c.SqlType == SqlDbType.Bit ? Regex.Replace(Label(c.Name), "^Is ", "") + "?" : Label(c.Name);
        var gridColumns = shown.Where(c => !IsMultiline(c)).ToList();
        if (gridColumns.Count == 0) gridColumns = shown.ToList();

        var ts = new StringBuilder();
        void T(string s = "") => ts.Append(s).Append('\n');

        // ================= imports
        T("import { useEffect, useState } from 'react';");
        T("import type { FormEvent } from 'react';");
        T($"import type {{ {baseName} }} from '../{modelsFolder}/{stem}';");
        T($"import {{ {variable}Api }} from '../{apiFolder}/{stem}Api';");
        T($"import {{ ApiError, request }} from '../{apiFolder}/client';");
        foreach (var p in parents.Where(p => !p.Self))
        {
            T($"import type {{ {p.Type} }} from '../{modelsFolder}/{p.ModelFile}';");
            T($"import {{ {p.ApiVar} }} from '../{apiFolder}/{p.ApiFile}';");
        }
        T();
        T($"export function {baseName}DetailMasterPage() {{");
        T($"  const [{listName}, {setList}] = useState<{baseName}[]>([]);");
        foreach (var p in parents.Where(p => !p.Self))
            T($"  const [{p.List}, {p.SetList}] = useState<{p.Type}[]>([]);");
        T($"  const [selectedRow, setSelectedRow] = useState<{baseName} | null>(null);");
        if (hasName) T("  const [searchText, setSearchText] = useState('');");
        T("  const [error, setError] = useState<string | null>(null);");
        foreach (var child in children)
        {
            T($"  const [{child.Var}Rows, set{child.MethodName}Rows] = useState<any[]>([]);");
            T($"  const [{child.Var}Columns, set{child.MethodName}Columns] = useState<string[]>([]);");
        }
        T();
        T("  const load = () => {");
        T($"    {variable}Api.getAll().then({setList}).catch(() => setError('Failed to load {Words(baseName).ToLowerInvariant()}s.'));");
        T("  };");
        T();
        T("  useEffect(() => {");
        T("    load();");
        foreach (var p in parents.Where(p => !p.Self))
            T($"    {p.ApiVar}.getAll().then({p.SetList}).catch(() => {{}});");
        T("  }, []);");
        T();
        T($"  const submit = async ({variable}: {baseName}): Promise<void> => {{");
        T("    setError(null);");
        T($"    try {{");
        T($"      if ({variable}.{keyProp}) {{");
        T($"        await {variable}Api.update({variable}.{keyProp}, {variable});");
        T("      } else {");
        T($"        {variable}.{keyProp} = {emptyKey};");
        T($"        await {variable}Api.create({variable});");
        T("      }");
        T("      setSelectedRow(null);");
        T("      load();");
        T("    } catch (err) {");
        T("      showError('saving', err);");
        T("    }");
        T("  };");
        T();
        T("  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {");
        T("    event.preventDefault();");
        T("    if (selectedRow) void submit(selectedRow);");
        T("  };");
        T();
        T($"  const remove = async (id: {keyTs}): Promise<void> => {{");
        T("    if (!confirm('Are you sure you want to delete this?')) return;");
        T("    try {");
        T($"      await {variable}Api.delete(id);");
        T($"      {setList}(({listName}) => {listName}.filter((p) => p.{keyProp} !== id));");
        T("    } catch (err) {");
        T("      if (err instanceof ApiError && err.status === 400) {");
        T("        setError('It cannot be deleted because it is in use!');");
        T("      } else if (err instanceof ApiError && err.status === 404) {");
        T("        setError('It no longer exists!');");
        T("        load();");
        T("      } else {");
        T("        setError('Problem while deleting!');");
        T("      }");
        T("    }");
        T("  };");
        T();
        var adds = new List<string>();
        foreach (var c in Model.Columns.Where(c => !c.IsPrimaryKey && !c.IsNullable && !c.IsComputed && !c.IsIdentity))
        {
            string value;
            if (c.SqlType == SqlDbType.Bit) value = c.DatabaseDefaultSql is not null && c.DatabaseDefaultSql.Trim('(', ')', ' ') == "1" ? "true" : "false";
            else if (IsDate(c)) value = "new Date().toISOString().substring(0, 10)";
            else if (IsNumber(c)) value = "0";
            else value = "''";
            adds.Add($"{Camel(c.Name)}: {value}");
        }
        T("  const add = () => {");
        T(adds.Count == 0 ? "    setSelectedRow({});" : $"    setSelectedRow({{ {string.Join(", ", adds)} }});");
        foreach (var child in children)
        {
            T($"    set{child.MethodName}Rows([]);");
            T($"    set{child.MethodName}Columns([]);");
        }
        T("  };");
        T();
        T($"  const edit = ({variable}: {baseName}) => {{");
        T($"    const row = {{ ...{variable} }};");
        var dateColumns = shown.Where(IsDate).ToList();
        if (dateColumns.Count > 0)
        {
            T("    // the date box wants yyyy-MM-dd; the API sends a full timestamp");
            foreach (var c in dateColumns)
            {
                string prop = $"row.{Camel(c.Name)}";
                if (c.IsNullable) T($"    if ({prop}) {{ {prop} = {prop}.substring(0, 10); }}");
                else T($"    {prop} = {prop}.substring(0, 10);");
            }
        }
        T("    setSelectedRow(row);");
        foreach (var child in children)
            T($"    load{child.MethodName}({variable}.{keyProp}!);");
        T("  };");
        T();
        T("  const cancel = () => {");
        T("    setSelectedRow(null);");
        T("  };");
        if (hasName)
        {
            T();
            T("  const search = () => {");
            T("    setSelectedRow(null);");
            T($"    {variable}Api.findByName(searchText).then({setList}).catch(() => setError('Search failed.'));");
            T("  };");
        }
        foreach (var p in parents)
        {
            T();
            T($"  // the name to show in place of a {p.Type} id");
            T($"  const {p.NameMethod} = (id?: {p.IdType}): string => {{");
            T($"    return {p.List}.find((p) => p.{p.KeyProp} === id)?.{p.DisplayProp} ?? '';");
            T("  };");
        }
        foreach (var child in children)
        {
            T();
            T($"  // {child.Title} rows whose {child.FkProp} matches the row being edited -- the whole table is loaded and");
            T("  // filtered client-side (same no-paging simplification TSX_Page.tt's own grid makes), and the columns");
            T("  // shown are whatever keys the first row actually has, since this template never sees the child's own schema.");
            T($"  const load{child.MethodName} = (parentId: {keyTs}) => {{");
            T($"    request<any[]>('{apiPrefix}/{child.Route}').then((rows) => {{");
            T($"      const filtered = rows.filter((r) => r['{child.FkProp}'] === parentId);");
            T($"      set{child.MethodName}Rows(filtered);");
            T($"      set{child.MethodName}Columns(filtered.length > 0 ? Object.keys(filtered[0]) : []);");
            T("    }).catch(() => {});");
            T("  };");
        }
        T();
        T("  const showError = (action: string, err: unknown) => {");
        T($"    if (err instanceof ApiError && err.status === 400) {{ setError({(hasName ? "'Name is bad or has special characters!'" : "'Some of the values are not acceptable!'")}); }}");
        T($"    else if (err instanceof ApiError && err.status === 404) {{ setError('This {Words(baseName).ToLowerInvariant()} no longer exists!'); load(); }}");
        T("    else { setError('Problem while ' + action + '!'); }");
        T("  };");
        T();

        // ================= render
        T("  return (");
        T("    <div className=\"rail\">");
        T($"      <h1>{title}s</h1>");
        T("      <button type=\"button\" onClick={add}>Add New " + title + "</button>");
        if (hasName)
        {
            T();
            T("      <div>");
            T("        <input");
            T("          type=\"text\"");
            T("          placeholder=\"Search by Name\"");
            T("          aria-label=\"Search by Name\"");
            T("          value={searchText}");
            T("          onChange={(event) => setSearchText(event.target.value)}");
            T("        />");
            T("        <button type=\"button\" onClick={search}>Search</button>");
            T("      </div>");
        }
        T();
        T("      {error && <p>{error}</p>}");
        T();
        T("      <table>");
        T("        <thead>");
        T("          <tr>");
        foreach (var c in gridColumns)
            T($"            <th>{LabelOf(c)}</th>");
        T("            <th>Actions</th>");
        T("          </tr>");
        T("        </thead>");
        T("        <tbody>");
        T($"          {{{listName}.map(({variable}) => (");
        T($"            <tr key={{{variable}.{keyProp}}}>");
        foreach (var c in gridColumns)
        {
            string prop = $"{variable}.{Camel(c.Name)}";
            var lookup = LookupOf(c);
            string cell;
            if (lookup is not null) cell = $"{{{parentOf[lookup.ReferencedTable].NameMethod}({prop})}}";
            else if (c.SqlType == SqlDbType.Bit) cell = $"{{{prop} ? 'Yes' : 'No'}}";
            else if (IsDate(c)) cell = $"{{{prop}.substring(0, 10)}}";
            else if (c.SqlType is SqlDbType.Decimal or SqlDbType.Money or SqlDbType.SmallMoney) cell = $"{{{prop}.toFixed(2)}}";
            else cell = $"{{{prop}}}";
            T($"              <td>{cell}</td>");
        }
        T("              <td>");
        T($"                <button type=\"button\" onClick={{() => edit({variable})}}>Edit</button>");
        T($"                <button type=\"button\" onClick={{() => void remove({variable}.{keyProp}!)}}>Delete</button>");
        T("              </td>");
        T("            </tr>");
        T("          ))}");
        T("        </tbody>");
        T("      </table>");
        T();
        T("      {selectedRow && (");
        T("        <div>");
        T($"          <h2>{{selectedRow.{keyProp} ? 'Edit' : 'Add'}} {title}</h2>");
        T("          <form onSubmit={handleSubmit}>");
        foreach (var c in shown)
        {
            string id = Id(c);
            string prop = Camel(c.Name);
            var lookup = LookupOf(c);
            T("            <label htmlFor=\"" + id + "\">" + LabelOf(c) + "</label>");
            if (lookup is not null)
            {
                var p = parentOf[lookup.ReferencedTable];
                string numeric = p.IdType == "number" ? "Number(event.target.value)" : "event.target.value";
                T($"            <select");
                T($"              id=\"{id}\"");
                T($"              aria-label=\"{LabelOf(c)}\"");
                T($"              value={{selectedRow.{prop} ?? ''}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: {numeric} }})}}");
                if (!c.IsNullable) T("              required");
                T("            >");
                if (c.IsNullable) T("              <option value=\"\"></option>");
                T($"              {{{p.List}.map((p) => (");
                T($"                <option key={{p.{p.KeyProp}}} value={{p.{p.KeyProp}}}>{{p.{p.DisplayProp}}}</option>");
                T("              ))}");
                T("            </select>");
            }
            else if (c.SqlType == SqlDbType.Bit)
            {
                T($"            <input");
                T($"              id=\"{id}\"");
                T("              type=\"checkbox\"");
                T($"              aria-label=\"{LabelOf(c)}\"");
                T($"              checked={{!!selectedRow.{prop}}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.checked }})}}");
                T("            />");
            }
            else if (IsDate(c))
            {
                T($"            <input");
                T($"              id=\"{id}\"");
                T("              type=\"date\"");
                T($"              aria-label=\"{LabelOf(c)}\"");
                T($"              value={{selectedRow.{prop}}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value }})}}");
                if (!c.IsNullable) T("              required");
                T("            />");
            }
            else if (IsNumber(c))
            {
                string step = c.SqlType is SqlDbType.Decimal && (c.Scale ?? 0) > 0 ? "0." + new string('0', c.Scale!.Value - 1) + "1"
                            : c.SqlType is SqlDbType.Money or SqlDbType.SmallMoney ? "0.01"
                            : c.SqlType is SqlDbType.Float or SqlDbType.Real ? "any" : null;
                T($"            <input");
                T($"              id=\"{id}\"");
                T("              type=\"number\"");
                T($"              aria-label=\"{LabelOf(c)}\"");
                if (step is not null) T($"              step=\"{step}\"");
                T($"              value={{selectedRow.{prop}}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: Number(event.target.value) }})}}");
                T($"              placeholder=\"{PlaceholderFor(c)}\"");
                if (!c.IsNullable) T("              required");
                T("            />");
            }
            else if (IsMultiline(c))
            {
                T($"            <textarea");
                T($"              id=\"{id}\"");
                T($"              aria-label=\"{LabelOf(c)}\"");
                T($"              value={{selectedRow.{prop}}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value }})}}");
                T($"              maxLength={{{Chars(c)}}}");
                T($"              placeholder=\"{PlaceholderFor(c)}\"");
                if (!c.IsNullable) T("              required");
                T("            />");
            }
            else
            {
                T($"            <input");
                T($"              id=\"{id}\"");
                T("              type=\"text\"");
                T($"              aria-label=\"{LabelOf(c)}\"");
                T($"              value={{selectedRow.{prop}}}");
                T($"              onChange={{(event) => setSelectedRow({{ ...selectedRow, {prop}: event.target.value }})}}");
                if (IsText(c) && Chars(c) > 0) T($"              maxLength={{{Chars(c)}}}");
                T($"              placeholder=\"{PlaceholderFor(c)}\"");
                if (!c.IsNullable) T("              required");
                T("            />");
            }
        }
        T();
        T("            <button type=\"submit\">Submit</button>");
        T("            <button type=\"button\" onClick={cancel}>Cancel</button>");
        T("          </form>");
        T();
        T("          {/* Child grids: TableModel.ChildForeignKeys, one per table, columns discovered at run time */}");
        foreach (var child in children)
        {
            T($"          {{selectedRow.{keyProp} ? (");
            T("            <div>");
            T($"              <h3>{child.Title}</h3>");
            T("              <table>");
            T("                <thead>");
            T($"                  <tr>{{{child.Var}Columns.map((col) => <th key={{col}}>{{col}}</th>)}}</tr>");
            T("                </thead>");
            T("                <tbody>");
            T($"                  {{{child.Var}Rows.map((row, index) => (");
            T("                    <tr key={index}>");
            T($"                      {{{child.Var}Columns.map((col) => <td key={{col}}>{{row[col]}}</td>)}}");
            T("                    </tr>");
            T("                  ))}");
            T("                </tbody>");
            T("              </table>");
            T("            </div>");
            T("          ) : (");
            T($"            <p><em>Save this {title} first to see its {child.Title} rows.</em></p>");
            T("          )}");
        }
        T("        </div>");
        T("      )}");
        T("    </div>");
        T("  );");
        T("}");

        // ================= test
        var test = new StringBuilder();
        void S(string s = "") => test.Append(s).Append('\n');
        S("import { render, screen } from '@testing-library/react';");
        S("import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';");
        S($"import {{ {baseName}DetailMasterPage }} from '../{baseName}DetailMasterPage';");
        S($"import {{ {variable}Api }} from '../../{apiFolder}/{stem}Api';");
        foreach (var p in parents.Where(p => !p.Self))
            S($"import {{ {p.ApiVar} }} from '../../{apiFolder}/{p.ApiFile}';");
        S();
        S($"describe('{baseName}DetailMasterPage', () => {{");
        S("  beforeEach(() => {");
        S($"    vi.spyOn({variable}Api, 'getAll').mockResolvedValue([]);");
        foreach (var p in parents.Where(p => !p.Self))
            S($"    vi.spyOn({p.ApiVar}, 'getAll').mockResolvedValue([]);");
        S("  });");
        S();
        S("  afterEach(() => {");
        S("    vi.restoreAllMocks();");
        S("  });");
        S();
        S($"  it('renders the {title} heading', async () => {{");
        S($"    render(<{baseName}DetailMasterPage />);");
        S($"    expect(await screen.findByText('{title}s')).toBeInTheDocument();");
        S("  });");
        S("});");

        var o = new StringBuilder();
        o.Append($"@@@FILE {pagesFolder}/{baseName}DetailMasterPage.tsx@@@\n").Append(ts);
        o.Append($"@@@FILE {pagesFolder}/__tests__/{baseName}DetailMasterPage.test.tsx@@@\n").Append(test);
        Write(o.ToString());
    }
#>
