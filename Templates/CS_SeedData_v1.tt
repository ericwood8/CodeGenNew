<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // CS_SeedData_v1.tt
    // Generates: SeedData.cs   (see OutputName in CS_SeedData_v1.tt.config)
    // The class that runs the seed class of every table in the project's SeedTables (CS_Seed), in the order the setting lists them, and an extension on WebApplication to call it at start-up:
    // <c>await app.SeedGeneratedDataAsync();</c> in Program.cs after the database exists. A table that already has rows is left alone, so it is safe to run on every start.
    // Full notes: Docs/TemplateNotes/CS_Seed_v1.md
    // ==========================================================================================
    string projectName = Project.ProjectName ?? "MyApp";
    string contextNamespace = Project.ContextNamespace ?? projectName + ".App.Data";
    string contextType = Project.ContextName ?? projectName + "Context";

    var tables = Database.SeedTables(Project);
    var unknown = Project.SeedTables.Where(name => !tables.Any(t => t.TableName.EqualsIgnoreCase(name))).ToList();
    if (tables.Count == 0)
        Error("CS_SeedData found no table to seed: the project's SeedTables names none that has an entity.");
    else if (unknown.Count > 0)
        Error("CS_SeedData: SeedTables names " + string.Join(", ", unknown) + ", which has no entity here (a missing table, an enum or a table with no repository).");
    else
    {
        var o = new StringBuilder();
        void L(string text = "") => o.Append(text).Append('\n');
        L($"namespace {contextNamespace};");
        L();
        L("/// <summary> Generated by CS_SeedData: runs the seed class of each table in the project's SeedTables, parents first. Each adds its rows only when its table is empty. </summary>");
        L("public static class SeedData");
        L("{");
        L($"    public static async Task SeedAsync({contextType} context, CancellationToken cancellationToken = default)");
        L("    {");
        foreach (var table in tables)
            L($"        await {table.TableName}Seed.SeedAsync(context, cancellationToken);");
        L("    }");
        L();
        L("    /// <summary> Seeds from Program.cs once the database exists: <c>await app.SeedGeneratedDataAsync();</c>. </summary>");
        L("    public static async Task SeedGeneratedDataAsync(this WebApplication app)");
        L("    {");
        L("        using var scope = app.Services.CreateScope();");
        L($"        await SeedAsync(scope.ServiceProvider.GetRequiredService<{contextType}>());");
        L("    }");
        L("}");
        Write(o.ToString());
    }
#>
