# Restriction checkboxes for API_Csv_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t.
DatabaseOnly=true
RequiresPrimaryKey=false
TableOnly=false
# Named Csv.cs, in the API project's Apis folder.
OutputName=Csv.cs
# Whole-project generation (codegen generate): for a project that sets ApiCsv=true (or names the template in PlanAlso).
Stacks=Api
OutputFolder=Apis
InPlan=false
