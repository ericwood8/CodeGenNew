# Restriction checkboxes for UNO_DetailMasterScreen_v1.tt (see Docs/Reference.md section 3).
Requires=PrimaryKey,SingleKey,NotNameActive,ChildTables
# The generated API takes the key as an int, a long, a Guid or text, and a name/active table's API is hand-maintained (no plain GetAll).
# Only offered for a table that is the "parent" side of at least one foreign key (TableModel.ChildForeignKeys) --
# otherwise it's exactly UNO_DetailScreen with nothing extra to show, so use that instead.
# The drop-downs for foreign keys show the parent table's display column, so ask for it.
NeedsReferencedDisplayColumns=true
# No OutputName: the template writes its own paths (Views/..., ViewModels/...) with @@@FILE markers.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Uno
PlanTables=ScreenDetailMaster
