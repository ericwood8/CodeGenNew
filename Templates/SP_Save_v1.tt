<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // MySQL has real stored procedures with its own syntax: CodeGenNew.Core's MySqlProcedures writes this one for a table read from MySQL.
    if (Model.Dialect == SqlDialect.MySql)
    {
        Write(MySqlProcedures.Save(Model));
        return GenerationEnvironment.ToString();
    }
#>
<#
    // PostgreSQL has functions rather than stored procedures: CodeGenNew.Core's PostgresProcedures writes this one for a table read from PostgreSQL.
    if (Model.Dialect == SqlDialect.PostgreSql)
    {
        Write(PostgresProcedures.Save(Model));
        return GenerationEnvironment.ToString();
    }
#>
<#
    // ==========================================================================================
    // SP_Save_v1.tt
    // Generates: <TableName>_Save.sql
    // Insert-or-update in one routine: a row with the supplied primary key is updated, otherwise inserted, so a business rule lives in one place.
    // The caller must always pass the whole record (no NULL-means-untouched trick as in SP_Update). Needs a primary key.
    // SQL Server procedure, PostgreSQL function or MySQL procedure, by the source database.
    // Full notes: Docs/TemplateNotes/SP_Save_v1.md

    bool IsTextLob(ColumnModel c) => c.SqlType is SqlDbType.Text or SqlDbType.NText;
    bool IsRowVersion(ColumnModel c) =>
        c.SqlTypeDeclaration.Equals("timestamp", StringComparison.OrdinalIgnoreCase) ||
        c.SqlTypeDeclaration.Equals("rowversion", StringComparison.OrdinalIgnoreCase);

    // A single identity key (or an identity column inside a composite key) is the OUTPUT parameter.
    var identityKey = Model.PrimaryKeyColumns.FirstOrDefault(c => c.IsIdentity);

    var parameterColumns = Model.Columns
        .Where(c => !c.IsComputed && !IsRowVersion(c)
                    && !c.IsCreateDateColumn && !c.IsModifiedDateColumn && !c.IsLastChangedDateColumn
                    && (!c.IsIdentity || c.IsPrimaryKey))
        .ToList();

    var pkColumns = Model.PrimaryKeyColumns;
    string whereClause = string.Join(" AND ", pkColumns.Select(pk => $"[{pk.Name}] = {pk.ParameterName}"));

    bool hasActivePair = Model.HasActiveInactivePair && Model.ActiveColumn is not null;
    var activeCol = hasActivePair ? Model.ActiveColumn : null;

    // Literal for "inactive"/"active" in the active-flag column's own polarity (IsInactive-style is inverted).
    bool activeIsNegativePolarity = activeCol is not null && activeCol.Name.Contains("Inactive", StringComparison.OrdinalIgnoreCase);
    string Literal(ColumnModel c, string value) => c.IsStringColumn ? $"'{value}'" : value;
    string inactiveLiteral = activeCol is null ? "" : Literal(activeCol, activeIsNegativePolarity ? "1" : "0");
    string activeLiteral = activeCol is null ? "" : Literal(activeCol, activeIsNegativePolarity ? "0" : "1");

    // "Was a value supplied?" for the inactivation triggers. Whole record is passed on Save, so an empty
    // string counts as "not supplied" (a NOT NULL reason column is trimmed to '' above).
    string Supplied(ColumnModel c) => c.IsStringColumn ? $"DATALENGTH({c.ParameterName}) > 0" : $"{c.ParameterName} IS NOT NULL";
    var inactivationTriggers = new List<ColumnModel>();
    if (hasActivePair && Model.InactiveDateColumn is not null)
        inactivationTriggers.Add(Model.InactiveDateColumn);
    if (hasActivePair)
        inactivationTriggers.AddRange(Model.Columns.Where(c => c.IsInactiveReasonColumn && parameterColumns.Contains(c)));

    // ==== UPDATE: (column, value) pairs. Everything but the primary key; the active flag via CASE.
    var updatePairs = new List<(string Name, string Value)>();
    foreach (var c in parameterColumns.Where(c => !c.IsPrimaryKey && !c.IsCreateUserColumn))
    {
        if (c == activeCol)
        {
            updatePairs.Add((c.Name, inactivationTriggers.Count > 0
                ? $"CASE WHEN {string.Join(" OR ", inactivationTriggers.Select(Supplied))} THEN {inactiveLiteral} ELSE {c.ParameterName} END"
                : c.ParameterName));
        }
        else
        {
            updatePairs.Add((c.Name, c.ParameterName));
        }
    }
    foreach (var c in Model.Columns.Where(c => !c.IsComputed && (c.IsModifiedDateColumn || c.IsLastChangedDateColumn)))
        updatePairs.Add((c.Name, "GETDATE()"));

    // ==== INSERT: (column, value) pairs, mirroring SP_Insert.tt.
    var insertPairs = parameterColumns
        .Where(c => c != identityKey && !c.IsInactiveReasonColumn && !c.IsAdminFlagColumn && !c.IsModifiedUserColumn
                    && c != Model.InactiveDateColumn && c != activeCol)
        .Select(c => (Name: c.Name, Value: c.ParameterName))
        .ToList();
    foreach (var c in Model.Columns.Where(c => !c.IsComputed && (c.IsCreateDateColumn || c.IsLastChangedDateColumn)))
        insertPairs.Add((c.Name, "GETDATE()"));
    if (activeCol is not null)
        insertPairs.Add((activeCol.Name, activeLiteral));
    foreach (var c in Model.Columns.Where(c => c.IsAdminFlagColumn && !c.IsComputed))
        insertPairs.Add((c.Name, c.IsStringColumn ? "'False'" : "0"));
#>
CREATE OR ALTER PROCEDURE [<#= Model.SchemaName #>].[<#= Model.TableName #>_Save]
-- Inserts the row if the primary key is not found, otherwise updates it.
-- ** Always pass the entire record: on update, every column below is overwritten with what you pass. **
(
<#
    for (int i = 0; i < parameterColumns.Count; i++)
    {
        var c = parameterColumns[i];
        string suffix = c == identityKey ? " = NULL OUTPUT" : "";
        string comma = (i < parameterColumns.Count - 1) ? "," : "";
#>
<#= c.ParameterName #> <#= c.SqlTypeDeclaration #><#= suffix #><#= comma #>
<#
    }
#>
)
AS
BEGIN
	SET NOCOUNT OFF;
	SET XACT_ABORT ON;

<#
    // Trim strings once, up front.
    var trimColumns = parameterColumns.Where(c => c.IsStringColumn && !IsTextLob(c)).ToList();
    foreach (var c in trimColumns)
    {
        string trimmed = $"LTRIM(RTRIM({c.ParameterName}))";
        string expression = c.IsNullable ? trimmed : $"ISNULL({trimmed}, '')";
#>
	SET <#= c.ParameterName #> = <#= expression #>;
<#
    }
    if (trimColumns.Count > 0)
    {
#>

<#
    }
    if (Model.HasStartEndDatePair && Model.StartDateColumn is not null && Model.EndDateColumn is not null
        && parameterColumns.Contains(Model.StartDateColumn) && parameterColumns.Contains(Model.EndDateColumn))
    {
        var startCol = Model.StartDateColumn;
        var endCol = Model.EndDateColumn;
#>
	IF (<#= startCol.ParameterName #> IS NOT NULL AND <#= endCol.ParameterName #> IS NOT NULL
	    AND CAST(<#= startCol.ParameterName #> AS DATETIME) > CAST(<#= endCol.ParameterName #> AS DATETIME))
		THROW 50000, '[<#= startCol.Name #>] must not be later than [<#= endCol.Name #>].', 1;

<#
    }
    if (Model.HasInOutDateTimePair && Model.InDateColumn is not null && Model.InTimeColumn is not null && Model.OutDateColumn is not null && Model.OutTimeColumn is not null)
    {
        var inDate = Model.InDateColumn;
        var inTime = Model.InTimeColumn;
        var outDate = Model.OutDateColumn;
        var outTime = Model.OutTimeColumn;
#>
	IF (<#= inDate.ParameterName #> IS NOT NULL AND <#= inTime.ParameterName #> IS NOT NULL AND <#= outDate.ParameterName #> IS NOT NULL AND <#= outTime.ParameterName #> IS NOT NULL
	    AND (CAST(<#= inDate.ParameterName #> AS DATETIME) > CAST(<#= outDate.ParameterName #> AS DATETIME)
	         OR (CAST(<#= inDate.ParameterName #> AS DATETIME) = CAST(<#= outDate.ParameterName #> AS DATETIME)
	             AND CAST(<#= inTime.ParameterName #> AS TIME) > CAST(<#= outTime.ParameterName #> AS TIME))))
		THROW 50000, '[<#= inDate.Name #>]/[<#= inTime.Name #>] must not be later than [<#= outDate.Name #>]/[<#= outTime.Name #>].', 1;

<#
    }
#>
	-- Join the caller's transaction if there is one; otherwise own this one.
	DECLARE @blnOwnsTransaction BIT = CASE WHEN @@TRANCOUNT = 0 THEN 1 ELSE 0 END;

	BEGIN TRY
		IF @blnOwnsTransaction = 1
			BEGIN TRANSACTION;

<#
    string existsCheck = $"SELECT 1 FROM [{Model.SchemaName}].[{Model.TableName}] WITH (UPDLOCK, HOLDLOCK) WHERE {whereClause}";
    if (updatePairs.Count > 0)
    {
#>
		IF EXISTS (<#= existsCheck #>)
		BEGIN
			UPDATE [<#= Model.SchemaName #>].[<#= Model.TableName #>] SET
<#
        for (int i = 0; i < updatePairs.Count; i++)
        {
            string comma = (i < updatePairs.Count - 1) ? "," : "";
#>
				[<#= updatePairs[i].Name #>] = <#= updatePairs[i].Value #><#= comma #>
<#
        }
#>
			WHERE <#= whereClause #>;
		END
		ELSE
<#
    }
    else
    {
        // Every column is part of the key: nothing to update, so only insert when the key is missing.
#>
		IF NOT EXISTS (<#= existsCheck #>)
<#
    }
#>
		BEGIN
			INSERT INTO [<#= Model.SchemaName #>].[<#= Model.TableName #>]
			(
<#
    for (int i = 0; i < insertPairs.Count; i++)
    {
        string comma = (i < insertPairs.Count - 1) ? "," : "";
#>
				[<#= insertPairs[i].Name #>]<#= comma #>
<#
    }
#>
			)
			VALUES
			(
<#
    for (int i = 0; i < insertPairs.Count; i++)
    {
        string comma = (i < insertPairs.Count - 1) ? "," : "";
#>
				<#= insertPairs[i].Value #><#= comma #>
<#
    }
#>
			);
<#
    if (identityKey is not null)
    {
#>

			SET <#= identityKey.ParameterName #> = CAST(SCOPE_IDENTITY() AS <#= identityKey.SqlTypeDeclaration #>); -- learn the id of the new row
<#
    }
#>
		END

		IF @blnOwnsTransaction = 1
			COMMIT TRANSACTION;

		RETURN 0;
	END TRY
	BEGIN CATCH
		IF @blnOwnsTransaction = 1 AND @@TRANCOUNT > 0
			ROLLBACK TRANSACTION;
		THROW;
	END CATCH;
END
