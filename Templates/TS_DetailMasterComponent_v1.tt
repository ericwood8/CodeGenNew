<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string componentsFolder = Project.ComponentsFolder;
    string servicesFolder = Project.ServicesFolder;
    string modelsFolder = Project.ModelsFolder;
    string apiPrefix = "api";
    // ==========================================================================================

    // ==========================================================================================
    // TS_DetailMasterComponent_v1.tt
    // Generates the four files of an Angular component in components/<table>-detail-master/ (the paths are written by the template, point the output folder at src/app)
    // TS_Component's grid, search, paging and add/edit form, plus one read-only grid per child table under the form while a row is edited, sortable
    // and clickable (a row opens its own screen). The Angular counterpart of WinUI3_DetailMasterScreen. Needs a table with at least one child foreign key.
    // A child the project lists in EditableChildren (Department.DepartmentTeam) is an editable table inside the form instead, saved with the row in one request (see EditableChild in Core).
    // Full notes: Docs/TemplateNotes/TS_DetailMasterComponent_v1.md
    // ==========================================================================================

    // A decimal, float or real column that is not money (a percentage, a rate, a quantity, a weight) is limited to what the column can hold (a percentage to 0-100).

    var keyColumn = Model.PrimaryKeyColumns.Count == 1 ? Model.PrimaryKeyColumns[0] : null;
    var keyType = KeyType.Of(Model);   // how the key travels: a number, or a string for a uniqueidentifier or a text key
    if (Project.NoApiFor(Model.TableName, Model.LookupShape))
    {
        Error($"TS_DetailMasterComponent writes no screen for [{Model.SchemaName}].[{Model.TableName}]: it is an enum or excluded by the NoApiTables setting (an enum, a *Type lookup table, or a table with no entity class), so there is no API for it to show.");
    }
    else if (keyColumn is null || keyType is null)
    {
        Error($"TS_DetailMasterComponent needs a table with a single int, uniqueidentifier or text primary key (the routes take the id as {{id:int}}, {{id:guid}} or {{id}}), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else if (!Model.HasAtLeastOneChildForeignKey)
    {
        Error($"TS_DetailMasterComponent needs at least one other table with a foreign key pointing back at [{Model.SchemaName}].[{Model.TableName}]; none was found - use TS_Component instead.");
    }
    else
    {
        // A table with a Name and an IsActive column (a department and its teams) has no search endpoint: its screen is on NameActiveCrudScreen (see TS_Component), with no paging or sorting of its own grid.
        bool nameActive = Model.IsNameActiveTable;
        string baseName = BaseName(Model.TableName);
        string stem = baseName.ToLowerInvariant();
        string variable = LowerFirst(baseName);        // holiday
        string keyProp = JsonNames.Camel(keyColumn.Name);         // holidayId
        string keyTs = keyType.TypeScript;
        string emptyKey = keyType.TypeScriptEmpty;
        bool textKey = keyType.Kind == KeyKind.Text;    // the key is a box on the form (typed on a new row, read-only on an existing one) and a column of the grid
        // the child grids and the "save first" note show once the row exists: for a typed key that is `!adding`, since the key is set on a new row too
        string savedTest = textKey ? "!adding" : "selectedRow." + keyProp;
        string title = Labels.Words(baseName);
        bool hasName = Model.Columns.Any(c => c.IsStringColumn && c.Name == "Name"); // just for showError's message wording below
        const int pageSize = 20;
        // The same paging and search bar as TS_Component: one text box per searchable column (Model.SearchableColumns), paged by the API's /search endpoint.
        // The Search list protocol (ListProtocol=Search) has one search box for the whole table; the server decides which columns it matches.
        var searchFields = Project.ListSearchProtocol
            ? new List<(string ParamName, string Name, string Label)> { ("search", "search", "") }
            : Model.SearchableColumns.Select(c => (ParamName: LowerFirst(c.Name), c.Name, Label: Labels.Column(c.Name))).ToList();
        bool canSearch = !nameActive && searchFields.Count > 0;
        // The route of a table's own page ("SalesInvoice" -> "sales-invoice"): the project's routing has one route per generated page, named this way.
        string selfRoute = ScreenNames.Route(Model.TableName);

        // What the form is made of (its columns, the foreign key behind each, the drop-downs and their parents) is decided in Core for every stack.
        var form = FormModel.For(Model, Project);
        var fkByColumn = form.ForeignKeysByColumn;

        var shown = form.Columns.ToList();

        var parents = form.Parents
            .Select(fk =>
            {
                string parentBase = BaseName(fk.ReferencedTable);
                bool self = fk.ReferencedTable.EqualsIgnoreCase(Model.TableName);
                // a drop-down over a parent with a whole-number or text key reads the parent's lookup list ({ id, name }: GET <route>/lookup) instead of every column of every row
                var fkColumn = Model.Columns.First(col => col.Name.EqualsIgnoreCase(fk.ReferencingColumns[0]));
                bool viaLookup = !fkColumn.IsGuidColumn && fk.ReferencedColumns.Count == 1 && !Project.NoApiFor(fk.ReferencedTable, fk.ReferencedLookupShape);
                string idType = Model.ForeignKeyType(fk)?.TypeScript ?? "number";
                return new
                {
                    Table = fk.ReferencedTable,
                    Type = parentBase,
                    ModelFile = Project.ModelFileOf(fk.ReferencedTable, parentBase.ToLowerInvariant()),
                    Service = parentBase + "Service",
                    ServiceVar = LowerFirst(parentBase) + "Service",
                    ServiceFile = parentBase.ToLowerInvariant() + ".service",
                    List = LowerFirst(parentBase).Pluralize(),
                    NameMethod = LowerFirst(parentBase) + "Name",
                    Lookup = viaLookup,
                    LookupType = idType == "number" ? "Lookup" : $"Lookup<{idType}>",
                    KeyProp = viaLookup ? "id" : JsonNames.Camel(fk.ReferencedColumns[0]),
                    IdType = idType,
                    DisplayProp = viaLookup ? "name" : JsonNames.Camel(fk.ReferencedDisplayColumns[0]),
                    Self = self
                };
            }).ToList();
        var parentOf = parents.ToDictionary(p => p.Table, StringComparer.OrdinalIgnoreCase);

        // The child tables, decided in Core for every stack (ChildGrid): which ones get a grid, its heading and role, its key, and the foreign keys shown as names.
        var childGrids = ChildGrid.For(Model, Project);
        var children = childGrids
            .Select(g => new
            {
                Table = g.Table,
                // the property of the save request that holds this child's rows when the table is edited in the form (EditableChildren)
                JsonName = EditableChild.JsonName(g.Link),
                Title = g.Title,
                Var = LowerFirst(g.Name),
                MethodName = g.Name,
                Route = ScreenNames.ApiRoute(g.Table),
                PageRoute = ScreenNames.Route(g.Table),
                KeyProp = g.KeyName is null ? null : JsonNames.Camel(g.KeyName),
                // a child with a text key has it encoded into the links and the delete route
                KeyIsText = g.KeyType?.Kind == KeyKind.Text,
                FkProp = JsonNames.Camel(g.Link.ReferencingColumns[0]),
                // a whole-number key is named by the parent's lookup list ({ id, name }); any other key reads the parent's rows
                Lookups = g.Lookups.Select(l => l.UsesLookupEndpoint
                    ? (Column: JsonNames.Camel(l.ColumnName), Route: ScreenNames.ApiRoute(l.ParentTable) + "/lookup", Key: "id", Display: "name")
                    : (Column: JsonNames.Camel(l.ColumnName), Route: ScreenNames.ApiRoute(l.ParentTable), Key: JsonNames.Camel(l.ParentKeyName), Display: JsonNames.Camel(l.ParentDisplayName))).ToList(),
                Hidden = g.HiddenColumns.Select(JsonNames.Camel).ToList(),
                // What the schema says about the child's columns (their JSON names are camelCase): money shows as currency, long text goes last.
                Currency = g.Link.ReferencingTableColumns.Where(c => c.IsMoneyAmount)
                    .Select(c => (Name: JsonNames.Camel(c.Name), Digits: NumericClassifier.CurrencyDigits(c))).ToList(),
                LongText = g.Link.ReferencingTableColumns.Where(c => c.IsLongTextColumn).Select(c => JsonNames.Camel(c.Name)).ToList(),
                // The caption each child column gets (date columns lose "Date", yes/no columns end in "?", Number -> #, Percent -> %).
                Captions = g.Link.ReferencingTableColumns.Select(c => (Name: JsonNames.Camel(c.Name), Caption: GridCaption.For(c, Labels.Column(c.Name)))).ToList()
            }).ToList();

        // ==== naming on the page
        string Id(ColumnModel c) => variable + UpperFirst(JsonNames.Camel(c.Name));

        // EditableChildren: the child tables whose rows are added, changed and removed inside this form and sent with it in one request (EditableChild, the rule the API's create and update use too);
        // every other child keeps its read-only grid under the form
        var editableLinks = childGrids.Where(g => g.IsEditable).Select(g => g.Link).ToList();
        bool IsEditableChild(string table) => editableLinks.Any(fk => fk.ReferencingTable.EqualsIgnoreCase(table));
        var gridChildren = children.Where(ch => !IsEditableChild(ch.Table)).ToList();
        var editableChildren = children.Where(ch => IsEditableChild(ch.Table)).ToList();
        ChildForeignKeyModel LinkOf(string table) => editableLinks.First(fk => fk.ReferencingTable.EqualsIgnoreCase(table));
        // a child's own foreign key is a drop-down over the parent's lookup list ({ id, name }), unless its key is a uniqueidentifier
        ForeignKeyModel EditLookupOf(ChildForeignKeyModel link, ColumnModel c) => c.IsGuidColumn ? null
            : link.ReferencingTableForeignKeys.FirstOrDefault(o => o.ReferencingColumns.Count == 1 && o.ReferencingColumns[0].EqualsIgnoreCase(c.Name)
                && o.ReferencedDisplayColumns.Count > 0 && !Project.NoApiFor(o.ReferencedTable, o.ReferencedLookupShape) && !Project.NoLookupFor(o.ReferencedTable, o.ReferencedLookupShape));
        // a money column of the child that is not a foreign key or a list of choices
        bool IsChildCurrency(ChildForeignKeyModel link, ColumnModel c) => c.IsMoneyAmount && IsNumber(c) && EditLookupOf(link, c) is null && !c.HasChoices;
        string ChildInput(ChildForeignKeyModel link, string childVar, ColumnModel c)
        {
            string model = $"row.{JsonNames.Camel(c.Name)}";
            string name = $"[name]=\"'{childVar}{UpperFirst(JsonNames.Camel(c.Name))}' + {childVar}Rows.indexOf(row)\"";
            string req = c.IsNullable ? "" : " required";
            if (EditLookupOf(link, c) is not null)
                return $"<select {name} [(ngModel)]=\"{model}\"{req}>{(c.IsNullable ? "<option [ngValue]=\"null\"></option>" : "")}<option *ngFor=\"let p of {childVar}Options['{JsonNames.Camel(c.Name)}']\" [ngValue]=\"p.id\">{{{{p.name}}}}</option></select>";
            if (c.HasChoices)
                return $"<select {name} [(ngModel)]=\"{model}\"{req}>{(c.IsNullable ? "<option [ngValue]=\"null\"></option>" : "<option value=\"\"></option>")}{string.Concat(c.Choices!.Select(choice => $"<option value=\"{ChoiceFormat.Html(choice)}\">{ChoiceFormat.Html(choice)}</option>"))}</select>";
            if (c.IsBooleanColumn)
                return $"<input type=\"checkbox\" {name} [(ngModel)]=\"{model}\">";
            if (IsDate(c))
                return $"<input type=\"date\" {name} [(ngModel)]=\"{model}\"{req}>";
            if (IsChildCurrency(link, c))
            {
                var (moneyMin, moneyMax) = Project.MoneyLimits(link.ReferencingTable, c);
                return $"<input type=\"text\" inputmode=\"decimal\" {name} appCurrency currencyCode=\"{Project.CurrencyCode}\" [digits]=\"{NumericClassifier.CurrencyDigits(c)}\""
                       + (moneyMin is { } lo ? $" [min]=\"{Inv(lo)}\"" : "") + (moneyMax is { } hi ? $" [max]=\"{Inv(hi)}\"" : "") + $" [(ngModel)]=\"{model}\"{req}>";
            }
            if (IsNumber(c))
            {
                string step = c.SqlType is SqlDbType.Decimal && (c.Scale ?? 0) > 0 ? " step=\"" + "0." + new string('0', c.Scale!.Value - 1) + "1\""
                            : c.IsMoneyColumn ? " step=\"0.01\""
                            : c.SqlType is SqlDbType.Float or SqlDbType.Real ? " step=\"any\"" : "";
                string range = Project.RangeFor(c) is { } r ? $" min=\"{r.Min}\" max=\"{r.Max}\""
                    : IsPlainDecimal(c) ? $" min=\"{Inv(NumericClassifier.DecimalRange(c).Min)}\" max=\"{Inv(NumericClassifier.DecimalRange(c).Max)}\"" : "";
                string width = Project.NumberBoxCharacters(c) is { } boxWidth ? $" style=\"width: {boxWidth}ch\"" : "";
                return $"<input type=\"number\" {name} [(ngModel)]=\"{model}\"{step}{range}{width}{req}>";
            }
            string max = IsText(c) && Chars(c) > 0 ? $" maxlength=\"{Chars(c)}\"" : "";
            return $"<input type=\"text\" {name} [(ngModel)]=\"{model}\"{max}{req}>";
        }
        bool UsesCurrencyBox() => shown.Any(form.IsMoneyInput) || editableChildren.Any(ch => EditableChild.Columns(LinkOf(ch.Table)).Any(c => IsChildCurrency(LinkOf(ch.Table), c)));
        // The grid shows at most 20 columns and never a long text column (a Notes column, ...), and multi-line text only when that leaves fewer than GridColumns.MinColumns: see GridColumns.
        var gridColumns = GridColumns.For(shown);
        // A grid column's header sorts the grid unless it is long text or binary (SearchSort.IsSortable; long text never is in a grid anyway).
        var sortableColumns = nameActive ? new List<ColumnModel>() : gridColumns.Where(SearchSort.IsSortable).ToList();
        // A Clone button beside Edit and Delete for the tables CloneShape allows (the service has clone(id), API_Crud / CS_Repo write the server side).
        bool canClone = !nameActive && CloneShape.CanClone(Model, Project);
        string rowsExpression = nameActive ? "visibleRows" : "rows";
        // The form is tabbed (Main / Billing & Shipping / Notes) when it has more than one kind of field: see FormPages.
        var formPages = FormPages.For(shown);
        bool tabbed = formPages.Count > 1;

        var css = new StringBuilder();
        var html = new StringBuilder();
        var spec = new StringBuilder();
        var ts = new StringBuilder();
        void H(string s = "") => html.Append(s).Append('\n');
        void T(string s = "") => ts.Append(s).Append('\n');

        // ================= html
        H("<main class=\"main\">");
        H("    <div class=\"content\">");
        H("      <div class=\"left-side\">");
        H("<div>");
        H("    <!-- Heading -->");
        H($"    <h1>{title.Pluralize()}</h1>");
        H($"    <button (click)=\"add()\" class=\"btn\">Add New {title}</button>");
        if (canSearch)
        {
            H();
            H("    <!-- Search -->");
            H("    <div class=\"form-group form-group-search dept\">");
            foreach (var f in searchFields)
                H($"        <input type=\"text\" class=\"form-control\" placeholder=\"Search{(f.Label == "" ? "" : " by " + f.Label)}\" [(ngModel)]=\"filters.{f.ParamName}\" />");
            H("        <button class=\"btn btn-outline-secondary\" type=\"button\" (click)=\"search()\"> Search </button>");
            H("        <button class=\"btn btn-outline-secondary\" type=\"button\" (click)=\"clearSearch()\"> Clear </button>");
            H("    </div>");
        }
        if (nameActive)
        {
            H();
            H("    <!-- Search -->");
            H("    <div class=\"form-group form-group-search dept\">");
            H("        <input type=\"text\" class=\"form-control\" placeholder=\"Search by Name\" [(ngModel)]=\"searchText\" />");
            H("        <label class=\"active-only\"><input type=\"checkbox\" name=\"activeOnly\" [(ngModel)]=\"activeOnly\" /> Active only</label>");
            H("        <button class=\"btn btn-outline-secondary\" type=\"button\" (click)=\"clearSearch()\"> Clear </button>");
            H("    </div>");
        }
        H();
        H("    <!-- Grid -->");
        // A right-click on the grid opens a small menu with Clear sort; a click on a sortable header sorts by it (again: flips the direction).
        H(nameActive ? "    <table>" : "    <table (contextmenu)=\"openSortMenu($event)\">");
        H("        <thead>");
        H("            <tr>");
        foreach (var c in gridColumns)
        {
            if (sortableColumns.Contains(c))
                H($"                <th [attr.aria-sort]=\"ariaSort('{c.Name}')\"><button type=\"button\" class=\"sort-header\" (click)=\"sortBy('{c.Name}')\">{GridCaption.For(c, Labels.Field(c))}{{{{ sortMark('{c.Name}') }}}}</button></th>");
            else
                H($"                <th>{GridCaption.For(c, Labels.Field(c))}</th>");
        }
        H("                <th>Actions</th>");
        H("            </tr>");
        H("        </thead>");
        H("        <tbody>");
        H($"            <tr *ngFor=\"let {variable} of {rowsExpression}\">");
        foreach (var c in gridColumns)
        {
            string prop = $"{variable}.{JsonNames.Camel(c.Name)}";
            var lookup = form.LookupOf(c);
            string cell;
            if (lookup is not null) cell = $"{{{{ {parentOf[lookup.ReferencedTable].NameMethod}({prop}) }}}}";
            else if (c.IsBooleanColumn) cell = $"{{{{ {prop} ? \"Yes\" : \"No\" }}}}";
            else if (IsDate(c)) cell = $"{{{{ {prop} | date:'MM/dd/yyyy' }}}}";
            else if (c.IsMoneyAmount) { int d = NumericClassifier.CurrencyDigits(c); cell = $"{{{{ {prop} | currency:'{Project.CurrencyCode}':'symbol':'1.{Math.Min(2, d)}-{d}' }}}}"; }
            else if (c.SqlType is SqlDbType.Decimal or SqlDbType.Money or SqlDbType.SmallMoney) cell = $"{{{{ {prop} | number:'1.2-2' }}}}";
            else cell = $"{{{{ {prop} }}}}";
            H($"                <td>{cell}</td>");
        }
        H("                <td>");
        H($"                    <button (click)=\"edit({variable})\" class=\"btn-action\">Edit</button>");
        if (canClone)
            H($"                    <button (click)=\"clone({variable}.{keyProp}!)\" class=\"btn-action\">Clone</button>");
        H($"                    <button (click)=\"delete({variable}.{keyProp}!)\" class=\"btn-action delete\">Delete</button>");
        H("                </td>");
        H("            </tr>");
        H("        </tbody>");
        H("    </table>");
        if (nameActive)
        {
            H("    <p *ngIf=\"loaded && visibleRows.length === 0\" class=\"no-rows\">Nothing found.</p>");
        }
        else
        {
            H("    <p *ngIf=\"loaded && totalCount === 0\" class=\"no-rows\">Nothing found.</p>");
            H("    <ul *ngIf=\"sortMenu\" class=\"sort-menu\" role=\"menu\" [style.left.px]=\"sortMenu.x\" [style.top.px]=\"sortMenu.y\">");
            H("        <li role=\"none\"><button type=\"button\" role=\"menuitem\" [disabled]=\"!sort\" (click)=\"clearSort()\">Clear sort</button></li>");
            H("    </ul>");
            H();
            H("    <mat-paginator");
            H("        [length]=\"totalCount\"");
            H("        [pageSize]=\"pageSize\"");
            H("        [pageSizeOptions]=\"[10, 20, 50, 100]\"");
            H("        [pageIndex]=\"pageIndex\"");
            H("        (page)=\"onPageChange($event)\">");
            H("    </mat-paginator>");
        }
        H();
        H("    <!-- Add/Edit Form -->");
        // The add/edit form is a modal <dialog> (native, no library): it opens over the page, wherever the grid is scrolled to, and Escape cancels it.
        H("    <dialog *ngIf=\"selectedRow\" #editDialog class=\"form-container\" (cancel)=\"$event.preventDefault(); cancel()\">");
        string headingTest = textKey ? "adding ? 'Add' : 'Edit'" : "selectedRow." + keyProp + " ? 'Edit' : 'Add'";
        H($"        <h2>{{{{{headingTest}}}}} {title}</h2>");
        H($"        <form id=\"{variable}Form\" ngNativeValidate (ngSubmit)=\"submit(selectedRow)\">");
        if (tabbed)
        {
            H("            <div role=\"tablist\" class=\"form-tabs\">");
            for (int i = 0; i < formPages.Count; i++)
                H($"                <button type=\"button\" role=\"tab\" [attr.aria-selected]=\"activeTab === {i}\" [style.font-weight]=\"activeTab === {i} ? 'bold' : 'normal'\" (click)=\"activeTab = {i}\">{formPages[i].Header.Replace("&", "&amp;")}</button>");
            H("            </div>");
        }
        for (int pageIndex = 0; pageIndex < formPages.Count; pageIndex++)
        {
        if (tabbed) H($"            <div role=\"tabpanel\" data-tab=\"{pageIndex}\" [hidden]=\"activeTab !== {pageIndex}\">");
        foreach (var c in formPages[pageIndex].Columns)
        {
            string id = Id(c);
            string model = $"selectedRow.{JsonNames.Camel(c.Name)}";
            string req = c.IsNullable ? "" : " required";
            var lookup = form.LookupOf(c);
            if (c.IsSystemStampColumn)
            {
                // who made the row and when it changed: the system writes it, so it is text, shown once the row exists
                string stampValue = c.IsDateColumn ? "{{ " + model + " | date:'medium' }}" : "{{ " + model + " }}";
                H($"            <div class=\"form-group\" *ngIf=\"{(textKey ? "!adding" : "selectedRow." + keyProp)}\">");
                H($"                <label for=\"{id}\">{Labels.Field(c)}</label>");
                H($"                <span id=\"{id}\">{stampValue}</span>");
                H("            </div>");
                continue;
            }
            H("            <div class=\"form-group\">");
            H($"                <label for=\"{id}\">{Labels.Field(c)}</label>");
            if (textKey && c.IsPrimaryKey)
            {
                // the key of a new row is typed; once the row exists it is read-only (the API does not change a key)
                string max = Chars(c) > 0 ? $" maxlength=\"{Chars(c)}\"" : "";
                H($"                <input type=\"text\" id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{max} [readonly]=\"!adding\" placeholder=\"{Labels.Placeholder(c)}\"{req}>");
            }
            else if (lookup is not null)
            {
                var p = parentOf[lookup.ReferencedTable];
                H($"                <select id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{req}>");
                if (c.IsNullable) H("                    <option [ngValue]=\"null\"></option>");
                H($"                    <option *ngFor=\"let p of {p.List}\" [ngValue]=\"p.{p.KeyProp}\">{{{{p.{p.DisplayProp}}}}}</option>");
                H("                </select>");
            }
            else if (c.HasChoices)
            {
                // A column whose values the database lists (a MySQL enum) is a drop-down of them.
                H($"                <select id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{req}>");
                H(c.IsNullable ? "                    <option [ngValue]=\"null\"></option>" : "                    <option value=\"\"></option>");
                foreach (string choice in c.Choices!)
                    H($"                    <option value=\"{ChoiceFormat.Html(choice)}\">{ChoiceFormat.Html(choice)}</option>");
                H("                </select>");
            }
            else if (c.IsBooleanColumn)
            {
                H($"                <input type=\"checkbox\" id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\">");
            }
            else if (IsDate(c))
            {
                // A nullable date has a Clear button on the same line, like WinUI3's calendar.
                if (c.IsNullable) H("                <div class=\"date-with-clear\">");
                H($"                <input type=\"date\" id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{req}>");
                if (c.IsNullable)
                {
                    H($"                <button type=\"button\" class=\"btn-action\" (click)=\"{model} = undefined\">Clear</button>");
                    H("                </div>");
                }
            }
            else if (form.IsMoneyInput(c))
            {
                // the money box shows $1,234.50 and takes the plain number; the limits are the column's CHECK constraint, or 0 for a column the project lists as never negative
                var (moneyMin, moneyMax) = Project.MoneyLimits(Model.TableName, c);
                string limits = (moneyMin is { } lo ? $" [min]=\"{Inv(lo)}\"" : "") + (moneyMax is { } hi ? $" [max]=\"{Inv(hi)}\"" : "");
                H($"                <input type=\"text\" inputmode=\"decimal\" id=\"{id}\" name=\"{id}\" appCurrency currencyCode=\"{Project.CurrencyCode}\" [digits]=\"{NumericClassifier.CurrencyDigits(c)}\"{limits} [(ngModel)]=\"{model}\"{req}>");
            }
            else if (IsNumber(c))
            {
                string step = c.SqlType is SqlDbType.Decimal && (c.Scale ?? 0) > 0 ? " step=\"" + "0." + new string('0', c.Scale!.Value - 1) + "1\""
                            : c.IsMoneyColumn ? " step=\"0.01\""
                            : c.SqlType is SqlDbType.Float or SqlDbType.Real ? " step=\"any\"" : "";
                // A whole-number column carries the limits its name and SQL type imply (a month 1-12, a year MinYear-MaxYear, ...).
                string range = Project.RangeFor(c) is { } r ? $" min=\"{r.Min}\" max=\"{r.Max}\""
                    : IsPlainDecimal(c) ? $" min=\"{Inv(NumericClassifier.DecimalRange(c).Min)}\" max=\"{Inv(NumericClassifier.DecimalRange(c).Max)}\""
                    : c.IsMoneyAmount ? Project.MoneyLimitHtml(Model.TableName, c) : "";
                string width = Project.NumberBoxCharacters(c) is { } boxWidth ? $" style=\"width: {boxWidth}ch\"" : "";
                H($"                <input type=\"number\" id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{step}{range}{width} placeholder=\"{Labels.Placeholder(c)}\"{req}>");
            }
            else if (IsMultiline(c))
            {
                H($"                <textarea id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\" maxlength=\"{Chars(c)}\" placeholder=\"{Labels.Placeholder(c)}\"{req}></textarea>");
            }
            else
            {
                string max = IsText(c) && Chars(c) > 0 ? $" maxlength=\"{Chars(c)}\"" : "";
                H($"                <input type=\"text\" id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{max} placeholder=\"{Labels.Placeholder(c)}\"{req}>");
            }
            H("            </div>");
        }
        if (tabbed) H("            </div>");
        }
        foreach (var child in editableChildren)
        {
            // the child's rows are part of the form: Submit saves them with the row, in one request
            var link = LinkOf(child.Table);
            var editColumns = EditableChild.Columns(link);
            H();
            H("            <fieldset class=\"child-edit\">");
            H($"                <legend>{child.Title}</legend>");
            if (EditableChild.UsesCards(link))
            {
                // too many columns for one table: each row is a block of labelled fields that wrap, so no box is squeezed
                H($"                <div class=\"child-card\" *ngFor=\"let row of {child.Var}Rows\">");
                H("                    <div class=\"child-card-head\">");
                H($"                        <strong>{Labels.Words(BaseName(child.Table))}</strong>");
                H($"                        <button type=\"button\" class=\"btn-action delete\" (click)=\"remove{child.MethodName}(row)\">Remove</button>");
                H("                    </div>");
                H("                    <div class=\"child-card-fields\">");
                foreach (var c in editColumns)
                    H($"                        <label class=\"child-field{(IsMultiline(c) ? " child-field-wide" : "")}\"><span>{GridCaption.For(c, Labels.Field(c))}</span>{ChildInput(link, child.Var, c)}</label>");
                H("                    </div>");
                H("                </div>");
                H($"                <button type=\"button\" class=\"btn btn-outline\" (click)=\"add{child.MethodName}()\">Add {Labels.Words(BaseName(child.Table))}</button>");
                H("            </fieldset>");
                continue;
            }
            H("                <table>");
            H("                    <thead>");
            H("                        <tr>" + string.Concat(editColumns.Select(c => $"<th>{GridCaption.For(c, Labels.Field(c))}</th>")) + "<th></th></tr>");
            H("                    </thead>");
            H("                    <tbody>");
            H($"                        <tr *ngFor=\"let row of {child.Var}Rows\">");
            foreach (var c in editColumns)
                H($"                            <td>{ChildInput(link, child.Var, c)}</td>");
            H($"                            <td><button type=\"button\" class=\"btn-action delete\" (click)=\"remove{child.MethodName}(row)\">Remove</button></td>");
            H("                        </tr>");
            H("                    </tbody>");
            H("                </table>");
            H($"                <button type=\"button\" class=\"btn btn-outline\" (click)=\"add{child.MethodName}()\">Add {Labels.Words(BaseName(child.Table))}</button>");
            H("            </fieldset>");
        }
        H();
        H("            <button type=\"submit\" class=\"btn\"" + (tabbed ? " (click)=\"revealInvalidTab($event)\"" : "") + ">Submit</button>");
        H("            <button type=\"button\" (click)=\"cancel()\" class=\"btn btn-outline\">Cancel</button>");
        H("        </form>");
        H();
        if (gridChildren.Count > 0)
            H("        <!-- Child grids: TableModel.ChildForeignKeys, one per table, columns discovered at run time -->");
        foreach (var child in gridChildren)
        {
            H($"        <div class=\"child-grid\" *ngIf=\"{savedTest}; else save{child.MethodName}First\">");
            H($"            <h3>{child.Title}</h3>");
            // The grid holds all its rows, so a header click sorts them in the browser; a right-click opens the Clear sort menu.
            H($"            <table (contextmenu)=\"openChildSortMenu($event, '{child.Var}')\">");
            H("                <thead>");
            H($"                    <tr><th *ngFor=\"let col of {child.Var}Columns\" [attr.aria-sort]=\"childAriaSort('{child.Var}', col)\"><button type=\"button\" class=\"sort-header\" (click)=\"sortChildBy('{child.Var}', col)\">{{{{caption(col)}}}}{{{{ childSortMark('{child.Var}', col) }}}}</button></th>{(child.KeyProp is not null ? "<th>Actions</th>" : "")}</tr>");
            H("                </thead>");
            H("                <tbody>");
            // Clicking a row, or its Edit button, opens that row on its own page.
            string shownRows = $"sortedChildRows('{child.Var}', {child.Var}Rows{(child.Lookups.Count > 0 ? $", {child.Var}Names" : "")})";
            H(child.KeyProp is not null
                ? $"                    <tr *ngFor=\"let row of {shownRows}\" (click)=\"edit{child.MethodName}(row)\" style=\"cursor: pointer\">"
                : $"                    <tr *ngFor=\"let row of {shownRows}\">");
            H($"                        <td *ngFor=\"let col of {child.Var}Columns\">{{{{cell(row[col], col{(child.Lookups.Count > 0 ? $", {child.Var}Names[col]" : "")})}}}}</td>");
            if (child.KeyProp is not null)
            {
                H("                        <td>");
                H($"                            <button type=\"button\" class=\"btn-action\" (click)=\"edit{child.MethodName}(row); $event.stopPropagation()\">Edit</button>");
                H($"                            <button type=\"button\" class=\"btn-action delete\" (click)=\"delete{child.MethodName}(row); $event.stopPropagation()\">Delete</button>");
                H("                        </td>");
            }
            H("                    </tr>");
            H("                </tbody>");
            H("            </table>");
            H($"            <ul *ngIf=\"childSortMenu && childSortMenu.child === '{child.Var}'\" class=\"sort-menu\" role=\"menu\" [style.left.px]=\"childSortMenu.x\" [style.top.px]=\"childSortMenu.y\">");
            H($"                <li role=\"none\"><button type=\"button\" role=\"menuitem\" [disabled]=\"!childSorts['{child.Var}']\" (click)=\"clearChildSort('{child.Var}')\">Clear sort</button></li>");
            H("            </ul>");
            H("        </div>");
            H($"        <ng-template #save{child.MethodName}First><p><em>Save this {title} first to see its {child.Title} rows.</em></p></ng-template>");
        }
        H("    </dialog>");
        H("</div>");
        H("</div>");
        H("</div>");
        H("</main>");

        // ================= spec
        string cls = baseName + "DetailMasterComponent";
        spec.Append("import { ComponentFixture, TestBed } from '@angular/core/testing';\nimport { provideHttpClient } from '@angular/common/http';\nimport { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';\nimport { provideRouter } from '@angular/router';\nimport { provideNoopAnimations } from '@angular/platform-browser/animations';\n\n");
        spec.Append($"import {{ {cls} }} from './{stem}-detail-master.component';\n\n");
        spec.Append($"describe('{cls}', () => {{\n  let component: {cls};\n  let fixture: ComponentFixture<{cls}>;\n\n");
        spec.Append($"  beforeEach(async () => {{\n    await TestBed.configureTestingModule({{\n      imports: [{cls}],\n      providers: [provideHttpClient(), provideHttpClientTesting(), provideNoopAnimations(), provideRouter([])]\n    }})\n    .compileComponents();\n\n");
        spec.Append($"    fixture = TestBed.createComponent({cls});\n    component = fixture.componentInstance;\n    fixture.detectChanges();\n  }});\n\n");
        // Server paging: the first page is asked for, and a page past the end (the last row of the last page was deleted) falls back to the last page there is.
        // The project's list protocol decides how the request and the answer are written.
        bool searchProtocol = Project.ListSearchProtocol;
        int specPageBase = searchProtocol ? Project.PageBase : 1;
        string specPageParam = Project.PageParameter;
        string specSizeParam = Project.PageSizeParameter;
        string Asked(int page, string? size = null) => $"(r) => r.url === 'api/{stem.Pluralize()}' && r.params.get('{specPageParam}') === '{page - 1 + specPageBase}'" + (size is null ? "" : $" && r.params.get('{specSizeParam}') === '{size}'");
        string Reply(int page, string size, int total, int pages) => $"{{ '{Project.ItemsMember}': [], '{Project.TotalMember}': {total} }}";
        var pagingSpecs = searchProtocol ? new[]
        {
            "  it('asks the server for the first page', () => {",
            "    const http = TestBed.inject(HttpTestingController);",
            $"    const request = http.expectOne({Asked(1)});",
            $"    expect(request.request.params.get('{specSizeParam}')).toBe(String(component.pageSize));",
            $"    request.flush({Reply(1, "component.pageSize", 0, 0)});",
            "    expect(component.totalCount).toBe(0);",
            "  });",
            "",
            "  it('goes back to the last page there is when the page it asked for is past the end', () => {",
            "    const http = TestBed.inject(HttpTestingController);",
            $"    http.expectOne({Asked(1)}).flush({Reply(1, "component.pageSize", 0, 0)});",
            "    component.onPageChange({ pageIndex: 3, pageSize: 10, length: 25 });",
            $"    http.expectOne({Asked(4, "10")})",
            $"      .flush({Reply(4, "10", 25, 3)});",
            $"    const lastPage = http.expectOne({Asked(3)});",
            "    expect(component.pageIndex).toBe(2);",
            $"    lastPage.flush({Reply(3, "10", 25, 3)});",
            "  });",
        } : new[]
        {
            "  it('asks the server for the first page', () => {",
            "    const http = TestBed.inject(HttpTestingController);",
            "    const request = http.expectOne((r) => r.url.endsWith('/search'));",
            "    expect(request.request.params.get('pageNumber')).toBe('1');",
            "    expect(request.request.params.get('pageSize')).toBe(String(component.pageSize));",
            "    request.flush({ items: [], page: 1, pageSize: component.pageSize, totalCount: 0, totalPages: 0 });",
            "    expect(component.totalCount).toBe(0);",
            "  });",
            "",
            "  it('goes back to the last page there is when the page it asked for is past the end', () => {",
            "    const http = TestBed.inject(HttpTestingController);",
            "    http.expectOne((r) => r.url.endsWith('/search')).flush({ items: [], page: 1, pageSize: component.pageSize, totalCount: 0, totalPages: 0 });",
            "    component.onPageChange({ pageIndex: 3, pageSize: 10, length: 25 });",
            "    http.expectOne((r) => r.url.endsWith('/search') && r.params.get('pageNumber') === '4' && r.params.get('pageSize') === '10')",
            "      .flush({ items: [], page: 4, pageSize: 10, totalCount: 25, totalPages: 3 });",
            "    const lastPage = http.expectOne((r) => r.url.endsWith('/search') && r.params.get('pageNumber') === '3');",
            "    expect(component.pageIndex).toBe(2);",
            "    lastPage.flush({ items: [], page: 3, pageSize: 10, totalCount: 25, totalPages: 3 });",
            "  });",
        };
        // A name/active screen reads the whole list from the table's route and narrows it on the page.
        var listSpecs = new[]
        {
            "  it('reads the whole list and narrows it by name and by active', () => {",
            "    const http = TestBed.inject(HttpTestingController);",
            $"    // a drop-down over this table itself (a manager) reads the list as well, so every request for it is answered",
            $"    http.match((r) => r.method === 'GET' && r.url === 'api/{stem.Pluralize()}').forEach((request) => request.flush([",
            "      { name: 'Alpha', isActive: true },",
            "      { name: 'Alphabet', isActive: false },",
            "      { name: 'Beta', isActive: true }",
            "    ]));",
            "    expect(component.visibleRows.length).toBe(3);",
            "    component.searchText = 'alpha';",
            "    expect(component.visibleRows.length).toBe(2);",
            "    component.activeOnly = true;",
            "    expect(component.visibleRows.length).toBe(1);",
            "    component.clearSearch();",
            "    expect(component.visibleRows.length).toBe(3);",
            "  });",
        };
        // an editable child list: rows can be added and removed in the form, and the list goes into the body of the save
        var childSpecs = new List<string>();
        foreach (var child in editableChildren)
        {
            childSpecs.Add("");
            childSpecs.Add($"  it('keeps the {child.Title.ToLowerInvariant()} rows in the form and sends them with the row', () => {{");
            childSpecs.Add("    component.add();");
            childSpecs.Add($"    component.add{child.MethodName}();");
            childSpecs.Add($"    component.add{child.MethodName}();");
            childSpecs.Add($"    expect(component.{child.Var}Rows.length).toBe(2);");
            childSpecs.Add($"    component.remove{child.MethodName}(component.{child.Var}Rows[0]);");
            childSpecs.Add($"    expect(component.{child.Var}Rows.length).toBe(1);");
            childSpecs.Add("    // eslint-disable-next-line @typescript-eslint/no-explicit-any");
            childSpecs.Add("    const row = component.selectedRow as any;");
            childSpecs.Add("    // eslint-disable-next-line @typescript-eslint/no-explicit-any");
            childSpecs.Add("    (component as any).prepare(row, true);");
            childSpecs.Add($"    expect(row['{child.JsonName}'].length).toBe(1);");
            childSpecs.Add("  });");
        }
        spec.Append("  it('should create', () => {\n    expect(component).toBeTruthy();\n  });\n\n" + string.Join("\n", nameActive ? listSpecs : pagingSpecs) + (childSpecs.Count > 0 ? "\n" + string.Join("\n", childSpecs) : "") + "\n});\n");

        // ================= ts
        // A short class on PagedCrudScreen (components/crud-screen.ts, TS_EssentialCrud): the rows, the open row, add / edit / submit / delete / clone / cancel, the way back to the page that opened a row,
        // the page, the sort and the search boxes are the base's. This class names its service and key and keeps what is the table's own: the starting row, the date boxes, the drop-down lists and the child grids.
        string keyGeneric = keyType.Kind == KeyKind.Int ? "" : ", " + keyType.TypeScript;
        T("import { ChangeDetectionStrategy, Component, " + (gridChildren.Count > 0 ? "HostListener, " : "") + "inject } from '@angular/core';");
        if (gridChildren.Count > 0) T("import { GridSort, loadSort, nextSort, saveSort, sortRows } from '../../grid-sort';");
        T($"import {{ {baseName} }} from '../../{modelsFolder}/{stem}';");
        T($"import {{ {baseName}Service }} from '../../{servicesFolder}/{stem}.service';");
        if (parents.Any(p => p.Lookup)) T($"import {{ Lookup }} from '../../{servicesFolder}/crud.service';");
        foreach (var p in parents.Where(p => !p.Self))
        {
            if (!p.Lookup) T($"import {{ {p.Type} }} from '../../{modelsFolder}/{p.ModelFile}';");
            T($"import {{ {p.Service} }} from '../../{servicesFolder}/{p.ServiceFile}';");
        }
        if (children.Count > 0) T("import { HttpClient } from '@angular/common/http';");
        T("import { CommonModule } from '@angular/common';");
        T("import { FormsModule } from '@angular/forms';");
        if (UsesCurrencyBox()) T("import { CurrencyInputDirective } from '../currency-input';");
        if (!nameActive) T("import { MatPaginatorModule } from '@angular/material/paginator';");
        T($"import {{ {(nameActive ? "NameActiveCrudScreen" : "PagedCrudScreen")} }} from '../crud-screen';");
        if (gridChildren.Any(ch => ch.KeyProp is not null)) T($"import {{ apiMessage }} from '../../{servicesFolder}/api-error';");
        T();
        T("@Component({");
        T($"  selector: 'app-{stem}-detail-master',");
        if (Project.AngularStandaloneFlag) T("  standalone: true,");
        T($"  changeDetection: ChangeDetectionStrategy.{Project.AngularEagerStrategy}, // plain properties change inside subscribe callbacks: keep eager checking when OnPush is the default (Angular 22)");
        T("  imports: [ CommonModule, FormsModule" + (UsesCurrencyBox() ? ", CurrencyInputDirective" : "") + (nameActive ? "" : ", MatPaginatorModule") + " ],");
        T($"  templateUrl: './{stem}-detail-master.component.html',");
        T($"  styleUrl: './{stem}-detail-master.component.css'");
        T("})");
        T($"export class {cls} extends {(nameActive ? "NameActiveCrudScreen" : "PagedCrudScreen")}<{baseName}{keyGeneric}> {{");
        T($"  protected readonly service = inject({baseName}Service);");
        T($"  protected readonly noun = '{Labels.Words(baseName).ToLowerInvariant()}';");
        T($"  protected readonly idKey = '{keyProp}';");
        if (keyType.Kind != KeyKind.Int) T($"  protected override readonly emptyKey: {keyType.TypeScript} = {emptyKey};");
        if (textKey) T("  protected override readonly keyChosen = true; // the person types the key of a new row: it is sent as typed");
        T($"  protected readonly gridKey = '{stem}'; // the grid's saved sort is kept in the browser under this key (see grid-sort.ts)");
        if (!nameActive) T($"  readonly sortableColumns = [{string.Join(", ", sortableColumns.Select(c => "'" + c.Name + "'"))}]; // the columns whose header sorts the grid");
        if (!nameActive && Project.DefaultSort(Model.TableName) is { } defaultSort)
            T($"  protected override readonly defaultSort = {{ column: '{defaultSort.Column}', descending: {(defaultSort.Descending ? "true" : "false")} }}; // the project's DefaultSorts: the sort until the person sorts");
        T($"  protected override readonly badInputMessage = '{(hasName ? "Name is bad or has special characters!" : "Some of the values are not acceptable!")}';");
        if (canSearch) T($"  override filters = {{ {string.Join(", ", searchFields.Select(f => $"{f.ParamName}: ''"))} }};");
        if (!nameActive && pageSize != 20) T($"  override pageSize = {pageSize};");
        foreach (var p in parents)
            T($"  {p.List}: {(p.Lookup ? p.LookupType : p.Type)}[] = [];");
        foreach (var p in parents.Where(p => !p.Self))
            T($"  private readonly {p.ServiceVar} = inject({p.Service});");
        if (children.Count > 0) T("  private readonly http = inject(HttpClient);");
        if (tabbed)
        {
            T("  activeTab = 0; // the form tab showing");
            T();
            T("  // A required field on a tab that is not showing blocks the submit without a visible message: show the tab that holds the first invalid field.");
            T("  revealInvalidTab(event: Event): void {");
            T("    const panel = (event.currentTarget as HTMLButtonElement).form?.querySelector(':invalid')?.closest('[role=\"tabpanel\"]');");
            T("    if (panel) { this.activeTab = Number(panel.getAttribute('data-tab')); }");
            T("  }");
        }
        if (gridChildren.Count > 0)
        {
            T("  // The child grids hold all their rows, so each sorts them in the browser; its sort is saved under the grid's key plus the child's name.");
            T("  childSorts: Record<string, GridSort | null> = { " + string.Join(", ", gridChildren.Select(ch => $"{ch.Var}: loadSort(this.gridKey + '.{ch.Var}')")) + " };");
            T("  childSortMenu: { child: string; x: number; y: number } | null = null; // the child grid's right-click menu, where it is open");
        }
        foreach (var child in gridChildren)
        {
            T($"  {child.Var}Rows: any[] = [];");
            T($"  {child.Var}Columns: string[] = [];");
            T($"  private readonly {child.Var}Hidden: string[] = [" + string.Join(", ", child.Hidden.Select(n => "'" + n + "'")) + "];");
            if (child.Lookups.Count > 0)
                T($"  {child.Var}Names: Record<string, Record<string, string>> = {{}};");
        }
        foreach (var child in editableChildren)
        {
            // the rows of the form's own child list: plain objects the inputs edit, sent with the row (prepare below)
            T($"  {child.Var}Rows: any[] = [];");
            if (EditableChild.Columns(LinkOf(child.Table)).Any(c => EditLookupOf(LinkOf(child.Table), c) is not null))
                T($"  {child.Var}Options: Record<string, {{ id: any; name: string }}[]> = {{}};");
        }
        T();
        {
            var parentsToLoad = parents.ToList();   // a drop-down over this table itself (a manager) is read through the screen's own service
            var optionLoads = editableChildren.SelectMany(child => EditableChild.Columns(LinkOf(child.Table))
                .Select(c => (Child: child, Column: c, Lookup: EditLookupOf(LinkOf(child.Table), c))).Where(x => x.Lookup is not null)).ToList();
            if (parentsToLoad.Count > 0 || optionLoads.Count > 0)
            {
                T("  protected override start(): void {");
                T("    super.start();");
                foreach (var p in parentsToLoad)
                    T($"    this.{(p.Self ? "service" : p.ServiceVar)}.{(p.Lookup ? "getLookup" : "getAll")}().subscribe((data) => {{ this.{p.List} = data; }});");
                foreach (var (child, column, lookup) in optionLoads)
                    T($"    this.http.get<any[]>('{apiPrefix}/{ScreenNames.ApiRoute(lookup.ReferencedTable)}/lookup').subscribe((items) => {{ this.{child.Var}Options = {{ ...this.{child.Var}Options, {JsonNames.Camel(column.Name)}: items.map((i) => ({{ id: i['id'], name: String(i['name'] ?? '') }})) }}; }});");
                T("  }");
                T();
            }
        }
        var adds = new List<string>();
        if (textKey) adds.Add($"{keyProp}: {emptyKey}");
        foreach (var c in Model.Columns.Where(c => !c.IsPrimaryKey && !c.IsNullable && !c.IsComputed && !c.IsIdentity))
        {
            string value;
            if (c.IsBooleanColumn) value = c.DatabaseDefaultSql is not null && c.DatabaseDefaultSql.Trim('(', ')', ' ') == "1" ? "true" : "false";
            else if (IsDate(c)) value = "new Date().toISOString().substring(0, 10)";
            else if (IsNumber(c)) value = "0";
            else value = "''";
            adds.Add($"{JsonNames.Camel(c.Name)}: {value}");
        }
        T($"  protected newRow(): {baseName} {{");
        T(adds.Count == 0 ? "    return { };" : $"    return {{ {string.Join(", ", adds)} }};");
        T("  }");
        var dateColumns = shown.Where(c => IsDate(c) && !c.IsSystemStampColumn).ToList();   // a stamp keeps the timestamp the API sent
        if (dateColumns.Count > 0)
        {
            T();
            T($"  protected override prepareEdit(copy: {baseName}): {baseName} {{");
            T("    // the date box wants yyyy-MM-dd; the API sends a full timestamp");
            foreach (var c in dateColumns)
            {
                string prop = $"copy.{JsonNames.Camel(c.Name)}";
                if (c.IsNullable) T($"    if ({prop}) {{ {prop} = {prop}.substring(0, 10); }}");
                else T($"    {prop} = {prop}.substring(0, 10);");
            }
            T("    return copy;");
            T("  }");
        }
        if (tabbed)
        {
            T();
            T("  protected override opened(): void {");
            T("    this.activeTab = 0;");
            T("  }");
        }
        if (children.Count > 0)
        {
            // a new row has no child rows yet; an opened row shows the ones that point at it
            T();
            T("  override add(): void {");
            T("    super.add();");
            foreach (var child in children)
            {
                T($"    this.{child.Var}Rows = [];");
                if (!IsEditableChild(child.Table)) T($"    this.{child.Var}Columns = [];");
            }
            T("  }");
            T();
            T($"  override edit({variable}: {baseName}): void {{");
            T($"    super.edit({variable});");
            foreach (var child in children)
                T($"    this.load{child.MethodName}({variable}.{keyProp}!);");
            T("  }");
        }
        foreach (var p in parents)
        {
            T();
            T($"  // the name to show in place of a {p.Type} id");
            T($"  {p.NameMethod}(id?: {p.IdType}): string {{");
            T($"    return this.{p.List}.find((p) => p.{p.KeyProp} === id)?.{p.DisplayProp} ?? '';");
            T("  }");
        }
        foreach (var child in editableChildren)
        {
            var link = LinkOf(child.Table);
            var editColumns = EditableChild.Columns(link);
            var childDates = editColumns.Where(IsDate).ToList();
            var defaults = new List<string>();
            foreach (var c in editColumns.Where(c => !c.IsNullable))
            {
                if (EditLookupOf(link, c) is not null) defaults.Add($"{JsonNames.Camel(c.Name)}: null");
                else if (c.IsBooleanColumn) defaults.Add($"{JsonNames.Camel(c.Name)}: {(c.DatabaseDefaultSql is not null && c.DatabaseDefaultSql.Trim('(', ')', ' ') == "1" ? "true" : "false")}");
                else if (IsDate(c)) defaults.Add($"{JsonNames.Camel(c.Name)}: new Date().toISOString().substring(0, 10)");
                else if (IsNumber(c)) defaults.Add($"{JsonNames.Camel(c.Name)}: 0");
                else defaults.Add($"{JsonNames.Camel(c.Name)}: ''");
            }
            T();
            T($"  // {child.Title} are part of this form: the rows that point at the row being edited are read once, edited here and sent with the row under '{child.JsonName}'.");
            T($"  // The API makes the table match the list: a row with its key is changed, a row without one is added, a row left out is removed.");
            T($"  private load{child.MethodName}(parentId: {keyTs}): void {{");
            T($"    this.http.get<any[]>('{apiPrefix}/{child.Route}').subscribe({{");
            T("      next: (rows) => {");
            T($"        this.{child.Var}Rows = rows.filter((r: any) => r['{child.FkProp}'] === parentId).map((r: any) => ({{ ...r{string.Concat(childDates.Select(c => $", {JsonNames.Camel(c.Name)}: r['{JsonNames.Camel(c.Name)}']?.substring(0, 10) ?? null"))} }}));");
            T("      },");
            T("      error: (e) => console.error(e)");
            T("    });");
            T("  }");
            T();
            T($"  add{child.MethodName}(): void {{");
            T($"    this.{child.Var}Rows = [...this.{child.Var}Rows, {{ {string.Join(", ", defaults)} }}];");
            T("  }");
            T();
            T($"  remove{child.MethodName}(row: any): void {{");
            T($"    this.{child.Var}Rows = this.{child.Var}Rows.filter((r) => r !== row);");
            T("  }");
        }
        if (editableChildren.Count > 0)
        {
            T();
            T("  // the child lists go in the request body with the row");
            T($"  protected override prepare(row: {baseName}, isNew: boolean): void {{");
            T("    super.prepare(row, isNew);");
            foreach (var child in editableChildren)
                T($"    (row as unknown as Record<string, unknown>)['{child.JsonName}'] = this.{child.Var}Rows;");
            T("  }");
        }
        foreach (var child in gridChildren)
        {
            T();
            T($"  // {child.Title} rows whose {child.FkProp} matches the row being edited - the whole table is loaded and");
            T("  // filtered client-side (same no-paging simplification TS_Component.tt's own grid makes), and the columns");
            T("  // shown are whatever keys the first row actually has, since this template never sees the child's own schema.");
            T($"  private load{child.MethodName}(parentId: {keyTs}): void {{");
            T($"    this.http.get<any[]>('{apiPrefix}/{child.Route}').subscribe({{");
            T("      next: (rows) => {");
            T($"        this.{child.Var}Rows = rows.filter((r: any) => r['{child.FkProp}'] === parentId);");
            T($"        this.{child.Var}Columns = this.{child.Var}Rows.length > 0 ? this.orderColumns(Object.keys(this.{child.Var}Rows[0]), this.{child.Var}Hidden) : [];");
            foreach (var lookup in child.Lookups)
                T($"        this.http.get<any[]>('{apiPrefix}/{lookup.Route}').subscribe((items) => {{ this.{child.Var}Names = {{ ...this.{child.Var}Names, {lookup.Column}: Object.fromEntries(items.map((i) => [String(i['{lookup.Key}']), String(i['{lookup.Display}'] ?? '')])) }}; }});");
            T("      },");
            T("      error: (e) => console.error(e)");
            T("    });");
            T("  }");
            if (child.KeyProp is not null)
            {
                T();
                T($"  // Edit opens the {child.Title}'s own page on that row; saving or cancelling there comes back here with this {title} open again.");
                T($"  edit{child.MethodName}(row: any): void {{");
                string childKey = child.KeyIsText ? $"encodeURIComponent(row['{child.KeyProp}'])" : $"row['{child.KeyProp}']";
                string selfKey = textKey ? $"encodeURIComponent(this.selectedRow?.{keyProp} ?? '')" : $"this.selectedRow?.{keyProp}";
                T($"    this.router.navigateByUrl(`/{child.PageRoute}?edit=${{{childKey}}}&back=${{encodeURIComponent('/{selfRoute}?edit=' + {selfKey})}}`);");
                T("  }");
                T();
                T($"  delete{child.MethodName}(row: any): void {{");
                T("    if (!this.notifier.confirm('Are you sure you want to delete this?')) return;");
                T($"    this.http.delete(`{apiPrefix}/{child.Route}/${{{childKey}}}`).subscribe({{");
                T($"      next: () => this.load{child.MethodName}(this.selectedRow!.{keyProp}!),");
                T("      error: (error) => this.notifier.error(apiMessage(error, error.status == 400 ? 'It cannot be deleted because it is in use!' : 'Problem while deleting! ' + error.message))");
                T("    });");
                T("  }");
            }
        }
        if (gridChildren.Count > 0)
        {
            var allCurrency = gridChildren.SelectMany(ch => ch.Currency).GroupBy(m => m.Name).Select(g => g.First()).ToList();
            var allLongText = gridChildren.SelectMany(ch => ch.LongText).Distinct().ToList();
            // A click on a header sorts by it (again: flips the direction), the right-click menu clears the sort; the sort is saved (grid-sort.ts).
            T();
            T("  sortChildBy(child: string, column: string): void {");
            T("    this.childSorts[child] = nextSort(this.childSorts[child] ?? null, column);");
            T("    saveSort(this.gridKey + '.' + child, this.childSorts[child]);");
            T("  }");
            T();
            T("  clearChildSort(child: string): void {");
            T("    this.childSorts[child] = null;");
            T("    saveSort(this.gridKey + '.' + child, null);");
            T("    this.childSortMenu = null;");
            T("  }");
            T();
            T("  openChildSortMenu(event: MouseEvent, child: string): void {");
            T("    event.preventDefault();");
            T("    this.childSortMenu = { child, x: event.clientX, y: event.clientY };");
            T("  }");
            T();
            T("  @HostListener('document:click')");
            T("  @HostListener('document:keydown.escape')");
            T("  closeChildSortMenu(): void {");
            T("    this.childSortMenu = null;");
            T("  }");
            T();
            T("  childSortMark(child: string, column: string): string {");
            T("    const sort = this.childSorts[child];");
            T("    return sort?.column === column ? (sort.descending ? ' \\u25BC' : ' \\u25B2') : '';");
            T("  }");
            T();
            T("  childAriaSort(child: string, column: string): 'ascending' | 'descending' | null {");
            T("    const sort = this.childSorts[child];");
            T("    return sort?.column === column ? (sort.descending ? 'descending' : 'ascending') : null;");
            T("  }");
            T();
            T("  // The rows in the child grid's sort order; a column that shows a name instead of an id sorts by the name.");
            T("  sortedChildRows(child: string, rows: any[], names?: Record<string, Record<string, string>>): any[] {");
            T("    const sort = this.childSorts[child] ?? null;");
            T("    return sortRows(rows, sort, sort ? names?.[sort.column] : undefined);");
            T("  }");
            T();
            T("  // Child grids show whatever keys the API returns; these members caption them, leave out long text, limit them to 20 and format money and dates.");
            T("  private readonly childCurrencyDigits: Record<string, number> = { " + string.Join(", ", allCurrency.Select(m => m.Name + ": " + m.Digits)) + " };");
            var allCaptions = gridChildren.SelectMany(ch => ch.Captions).GroupBy(m => m.Name).Select(g => g.First()).ToList();
            T("  private readonly childCaptions: Record<string, string> = { " + string.Join(", ", allCaptions.Select(m => m.Name + ": '" + m.Caption.Replace("'", "\'") + "'")) + " };");
            T("  private readonly childLongTextColumns: string[] = [" + string.Join(", ", allLongText.Select(n => "'" + n + "'")) + "];");
            T();
            T("  orderColumns(keys: string[], hidden: string[]): string[] {");
            T("    // Only the child table's own columns: the API also sends each navigation property (customer, customerMonthlySummary, ...), which is not a column.");
            T($"    return keys.filter((k) => k in this.childCaptions && !hidden.includes(k) && !this.childLongTextColumns.includes(k)).slice(0, {GridColumns.MaxColumns});");
            T("  }");
            T();
            T("  caption(key: string): string {");
            T("    if (key in this.childCaptions) return this.childCaptions[key];");
            T("    const spaced = key.replace(/Id$/, '').replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/([A-Z])([A-Z][a-z])/g, '$1 $2');");
            T("    return spaced.split(' ').filter(Boolean).map((w) => {");
            T("      const l = w.toLowerCase();");
            T("      return l === 'number' || l === 'num' ? '#' : l === 'percentage' || l === 'percent' || l === 'pct' ? '%' : w.charAt(0).toUpperCase() + w.slice(1);");
            T("    }).join(' ');");
            T("  }");
            T();
            T("  cell(value: unknown, key: string, names?: Record<string, string>): string {");
            T("    if (value === null || value === undefined) return '';");
            T("    if (names) return names[String(value)] ?? String(value);");
            T("    if (typeof value === 'boolean') return value ? 'Yes' : 'No';");
            T("    if (typeof value === 'number' && key in this.childCurrencyDigits) {");
            T("      const d = this.childCurrencyDigits[key];");
            T("      return value.toLocaleString(undefined, { style: 'currency', currency: '" + Project.CurrencyCode + "', minimumFractionDigits: d, maximumFractionDigits: d });");
            T("    }");
            T("    // A date-and-time string from the API (2026-09-27T00:00:00) shows as its date only.");
            T("    return typeof value === 'string' ? value.replace(/^(\\d{4}-\\d{2}-\\d{2})T.*$/, '$1') : String(value);");
            T("  }");
        }
        T("}");

        var o = new StringBuilder();
        o.Append($"@@@FILE {componentsFolder}/{stem}-detail-master/{stem}-detail-master.component.css@@@\n").Append(GridSortStyles.Css);
        if (editableChildren.Count > 0)
            o.Append("\n.child-edit { margin: 1rem 0; border: 1px solid #ccc; }\n.child-edit table { width: 100%; }\n.child-edit td { padding: 2px 4px; }\n.child-edit input[type=text], .child-edit input[type=number], .child-edit input[type=date], .child-edit select { width: 100%; box-sizing: border-box; }\n");
            if (editableChildren.Any(ch => EditableChild.UsesCards(LinkOf(ch.Table))))
                o.Append(".child-card { border: 1px solid #8886; border-radius: 6px; padding: 4px 12px 12px; margin-bottom: 12px; }\n.child-card-head { display: flex; justify-content: space-between; align-items: center; }\n.child-card-fields { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 0 12px; }\n.child-field { display: flex; flex-direction: column; }\n.child-field-wide { grid-column: 1 / -1; }\n");
        o.Append($"@@@FILE {componentsFolder}/{stem}-detail-master/{stem}-detail-master.component.html@@@\n").Append(Project.AdaptAngularHtml(html.ToString()));
        o.Append($"@@@FILE {componentsFolder}/{stem}-detail-master/{stem}-detail-master.component.spec.ts@@@\n").Append(Project.AdaptAngularSpec(spec.ToString()));
        o.Append($"@@@FILE {componentsFolder}/{stem}-detail-master/{stem}-detail-master.component.ts@@@\n").Append(ts);
        Write(o.ToString());
    }
#>
