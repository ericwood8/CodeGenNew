<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ parameter name="Variant" type="System.String" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string componentsFolder = Project.ComponentsFolder;
    string servicesFolder = Project.ServicesFolder;
    string modelsFolder = Project.ModelsFolder;
    string apiPrefix = "api";
    // ==========================================================================================

    // ==========================================================================================
    // TS_DetailMasterComponent_v1.tt
    // Generates the four files of an Angular component in components/<table>-detail-master/ (the paths are written by the template, point the output folder at src/app)
    // TS_Component's grid, search, paging and add/edit form, plus one read-only grid per child table under the form while a row is edited, sortable
    // and clickable (a row opens its own screen). The Angular counterpart of WinUI3_DetailMasterScreen. Needs a table with at least one child foreign key.
    // A child the project lists in EditableChildren (Department.DepartmentTeam) is an editable table inside the form instead, saved with the row in one request (see EditableChild in Core).
    // TS_ODataDetailMasterComponent is this template run with Variant=OData (its config says Base=TS_DetailMasterComponent_v1.tt): the same screen over the table's OData service, with the names, the
    // sort badges, the filter row and the slim grid of TS_Component's OData form (see there). The child grids read the child's OData entity set filtered by the parent's key when the project serves the
    // child as OData (ODataPlan.ServesByName), else the child's REST route as before; a table with editable child lists has no OData screen (the OData routes do not save the lists).
    // A Columns button above the grid shows or hides each column of the table (ChosenGridColumns in Core; the helpers are grid-columns.ts, TS_GridColumns): the choice is kept in the browser, and an OData screen asks only for the shown columns.
    // Full notes: Docs/TemplateNotes/TS_DetailMasterComponent_v1.md
    // ==========================================================================================

    // A decimal, float or real column that is not money (a percentage, a rate, a quantity, a weight) is limited to what the column can hold (a percentage to 0-100).

    var form = FormModel.For(Model, Project);   // what the screen is made of, decided in Core for every stack
    var keyColumn = form.KeyColumn;
    var keyType = form.KeyType;   // how the key travels: a number, or a string for a uniqueidentifier or a text key
    if (Variant == "OData" && !ODataPlan.Serves(Model, Project))
    {
        // the OData screen is written for the tables the project serves as OData (OData=true, ODataTables) and for no other; a plan runs this template for every master-detail table, so it says nothing for the rest
    }
    else if (Project.NoApiFor(Model.TableName, Model.LookupShape))
    {
        Error($"TS_DetailMasterComponent writes no screen for [{Model.SchemaName}].[{Model.TableName}]: it is an enum or excluded by the NoApiTables setting (an enum, a *Type lookup table, or a table with no entity class), so there is no API for it to show.");
    }
    else if (keyColumn is null || keyType is null)
    {
        Error($"TS_DetailMasterComponent needs a table with a single int, uniqueidentifier or text primary key (the routes take the id as {{id:int}}, {{id:guid}} or {{id}}), but [{Model.SchemaName}].[{Model.TableName}] has "
              + (Model.PrimaryKeyColumns.Count == 0 ? "none." : Model.PrimaryKeyColumns.Count > 1 ? "a composite primary key." : $"a {keyColumn.SqlTypeDeclaration} primary key."));
    }
    else if (!Model.HasAtLeastOneChildForeignKey)
    {
        Error($"TS_DetailMasterComponent needs at least one other table with a foreign key pointing back at [{Model.SchemaName}].[{Model.TableName}]; none was found - use TS_Component instead.");
    }
    else
    {
        bool odata = Variant == "OData";
        // A table with a Name and an IsActive column (a department and its teams) has no search endpoint: its screen is on NameActiveCrudScreen (see TS_Component), with no paging or sorting of its own grid.
        bool nameActive = form.IsNameActive;
        string baseName = form.BaseName;
        string stem = form.Stem;
        string screenStem = odata ? AngularNames.ODataComponentStem(Model.TableName) : stem + "-detail-master";   // the screen's folder, files and selector
        string gridKey = odata ? screenStem : stem;   // where the grid's saved sort is kept
        string serviceClass = odata ? AngularNames.ODataServiceClass(Model.TableName) : AngularNames.ServiceClass(Model.TableName);
        string serviceFile = odata ? AngularNames.ODataServiceFile(Model.TableName) : AngularNames.ServiceFile(Model.TableName);
        // OData writes a date and time with a Z (the column has no zone: its wall-clock value is taken as UTC); the date pipe then shows it in UTC, so the day a column holds is the day the grid shows
        string dateZone = odata ? ":'UTC'" : "";
        // The Columns list: the grid starts with the columns GridColumns picks and offers every column of the form; a name / active list is short and has no such list.
        var chosen = ChosenGridColumns.For(form);
        bool chooseColumns = !form.IsNameActive;
        var columnList = chooseColumns ? chosen.Offered : chosen.Initial;   // the columns the grid has a header and a cell for, in order; a hidden one is not drawn
        var odataFilters = odata && !form.IsNameActive ? columnList.Select(c => c.Filter).ToList() : null;   // the filter row's control of each of those columns (null: none)
        string If(ColumnModel c) => chooseColumns ? $" *ngIf=\"columns.has('{c.Name}')\"" : "";   // the attribute that draws a cell only while its column is chosen
        string variable = form.Variable;        // holiday
        string keyProp = JsonNames.Camel(keyColumn.Name);         // holidayId
        string keyTs = keyType.TypeScript;
        string emptyKey = keyType.TypeScriptEmpty;
        bool textKey = form.TextKey;    // the key is a box on the form (typed on a new row, read-only on an existing one) and a column of the grid
        // the child grids and the "save first" note show once the row exists: for a typed key that is `!adding`, since the key is set on a new row too
        string savedTest = textKey ? "!adding" : "selectedRow." + keyProp;
        string title = form.Title;
        bool hasName = form.HasName; // just for showError's message wording below
        const int pageSize = 20;
        // The same paging and search bar as TS_Component: one text box per searchable column (Model.SearchableColumns), paged by the API's /search endpoint.
        // The Search list protocol (ListProtocol=Search) has one search box for the whole table; the server decides which columns it matches.
        var searchFields = form.WebSearchFields;
        // a drop-down of the parent's rows per whole-number foreign key: an exact match on the key (the OData screen has its own filter row)
        IReadOnlyList<SearchKeyField> searchKeys = odata ? [] : form.SearchKeys;
        bool canSearch = !nameActive && (searchFields.Count > 0 || searchKeys.Count > 0);
        // The route of a table's own page ("SalesInvoice" -> "sales-invoice"): the project's routing has one route per generated page, named this way.
        string selfRoute = ScreenNames.Route(Model.TableName);

        var shown = form.Columns;

        var parents = form.Parents;
        // a parent with too many rows for a drop-down is found by typing (type-ahead.ts), in the form and in the OData filter row
        bool Ahead(FormParent p) => p.TypeAhead;
        string ColumnAhead(ODataFilterField f) => f.Property + "ColumnAhead";
        string FormAhead(ColumnModel c) => JsonNames.Camel(c.Name) + "Ahead";
        string FilterAhead(SearchKeyField k) => k.ParamName + "FilterAhead";
        string NamesOf(FormParent p) => p.Variable + "NameCache";
        var formAheads = shown.Where(c => form.KindOf(c) == FieldKind.Lookup && Ahead(form.ParentOf(c)!)).ToList();   // the form fields that are type-aheads
        var filterAheads = searchKeys.Where(k => Ahead(k.Parent)).ToList();                                          // the search keys that are type-aheads
        var columnAheads = (odataFilters ?? []).OfType<ODataFilterField>().Where(f => f.Kind == ODataFilterKind.Parent && Ahead(f.Parent!)).ToList();   // the filter-row parents that are type-aheads

        // The child tables, decided in Core for every stack (ChildGrid): which ones get a grid, its heading and role, its key, and the foreign keys shown as names.
        var children = ChildGrid.For(Model, Project);


        // EditableChildren: the child tables whose rows are added, changed and removed inside this form and sent with it in one request (EditableChild, the rule the API's create and update use too);
        // every other child keeps its read-only grid under the form
        var gridChildren = children.Where(g => !g.IsEditable).ToList();
        var editableChildren = children.Where(g => g.IsEditable).ToList();
        string ChildInput(ChildGrid child, ColumnModel c)
        {
            string childVar = child.Variable;
            string model = $"row.{JsonNames.Camel(c.Name)}";
            string name = $"[name]=\"'{childVar}{UpperFirst(JsonNames.Camel(c.Name))}' + {childVar}Rows.indexOf(row)\"";
            string req = c.IsNullable ? "" : " required";
            if (child.EditTypeAhead(c))
            {
                string rowAhead = $"{childVar}{UpperFirst(JsonNames.Camel(c.Name))}Aheads.of(row)";
                string cellBox = $"{childVar}{UpperFirst(JsonNames.Camel(c.Name))}Box";   // a required cell hands its input to the box, which fails the browser's check while text is typed and not picked
                return $"<div class=\"type-ahead\"><input type=\"text\" {name}{(req.Length > 0 ? $" #{cellBox}" : "")} autocomplete=\"off\" role=\"combobox\" aria-autocomplete=\"list\" [attr.aria-expanded]=\"{rowAhead}.open\" [ngModel]=\"{rowAhead}.shown({model})\" (ngModelChange)=\"{rowAhead}.type($event{(req.Length > 0 ? ", " + cellBox : "")})\" (blur)=\"{rowAhead}.leave()\"{req}>"
                       + $"<ul class=\"type-ahead-list\" role=\"listbox\" *ngIf=\"{rowAhead}.open\"><li role=\"option\" *ngFor=\"let o of {rowAhead}.options\" (mousedown)=\"{rowAhead}.pick(o)\">{{{{o.name}}}}</li></ul></div>";
            }
            if (child.EditLookupOf(c) is not null)
                return $"<select {name} [(ngModel)]=\"{model}\"{req}>{(c.IsNullable ? "<option [ngValue]=\"null\"></option>" : "")}<option *ngFor=\"let p of {childVar}Options['{JsonNames.Camel(c.Name)}']\" [ngValue]=\"p.id\">{{{{p.name}}}}</option></select>";
            if (c.HasChoices)
                return $"<select {name} [(ngModel)]=\"{model}\"{req}>{(c.IsNullable ? "<option [ngValue]=\"null\"></option>" : "<option value=\"\"></option>")}{string.Concat(c.Choices!.Select(choice => $"<option value=\"{ChoiceFormat.Html(choice)}\">{ChoiceFormat.Html(choice)}</option>"))}</select>";
            if (c.IsBooleanColumn)
                return $"<input type=\"checkbox\" {name} [(ngModel)]=\"{model}\">";
            if (IsDate(c))
                return $"<input type=\"date\" {name} [(ngModel)]=\"{model}\"{req}>";
            if (child.IsMoneyInput(c))
            {
                var money = child.MoneyBoxOf(c);
                return $"<input type=\"text\" inputmode=\"decimal\" {name} appCurrency currencyCode=\"{money.Currency}\" [digits]=\"{money.Digits}\""
                       + (money.Min is { } lo ? $" [min]=\"{lo}\"" : "") + (money.Max is { } hi ? $" [max]=\"{hi}\"" : "") + $" [(ngModel)]=\"{model}\"{req}>";
            }
            if (IsNumber(c))
                return $"<input type=\"number\" {name} [(ngModel)]=\"{model}\"{child.NumberBoxOf(c).Html}{req}>";
            string max = IsText(c) && Chars(c) > 0 ? $" maxlength=\"{Chars(c)}\"" : "";
            return $"<input type=\"text\" {name} [(ngModel)]=\"{model}\"{max}{req}>";
        }
        bool UsesCurrencyBox() => shown.Any(form.IsMoneyInput) || editableChildren.Any(ch => ch.EditColumns.Any(c => ch.IsMoneyInput(c)));
        IReadOnlyList<ColumnModel> sortableColumns = nameActive ? [] : columnList.Where(c => c.Sortable).Select(c => c.Column).ToList();
        bool canClone = form.CanClone;
        string rowsExpression = nameActive ? "visibleRows" : "rows";
        var formPages = form.Pages;
        bool tabbed = form.IsTabbed;
        // WriteRoles with the Angular sign-in: only the roles that may write see Add, Edit, Clone and Delete (the API refuses the others with a 403 anyway)
        IReadOnlyList<string> writeRoles = Project.Auth ? WriteRolePlan.For(Project, Model) : new List<string>();
        string writeOnly = writeRoles.Count > 0 ? " *ngIf=\"canWrite\"" : "";

        var css = new StringBuilder();
        var html = new StringBuilder();
        var spec = new StringBuilder();
        var ts = new StringBuilder();
        void H(string s = "") => html.Append(s).Append('\n');
        void T(string s = "") => ts.Append(s).Append('\n');

        // ================= html
        H("<main class=\"main\">");
        H("    <div class=\"content\">");
        H("      <div class=\"left-side\">");
        H("<div>");
        H("    <!-- Heading -->");
        H($"    <h1>{title.Pluralize()}</h1>");
        H($"    <button{writeOnly} (click)=\"add()\" class=\"btn\">Add New</button>");
        // The OData screen has the filter row under the headers (a control per column, Search and Clear in its last cell); only the one box of the Search list protocol stays above the grid.
        if (canSearch && (!odata || Project.ListSearchProtocol))
        {
            H();
            H("    <!-- Search -->");
            H("    <div class=\"form-group form-group-search dept\">");
            foreach (var f in searchFields)
                H($"        <input type=\"text\" class=\"form-control\" placeholder=\"Search{(f.Label == "" ? "" : " by " + f.Label)}\" [(ngModel)]=\"filters.{f.ParamName}\"{(odata ? " (keyup.enter)=\"search()\"" : "")} />");
            foreach (var k in searchKeys)
            {
                if (Ahead(k.Parent))
                {
                    string ahead = FilterAhead(k);
                    H("        <div class=\"type-ahead\">");
                    H($"            <input type=\"text\" class=\"form-control\" autocomplete=\"off\" role=\"combobox\" aria-autocomplete=\"list\" [attr.aria-expanded]=\"{ahead}.open\" aria-label=\"Filter by {k.Label}\" placeholder=\"All {k.Label.Pluralize()}\" [ngModel]=\"{ahead}.shown(filters.{k.ParamName})\" (ngModelChange)=\"{ahead}.type($event)\" (blur)=\"{ahead}.leave()\" />");
                    H($"            <ul class=\"type-ahead-list\" role=\"listbox\" *ngIf=\"{ahead}.open\">");
                    H($"                <li role=\"option\" *ngFor=\"let o of {ahead}.options\" (mousedown)=\"{ahead}.pick(o)\">{{{{o.name}}}}</li>");
                    H("            </ul>");
                    H("        </div>");
                    continue;
                }
                H($"        <select class=\"form-control\" aria-label=\"Filter by {k.Label}\" [(ngModel)]=\"filters.{k.ParamName}\" (ngModelChange)=\"search()\">");
                H($"            <option value=\"\">All {k.Label.Pluralize()}</option>");
                H($"            <option *ngFor=\"let p of {k.Parent.List}\" [value]=\"p.{k.Parent.KeyJson}\">{{{{p.{k.Parent.DisplayJson}}}}}</option>");
                H("        </select>");
            }
            if (!odata)
            {
                H("        <button class=\"btn btn-outline-secondary\" type=\"button\" (click)=\"search()\"> Search </button>");
                H("        <button class=\"btn btn-outline-secondary\" type=\"button\" (click)=\"clearSearch()\"> Clear </button>");
            }
            H("    </div>");
        }
        if (nameActive)
        {
            H();
            H("    <!-- Search -->");
            H("    <div class=\"form-group form-group-search dept\">");
            H("        <input type=\"text\" class=\"form-control\" placeholder=\"Search by Name\" [(ngModel)]=\"searchText\" />");
            H("        <label class=\"active-only\"><input type=\"checkbox\" name=\"activeOnly\" [(ngModel)]=\"activeOnly\" /> Active only</label>");
            H("        <button class=\"btn btn-outline-secondary\" type=\"button\" (click)=\"clearSearch()\"> Clear </button>");
            H("    </div>");
        }
        if (chooseColumns)
        {
            H();
            H("    <!-- Columns -->");
            H("    <details class=\"column-picker\">");
            H("        <summary>Columns</summary>");
            H("        <div class=\"column-list\">");
            H("            <label *ngFor=\"let column of columns.offered\"><input type=\"checkbox\" [checked]=\"columns.has(column.name)\" [disabled]=\"columns.isLast(column.name)\" (change)=\"toggleColumn(column.name)\" /> {{ column.label }}</label>");
            H("            <button type=\"button\" class=\"btn btn-outline-secondary\" (click)=\"resetColumns()\">Reset</button>");
            H("        </div>");
            H("    </details>");
        }
        H();
        H("    <!-- Grid -->");
        // A right-click on the grid opens a small menu with Clear sort; a click on a sortable header sorts by it (again: flips the direction).
        H(nameActive ? "    <table>" : "    <table (contextmenu)=\"openSortMenu($event)\">");
        H("        <thead>");
        H("            <tr>");
        foreach (var column in columnList)
        {
            var c = column.Column;
            if (sortableColumns.Contains(c) && odata)
                // Shift-click adds the column to the sort; the number says its place when there is more than one
                H($"                <th{If(c)} [attr.aria-sort]=\"ariaSort('{c.Name}')\"><button type=\"button\" class=\"sort-header\" title=\"Click to sort by {Labels.Field(c)}. Shift-click to add it to the sort.\" (click)=\"sortBy('{c.Name}', $event)\">{GridCaption.For(c, Labels.Field(c))}{{{{ sortMark('{c.Name}') }}}}<span class=\"sort-order\" *ngIf=\"sortOrder('{c.Name}')\">{{{{ sortOrder('{c.Name}') }}}}</span></button></th>");
            else if (sortableColumns.Contains(c))
                H($"                <th{If(c)} [attr.aria-sort]=\"ariaSort('{c.Name}')\"><button type=\"button\" class=\"sort-header\" (click)=\"sortBy('{c.Name}')\">{GridCaption.For(c, Labels.Field(c))}{{{{ sortMark('{c.Name}') }}}}</button></th>");
            else
                H($"                <th{If(c)}>{column.Caption}</th>");
        }
        H("                <th>Actions</th>");
        H("            </tr>");
        string ChoiceOptions(IReadOnlyList<string> choices)
        {
            var options = new StringBuilder();
            foreach (string choice in choices)
                options.Append("<option value=\"").Append(ChoiceFormat.Html(choice)).Append("\">").Append(ChoiceFormat.Html(choice)).Append("</option>");
            return options.ToString();
        }
        if (odata && !nameActive)
        {
            // the filter row: one control per column by its kind, an "empty" check box for a column that can be empty, Search and Clear at the end
            H("            <tr class=\"filter-row\">");
            for (int i = 0; i < columnList.Count; i++)
            {
                var c = columnList[i].Column;
                var f = odataFilters![i];
                if (f is null) { H($"                <td{If(c)}></td>"); continue; }
                string typed = $"columnFilters['{f.Name}']";
                string label = Labels.Field(c).Replace("\"", "&quot;");
                string control = f.Kind switch
                {
                    ODataFilterKind.Text => $"<input type=\"text\" class=\"form-control\" placeholder=\"contains\" aria-label=\"Filter by {label}\" [(ngModel)]=\"{typed}.text\" (keyup.enter)=\"search()\" />",
                    ODataFilterKind.Number => $"<div class=\"range\"><input type=\"number\" placeholder=\"from\" aria-label=\"{label} from\" [(ngModel)]=\"{typed}.from\" (keyup.enter)=\"search()\" /><input type=\"number\" placeholder=\"to\" aria-label=\"{label} to\" [(ngModel)]=\"{typed}.to\" (keyup.enter)=\"search()\" /></div>",
                    ODataFilterKind.Date => $"<div class=\"range\"><input type=\"date\" title=\"{label} from\" aria-label=\"{label} from\" [(ngModel)]=\"{typed}.from\" (keyup.enter)=\"search()\" /><input type=\"date\" title=\"{label} to\" aria-label=\"{label} to\" [(ngModel)]=\"{typed}.to\" (keyup.enter)=\"search()\" /></div>",
                    ODataFilterKind.Boolean => $"<select aria-label=\"Filter by {label}\" [(ngModel)]=\"{typed}.flag\"><option [ngValue]=\"undefined\">Any</option><option value=\"true\">Yes</option><option value=\"false\">No</option></select>",
                    ODataFilterKind.Parent when Ahead(f.Parent!) => $"<div class=\"type-ahead\"><input type=\"text\" autocomplete=\"off\" role=\"combobox\" aria-autocomplete=\"list\" [attr.aria-expanded]=\"{ColumnAhead(f)}.open\" aria-label=\"Filter by {label}\" placeholder=\"Any\" [ngModel]=\"{ColumnAhead(f)}.shown({typed}.value)\" (ngModelChange)=\"{ColumnAhead(f)}.type($event)\" (blur)=\"{ColumnAhead(f)}.leave()\" /><ul class=\"type-ahead-list\" role=\"listbox\" *ngIf=\"{ColumnAhead(f)}.open\"><li role=\"option\" *ngFor=\"let o of {ColumnAhead(f)}.options\" (mousedown)=\"{ColumnAhead(f)}.pick(o)\">{{{{o.name}}}}</li></ul></div>",
                    ODataFilterKind.Parent => $"<select aria-label=\"Filter by {label}\" [(ngModel)]=\"{typed}.value\"><option [ngValue]=\"undefined\">Any</option><option *ngFor=\"let p of {f.Parent!.List}\" [ngValue]=\"p.{f.Parent!.KeyJson}\">{{{{p.{f.Parent!.DisplayJson}}}}}</option></select>",
                    _ => $"<select aria-label=\"Filter by {label}\" [(ngModel)]=\"{typed}.value\"><option [ngValue]=\"undefined\">Any</option>{ChoiceOptions(f.Choices)}</select>"
                };
                string empty = f.Nullable && f.Kind != ODataFilterKind.Boolean
                    ? $"<label class=\"empty-toggle\" title=\"Only the rows where {label} is empty\"><input type=\"checkbox\" [(ngModel)]=\"{typed}.empty\" /> empty</label>" : "";
                H($"                <td{If(c)}>{control}{empty}</td>");
            }
            H("                <td class=\"filter-actions\">");
            H("                    <button class=\"btn btn-outline-secondary\" type=\"button\" title=\"Show the rows that match the filters\" (click)=\"search()\">Search</button>");
            H("                    <button class=\"btn btn-outline-secondary\" type=\"button\" title=\"Remove every filter\" (click)=\"clearSearch()\">Clear</button>");
            H("                </td>");
            H("            </tr>");
        }
        H("        </thead>");
        H("        <tbody>");
        H($"            <tr *ngFor=\"let {variable} of {rowsExpression}\">");
        foreach (var column in columnList)
        {
            var c = column.Column;
            string prop = $"{variable}.{JsonNames.Camel(c.Name)}";
            var cellKind = form.CellOf(c);
            string cell;
            if (cellKind == CellKind.Lookup) cell = $"{{{{ {form.ParentOf(c)!.NameMethod}({prop}) }}}}";
            else if (cellKind == CellKind.Boolean) cell = $"{{{{ {prop} ? \"Yes\" : \"No\" }}}}";
            else if (cellKind == CellKind.Date) cell = $"{{{{ {prop} | date:'MM/dd/yyyy'{dateZone} }}}}";
            else if (cellKind == CellKind.DateTime) cell = $"{{{{ {prop} | date:'MM/dd/yyyy HH:mm'{dateZone} }}}}";
            else if (cellKind == CellKind.Money) { int d = NumericClassifier.CurrencyDigits(c); cell = $"{{{{ {prop} | currency:'{Project.CurrencyCode}':'symbol':'1.{Math.Min(2, d)}-{d}' }}}}"; }
            else if (cellKind == CellKind.Decimal) cell = $"{{{{ {prop} | number:'1.2-2' }}}}";
            else cell = column.Cut ? $"{{{{ cut({prop}) }}}}" : $"{{{{ {prop} }}}}";
            H($"                <td{If(c)}>{cell}</td>");
        }
        H("                <td>");
        H($"                    <button{writeOnly} (click)=\"{(odata && !nameActive ? "open" : "edit")}({variable})\" class=\"btn-action\">Edit</button>");
        if (canClone)
            H($"                    <button{writeOnly} (click)=\"clone({variable}.{keyProp}!)\" class=\"btn-action\">Clone</button>");
        H($"                    <button{writeOnly} (click)=\"delete({variable}.{keyProp}!)\" class=\"btn-action delete\">Delete</button>");
        H("                </td>");
        H("            </tr>");
        H("        </tbody>");
        H("    </table>");
        if (nameActive)
        {
            H("    <p *ngIf=\"loaded && visibleRows.length === 0\" class=\"no-rows\">Nothing found.</p>");
        }
        else
        {
            H("    <p *ngIf=\"loaded && totalCount === 0\" class=\"no-rows\">Nothing found.</p>");
            H("    <ul *ngIf=\"sortMenu\" class=\"sort-menu\" role=\"menu\" [style.left.px]=\"sortMenu.x\" [style.top.px]=\"sortMenu.y\">");
            H("        <li role=\"none\"><button type=\"button\" role=\"menuitem\" [disabled]=\"!sort\" (click)=\"clearSort()\">Clear sort</button></li>");
            H("    </ul>");
            H();
            H("    <mat-paginator");
            H("        [length]=\"totalCount\"");
            H("        [pageSize]=\"pageSize\"");
            H("        [pageSizeOptions]=\"[10, 20, 50, 100]\"");
            H("        [pageIndex]=\"pageIndex\"");
            H("        (page)=\"onPageChange($event)\">");
            H("    </mat-paginator>");
        }
        H();
        H("    <!-- Add/Edit Form -->");
        // The add/edit form is a modal <dialog> (native, no library): it opens over the page, wherever the grid is scrolled to, and Escape cancels it.
        H("    <dialog *ngIf=\"selectedRow\" #editDialog class=\"form-container\" (cancel)=\"$event.preventDefault(); cancel()\">");
        string headingTest = textKey ? "adding ? 'Add' : 'Edit'" : "selectedRow." + keyProp + " ? 'Edit' : 'Add'";
        H($"        <h2>{{{{{headingTest}}}}} {title}</h2>");
        H($"        <form id=\"{variable}Form\" ngNativeValidate (ngSubmit)=\"submit(selectedRow)\">");
        if (tabbed)
        {
            H("            <div role=\"tablist\" class=\"form-tabs\">");
            for (int i = 0; i < formPages.Count; i++)
                H($"                <button type=\"button\" role=\"tab\" [attr.aria-selected]=\"activeTab === {i}\" [style.font-weight]=\"activeTab === {i} ? 'bold' : 'normal'\" (click)=\"activeTab = {i}\">{formPages[i].Header.Replace("&", "&amp;")}</button>");
            H("            </div>");
        }
        for (int pageIndex = 0; pageIndex < formPages.Count; pageIndex++)
        {
        if (tabbed) H($"            <div role=\"tabpanel\" data-tab=\"{pageIndex}\" [hidden]=\"activeTab !== {pageIndex}\">");
        foreach (var c in formPages[pageIndex].Columns)
        {
            string id = form.FieldId(c);
            string model = $"selectedRow.{JsonNames.Camel(c.Name)}";
            string req = c.IsNullable ? "" : " required";
            var kind = form.KindOf(c);
            if (kind == FieldKind.SystemStamp)
            {
                // who made the row and when it changed: the system writes it, so it is text, shown once the row exists
                string stampValue = c.IsDateColumn ? "{{ " + model + " | date:'medium'" + dateZone + " }}" : "{{ " + model + " }}";
                // who set a guarded column and when: a row from before the stamp existed says so instead of showing nothing
                if (form.IsGuardStamp(c))
                    stampValue = c.IsDateColumn ? "{{ " + model + " ? (" + model + " | date:'medium'" + dateZone + ") : '" + GuardStamp.NotRecorded + "' }}" : "{{ " + model + " || '" + GuardStamp.NotRecorded + "' }}";
                H($"            <div class=\"form-group\" *ngIf=\"{(textKey ? "!adding" : "selectedRow." + keyProp)}\">");
                H($"                <label for=\"{id}\">{Labels.Field(c)}</label>");
                H($"                <span id=\"{id}\">{stampValue}</span>");
                H("            </div>");
                continue;
            }
            H("            <div class=\"form-group\">");
            H($"                <label for=\"{id}\">{Labels.Field(c)}{RequiredMark.Html(form.IsMarked(c))}</label>");
            // a guarded column is a control only for a person who may change it (the guards answer); everyone else sees its value as text and why
            var guard = form.GuardOf(c);
            if (guard is not null)
                H($"                <ng-container *ngIf=\"guards['{guard.Json}']; else guarded{c.Name}\">");
            if (kind == FieldKind.TypedKey)
            {
                // the key of a new row is typed; once the row exists it is read-only (the API does not change a key)
                string max = Chars(c) > 0 ? $" maxlength=\"{Chars(c)}\"" : "";
                H($"                <input type=\"text\" id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{max} [readonly]=\"!adding\" placeholder=\"{Labels.Placeholder(c)}\"{req}>");
            }
            else if (kind == FieldKind.Lookup)
            {
                var p = form.ParentOf(c)!;
                if (Ahead(p))
                {
                    string ahead = FormAhead(c);
                    H("                <div class=\"type-ahead\">");
                    // a required field hands its input to the box, which fails the browser's check while text is typed and not picked
                    string boxRef = req.Length > 0 ? " #" + JsonNames.Camel(c.Name) + "Box" : "";
                    string boxArg = req.Length > 0 ? ", " + JsonNames.Camel(c.Name) + "Box" : "";
                    H($"                    <input type=\"text\" id=\"{id}\" name=\"{id}\"{boxRef} autocomplete=\"off\" role=\"combobox\" aria-autocomplete=\"list\" [attr.aria-expanded]=\"{ahead}.open\" [ngModel]=\"{ahead}.shown({model})\" (ngModelChange)=\"{ahead}.type($event{boxArg})\" (blur)=\"{ahead}.leave()\"{req}>");
                    H($"                    <ul class=\"type-ahead-list\" role=\"listbox\" *ngIf=\"{ahead}.open\">");
                    H($"                        <li role=\"option\" *ngFor=\"let o of {ahead}.options\" (mousedown)=\"{ahead}.pick(o)\">{{{{o.name}}}}</li>");
                    H("                    </ul>");
                    H("                </div>");
                }
                else
                {
                    H($"                <select id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{req}>");
                    if (c.IsNullable) H("                    <option [ngValue]=\"null\"></option>");
                    H($"                    <option *ngFor=\"let p of {p.List}\" [ngValue]=\"p.{p.KeyJson}\">{{{{p.{p.DisplayJson}}}}}</option>");
                    H("                </select>");
                }
            }
            else if (kind == FieldKind.Choices)
            {
                // A column whose values the database lists (a MySQL enum) is a drop-down of them.
                H($"                <select id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{req}>");
                H(c.IsNullable ? "                    <option [ngValue]=\"null\"></option>" : "                    <option value=\"\"></option>");
                foreach (string choice in c.Choices!)
                    H($"                    <option value=\"{ChoiceFormat.Html(choice)}\">{ChoiceFormat.Html(choice)}</option>");
                H("                </select>");
            }
            else if (kind == FieldKind.Boolean)
            {
                H($"                <input type=\"checkbox\" id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\">");
            }
            else if (kind == FieldKind.Date)
            {
                // A nullable date has a Clear button on the same line, like WinUI3's calendar.
                if (c.IsNullable) H("                <div class=\"date-with-clear\">");
                H($"                <input type=\"date\" id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{req}>");
                if (c.IsNullable)
                {
                    H($"                <button type=\"button\" class=\"btn-action\" (click)=\"{model} = undefined\">Clear</button>");
                    H("                </div>");
                }
            }
            else if (kind == FieldKind.Money)
            {
                // the money box shows $1,234.50 and takes the plain number; the limits are the column's CHECK constraint, or 0 for a column the project lists as never negative
                var money = MoneyBox.For(Model.TableName, c, Project);
                string limits = (money.Min is { } lo ? $" [min]=\"{lo}\"" : "") + (money.Max is { } hi ? $" [max]=\"{hi}\"" : "");
                H($"                <input type=\"text\" inputmode=\"decimal\" id=\"{id}\" name=\"{id}\" appCurrency currencyCode=\"{money.Currency}\" [digits]=\"{money.Digits}\"{limits} [(ngModel)]=\"{model}\"{req}>");
            }
            else if (kind == FieldKind.Number)
            {
                // A whole-number column carries the limits its name and SQL type imply (a month 1-12, a year MinYear-MaxYear, ...).
                H($"                <input type=\"number\" id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{NumberBox.For(Model.TableName, c, Project).Html} placeholder=\"{Labels.Placeholder(c)}\"{req}>");
            }
            else if (kind == FieldKind.Multiline)
            {
                H($"                <textarea id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\" maxlength=\"{Chars(c)}\" placeholder=\"{Labels.Placeholder(c)}\"{req}></textarea>");
            }
            else
            {
                string max = IsText(c) && Chars(c) > 0 ? $" maxlength=\"{Chars(c)}\"" : "";
                string pattern = c.InputPattern(Project, Model.TableName) is { Length: > 0 } p ? " " + p : "";
                H($"                <input type=\"{c.InputType(Project, Model.TableName)}\" id=\"{id}\" name=\"{id}\" [(ngModel)]=\"{model}\"{max}{pattern} placeholder=\"{Labels.Placeholder(c)}\"{req}>");
            }
            if (guard is not null)
            {
                H("                </ng-container>");
                H($"                <ng-template #guarded{c.Name}>");
                H($"                    <span id=\"{id}\">{{{{ {model}{(c.IsBooleanColumn ? " ? 'Yes' : 'No'" : "")} }}}}</span> <small class=\"guard-note\">{guard.Note}</small>");
                H("                </ng-template>");
            }
            H("            </div>");
        }
        if (tabbed) H("            </div>");
        }
        foreach (var child in editableChildren)
        {
            // the child's rows are part of the form: Submit saves them with the row, in one request
            var editColumns = child.EditColumns;
            H();
            H("            <fieldset class=\"child-edit\">");
            H($"                <legend>{child.Title}</legend>");
            if (EditableChild.UsesCards(child.Link))
            {
                // too many columns for one table: each row is a block of labelled fields that wrap, so no box is squeezed
                H($"                <div class=\"child-card\" *ngFor=\"let row of {child.Variable}Rows\">");
                H("                    <div class=\"child-card-head\">");
                H($"                        <strong>{Labels.Words(BaseName(child.Table))}</strong>");
                H($"                        <button type=\"button\" class=\"btn-action delete\" (click)=\"remove{child.Name}(row)\">Remove</button>");
                H("                    </div>");
                H("                    <div class=\"child-card-fields\">");
                foreach (var c in editColumns)
                    H($"                        <label class=\"child-field{(IsMultiline(c) ? " child-field-wide" : "")}\"><span>{GridCaption.For(c, Labels.Field(c))}{RequiredMark.Html(child.IsMarked(c))}</span>{ChildInput(child, c)}</label>");
                H("                    </div>");
                H("                </div>");
                H($"                <button type=\"button\" class=\"btn btn-outline\" (click)=\"add{child.Name}()\">Add {Labels.Words(BaseName(child.Table))}</button>");
                H("            </fieldset>");
                continue;
            }
            H("                <table>");
            H("                    <thead>");
            H("                        <tr>" + string.Concat(editColumns.Select(c => $"<th>{GridCaption.For(c, Labels.Field(c))}{RequiredMark.Html(child.IsMarked(c))}</th>")) + "<th></th></tr>");
            H("                    </thead>");
            H("                    <tbody>");
            H($"                        <tr *ngFor=\"let row of {child.Variable}Rows\">");
            foreach (var c in editColumns)
                H($"                            <td>{ChildInput(child, c)}</td>");
            H($"                            <td><button type=\"button\" class=\"btn-action delete\" (click)=\"remove{child.Name}(row)\">Remove</button></td>");
            H("                        </tr>");
            H("                    </tbody>");
            H("                </table>");
            H($"                <button type=\"button\" class=\"btn btn-outline\" (click)=\"add{child.Name}()\">Add {Labels.Words(BaseName(child.Table))}</button>");
            H("            </fieldset>");
        }
        H();
        H("            <button type=\"submit\" class=\"btn\"" + (tabbed ? " (click)=\"revealInvalidTab($event)\"" : "") + ">Submit</button>");
        H("            <button type=\"button\" (click)=\"cancel()\" class=\"btn btn-outline\">Cancel</button>");
        H("        </form>");
        H();
        if (gridChildren.Count > 0)
            H("        <!-- Child grids: TableModel.ChildForeignKeys, one per table, columns discovered at run time -->");
        foreach (var child in gridChildren)
        {
            H($"        <div class=\"child-grid\" *ngIf=\"{savedTest}; else save{child.Name}First\">");
            H($"            <h3>{child.Title}</h3>");
            foreach (var filter in child.Filters)
            {
                H($"            <select class=\"form-control\" aria-label=\"Filter {child.Title} by {filter.Label}\" [(ngModel)]=\"childFilters['{child.Variable}']['{filter.ColumnJson}']\">");
                H($"                <option value=\"\">All {filter.Label.Pluralize()}</option>");
                H($"                <option *ngFor=\"let choice of childChoices({child.Variable}Rows, '{filter.ColumnJson}', {child.Variable}Names['{filter.ColumnJson}'])\" [value]=\"choice.value\">{{{{choice.name}}}}</option>");
                H("            </select>");
            }
            // The grid holds all its rows, so a header click sorts them in the browser; a right-click opens the Clear sort menu.
            H($"            <table (contextmenu)=\"openChildSortMenu($event, '{child.Variable}')\">");
            H("                <thead>");
            H($"                    <tr><th *ngFor=\"let col of {child.Variable}Columns\" [attr.aria-sort]=\"childAriaSort('{child.Variable}', col)\"><button type=\"button\" class=\"sort-header\" (click)=\"sortChildBy('{child.Variable}', col)\">{{{{caption(col)}}}}{{{{ childSortMark('{child.Variable}', col) }}}}</button></th>{(child.KeyJson is not null ? "<th>Actions</th>" : "")}</tr>");
            H("                </thead>");
            H("                <tbody>");
            // Clicking a row, or its Edit button, opens that row on its own page.
            string shownRows = $"sortedChildRows('{child.Variable}', {child.Variable}Rows{(child.Lookups.Count > 0 ? $", {child.Variable}Names" : "")})";
            H(child.KeyJson is not null
                ? $"                    <tr *ngFor=\"let row of {shownRows}\" (click)=\"edit{child.Name}(row)\" style=\"cursor: pointer\">"
                : $"                    <tr *ngFor=\"let row of {shownRows}\">");
            H($"                        <td *ngFor=\"let col of {child.Variable}Columns\">{{{{cell(row[col], col{(child.Lookups.Count > 0 ? $", {child.Variable}Names[col]" : "")})}}}}</td>");
            if (child.KeyJson is not null)
            {
                H("                        <td>");
                H($"                            <button type=\"button\" class=\"btn-action\" (click)=\"edit{child.Name}(row); $event.stopPropagation()\">Edit</button>");
                H($"                            <button type=\"button\" class=\"btn-action delete\" (click)=\"delete{child.Name}(row); $event.stopPropagation()\">Delete</button>");
                H("                        </td>");
            }
            H("                    </tr>");
            H("                </tbody>");
            H("            </table>");
            H($"            <ul *ngIf=\"childSortMenu && childSortMenu.child === '{child.Variable}'\" class=\"sort-menu\" role=\"menu\" [style.left.px]=\"childSortMenu.x\" [style.top.px]=\"childSortMenu.y\">");
            H($"                <li role=\"none\"><button type=\"button\" role=\"menuitem\" [disabled]=\"!childSorts['{child.Variable}']\" (click)=\"clearChildSort('{child.Variable}')\">Clear sort</button></li>");
            H("            </ul>");
            H("        </div>");
            H($"        <ng-template #save{child.Name}First><p><em>Save this {title} first to see its {child.Title} rows.</em></p></ng-template>");
        }
        H("    </dialog>");
        H("</div>");
        H("</div>");
        H("</div>");
        H("</main>");

        // ================= spec
        string cls = odata ? AngularNames.ODataComponentClass(Model.TableName) : baseName + "DetailMasterComponent";
        spec.Append("import { ComponentFixture, TestBed } from '@angular/core/testing';\nimport { provideHttpClient } from '@angular/common/http';\nimport { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';\nimport { provideRouter } from '@angular/router';\nimport { provideNoopAnimations } from '@angular/platform-browser/animations';\n\n");
        spec.Append($"import {{ {cls} }} from './{screenStem}.component';\n\n");
        spec.Append($"describe('{cls}', () => {{\n  let component: {cls};\n  let fixture: ComponentFixture<{cls}>;\n\n");
        spec.Append($"  beforeEach(async () => {{\n    await TestBed.configureTestingModule({{\n      imports: [{cls}],\n      providers: [provideHttpClient(), provideHttpClientTesting(), provideNoopAnimations(), provideRouter([])]\n    }})\n    .compileComponents();\n\n");
        spec.Append($"    fixture = TestBed.createComponent({cls});\n    component = fixture.componentInstance;\n    fixture.detectChanges();\n  }});\n\n");
        // Server paging: the first page is asked for, and a page past the end (the last row of the last page was deleted) falls back to the last page there is.
        // The project's list protocol decides how the request and the answer are written.
        bool searchProtocol = Project.ListSearchProtocol;
        int specPageBase = searchProtocol ? Project.PageBase : 1;
        string specPageParam = Project.PageParameter;
        string specSizeParam = Project.PageSizeParameter;
        string Asked(int page, string? size = null) => $"(r) => r.url === 'api/{stem.Pluralize()}' && r.params.get('{specPageParam}') === '{page - 1 + specPageBase}'" + (size is null ? "" : $" && r.params.get('{specSizeParam}') === '{size}'");
        string Reply(int page, string size, int total, int pages) => $"{{ '{Project.ItemsMember}': [], '{Project.TotalMember}': {total} }}";
        // The OData screen asks GET odata/<set>?$top=&$skip=&$count=true and reads { value, '@odata.count' }.
        string ODataAsked(string skip, string? top = null) => $"(r) => r.urlWithParams.startsWith('odata/{stem.Pluralize()}?') && r.urlWithParams.includes('$skip={skip}')" + (top is null ? "" : $" && r.urlWithParams.includes('$top={top}')");
        var odataSpecs = new[]
        {
            "  it('asks the server for the first page', () => {",
            "    const http = TestBed.inject(HttpTestingController);",
            $"    const request = http.expectOne({ODataAsked("0")});",
            "    expect(request.request.urlWithParams).toContain('$top=' + component.pageSize);",
            "    request.flush({ value: [], '@odata.count': 0 });",
            "    expect(component.totalCount).toBe(0);",
            "  });",
            "",
            "  it('goes back to the last page there is when the page it asked for is past the end', () => {",
            "    const http = TestBed.inject(HttpTestingController);",
            $"    http.expectOne({ODataAsked("0")}).flush({{ value: [], '@odata.count': 0 }});",
            "    component.onPageChange({ pageIndex: 3, pageSize: 10, length: 25 });",
            $"    http.expectOne({ODataAsked("30", "10")})",
            "      .flush({ value: [], '@odata.count': 25 });",
            $"    const lastPage = http.expectOne({ODataAsked("20", "10")});",
            "    expect(component.pageIndex).toBe(2);",
            "    lastPage.flush({ value: [], '@odata.count': 25 });",
            "  });",
        };
        var pagingSpecs = odata ? odataSpecs : searchProtocol ? new[]
        {
            "  it('asks the server for the first page', () => {",
            "    const http = TestBed.inject(HttpTestingController);",
            $"    const request = http.expectOne({Asked(1)});",
            $"    expect(request.request.params.get('{specSizeParam}')).toBe(String(component.pageSize));",
            $"    request.flush({Reply(1, "component.pageSize", 0, 0)});",
            "    expect(component.totalCount).toBe(0);",
            "  });",
            "",
            "  it('goes back to the last page there is when the page it asked for is past the end', () => {",
            "    const http = TestBed.inject(HttpTestingController);",
            $"    http.expectOne({Asked(1)}).flush({Reply(1, "component.pageSize", 0, 0)});",
            "    component.onPageChange({ pageIndex: 3, pageSize: 10, length: 25 });",
            $"    http.expectOne({Asked(4, "10")})",
            $"      .flush({Reply(4, "10", 25, 3)});",
            $"    const lastPage = http.expectOne({Asked(3)});",
            "    expect(component.pageIndex).toBe(2);",
            $"    lastPage.flush({Reply(3, "10", 25, 3)});",
            "  });",
        } : new[]
        {
            "  it('asks the server for the first page', () => {",
            "    const http = TestBed.inject(HttpTestingController);",
            "    const request = http.expectOne((r) => r.url.endsWith('/search'));",
            "    expect(request.request.params.get('pageNumber')).toBe('1');",
            "    expect(request.request.params.get('pageSize')).toBe(String(component.pageSize));",
            "    request.flush({ items: [], page: 1, pageSize: component.pageSize, totalCount: 0, totalPages: 0 });",
            "    expect(component.totalCount).toBe(0);",
            "  });",
            "",
            "  it('goes back to the last page there is when the page it asked for is past the end', () => {",
            "    const http = TestBed.inject(HttpTestingController);",
            "    http.expectOne((r) => r.url.endsWith('/search')).flush({ items: [], page: 1, pageSize: component.pageSize, totalCount: 0, totalPages: 0 });",
            "    component.onPageChange({ pageIndex: 3, pageSize: 10, length: 25 });",
            "    http.expectOne((r) => r.url.endsWith('/search') && r.params.get('pageNumber') === '4' && r.params.get('pageSize') === '10')",
            "      .flush({ items: [], page: 4, pageSize: 10, totalCount: 25, totalPages: 3 });",
            "    const lastPage = http.expectOne((r) => r.url.endsWith('/search') && r.params.get('pageNumber') === '3');",
            "    expect(component.pageIndex).toBe(2);",
            "    lastPage.flush({ items: [], page: 3, pageSize: 10, totalCount: 25, totalPages: 3 });",
            "  });",
        };
        // A name/active screen reads the whole list from the table's route and narrows it on the page.
        var listSpecs = new[]
        {
            "  it('reads the whole list and narrows it by name and by active', () => {",
            "    const http = TestBed.inject(HttpTestingController);",
            $"    // a drop-down over this table itself (a manager) reads the list as well, so every request for it is answered",
            $"    http.match((r) => r.method === 'GET' && r.url === 'api/{stem.Pluralize()}').forEach((request) => request.flush([",
            "      { name: 'Alpha', isActive: true },",
            "      { name: 'Alphabet', isActive: false },",
            "      { name: 'Beta', isActive: true }",
            "    ]));",
            "    expect(component.visibleRows.length).toBe(3);",
            "    component.searchText = 'alpha';",
            "    expect(component.visibleRows.length).toBe(2);",
            "    component.activeOnly = true;",
            "    expect(component.visibleRows.length).toBe(1);",
            "    component.clearSearch();",
            "    expect(component.visibleRows.length).toBe(3);",
            "  });",
        };
        // an editable child list: rows can be added and removed in the form, and the list goes into the body of the save
        var childSpecs = new List<string>();
        foreach (var child in editableChildren)
        {
            childSpecs.Add("");
            childSpecs.Add($"  it('keeps the {child.Title.ToLowerInvariant()} rows in the form and sends them with the row', () => {{");
            childSpecs.Add("    component.add();");
            childSpecs.Add($"    component.add{child.Name}();");
            childSpecs.Add($"    component.add{child.Name}();");
            childSpecs.Add($"    expect(component.{child.Variable}Rows.length).toBe(2);");
            childSpecs.Add($"    component.remove{child.Name}(component.{child.Variable}Rows[0]);");
            childSpecs.Add($"    expect(component.{child.Variable}Rows.length).toBe(1);");
            childSpecs.Add("    // eslint-disable-next-line @typescript-eslint/no-explicit-any");
            childSpecs.Add("    const row = component.selectedRow as any;");
            childSpecs.Add("    // eslint-disable-next-line @typescript-eslint/no-explicit-any");
            childSpecs.Add("    (component as any).prepare(row, true);");
            childSpecs.Add($"    expect(row['{child.JsonName}'].length).toBe(1);");
            childSpecs.Add("  });");
        }
        // the OData name/active screen reads the table's entity set (every row, its pages followed) and narrows it on the page like the REST one
        var odataListSpecs = new[]
        {
            "  it('reads the whole list and narrows it by name and by active', () => {",
            "    const http = TestBed.inject(HttpTestingController);",
            "    // a drop-down over this table itself (a manager) reads the list as well, so every request for it is answered",
            $"    http.match((r) => r.method === 'GET' && r.urlWithParams.startsWith('odata/{stem.Pluralize()}')).forEach((request) => request.flush({{ value: [",
            "      { name: 'Alpha', isActive: true },",
            "      { name: 'Alphabet', isActive: false },",
            "      { name: 'Beta', isActive: true }",
            "    ] }));",
            "    expect(component.visibleRows.length).toBe(3);",
            "    component.searchText = 'alpha';",
            "    expect(component.visibleRows.length).toBe(2);",
            "    component.activeOnly = true;",
            "    expect(component.visibleRows.length).toBe(1);",
            "    component.clearSearch();",
            "    expect(component.visibleRows.length).toBe(3);",
            "  });",
        };
        // the Columns list: a column cleared leaves the grid (and the properties an OData page asks for), a column ticked joins it, a sort on a hidden column is dropped, Reset puts the starting columns back
        var columnSpecs = new List<string>();
        if (chooseColumns)
        {
            string storageKey = "gridColumns:" + gridKey;
            var clearedColumn = columnList.Count(c => c.Initial) >= 2 ? columnList.FirstOrDefault(c => c.Initial) : null;   // the last shown column cannot be cleared
            var tickedColumn = columnList.FirstOrDefault(c => !c.Initial);
            var sortedColumn = columnList.Count(c => c.Initial) >= 2 ? columnList.FirstOrDefault(c => c.Initial && c.Sortable) : null;
            if (clearedColumn is not null)
            {
                columnSpecs.Add("");
                columnSpecs.Add("  it('hides a column the person clears, keeps the choice and brings it back on Reset', () => {");
                columnSpecs.Add($"    expect(component.columns.has('{clearedColumn.Name}')).toBe(true);");
                columnSpecs.Add($"    component.toggleColumn('{clearedColumn.Name}');");
                columnSpecs.Add($"    expect(component.columns.has('{clearedColumn.Name}')).toBe(false);");
                if (clearedColumn.Sortable) columnSpecs.Add($"    expect(component.sortableColumns).not.toContain('{clearedColumn.Name}');");
                if (odata) columnSpecs.Add($"    expect(component.columns.properties).not.toContain('{clearedColumn.Property}');");
                columnSpecs.Add($"    expect(JSON.parse(localStorage.getItem('{storageKey}') ?? 'null')).not.toContain('{clearedColumn.Name}');");
                columnSpecs.Add("    component.resetColumns();");
                columnSpecs.Add($"    expect(component.columns.has('{clearedColumn.Name}')).toBe(true);");
                columnSpecs.Add($"    expect(localStorage.getItem('{storageKey}')).toBeNull();");
                columnSpecs.Add("  });");
            }
            if (tickedColumn is not null)
            {
                columnSpecs.Add("");
                columnSpecs.Add("  it('shows a column the grid does not start with when the person ticks it', () => {");
                columnSpecs.Add($"    expect(component.columns.has('{tickedColumn.Name}')).toBe(false);");
                columnSpecs.Add($"    component.toggleColumn('{tickedColumn.Name}');");
                columnSpecs.Add($"    expect(component.columns.has('{tickedColumn.Name}')).toBe(true);");
                if (odata) columnSpecs.Add($"    expect(component.columns.properties).toContain('{tickedColumn.Property}');");
                columnSpecs.Add("    component.resetColumns();");
                columnSpecs.Add("  });");
            }
            if (sortedColumn is not null)
            {
                columnSpecs.Add("");
                columnSpecs.Add("  it('drops the sort of a column that is then hidden', () => {");
                columnSpecs.Add($"    component.sortBy('{sortedColumn.Name}');");
                columnSpecs.Add($"    expect(component.sort).toEqual({{ column: '{sortedColumn.Name}', descending: false }});");
                columnSpecs.Add($"    component.toggleColumn('{sortedColumn.Name}');");
                columnSpecs.Add("    expect(component.sort).toBeNull();");
                columnSpecs.Add("    component.resetColumns();");
                columnSpecs.Add("  });");
            }
        }
        spec.Append("  it('should create', () => {\n    expect(component).toBeTruthy();\n  });\n\n" + string.Join("\n", nameActive ? (odata ? odataListSpecs : listSpecs) : pagingSpecs) + (childSpecs.Count > 0 ? "\n" + string.Join("\n", childSpecs) : "") + (columnSpecs.Count > 0 ? "\n" + string.Join("\n", columnSpecs) : "") + "\n});\n");
        if (writeRoles.Count > 0) spec.Append(WriteRoleSpec.For(Project, cls, writeRoles));

        // ================= ts
        // A short class on PagedCrudScreen (components/crud-screen.ts, TS_EssentialCrud): the rows, the open row, add / edit / submit / delete / clone / cancel, the way back to the page that opened a row,
        // the page, the sort and the search boxes are the base's. This class names its service and key and keeps what is the table's own: the starting row, the date boxes, the drop-down lists and the child grids.
        string keyGeneric = keyType.Kind == KeyKind.Int ? "" : ", " + keyType.TypeScript;
        T("import { ChangeDetectionStrategy, Component, " + (gridChildren.Count > 0 ? "HostListener, " : "") + "inject } from '@angular/core';");
        if (gridChildren.Count > 0) T("import { GridSort, loadSort, nextSort, saveSort, sortRows } from '../../grid-sort';");
        T($"import {{ {baseName} }} from '../../{modelsFolder}/{stem}';");
        T($"import {{ {serviceClass} }} from '../../{servicesFolder}/{serviceFile}';");
        if (writeRoles.Count > 0) T($"import {{ AuthService }} from '../../{servicesFolder}/auth.service';");
        if (parents.Any(p => p.UsesLookupEndpoint && !Ahead(p))) T($"import {{ Lookup }} from '../../{servicesFolder}/crud.service';");
        {
            // the helpers of type-ahead.ts this screen uses: the parents' name caches and boxes, the boxes of editable child rows and the names a child grid asks for by key
            var aheadNames = new SortedSet<string>(StringComparer.Ordinal);
            if (parents.Any(Ahead)) aheadNames.Add("LookupNames");
            if (formAheads.Count + filterAheads.Count > 0) aheadNames.Add("TypeAhead");
            if (editableChildren.Any(ch => ch.EditColumns.Any(ch.EditTypeAhead)))
            {
                aheadNames.Add("LookupNames");
                aheadNames.Add("RowAheads");
                aheadNames.Add("lookupCall");
            }
            if (gridChildren.Any(ch => ch.Lookups.Any(l => l.TypeAhead)))
            {
                aheadNames.Add("lookupCall");
                aheadNames.Add("namesOf");
            }
            if (aheadNames.Count > 0) T($"import {{ {string.Join(", ", aheadNames)} }} from '../../{servicesFolder}/type-ahead';");
        }
        foreach (var p in parents.Where(p => !p.IsSelf))
        {
            if (!p.UsesLookupEndpoint) T($"import {{ {p.BaseName} }} from '../../{modelsFolder}/{p.ModelFile}';");
            T($"import {{ {AngularNames.ServiceClass(p.Table)} }} from '../../{servicesFolder}/{AngularNames.ServiceFile(p.Table)}';");
        }
        if (children.Count > 0) T("import { HttpClient } from '@angular/common/http';");
        if (odata && gridChildren.Any(ch => ch.KeyJson is not null && ODataPlan.ServesByName(ch.Table, Project)))
        {
            T($"import {{ readOData }} from '../../{servicesFolder}/odata-crud.service';");
            T($"import {{ odataLiteral, queryString }} from '../../{servicesFolder}/odata-query';");
        }
        T("import { CommonModule } from '@angular/common';");
        T("import { FormsModule } from '@angular/forms';");
        if (UsesCurrencyBox()) T("import { CurrencyInputDirective } from '../currency-input';");
        if (!nameActive) T("import { MatPaginatorModule } from '@angular/material/paginator';");
        if (chooseColumns) T($"import {{ GridColumns{(columnList.Any(c => c.Cut) ? ", cutText" : "")} }} from '../../grid-columns';");
        T(odata && !nameActive ? "import { ColumnFilterField, ODataPagedScreen, saveSorts } from '../odata-screen';" : $"import {{ {(nameActive ? "NameActiveCrudScreen" : "PagedCrudScreen")} }} from '../crud-screen';");
        if (gridChildren.Any(ch => ch.KeyJson is not null)) T($"import {{ apiMessage }} from '../../{servicesFolder}/api-error';");
        T();
        T("@Component({");
        T($"  selector: 'app-{screenStem}',");
        if (Project.AngularStandaloneFlag) T("  standalone: true,");
        T($"  changeDetection: ChangeDetectionStrategy.{Project.AngularEagerStrategy}, // plain properties change inside subscribe callbacks: keep eager checking when OnPush is the default (Angular 22)");
        T("  imports: [ CommonModule, FormsModule" + (UsesCurrencyBox() ? ", CurrencyInputDirective" : "") + (nameActive ? "" : ", MatPaginatorModule") + " ],");
        T($"  templateUrl: './{screenStem}.component.html',");
        T($"  styleUrl: './{screenStem}.component.css'");
        T("})");
        T($"export class {cls} extends {(nameActive ? "NameActiveCrudScreen" : odata ? "ODataPagedScreen" : "PagedCrudScreen")}<{baseName}{keyGeneric}> {{");
        T($"  protected readonly service = inject({serviceClass});");
        if (writeRoles.Count > 0)
        {
            T("  private readonly auth = inject(AuthService);");
            T($"  get canWrite(): boolean {{ return this.auth.hasRole([{WriteRolePlan.Literal(writeRoles, (char)39)}]); }} // WriteRoles: the roles that may add, change and delete rows");
        }
        T($"  protected readonly noun = '{Labels.Words(baseName).ToLowerInvariant()}';");
        T($"  protected readonly idKey = '{keyProp}';");
        if (keyType.Kind != KeyKind.Int) T($"  protected override readonly emptyKey: {keyType.TypeScript} = {emptyKey};");
        if (textKey) T("  protected override readonly keyChosen = true; // the person types the key of a new row: it is sent as typed");
        T($"  protected readonly gridKey = '{gridKey}'; // the grid's saved sort is kept in the browser under this key (see grid-sort.ts)");
        if (!nameActive)
        {
            T("  // the columns the Columns list offers, then the ones the grid starts with; the person's choice is kept in the browser under the grid's key");
            T("  readonly columns = new GridColumns(this.gridKey, [");
            for (int i = 0; i < columnList.Count; i++)
            {
                var column = columnList[i];
                T($"    {{ name: '{column.Name}', label: '{column.Label.Replace("\\", "\\\\").Replace("'", "\\'")}', property: '{column.Property}', sortable: {(column.Sortable ? "true" : "false")} }}{(i < columnList.Count - 1 ? "," : "")}");
            }
            T($"  ], [{string.Join(", ", columnList.Where(c => c.Initial).Select(c => "'" + c.Name + "'"))}]);");
            T("  readonly sortableColumns = this.columns.sortable; // the shown columns whose header sorts the grid (one array, kept up to date)");
            if (columnList.Any(c => c.Cut))
                T("  readonly cut = cutText; // a long or multi-line text shows its first characters in the grid");
        }
        if (!nameActive && Project.DefaultSort(Model.TableName) is { } defaultSort)
            T($"  protected override readonly defaultSort = {{ column: '{defaultSort.Column}', descending: {(defaultSort.Descending ? "true" : "false")} }}; // the project's DefaultSorts: the sort until the person sorts");
        T($"  protected override readonly badInputMessage = '{(hasName ? "Name is bad or has special characters!" : "Some of the values are not acceptable!")}';");
        if (canSearch && (!odata || Project.ListSearchProtocol)) T($"  override filters = {{ {string.Join(", ", searchFields.Select(f => f.ParamName).Concat(searchKeys.Select(k => k.ParamName)).Select(n => $"{n}: ''"))} }};");
        if (odataFilters is not null)
        {
            // the filter row: the control of each grid column (the screen's columnFilters hold what was typed), and the properties the grid reads (the key is always read)
            T("  readonly filterFields: readonly ColumnFilterField[] = [");
            var fields = odataFilters.Where(f => f is not null).Select(f => f!).ToList();
            for (int i = 0; i < fields.Count; i++)
            {
                var f = fields[i];
                string literal = f.Literal is null ? "" : $", literal: '{f.Literal}'";
                T($"    {{ name: '{f.Name}', property: '{f.Property}', kind: '{f.Kind.ToString().ToLowerInvariant()}', nullable: {(f.Nullable ? "true" : "false")}{literal} }}{(i < fields.Count - 1 ? "," : "")}");
            }
            T("  ];");
            T("  protected override readonly selectColumns = this.columns.properties; // the grid asks for the shown columns and the key (one array, kept up to date); a row is read whole when it is opened");
        }
        if (!nameActive && pageSize != 20) T($"  override pageSize = {pageSize};");
        foreach (var p in parents.Where(p => !Ahead(p)))
            T($"  {p.List}: {p.ItemType}[] = [];");
        if (form.Guards.Count > 0)
            T("  guards: Record<string, boolean> = {}; // which guarded columns the signed-in person may change (GET guards)");
        foreach (var p in parents.Where(p => !p.IsSelf))
            T($"  private readonly {AngularNames.ServiceField(p.Table)} = inject({AngularNames.ServiceClass(p.Table)});");
        string ParentService(FormParent p) => p.IsSelf ? "service" : AngularNames.ServiceField(p.Table);
        foreach (var p in parents.Where(Ahead))
            T($"  private readonly {NamesOf(p)} = new LookupNames<{p.KeyTs}>((query) => this.{ParentService(p)}.getLookup(query)); // the names of {p.BaseName} rows, asked for as the screen shows them (too many rows for a drop-down)");
        foreach (var c in formAheads)
        {
            var p = form.ParentOf(c)!;
            T($"  readonly {FormAhead(c)} = new TypeAhead<{p.KeyTs}>((query) => this.{ParentService(p)}.getLookup(query), this.{NamesOf(p)}, (id) => {{ if (this.selectedRow) {{ (this.selectedRow as unknown as Record<string, unknown>)['{JsonNames.Camel(c.Name)}'] = id; }} }});");
        }
        foreach (var k in filterAheads)
            T($"  readonly {FilterAhead(k)} = new TypeAhead<{k.Parent.KeyTs}>((query) => this.{ParentService(k.Parent)}.getLookup(query), this.{NamesOf(k.Parent)}, (id) => {{ const text = id === null ? '' : String(id); if (this.filters['{k.ParamName}'] !== text) {{ this.filters['{k.ParamName}'] = text; this.search(); }} }});");
        foreach (var f in columnAheads)
            T($"  readonly {ColumnAhead(f)} = new TypeAhead<{f.Parent!.KeyTs}>((query) => this.{ParentService(f.Parent!)}.getLookup(query), this.{NamesOf(f.Parent!)}, (id) => {{ this.columnFilters['{f.Name}'].value = id ?? undefined; }});");
        if (children.Count > 0) T("  private readonly http = inject(HttpClient);");
        if (tabbed)
        {
            T("  activeTab = 0; // the form tab showing");
            T();
            T("  // A required field on a tab that is not showing blocks the submit without a visible message: show the tab that holds the first invalid field.");
            T("  revealInvalidTab(event: Event): void {");
            T("    const panel = (event.currentTarget as HTMLButtonElement).form?.querySelector(':invalid')?.closest('[role=\"tabpanel\"]');");
            T("    if (panel) { this.activeTab = Number(panel.getAttribute('data-tab')); }");
            T("  }");
        }
        if (gridChildren.Count > 0)
        {
            T("  // The child grids hold all their rows, so each sorts them in the browser; its sort is saved under the grid's key plus the child's name.");
            T("  childSorts: Record<string, GridSort | null> = { " + string.Join(", ", gridChildren.Select(ch => $"{ch.Variable}: loadSort(this.gridKey + '.{ch.Variable}')")) + " };");
            T("  childSortMenu: { child: string; x: number; y: number } | null = null; // the child grid's right-click menu, where it is open");
            if (gridChildren.Any(ch => ch.Filters.Count > 0))
                T("  childFilters: Record<string, Record<string, string>> = { " + string.Join(", ", gridChildren.Where(ch => ch.Filters.Count > 0).Select(ch => $"{ch.Variable}: {{ {string.Join(", ", ch.Filters.Select(f => f.ColumnJson + ": ''"))} }}")) + " }; // the name picked in each child grid's filter drop-downs, by column");
        }
        foreach (var child in gridChildren)
        {
            T($"  {child.Variable}Rows: any[] = [];");
            T($"  {child.Variable}Columns: string[] = [];");
            T($"  private readonly {child.Variable}Hidden: string[] = [" + string.Join(", ", child.HiddenJson.Select(n => "'" + n + "'")) + "];");
            if (child.Lookups.Count > 0)
                T($"  {child.Variable}Names: Record<string, Record<string, string>> = {{}};");
        }
        foreach (var child in editableChildren)
        {
            // the rows of the form's own child list: plain objects the inputs edit, sent with the row (prepare below)
            T($"  {child.Variable}Rows: any[] = [];");
            if (child.EditColumns.Any(c => child.EditLookupOf(c) is not null && !child.EditTypeAhead(c)))
                T($"  {child.Variable}Options: Record<string, {{ id: any; name: string }}[]> = {{}};");
            foreach (var c in child.EditColumns.Where(child.EditTypeAhead))
            {
                // a parent with too many rows for a drop-down: each row's cell is a box that finds the parent by what is typed in it
                string cellTs = IsNumber(c) ? "number" : "string";
                string route = $"{apiPrefix}/{ScreenNames.ApiRoute(child.EditLookupOf(c)!.ReferencedTable)}";
                T($"  readonly {child.Variable}{UpperFirst(JsonNames.Camel(c.Name))}Aheads = new RowAheads<{cellTs}>('{JsonNames.Camel(c.Name)}', (query) => lookupCall<{cellTs}>(this.http, '{route}', query), new LookupNames<{cellTs}>((query) => lookupCall<{cellTs}>(this.http, '{route}', query)));");
            }
        }
        T();
        {
            var parentsToLoad = parents.Where(p => !Ahead(p)).ToList();   // a drop-down over this table itself (a manager) is read through the screen's own service; a type-ahead reads nothing until it is used
            var optionLoads = editableChildren.SelectMany(child => child.EditColumns
                .Select(c => (Child: child, Column: c, Lookup: child.EditLookupOf(c))).Where(x => x.Lookup is not null && !child.EditTypeAhead(x.Column))).ToList();
            if (parentsToLoad.Count > 0 || optionLoads.Count > 0 || form.Guards.Count > 0)
            {
                T("  protected override start(): void {");
                T("    super.start();");
                if (form.Guards.Count > 0)
                    T("    this.service.getGuards().subscribe((data) => { this.guards = data; });");
                foreach (var p in parentsToLoad)
                    T($"    this.{(p.IsSelf ? "service" : AngularNames.ServiceField(p.Table))}.{p.LoadMethod}().subscribe((data) => {{ this.{p.List} = data; }});");
                foreach (var (child, column, lookup) in optionLoads)
                    T($"    this.http.get<any[]>('{apiPrefix}/{ScreenNames.ApiRoute(lookup.ReferencedTable)}/lookup').subscribe((items) => {{ this.{child.Variable}Options = {{ ...this.{child.Variable}Options, {JsonNames.Camel(column.Name)}: items.map((i) => ({{ id: i['id'], name: String(i['name'] ?? '') }})) }}; }});");
                T("  }");
                T();
            }
        }
        if (chooseColumns)
        {
            T("  // Showing or hiding a column: the choice is kept, and a sort" + (odata ? " or a filter" : "") + " on a column that is no longer shown is dropped.");
            T("  toggleColumn(name: string): void {");
            T("    this.columns.toggle(name);");
            T("    this.columnsChanged();");
            T("  }");
            T();
            T("  resetColumns(): void {");
            T("    this.columns.reset();");
            T("    this.columnsChanged();");
            T("  }");
            T();
            T("  private columnsChanged(): void {");
            if (odata)
            {
                T("    const kept = this.sorts.filter((s) => this.columns.has(s.column));");
                T("    if (kept.length !== this.sorts.length) {");
                T("      this.sorts = kept;");
                T("      this.sort = kept[0] ?? null;");
                T("      saveSorts(this.gridKey, kept);");
                T("    }");
                T("    for (const field of this.filterFields) {");
                T("      if (!this.columns.has(field.name)) this.columnFilters[field.name] = {};");
                T("    }");
                T("    this.load(); // the page is read again with the columns that are shown");
            }
            else
            {
                T("    if (this.sort && !this.columns.has(this.sort.column)) this.clearSort();");
            }
            T("  }");
            T();
        }
        var adds = form.NewRowTypeScript;
        T($"  protected newRow(): {baseName} {{");
        T(adds.Count == 0 ? "    return { };" : $"    return {{ {string.Join(", ", adds)} }};");
        T("  }");
        var dateColumns = form.DateColumns;   // a stamp keeps the timestamp the API sent
        if (dateColumns.Count > 0)
        {
            T();
            T($"  protected override prepareEdit(copy: {baseName}): {baseName} {{");
            T("    // the date box wants yyyy-MM-dd; the API sends a full timestamp");
            foreach (var c in dateColumns)
            {
                string prop = $"copy.{JsonNames.Camel(c.Name)}";
                if (c.IsNullable) T($"    if ({prop}) {{ {prop} = {prop}.substring(0, 10); }}");
                else T($"    {prop} = {prop}.substring(0, 10);");
            }
            T("    return copy;");
            T("  }");
        }
        if (tabbed || formAheads.Count > 0)
        {
            T();
            T("  protected override opened(): void {");
            if (tabbed) T("    this.activeTab = 0;");
            foreach (var c in formAheads)
                T($"    this.{FormAhead(c)}.reset(); // show the name of the key the row has, not what was typed last");
            T("  }");
        }
        if (filterAheads.Count + columnAheads.Count > 0)
        {
            T();
            T("  override clearSearch(): void {");
            T("    super.clearSearch();");
            foreach (var k in filterAheads)
                T($"    this.{FilterAhead(k)}.reset();");
            foreach (var f in columnAheads)
                T($"    this.{ColumnAhead(f)}.reset();");
            T("  }");
        }
        if (children.Count > 0)
        {
            // a new row has no child rows yet; an opened row shows the ones that point at it
            T();
            T("  override add(): void {");
            T("    super.add();");
            foreach (var child in children)
            {
                T($"    this.{child.Variable}Rows = [];");
                if (!child.IsEditable) T($"    this.{child.Variable}Columns = [];");
            }
            T("  }");
            T();
            T($"  override edit({variable}: {baseName}): void {{");
            T($"    super.edit({variable});");
            foreach (var child in children)
                T($"    this.load{child.Name}({variable}.{keyProp}!);");
            T("  }");
        }
        foreach (var p in parents)
        {
            T();
            T($"  // the name to show in place of a {p.BaseName} id");
            T($"  {p.NameMethod}(id?: {p.KeyTs}): string {{");
            T(Ahead(p) ? $"    return this.{NamesOf(p)}.name(id);" : $"    return this.{p.List}.find((p) => p.{p.KeyJson} === id)?.{p.DisplayJson} ?? '';");
            T("  }");
        }
        foreach (var child in editableChildren)
        {
            var editColumns = child.EditColumns;
            var childDates = editColumns.Where(IsDate).ToList();
            var defaults = new List<string>();
            foreach (var c in editColumns.Where(c => !c.IsNullable))
            {
                if (child.EditLookupOf(c) is not null) defaults.Add($"{JsonNames.Camel(c.Name)}: null");
                else if (c.IsBooleanColumn) defaults.Add($"{JsonNames.Camel(c.Name)}: {(c.DatabaseDefaultSql is not null && c.DatabaseDefaultSql.Trim('(', ')', ' ') == "1" ? "true" : "false")}");
                else if (IsDate(c)) defaults.Add($"{JsonNames.Camel(c.Name)}: new Date().toISOString().substring(0, 10)");
                else if (IsNumber(c)) defaults.Add($"{JsonNames.Camel(c.Name)}: 0");
                else defaults.Add($"{JsonNames.Camel(c.Name)}: ''");
            }
            T();
            T($"  // {child.Title} are part of this form: the rows that point at the row being edited are read once, edited here and sent with the row under '{child.JsonName}'.");
            T($"  // The API makes the table match the list: a row with its key is changed, a row without one is added, a row left out is removed.");
            T($"  private load{child.Name}(parentId: {keyTs}): void {{");
            T($"    this.http.get<any[]>('{apiPrefix}/{child.ApiRoute}').subscribe({{");
            T("      next: (rows) => {");
            T($"        this.{child.Variable}Rows = rows.filter((r: any) => r['{child.ForeignKeyJson}'] === parentId).map((r: any) => ({{ ...r{string.Concat(childDates.Select(c => $", {JsonNames.Camel(c.Name)}: r['{JsonNames.Camel(c.Name)}']?.substring(0, 10) ?? null"))} }}));");
            T("      },");
            T("      error: (e) => console.error(e)");
            T("    });");
            T("  }");
            T();
            T($"  add{child.Name}(): void {{");
            T($"    this.{child.Variable}Rows = [...this.{child.Variable}Rows, {{ {string.Join(", ", defaults)} }}];");
            T("  }");
            T();
            T($"  remove{child.Name}(row: any): void {{");
            T($"    this.{child.Variable}Rows = this.{child.Variable}Rows.filter((r) => r !== row);");
            T("  }");
        }
        if (editableChildren.Count > 0)
        {
            T();
            T("  // the child lists go in the request body with the row");
            T($"  protected override prepare(row: {baseName}, isNew: boolean): void {{");
            T("    super.prepare(row, isNew);");
            foreach (var child in editableChildren)
                T($"    (row as unknown as Record<string, unknown>)['{child.JsonName}'] = this.{child.Variable}Rows;");
            T("  }");
        }
        foreach (var child in gridChildren)
        {
            T();
            T($"  // {child.Title} rows whose {child.ForeignKeyJson} matches the row being edited - the whole table is loaded and");
            T("  // filtered client-side (same no-paging simplification TS_Component.tt's own grid makes), and the columns");
            T("  // shown are whatever keys the first row actually has, since this template never sees the child's own schema.");
            T($"  private load{child.Name}(parentId: {keyTs}): void {{");
            if (child.Filters.Count > 0)
                T($"    this.childFilters['{child.Variable}'] = {{ {string.Join(", ", child.Filters.Select(f => f.ColumnJson + ": ''"))} }};");
            if (odata && child.KeyJson is not null && ODataPlan.ServesByName(child.Table, Project))
            {
                // the child is served as OData too: the server finds the rows that point at this one, instead of the whole table being read and filtered here
                string parentLiteral = keyType.Kind == KeyKind.Int ? "number" : keyType.Kind == KeyKind.Guid ? "guid" : "string";
                T($"    readOData<any>(this.http, 'odata/{child.ApiRoute}' + queryString({{ $filter: `{child.ForeignKeyJson} eq ${{odataLiteral(parentId, '{parentLiteral}')}}`, $orderby: '{child.KeyJson}' }})).subscribe({{");
                T("      next: (rows) => {");
                T($"        this.{child.Variable}Rows = rows;");
            }
            else
            {
                T($"    this.http.get<any[]>('{apiPrefix}/{child.ApiRoute}').subscribe({{");
                T("      next: (rows) => {");
                T($"        this.{child.Variable}Rows = rows.filter((r: any) => r['{child.ForeignKeyJson}'] === parentId);");
            }
            T($"        this.{child.Variable}Columns = this.{child.Variable}Rows.length > 0 ? this.orderColumns(Object.keys(this.{child.Variable}Rows[0]), this.{child.Variable}Hidden) : [];");
            foreach (var lookup in child.Lookups.Where(l => l.TypeAhead))
                T($"        namesOf((query) => lookupCall(this.http, '{apiPrefix}/{ScreenNames.ApiRoute(lookup.ParentTable)}', query), this.{child.Variable}Rows.map((r) => r['{lookup.ColumnJson}'])).subscribe((names) => {{ this.{child.Variable}Names = {{ ...this.{child.Variable}Names, {lookup.ColumnJson}: names }}; }});");
            foreach (var lookup in child.Lookups.Where(l => !l.TypeAhead))
                T($"        this.http.get<any[]>('{apiPrefix}/{lookup.WebRoute}').subscribe((items) => {{ this.{child.Variable}Names = {{ ...this.{child.Variable}Names, {lookup.ColumnJson}: Object.fromEntries(items.map((i) => [String(i['{lookup.WebKey}']), String(i['{lookup.WebDisplay}'] ?? '')])) }}; }});");
            T("      },");
            T("      error: (e) => console.error(e)");
            T("    });");
            T("  }");
            if (child.KeyJson is not null)
            {
                T();
                T($"  // Edit opens the {child.Title}'s own page on that row; saving or cancelling there comes back here with this {title} open again.");
                T($"  edit{child.Name}(row: any): void {{");
                string childKey = child.KeyIsText ? $"encodeURIComponent(row['{child.KeyJson}'])" : $"row['{child.KeyJson}']";
                string selfKey = textKey ? $"encodeURIComponent(this.selectedRow?.{keyProp} ?? '')" : $"this.selectedRow?.{keyProp}";
                T($"    this.router.navigateByUrl(`/{child.PageRoute}?edit=${{{childKey}}}&back=${{encodeURIComponent('/{selfRoute}?edit=' + {selfKey})}}`);");
                T("  }");
                T();
                T($"  delete{child.Name}(row: any): void {{");
                T("    if (!this.notifier.confirm('Are you sure you want to delete this?')) return;");
                T($"    this.http.delete(`{apiPrefix}/{child.ApiRoute}/${{{childKey}}}`).subscribe({{");
                T($"      next: () => this.load{child.Name}(this.selectedRow!.{keyProp}!),");
                T($"      error: (error) => this.notifier.error(apiMessage(error, error.status == {HttpStatus.BadRequest} ? 'It cannot be deleted because it is in use!' : 'Problem while deleting! ' + error.message))");
                T("    });");
                T("  }");
            }
        }
        if (gridChildren.Count > 0)
        {
            var allCurrency = gridChildren.SelectMany(ch => ch.MoneyColumns).GroupBy(m => m.Name).Select(g => g.First()).ToList();
            var allLongText = gridChildren.SelectMany(ch => ch.LongTextJson).Distinct().ToList();
            // A click on a header sorts by it (again: flips the direction), the right-click menu clears the sort; the sort is saved (grid-sort.ts).
            T();
            T("  sortChildBy(child: string, column: string): void {");
            T("    this.childSorts[child] = nextSort(this.childSorts[child] ?? null, column);");
            T("    saveSort(this.gridKey + '.' + child, this.childSorts[child]);");
            T("  }");
            T();
            T("  clearChildSort(child: string): void {");
            T("    this.childSorts[child] = null;");
            T("    saveSort(this.gridKey + '.' + child, null);");
            T("    this.childSortMenu = null;");
            T("  }");
            T();
            T("  openChildSortMenu(event: MouseEvent, child: string): void {");
            T("    event.preventDefault();");
            T("    this.childSortMenu = { child, x: event.clientX, y: event.clientY };");
            T("  }");
            T();
            T("  @HostListener('document:click')");
            T("  @HostListener('document:keydown.escape')");
            T("  closeChildSortMenu(): void {");
            T("    this.childSortMenu = null;");
            T("  }");
            T();
            T("  childSortMark(child: string, column: string): string {");
            T("    const sort = this.childSorts[child];");
            T("    return sort?.column === column ? (sort.descending ? ' \\u25BC' : ' \\u25B2') : '';");
            T("  }");
            T();
            T("  childAriaSort(child: string, column: string): 'ascending' | 'descending' | null {");
            T("    const sort = this.childSorts[child];");
            T("    return sort?.column === column ? (sort.descending ? 'descending' : 'ascending') : null;");
            T("  }");
            T();
            bool childFilterBoxes = gridChildren.Any(ch => ch.Filters.Count > 0);
            if (childFilterBoxes)
            {
                T("  // A child grid holds every row of the child for this row, so its filters work on those rows: the names to pick from are the ones the rows have.");
                T("  // The same list is returned until the rows or the names change, so the options are not rebuilt on every change detection.");
                T("  private readonly childChoiceCache = new WeakMap<any[], Map<string, { names?: Record<string, string>; choices: { value: string; name: string }[] }>>();");
                T();
                T("  childChoices(rows: any[], column: string, names?: Record<string, string>): { value: string; name: string }[] {");
                T("    const perRows = this.childChoiceCache.get(rows) ?? new Map<string, { names?: Record<string, string>; choices: { value: string; name: string }[] }>();");
                T("    this.childChoiceCache.set(rows, perRows);");
                T("    const cached = perRows.get(column);");
                T("    if (cached && cached.names === names) return cached.choices;");
                T("    const values = Array.from(new Set(rows.map((r) => r[column]).filter((v) => v !== null && v !== undefined && v !== '').map(String)));");
                T("    const choices = values.map((value) => ({ value, name: names?.[value] ?? value })).sort((a, b) => a.name.localeCompare(b.name));");
                T("    perRows.set(column, { names, choices });");
                T("    return choices;");
                T("  }");
                T();
            }
            T("  // The rows in the child grid's sort order; a column that shows a name instead of an id sorts by the name.");
            T("  sortedChildRows(child: string, rows: any[], names?: Record<string, Record<string, string>>): any[] {");
            T("    const sort = this.childSorts[child] ?? null;");
            if (childFilterBoxes)
            {
                T("    const filter = Object.entries(this.childFilters[child] ?? {});");
                T("    const shown = rows.filter((r) => filter.every(([column, value]) => !value || String(r[column] ?? '') === value));");
                T("    return sortRows(shown, sort, sort ? names?.[sort.column] : undefined);");
            }
            else
                T("    return sortRows(rows, sort, sort ? names?.[sort.column] : undefined);");
            T("  }");
            T();
            T("  // Child grids show whatever keys the API returns; these members caption them, leave out long text, limit them to 20 and format money and dates.");
            T("  private readonly childCurrencyDigits: Record<string, number> = { " + string.Join(", ", allCurrency.Select(m => m.Name + ": " + m.Digits)) + " };");
            var allCaptions = gridChildren.SelectMany(ch => ch.Captions).GroupBy(m => m.Name).Select(g => g.First()).ToList();
            T("  private readonly childCaptions: Record<string, string> = { " + string.Join(", ", allCaptions.Select(m => m.Name + ": '" + m.Caption.Replace("'", "\'") + "'")) + " };");
            T("  private readonly childLongTextColumns: string[] = [" + string.Join(", ", allLongText.Select(n => "'" + n + "'")) + "];");
            T();
            T("  orderColumns(keys: string[], hidden: string[]): string[] {");
            T("    // Only the child table's own columns: the API also sends each navigation property (customer, customerMonthlySummary, ...), which is not a column.");
            T($"    return keys.filter((k) => k in this.childCaptions && !hidden.includes(k) && !this.childLongTextColumns.includes(k)).slice(0, {GridColumns.MaxColumns});");
            T("  }");
            T();
            T("  caption(key: string): string {");
            T("    if (key in this.childCaptions) return this.childCaptions[key];");
            T("    const spaced = key.replace(/Id$/, '').replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/([A-Z])([A-Z][a-z])/g, '$1 $2');");
            T("    return spaced.split(' ').filter(Boolean).map((w) => {");
            T("      const l = w.toLowerCase();");
            T("      return l === 'number' || l === 'num' ? '#' : l === 'percentage' || l === 'percent' || l === 'pct' ? '%' : w.charAt(0).toUpperCase() + w.slice(1);");
            T("    }).join(' ');");
            T("  }");
            T();
            T("  cell(value: unknown, key: string, names?: Record<string, string>): string {");
            T("    if (value === null || value === undefined) return '';");
            T("    if (names) return names[String(value)] ?? String(value);");
            T("    if (typeof value === 'boolean') return value ? 'Yes' : 'No';");
            T("    if (typeof value === 'number' && key in this.childCurrencyDigits) {");
            T("      const d = this.childCurrencyDigits[key];");
            T("      return value.toLocaleString(undefined, { style: 'currency', currency: '" + Project.CurrencyCode + "', minimumFractionDigits: d, maximumFractionDigits: d });");
            T("    }");
            T("    // A date-and-time string from the API (2026-09-27T00:00:00) shows as its date only.");
            T("    return typeof value === 'string' ? value.replace(/^(\\d{4}-\\d{2}-\\d{2})T.*$/, '$1') : String(value);");
            T("  }");
        }
        T("}");

        var o = new StringBuilder();
        o.Append($"@@@FILE {componentsFolder}/{screenStem}/{screenStem}.component.css@@@\n").Append(GridSortStyles.Css).Append(chooseColumns ? ColumnPickerStyles.Css : "").Append(odata && !nameActive ? ODataGridStyles.Css : "");
        if (editableChildren.Count > 0)
            o.Append("\n.child-edit { margin: 1rem 0; border: 1px solid #ccc; }\n.child-edit table { width: 100%; }\n.child-edit td { padding: 2px 4px; }\n.child-edit input[type=text], .child-edit input[type=number], .child-edit input[type=date], .child-edit select { width: 100%; box-sizing: border-box; }\n");
            if (editableChildren.Any(ch => EditableChild.UsesCards(ch.Link)))
                o.Append(".child-card { border: 1px solid #8886; border-radius: 6px; padding: 4px 12px 12px; margin-bottom: 12px; }\n.child-card-head { display: flex; justify-content: space-between; align-items: center; }\n.child-card-fields { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 0 12px; }\n.child-field { display: flex; flex-direction: column; }\n.child-field-wide { grid-column: 1 / -1; }\n");
        o.Append($"@@@FILE {componentsFolder}/{screenStem}/{screenStem}.component.html@@@\n").Append(Project.AdaptAngularHtml(html.ToString()));
        o.Append($"@@@FILE {componentsFolder}/{screenStem}/{screenStem}.component.spec.ts@@@\n").Append(Project.AdaptAngularSpec(spec.ToString()));
        o.Append($"@@@FILE {componentsFolder}/{screenStem}/{screenStem}.component.ts@@@\n").Append(ts);
        Write(o.ToString());
    }
#>
