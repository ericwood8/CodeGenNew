# Restriction checkboxes for TSX_Api_v1.tt (see Docs/Reference.md section 3).
# The routes are keyed by the primary key (api/<table>s/{id}), taken as {id:int} or {id:guid}.
RequiresPrimaryKey=true
TableOnly=true
RequiredPrimaryKeyShape=SingleIntOrGuid
# A name/active table's real API is always hand-maintained and commonly has no plain getAll() at all
# (confirmed against a real one).
RequiresNotNameActiveTable=true
# No OutputName: the template writes its own path (api/<table>Api.ts) with an @@@FILE marker.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=React
PlanTables=Entity
OutputFolder=src
