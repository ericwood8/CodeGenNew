<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PY_TestParties_v1.tt
    // Generates: tests/conftest.py and tests/test_parties.py   (whole-database; the output folder is the Python API's folder)
    // pytest tests of what PY_Routes writes for PartyTables. conftest.py is the one PY_TestApprovals writes (the application over a scratch database: a temporary copy of the SQLite file, or the URL
    // in <PROJECT>_TEST_CONNECTION for PostgreSQL and MySQL; with none the tests are skipped with the reason). test_parties.py adds two parties and their identifiers through the routes, removes them after
    // the test, and plays the cases: a scheme and value pair another row holds is refused on create and on update (trimmed, without regard to case), and a party is found by an identifier.
    // The words are PartyWords, as in the other stacks' tests.
    // Written only for a project with PythonTests=true and a party table the tests can fill (PartyTestPlan); not for SQL Server.
    // Run them with pytest from the API's folder (requirements.txt lists pytest and httpx with PythonTests=true).
    // Full notes: Docs/TemplateNotes/API_RowShapes_v1.md
    // ==========================================================================================
    if (PythonPartyTests.Applies(Database, Project))
    {
        Write("@@@FILE tests/conftest.py@@@\n" + PythonPartyTests.Conftest(Project, Database.Dialect));
        Write("@@@FILE tests/test_parties.py@@@\n" + PythonPartyTests.File(Database, Project));
    }
#>
