<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // WinUI3_EssentialMainWindow_v1.tt
    // Generates: MainWindow.xaml and MainWindow.xaml.cs   (no table, no database: an essentials group)
    // The main window: a NavigationView (its hamburger button opens and closes the menu) with a content area, the shared database context, and the selection handler.
    // The menu entries, FirstScreen and ShowPage come from MainWindow.Screens.cs, the other half of this partial class (WinUI3_Screens writes it from the project's Screens setting).
    // Needs the project settings AppNamespace, ViewNamespace and ContextName (defaults derive from ProjectName).
    // ==========================================================================================
    string appNamespace = Project.AppNamespace;
    string viewNamespace = Project.ViewNamespace ?? appNamespace + ".Views";
    string contextType = Project.ContextName ?? "AppContext";
#>
@@@FILE MainWindow.xaml@@@
<Window
    x:Class="<#= appNamespace #>.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <NavigationView x:Name="NavView" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                    SelectionChanged="NavView_SelectionChanged">
        <!-- The menu entries are added by AddScreens() in MainWindow.Screens.cs (generated by WinUI3_Screens). -->
        <ContentControl x:Name="MainContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </NavigationView>
</Window>
@@@FILE MainWindow.xaml.cs@@@
using <#= viewNamespace #>;
using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;

namespace <#= appNamespace #>;

public sealed partial class MainWindow : Window
{
    private readonly <#= contextType #> _context = new();

    public MainWindow()
    {
        InitializeComponent();
        AddScreens();
        NavView.SelectedItem = NavView.MenuItems[0];
        ShowPage(FirstScreen);
    }

    private void NavView_SelectionChanged(NavigationView sender, NavigationViewSelectionChangedEventArgs args)
    {
        if (args.SelectedItem is NavigationViewItem { Tag: string tag })
            ShowPage(tag);
    }
}
