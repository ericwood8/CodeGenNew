<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // WinUI3_EssentialMainWindow_v1.tt
    // Generates: MainWindow.xaml and MainWindow.xaml.cs   (no table, no database: an essentials group)
    // The main window: a NavigationView (its hamburger button opens and closes the menu) with a content area, the shared database context, and the selection handler.
    // The menu entries, FirstScreen and ShowPage come from MainWindow.Screens.cs, the other half of this partial class (WinUI3_Screens writes it from the project's Screens setting).
    // With Auth=true, a UserTable and ApiAuth (WinUI3_Auth writes DesktopSignIn and LoginView) the window shows the sign-in first, then the menu, the person's name and Sign out in the pane footer; with
    // TenantTable the context gets the tenant scope the person signed in to, and with TenantMembership the footer shows the tenant (a drop-down for a person in several; a switch makes the screens again).
    // Needs the project settings AppNamespace, ViewNamespace and ContextName (defaults derive from ProjectName).
    // ==========================================================================================
    string appNamespace = Project.AppNamespace;
    string viewNamespace = Project.ViewNamespace ?? appNamespace + ".Views";
    string contextType = Project.ContextName ?? "AppContext";
    bool signIn = TenantPlan.HasDesktopSignIn(Project);
    bool tenants = TenantPlan.HasDesktopTenants(Project);
    bool switcher = TenantPlan.HasDesktopSwitcher(Project);
    bool caller = TenantPlan.DesktopSetsCaller(Project);
    bool roles = TenantPlan.HasDesktopRoles(Project);
    bool session = TenantPlan.HasDesktopSignIn(Project);
#>
@@@FILE MainWindow.xaml@@@
<Window
    x:Class="<#= appNamespace #>.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<# if (signIn) { #>
    <Grid>
        <NavigationView x:Name="NavView" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" Visibility="Collapsed"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.PaneFooter>
                <StackPanel Margin="12" Spacing="8">
                    <TextBlock x:Name="UserText" TextWrapping="Wrap" />
<# if (switcher) { #>
                    <TextBlock x:Name="TenantName" Visibility="Collapsed" TextWrapping="Wrap" />
                    <ComboBox x:Name="TenantList" AutomationProperties.Name="<#= TenantWords.SignInLabel #>" DisplayMemberPath="Text" HorizontalAlignment="Stretch" Visibility="Collapsed"
                              SelectionChanged="OnTenantChosen" />
<# } #>
                    <Button x:Name="SignOutButton" Content="Sign out" Click="OnSignOutClick" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <!-- The menu entries are added by AddScreens() in MainWindow.Screens.cs (generated by WinUI3_Screens) once someone has signed in. -->
            <ContentControl x:Name="MainContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </NavigationView>
        <ContentControl x:Name="SignInHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
<# } else { #>
    <NavigationView x:Name="NavView" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                    SelectionChanged="NavView_SelectionChanged">
        <!-- The menu entries are added by AddScreens() in MainWindow.Screens.cs (generated by WinUI3_Screens). -->
        <ContentControl x:Name="MainContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </NavigationView>
<# } #>
</Window>
@@@FILE MainWindow.xaml.cs@@@
using <#= viewNamespace #>;
using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;

namespace <#= appNamespace #>;

public sealed partial class MainWindow : Window
{
<# if (!signIn) { #>
    private readonly <#= contextType #> _context = new();

    public MainWindow()
    {
        InitializeComponent();
        AddScreens();
        NavView.SelectedItem = NavView.MenuItems[0];
        ShowPage(FirstScreen);
    }
<# } else { #>
    private <#= contextType #> _context = new();
    private SignedInUser? _user;
<# if (switcher) { #>
    private bool _showingTenants;
<# } #>

    public MainWindow()
    {
        InitializeComponent();
        ShowSignIn();
    }

    private void ShowSignIn()
    {
        NavView.Visibility = Visibility.Collapsed;
        NavView.MenuItems.Clear();
        MainContent.Content = null;
        SignInHost.Content = new LoginView(OnSignedIn);
        SignInHost.Visibility = Visibility.Visible;
    }

    private void OnSignedIn(SignedInUser user)
    {
        _user = user;
<# if (caller) { #>
        DesktopCaller.Name = user.Name;
<# } #>
        UseContext();
        SignInHost.Content = null;
        SignInHost.Visibility = Visibility.Collapsed;
        UserText.Text = user.Name;
        NavView.Visibility = Visibility.Visible;
<# if (session) { #>
        DesktopSession.User = user;
<# } #>
        AddScreens();
        ShowFirstScreen();
<# if (switcher) { #>
        _ = ShowTenantsAsync();
<# } #>
    }

    // The pages hold the context they were made with, so a new person or a new tenant gets a new context and new pages. Every context reads the app's one tenant scope.
    private void UseContext()
    {
<# if (tenants) { #>
        DesktopTenantScope.Current.Use(_user?.TenantId, _user?.IsPlatform ?? false, _user?.Name);
<# } #>
        _context = new <#= contextType #>();
    }

    // The first screen the person's role may read; a role that may read none sees an empty window.
    private void ShowFirstScreen()
    {
        MainContent.Content = null;
        if (NavView.MenuItems.Count == 0)
            return;
        NavView.SelectedItem = NavView.MenuItems[0];
        ShowPage(FirstScreen);
    }

    private void OnSignOutClick(object sender, RoutedEventArgs e)
    {
        _user = null;
<# if (session) { #>
        DesktopSession.User = null;
<# } #>
<# if (caller) { #>
        DesktopCaller.Name = Environment.UserName;
<# } #>
        UseContext();
        ShowSignIn();
    }
<# if (switcher) { #>

    // The tenant the person works in: a name when they belong to one, a drop-down when they belong to several.
    private async Task ShowTenantsAsync()
    {
        using var context = new <#= contextType #>();
        var choices = await DesktopSignIn.TenantsAsync(context, _user!.Name);
        _showingTenants = true;
        try
        {
            TenantName.Text = choices.Count == 1 ? choices[0].Text : "";
            TenantName.Visibility = choices.Count == 1 ? Visibility.Visible : Visibility.Collapsed;
            TenantList.ItemsSource = choices;
            TenantList.SelectedItem = choices.FirstOrDefault(c => c.Id == _user.TenantId);
            TenantList.Visibility = choices.Count > 1 ? Visibility.Visible : Visibility.Collapsed;
        }
        finally
        {
            _showingTenants = false;
        }
    }

    private async void OnTenantChosen(object sender, SelectionChangedEventArgs e)
    {
        if (_showingTenants || _user is null || TenantList.SelectedItem is not TenantChoice choice || choice.Id == _user.TenantId)
            return;
        using var context = new <#= contextType #>();
        if (await DesktopSignIn.SwitchAsync(context, _user, choice.Id) is not { } switched)
            return;
        _user = switched;
<# if (session) { #>
        DesktopSession.User = switched;
<# } #>
        UseContext();
<# if (roles) { #>
        AddScreens();
<# } #>
        ShowFirstScreen();
    }
<# } #>
<# } #>

    private void NavView_SelectionChanged(NavigationView sender, NavigationViewSelectionChangedEventArgs args)
    {
        if (args.SelectedItem is NavigationViewItem { Tag: string tag })
            ShowPage(tag);
    }
}
