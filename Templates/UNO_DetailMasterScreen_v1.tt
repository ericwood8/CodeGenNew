    private const string GridKey = "<#= table #>";
    private static string GridKeyFor(string child) => GridKey + "." + child;
    private static string SortMark(string column, string? sortColumn, bool descending) => column == sortColumn ? (descending ? " ▼" : " ▲") : "";

    // Compares what two cells sort by as what they are: numbers as numbers, dates as dates, text without regard to case, nothing first.
    private sealed class SortValueComparer : IComparer<object?>
    {
        public static readonly SortValueComparer Instance = new();

        public int Compare(object? a, object? b)
        {
            if (a is null) return b is null ? 0 : -1;
            if (b is null) return 1;
            if (a is string sa && b is string sb) return StringComparer.CurrentCultureIgnoreCase.Compare(sa, sb);
            if (a is IComparable ca && a.GetType() == b.GetType()) return ca.CompareTo(b);
            return StringComparer.CurrentCultureIgnoreCase.Compare(a.ToString(), b.ToString());
        }
    }

    // Spaces an EF property name like the list screens' captions: "CustomerPO" -> "Customer PO", no trailing "Id" or leading "SY_",
    // "Number" written # and "Percent" %.
    private static string SpacedHeader(string name)
    {
        string spaced = Regex.Replace(Regex.Replace(Regex.Replace(name, "^SY_", ""), "Id$", "").Replace('_', ' '),
            "(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])", " ").Trim();
        return string.Join(' ', spaced.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(word => word.ToLowerInvariant() switch
        {
            "number" or "num" => "#",
            "percentage" or "percent" or "pct" => "%",
            _ => word
        }));
    }

