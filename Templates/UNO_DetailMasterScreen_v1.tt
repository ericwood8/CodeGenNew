    private async Task Load<#= child.Member #>Async()
    {
        <#= child.Var #>ColumnHeaders.Clear();
        <#= child.Var #>Rows.Clear();
        _<#= child.Var #>Loaded.Clear();
        if (_editing is null)
            return; // no child rows to show until this <#= title #> has been saved once

<#
        foreach (var r in child.Resolvable)
        {
#>
<#
            if (r.TypeAhead)
            {
#>
        var <#= r.LookupVar #> = new Dictionary<<#= r.KeyCs #>, string>();
<#
            }
            else
            {
#>
        var <#= r.LookupVar #> = (await _api.<#= UnoNames.ClientProperty(r.ReferencedTable) #>.<#= r.Lookup ? "GetLookupAsync" : "GetAllAsync" #>()).ToDictionary(r => r.<#= r.Lookup ? "Id" : r.KeyProp #>, r => r.<#= r.Lookup ? "Name" : r.DisplayProp #>?.ToString() ?? "");
<#
            }
#>
<#
        }
#>
        // <#= child.FkColumn #> (the filter column, one value here) and ids with no display name are left out.
        var propertyNames = typeof(<#= child.Type #>).GetProperties().Select(p => p.Name)
            .Where(name => !HideFrom<#= child.Member #>Grid.Contains(name, StringComparer.OrdinalIgnoreCase))
            .Where(name => !LongTextIn<#= child.Member #>Grid.Contains(name, StringComparer.OrdinalIgnoreCase)) // long text never shows in a grid
            .Take(<#= Project.MaxGridColumns #>).ToList();
        _<#= child.Var #>Columns = propertyNames;
        _<#= child.Var #>Captions = propertyNames.Select(name => HeaderLabelFor<#= child.Member #>Grid.TryGetValue(name, out string? label) ? label : SpacedHeader(name)).ToList();
        // The saved sort, if its column is still in the grid.
        var savedSort = GridSortStore.Load(GridKeyFor("<#= child.Var #>"), propertyNames);
        _<#= child.Var #>SortColumn = savedSort?.Column;
        _<#= child.Var #>SortDescending = savedSort?.Descending ?? false;

        // The whole child table is read and filtered here by this row's key.
        var rows = (await _api.<#= UnoNames.ClientProperty(child.Table) #>.GetAllAsync())
            .Where(c => c.<#= child.FkColumn #> == _editing!.<#= child.ParentKeyColumn #>)
            .ToList();
<#
        foreach (var r in child.Resolvable.Where(r => r.TypeAhead))
        {
#>
        var wanted<#= r.Column #> = rows.Select(row => typeof(<#= child.Type #>).GetProperty("<#= r.Column #>")!.GetValue(row)).OfType<<#= r.KeyCs #>>().Distinct().ToList();
        if (wanted<#= r.Column #>.Count > 0)
            <#= r.LookupVar #> = (await _api.<#= UnoNames.ClientProperty(r.ReferencedTable) #>.GetLookupAsync(ids: wanted<#= r.Column #>)).ToDictionary(p => p.Id, p => p.Name);
<#
        }
#>
        foreach (var row in rows)
        {
            // What each cell sorts by: its value, or the name a column shows in place of an id.
            var values = propertyNames.Select<string, object?>(name =>
            {
                object? raw = typeof(<#= child.Type #>).GetProperty(name)!.GetValue(row);
<#
        if (child.Resolvable.Count > 0)
        {
#>
<#
            foreach (var r in child.Resolvable)
            {
#>
                if (name == "<#= r.Column #>" && raw is <#= r.KeyCs #> rawId<#= r.Column #>)
                    return <#= r.LookupVar #>.TryGetValue(rawId<#= r.Column #>, out string? resolved<#= r.Column #>) ? resolved<#= r.Column #> : rawId<#= r.Column #>.ToString();
<#
            }
#>
<#
        }
#>
                return raw;
            }).ToList();
            var cells = values.Select((value, i) =>
            {
                // Money shows in the project's CurrencyCode with the column's own decimals, as on the list screens.
                if (value is decimal moneyValue && CurrencyDigitsFor<#= child.Member #>Grid.TryGetValue(propertyNames[i], out int moneyDigits)) return new Windows.Globalization.NumberFormatting.CurrencyFormatter("<#= Project.CurrencyCode #>") { IsGrouped = true, FractionDigits = moneyDigits }.FormatDouble((double)moneyValue);
                // A date-and-time shows as its date only.
                if (value is DateTime dateValue) return dateValue.ToString("MM/dd/yyyy");
                if (value is DateTimeOffset dateOffsetValue) return dateOffsetValue.ToString("MM/dd/yyyy");
                return value?.ToString() ?? "";
            }).ToList();
            _<#= child.Var #>Loaded.Add(new <#= table #>ChildGridRow { Cells = cells, Values = values, Entity = row });
        }
<#
        foreach (var f in child.Filters)
        {
#>
        <#= TemplateHelpers.UpperFirst(f.Choices) #>.Clear();
        int <#= f.Choices #>At = propertyNames.IndexOf("<#= f.Column #>");
        if (<#= f.Choices #>At >= 0)
        {
            <#= TemplateHelpers.UpperFirst(f.Choices) #>.Add("<#= f.All #>");
            foreach (string choiceName in _<#= child.Var #>Loaded.Select(r => r.Cells[<#= f.Choices #>At]).Where(n => n.Length > 0).Distinct().OrderBy(n => n, StringComparer.CurrentCultureIgnoreCase))
                <#= TemplateHelpers.UpperFirst(f.Choices) #>.Add(choiceName);
        }
        <#= f.Prop #> = <#= f.Choices #>At >= 0 ? "<#= f.All #>" : null;
<#
        }
#>
        Show<#= child.Member #>Sorted();
    }

    private static readonly string[] HideFrom<#= child.Member #>Grid = [ <#= string.Join(", ", child.HideColumns.Select(c => $"\"{c}\"")) #> ];
