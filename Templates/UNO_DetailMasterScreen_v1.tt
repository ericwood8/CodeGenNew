    /// <summary> A click on a column header: another column sorts ascending, the sorted column flips its direction. </summary>
    public void Sort<#= child.Member #>By(string column)
    {
        _<#= child.Var #>SortDescending = _<#= child.Var #>SortColumn == column && !_<#= child.Var #>SortDescending;
        _<#= child.Var #>SortColumn = column;
        GridSortStore.Save(GridKeyFor("<#= child.Var #>"), new GridSortEntry(column, _<#= child.Var #>SortDescending));
