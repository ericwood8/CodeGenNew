<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // folders, lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string viewNamespace = "MyApp.Views";
    string viewModelNamespace = "MyApp.ViewModels";
    string modelsNamespace = "MyApp.Models";      // the model classes (UNO_Model)
    string servicesNamespace = "MyApp.Services";  // the API clients and ApiClients (UNO_Client, UNO_Screens)
    string[] usings = { };
    string viewsFolder = "Views";
    string viewModelsFolder = "ViewModels";
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    viewNamespace = Project.ViewNamespace ?? viewNamespace;
    viewModelNamespace = Project.ViewModelNamespace ?? viewModelNamespace;
    if (Project.ViewNamespace is not null || Project.ProjectName is not null)
    {
        modelsNamespace = UnoNames.ModelsNamespace(Project);
        servicesNamespace = UnoNames.ServicesNamespace(Project);
    }
    usings = Project.Usings ?? usings;
    viewsFolder = Project.ViewsFolder ?? viewsFolder;
    viewModelsFolder = Project.ViewModelsFolder ?? viewModelsFolder;
    // ==========================================================================================

    // ==========================================================================================
    // UNO_DetailMasterScreen_v1.tt
    // Generates: Views/<Table>DetailMasterDialog.xaml and .xaml.cs, ViewModels/<Table>DetailMasterViewModel.cs, Views/PaginationBar and CurrencyNumberFormatter
    // The Uno Platform twin of WinUI3_DetailMasterScreen: UNO_DetailScreen's form (same field, drop-down and validation rules) plus one sortable grid per child table, so editing
    // a row also shows the rows that hang off it; clicking one opens its own dialog. The rows come from the child's API client (the whole child table, filtered here by this row's
    // key) and the column list from the model class. Needs a table with at least one child foreign key.
    // Full notes: Docs/TemplateNotes/UNO_DetailMasterScreen_v1.md
    // ==========================================================================================

    // Number columns are edited in a number box whose value is a double (NaN = blank), converted back on save:
    // a whole number is checked to be whole and in range; a currency column (money, or a decimal whose name says money) is formatted as currency in
    // code-behind (CurrencyNumberFormatter.cs, written alongside, since XAML cannot declare a NumberFormatter) and rounded to the column's scale;
    // any other decimal, float or real is limited to NumericClassifier.DecimalRange.

    var form = FormModel.For(Model, Project);   // what the screen is made of, decided in Core for every stack
    var keyColumn = form.KeyColumn;
    bool isNameActive = form.IsNameActive;

    var keyType = form.KeyType;   // how the key travels: a text key is typed by the person on a new row and read-only afterwards
    if (UnoNames.Refusal(Model, Project) is { } reason)
    {
        Error($"UNO_DetailMasterScreen writes no dialog for [{Model.SchemaName}].[{Model.TableName}]: {reason}");
    }
    else if (keyColumn is null || keyType is null)
    {
        Error($"UNO_DetailMasterScreen needs a table with a single int, uniqueidentifier or text primary key, but [{Model.SchemaName}].[{Model.TableName}] is not one.");
    }
    else if (!Model.HasAtLeastOneChildForeignKey)
    {
        Error($"UNO_DetailMasterScreen needs at least one other table with a foreign key pointing back at [{Model.SchemaName}].[{Model.TableName}]; none was found - use UNO_DetailScreen instead.");
    }
    else
    {
        string table = Model.TableName;
        string type = BlazorNames.TypeName(table);   // the model class (UNO_Model): the table without an E_ or SY_ prefix
        string title = form.Title;
        string keyProp = keyColumn.Name;
        bool textKey = form.TypedKey;

        var shown = form.Columns;

        // A form with more than one kind of field is tabbed (see FormPages); a narrow table stays one column.
        var pages = form.Pages.Select(p => (Header: p.Header.Replace("&", "&amp;"), Columns: p.Columns)).ToList();
        bool tabbed = pages.Count > 1;

        var parents = form.Parents;
        // a parent with too many rows for a drop-down is found by typing: an AutoSuggestBox that asks the context for the rows whose text contains what was typed
        var aheadParents = parents.Where(p => p.TypeAhead).ToList();
        var aheadColumns = shown.Where(c => form.KindOf(c) == FieldKind.Lookup && form.ParentOf(c) is { TypeAhead: true }).ToList();

        if (!Model.HasReferencedDisplayColumns && parents.Count > 0)
            Error("UNO_DetailMasterScreen needs the foreign-keyed tables' display columns for its drop-downs; its .tt.config must say NeedsReferencedDisplayColumns=true.");

        // The child tables, decided in Core for every stack (ChildGrid): which ones get a grid, its heading and role, its key, and the foreign keys shown as names.
        // A raw id with no display name (the child's own key, or a foreign key to a table without one) is hidden; a foreign key with one shows that name.
        var children = DesktopChild.For(Model, Project, needsOwnKey: true);
#>
@@@FILE <#= viewsFolder #>/<#= table #>DetailMasterDialog.xaml@@@
<ContentDialog
    x:Class="<#= viewNamespace #>.<#= table #>DetailMasterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <!-- A ContentDialog's width is capped by these two theme resources, not by its own MinWidth/MaxWidth. Raising the cap
         lets the ScrollViewer's MinWidth below decide the width, up to the window. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">320</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1400</x:Double>
        <!-- every button's caption is bold -->
        <Style x:Key="BoldDialogButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="BoldAccentDialogButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
<#= form.Columns.Any(form.IsMarked) ? RequiredMark.XamlHeaderTemplate : "" #>    </ContentDialog.Resources>
    <!-- Applied here, not as attributes on the root: those are read before the Resources element, so the StaticResource is not found and the dialog fails to open. -->
    <ContentDialog.PrimaryButtonStyle>
        <StaticResource ResourceKey="BoldAccentDialogButton" />
    </ContentDialog.PrimaryButtonStyle>
    <ContentDialog.CloseButtonStyle>
        <StaticResource ResourceKey="BoldDialogButton" />
    </ContentDialog.CloseButtonStyle>

    <!-- The error bar is above the scrolling area so a validation message is never scrolled out of sight. -->
    <StackPanel Spacing="12">
        <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />
    <ScrollViewer MinWidth="560" MaxHeight="620" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
        <!-- The bottom padding stops the last child-grid row being cut off at the end of the scroll. -->
        <StackPanel Spacing="12" Padding="0,0,0,24">
<#
        if (tabbed)
        {
#>
            <TabView IsAddTabButtonVisible="False" TabWidthMode="SizeToContent" CanReorderTabs="False" CanDragTabs="False" SelectedIndex="0">
<#
        }
        foreach (var page in pages)
        {
            if (tabbed)
            {
#>
                <TabViewItem Header="<#= page.Header #>" IsClosable="False">
                    <StackPanel Spacing="12" Padding="0,8,0,8">
<#
            }
        foreach (var c in page.Columns)
            Write(DesktopFormXaml.Field(form, Project, Model, c, textKey, withGuards: true));
            if (tabbed)
            {
#>
                    </StackPanel>
                </TabViewItem>
<#
            }
        }
        if (tabbed)
        {
#>
            </TabView>
<#
        }
#>

            <TextBlock Text="Save this <#= title #> first to add or see child rows below." FontStyle="Italic"
                       Visibility="{x:Bind ViewModel.IsAddModeVisibility}" />
<#
        foreach (var child in children)
        {
#>

            <TextBlock Text="<#= child.Title #>" Style="{ThemeResource BodyStrongTextBlockStyle}" />
<#
            if (child.Filters.Count > 0)
            {
#>
            <StackPanel Orientation="Horizontal" Spacing="8">
<#
                foreach (var f in child.Filters)
                {
#>
                <ComboBox AutomationProperties.Name="Filter <#= child.Title #> by <#= f.Label #>" MinWidth="180" ItemsSource="{x:Bind ViewModel.<#= TemplateHelpers.UpperFirst(f.Choices) #>}"
                          SelectedItem="{x:Bind ViewModel.<#= f.Prop #>, Mode=TwoWay}" />
<#
                }
#>
            </StackPanel>
<#
            }
#>
            <!-- Boxed like the master screen's grid. A click on a row opens its own dialog (On<#= child.Member #>ItemClick); a click on a header sorts
                 (again: flips the direction); a right-click on the grid offers Clear sort. -->
            <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="1" CornerRadius="4"
                    Background="Transparent" RightTapped="On<#= child.Member #>GridRightTapped">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="0,0,0,1" Padding="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.<#= child.Var #>ColumnHeaders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Text}" Tag="{Binding Column}" Click="On<#= child.Member #>HeaderClick" Width="120" Padding="0"
                                                Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Actions" FontWeight="SemiBold" Width="120" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.<#= child.Var #>Rows}"
                              <#= child.HasDialog ? "IsItemClickEnabled=\"True\" ItemClick=\"On" + child.Member + "ItemClick\" " : "" #>MaxHeight="200" Padding="0">
                        <!-- Row containers have a 40 pixel minimum height, so shorter rows made the grid too short and cut off its last row. -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource ControlStrokeColorSecondaryBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <!-- x:Bind, not {Binding}: a Binding to an empty string falls back to the row object and prints its type name. -->
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{x:Bind}" Width="120" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Delete asks to be clicked twice: a second ContentDialog cannot open over this one. -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" Width="120">
<#
            if (child.HasDialog)
            {
#>
                                        <Button Content="Edit" FontWeight="Bold" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="8,2" Click="On<#= child.Member #>EditClick" />
<#
            }
#>
                                        <Button Content="Delete" FontWeight="Bold" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="8,2" Click="On<#= child.Member #>DeleteClick" LostFocus="On<#= child.Member #>DeleteLostFocus" />
                                    </StackPanel>
                                  </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
<#
        }
#>
        </StackPanel>
    </ScrollViewer>
    </StackPanel>
</ContentDialog>
@@@FILE <#= viewsFolder #>/<#= table #>DetailMasterDialog.xaml.cs@@@
using <#= viewModelNamespace #>;
using <#= modelsNamespace #>;
using <#= servicesNamespace #>;
using Microsoft.UI.Xaml.Controls;
<#
        var currencyColumns = shown.Where(c => form.ValueOf(c) == ValueKind.Money).ToList();
        foreach (string u in usings)
        {
#>
using <#= u #>;
<#
        }
#>

namespace <#= viewNamespace #>;

public sealed partial class <#= table #>DetailMasterDialog : ContentDialog
{
    private readonly ApiClients _api; // for the child dialogs a clicked row opens, and the delete of a child row
    public <#= table #>DetailMasterViewModel ViewModel { get; }
    private System.Threading.Tasks.Task _loading = System.Threading.Tasks.Task.CompletedTask;
    private System.Threading.Tasks.TaskCompletionSource? _drillDown; // set while a child dialog opened from this one is showing

    /// <param name="editing"> The row being edited, or null to add a new one (child grids only load for an existing row). </param>
    public <#= table #>DetailMasterDialog(ApiClients api, <#= type #>? editing = null)
    {
        _api = api;
        ViewModel = new <#= table #>DetailMasterViewModel(api, editing);
        InitializeComponent();
<#
        foreach (var c in currencyColumns)
        {
#>
        <#= c.Name #>Box.NumberFormatter = new CurrencyNumberFormatter("<#= Project.CurrencyCode #>", <#= NumericClassifier.CurrencyDigits(c) #>);
<#
        }
#>
<#
        foreach (var c in shown.Where(c => form.ValueOf(c) == ValueKind.Decimal && c.SqlType == SqlDbType.Decimal))
        {
#>
        <#= c.Name #>Box.NumberFormatter = new Windows.Globalization.NumberFormatting.DecimalFormatter
        {
            IntegerDigits = 1, FractionDigits = <#= NumericClassifier.DecimalPlaces(c) #>, IsGrouped = false,
            NumberRounder = new Windows.Globalization.NumberFormatting.IncrementNumberRounder { Increment = <#= Inv(Math.Pow(10, -NumericClassifier.DecimalPlaces(c))) #>, RoundingAlgorithm = Windows.Globalization.NumberFormatting.RoundingAlgorithm.RoundHalfUp }
        };
<#
        }
#>
        Loaded += (_, _) => _loading = ViewModel.LoadAsync();
    }

    // ShowAsync() returns when the dialog closes or hides to open a child's dialog, possibly before LoadAsync() finishes or while the child is still showing.
    // A caller about to reload the list or open another dialog calls this instead: it also waits for that load and for any child dialog opened from here.
    public async System.Threading.Tasks.Task<ContentDialogResult> ShowAndWaitAsync()
    {
        var result = await ShowAsync();
        await _loading;
        if (_drillDown is not null)
            await _drillDown.Task;
        return result;
    }

<#
        foreach (var c in aheadColumns)
        {
            var p = form.ParentOf(c)!;
#>
    // Typing in the <#= Labels.Column(c.Name) #> box clears the choice and lists the rows containing the text; picking one chooses it.
    private async void On<#= c.Name #>TextChanged(AutoSuggestBox sender, AutoSuggestBoxTextChangedEventArgs args)
    {
        if (args.Reason != AutoSuggestionBoxTextChangeReason.UserInput)
            return;
        ViewModel.<#= c.Name #> = null;
        sender.ItemsSource = string.IsNullOrWhiteSpace(sender.Text) ? null : await ViewModel.Suggest<#= p.BaseName #>Async(sender.Text);
    }

    private void On<#= c.Name #>Chosen(AutoSuggestBox sender, AutoSuggestBoxSuggestionChosenEventArgs args) =>
        ViewModel.<#= c.Name #> = ((<#= WinUI3Names.LookupOptionClass(table, "DetailMaster", p.KeyCs) #>)args.SelectedItem).Id;

<#
        }
#>
    // A failed validation (ViewModel.SaveAsync) keeps the dialog open.
    private async void OnPrimaryButtonClick(ContentDialog sender, ContentDialogButtonClickEventArgs args)
    {
        var deferral = args.GetDeferral();
        try
        {
            if (!await ViewModel.SaveAsync())
                args.Cancel = true;
        }
        finally
        {
            deferral.Complete();
        }
    }
<#
        foreach (var c in shown.Where(c => form.ValueOf(c) == ValueKind.Date && c.IsNullable))
        {
#>

    // CalendarDatePicker has no clear button of its own; a nullable date gets one beside it.
    private void OnClear<#= c.Name #>Click(object sender, RoutedEventArgs e) => ViewModel.<#= c.Name #> = null;
<#
        }
#>
<#
        foreach (var child in children)
        {
            string childDialog = child.Table + (DatabaseModel.IsDetailMaster(child.Table, child.HasChildren, Project) ? "DetailMasterDialog" : "DetailDialog");
#>

<#
            if (child.HasDialog)
            {
#>
    // Opens the clicked <#= child.Table #> row's own dialog. WinUI3 allows one ContentDialog at a time, so this one hides first and does not reopen:
    // Hide() resolves its ShowAsync(), which also releases any ancestor dialog awaiting it, and three or more levels deep that
    // lets two dialogs call ShowAsync() at once and crashes the process.
    private async void On<#= child.Member #>ItemClick(object sender, ItemClickEventArgs e)
    {
        if (e.ClickedItem is <#= table #>ChildGridRow { Entity: <#= child.Type #> entity })
            await Open<#= child.Member #>Async(entity);
    }

    private async void On<#= child.Member #>EditClick(object sender, RoutedEventArgs e)
    {
        if (((FrameworkElement)sender).DataContext is <#= table #>ChildGridRow { Entity: <#= child.Type #> entity })
            await Open<#= child.Member #>Async(entity);
    }
<#
            }
#>

    // The first click on Delete only asks ("Confirm?"); the second deletes the row and reloads the grid. Losing focus puts the label back.
    private async void On<#= child.Member #>DeleteClick(object sender, RoutedEventArgs e)
    {
        var button = (Button)sender;
        if (button.DataContext is not <#= table #>ChildGridRow { Entity: <#= child.Type #> entity })
            return;
        if (button.Content as string != "Confirm?")
        {
            button.Content = "Confirm?";
            return;
        }
        try
        {
            await _api.<#= UnoNames.ClientProperty(child.Table) #>.DeleteAsync(entity.<#= child.KeyProp #>);
            await ViewModel.LoadAsync();
        }
        catch (ApiException ex)
        {
            ViewModel.ErrorMessage = ex.Explain("deleting");
            button.Content = "Delete";
        }
        catch (HttpRequestException)
        {
            ViewModel.ErrorMessage = "The server could not be reached.";
            button.Content = "Delete";
        }
    }

    private void On<#= child.Member #>DeleteLostFocus(object sender, RoutedEventArgs e) => ((Button)sender).Content = "Delete";

    // A click on a column header sorts the rows by it (again: flips the direction); the rows are all loaded, so it sorts them here.
    private void On<#= child.Member #>HeaderClick(object sender, RoutedEventArgs e) => ViewModel.Sort<#= child.Member #>By((string)((Button)sender).Tag);

    // A right-click on the grid offers Clear sort, which also forgets the saved sort.
    private void On<#= child.Member #>GridRightTapped(object sender, Microsoft.UI.Xaml.Input.RightTappedRoutedEventArgs e)
    {
        var clear = new MenuFlyoutItem { Text = "Clear sort", IsEnabled = ViewModel.Has<#= child.Member #>Sort };
        clear.Click += (_, _) => ViewModel.Clear<#= child.Member #>Sort();
        var flyout = new MenuFlyout();
        flyout.Items.Add(clear);
        flyout.ShowAt((FrameworkElement)sender, e.GetPosition((FrameworkElement)sender));
        e.Handled = true;
    }

<#
            if (child.HasDialog)
            {
#>
    private async System.Threading.Tasks.Task Open<#= child.Member #>Async(<#= child.Type #> entity)
    {
        _drillDown = new System.Threading.Tasks.TaskCompletionSource();
        Hide();
        var childDialog = new <#= childDialog #>(_api, entity) { XamlRoot = XamlRoot };
        try
        {
            await childDialog.ShowAndWaitAsync();
        }
        finally
        {
            _drillDown.SetResult();
        }
    }
<#
            }
#>
<#
        }
#>
}
@@@FILE <#= viewModelsFolder #>/<#= table #>DetailMasterViewModel.cs@@@
using System.Collections.Generic;
using System.Collections.ObjectModel;
using System.Text.RegularExpressions;
using System.Threading.Tasks;
using <#= modelsNamespace #>;
using <#= servicesNamespace #>;
using CommunityToolkit.Mvvm.ComponentModel;
using Microsoft.UI.Xaml;
<#
        foreach (string u in usings)
        {
#>
using <#= u #>;
<#
        }
#>

namespace <#= viewModelNamespace #>;

/// <summary> One entry of a <#= table #>DetailMasterDialog drop-down: an id plus the text to show for it. </summary>
public class <#= WinUI3Names.LookupOptionClass(table, "DetailMaster", "int") #>
{
    public int? Id { get; set; }
    public string Text { get; set; } = "";
}
<#
        // a drop-down over a parent whose key is not an int (a country or currency code, a GUID) has an option class of its own
        foreach (string optionKey in parents.Select(p => p.KeyCs).Where(k => k != "int").Distinct())
        {
#>

/// <summary> One entry of a <#= table #>DetailMasterDialog drop-down whose ids are <#= optionKey #>: an id plus the text to show for it. </summary>
public class <#= WinUI3Names.LookupOptionClass(table, "DetailMaster", optionKey) #>
{
    public <#= optionKey #>? Id { get; set; }
    public string Text { get; set; } = "";
}
<#
        }
#>

/// <summary> One row of a child grid: a display string per scalar EF property of the child entity (the columns are read from EF's metadata at run time). </summary>
public class <#= table #>ChildGridRow
{
    public List<string> Cells { get; init; } = [];
    /// <summary> What each cell sorts by: the value itself (a number, a date, a yes/no, text), or the name a column shows in place of an id. </summary>
    public List<object?> Values { get; init; } = [];
    /// <summary> The child entity this row shows, so clicking the row can open its own dialog. </summary>
    public object? Entity { get; init; }
}

/// <summary> The header of one column of a child grid: its caption (with an arrow when the grid is sorted by it) and the property it sorts by. </summary>
public class <#= table #>ChildGridHeader
{
    public string Text { get; init; } = "";
    public string Column { get; init; } = "";
}

public partial class <#= table #>DetailMasterViewModel : ViewModelBase
{
    private readonly ApiClients _api;
    private readonly <#= type #>? _editing;

    public string DialogTitle => _editing is null ? "Add <#= title #>" : "Edit <#= title #>";
<#
        if (textKey)
        {
#>
    /// <summary> True when the row was read from the database: its key can no longer be changed. </summary>
    public bool IsExisting => _editing is not null;
<#
        if (!form.TextKey)
        {
#>
    /// <summary> True while the row is new: the key is a whole number the person types, and a box cannot be read-only. </summary>
    public bool IsNewRow => _editing is null;
<#
        }
#>
<#
        }
#>
    public Visibility IsAddModeVisibility => _editing is null ? Visibility.Visible : Visibility.Collapsed;

<#
        foreach (var p in parents.Where(p => !p.TypeAhead))
        {
#>
    public ObservableCollection<<#= WinUI3Names.LookupOptionClass(table, "DetailMaster", p.KeyCs) #>> <#= WinUI3Names.OptionsProperty(p) #> { get; } = [];
<#
        }
        if (aheadParents.Count > 0)
        {
#>
    // Loading the dialog and the suggestions of a type-ahead take turns, so an old answer never replaces a newer one.
    private System.Threading.SemaphoreSlim _gate => ContextGate;

<#
        }
        foreach (var c in aheadColumns)
        {
#>
    /// <summary> What the <#= Labels.Column(c.Name) #> box shows: what was typed, or the name of the row that was picked. </summary>
    [ObservableProperty]
    private string _<#= char.ToLowerInvariant(c.Name[0]) #><#= c.Name[1..] #>Text = "";

<#
        }
        foreach (var p in aheadParents)
        {
#>
    /// <summary> The first few <#= p.Table #> rows whose text contains what was typed. </summary>
    public async Task<IReadOnlyList<<#= WinUI3Names.LookupOptionClass(table, "DetailMaster", p.KeyCs) #>>> Suggest<#= p.BaseName #>Async(string text)
    {
        await _gate.WaitAsync();
        try
        {
            var found = await _api.<#= UnoNames.ClientProperty(p.Table) #>.GetLookupAsync(search: text.Trim(), take: 10);
            return found.Select(r => new <#= WinUI3Names.LookupOptionClass(table, "DetailMaster", p.KeyCs) #> { Id = r.Id, Text = r.Name }).ToList();
        }
        finally { _gate.Release(); }
    }

<#
        }
        foreach (var child in children)
        {
#>
    public ObservableCollection<<#= table #>ChildGridHeader> <#= child.Var #>ColumnHeaders { get; } = [];
