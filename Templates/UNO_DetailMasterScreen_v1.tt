        int sortIndex = _<#= child.Var #>SortColumn is null ? -1 : _<#= child.Var #>Columns.IndexOf(_<#= child.Var #>SortColumn);
        IEnumerable<<#= table #>ChildGridRow> ordered = _<#= child.Var #>Loaded;
<#
