    // The headers (an arrow after the sorted one) and the rows in the grid's sort order.
    private void Show<#= child.Member #>Sorted()
    {
        <#= child.Var #>ColumnHeaders.Clear();
        for (int i = 0; i < _<#= child.Var #>Columns.Count; i++)
            <#= child.Var #>ColumnHeaders.Add(new <#= table #>ChildGridHeader { Text = _<#= child.Var #>Captions[i] + SortMark(_<#= child.Var #>Columns[i], _<#= child.Var #>SortColumn, _<#= child.Var #>SortDescending), Column = _<#= child.Var #>Columns[i] });

