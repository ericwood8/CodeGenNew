<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // BLZ_Screens_v1.tt
    // Generates: Layout/NavMenu.razor, Pages/Home.razor and Services/ApiClients.cs   (the paths are written by the template; point the output folder at the Blazor app's folder)
    // The two lists a Blazor shell takes from the database: the menu (one link per screen, in the order of the project's Screens setting, which MainLayout shows) and the registration of every
    // table's API client (Program.cs calls AddApiClients()); Home sends the address / to the first screen (the dashboard with Dashboard=true, which also adds its menu link and client). The pages themselves are BLZ_Page's.
    // With OData=true each table served as OData also gets the entry of its OData page (BLZ_ODataPage) after the REST ones, with the route <table>-odata and the label "<Table> (OData)", and its
    // OData client is registered; ODataScreens=Replace leaves the menu as it is (the OData page has the REST page's route).
    // With Auth=true the menu shows only to a signed-in person and leaves out the screens of tables whose reads ReadRoles / TableReadRoles limit to other roles; Home opens the first screen the role may read.
    // Full notes: Docs/TemplateNotes/BLZ_Screens_v1.md
    // ==========================================================================================

    var screens = Database.ScreenTables(Project, "Blazor");
    foreach (string name in Database.UnknownScreens(Project))
        Error($"The Screens setting lists '{name}', which is not a table of the database with a single-column primary key.");
    if (screens.Count == 0)
        Error("BLZ_Screens found no table to list: no table has an API and a search endpoint, and the project's Screens setting is empty.");
    var clients = Database.AspNetApiTables(Project).Where(t => BlazorNames.HasClient(t, Project)).ToList();
    var odataClients = Project.OData ? ODataPlan.For(Database, Project).Tables.Where(t => BlazorNames.HasODataClient(t, Project)).ToList() : new List<TableModel>();

    // the screens in menu order: the dashboard, the REST screens, the OData ones that do not take a REST screen's place, then a page for each junction table (BlazorMenu is the one list)
    var entries = BlazorMenu.Entries(Database, Project);
    var junctionTables = Database.Tables.Where(t => BlazorNames.HasJunctionPage(t, Project)).OrderBy(t => t.TableName, StringComparer.OrdinalIgnoreCase).ToList();

    var o = new StringBuilder();
    void L(string s = "") => o.Append(s).Append('\n');

    L("@@@FILE Layout/NavMenu.razor@@@");
    L("@* Generated by BLZ_Screens: one link per screen, in menu order. Change the list with the Screens project setting and regenerate. *@");
    if (Project.Auth)
    {
        L("@implements IDisposable");
        L("@inject AuthSession Session");
        L();
        L("<nav class=\"rail\">");
        L("    @if (Session.IsSignedIn)");
        L("    {");
        foreach (var e in entries)
        {
            if (e.Roles.Count == 0)
                L($"        <NavLink href=\"{e.Route}\">{e.Label}</NavLink>");
            else
            {
                L($"        @if (Session.HasRole([{WriteRolePlan.Literal(e.Roles)}]))");
                L("        {");
                L($"            <NavLink href=\"{e.Route}\">{e.Label}</NavLink>");
                L("        }");
            }
        }
        L("    }");
        L("</nav>");
        L();
        L("@code {");
        L("    protected override void OnInitialized() => Session.Changed += Refresh;");
        L();
        L("    private void Refresh() => InvokeAsync(StateHasChanged);");
        L();
        L("    public void Dispose() => Session.Changed -= Refresh;");
        L("}");
    }
    else
    {
        L("<nav class=\"rail\">");
        foreach (var e in entries)
            L($"    <NavLink href=\"{e.Route}\">{e.Label}</NavLink>");
        L("</nav>");
    }
    L("@@@FILE Pages/Home.razor@@@");
    L("@page \"/\"");
    L("@inject NavigationManager Navigation");
    if (Project.Auth)
    {
        L("@inject AuthSession Session");
        L();
        L("@if (nothingToShow)");
        L("{");
        L("    <p role=\"alert\">There is no screen your role may read.</p>");
        L("}");
        L();
        L("@code {");
        L("    private bool nothingToShow;");
        L();
        L("    // The screens in menu order and the roles that may read each (none listed: any signed-in person).");
        L("    private static readonly (string Route, string[]? Roles)[] Screens =");
        L("    [");
        foreach (var e in entries)
            L(e.Roles.Count == 0 ? $"        (\"{e.Route}\", null)," : $"        (\"{e.Route}\", [{WriteRolePlan.Literal(e.Roles)}]),");
        L("    ];");
        L();
        L("    protected override async Task OnInitializedAsync()");
        L("    {");
        L("        await Session.InitializeAsync();");
        L("        if (!Session.IsSignedIn)");
        L("        {");
        L("            Navigation.NavigateTo(\"login\", replace: true);");
        L("            return;");
        L("        }");
        L("        foreach (var (route, roles) in Screens)");
        L("        {");
        L("            if (roles is null || Session.HasRole(roles))");
        L("            {");
        L("                Navigation.NavigateTo(route, replace: true);");
        L("                return;");
        L("            }");
        L("        }");
        L("        nothingToShow = true;");
        L("    }");
        L("}");
    }
    else
    {
        L();
        L("@code {");
        L($"    protected override void OnInitialized() => Navigation.NavigateTo(\"{(Project.Dashboard ? "dashboard" : screens.Count > 0 ? ScreenNames.Route(screens[0].TableName) : "")}\", replace: true);");
        L("}");
    }
    L("@@@FILE Services/ApiClients.cs@@@");
    L("namespace " + BlazorNames.Namespace(Project) + ".Services;");
    L();
    L("// Generated by BLZ_Screens: every table's API client, registered for injection into the pages.");
    L("public static class ApiClients");
    L("{");
    L("    public static IServiceCollection AddApiClients(this IServiceCollection services)");
    L("    {");
    foreach (var t in clients)
        L($"        services.AddScoped<{BlazorNames.TypeName(t.TableName)}Client>();");
    foreach (var t in odataClients)
        L($"        services.AddScoped<{BlazorNames.ODataClientName(t.TableName)}>();");
    foreach (var t in junctionTables)
        L($"        services.AddScoped<{t.TableName}JunctionClient>();");
    if (Project.Dashboard)
        L("        services.AddScoped<DashboardClient>();");
    if (ApprovalScreens.For(Database, Project).Count > 0)
        L("        services.AddScoped<ApprovalsClient>();");
    L("        return services;");
    L("    }");
    L("}");
    Write(o.ToString());
#>
