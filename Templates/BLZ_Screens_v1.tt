<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // BLZ_Screens_v1.tt
    // Generates: Layout/NavMenu.razor, Pages/Home.razor and Services/ApiClients.cs   (the paths are written by the template; point the output folder at the Blazor app's folder)
    // The two lists a Blazor shell takes from the database: the menu (one link per screen, in the order of the project's Screens setting, which MainLayout shows) and the registration of every
    // table's API client (Program.cs calls AddApiClients()); Home sends the address / to the first screen. The pages themselves are BLZ_Page's.
    // Full notes: Docs/TemplateNotes/BLZ_Screens_v1.md
    // ==========================================================================================

    var screens = Database.ScreenTables(Project);
    foreach (string name in Database.UnknownScreens(Project))
        Error($"The Screens setting lists '{name}', which is not a table of the database with a single-column primary key.");
    if (screens.Count == 0)
        Error("BLZ_Screens found no table to list: no table has an API and a search endpoint, and the project's Screens setting is empty.");
    var clients = Database.ApiTables(Project).Where(t => BlazorNames.HasClient(t, Project)).ToList();

    var o = new StringBuilder();
    void L(string s = "") => o.Append(s).Append('\n');

    L("@@@FILE Layout/NavMenu.razor@@@");
    L("@* Generated by BLZ_Screens: one link per screen, in menu order. Change the list with the Screens project setting and regenerate. *@");
    L("<nav class=\"rail\">");
    foreach (var t in screens)
        L($"    <NavLink href=\"{ScreenNames.Route(t.TableName)}\">{ScreenNames.Label(t.TableName)}</NavLink>");
    L("</nav>");
    L("@@@FILE Pages/Home.razor@@@");
    L("@page \"/\"");
    L("@inject NavigationManager Navigation");
    L();
    L("@code {");
    L($"    protected override void OnInitialized() => Navigation.NavigateTo(\"{(screens.Count > 0 ? ScreenNames.Route(screens[0].TableName) : "")}\", replace: true);");
    L("}");
    L("@@@FILE Services/ApiClients.cs@@@");
    L("namespace " + BlazorNames.Namespace(Project) + ".Services;");
    L();
    L("// Generated by BLZ_Screens: every table's API client, registered for injection into the pages.");
    L("public static class ApiClients");
    L("{");
    L("    public static IServiceCollection AddApiClients(this IServiceCollection services)");
    L("    {");
    foreach (var t in clients)
        L($"        services.AddScoped<{BlazorNames.TypeName(t.TableName)}Client>();");
    L("        return services;");
    L("    }");
    L("}");
    Write(o.ToString());
#>
