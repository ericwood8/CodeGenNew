    // The grid's sort: a column name (null = the default order) and the direction. It is remembered between runs (GridSortStore) until Clear sort.
    private const string GridKey = "<#= stemName #>";
    private static readonly string[] SortableColumns = [<#= string.Join(", ", sortableShown.Select(c => "\"" + c.Name + "\"")) #>];
    private string? _sortColumn;
    private bool _sortDescending;

    public bool HasSort => _sortColumn is not null;
<#
        if (gated)
        {
#>

    /// <summary> The buttons that write show only to the roles that may write this table (WriteRoles). </summary>
    public Visibility WriteVisibility => _api.Session.HasRole([<#= WriteRolePlan.Literal(writeRoles) #>]) ? Visibility.Visible : Visibility.Collapsed;
<#
        }
#>

    public <#= stemName #>ListViewModel(ApiClients api)
    {
        _api = api;
        var saved = GridSortStore.Load(GridKey, SortableColumns);
        _sortColumn = saved?.Column;
        _sortDescending = saved?.Descending ?? false;
    }

    /// <summary> A click on a column header: another column sorts ascending, the sorted column flips its direction. The caller reloads (page 1). </summary>
    public void SortBy(string column)
    {
        if (_sortColumn == column)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortColumn = column;
            _sortDescending = false;
        }
        PageNumber = 1;
        GridSortStore.Save(GridKey, new GridSortEntry(_sortColumn, _sortDescending));
    }

    /// <summary> Back to the default order, and forget the saved sort. The caller reloads (page 1). </summary>
    public void ClearSort()
    {
        _sortColumn = null;
        _sortDescending = false;
        PageNumber = 1;
        GridSortStore.Save(GridKey, null);
    }

    /// <summary> The arrow shown after the caption of the sorted column's header. </summary>
    public string SortMark(string column) => _sortColumn == column ? (_sortDescending ? " ▼" : " ▲") : "";

<#
        if (anyAhead)
        {
#>
    // A load and the suggestions of a type-ahead take turns, so an old answer never replaces a newer one.
    private readonly System.Threading.SemaphoreSlim _gate = new(1, 1);

<#
        }
#>
    /// <summary> Reads the current page from the API. A call that fails shows its sentence in ErrorMessage instead of throwing. </summary>
    public async Task LoadAsync()
    {
<#
        if (anyAhead)
        {
#>
        await _gate.WaitAsync();
<#
        }
#>
        try
        {
            await ReadAsync();
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Explain("loading");
            HasLoaded = true;
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "The server could not be reached.";
            HasLoaded = true;
        }
<#
        if (anyAhead)
        {
#>
        finally { _gate.Release(); }
<#
        }
#>
    }

    private async Task ReadAsync()
    {
        ErrorMessage = null;
        Rows.Clear();

<#
        foreach (var p in parents)
        {
            if (p.TypeAhead)
            {
#>
        Dictionary<<#= p.KeyCs #>, string> <#= WinUI3Names.NamesDictionary(p) #> = [];   // too many rows to read: filled below with the names of the rows this page shows
<#
            }
            else
            {
#>
        var <#= WinUI3Names.NamesDictionary(p) #> = (await _api.<#= UnoNames.ClientProperty(p.Table) #>.<#= BlazorNames.LoadCall(p) #>()).ToDictionary(r => r.<#= BlazorNames.KeyProperty(p) #>, r => r.<#= BlazorNames.DisplayProperty(p) #>?.ToString() ?? "");
<#
            }
        }
#>

<#
        foreach (var k in searchKeys.Where(k => !k.Parent.TypeAhead))
        {
#>
        if (<#= k.Choices #>.Count == 0)
        {
            // the parent's rows by name, after "All": picking one filters the grid to the rows that point at it
            var <#= k.Choices #>Names = (await _api.<#= UnoNames.ClientProperty(k.Parent.Table) #>.<#= BlazorNames.LoadCall(k.Parent) #>()).ToDictionary(r => r.<#= BlazorNames.KeyProperty(k.Parent) #>, r => r.<#= BlazorNames.DisplayProperty(k.Parent) #>?.ToString() ?? "");
            <#= k.Choices #>.Add(new <#= stemName #>KeyChoice(null, "All <#= k.Label.Pluralize() #>"));
            foreach (var choice in <#= k.Choices #>Names.OrderBy(n => n.Value, StringComparer.CurrentCultureIgnoreCase))
                <#= k.Choices #>.Add(new <#= stemName #>KeyChoice(choice.Key, choice.Value));
            <#= k.Prop #> ??= <#= k.Choices #>[0];
        }
<#
        }
#>
        // the search boxes by the names the API's search endpoint reads; a blank one is left out by the client
        var filters = new Dictionary<string, string?>
        {
<#
        foreach (var f in searchFields)
        {
#>
            ["<#= f.ParamName #>"] = <#= f.Prop #>,
<#
        }
        foreach (var k in searchKeys)
        {
#>
            ["<#= k.ParamName #>"] = <#= k.Prop #>?.Id?.ToString(),
<#
        }
#>
        };
        var result = <#= pageCall #>;
        var rows = result.Items;
        int totalCount = result.TotalCount;
        TotalPages = totalCount == 0 ? 0 : (int)Math.Ceiling(totalCount / (double)PageSize);
        if (rows.Count == 0 && totalCount > 0 && PageNumber > TotalPages)
        {
            // the last row of the last page was deleted: show the last page there is
            PageNumber = TotalPages;
            result = <#= pageCall #>;
            rows = result.Items;
            totalCount = result.TotalCount;
        }
        TotalRows = totalCount;
        HasLoaded = true;
<#
        foreach (var p in aheadParents)
        {
            var own = shown.Where(c => form.ParentOf(c) == p).ToList();
            string ids = own.Select(c => $"rows.Select(r => r.{c.Name}).OfType<{p.KeyCs}>()").Aggregate((a, b) => $"{a}.Concat({b})");
#>
        {
            var ids = <#= ids #>.Distinct().ToList();
            if (ids.Count > 0)
                <#= WinUI3Names.NamesDictionary(p) #> = (await _api.<#= UnoNames.ClientProperty(p.Table) #>.GetLookupAsync(ids: ids)).ToDictionary(r => r.Id, r => r.Name);
        }
<#
        }
#>

        foreach (var e in rows)
        {
            List<string> cells =
            [
<#
        foreach (var c in shown)
            Write(DesktopGridCode.CellLines(form, Project, c));
#>
            ];
            Rows.Add(new <#= stemName #>ListRow { Id = e.<#= keyProp #>, Cells = cells<#= gated ? ", WriteVisibility = WriteVisibility" : "" #> });
        }
    }

    /// <summary> The row to edit, or null when it no longer exists (or the server cannot be reached; ErrorMessage says so). </summary>
    public async Task<<#= type #>?> GetAsync(<#= keyCs #> id)
    {
        ErrorMessage = null;
        try
        {
            return await Client.GetAsync(id);
        }
        catch (ApiException ex) when (ex.Status == <#= HttpStatus.NotFound #>)
        {
            return null;
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Explain("reading");
            return null;
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "The server could not be reached.";
            return null;
        }
    }

    public async Task DeleteAsync(<#= keyCs #> id)
    {
        ErrorMessage = null;
        try
        {
            await Client.DeleteAsync(id);
        }
        catch (ApiException ex)
        {
            ErrorMessage = ex.Status == <#= HttpStatus.NotFound #> ? "This row no longer exists." : ex.Status == <#= HttpStatus.BadRequest #> ? "This row cannot be deleted because it is in use." : ex.Explain("deleting");
            return;
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "The server could not be reached.";
            return;
        }
        await LoadAsync();
    }

<#
        if (canClone)
        {
#>
    /// <summary> Copies the row and returns the copy, or null with ErrorMessage set when the copy failed. </summary>
    public async Task<<#= type #>?> CloneAsync(<#= keyCs #> id)
    {
        ErrorMessage = null;
        try
        {
            return await Client.CloneAsync(id);
        }
        catch (ApiException ex)
        {
            ErrorMessage = "The row could not be cloned: " + ex.Explain("cloning");
            return null;
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "The server could not be reached.";
            return null;
        }
    }

<#
        }
#>
    /// <summary> The person picked another page size under the grid: the first page is read again with it. </summary>
    public async Task ChangePageSizeAsync(int size)
    {
        if (size == PageSize) return;
        PageSize = size;
        PageNumber = 1;
        await LoadAsync();
    }

    public async Task PreviousPageAsync()
    {
        if (!CanGoPrevious) return;
        PageNumber--;
        await LoadAsync();
    }

    public async Task NextPageAsync()
    {
        if (!CanGoNext) return;
        PageNumber++;
        await LoadAsync();
    }
}
