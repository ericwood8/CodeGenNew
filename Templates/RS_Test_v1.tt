#[tokio::test]
async fn a_row_can_be_cloned() {
    let Some(api) = Client::start().await else { return };
    let Some(body) = new_body(&api).await else { return };

    let created = api.post(ROUTE, &body).await;
    assert_eq!(created.status, StatusCode::CREATED, "{}", created.body);
    let id = segment(&created.json()[<#= Json(keyJson) #>]);

    let cloned = api.post_empty(&format!("{ROUTE}/{id}/clone")).await;
    assert_eq!(cloned.status, StatusCode::CREATED, "{}", cloned.body);
    let copy_id = segment(&cloned.json()[<#= Json(keyJson) #>]);
    assert_ne!(id, copy_id, "the copy is a new row");

    api.delete(&format!("{ROUTE}/{copy_id}")).await;
    api.delete(&format!("{ROUTE}/{id}")).await;
}
