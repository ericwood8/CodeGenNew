#[tokio::test]
async fn a_second_row_with_a_value_that_must_be_unique_is_refused() {
    let Some(api) = Client::start().await else { return };
    let Some(body) = new_body(&api).await else { return };

    let created = api.post(ROUTE, &body).await;
    assert_eq!(created.status, StatusCode::CREATED, "{}", created.body);
    let id = segment(&created.json()[<#= Json(keyJson) #>]);

    let mut again = new_body(&api).await.expect("a second body");
    again[<#= uniqueJson #>] = body[<#= uniqueJson #>].clone();
    let duplicate = api.post(ROUTE, &again).await;
    if duplicate.status.is_success() {
        let extra = segment(&duplicate.json()[<#= Json(keyJson) #>]);
        api.delete(&format!("{ROUTE}/{extra}")).await;
    }
    assert!(duplicate.status.is_client_error(), "the duplicate is refused with a client error, not saved and not a 500: {}", duplicate.status);

    api.delete(&format!("{ROUTE}/{id}")).await;
}
