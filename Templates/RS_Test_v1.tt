#[tokio::test]
async fn the_search_sorts_by_each_column_it_offers() {
    let Some(api) = Client::start().await else { return };
    for column in [<#= string.Join(", ", sortNames.Select(Json)) #>] {
        for direction in ["asc", "desc"] {
            let page = api.get(&format!("{ROUTE}/search?pageNumber=1&pageSize=5&sortBy={column}&sortDir={direction}")).await;
            assert_eq!(page.status, StatusCode::OK, "{column} {direction}: {}", page.body);
        }
    }
}

