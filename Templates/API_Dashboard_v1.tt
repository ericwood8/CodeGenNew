<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string apiNamespace = "MyApp.ApiService.Apis";
    string repositoryNamespace = "MyApp.Common.Repositories";
    string contextType = "MyAppContext";
    string[] usings = { };   // namespaces the generated file must "using" (the context's)
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    contextType = Project.ContextName ?? contextType;
    apiNamespace = Project.ApiNamespace ?? apiNamespace;
    repositoryNamespace = Project.RepoNamespace ?? repositoryNamespace;
    usings = Project.Usings ?? usings;
    // ==========================================================================================

    // ==========================================================================================
    // API_Dashboard_v1.tt
    // Generates: DashboardApi.cs   (see OutputName in API_Dashboard_v1.tt.config)
    // GET /api/dashboard returns every widget of the dashboard page in one call; GET /api/dashboard?table=Customer returns the cards of that table's strip. The data comes from
    // DashboardData (CS_Dashboard) and is kept for a minute; with ApiAuth and ReadRoles / TableReadRoles a caller gets only the widgets of tables the role may read. Registered by API_Registration when the project says Dashboard=true.
    // Full notes: Docs/TemplateNotes/API_Dashboard_v1.md

    string usingLines = string.Concat(usings.Select(u => $"using {u};\n"));

    // ReadRoles with ApiAuth: a widget of a table whose reads are limited goes only to those roles.
    var limited = Database.Tables.Select(t => (t.TableName, Roles: WriteRolePlan.ReadFor(Project, t))).Where(t => t.Roles.Count > 0).ToList();
    string readRules = string.Concat(limited.Select(t => $"        [\"{t.TableName}\"] = [{WriteRolePlan.Literal(t.Roles)}],\n"));
#>
namespace <#= apiNamespace #>;

<#= usingLines #><#= limited.Count > 0 ? "using System.Security.Claims;\n" : "" #>using <#= repositoryNamespace #>;
using static Microsoft.AspNetCore.Http.TypedResults;

/// <summary> Generated by API_Dashboard: the read-only dashboard endpoint. </summary>
public static class DashboardApi
{
    public static void Register(WebApplication app)
    {
        app.MapGet("/api/dashboard", Get)
        .WithName("GetDashboard")
        .WithOpenApi()
        .Produces<DashboardResult>()
        .ProducesProblem(<#= HttpStatus.InternalServerError #>);
    }

<#
    if (limited.Count > 0)
    {
#>
    /// <summary> The roles that may read a table's rows (ReadRoles, TableReadRoles); a table not listed is open to every signed-in person. </summary>
    private static readonly Dictionary<string, string[]> ReadRules = new(StringComparer.OrdinalIgnoreCase)
    {
<#= readRules #>    };

    private static async Task<IResult> Get([FromServices] <#= contextType #> context, ClaimsPrincipal caller, string? table)
    {
        var result = await DashboardData.LoadAsync(context, table, useCache: true);
        // The result is shared by every caller for a minute, so a copy without the widgets this caller may not read is sent.
        var allowed = result.Widgets.Where(w => !ReadRules.TryGetValue(w.Table, out var roles) || RoleGate.Allows(caller, roles)).ToList();
        return Ok(new DashboardResult { Widgets = allowed });
    }
<#
    }
    else
    {
#>
    private static async Task<IResult> Get([FromServices] <#= contextType #> context, string? table)
    {
        var result = await DashboardData.LoadAsync(context, table, useCache: true);
        return Ok(result);
    }
<#
    }
#>
}
