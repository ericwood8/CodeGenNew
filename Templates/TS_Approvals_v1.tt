@@@FILE <#= componentsFolder #>/approvals/approval-panel.component.ts@@@
import { ChangeDetectionStrategy, ChangeDetectorRef, Component, Input, OnChanges } from '@angular/core';
import { CommonModule } from '@angular/common';
import { Observable } from 'rxjs';
import { ApprovalView, ApprovalsService, panelStatus, problemText } from '../../<#= servicesFolder #>/approvals.service';

// The approval of one saved row, on its edit form: the latest request, with Request while none waits and Withdraw while one does. The API says who may do what.
@Component({
  selector: 'app-approval-panel',
<#= detection #><#= standalone #>  imports: [CommonModule],
  templateUrl: './approval-panel.component.html',
  styleUrl: './approval-panel.component.css'
})
export class ApprovalPanelComponent implements OnChanges {
  @Input() segment = '';
  @Input() id = 0;
  latest: ApprovalView | null = null;
  loaded = false;
  reason = '';
  message: string | null = null;
  failed = false;

  constructor(private service: ApprovalsService, private changes: ChangeDetectorRef) { }

  get pending(): boolean {
    return this.latest !== null && this.latest.status === '<#= ApprovalWords.PendingStatus #>';
  }

  ngOnChanges(): void {
    this.load();
  }

  status(latest: ApprovalView): string {
    return panelStatus(latest);
  }

  requestApproval(): void {
    this.act(this.service.request(this.segment, this.id, this.reason), '<#= ApprovalWords.Requested #>');
  }

  withdraw(): void {
    this.act(this.service.withdraw(this.segment, this.id), '<#= ApprovalWords.Withdrawn #>');
  }

  private load(): void {
    this.service.history(this.segment, this.id).subscribe({
      next: (cycles) => {
        this.latest = cycles.reduce<ApprovalView | null>((best, c) => (best === null || c.revision > best.revision ? c : best), null);
        this.loaded = true;
        this.changes.markForCheck();
      },
      error: () => { this.failed = true; this.message = '<#= ApprovalWords.PanelLoadFailed #>'; this.changes.markForCheck(); }
    });
  }

  private act(call: Observable<ApprovalView>, done: string): void {
    call.subscribe({
      next: () => { this.failed = false; this.message = done; this.reason = ''; this.load(); },
      error: (error) => { this.failed = true; this.message = problemText(error); this.changes.markForCheck(); }
    });
  }
}
@@@FILE <#= componentsFolder #>/approvals/approval-panel.component.html@@@
<#= panelHtml #>@@@FILE <#= componentsFolder #>/approvals/approval-panel.component.css@@@
:host { display: block; }
.approvals-error { color: #b00020; }
@@@FILE <#= componentsFolder #>/approvals/approval-panel.component.spec.ts@@@
import { TestBed } from '@angular/core/testing';
import { provideHttpClient } from '@angular/common/http';
import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';

import { ApprovalPanelComponent } from './approval-panel.component';

const pending = { id: 1, rowId: 7, revision: 1, status: 'Pending', reason: 'please', requestedBy: 'ann', requestedOn: '2026-01-02T00:00:00', decidedBy: null, decidedOn: null, decisionNote: null };

async function open() {
  await TestBed.configureTestingModule({
    imports: [ApprovalPanelComponent],
    providers: [provideHttpClient(), provideHttpClientTesting()]
  }).compileComponents();
  const fixture = TestBed.createComponent(ApprovalPanelComponent);
  fixture.componentRef.setInput('segment', '<#= first #>');
  fixture.componentRef.setInput('id', 7);
  fixture.detectChanges();
  return { fixture, http: TestBed.inject(HttpTestingController), text: () => (fixture.nativeElement as HTMLElement).textContent ?? '' };
}

describe('ApprovalPanelComponent', () => {
  it('says so for a row that was never requested and offers the request', async () => {
    const { fixture, http, text } = await open();
    http.expectOne('api/<#= first #>/7/approvals').flush([]);
    fixture.detectChanges();
    expect(text()).toContain('<#= ApprovalWords.NoHistory #>');
    expect(text()).toContain('<#= ApprovalWords.Request #>');
    expect(text()).not.toContain('<#= ApprovalWords.Withdraw #>');
  });

  it('requests approval with the reason and shows the new status', async () => {
    const { fixture, http, text } = await open();
    http.expectOne('api/<#= first #>/7/approvals').flush([]);
    fixture.componentInstance.reason = 'please';
    fixture.componentInstance.requestApproval();
    const post = http.expectOne('api/<#= first #>/7/request');
    expect(post.request.body).toEqual({ reason: 'please' });
    post.flush(pending);
    http.expectOne('api/<#= first #>/7/approvals').flush([pending]);
    fixture.detectChanges();
    expect(text()).toContain('<#= ApprovalWords.PanelHeading #> status: Pending, requested by ann');
    expect(text()).toContain('<#= ApprovalWords.Withdraw #>');
    expect(text()).not.toContain('<#= ApprovalWords.Request #>');
  });

  it('withdraws a waiting request', async () => {
    const { fixture, http, text } = await open();
    http.expectOne('api/<#= first #>/7/approvals').flush([pending]);
    fixture.detectChanges();
    fixture.componentInstance.withdraw();
    http.expectOne('api/<#= first #>/7/withdraw').flush({ ...pending, status: 'Withdrawn' });
    http.expectOne('api/<#= first #>/7/approvals').flush([{ ...pending, status: 'Withdrawn', decidedBy: 'ann' }]);
    fixture.detectChanges();
    expect(text()).toContain('<#= ApprovalWords.Withdrawn #>');
  });

  it('shows the latest cycle of a decided row with its note', async () => {
    const { fixture, http, text } = await open();
    http.expectOne('api/<#= first #>/7/approvals').flush([{ ...pending, status: 'Rejected', decidedBy: 'bob' }, { ...pending, id: 2, revision: 2, status: 'Approved', decidedBy: 'bob', decisionNote: 'fine' }]);
    fixture.detectChanges();
    expect(text()).toContain('<#= ApprovalWords.PanelHeading #> status: Approved, decided by bob: fine');
  });

  it('shows the sentence of a refused request', async () => {
    const { fixture, http, text } = await open();
    http.expectOne('api/<#= first #>/7/approvals').flush([]);
    fixture.componentInstance.requestApproval();
    http.expectOne('api/<#= first #>/7/request').flush({ detail: '<#= ApprovalWords.AlreadyWaiting #>' }, { status: <#= HttpStatus.Conflict #>, statusText: 'Conflict' });
    fixture.detectChanges();
    expect(text()).toContain('<#= ApprovalWords.AlreadyWaiting #>');
  });
});
@@@FILE <#= componentsFolder #>/approvals/approvals.component.spec.ts@@@
import { TestBed } from '@angular/core/testing';
import { provideHttpClient } from '@angular/common/http';
import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';

import { ApprovalsComponent } from './approvals.component';

const pending = { id: 1, rowId: 7, revision: 1, status: 'Pending', reason: 'please', requestedBy: 'ann', requestedOn: '2026-01-02T00:00:00', decidedBy: null, decidedOn: null, decisionNote: null };

async function open() {
  await TestBed.configureTestingModule({
    imports: [ApprovalsComponent],
    providers: [provideHttpClient(), provideHttpClientTesting()]
  }).compileComponents();
  const fixture = TestBed.createComponent(ApprovalsComponent);
  fixture.detectChanges();
  return { fixture, http: TestBed.inject(HttpTestingController), text: () => (fixture.nativeElement as HTMLElement).textContent ?? '' };
}

describe('ApprovalsComponent', () => {
  it('says so when nothing is waiting', async () => {
    const { fixture, http, text } = await open();
    http.expectOne('api/<#= first #>/toapprove').flush([]);
    fixture.detectChanges();
    expect(text()).toContain('<#= ApprovalWords.NoneWaiting #>');
  });

  it('lists the requests waiting and posts an approval with its note', async () => {
    const { fixture, http, text } = await open();
    http.expectOne('api/<#= first #>/toapprove').flush([pending]);
    fixture.detectChanges();
    expect(text()).toContain('ann');
    fixture.componentInstance.setNote(fixture.componentInstance.tables[0], 7, 'ok');
    fixture.componentInstance.decide(fixture.componentInstance.tables[0], 7, true);
    const post = http.expectOne('api/<#= first #>/7/approve');
    expect(post.request.body).toEqual({ note: 'ok' });
    post.flush({ ...pending, status: 'Approved' });
    http.expectOne('api/<#= first #>/toapprove').flush([]);
    http.expectOne('api/<#= first #>/7/approvals').flush([{ ...pending, status: 'Approved' }]);
    fixture.detectChanges();
    expect(text()).toContain('<#= ApprovalWords.Approved #>');
  });

  it('shows the sentence of a refused decision', async () => {
    const { fixture, http, text } = await open();
    http.expectOne('api/<#= first #>/toapprove').flush([pending]);
    fixture.componentInstance.decide(fixture.componentInstance.tables[0], 7, false);
    http.expectOne('api/<#= first #>/7/reject').flush({ detail: '<#= ApprovalWords.FourEyes #>' }, { status: <#= HttpStatus.Forbidden #>, statusText: 'Forbidden' });
    fixture.detectChanges();
    expect(text()).toContain('<#= ApprovalWords.FourEyes #>');
  });

  it('asks for a row number before it requests', async () => {
    const { fixture, http, text } = await open();
    http.expectOne('api/<#= first #>/toapprove').flush([]);
    fixture.componentInstance.requestApproval(fixture.componentInstance.tables[0]);
    fixture.detectChanges();
    expect(text()).toContain('<#= ApprovalWords.NeedRow #>');
    http.expectNone('api/<#= first #>/0/request');
  });
});
