# Restriction checkboxes for RS_EssentialAuth_v1.tt (see Docs/Reference.md section 3).
# One of the files a Rust API can have: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`;
# a project that says ApiAuth=true gets it with every `codegen generate --essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Rust
EssentialsGroup=Jwt
EssentialsDefault=false
Description=Sign-in (ApiAuth=true): src/auth.rs (POST /api/auth/login, the bearer check, password hashing, the owner scope)
