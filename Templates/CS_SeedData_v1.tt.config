# Restriction checkboxes for CS_SeedData_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
OutputName=SeedData.cs
# Whole-project generation (codegen generate): the project's SeedTables adds the template to the plan.
Stacks=Api
OutputFolder=Seeding
InPlan=false
