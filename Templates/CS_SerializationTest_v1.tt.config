# Restriction checkboxes for CS_SerializationTest_v1.tt (see Docs/Reference.md section 3).
# Tests the classes CS_SerializationDtos writes; they need no key.
# Name the file like the table: Customer -> CustomerSerializationTests.cs
Requires=
OutputName={Table}SerializationTests.cs
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso. The files go to the test project (ApiTests=true writes it), not the API.
Stacks=Api
PlanTables=Dto
OutputRoot=ApiTests
InPlan=false
