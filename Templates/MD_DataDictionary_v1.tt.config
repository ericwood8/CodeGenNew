# Restriction checkboxes for MD_DataDictionary_v1.tt (see Docs/specs.md section 5.3).
# A table page needs no key: any table or view has columns to describe.
RequiresPrimaryKey=false
TableOnly=false
# Name the file like the table: Customer -> Customer.md
OutputName={Table}.md
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso.
Stacks=Api
PlanTables=Entity
OutputFolder=docs/tables
InPlan=false
