# Restriction checkboxes for TS_Features_v1.tt (see Docs/Reference.md section 3).
# One set of files for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# No OutputName: the template writes its own paths (the service, and the component with its html, css and spec) with @@@FILE markers.
# Whole-project generation (codegen generate): written only for a project with Auth=true, ApiAuth, FeatureTables and a tenant column on the override table.
Stacks=Angular
InPlan=false
