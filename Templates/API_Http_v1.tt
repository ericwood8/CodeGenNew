<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Globalization" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // API_Http_v1.tt
    // Generates: <TableName>.http   (see OutputName in API_Http_v1.tt.config)
    // A request file for one table's API, for Visual Studio, Visual Studio Code (REST Client) and Rider: get all, get one, search, create, update, delete and (where the clone routine exists) clone,
    // against http://localhost:<ApiPort> (the Rust port for a project with a Rust stack and no Api stack; the Python and Rust APIs answer the same routes). The create and update bodies hold one value for every column that cannot be NULL, shaped by the column (a choice from its CHECK list, a number inside its
    // range, an email address for an email column); a nullable column is left out. Change the host and the id at the top; run the requests one by one.
    // Writes for the tables API_Crud writes an API for, with the routes the API templates use. Does not log in: with ApiAuth=true every request carries Authorization: Bearer {{token}} and the token variable at the top is yours to fill from POST /api/auth/login.
    // Full notes: Docs/TemplateNotes/API_Http_v1.md
    // ==========================================================================================

    if (!Model.HasCrudApiOfAnyKey(Project))
    {
        Error($"API_Http writes requests for the tables API_Crud writes an API for (a single int, uniqueidentifier or text key, not an enum or a name/active table), and [{Model.SchemaName}].[{Model.TableName}] is not one.");
    }
    else
    {
        string singular = Model.TableName;
        string idVar = ApiRequests.IdVariable(Model);
        string plural = singular.Pluralize();
        string route = "/api/" + plural.ToLowerInvariant();
        var key = Model.PrimaryKeyColumns[0];
        string words = Labels.Words(singular);

        // the request body: every column that cannot be NULL (and is not computed), by its JSON name; the key from the id variable for an update
        string Body(bool update) => ApiRequests.Body(Model, Project, update);

        var o = new StringBuilder();
        void L(string s = "") => o.Append(s).Append('\n');

        // the Python and Rust APIs serve the same routes; a project with a Rust stack and no Api stack calls the Rust port
        bool rustOnly = Project.Stacks.Any(s => s.EqualsIgnoreCase("Rust")) && !Project.Stacks.Any(s => s.EqualsIgnoreCase("Api"));
        L("@host = http://localhost:" + (rustOnly ? Project.RustPort : Project.ApiPort));
        L("@" + idVar + " = " + ApiSampleValues.SampleId(Model));   // the key the add request creates: 1, a GUID, or a text key's example
        L();
        L("### All " + plural);
        L("GET {{host}}" + route);
        L("Accept: application/json");
        L();
        L("### One " + words.ToLowerInvariant() + " by its id");
        L("GET {{host}}" + route + "/{{" + idVar + "}}");
        L("Accept: application/json");
        if (Model.HasSearchApiOfAnyKey(Project))
        {
            var search = Model.SearchableColumns;
            string filters = string.Concat(search.Take(2).Select(c => char.ToLowerInvariant(c.Name[0]) + c.Name[1..] + "=&"));
            string sort = search.Count > 0 ? "&sortBy=" + char.ToLowerInvariant(search[0].Name[0]) + search[0].Name[1..] + "&sortDir=asc" : "";
            L();
            L("### Search " + plural + ", a page at a time" + (search.Count > 0 ? " (each text box filters by part of the text)" : ""));
            // a log table also takes the first and last day of the rows to list
            string range = LogTablePlan.For(Model, Project) is not null ? LogTable.FromParameter + "=2026-01-01&" + LogTable.ToParameter + "=2026-01-31&" : "";
            L("GET {{host}}" + route + "/search?" + filters + range + "pageNumber=1&pageSize=20" + sort);
            L("Accept: application/json");
        }
        // a log table is only read: no add, change, remove or copy
        bool readOnly = LogTablePlan.For(Model, Project) is not null;
        if (!readOnly)
        {
        L();
        L("### Add a " + words.ToLowerInvariant());
        L("POST {{host}}" + route);
        L("Content-Type: application/json");
        L();
        L(Body(false));
        L();
        L("### Change a " + words.ToLowerInvariant() + " (the key in the body must be the id)");
        L("PUT {{host}}" + route + "/{{" + idVar + "}}");
        L("Content-Type: application/json");
        L();
        L(Body(true));
        L();
        L("### Remove a " + words.ToLowerInvariant() + " (400 when another row uses it)");
        L("DELETE {{host}}" + route + "/{{" + idVar + "}}");
        if (CloneShape.CanClone(Model, Project))
        {
            L();
            L("### Copy a " + words.ToLowerInvariant() + " into a new row");
            L("POST {{host}}" + route + "/{{" + idVar + "}}/clone");
        }
        }
        if (QueuePlan.For(Model, Project) is not null)
        {
            L();
            L("### How many rows are pending, claimed, done and failed, and the oldest pending one");
            L("GET {{host}}" + route + "/stats");
            L();
            L("### A worker takes the oldest pending row (204 when there is none)");
            L("POST {{host}}" + route + "/claim?worker=worker-1");
            L();
            L("### The worker finished the row it claimed");
            L("POST {{host}}" + route + "/{{" + idVar + "}}/complete");
            L();
            L("### The worker could not do it: one more retry, back to pending until the retries are used, then failed");
            L("POST {{host}}" + route + "/{{" + idVar + "}}/fail");
            L("Content-Type: application/json");
            L();
            L("{ \"error\": \"what went wrong\" }");
            L();
            L("### The failed rows");
            L("GET {{host}}" + route + "/failed");
            L();
            L("### Put a failed row back to pending");
            L("POST {{host}}" + route + "/{{" + idVar + "}}/retry");
        }
        string text = o.ToString();
        if (Project.ApiAuth)
        {
            // every request carries the token that POST /api/auth/login answered (paste it below)
            var withToken = new StringBuilder();
            withToken.Append("@token = paste the token from POST /api/auth/login here\n");
            foreach (string line in text.Split('\n'))
            {
                withToken.Append(line).Append('\n');
                if (line.StartsWith("GET {{host}}") || line.StartsWith("POST {{host}}") || line.StartsWith("PUT {{host}}") || line.StartsWith("DELETE {{host}}"))
                    withToken.Append("Authorization: Bearer {{token}}\n");
            }
            text = withToken.ToString().TrimEnd('\n') + "\n";
        }
        Write(text);
    }
#>
