<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Globalization" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // API_Http_v1.tt
    // Generates: <TableName>.http   (see OutputName in API_Http_v1.tt.config)
    // A request file for one table's API, for Visual Studio, Visual Studio Code (REST Client) and Rider: get all, get one, search, create, update, delete and (where the clone routine exists) clone,
    // against http://localhost:<ApiPort>. The create and update bodies hold one value for every column that cannot be NULL, shaped by the column (a choice from its CHECK list, a number inside its
    // range, an email address for an email column); a nullable column is left out. Change the host and the id at the top; run the requests one by one.
    // Writes for the tables API_Crud writes an API for, with the routes the API templates use. Does not log in: add the Authorization header yourself if the API has authentication.
    // Full notes: Docs/TemplateNotes/API_Http_v1.md
    // ==========================================================================================

    if (!Model.HasCrudApi(Project))
    {
        Error($"API_Http writes requests for the tables API_Crud writes an API for (a single whole-number key, not an enum or a name/active table), and [{Model.SchemaName}].[{Model.TableName}] is not one.");
    }
    else
    {
        string Inv(double value) => value.ToString("R", CultureInfo.InvariantCulture);
        string Json(string s) => "\"" + s.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";

        string singular = Model.TableName;
        string plural = singular.Pluralize();
        string route = "/api/" + plural.ToLowerInvariant();
        var key = Model.PrimaryKeyColumns[0];
        string words = Labels.Words(singular);

        // one example value (as JSON text) for a column
        string Sample(ColumnModel c)
        {
            if (c.IsPrimaryKey)
                return c.IsIdentity ? "0" : "1";
            if (c.IsStringColumn)
            {
                string text = c.HasChoices ? c.Choices![0]
                    : c.Name.Contains("Email", StringComparison.OrdinalIgnoreCase) ? "someone@example.com"
                    : c.Name.Contains("Phone", StringComparison.OrdinalIgnoreCase) || c.Name.Contains("Fax", StringComparison.OrdinalIgnoreCase) ? "555-0100"
                    : c.Name.Contains("Url", StringComparison.OrdinalIgnoreCase) || c.Name.Contains("Website", StringComparison.OrdinalIgnoreCase) ? "https://example.com"
                    : "Sample " + Labels.Words(c.Name).ToLowerInvariant();
                int chars = c.CharacterLength();
                if (chars > 0 && text.Length > chars)
                    text = text[..chars];
                return Json(text);
            }
            if (c.IsIntegerColumn)
                return Project.RangeFor(c) is { } range ? Math.Max(range.Min, Math.Min(1, range.Max)).ToString(CultureInfo.InvariantCulture) : "1";
            switch (c.SqlType)
            {
                case SqlDbType.Decimal or SqlDbType.Money or SqlDbType.SmallMoney or SqlDbType.Float or SqlDbType.Real:
                    double value = 1;
                    if (c.Check is { } check)
                    {
                        if (check.Min is { } min && value <= min)
                            value = check.MinStrict ? min + 1 : min;
                        if (check.Max is { } max && value > max)
                            value = max;
                    }
                    return Inv(value);
                case SqlDbType.Bit: return "false";
                case SqlDbType.Date or SqlDbType.DateTime or SqlDbType.DateTime2 or SqlDbType.SmallDateTime: return "\"2026-01-15T00:00:00\"";
                case SqlDbType.DateTimeOffset: return "\"2026-01-15T00:00:00+00:00\"";
                case SqlDbType.Time: return "\"08:00:00\"";
                case SqlDbType.UniqueIdentifier: return "\"00000000-0000-0000-0000-000000000001\"";
                case SqlDbType.Binary or SqlDbType.VarBinary or SqlDbType.Image or SqlDbType.Timestamp: return "\"AA==\"";
                default: return "null";
            }
        }

        // the request body: every column that cannot be NULL (and is not computed), by its JSON name; the key from {{id}} for an update
        string Body(bool update)
        {
            var fields = Model.Columns.OrderBy(c => c.OrdinalPosition).Where(c => !c.IsComputed && (!c.IsNullable || c.IsPrimaryKey)).ToList();
            var lines = fields.Select(c => "  " + Json(JsonNames.Camel(c.Name)) + ": " + (update && c.IsPrimaryKey ? "{{id}}" : Sample(c)));
            return "{\n" + string.Join(",\n", lines) + "\n}";
        }

        var o = new StringBuilder();
        void L(string s = "") => o.Append(s).Append('\n');

        L("@host = http://localhost:" + Project.ApiPort);
        L("@id = 1");
        L();
        L("### All " + plural);
        L("GET {{host}}" + route);
        L("Accept: application/json");
        L();
        L("### One " + words.ToLowerInvariant() + " by its id");
        L("GET {{host}}" + route + "/{{id}}");
        L("Accept: application/json");
        if (Model.HasSearchApi(Project))
        {
            var search = Model.SearchableColumns;
            string filters = string.Concat(search.Take(2).Select(c => char.ToLowerInvariant(c.Name[0]) + c.Name[1..] + "=&"));
            string sort = search.Count > 0 ? "&sortBy=" + char.ToLowerInvariant(search[0].Name[0]) + search[0].Name[1..] + "&sortDir=asc" : "";
            L();
            L("### Search " + plural + ", a page at a time" + (search.Count > 0 ? " (each text box filters by part of the text)" : ""));
            L("GET {{host}}" + route + "/search?" + filters + "pageNumber=1&pageSize=20" + sort);
            L("Accept: application/json");
        }
        L();
        L("### Add a " + words.ToLowerInvariant());
        L("POST {{host}}" + route);
        L("Content-Type: application/json");
        L();
        L(Body(false));
        L();
        L("### Change a " + words.ToLowerInvariant() + " (the key in the body must be the id)");
        L("PUT {{host}}" + route + "/{{id}}");
        L("Content-Type: application/json");
        L();
        L(Body(true));
        L();
        L("### Remove a " + words.ToLowerInvariant() + " (400 when another row uses it)");
        L("DELETE {{host}}" + route + "/{{id}}");
        if (CloneShape.CanClone(Model, Project))
        {
            L();
            L("### Copy a " + words.ToLowerInvariant() + " into a new row");
            L("POST {{host}}" + route + "/{{id}}/clone");
        }
        Write(o.ToString());
    }
#>
