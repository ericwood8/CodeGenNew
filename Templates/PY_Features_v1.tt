<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PY_Features_v1.tt
    // Generates: app/routes/features.py   (whole-database; the path is written by the template)
    // The Python counterpart of API_Features (feature flags in two tables, FeatureTables): all_flags and is_enabled for the API's own code, GET /api/features and PUT /api/features/{name}. The rules and sentences
    // are FeatureFlagTables in Core, the text is PythonFeatureWriter. Needs ApiAuth=true. Full notes: Docs/TemplateNotes/API_Features_v1.md
    // ==========================================================================================
    var (plan, problem) = FeatureFlagTables.Resolve(Database, Project);
    if (problem is not null)
        Error(problem);
    else if (PythonFeatureWriter.PlanOf(Database, Project) is not null)
        Write("@@@FILE app/routes/features.py@@@\n" + PythonFeatureWriter.File(Database, Project));
#>
