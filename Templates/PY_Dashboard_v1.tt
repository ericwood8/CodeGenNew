<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PY_Dashboard_v1.tt
    // Generates: app/routes/dashboard.py   (whole-database; the output folder is the Python API's folder; written only for a project with Dashboard=true)
    // GET /api/dashboard answers every widget of the dashboard page in one call, and GET /api/dashboard?table=Customer the cards of that table's strip: the JSON of DashboardWire, the widgets
    // DashboardPlan chose and the one fixed statement of each, kept for a minute. The same choice and the same statements as CS_Dashboard and RS_Dashboard, so every stack shows the same numbers.
    // PY_Mod lists the router with the tables' routers. With ApiAuth and ReadRoles or TableReadRoles the widgets of a table the caller's role may not read are left out of the caller's copy.
    // Full notes: Docs/TemplateNotes/PY_Dashboard_v1.md
    // ==========================================================================================

    var plan = DashboardPlan.Build(Database, Project);
    foreach (string problem in plan.Problems)
        Error(problem);

    var strip = Project.DashboardStrip ? plan.StripTables.SelectMany(plan.StripOf).Select(w => w.Id).ToHashSet() : new HashSet<string>();
    var onDashboard = plan.Widgets.Select(w => w.Id).ToHashSet();
    var widgets = plan.Widgets.Concat(plan.Candidates.Where(w => strip.Contains(w.Id) && !onDashboard.Contains(w.Id))).ToList();
    var screenTables = Database.ScreenTables(Project).Select(t => t.TableName).ToHashSet(StringComparer.OrdinalIgnoreCase);

    // ReadRoles with ApiAuth: the widgets of a table whose reads are limited go only to those roles
    var limited = Database.Tables.Select(t => (t.TableName, Roles: WriteRolePlan.ReadFor(Project, t))).Where(t => t.Roles.Count > 0).ToList();

    string Bool(bool value) => value ? "True" : "False";
    // text() reads :name as a bind parameter; a colon in a statement is written \: so it reaches the database as it is
    string Sql(string text) => PythonNames.Str(text.Replace(":", "\\:"));
    string Roles(IReadOnlyList<string> roles) => "(" + string.Join(", ", roles.Select(PythonNames.Str)) + (roles.Count == 1 ? "," : "") + ")";

    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');

    Line("@@@FILE app/routes/dashboard.py@@@");
    Line("\"\"\"The dashboard: GET /api/dashboard answers every widget of the dashboard page, GET /api/dashboard?table=Customer the cards of that table's strip. Generated by PY_Dashboard.\"\"\"");
    Line("import threading");
    Line("import time");
    Line("from dataclasses import dataclass");
    Line("from typing import Any");
    Line();
    Line("from fastapi import APIRouter, Depends, Query");
    Line("from sqlalchemy import text");
    Line("from sqlalchemy.orm import Session");
    Line();
    if (limited.Count > 0)
        Line("from app.auth import CurrentUser, require_user");
    Line("from app.db import get_session");
    Line();
    Line("router = APIRouter()");
    Line();
    Line();
    Line("@dataclass(frozen=True)");
    Line("class Definition:");
    Line("    id: str");
    Line("    kind: str");
    Line("    title: str");
    Line("    table: str");
    Line("    route: str");
    Line("    is_money: bool");
    Line("    is_rows: bool");
    Line("    on_dashboard: bool");
    Line("    on_strip: bool");
    Line("    sql: str");
    Line();
    Line();
    Line("# The widgets DashboardPlan chose from the schema's own facts, each with its one fixed statement (no parameter: a table named in the query string is only compared with this list).");
    Line("# Kind is " + DashboardWire.KindSentence + "; a recent widget fills rows, every other one points.");
    Line("DEFINITIONS = [");
    foreach (var w in widgets)
    {
        string route = screenTables.Contains(w.Table) ? ScreenNames.Route(w.Table) : "";
        Line($"    Definition({PythonNames.Str(w.Id)}, {PythonNames.Str(w.KindName)}, {PythonNames.Str(w.Title)}, {PythonNames.Str(w.Table)}, {PythonNames.Str(route)}, {Bool(w.IsMoney)}, {Bool(w.IsRows)}, {Bool(onDashboard.Contains(w.Id))}, {Bool(strip.Contains(w.Id))},");
        Line($"               {Sql(w.Sql)}),");
    }
    Line("]");
    Line();
    Line("CACHE_FOR = 60.0");
    Line("_cache: dict[str, tuple[float, list[dict[str, Any]]]] = {}");
    Line("_lock = threading.Lock()");
    if (limited.Count > 0)
    {
        Line();
        Line();
        Line("# The roles that may read a table's rows (ReadRoles, TableReadRoles); a table not listed is open to every signed-in person.");
        Line("READ_RULES = {");
        foreach (var rule in limited)
            Line($"    {PythonNames.Str(rule.TableName.ToLowerInvariant())}: {Roles(rule.Roles)},");
        Line("}");
        Line();
        Line();
        Line("def may_read(user: CurrentUser, table: str) -> bool:");
        Line("    roles = READ_RULES.get(table.lower())");
        Line("    return roles is None or user.role in roles");
    }
    Line();
    Line();
    Line("@router.get(\"/api/dashboard\")");
    if (limited.Count > 0)
    {
        Line("def dashboard(table: str | None = Query(None), session: Session = Depends(get_session), user: CurrentUser = Depends(require_user)):");
        Line("    # the answer is cached for every caller, so the copy sent loses the widgets this caller may not read");
        Line("    widgets = [w for w in load(session, table) if may_read(user, w[\"table\"])]");
        Line("    return {\"widgets\": widgets}");
    }
    else
    {
        Line("def dashboard(table: str | None = Query(None), session: Session = Depends(get_session)):");
        Line("    return {\"widgets\": load(session, table)}");
    }
    Line();
    Line();
    Line("def number(value: Any) -> float | None:");
    Line("    return None if value is None else float(value)");
    Line();
    Line();
    Line("def label(value: Any) -> str | None:");
    Line("    return None if value is None else str(value)");
    Line();
    Line();
    Line("def load(session: Session, table: str | None) -> list[dict[str, Any]]:");
    Line("    \"\"\"The dashboard page's widgets, or with a table the cards of that table's strip (empty for a table that has none). The answer is kept for a minute per table.\"\"\"");
    Line("    if table is None:");
    Line("        chosen = [d for d in DEFINITIONS if d.on_dashboard]");
    Line("    else:");
    Line("        chosen = [d for d in DEFINITIONS if d.on_strip and d.table.lower() == table.lower()]");
    Line("        # a table that has no strip is not cached, so a caller cannot grow the cache with names of its own");
    Line("        if not chosen:");
    Line("            return []");
    Line();
    Line("    key = \"\" if table is None else \"table:\" + table.lower()");
    Line("    now = time.monotonic()");
    Line("    with _lock:");
    Line("        hit = _cache.get(key)");
    Line("    if hit is not None and hit[0] > now:");
    Line("        return hit[1]");
    Line();
    Line("    widgets: list[dict[str, Any]] = []");
    Line("    for d in chosen:");
    Line("        found = session.execute(text(d.sql)).all()");
    Line("        widgets.append(");
    Line("            {");
    Line("                \"id\": d.id,");
    Line("                \"kind\": d.kind,");
    Line("                \"title\": d.title,");
    Line("                \"table\": d.table,");
    Line("                \"route\": d.route,");
    Line("                \"isMoney\": d.is_money,");
    Line("                \"points\": [] if d.is_rows else [{\"label\": label(r[0]), \"value\": number(r[1])} for r in found],");
    Line("                \"rows\": [{\"label\": label(r[0]), \"detail\": label(r[1])} for r in found] if d.is_rows else [],");
    Line("            }");
    Line("        )");
    Line();
    Line("    with _lock:");
    Line("        _cache[key] = (now + CACHE_FOR, widgets)");
    Line("    return widgets");
    Write(sb.ToString());
#>
