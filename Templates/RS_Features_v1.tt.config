# Restriction checkboxes for RS_Features_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# The template writes its own path (src/features.rs) with an @@@FILE marker.
OutputName=src/features.rs
# Whole-project generation (codegen generate): written only for a project with FeatureTables and ApiAuth.
Stacks=Rust
InPlan=false
