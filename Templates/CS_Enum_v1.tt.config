# Restriction checkboxes for CS_Enum_v1.tt (see Docs/specs.md section 5.3).
# The enum member values are the table's primary key, so one is required (the template further insists on a single integer key).
RequiresPrimaryKey=true
TableOnly=true
# The members ARE the table's rows, so the rows must be read.
NeedsRowData=true
# Name the file like the enum: SY_Role -> SY_Role.cs
OutputName={Table}.cs
