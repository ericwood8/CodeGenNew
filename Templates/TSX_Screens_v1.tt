<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (folders).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string pagesFolder = Project.PagesFolder;   // where TSX_Page / TSX_DetailMasterPage write the pages, relative to the file this template writes
    string componentsFolder = Project.ComponentsFolder;   // where TSX_Dashboard writes DashboardStrip
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    // The screens and their order come from the project's Screens setting, the master-detail ones from DetailMasterTables (see DatabaseModel).
    // ==========================================================================================

    // ==========================================================================================
    // TSX_Screens_v1.tt
    // Generates: screens.tsx   (see OutputName in TSX_Screens_v1.tt.config; point the output folder at the React app's src folder)
    // The screens a React shell shows: one entry per table (route, menu text, page element), in menu order from the project's Screens setting, which
    // App.tsx imports as { screens }. A master-detail screen whose child table has no screen gets a WARNING comment at the top.
    // With OData=true each table served as OData also gets the entry of its OData page (TSX_ODataPage) after the REST ones, with the route <table>-odata and the label "<Table> (OData)", loaded when its route is
    // first opened (React.lazy, a separate chunk each). ODataScreens=Replace puts the OData page in the REST page's place instead (same route, label and menu place).
    // With Auth=true and ReadRoles / TableReadRoles, the entries of the tables whose reads are limited carry roles: ['Administrator', 'Hr'] (see the Shell, which hides them from the menu).
    // Full notes: Docs/TemplateNotes/TSX_Screens_v1.md

    var screens = Database.ScreenTables(Project, "React");
    foreach (string name in Database.UnknownScreens(Project))
        Error($"The Screens setting lists '{name}', which is not a table of the database with a single-column primary key.");
    if (screens.Count == 0)
        Error("TSX_Screens found no table to list: no table has an API and a search endpoint, and the project's Screens setting is empty.");
    var missingChildren = DatabaseModel.ChildrenWithoutScreen(screens, Project);
    var odataScreens = ODataPlan.ReactScreenTables(Database, Project);
    // Auth=true with ReadRoles: a screen of a table whose reads are limited to some roles carries them (the shell hides it from the menu and the route sends another role to the start page)
    string RolesOf(TableModel t) => ScreenMenu.RolesOf(Project, t) is { Count: > 0 } roles ? ", roles: [" + WriteRolePlan.Literal(roles, (char)39) + "]" : "";

    string PageName(TableModel t) => ReactNames.PageName(t, Project);
    var junctions = JunctionPlan.Tables(Database, Project);   // a page for each many-to-many junction table, after the screens
    string JunctionRoles(TableModel t) => JunctionPlan.Roles(Project, t) is { Count: > 0 } roles ? ", roles: [" + WriteRolePlan.Literal(roles, (char)39) + "]" : "";

    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');

    // With Dashboard=true the dashboard is the first screen; with DashboardStrip=true each table that has cards shows them above its page.
    var stripTables = Project.DashboardStrip ? DashboardPlan.Build(Database, Project).StripTables.Where(name => screens.Any(t => t.TableName.EqualsIgnoreCase(name))).ToHashSet(StringComparer.OrdinalIgnoreCase) : new HashSet<string>();
    string Element(TableModel t) => stripTables.Contains(t.TableName) ? $"<><DashboardStrip table=\"{t.TableName}\" /><{PageName(t)} /></>" : $"<{PageName(t)} />";
    // ODataScreens=Replace: a table served as OData has its OData page at the REST page's route, label and menu place (a table hosted with dashboard cards keeps its REST page)
    var replaced = Project.ODataReplacesScreens ? odataScreens.Where(t => !stripTables.Contains(t.TableName)).ToList() : new List<TableModel>();
    bool Replaced(TableModel t) => replaced.Any(r => r.TableName.EqualsIgnoreCase(t.TableName));
    string ODataElement(TableModel t) => $"<Suspense fallback={{null}}><{ReactNames.ODataPageName(t, Project)} /></Suspense>";
    if (odataScreens.Count > 0)
        Line("import { Suspense, lazy } from 'react';");
    if (Project.Dashboard)
        Line($"import {{ DashboardPage }} from './{pagesFolder}/DashboardPage';");
    if (stripTables.Count > 0)
        Line($"import {{ DashboardStrip }} from './{componentsFolder}/DashboardStrip';");
    foreach (var t in screens.Where(t => !Replaced(t)))
        Line($"import {{ {PageName(t)} }} from './{pagesFolder}/{PageName(t)}';");
    foreach (var t in junctions)
        Line($"import {{ {JunctionPlan.ReactPage(t.TableName)} }} from './{pagesFolder}/{JunctionPlan.ReactPage(t.TableName)}';");
    Line();
    // the OData pages are loaded when their route is first opened (a separate chunk each), so they do not add to the first download
    foreach (var t in odataScreens)
    {
        string page = ReactNames.ODataPageName(t, Project);
        Line($"const {page} = lazy(() => import('./{pagesFolder}/{page}').then((m) => ({{ default: m.{page} }})));");
    }
    if (odataScreens.Count > 0)
        Line();
    Line("// Generated by TSX_Screens: one entry per screen, in menu order. Change the list with the Screens project setting and regenerate; App.tsx stays as it is.");
    if (missingChildren.Count > 0)
        Line("// WARNING: these child tables are linked from a master-detail screen but have no screen of their own: " + string.Join(", ", missingChildren) + ".");
    Line("export const screens = [");
    if (Project.Dashboard)
        Line("  { path: 'dashboard', label: 'Dashboard', element: <DashboardPage /> },");
    foreach (var t in screens)
        Line($"  {{ path: '{ScreenNames.Route(t.TableName)}', label: '{ScreenNames.Label(t.TableName)}', element: {(Replaced(t) ? ODataElement(t) : Element(t))}{RolesOf(t)} }},");
    foreach (var t in odataScreens.Where(t => !Replaced(t)))
        Line($"  {{ path: '{AngularNames.ODataRoute(t.TableName)}', label: '{AngularNames.ODataLabel(t.TableName)}', element: {ODataElement(t)}{RolesOf(t)} }},");
    foreach (var t in junctions)
        Line($"  {{ path: '{JunctionPlan.Route(t.TableName)}', label: '{JunctionPlan.Label(t.TableName)}', element: <{JunctionPlan.ReactPage(t.TableName)} />{JunctionRoles(t)} }},");
    Line("];");
    Write(sb.ToString());
#>
