# TSX_Page_v1.tt run as its OData form (see Base and Variant in TemplateConfig). Opt in with OData=true and a React stack; written only for the tables the project serves as OData.
Base=TSX_Page_v1.tt
Variant=OData
RequiresPrimaryKey=true
TableOnly=true
RequiresSingleKey=true
NeedsReferencedDisplayColumns=true
Stacks=React
PlanTables=ScreenForm
OutputFolder=src
InPlan=false
