# Restriction checkboxes for BLZ_Page_v1.tt (see Docs/Reference.md section 3).
# The screen edits rows by their primary key, taken as {id:int}, {id:guid} or {id} (text).
RequiresPrimaryKey=true
TableOnly=true
RequiredPrimaryKeyShape=SingleIntGuidOrText
# A name/active table's real API is hand-maintained and has no plain getAll().
RequiresNotNameActiveTable=true
# The drop-downs for foreign keys show the parent table's display column, so ask for it.
NeedsReferencedDisplayColumns=true
# No OutputName: the template writes its own path (Pages/<Table>Page.razor) with an @@@FILE marker.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Blazor
PlanTables=Screen
