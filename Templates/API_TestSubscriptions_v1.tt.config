# Restriction checkboxes for API_TestSubscriptions_v1.tt (see Docs/Reference.md section 3).
# One run for the whole database: the test class of the subscription routes and plan limits.
Scope=Database
# Whole-project generation (codegen generate): added by ApiTests=true when SubscriptionTable is set. The files go to the test project, not the API.
Stacks=Api
OutputRoot=ApiTests
InPlan=false
