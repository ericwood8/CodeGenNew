# Restriction checkboxes for UNO_EssentialAuth_v1.tt (see Docs/Reference.md section 3).
# The sign-in of the Uno app: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`; Auth=true ticks it.
Scope=None
Stacks=Uno
EssentialsGroup=Auth
EssentialsDefault=false
Description=Services/AuthSession.cs and Views/LoginPage: the session, the sign-in page and the token handler of the Uno app (Auth=true); needs a Jwt API (ApiAuth=true)
