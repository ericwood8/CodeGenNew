# Restriction checkboxes for BLZ_Screens_v1.tt (see Docs/Reference.md section 3).
# One run for the whole database: the menu offers it on the database, the CLI runs it without -t.
DatabaseOnly=true
RequiresPrimaryKey=false
TableOnly=false
# The template writes its own paths (Layout/NavMenu.razor, Services/ApiClients.cs) with @@@FILE markers.
OutputName=Layout/NavMenu.razor
# Whole-project generation (codegen generate): the stacks that include this template.
Stacks=Blazor
