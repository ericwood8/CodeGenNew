# Restriction checkboxes for API_Test_v1.tt (see Docs/Reference.md section 3).
# Integration tests for the tables API_Crud writes an API for (a single whole-number key).
RequiresPrimaryKey=true
TableOnly=true
# Name the file like the table: Customer -> CustomerApiTests.cs
OutputName={Table}ApiTests.cs
# Whole-project generation (codegen generate): for a project that sets ApiTests=true (or names the template in PlanAlso). The files go to the test project, not the API.
Stacks=Api
PlanTables=Api
OutputRoot=ApiTests
InPlan=false
