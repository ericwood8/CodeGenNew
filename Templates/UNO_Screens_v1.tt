<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // UNO_Screens_v1.tt
    // Generates: MainPage.Screens.cs and Services/ApiClients.cs   (the paths are written by the template; point the output folder at the Uno app's folder)
    // The two lists an Uno shell takes from the database: the menu and the switch that shows a screen (one entry per screen, in the order of the project's Screens setting; the other half of
    // the partial MainPage, whose XAML and hand-written part UNO_EssentialApp writes), and ApiClients, one API client per table over the app's one HttpClient. The pages themselves are
    // UNO_MasterScreen's and UNO_DetailScreen's.
    // Full notes: Docs/TemplateNotes/UNO_Screens_v1.md
    // ==========================================================================================
    string viewNamespace = Project.ViewNamespace ?? (Project.ProjectName is not null ? UnoNames.Namespace(Project) + ".Views" : "MyApp.Views");

    var screens = Database.ScreenTables(Project, "Uno");
    foreach (string name in Database.UnknownScreens(Project))
        Error($"The Screens setting lists '{name}', which is not a table of the database with a single-column primary key.");
    if (screens.Count == 0)
        Error("UNO_Screens found no table to list: no table has an API and a search endpoint, and the project's Screens setting is empty.");
    var clients = Database.CrudApiTables(Project).Where(t => UnoNames.HasClient(t, Project)).ToList();
    var odataScreens = ODataPlan.UnoScreenTables(Database, Project);   // the tables served as OData that have an Uno screen: each also gets an OData page (UNO_ODataPage)
    var odataClients = Project.OData ? ODataPlan.For(Database, Project).Tables.Where(t => UnoNames.HasClient(t, Project)).ToList() : new List<TableModel>();
    bool dashboard = Project.Dashboard;   // the dashboard is the first screen (UNO_Dashboard writes the page and its client)
    // the menu in order (the dashboard, the screens, the OData pages) and the tag each entry is selected by
    var menu = ScreenMenu.For(Project, screens, odataScreens)
        .Select(m => (Tag: m.Kind switch { ScreenMenuKind.Dashboard => "Dashboard", ScreenMenuKind.Screen => m.Table!.TableName, _ => m.Table!.TableName + "OData" }, m.Label, m.Roles))
        .ToList();
    foreach (string table in screens.Select(t => t.TableName).Where(n => !clients.Any(c => c.TableName.EqualsIgnoreCase(n))))
        Error($"UNO_Screens lists {table}, which has no API client (see UNO_Client): a screen needs the table's own CRUD API.");

    var o = new StringBuilder();
    void L(string s = "") => o.Append(s).Append('\n');

    L("@@@FILE MainPage.Screens.cs@@@");
    L($"using {viewNamespace};");
    L("using Microsoft.UI.Xaml.Controls;");
    L();
    L($"namespace {UnoNames.Namespace(Project)};");
    L();
    L("// Generated by UNO_Screens: the screens in menu order. Change the list with the Screens project setting and regenerate.");
    L("public sealed partial class MainPage");
    L("{");
    if (Project.Auth)
    {
        // the screens and the roles that may read each (none listed: any signed-in person); the menu holds only the ones the signed-in role may read
        L("    private static readonly (string Tag, string Label, string[]? Roles)[] Screens =");
        L("    [");
        foreach (var e in menu)
            L($"        (\"{e.Tag}\", \"{e.Label}\", {(e.Roles.Count == 0 ? "null" : "[" + WriteRolePlan.Literal(e.Roles) + "]")}),");
        L("    ];");
        L();
        L("    // Fills the menu with the screens the signed-in role may read and returns the first of them, or null when there is none.");
        L("    private string? AddScreens()");
        L("    {");
        L("        NavView.MenuItems.Clear();");
        L("        string? first = null;");
        L("        foreach (var (tag, label, roles) in Screens)");
        L("        {");
        L("            if (roles is not null && !_session.HasRole(roles))");
        L("                continue;");
        L("            NavView.MenuItems.Add(new NavigationViewItem { Content = label, Tag = tag });");
        L("            first ??= tag;");
        L("        }");
        L("        return first;");
        L("    }");
    }
    else
    {
        L($"    private const string FirstScreen = \"{menu[0].Tag}\";");
        L();
        L("    private void AddScreens()");
        L("    {");
        foreach (var e in menu)
            L($"        NavView.MenuItems.Add(new NavigationViewItem {{ Content = \"{e.Label}\", Tag = \"{e.Tag}\" }});");
        L("    }");
    }
    L();
    if (dashboard)
    {
        L("    // Selecting the menu entry shows its page, so a widget's link goes through the menu.");
        L("    private void GoTo(string tag)");
        L("    {");
        L("        var item = NavView.MenuItems.OfType<NavigationViewItem>().FirstOrDefault(i => (string?)i.Tag == tag);");
        L("        if (item is not null)");
        L("            NavView.SelectedItem = item;");
        L("    }");
        L();
    }
    L("    private void ShowPage(string tag)");
    L("    {");
    L("        MainContent.Content = tag switch");
    L("        {");
    if (dashboard)
        L("            \"Dashboard\" => new DashboardPage(_api.Dashboard, GoTo),");
    foreach (var t in screens)
        L(SingleRowPlan.Applies(t, Project, "Uno")
            ? $"            \"{t.TableName}\" => new {t.TableName}Page(_api),"   // the table's one row as a form (UNO_SingleRowScreen)
            : Project.ODataReplacesScreens && odataScreens.Any(o => o.TableName == t.TableName)
                ? $"            \"{t.TableName}\" => new {t.TableName}ODataListPage(_api),"   // ODataScreens=Replace: the OData page takes the REST page's place
                : $"            \"{t.TableName}\" => new {t.TableName}ListPage(_api),");
    if (!Project.ODataReplacesScreens)
        foreach (var t in odataScreens)
            L($"            \"{t.TableName}OData\" => new {t.TableName}ODataListPage(_api),");
    L("            _ => MainContent.Content");
    L("        };");
    L("    }");
    L("}");
    L("@@@FILE Services/ApiClients.cs@@@");
    L($"namespace {UnoNames.ServicesNamespace(Project)};");
    L();
    L("// Generated by UNO_Screens: every table's API client over the one HttpClient, made when first asked for.");
    if (Project.Auth)
    {
        L("public sealed class ApiClients(HttpClient http, AuthSession session)");
        L("{");
        L("    /// <summary> The sign-in the screens ask which buttons the role may use. </summary>");
        L("    public AuthSession Session => session;");
        L();
    }
    else
    {
        L("public sealed class ApiClients(HttpClient http)");
        L("{");
    }
    if (dashboard)
    {
        L("    private DashboardClient? _dashboard;");
        L("    public DashboardClient Dashboard => _dashboard ??= new(http);");
    }
    // the junction tables of the database: the client of each one's API_Junction routes (UNO_JunctionEditor writes the class)
    foreach (var t in Database.Tables.Where(t => t.IsJunctionTable).OrderBy(t => t.TableName, StringComparer.OrdinalIgnoreCase))
    {
        L($"    private {t.TableName}JunctionClient? _{TemplateHelpers.LowerFirst(t.TableName)}Junction;");
        L($"    public {t.TableName}JunctionClient {t.TableName}Junction => _{TemplateHelpers.LowerFirst(t.TableName)}Junction ??= new(http);");
    }
    foreach (var t in odataClients)
    {
        string type = BlazorNames.TypeName(t.TableName);
        L($"    private {BlazorNames.ODataClientName(t.TableName)}? _{TemplateHelpers.LowerFirst(type)}OData;");
        L($"    public {BlazorNames.ODataClientName(t.TableName)} {UnoNames.ClientProperty(t.TableName)}OData => _{TemplateHelpers.LowerFirst(type)}OData ??= new(http);");
    }
    foreach (var t in clients)
    {
        string type = BlazorNames.TypeName(t.TableName);
        string field = "_" + TemplateHelpers.LowerFirst(type);
        L($"    private {type}Client? {field};");
        L($"    public {type}Client {UnoNames.ClientProperty(t.TableName)} => {field} ??= new(http);");
    }
    L("}");
    Write(o.ToString());
#>
