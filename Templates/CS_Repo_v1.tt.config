# Restriction checkboxes for CS_Repo_v1.tt (see Docs/Reference.md section 3).
# The repository is keyed by the primary key (GenericRepo/NameActiveRepo look rows up by an int id), so one is required.
RequiresPrimaryKey=true
TableOnly=true
# Name the file like the class: Holiday -> HolidayRepo.cs
OutputName={Table}Repo.cs
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Api,WinUI3
PlanTables=Entity
OutputFolder=Repositories
