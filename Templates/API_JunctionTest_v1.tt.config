# Restriction checkboxes for API_JunctionTest_v1.tt (see Docs/Reference.md section 3).
Requires=PrimaryKey,JunctionTable
# Only offered for a many-to-many junction/bridge table (TableModel.IsJunctionTable).
# The list shows the target table's display columns, so they must be looked up.
NeedsReferencedDisplayColumns=true
# Name the file like the table: CustomerTag -> CustomerTagJunctionApiTests.cs
OutputName={Table}JunctionApiTests.cs
# Whole-project generation (codegen generate): for a project that sets ApiTests=true (or names the template in PlanAlso). The files go to the test project, not the API.
Stacks=Api
PlanTables=Junction
OutputRoot=ApiTests
InPlan=false
