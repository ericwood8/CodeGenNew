# Restriction checkboxes for SP_AuditTable_v1.tt (see Docs/Reference.md section 3).
# A trigger script in the table's own database, so every database is allowed; a table with no primary key can be audited too (the history rows carry every column).
RequiresPrimaryKey=false
TableOnly=true
# Name the file like the table: Customer -> Customer_Audit.sql
OutputName={Table}_Audit.sql
# Only a table with audit columns (a creation column and a change column) is offered it.
RequiresAuditTable=true
# Whole-project generation (codegen generate): the tables with audit columns, when the project's PlanAlso setting names the template.
Stacks=Api,WinUI3
PlanTables=Audit
OutputRoot=Sql
InPlan=false
