# Restriction checkboxes for RS_Approvals_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# The Rust stack reads PostgreSQL, MySQL and SQLite through sqlx; SQL Server is not supported.
Dialects=PostgreSql,MySql,Sqlite
# The template writes its own path (src/routes/approvals.rs) with an @@@FILE marker.
OutputName=src/routes/approvals.rs
# Whole-project generation (codegen generate): written only for a project with RowApprovals (and ApiAuth).
Stacks=Rust
InPlan=false
