# Restriction checkboxes for RS_TestDashboard_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# The Rust stack reads PostgreSQL, MySQL and SQLite through sqlx; SQL Server is not supported.
Dialects=PostgreSql,MySql,Sqlite
# Whole-project generation (codegen generate): added by RustTests=true when the project has a dashboard.
Stacks=Rust
InPlan=false
