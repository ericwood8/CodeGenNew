<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PY_TestTax_v1.tt
    // Generates: tests/conftest.py and tests/test_tax.py   (whole-database; the output folder is the Python API's folder)
    // pytest tests of what PY_Routes writes for TaxLines. conftest.py is the one PY_TestApprovals writes (the application over a scratch database: a temporary copy of the SQLite file, or the URL
    // in <PROJECT>_TEST_CONNECTION for PostgreSQL and MySQL; with none the tests are skipped with the reason). test_tax.py adds categories and lines through the routes and removes them after the test, and
    // plays the cases: the rate is the category's and the tax is worked out from it, the rate is kept when the category's rate changes, a category that does not exist is refused, and with the validity and
    // document parts a category outside its validity is refused and the subtotals of a document add up.
    // The words are TaxWords, as in the other stacks' tests.
    // Written only for a project with PythonTests=true and a line table the tests can fill (TaxTestPlan); not for SQL Server.
    // Run them with pytest from the API's folder (requirements.txt lists pytest and httpx with PythonTests=true).
    // Full notes: Docs/TemplateNotes/API_RowShapes_v1.md
    // ==========================================================================================
    if (PythonTaxTests.Applies(Database, Project))
    {
        if (!PythonRateTests.Applies(Database, Project) && !PythonRateDocumentTests.Applies(Database, Project))
            Write("@@@FILE tests/conftest.py@@@\n" + PythonTaxTests.Conftest(Project, Database.Dialect));
        Write("@@@FILE tests/test_tax.py@@@\n" + PythonTaxTests.File(Database, Project));
    }
#>
