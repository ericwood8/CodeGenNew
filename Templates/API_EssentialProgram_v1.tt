<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // API_EssentialProgram_v1.tt
    // Generates: <ProjectName>.Api.csproj, Program.cs, appsettings.json and GlobalUsings.cs   (no table, no database: an essentials group; the output folder is the API project's own folder)
    // The web API project: the project file with the EF Core provider of the project's DatabaseProvider, Program.cs (the generated context and registration, JSON options that do not follow
    // entity loops, CORS for the front ends the project's Stacks name), appsettings.json (the connection string without a password, the port from ApiPort) and the global usings the generated
    // classes assume. ApiTests=true makes Program public for the test project. ApiProduction=true adds ProductionProfile.cs, a Dockerfile and a .dockerignore, using only what ships in ASP.NET Core (no package is added).
    // Settings: DatabaseProvider, DatabaseServer, DatabaseName, DatabaseUser, ApiPort, ApiProduction, Stacks and the namespaces.
    // ==========================================================================================
    string projectName = Project.ProjectName ?? "MyApp";
    string apiNamespace = Project.ApiNamespace ?? projectName + ".Api.Apis";
    string entityNamespace = Project.EntityNamespace ?? projectName + ".Api.Entities";
    string repoNamespace = Project.RepoNamespace ?? projectName + ".Api.Repositories";
    string contextNamespace = Project.ContextNamespace ?? projectName + ".Api.Data";
    var dialect = Project.DatabaseDialect;
    string providerName = EfProviderInfo.For(dialect).UseMethod;
    string providerPackage = dialect switch
    {
        SqlDialect.PostgreSql => "Npgsql.EntityFrameworkCore.PostgreSQL\" Version=\"10.0.0",
        SqlDialect.MySql => "MySql.EntityFrameworkCore\" Version=\"10.0.9",
        SqlDialect.Sqlite => "Microsoft.EntityFrameworkCore.Sqlite\" Version=\"10.0.12",
        _ => "Microsoft.EntityFrameworkCore.SqlServer\" Version=\"10.0.12"
    };
    string user = Project.DatabaseUser ?? "";
    string connection = dialect switch
    {
        SqlDialect.PostgreSql => $"Host={Project.DatabaseServer};Port=5432;Database={Project.DatabaseName};Username={user}",
        SqlDialect.MySql => $"Server={Project.DatabaseServer};Port=3306;Database={Project.DatabaseName};User ID={user}",
        SqlDialect.Sqlite => $"Data Source={Project.DatabaseName}",
        _ => user.Length > 0
            ? $"Server={Project.DatabaseServer};Database={Project.DatabaseName};User Id={user};TrustServerCertificate=True;"
            : $"Server={Project.DatabaseServer};Database={Project.DatabaseName};Trusted_Connection=True;TrustServerCertificate=True;"
    };
    // the front ends that call this API from another origin
    var stacks = Project.Stacks.Where(s => s.Equals("React", StringComparison.OrdinalIgnoreCase) || s.Equals("Angular", StringComparison.OrdinalIgnoreCase) || s.Equals("Blazor", StringComparison.OrdinalIgnoreCase)).ToList();
    if (stacks.Count == 0) stacks = ["React"];
    string origins = string.Join(", ", stacks.Select(s => $"\"http://localhost:{Project.DevPort(s)}\""));
    var proxied = stacks.Where(s => !s.Equals("Blazor", StringComparison.OrdinalIgnoreCase)).ToList();   // the dev servers that forward /api; a Blazor app calls the API itself
    string frontEnd = string.Join(" / ", proxied.Select(s => s == "Angular" ? "Angular" : "React"));
    string contextName = Project.ContextName ?? "AppContext";
    // the Dockerfile flag, built from parts: a template line may not hold two hyphens in a row (see TemplateDashTests)
    string fromBuild = new string('-', 2) + "from=build";
    string proxyFile = proxied.Count > 0 && proxied[0].Equals("Angular", StringComparison.OrdinalIgnoreCase) ? "frontend/proxy.conf.json" : "frontend/vite.config.ts";
    string corsNote = proxied.Count == 0 ? "The Blazor app calls this API from its own origin, which is allowed below."
        : $"The {frontEnd} dev server proxies /api here (see {proxyFile}), so CORS only matters if the front end is served elsewhere." + (stacks.Count > proxied.Count ? " The Blazor app calls this API directly, so its origin is allowed below." : "");
#>
@@@FILE <#= projectName #>.Api.csproj@@@
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace><#= projectName #>.Api</RootNamespace>
    <!-- The generated entities and API classes carry a few nullable warnings. -->
    <NoWarn>$(NoWarn);CS8618;CS8601;CS8602;CS8603;CS8604;CS8619;CS8625;ASPDEPR002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="<#= providerPackage #>" />
<#
    if (Project.ApiValidation)
    {
#>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
<#
    }
    if (Project.ApiFakers)
    {
#>
    <PackageReference Include="Bogus" Version="35.6.3" />
<#
    }
#>
  </ItemGroup>
<#
    if (Project.ApiDocs)
    {
#>

  <ItemGroup>
    <!-- openapi.yaml (API_OpenApi) is served at /openapi.yaml and by the Swagger UI page at /docs. -->
    <Content Include="openapi.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
<#
    }
#>

</Project>
@@@FILE Program.cs@@@
using System.Text.Json;
using System.Text.Json.Serialization;

<#
    if (Project.ApiValidation)
    {
#>
using FluentValidation;

<#
    }
#>
var builder = WebApplication.CreateBuilder(args);

// The provider (<#= providerName #>) is chosen in the generated <#= Project.ContextName ?? "AppContext" #>.
builder.Services.AddGeneratedDbContext(builder.Configuration);

<#
    if (Project.ApiValidation)
    {
#>
// The validators CS_Validator writes (one per table); the create and update endpoints run them through ValidationFilter and answer 400 with the messages.
builder.Services.AddValidatorsFromAssemblyContaining<Program>();

<#
    }
#>
// Entities point at each other (an invoice at its customer, a customer at its invoices); do not follow the loop when writing JSON.
builder.Services.ConfigureHttpJsonOptions(options =>
{
    options.SerializerOptions.ReferenceHandler = ReferenceHandler.IgnoreCycles;
    options.SerializerOptions.PropertyNamingPolicy = JsonNamingPolicy.CamelCase;
});

// <#= corsNote #>
<#
    if (Project.ApiProduction)
    {
#>
// The origins come from Cors:Origins in appsettings.json (or the Cors__Origins__0 environment variable), so a deployment can name its own.
string[] origins = builder.Configuration.GetSection("Cors:Origins").Get<string[]>() ?? [<#= origins #>];
builder.Services.AddCors(options => options.AddDefaultPolicy(policy =>
    policy.WithOrigins(origins).AllowAnyHeader().AllowAnyMethod()));

builder.AddProductionProfile();

<#
    }
    else
    {
#>
builder.Services.AddCors(options => options.AddDefaultPolicy(policy =>
    policy.WithOrigins(<#= origins #>).AllowAnyHeader().AllowAnyMethod()));

<#
    }
#>
var app = builder.Build();
<#
    if (Project.ApiProduction)
    {
#>
app.UseProductionProfile();
<#
    }
#>
app.UseCors();
<#
    if (Project.ApiProduction)
    {
#>
app.UseRateLimiter();
<#
    }
#>

// ApiRegistration.cs (generated by API_Registration) has one line per table. The Search classes need the <Table>_Search / <Table>_SearchCount routines in the database (the sql folder).
app.RegisterGeneratedApis();
<#
    if (Project.ApiProduction)
    {
#>

// /health/live and /health/ready.
app.MapProductionHealth();
<#
    }
#>
<#
    if (Project.ApiDocs)
    {
#>

// openapi.yaml (API_OpenApi) and a Swagger UI page over it at /docs.
app.MapOpenApiDocs();
<#
    }
#>

app.Run();
<#
    if (Project.ApiTests)
    {
#>

// The test project (ApiTests=true) starts this API in process.
public partial class Program;
<#
    }
#>
@@@FILE appsettings.json@@@
{
  "ConnectionStrings": {
    "DbConnectionString": "<#= connection #>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
<#
    if (Project.ApiProduction)
    {
#>
  "Cors": {
    "Origins": [ <#= origins #> ]
  },
  "RateLimit": {
    "PermitsPerMinute": 100
  },
<#
    }
#>
  "Urls": "http://localhost:<#= Project.ApiPort #>"
}
<#
    if (Project.ApiDocs)
    {
#>
@@@FILE OpenApiDocs.cs@@@
namespace <#= apiNamespace #>;

/// <summary> Serves openapi.yaml (written by API_OpenApi next to the project file) at /openapi.yaml and a Swagger UI page over it at /docs. </summary>
public static class OpenApiDocs
{
    public static void MapOpenApiDocs(this WebApplication app)
    {
        app.MapGet("/openapi.yaml", (IWebHostEnvironment environment) =>
        {
            string path = Path.Combine(AppContext.BaseDirectory, "openapi.yaml");
            if (!File.Exists(path))
                path = Path.Combine(environment.ContentRootPath, "openapi.yaml");
            return File.Exists(path) ? Results.File(path, "application/yaml") : Results.NotFound();
        }).ExcludeFromDescription();

        app.MapGet("/docs", () => Results.Content(Page, "text/html")).ExcludeFromDescription();
    }

    // Swagger UI from a CDN: the page needs a network connection, the document does not.
    private const string Page = """
        <!doctype html>
        <html>
        <head>
          <meta charset="utf-8" />
          <title>API</title>
          <link rel="stylesheet" href="https://unpkg.com/swagger-ui-dist@5/swagger-ui.css" />
        </head>
        <body>
          <div id="swagger"></div>
          <script src="https://unpkg.com/swagger-ui-dist@5/swagger-ui-bundle.js"></script>
          <script>SwaggerUIBundle({ url: '/openapi.yaml', dom_id: '#swagger' });</script>
        </body>
        </html>
        """;
}
<#
    }
    if (Project.ApiValidation)
    {
#>
@@@FILE ValidationFilter.cs@@@
using FluentValidation;

namespace <#= apiNamespace #>;

/// <summary> An endpoint filter that runs the FluentValidation validator of the request body (the validators CS_Validator writes) and answers 400 with the messages when it fails. A body with no validator passes. </summary>
public class ValidationFilter<T> : IEndpointFilter where T : class
{
    public async ValueTask<object?> InvokeAsync(EndpointFilterInvocationContext context, EndpointFilterDelegate next)
    {
        var validator = context.HttpContext.RequestServices.GetService<IValidator<T>>();
        if (validator is null || context.Arguments.OfType<T>().FirstOrDefault() is not { } body)
            return await next(context);

        var result = await validator.ValidateAsync(body, context.HttpContext.RequestAborted);
        return result.IsValid ? await next(context) : Results.ValidationProblem(result.ToDictionary());
    }
}
<#
    }
#>
<#
    if (Project.ApiProduction)
    {
#>
@@@FILE ProductionProfile.cs@@@
using System.Threading.RateLimiting;
using Microsoft.AspNetCore.Diagnostics.HealthChecks;
using Microsoft.AspNetCore.RateLimiting;
using Microsoft.Extensions.Diagnostics.HealthChecks;

namespace <#= apiNamespace #>;

/// <summary> What a deployed API needs beyond the CRUD endpoints, all from ASP.NET Core itself: Problem Details for errors, response compression, security headers, a per-client rate limit, request size and server header limits, and health checks. </summary>
public static class ProductionProfile
{
    public static WebApplicationBuilder AddProductionProfile(this WebApplicationBuilder builder)
    {
        builder.WebHost.ConfigureKestrel(options =>
        {
            options.AddServerHeader = false;
            options.Limits.MaxRequestBodySize = 1_048_576;
        });

        builder.Services.AddProblemDetails();
        builder.Services.AddResponseCompression();

        int permits = builder.Configuration.GetValue("RateLimit:PermitsPerMinute", 100);
        builder.Services.AddRateLimiter(options =>
        {
            options.RejectionStatusCode = StatusCodes.Status429TooManyRequests;
            options.GlobalLimiter = PartitionedRateLimiter.Create<HttpContext, string>(context =>
                context.Request.Path.StartsWithSegments("/health")
                    ? RateLimitPartition.GetNoLimiter("health")
                    : RateLimitPartition.GetFixedWindowLimiter(context.Connection.RemoteIpAddress?.ToString() ?? "unknown", _ => new FixedWindowRateLimiterOptions
                    {
                        PermitLimit = permits,
                        Window = TimeSpan.FromMinutes(1)
                    }));
        });

        builder.Services.AddHealthChecks().AddCheck<DatabaseHealthCheck>("database", tags: ["ready"]);
        return builder;
    }

    public static WebApplication UseProductionProfile(this WebApplication app)
    {
        app.UseExceptionHandler();
        app.UseStatusCodePages();
        app.UseResponseCompression();
        app.Use(async (context, next) =>
        {
            context.Response.Headers.XContentTypeOptions = "nosniff";
            context.Response.Headers.XFrameOptions = "DENY";
            context.Response.Headers["Referrer-Policy"] = "no-referrer";
            await next();
        });
        return app;
    }

    /// <summary> /health/live answers while the process runs; /health/ready also reaches the database. </summary>
    public static WebApplication MapProductionHealth(this WebApplication app)
    {
        app.MapHealthChecks("/health/live", new HealthCheckOptions { Predicate = _ => false }).ExcludeFromDescription();
        app.MapHealthChecks("/health/ready", new HealthCheckOptions { Predicate = check => check.Tags.Contains("ready") }).ExcludeFromDescription();
        return app;
    }
}

/// <summary> Ready when the context can open a connection to the database. </summary>
public class DatabaseHealthCheck(<#= contextName #> context) : IHealthCheck
{
    public async Task<HealthCheckResult> CheckHealthAsync(HealthCheckContext healthContext, CancellationToken cancellationToken = default) =>
        await context.Database.CanConnectAsync(cancellationToken)
            ? HealthCheckResult.Healthy()
            : HealthCheckResult.Unhealthy("The database cannot be reached.");
}
@@@FILE Dockerfile@@@
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY <#= projectName #>.Api.csproj .
RUN dotnet restore
COPY . .
RUN dotnet publish -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY <#= fromBuild #> /app .
ENV Urls=http://+:8080 \
    ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet", "<#= projectName #>.Api.dll"]
@@@FILE .dockerignore@@@
bin/
obj/
.vs/
.git/
*.user
Dockerfile
.dockerignore
<#
    }
#>
