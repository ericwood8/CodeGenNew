<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // API_EssentialProgram_v1.tt
    // Generates: <ProjectName>.Api.csproj, Program.cs, appsettings.json and GlobalUsings.cs   (no table, no database: an essentials group; the output folder is the API project's own folder)
    // The web API project: the project file with the EF Core provider of the project's DatabaseProvider, Program.cs (the generated context and registration, JSON options that do not follow
    // entity loops, CORS for the front ends the project's Stacks name), appsettings.json (the connection string without a password, the port from ApiPort) and the global usings the generated
    // classes assume. ApiTests=true makes Program public for the test project. ApiProduction=true adds ProductionProfile.cs, a Dockerfile and a .dockerignore, using only what ships in ASP.NET Core (no package is added).
    // ApiTelemetry=true adds Telemetry.cs (OpenTelemetry traces, metrics and logs) and the OpenTelemetry packages.
    // ApiAuth=true adds the JwtBearer package, builder.AddGeneratedAuth(), the authentication and authorization middleware and the login route (the Jwt group's Auth.cs), and marks the health and document routes AllowAnonymous.
    // Settings: DatabaseProvider, DatabaseServer, DatabaseName, DatabaseUser, ApiPort, ApiProduction, ApiTelemetry, ApiAuth, Stacks and the namespaces.
    // ==========================================================================================
    string projectName = Project.ProjectName ?? "MyApp";
    string apiNamespace = Project.ApiNamespace ?? projectName + ".Api.Apis";
    string entityNamespace = Project.EntityNamespace ?? projectName + ".Api.Entities";
    string repoNamespace = Project.RepoNamespace ?? projectName + ".Api.Repositories";
    string contextNamespace = Project.ContextNamespace ?? projectName + ".Api.Data";
    var dialect = Project.DatabaseDialect;
    string providerName = EfProviderInfo.For(dialect).UseMethod;
    string providerPackage = dialect switch
    {
        SqlDialect.PostgreSql => "Npgsql.EntityFrameworkCore.PostgreSQL\" Version=\"10.0.0",
        SqlDialect.MySql => "MySql.EntityFrameworkCore\" Version=\"10.0.9",
        SqlDialect.Sqlite => "Microsoft.EntityFrameworkCore.Sqlite\" Version=\"10.0.12",
        _ => "Microsoft.EntityFrameworkCore.SqlServer\" Version=\"10.0.12"
    };
    string user = Project.DatabaseUser ?? "";
    string connection = dialect switch
    {
        SqlDialect.PostgreSql => $"Host={Project.DatabaseServer};Port=5432;Database={Project.DatabaseName};Username={user}",
        SqlDialect.MySql => $"Server={Project.DatabaseServer};Port=3306;Database={Project.DatabaseName};User ID={user}",
        SqlDialect.Sqlite => $"Data Source={Project.DatabaseName}",
        _ => user.Length > 0
            ? $"Server={Project.DatabaseServer};Database={Project.DatabaseName};User Id={user};TrustServerCertificate=True;"
            : $"Server={Project.DatabaseServer};Database={Project.DatabaseName};Trusted_Connection=True;TrustServerCertificate=True;"
    };
    // the front ends that call this API from another origin
    var stacks = Project.Stacks.Where(s => s.EqualsIgnoreCase("React") || s.EqualsIgnoreCase("Angular") || s.EqualsIgnoreCase("Blazor") || s.EqualsIgnoreCase("Uno")).ToList();
    if (stacks.Count == 0) stacks = ["React"];
    string origins = string.Join(", ", stacks.Select(s => $"\"http://localhost:{Project.DevPort(s)}\""));
    var direct = stacks.Where(s => s.EqualsIgnoreCase("Blazor") || s.EqualsIgnoreCase("Uno")).ToList();   // the apps that call the API themselves (the dev servers of the others forward /api)
    var proxied = stacks.Where(s => !direct.Contains(s)).ToList();
    string callers = string.Join(" and ", direct.Select(s => s.EqualsIgnoreCase("Uno") ? "Uno app" : "Blazor app"));
    string frontEnd = string.Join(" / ", proxied.Select(s => s == "Angular" ? "Angular" : "React"));
    string contextName = Project.ContextName ?? "AppContext";
    // with ApiAuth the fallback policy asks for a token everywhere, so the documents and health checks say they are open
    string anonymous = Project.ApiAuth ? ".AllowAnonymous()" : "";
    // the Dockerfile flag, built from parts: a template line may not hold two hyphens in a row (see TemplateDashTests)
    string fromBuild = new string('-', 2) + "from=build";
    string proxyFile = proxied.Count > 0 && proxied[0].EqualsIgnoreCase("Angular") ? "frontend/proxy.conf.json" : "frontend/vite.config.ts";
    // Problems.cs: the numbers the project's database raises for a refused write (ConstraintErrors in Core) as named constants, and how to read the number from the provider's exception
    (string Pattern, string Value, string[] Constants, string[] Arms) errors = dialect switch
    {
        SqlDialect.PostgreSql => ("Npgsql.PostgresException database", "database.SqlState",
        [
            $"private const string UniqueViolation = \"{ConstraintErrors.PostgreSql.UniqueViolation}\";",
            $"private const string ForeignKeyViolation = \"{ConstraintErrors.PostgreSql.ForeignKeyViolation}\";",
            $"private const string StringDataRightTruncation = \"{ConstraintErrors.PostgreSql.StringDataRightTruncation}\";",
            $"private const string NotNullViolation = \"{ConstraintErrors.PostgreSql.NotNullViolation}\";"
        ],
        [
            "UniqueViolation => Constraint.Unique,", "ForeignKeyViolation => Constraint.ForeignKey,", "StringDataRightTruncation => Constraint.TooLong,", "NotNullViolation => Constraint.Required,"
        ]),
        SqlDialect.MySql => ("MySql.Data.MySqlClient.MySqlException database", "database.Number",
        [
            $"private const int DuplicateEntry = {ConstraintErrors.MySql.DuplicateEntry};",
            $"private const int RowIsReferenced = {ConstraintErrors.MySql.RowIsReferenced};",
            $"private const int NoReferencedRow = {ConstraintErrors.MySql.NoReferencedRow};",
            $"private const int DataTooLong = {ConstraintErrors.MySql.DataTooLong};",
            $"private const int ColumnCannotBeNull = {ConstraintErrors.MySql.ColumnCannotBeNull};"
        ],
        [
            "DuplicateEntry => Constraint.Unique,", "RowIsReferenced or NoReferencedRow => Constraint.ForeignKey,", "DataTooLong => Constraint.TooLong,", "ColumnCannotBeNull => Constraint.Required,"
        ]),
        SqlDialect.Sqlite => ("Microsoft.Data.Sqlite.SqliteException database", "database.SqliteExtendedErrorCode",
        [
            $"private const int UniqueConstraint = {ConstraintErrors.Sqlite.UniqueConstraint};",
            $"private const int PrimaryKeyConstraint = {ConstraintErrors.Sqlite.PrimaryKeyConstraint};",
            $"private const int ForeignKeyConstraint = {ConstraintErrors.Sqlite.ForeignKeyConstraint};",
            $"private const int NotNullConstraint = {ConstraintErrors.Sqlite.NotNullConstraint};"
        ],
        [
            "UniqueConstraint or PrimaryKeyConstraint => Constraint.Unique,", "ForeignKeyConstraint => Constraint.ForeignKey,", "NotNullConstraint => Constraint.Required,"
        ]),
        _ => ("Microsoft.Data.SqlClient.SqlException database", "database.Number",
        [
            $"private const int UniqueConstraint = {ConstraintErrors.SqlServer.UniqueConstraint};",
            $"private const int UniqueIndex = {ConstraintErrors.SqlServer.UniqueIndex};",
            $"private const int ForeignKeyViolation = {ConstraintErrors.SqlServer.ForeignKey};",
            $"private const int StringTruncated = {ConstraintErrors.SqlServer.StringTruncated};",
            $"private const int StringTruncatedWithDetail = {ConstraintErrors.SqlServer.StringTruncatedWithDetail};",
            $"private const int NullNotAllowed = {ConstraintErrors.SqlServer.NullNotAllowed};"
        ],
        [
            "UniqueConstraint or UniqueIndex => Constraint.Unique,", "ForeignKeyViolation => Constraint.ForeignKey,", "StringTruncated or StringTruncatedWithDetail => Constraint.TooLong,", "NullNotAllowed => Constraint.Required,"
        ])
    };
    string errorConstants = string.Join("\n", errors.Constants.Select(c => "    " + c));
    string errorArms = string.Join("\n", errors.Arms.Select(a => "            " + a));
    string corsNote = proxied.Count == 0 ? $"The {callers} calls this API from its own origin, which is allowed below."
        : $"The {frontEnd} dev server proxies /api here (see {proxyFile}), so CORS only matters if the front end is served elsewhere." + (stacks.Count > proxied.Count ? $" The {callers} calls this API directly, so its origin is allowed below." : "");
#>
@@@FILE <#= projectName #>.Api.csproj@@@
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace><#= projectName #>.Api</RootNamespace>
    <!-- The generated entities and API classes carry a few nullable warnings. -->
    <NoWarn>$(NoWarn);CS8618;CS8601;CS8602;CS8603;CS8604;CS8619;CS8625;ASPDEPR002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="<#= providerPackage #>" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
<#
    if (Project.OData)
    {
#>
    <PackageReference Include="Microsoft.AspNetCore.OData" Version="9.5.0" />
<#
    }
    if (Project.ApiAuth)
    {
#>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
<#
    }
    if (Project.ApiValidation)
    {
#>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
<#
    }
    if (Project.ApiFakers)
    {
#>
    <PackageReference Include="Bogus" Version="35.6.3" />
<#
    }
    if (Project.ApiTelemetry)
    {
#>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
<#
    }
#>
  </ItemGroup>
<#
    if (Project.ApiDocs)
    {
#>

  <ItemGroup>
    <!-- openapi.yaml (API_OpenApi) is served at /openapi.yaml and by the Swagger UI page at /docs. -->
    <Content Include="openapi.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
<#
    }
#>

</Project>
@@@FILE Program.cs@@@
using System.Text.Json;
using System.Text.Json.Serialization;

<#
    if (Project.ApiValidation)
    {
#>
using FluentValidation;

<#
    }
#>
var builder = WebApplication.CreateBuilder(args);

// The provider (<#= providerName #>) is chosen in the generated <#= Project.ContextName ?? "AppContext" #>.
builder.Services.AddGeneratedDbContext(builder.Configuration);

// Every error answers as problem details (Problems.cs): a refused database write says why, an unexpected failure says nothing of the server.
builder.Services.AddApiProblems();

<#
    if (Project.ApiValidation)
    {
#>
// The validators CS_Validator writes (one per table); the create and update endpoints run them through ValidationFilter and answer 400 with the messages.
builder.Services.AddValidatorsFromAssemblyContaining<Program>();

<#
    }
#>
<#
    if (Project.ApiAuth)
    {
#>
// Sign-in (Auth.cs, the Jwt group): the bearer token check and a policy that makes every endpoint but POST /api/auth/login need a token. Jwt:Key comes from the environment variable Jwt__Key.
// A project with its own user table registers its IUserDirectory before this line.
<#
        if (Project.UserTable is not null)
        {
#>
builder.Services.AddTableUserDirectory();   // TableUserDirectory.cs (API_UserDirectory): the people who sign in are the rows of <#= Project.UserTable #>
<#
        }
#>
builder.AddGeneratedAuth();

<#
    }
#>
// Entities point at each other (an invoice at its customer, a customer at its invoices); do not follow the loop when writing JSON.
builder.Services.ConfigureHttpJsonOptions(options =>
{
    options.SerializerOptions.ReferenceHandler = ReferenceHandler.IgnoreCycles;
    options.SerializerOptions.PropertyNamingPolicy = JsonNamingPolicy.CamelCase;
});

<#
    if (Project.OData)
    {
#>
// OData.cs (generated by API_OData): the query options and the limits of the /odata routes.
builder.Services.AddGeneratedOData();

<#
    }
#>
// <#= corsNote #>
<#
    if (Project.ApiProduction)
    {
#>
// The origins come from Cors:Origins in appsettings.json (or the Cors__Origins__0 environment variable), so a deployment can name its own.
string[] origins = builder.Configuration.GetSection("Cors:Origins").Get<string[]>() ?? [<#= origins #>];
builder.Services.AddCors(options => options.AddDefaultPolicy(policy =>
    policy.WithOrigins(origins).AllowAnyHeader().AllowAnyMethod()));

builder.AddProductionProfile();

<#
    }
    else
    {
#>
builder.Services.AddCors(options => options.AddDefaultPolicy(policy =>
    policy.WithOrigins(<#= origins #>).AllowAnyHeader().AllowAnyMethod()));

<#
    }
    if (Project.ApiTelemetry)
    {
#>
// Traces, metrics and logs; exported over OTLP when OTEL_EXPORTER_OTLP_ENDPOINT names a collector (see Telemetry.cs).
builder.AddTelemetry();

<#
    }
#>
var app = builder.Build();
<#
    if (Project.ApiAuth && Project.UserTable is not null)
    {
#>

// The command set-password <user name> (run with dotnet run and the arguments after a double hyphen; the new password in the environment variable NEW_PASSWORD) writes a password hash and ends; any other start goes on to the server.
if (await UserCommands.TryRunAsync(args, app.Services))
    return;

<#
    }
#>
app.UseApiProblems();
<#
    if (Project.ApiProduction)
    {
#>
app.UseProductionProfile();
<#
    }
#>
app.UseCors();
<#
    if (Project.ApiProduction)
    {
#>
app.UseRateLimiter();
<#
    }
    if (Project.ApiAuth)
    {
#>
app.UseAuthentication();
app.UseAuthorization();
app.MapAuthEndpoints();   // Auth.cs: POST /api/auth/login
<#
    }
#>

// ApiRegistration.cs (generated by API_Registration) has one line per table. The Search classes need the <Table>_Search / <Table>_SearchCount routines in the database (the sql folder).
app.RegisterGeneratedApis();
<#
    if (Project.ApiCsv)
    {
#>
app.MapCsvEndpoints();   // Csv.cs (generated by API_Csv): GET /api/<table>/export.csv and POST /api/<table>/import
<#
    }
    if (Project.OData)
    {
#>
app.MapODataEndpoints();   // OData.cs (generated by API_OData): the tables served as OData under /odata, next to the /api routes
<#
    }
    if (Project.ApiProduction)
    {
#>

// /health/live and /health/ready.
app.MapProductionHealth();
<#
    }
#>
<#
    if (Project.ApiDocs)
    {
#>

// openapi.yaml (API_OpenApi) and a Swagger UI page over it at /docs.
app.MapOpenApiDocs();
<#
    }
#>

app.Run();
<#
    if (Project.ApiTests)
    {
#>

// The test project (ApiTests=true) starts this API in process.
public partial class Program;
<#
    }
#>
@@@FILE Problems.cs@@@
using System.Text.RegularExpressions;
using Microsoft.AspNetCore.Diagnostics;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;

namespace <#= apiNamespace #>;

/// <summary>
/// Every error answers as problem details (RFC 9457): a validation failure lists the fields, a database write that was refused says why (a duplicate value, a row still in use, a value too long or missing) and names the
/// table, and anything unexpected says nothing of the server outside Development. The Angular, React and Blazor screens show the <c>detail</c> as it is.
/// </summary>
public static partial class ApiProblems
{
    private enum Constraint { Unique, ForeignKey, TooLong, Required }

    // The numbers <#= dialect #> raises for a refused write, read from the provider's exception.
<#= errorConstants #>

    public static IServiceCollection AddApiProblems(this IServiceCollection services)
    {
        services.AddProblemDetails();
        services.AddExceptionHandler<ApiExceptionHandler>();
        return services;
    }

    public static WebApplication UseApiProblems(this WebApplication app)
    {
        app.UseExceptionHandler();
        app.UseStatusCodePages();
        return app;
    }

    public static ProblemDetails Problem(int status, string type, string title, string detail) => new() { Status = status, Type = type, Title = title, Detail = detail };

    /// <summary> What to tell the caller about a write the database refused. </summary>
    public static ProblemDetails Describe(DbUpdateException error)
    {
        string table = TableOf(error);
        bool removing = error.Entries.Any(entry => entry.State == EntityState.Deleted);
        return ConstraintOf(error.InnerException) switch
        {
            Constraint.Unique => Problem(StatusCodes.Status409Conflict, "<#= ProblemTypes.DuplicateValue #>", "Duplicate value", $"A {table} with that value already exists."),
            Constraint.ForeignKey when removing => Problem(StatusCodes.Status409Conflict, "<#= ProblemTypes.InUse #>", "In use", $"The {table} cannot be removed because other rows use it."),
            Constraint.ForeignKey => Problem(StatusCodes.Status400BadRequest, "<#= ProblemTypes.RelatedRowMissing #>", "Related row missing", $"The {table} names a row that does not exist."),
            Constraint.TooLong => Problem(StatusCodes.Status400BadRequest, "<#= ProblemTypes.ValueTooLong #>", "Value too long", $"A value is too long for the {table}."),
            Constraint.Required => Problem(StatusCodes.Status400BadRequest, "<#= ProblemTypes.ValueRequired #>", "Value required", $"A required value of the {table} is missing."),
            _ => Problem(StatusCodes.Status500InternalServerError, "<#= ProblemTypes.DatabaseRefused #>", "The database refused the change", "The change could not be saved.")
        };
    }

    /// <summary> <see cref="Describe"/> as an answer, for a handler that catches the exception itself. </summary>
    public static IResult ToResult(DbUpdateException error) => Results.Problem(Describe(error));

    private static Constraint? ConstraintOf(Exception? error)
    {
        if (error is not <#= errors.Pattern #>)
            return null;
        return <#= errors.Value #> switch
        {
<#= errorArms #>
            _ => null
        };
    }

    // the table of the row that was being saved, in words: "SalesInvoiceLine" is "sales invoice line"
    private static string TableOf(DbUpdateException error) =>
        Words(error.Entries.Select(entry => entry.Metadata.GetTableName()).FirstOrDefault(name => name is not null) ?? "row");

    private static string Words(string name) => PascalWords().Replace(name.Replace('_', ' '), " ").ToLowerInvariant();

    [GeneratedRegex("(?<=[a-z0-9])(?=[A-Z])")]
    private static partial Regex PascalWords();
}

/// <summary> Turns an exception no endpoint caught into problem details; the stack trace and the message of the inner exception (the database's own) are included only in Development. </summary>
public sealed class ApiExceptionHandler(IProblemDetailsService problems, IHostEnvironment environment, ILogger<ApiExceptionHandler> logger) : IExceptionHandler
{
    public async ValueTask<bool> TryHandleAsync(HttpContext http, Exception exception, CancellationToken cancellationToken)
    {
        var problem = exception switch
        {
            DbUpdateConcurrencyException => ApiProblems.Problem(StatusCodes.Status409Conflict, "<#= ProblemTypes.ChangedByElse #>", "Changed by someone else", "The row was changed or removed since it was read. Load it again."),
            DbUpdateException update => ApiProblems.Describe(update),
            // ASP.NET throws this for a body it cannot read when ThrowOnBadRequest is on (Development); in production it answers 400 itself
            BadHttpRequestException unreadable => ApiProblems.Problem(unreadable.StatusCode, "<#= ProblemTypes.InvalidRequest #>", "Invalid request", "The request could not be read."),
            _ => ApiProblems.Problem(StatusCodes.Status500InternalServerError, "<#= ProblemTypes.Unexpected #>", "Something went wrong", environment.IsDevelopment() ? exception.Message : "The server could not finish the request.")
        };

        if (environment.IsDevelopment())
        {
            if (exception.InnerException is { } inner)
                problem.Extensions["cause"] = inner.Message;
            if (problem.Status == StatusCodes.Status500InternalServerError)
                problem.Extensions["trace"] = exception.ToString();
        }

        if (problem.Status >= StatusCodes.Status500InternalServerError)
            logger.LogError(exception, "Unhandled exception on {Path}", http.Request.Path);
        else
            logger.LogWarning("{Title} on {Path}: {Detail}", problem.Title, http.Request.Path, problem.Detail);

        http.Response.StatusCode = problem.Status!.Value;
        return await problems.TryWriteAsync(new ProblemDetailsContext { HttpContext = http, ProblemDetails = problem, Exception = exception });
    }
}
