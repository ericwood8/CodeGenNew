# Restriction checkboxes for SP_CreateSchema_v1.tt (see Docs/Reference.md section 3).
# One script for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# No OutputName: the template writes its own path (CreateSchema.sql) with an @@@FILE marker.
# Whole-project generation (codegen generate): written only for a project with ApiTests and ApiTestContainers that names no ApiTestSchema of its own.
Stacks=Api
OutputRoot=Sql
InPlan=false
Dialects=SqlServer,PostgreSql,MySql
