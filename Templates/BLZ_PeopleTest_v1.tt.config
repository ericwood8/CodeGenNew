# Restriction checkboxes for BLZ_PeopleTest_v1.tt (see Docs/Reference.md section 3).
# One set of files for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# No OutputName: the template writes its own path (MembersTests.cs) with an @@@FILE marker.
# Whole-project generation (codegen generate): for a project that sets BlazorTests=true with Auth=true, ApiAuth, a UserTable and a TenantMembership. The file goes to the test project, not the Blazor app.
Stacks=Blazor
OutputRoot=BlazorTests
InPlan=false
