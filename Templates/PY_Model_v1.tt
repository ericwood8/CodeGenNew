<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PY_Model_v1.tt
    // Generates: app/models/<table>.py   (the template writes its own path with an @@@FILE marker; the output folder is the Python API's folder)
    // The SQLAlchemy 2.0 class of a table: __tablename__ (the database's own name, with the schema for a SQL Server or PostgreSQL table that is not in dbo / public), and one Mapped column per
    // column, named in snake_case over the database's own column name, with its type (String(50), Numeric(10, 2), DateTime ...), nullability and, for the key, autoincrement. A column the
    // database writes (computed, or an identity that is not the key) is marked server-generated. A binary column, a PostgreSQL money column and a type CodeGenNew cannot map are left out.
    // Full notes: Docs/TemplateNotes/PY_Model_v1.md
    // ==========================================================================================

    Write(PythonModelFile.Text(Model, Project));
#>
