# Restriction checkboxes for TSX_EssentialStyles_v1.tt (see Docs/Reference.md section 3).
# One of the files every React app needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=React
EssentialsGroup=Styles
Description=src/index.css: the menu, grids, forms, tabs, modal dialog, search bar and the shaded bold row buttons the generated pages assume
