# Restriction checkboxes for SP_Clone_v1.tt (see Docs/Reference.md section 3).
# The row to copy is named by its primary key, so one is required.
RequiresPrimaryKey=true
TableOnly=true
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Api,WinUI3
PlanTables=Entity
OutputRoot=Sql
# The routines are written for the three databases that have them; a SQLite project reaches the database through EF (AccessMode=Ef) instead.
Dialects=SqlServer,PostgreSql,MySql
AccessMode=Routines
