# Restriction checkboxes for CS_Faker_v1.tt (see Docs/Reference.md section 3).
# The faker is for the entity class, which needs a key.
RequiresPrimaryKey=true
TableOnly=true
# Name the file like the class: Customer -> CustomerFaker.cs
OutputName={Table}Faker.cs
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso.
Stacks=Api
PlanTables=Entity
OutputFolder=Fakers
InPlan=false
