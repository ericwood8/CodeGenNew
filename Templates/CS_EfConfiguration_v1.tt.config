# Restriction checkboxes for CS_EfConfiguration_v1.tt (see Docs/Reference.md section 3).
# The configuration is for the entity class, which needs a key.
RequiresPrimaryKey=true
TableOnly=true
# Name the file like the class: Customer -> CustomerConfiguration.cs
OutputName={Table}Configuration.cs
# Whole-project generation (codegen generate): for a project that sets EfConfigurations=true (or names the template in PlanAlso).
Stacks=Api,WinUI3
PlanTables=Context
OutputFolder=Data/Configurations
InPlan=false
