# Restriction checkboxes for BLZ_Test_v1.tt (see Docs/Reference.md section 3).
# bUnit tests of the page BLZ_Page writes: the screen edits rows by their primary key, taken as {id:int}, {id:guid} or {id} (text).
# No OutputName: the template writes its own path (<Table>PageTests.cs) with an @@@FILE marker.
Requires=PrimaryKey,SingleKey,NotNameActive
NeedsReferencedDisplayColumns=true
# Whole-project generation (codegen generate): for a project that sets BlazorTests=true (or names the template in PlanAlso). The files go to the test project, not the Blazor app.
Stacks=Blazor
PlanTables=Screen
OutputRoot=BlazorTests
InPlan=false
