# Restriction checkboxes for BLZ_FeaturesTest_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the bUnit tests of the subscription page.
Scope=Database
# No OutputName: the template writes its own path (FeaturesTests.cs) with an @@@FILE marker.
# Whole-project generation (codegen generate): written only with BlazorTests=true and a subscription page. The file goes to the Blazor test project, not the app.
Stacks=Blazor
OutputRoot=BlazorTests
InPlan=false
