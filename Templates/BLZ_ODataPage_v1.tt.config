# BLZ_Page_v1.tt run as its OData form (see Base and Variant in TemplateConfig). Opt in with OData=true and a Blazor stack; written only for the tables the project serves as OData.
Base=BLZ_Page_v1.tt
Variant=OData
Requires=PrimaryKey,SingleKey,NotNameActive
NeedsReferencedDisplayColumns=true
Stacks=Blazor
PlanTables=Screen
InPlan=false
