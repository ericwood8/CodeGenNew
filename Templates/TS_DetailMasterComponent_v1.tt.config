# Restriction checkboxes for TS_DetailMasterComponent_v1.tt (see Docs/specs.md section 5.3).
RequiresPrimaryKey=true
TableOnly=true
RequiredPrimaryKeyShape=SingleIntOrGuid
# A name/active table's real API is always hand-maintained and commonly has no plain getAll() at all
# (confirmed against a real one).
RequiresNotNameActiveTable=true
# Only offered for a table that is the "parent" side of at least one foreign key (TableModel.ChildForeignKeys) --
# otherwise it's exactly TS_Component with nothing extra to show, so use that instead.
RequiresChildTables=true
# The drop-downs for foreign keys show the parent table's display column, so ask for it.
NeedsReferencedDisplayColumns=true
# No OutputName: the template writes its own paths (components/<table>-detail-master/...) with @@@FILE markers.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Angular
PlanTables=ScreenDetailMaster
OutputFolder=src/app
