<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // UNO_Model_v1.tt
    // Generates: Models/<Table>.cs   (the path is written by the template; point the output folder at the Uno app's folder)
    // The class a table's JSON becomes in the Uno app, one property per column, in the namespace <AppNamespace>.Models. The API writes camelCase and reads either case, so the property
    // names are the column names. Every property gets a starting value that keeps the nullable checks quiet: "" for text, an empty array for binary.
    // Full notes: Docs/TemplateNotes/UNO_Model_v1.md
    // ==========================================================================================

    if (UnoNames.Refusal(Model, Project) is { } reason)
    {
        Error($"UNO_Model writes no class for [{Model.SchemaName}].[{Model.TableName}]: {reason}");
    }
    else
    {
        string type = BlazorNames.TypeName(Model.TableName);
        Write($"@@@FILE Models/{type}.cs@@@\n" + ApiClientCode.Model(Model, Project, UnoNames.ModelsNamespace(Project), tinyIntAsShort: false));
    }
#>
