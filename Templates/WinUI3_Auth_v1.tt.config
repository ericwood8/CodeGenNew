# Restriction checkboxes for WinUI3_Auth_v1.tt (see Docs/Reference.md section 3).
# One set of files for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# No OutputName: the template writes its own paths (Repositories/DesktopSignIn.cs, Views/LoginView.xaml and Views/LoginView.xaml.cs) with @@@FILE markers.
# Whole-project generation (codegen generate): written only for a project with Auth=true, the WinUI3 stack and a UserTable (with ApiAuth).
Stacks=WinUI3
InPlan=false
