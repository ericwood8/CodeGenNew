# Restriction checkboxes for TS_EssentialShell_v1.tt (see Docs/Reference.md section 3).
# One of the files every Angular app needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Angular
EssentialsGroup=Shell
Description=index.html, main.ts and the root component (app.ts, app.html, app.css): the menu with its hamburger button around the router outlet
Needs=src/app/app.routes.ts
