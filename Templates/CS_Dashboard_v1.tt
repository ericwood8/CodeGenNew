<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string repositoryNamespace = "MyApp.Common.Repositories";
    string contextType = "MyAppContext";
    string[] usings = { };   // namespaces the generated file must "using" (the context's)
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    contextType = Project.ContextName ?? contextType;
    repositoryNamespace = Project.RepoNamespace ?? repositoryNamespace;
    usings = Project.Usings ?? usings;
    // ==========================================================================================

    // ==========================================================================================
    // CS_Dashboard_v1.tt
    // Generates: DashboardData.cs   (see OutputName in CS_Dashboard_v1.tt.config)
    // The dashboard's data for the whole database: the widgets DashboardPlan chose, each with its one fixed SQL statement, and LoadAsync, which runs them through the context
    // and returns the points of every widget. The web API (API_Dashboard) and the desktop app (WinUI3_DashboardPage) both call it. The statements take no parameter: a table named
    // by the caller is only compared with the fixed list.
    // Full notes: Docs/TemplateNotes/CS_Dashboard_v1.md

    var plan = DashboardPlan.Build(Database, Project);
    foreach (string problem in plan.Problems)
        Error(problem);

    var strip = Project.DashboardStrip ? plan.StripTables.SelectMany(plan.StripOf).Select(w => w.Id).ToHashSet() : new HashSet<string>();
    var onDashboard = plan.Widgets.Select(w => w.Id).ToHashSet();
    var widgets = plan.Widgets.Concat(plan.Candidates.Where(w => strip.Contains(w.Id) && !onDashboard.Contains(w.Id))).ToList();
    var screenTables = Database.ScreenTables(Project).Select(t => t.TableName).ToHashSet(StringComparer.OrdinalIgnoreCase);

    string Esc(string text) => text.Replace("\\", "\\\\").Replace("\"", "\\\"");
    string Bool(bool value) => value ? "true" : "false";

    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');

    Line($"namespace {repositoryNamespace};");
    Line();
    foreach (string u in usings)
        Line($"using {u};");
    Line("using System.Collections.Concurrent;");
    Line("using Microsoft.EntityFrameworkCore;");
    Line();
    Line("/// <summary> One value of a widget: a label and a number (a count, a sum, one month of a trend). </summary>");
    Line("public class DashboardPoint");
    Line("{");
    Line("    public string? Label { get; set; }");
    Line("    public double? Value { get; set; }");
    Line("}");
    Line();
    Line("/// <summary> One line of a recent-rows widget: what the row is called and its date. </summary>");
    Line("public class DashboardRow");
    Line("{");
    Line("    public string? Label { get; set; }");
    Line("    public string? Detail { get; set; }");
    Line("}");
    Line();
    Line("/// <summary> A widget with its data. Kind is count, childCount, money, topBy, breakdown, trend, ratio, status or recent; a recent widget fills Rows, every other one Points. </summary>");
    Line("public class DashboardWidgetData");
    Line("{");
    Line("    public string Id { get; set; } = \"\";");
    Line("    public string Kind { get; set; } = \"\";");
    Line("    public string Title { get; set; } = \"\";");
    Line("    public string Table { get; set; } = \"\";");
    Line("    /// <summary> The route of the table's screen (empty when it has none), where a click on the widget goes. </summary>");
    Line("    public string Route { get; set; } = \"\";");
    Line("    public List<DashboardPoint> Points { get; set; } = [];");
    Line("    public List<DashboardRow> Rows { get; set; } = [];");
    Line("}");
    Line();
    Line("public class DashboardResult");
    Line("{");
    Line("    public List<DashboardWidgetData> Widgets { get; set; } = [];");
    Line("}");
    Line();
    Line("/// <summary> Generated by CS_Dashboard from the schema's own facts (money columns, foreign keys, lookup and choice columns, dates). Change the choice with the project's Dashboard settings and regenerate. </summary>");
    Line("public static class DashboardData");
    Line("{");
    Line("    private sealed record Definition(string Id, string Kind, string Title, string Table, string Route, bool IsRows, bool OnDashboard, bool OnStrip, string Sql);");
    Line();
    Line("    private static readonly Definition[] Definitions =");
    Line("    [");
    foreach (var w in widgets)
    {
        string route = screenTables.Contains(w.Table) ? ScreenNames.Route(w.Table) : "";
        Line($"        new(\"{w.Id}\", \"{w.KindName}\", \"{Esc(w.Title)}\", \"{w.Table}\", \"{route}\", {Bool(w.IsRows)}, {Bool(onDashboard.Contains(w.Id))}, {Bool(strip.Contains(w.Id))},");
        Line($"            \"{Esc(w.Sql)}\"),");
    }
    Line("    ];");
    Line();
    Line("    private static readonly TimeSpan CacheFor = TimeSpan.FromMinutes(1);");
    Line("    private static readonly ConcurrentDictionary<string, (DateTime Expires, DashboardResult Result)> Cache = new();");
    Line();
    Line("    /// <summary> The tables whose screens show a strip of cards (the DashboardStrip project setting). </summary>");
    string stripTables = string.Join(", ", (Project.DashboardStrip ? plan.StripTables : []).Select(t => "\"" + t + "\""));
    Line($"    public static readonly string[] StripTables = [{stripTables}];");
    Line();
    Line("    /// <summary> The dashboard page's widgets, or with <paramref name=\"table\"/> the cards of that table's strip (empty for a table that has none). <paramref name=\"useCache\"/> keeps the answer for a minute. </summary>");
    Line($"    public static async Task<DashboardResult> LoadAsync({contextType} context, string? table = null, bool useCache = false, CancellationToken cancellationToken = default)");
    Line("    {");
    Line("        string key = table is null ? \"\" : \"table:\" + table;");
    Line("        if (useCache && Cache.TryGetValue(key, out var cached) && cached.Expires > DateTime.UtcNow)");
    Line("            return cached.Result;");
    Line();
    Line("        var chosen = table is null");
    Line("            ? Definitions.Where(d => d.OnDashboard)");
    Line("            : Definitions.Where(d => d.OnStrip && d.Table.EqualsIgnoreCase(table));");
    Line("        var result = new DashboardResult();");
    Line("        foreach (var d in chosen)");
    Line("        {");
    Line("            var data = new DashboardWidgetData { Id = d.Id, Kind = d.Kind, Title = d.Title, Table = d.Table, Route = d.Route };");
    Line("            if (d.IsRows)");
    Line("                data.Rows = await context.Database.SqlQueryRaw<DashboardRow>(d.Sql).ToListAsync(cancellationToken);");
    Line("            else");
    Line("                data.Points = await context.Database.SqlQueryRaw<DashboardPoint>(d.Sql).ToListAsync(cancellationToken);");
    Line("            result.Widgets.Add(data);");
    Line("        }");
    Line();
    Line("        if (useCache)");
    Line("            Cache[key] = (DateTime.UtcNow + CacheFor, result);");
    Line("        return result;");
    Line("    }");
    Line("}");
    Write(sb.ToString());
#>
