<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PY_TestTotals_v1.tt
    // Generates: tests/conftest.py and tests/test_totals.py   (whole-database; the output folder is the Python API's folder)
    // pytest tests of what PY_Routes writes for DocumentTotals. conftest.py is the one PY_TestApprovals writes. test_totals.py adds a header and lines through the routes and removes them after the test, and
    // plays the cases: the totals a client writes replaced, the lines total following every line added or removed, the payable amount following the prepaid amount and the check route. The words are DocumentTotalsWords.
    // Written only for a project with PythonTests=true and a header and a line table the tests can fill (DocumentTotalsTestPlan); not for SQL Server.
    // Run them with pytest from the API's folder (requirements.txt lists pytest and httpx with PythonTests=true).
    // Full notes: Docs/TemplateNotes/API_RowShapes_v1.md
    // ==========================================================================================
    if (PythonTotalsTests.Applies(Database, Project))
    {
        if (!PythonRateTests.Applies(Database, Project) && !PythonRateDocumentTests.Applies(Database, Project) && !PythonTaxTests.Applies(Database, Project) && !PythonAllowanceTests.Applies(Database, Project))
            Write("@@@FILE tests/conftest.py@@@\n" + PythonTotalsTests.Conftest(Project, Database.Dialect));
        Write("@@@FILE tests/test_totals.py@@@\n" + PythonTotalsTests.File(Database, Project));
    }
#>
