<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string entityNamespace = "MyApp.Common.Entities";
    string baseEntity = "BaseEntity";
    string baseNameActiveEntity = "BaseNameActiveEntity";
    // Namespaces the generated file must "using" (for example "MyApp.Entities"; leave empty when the project supplies them through
    // global usings). Each entry becomes a using line in the generated file.
    string[] usings = { };
    // Tables a foreign key can point to WITHOUT a navigation property: they are C# enums or have no entity class.
    string[] noNavigationTables =
    {
        "ClearanceType", "ExpenseType", "LeaveType", "OvertimeType", "SY_Display", "SY_ISOCountry",
        "SY_RequestStatusType", "SY_RequestType", "SY_ResponseType", "SY_Role"
    };
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    baseEntity = Project.BaseEntity ?? baseEntity;
    baseNameActiveEntity = Project.BaseNameActiveEntity ?? baseNameActiveEntity;
    entityNamespace = Project.EntityNamespace ?? entityNamespace;
    usings = Project.Usings ?? usings;
    // With a project chosen, which tables count as enums (no entity/repository/API of their own) comes from the project's
    // EnumTables, else from what the schema says about each table (LookupShape) - not from the lists above, which are
    // only used when no project is chosen.
    bool NoNavigation(string table, LookupShape shape) => Project.NoNavigation(table, shape) ?? noNavigationTables.Contains(table, StringComparer.OrdinalIgnoreCase);
    // ==========================================================================================

    // ==========================================================================================
    // CS_Entity_v1.tt
    // Generates: <TableName>.cs   (see OutputName in CS_Entity_v1.tt.config)
    // An EF Core entity class named like the table, one property per column, with [Key] on a single primary key (a composite key is named in
    // the context), a navigation property per single-column foreign key, [Display] / [DataType] attributes and, for NamingStyle=Pascal,
    // [Table] / [Column] with the real database names. Needs a primary key.
    // Does not write collection navigations, validation attributes beyond the column's own, or any business rule.
    // Full notes: Docs/TemplateNotes/CS_Entity_v1.md
    // ==========================================================================================

    if (Model.PrimaryKeyColumns.Count == 0)
    {
        Error($"CS_Entity needs a table with a primary key, but [{Model.SchemaName}].[{Model.TableName}] has none.");
    }
    else
    {
        // ==== naming helpers
        string Id(ColumnModel c) => c.CSharpName();
        string Words(string name, bool isBit) => Labels.Words(name, isBit);
        string Str(string s) => s.Replace("\\", "\\\\").Replace("\"", "\\\"");

        // ==== base class
        var nameColumn = Model.Columns.FirstOrDefault(c => c.IsStringColumn && !c.IsNullable && c.Name == "Name");
        var activeColumn = Model.Columns.FirstOrDefault(c => c.IsBooleanColumn && !c.IsNullable && c.Name == "IsActive");
        bool nameActive = nameColumn is not null && activeColumn is not null;
        string baseClass = nameActive ? baseNameActiveEntity : baseEntity;

        // ==== foreign keys: single-column ones only
        var fkByColumn = new Dictionary<string, ForeignKeyModel>(StringComparer.OrdinalIgnoreCase);
        foreach (var fk in Model.ForeignKeys.Where(f => f.ReferencingColumns.Count == 1))
            fkByColumn[fk.ReferencingColumns[0]] = fk;

        var navigations = EntityNavigations.Of(Model, fk => NoNavigation(fk.ReferencedTable, fk.ReferencedLookupShape))
            .Select(n => (Column: n.Column, Role: n.Role, Type: n.Type)).ToList();
        var navByColumn = navigations.ToDictionary(n => n.Column.Name, n => n, StringComparer.OrdinalIgnoreCase);

        // ==== C# type of a column
        string ClrType(ColumnModel c) => c.CSharp();

        var o = new StringBuilder();
        void L(string s = "") => o.Append(s).Append('\n');
        var body = new StringBuilder();
        void B(string s = "") => body.Append(s).Append('\n');
        bool usesSchema = false; // System.ComponentModel.DataAnnotations.Schema: [ForeignKey], [Column], [Table]

        // EF Core allows one [Column] per property: it carries the column's real name when the project's NamingStyle gave the property another one
        // (customer_id -> CustomerId), and the column type when one has to be said (money, a PostgreSQL timestamp or jsonb).
        string? ColumnAttribute(ColumnModel col, string? columnType)
        {
            string? name = col.DatabaseName;
            if (name is null && columnType is null) return null;
            usesSchema = true;
            return "    [Column(" + (name is null ? "" : $"\"{name}\"" + (columnType is null ? "" : ", ")) + (columnType is null ? "" : $"TypeName = \"{columnType}\"") + ")]";
        }

        // ==== Omitted: the key, then the foreign keys, in column order
        B("    #region Omitted");
        bool firstOmitted = true;
        foreach (var c in Model.Columns.Where(c => c.IsPrimaryKey || fkByColumn.ContainsKey(c.Name)))
        {
            if (!firstOmitted) B();
            firstOmitted = false;
            if (c.IsPrimaryKey)
            {
                if (Model.PrimaryKeyColumns.Count == 1)
                    B("    [Key]");
                B("    [Display(Order = -1, AutoGenerateField = true)]");
            }
            else
            {
                if (navByColumn.TryGetValue(c.Name, out var nav))
                {
                    B($"    [ForeignKey(nameof({nav.Role}))]");
                    usesSchema = true;
                }
                B("    [Display(Order = -1, AutoGenerateField = false)]");
            }
            if (ColumnAttribute(c, null) is { } omittedColumnAttribute) B(omittedColumnAttribute);
            B($"    public {(c.IsNullable ? "" : "required ")}{ClrType(c)} {Id(c)} {{ get; set; }}");
        }
        B("    #endregion Omitted");

        // ==== navigation properties
        if (navigations.Count > 0)
        {
            B();
            B("    // entities");
            foreach (var n in navigations)
                B($"    public {n.Type}? {n.Role} {{ get; set; }}");
        }

        // ==== the rest of the columns
        foreach (var c in Model.Columns.Where(c => !c.IsPrimaryKey && !fkByColumn.ContainsKey(c.Name) && !(nameActive && (c == nameColumn || c == activeColumn))))
        {
            B();
            bool isBit = c.IsBooleanColumn;
            string words = Str(Words(c.Name, isBit));
            int chars = c.CharacterLength();
            bool isText = c.SqlType is SqlDbType.Char or SqlDbType.VarChar or SqlDbType.NChar or SqlDbType.NVarChar;
            bool multiline = isText && chars >= 100;
            string? columnType = null;

            B($"    [Display({(multiline ? "Order = -1, " : "")}Name = \"{words}\", Description = \"{words}\")]");
            if (c.SqlType is SqlDbType.Date or SqlDbType.DateTime or SqlDbType.DateTime2 or SqlDbType.SmallDateTime)
            {
                B("    [DisplayFormat(DataFormatString = \"{0:MM/dd/yyyy}\")]");
                B("    [DataType(DataType.Date)]");
                // PostgreSQL: Npgsql maps a DateTime to "timestamp with time zone" (UTC only) unless the column type is said: timestamp (no zone) or date.
                if (Model.Dialect == SqlDialect.PostgreSql)
                    columnType = c.SqlTypeDeclaration;
            }
            else if (c.IsMoneyColumn)
            {
                B("    [DisplayFormat(ApplyFormatInEditMode = true)]");
                B("    [DataType(DataType.Currency)]");
                columnType = c.SqlType == SqlDbType.Money ? "money" : "smallmoney";
            }
            else if (c.SqlType == SqlDbType.Decimal)
            {
                int scale = c.Scale ?? 0;
                B($"    [DisplayFormat(ApplyFormatInEditMode = true, DataFormatString = \"#0{(scale > 0 ? "." + new string('0', scale) : "")}\")]");
                if (!(Model.Dialect == SqlDialect.PostgreSql && c.SqlTypeDeclaration == "numeric")) // a bare PostgreSQL numeric has no precision to state
                    B($"    [Precision({c.Precision ?? 18}, {scale})]");
            }
            else if (isText)
            {
                // PostgreSQL json / jsonb arrive as a string column; the column type has to be said or Npgsql sends text.
                if (Model.Dialect == SqlDialect.PostgreSql && c.SqlTypeDeclaration is "json" or "jsonb")
                    columnType = c.SqlTypeDeclaration;                if (chars > 0) B($"    [StringLength({chars})]");
                if (multiline) B("    [DataType(DataType.MultilineText)]");
                else if (c.Name.ContainsIgnoreCase("Phone")) B("    [DataType(DataType.PhoneNumber)]");
            }
            else if (c.SqlType == SqlDbType.Timestamp)
            {
                B("    [Timestamp]");
            }

            if (c.IsComputed) { B("    [DatabaseGenerated(DatabaseGeneratedOption.Computed)]"); usesSchema = true; }
            else if (c.IsIdentity) { B("    [DatabaseGenerated(DatabaseGeneratedOption.Identity)]"); usesSchema = true; }

            string initializer = "";
            if (isBit && c.DatabaseDefaultSql is not null)
            {
                string d = c.DatabaseDefaultSql.Trim('(', ')', ' ');
                // SQL Server writes a bit default as ((1)) / ((0)); PostgreSQL writes true / false.
                if (d == "1" || d.EqualsIgnoreCase("true")) initializer = " = true;";
                else if (d == "0" || d.EqualsIgnoreCase("false")) initializer = " = false;";
            }
            if (ColumnAttribute(c, columnType) is { } columnAttribute) B(columnAttribute);
            bool needsRequired = !c.IsNullable && !c.IsComputed && !c.IsIdentity && c.SqlType != SqlDbType.Timestamp;
            B($"    public {(needsRequired ? "required " : "")}{ClrType(c)} {Id(c)} {{ get; set; }}{initializer}");
        }

        // ==== ToString on a table that has a plain "Name"
        if (!nameActive && Model.Columns.Any(c => c.IsStringColumn && c.Name == "Name"))
        {
            B();
            B("    public override string? ToString() => Name;");
        }

        // ==== assemble
        var headUsings = usings.ToList();
        if (Model.DatabaseTableName is not null) usesSchema = true; // [Table("customer_item")] below
        if (usesSchema && !headUsings.Contains("System.ComponentModel.DataAnnotations.Schema"))
            headUsings.Insert(0, "System.ComponentModel.DataAnnotations.Schema");
        if (!headUsings.Contains("System.Diagnostics.CodeAnalysis"))
            headUsings.Insert(0, "System.Diagnostics.CodeAnalysis");
        if (headUsings.Count > 0)
        {
            foreach (string u in headUsings) L($"using {u};");
            L();
        }
        L($"namespace {entityNamespace};");
        L();
        string className = (Model.IsCSharpReservedWordName ? "@" : "") + Model.TableName;
        if (Model.DatabaseTableName is not null) L($"[Table(\"{Model.DatabaseTableName}\")]");
        L($"public class {className} : {baseClass}");
        L("{");
        // A brand-new row (WinUI3_DetailScreen.tt's "Add" case, CS_Repo.tt's own GenericRepo<T> internals) does
        // `new {Table}()` and fills every property in afterward, one line at a time - plain C# does not let a
        // caller do that for a "required" property (CS9035) unless the constructor that ran first is annotated
        // as having already set them. Found live, the first time this entity family was ever actually compiled
        // against a real WinUI3 project: every NOT NULL column above is `required`, so a bare `new {Table}()`
        // failed to build wherever WinUI3_DetailScreen.tt/WinUI3_DetailMasterScreen.tt used it.
        L($"    [SetsRequiredMembers]");
        L($"    public {className}() {{ }}");
        L();
        o.Append(body);
        L("}");
        Write(o.ToString());
    }
#>
