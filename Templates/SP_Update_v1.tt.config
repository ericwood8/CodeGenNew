# Restriction checkboxes for SP_Update_v1.tt (see Docs/Reference.md section 3).
# A template with no .tt.config defaults both of these to true.
RequiresPrimaryKey=true
TableOnly=true
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Api,WinUI3
PlanTables=Entity
OutputRoot=Sql
InPlan=false
