# Restriction checkboxes for CS_CqrsHandlers_v1.tt (see Docs/Reference.md section 3).
# One run for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# The template writes its own paths (Application/...) with @@@FILE markers.
OutputName=Application/ApplicationRegistration.cs
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso.
Stacks=Api
InPlan=false
