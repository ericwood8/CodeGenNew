<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string apiNamespace = "MyApp.ApiService.Apis";
    string contextType = "MyAppContext";
    string[] usings = { };   // namespaces the generated file must "using" (the context's)
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    contextType = Project.ContextName ?? contextType;
    apiNamespace = Project.ApiNamespace ?? apiNamespace;
    usings = Project.Usings ?? usings;
    // ==========================================================================================

    // ==========================================================================================
    // API_Inbound_v1.tt
    // Generates: Inbound.cs   (see OutputName in API_Inbound_v1.tt.config)
    // The routes of the inbound event landing tables (InboundTables): for each table POST receive and POST receive/{source} (open to anyone; a signature instead of a login, a replay window, a size limit, an event id applied once,
    // the raw body kept as text with a received-on stamp), GET unprocessed (the oldest unprocessed events) and POST {id}/processed (a signed-in worker marks one processed). The table itself is a read-only list, so rows are never
    // edited by hand. Needs InboundSecret (the environment variable that holds the shared secret) at run time.
    // Full notes: Docs/TemplateNotes/API_Inbound_v1.md
    // ==========================================================================================

    var tables = Database.Tables.Select(t => TableShapes.For(t, Project).Inbound).OfType<InboundShape>()
        .OrderBy(q => q.Table.TableName, StringComparer.OrdinalIgnoreCase).ToList();
    var problems = Database.Tables.Select(t => InboundPlan.Problem(t, Project)).Where(p => p is not null).ToList();
    problems.AddRange(InboundPlan.Entries(Project).Where(e => !Database.Tables.Any(t => t.TableName.EqualsIgnoreCase(e.Table)))
        .Select(e => $"InboundTables: {e.Table} is not a table of the database."));
    problems.AddRange(InboundPlan.ClientProblems(Database, Project));
    problems.AddRange(InboundPlan.SourceSecretProblems(Project));
    problems.AddRange(InboundPlan.EditProblems(Project));
    if (problems.Count > 0)
    {
        Error(string.Join(" | ", problems));
    }
    else if (tables.Count > 0)
    {
        Write("namespace " + apiNamespace + ";\n\n");
        Write(InboundWriter.File(tables, Project, contextType, usings));
    }
#>
