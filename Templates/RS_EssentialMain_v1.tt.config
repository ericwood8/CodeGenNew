# Restriction checkboxes for RS_EssentialMain_v1.tt (see Docs/Reference.md section 3).
# One of the files every Rust API needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Rust
EssentialsGroup=Main
Description=src/lib.rs (the router, the server, CORS), src/main.rs and src/support.rs (the pool, the errors, the JSON forms of dates and decimals)
Needs=src/routes/mod.rs
