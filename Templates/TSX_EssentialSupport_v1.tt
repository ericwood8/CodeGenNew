<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // TSX_EssentialSupport_v1.tt
    // Generates: src/api/client.ts, src/components/PaginationBar.tsx, src/components/CurrencyInput.tsx and src/setupTests.ts   (no table, no database: an essentials group)
    // The small files the generated React pages and api modules import: the fetch helper with ApiError (with Auth=true it sends the token of the Auth group and signs the person out on a 401), the Previous / Next bar under every grid, the money box of a form (CurrencyInput), and the test setup that adds the
    // jest-dom matchers. The folders come from the project's ApiFolder and ComponentsFolder settings.
    // ==========================================================================================
    string apiFolder = Project.ApiFolder;
    string componentsFolder = Project.ComponentsFolder;
#>
@@@FILE src/<#= apiFolder #>/client.ts@@@
// The shared fetch helper the generated api modules (TSX_Api) and pages import. Paths are relative ("/api/customers"): in development the Vite dev server proxies /api to the API
// (vite.config.ts), and VITE_API_BASE_URL can point a built copy at an API on another origin.
<# if (Project.Auth) { #>
import { getToken, logout } from './auth';

<# } #>
const API_BASE_URL: string = import.meta.env.VITE_API_BASE_URL ?? '';

export class ApiError extends Error {
  constructor(public status: number, message: string) {
    super(message);
  }
}

export async function request<T>(path: string, init?: RequestInit): Promise<T> {
<# if (Project.Auth) { #>
  const token = getToken();
<# } #>
  const response = await fetch(`${API_BASE_URL}${path}`, {
    ...init,
    headers: {
      'Content-Type': 'application/json',
<# if (Project.Auth) { #>
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
<# } #>
      ...init?.headers,
    },
  });

<# if (Project.Auth) { #>
  // the token is no longer good: the person is signed out, and the shell shows the sign-in page
  if (response.status === <#= HttpStatus.Unauthorized #> && token) logout();
<# } #>
  if (!response.ok) {
    const body = await response.text();
    throw new ApiError(response.status, body || response.statusText);
  }

  // DELETE (and a 200 with no body) has nothing to parse.
  const text = await response.text();
  return (text ? JSON.parse(text) : undefined) as T;
}

// The query string of a lookup call (GET <route>/lookup): the text a type-ahead sends, the keys whose names a page shows, and how many matches to list.
export function lookupQuery(query: { search?: string; ids?: (number | string)[]; take?: number }): string {
  const params = new URLSearchParams();
  if (query.search) params.set('search', query.search);
  if (query.ids?.length) params.set('ids', query.ids.join(','));
  if (query.take) params.set('take', String(query.take));
  const text = params.toString();
  return text ? `?${text}` : '';
}
@@@FILE src/<#= componentsFolder #>/PaginationBar.tsx@@@
// The Previous / Next bar every generated list page puts under its grid.
export function PaginationBar({ page, totalPages, onPrevious, onNext }: {
  page: number;
  totalPages: number;
  onPrevious: () => void;
  onNext: () => void;
}) {
  return (
    <div className="pagination">
      <button type="button" onClick={onPrevious} disabled={page <= 1}>Previous</button>
      <span>Page {page} of {totalPages}</span>
      <button type="button" onClick={onNext} disabled={page >= totalPages}>Next</button>
    </div>
  );
}
@@@FILE src/<#= componentsFolder #>/CurrencyInput.tsx@@@
import { useEffect, useRef, useState } from 'react';

// The money box of a generated form: it shows $1,234.50 while the person is not typing in it and the plain number while they are, and the browser's own required check applies.
// A value that is not a number, or outside min and max, is refused by the form's native validation.
export function CurrencyInput({ id, value, onChange, label, digits = 2, currency = 'USD', min, max, required, style }: {
  id?: string;
  value: number | null | undefined;
  onChange: (value: number | null) => void;
  label: string;
  digits?: number;
  currency?: string;
  min?: number;
  max?: number;
  required?: boolean;
  style?: React.CSSProperties;
}) {
  const [editing, setEditing] = useState(false);
  const [text, setText] = useState('');
  const box = useRef<HTMLInputElement>(null);

  const format = (amount: number | null | undefined): string =>
    amount === null || amount === undefined
      ? ''
      : amount.toLocaleString(undefined, { style: 'currency', currency, minimumFractionDigits: Math.min(2, digits), maximumFractionDigits: digits });
  // null is a blank box, undefined is text that is not a number
  const parse = (typed: string): number | null | undefined => {
    const plain = typed.replace(/[^0-9.\-]/g, '');
    if (plain === '') return typed.trim() === '' ? null : undefined;
    const amount = Number(plain);
    return Number.isNaN(amount) ? undefined : amount;
  };

  const typed = editing ? parse(text) : value;
  let problem = '';
  if (typed === undefined) problem = 'Enter an amount.';
  else if (typed !== null && min !== undefined && typed < min) problem = `The amount must be at least ${format(min)}.`;
  else if (typed !== null && max !== undefined && typed > max) problem = `The amount must be at most ${format(max)}.`;
  useEffect(() => {
    box.current?.setCustomValidity(problem);
  }, [problem]);

  return (
    <input
      id={id}
      ref={box}
      type="text"
      inputMode="decimal"
      aria-label={label}
      value={editing ? text : format(value)}
      required={required}
      style={style}
      onFocus={() => { setText(value === null || value === undefined ? '' : String(value)); setEditing(true); }}
      onBlur={() => setEditing(false)}
      onChange={(event) => {
        setText(event.target.value);
        const amount = parse(event.target.value);
        if (amount !== undefined) onChange(amount);
      }}
    />
  );
}
@@@FILE src/<#= componentsFolder #>/TypeAhead.tsx@@@
import { useEffect, useRef, useState } from 'react';

export type LookupRow<K extends number | string = number> = { id: K; name: string; isActive?: boolean | null };

/** The lookup call of a parent table: all its rows, or with a query only the rows whose text contains `search` (at most `take`) or whose key is in `ids`. */
export type LookupFinder<K extends number | string = number> = (query: { search?: string; ids?: K[]; take?: number }) => Promise<LookupRow<K>[]>;

export type LookupNames<K extends number | string = number> = {
  /** The name of a key, empty until it arrives; a missing, empty or zero key has none. */
  name: (id: K | string | number | null | undefined) => string;
  /** A row a person picked is known without asking. */
  remember: (rows: LookupRow<K>[]) => void;
};

/**
 * The names of the rows of a parent that is too big for a drop-down. A page asks for the name of a key as it draws it; the keys it has not seen yet are asked for together, once, from the
 * parent's lookup list (`ids`), and the name shows when it arrives.
 */
export function useLookupNames<K extends number | string = number>(find: LookupFinder<K>): LookupNames<K> {
  const [names, setNames] = useState<Record<string, string>>({});
  const asked = useRef(new Set<string>());
  const queue = useRef<K[]>([]);
  const timer = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);

  const remember = (rows: LookupRow<K>[]) => {
    for (const row of rows) asked.current.add(String(row.id));
    setNames((current) => ({ ...current, ...Object.fromEntries(rows.map((row) => [String(row.id), row.name])) }));
  };

  const flush = () => {
    const ids = queue.current.splice(0);
    timer.current = undefined;
    find({ ids }).then(remember).catch(() => {});
  };

  const name = (id: K | string | number | null | undefined): string => {
    if (!id) return '';
    const key = String(id);
    if (key in names) return names[key];
    if (!asked.current.has(key)) {
      asked.current.add(key);
      queue.current.push(id as K);
      timer.current ??= setTimeout(flush, 0);
    }
    return '';
  };

  return { name, remember };
}

/** The names of the keys a grid shows, asked together from a lookup call (100 keys a call), as `{ key: name }`. A grid with no key asks nothing. */
export async function namesOf<K extends number | string = number>(find: LookupFinder<K>, keys: (K | null | undefined)[]): Promise<Record<string, string>> {
  const ids = [...new Set(keys.filter((key): key is K => !!key))];
  const calls: Promise<LookupRow<K>[]>[] = [];
  for (let at = 0; at < ids.length; at += 100) calls.push(find({ ids: ids.slice(at, at + 100) }));
  const parts = await Promise.all(calls);
  return Object.fromEntries(parts.flat().map((row) => [String(row.id), row.name]));
}

/**
 * A box that finds the row of a big parent by what is typed in it: after a short pause it asks the parent's lookup list for the rows whose text contains it and lists a few; picking one sets the key.
 * Typing clears the key, so text that was not picked leaves nothing chosen, and leaving the box without a pick empties it.
 */
export function TypeAheadBox<K extends number | string = number>({ id, label, placeholder, value, names, find, onChange, required }: {
  id?: string;
  label: string;
  placeholder?: string;
  value: K | string | number | null | undefined;
  names: LookupNames<K>;
  find: LookupFinder<K>;
  onChange: (id: K | null) => void;
  required?: boolean;
}) {
  const [typed, setTyped] = useState<string | null>(null);
  const [options, setOptions] = useState<LookupRow<K>[]>([]);
  const [open, setOpen] = useState(false);
  const turn = useRef(0);
  const timer = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);
  const box = useRef<HTMLInputElement>(null);

  // text that was typed and not picked is not an answer: the browser's own required check sees a filled box
  useEffect(() => {
    box.current?.setCustomValidity(required && typed !== null && typed.trim() !== '' && !value ? 'Pick one of the matches.' : '');
  });

  const type = (text: string) => {
    setTyped(text);
    onChange(null);
    clearTimeout(timer.current);
    const wanted = text.trim();
    if (!wanted) {
      setOptions([]);
      setOpen(false);
      return;
    }
    timer.current = setTimeout(() => {
      const mine = ++turn.current;
      find({ search: wanted, take: 10 }).then((rows) => {
        if (mine !== turn.current) return; // a later keystroke asked again: this answer is old
        setOptions(rows);
        setOpen(true);
      }).catch(() => {});
    }, 250);
  };

  const pick = (row: LookupRow<K>) => {
    names.remember([row]);
    clearTimeout(timer.current);
    turn.current++;
    setTyped(null);
    setOptions([]);
    setOpen(false);
    onChange(row.id);
  };

  const leave = () => {
    clearTimeout(timer.current);
    turn.current++;
    setTyped(null);
    setOpen(false);
  };

  return (
    <div className="type-ahead">
      <input
        ref={box}
        type="text"
        id={id}
        role="combobox"
        aria-autocomplete="list"
        aria-expanded={open}
        aria-label={label}
        autoComplete="off"
        placeholder={placeholder}
        required={required}
        value={typed ?? names.name(value)}
        onChange={(event) => type(event.target.value)}
        onBlur={leave}
      />
      {open && (
        <ul className="type-ahead-list" role="listbox">
          {options.map((option) => (
            <li key={String(option.id)} role="option" aria-selected={false} onMouseDown={() => pick(option)}>{option.name}</li>
          ))}
        </ul>
      )}
    </div>
  );
}
@@@FILE src/<#= componentsFolder #>/__tests__/TypeAhead.test.tsx@@@
import { useState } from 'react';
import { act, fireEvent, render, screen } from '@testing-library/react';
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
import { TypeAheadBox, namesOf, useLookupNames } from '../TypeAhead';
import type { LookupFinder } from '../TypeAhead';

const rows = [{ id: 7, name: 'Acme' }, { id: 9, name: 'Acorn' }];

function Harness({ find, required }: { find: LookupFinder; required?: boolean }) {
  const names = useLookupNames(find);
  const [key, setKey] = useState<number | null>(null);
  return (
    <>
      <TypeAheadBox label="Customer" value={key} names={names} find={find} onChange={setKey} required={required} />
      <output data-testid="key">{String(key)}</output>
    </>
  );
}

describe('namesOf', () => {
  it('asks once for the distinct keys, in calls of 100, and answers the names by key', async () => {
    const find = vi.fn<LookupFinder>(async (query) => (query.ids ?? []).map((id) => ({ id, name: `N${id}` })));
    const keys = Array.from({ length: 150 }, (_, i) => i + 1);

    const names = await namesOf(find, [...keys, 1, 2, null, undefined, 0]);

    expect(find.mock.calls.map(([query]) => query.ids?.length)).toEqual([100, 50]);
    expect(names['1']).toBe('N1');
    expect(names['150']).toBe('N150');
  });

  it('asks nothing when the grid shows no key', async () => {
    const find = vi.fn<LookupFinder>().mockResolvedValue([]);

    expect(await namesOf(find, [null, 0])).toEqual({});
    expect(find).not.toHaveBeenCalled();
  });
});

describe('TypeAheadBox', () => {
  beforeEach(() => vi.useFakeTimers());
  afterEach(() => vi.useRealTimers());

  it('asks the lookup list for what was typed after a pause and picks a row by its key', async () => {
    const find = vi.fn<LookupFinder>().mockResolvedValue(rows);
    render(<Harness find={find} />);

    fireEvent.change(screen.getByRole('combobox', { name: 'Customer' }), { target: { value: ' ac ' } });
    expect(find).not.toHaveBeenCalled();
    await act(async () => { await vi.advanceTimersByTimeAsync(250); });

    expect(find).toHaveBeenCalledWith({ search: 'ac', take: 10 });
    fireEvent.mouseDown(screen.getByRole('option', { name: 'Acorn' }));

    expect(screen.getByTestId('key').textContent).toBe('9');
    expect((screen.getByRole('combobox') as HTMLInputElement).value).toBe('Acorn');
  });

  it('clears the key while typing and empties the box when it is left without a pick', async () => {
    const find = vi.fn<LookupFinder>().mockResolvedValue(rows);
    render(<Harness find={find} />);
    const box = screen.getByRole('combobox') as HTMLInputElement;

    fireEvent.change(box, { target: { value: 'zz' } });
    expect(screen.getByTestId('key').textContent).toBe('null');
    fireEvent.blur(box);

    expect(box.value).toBe('');
  });

  it('is invalid while required text was typed and not picked, and valid once a row is picked', async () => {
    const find = vi.fn<LookupFinder>().mockResolvedValue(rows);
    render(<Harness find={find} required />);
    const box = screen.getByRole('combobox') as HTMLInputElement;

    fireEvent.change(box, { target: { value: 'ac' } });
    expect(box.validity.customError).toBe(true);
    expect(box.validationMessage).toBe('Pick one of the matches.');

    await act(async () => { await vi.advanceTimersByTimeAsync(250); });
    fireEvent.mouseDown(screen.getByRole('option', { name: 'Acme' }));

    expect(box.validity.customError).toBe(false);
  });

  it('asks nothing for blank text', async () => {
    const find = vi.fn<LookupFinder>().mockResolvedValue(rows);
    render(<Harness find={find} />);

    fireEvent.change(screen.getByRole('combobox'), { target: { value: '   ' } });
    await act(async () => { await vi.advanceTimersByTimeAsync(500); });

    expect(find).not.toHaveBeenCalled();
  });
});
@@@FILE src/setupTests.ts@@@
import '@testing-library/jest-dom';
