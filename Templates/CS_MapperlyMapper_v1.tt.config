# Restriction checkboxes for CS_MapperlyMapper_v1.tt (see Docs/Reference.md section 3).
# Maps the entity to its transfer class and back: the entity needs a primary key.
RequiresPrimaryKey=true
TableOnly=false
# Name the file like the class: Customer -> CustomerMapper.cs
OutputName={Table}Mapper.cs
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso.
Stacks=Api
PlanTables=Entity
OutputFolder=Mappers
InPlan=false
