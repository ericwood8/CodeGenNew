# Restriction checkboxes for PY_EssentialAuth_v1.tt (see Docs/Reference.md section 3).
# One of the files a Python API can have: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`;
# a project that says ApiAuth=true gets it with every `codegen generate --essentials`.
Scope=None
Stacks=Python
EssentialsGroup=Jwt
EssentialsDefault=false
Description=Sign-in (ApiAuth=true): app/auth.py (POST /api/auth/login, the bearer check, password hashing, the owner scope)
