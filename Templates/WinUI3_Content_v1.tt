<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string repositoryNamespace = "MyApp.Common.Repositories";
    string contextType = "MyAppContext";
    string[] usings = { };   // namespaces the generated file must "using" (the context's)
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    contextType = Project.ContextName ?? contextType;
    repositoryNamespace = Project.RepoNamespace ?? repositoryNamespace;
    usings = Project.Usings ?? usings;
    // ==========================================================================================

    // ==========================================================================================
    // WinUI3_Content_v1.tt
    // Generates: Content.cs   (see OutputName in WinUI3_Content_v1.tt.config)
    // The rules of the project's ContentTables for the desktop app, which reads the database itself and so never meets the API's: one static class per table, <Table>Content, with the same MakeSlug and PrepareAsync the API
    // writes (ContentRulesWriter). The dialogs call PrepareAsync before a row is saved: the slug is made from the title when it is blank, kept when the title changes and numbered when it is taken, and a new row is a draft.
    // The list page changes the status itself (Publish, Unpublish and Archive). Written only when the project lists a content table (the plan adds it).
    // Full notes: Docs/TemplateNotes/API_RowShapes_v1.md
    // ==========================================================================================

    var problems = Database.Tables.Select(t => ContentPlan.Problem(t, Project)).OfType<string>().ToList();
    problems.AddRange(ContentPlan.Entries(Project).Where(e => !Database.Tables.Any(t => t.TableName.EqualsIgnoreCase(e.Table))).Select(e => $"ContentTables: {e.Table} is not a table of the database."));
    if (problems.Count > 0)
    {
        Error(string.Join(" | ", problems));
    }
    else if (Database.Tables.Any(t => TableShapes.For(t, Project).Content is not null))
    {
        var sb = new StringBuilder();
        void Line(string text = "") => sb.Append(text).Append('\n');

        Line($"namespace {repositoryNamespace};");
        Line();
        foreach (string u in usings)
            Line($"using {u};");
        Line("using Microsoft.EntityFrameworkCore;");
        Line();
        foreach (var table in Database.Tables.OrderBy(t => t.TableName, StringComparer.OrdinalIgnoreCase))
        {
            if (TableShapes.For(table, Project).Content is not { } content)
                continue;
            Line($"/// <summary> The content rules of {table.TableName} (ContentTables): the slug and the status, the same code the API writes. Generated by WinUI3_Content. </summary>");
            Line($"public static class {table.TableName}Content");
            Line("{");
            sb.Append(ContentRulesWriter.Members(content, contextType));
            Line("}");
            Line();
        }
        Write(sb.ToString());
    }
#>
