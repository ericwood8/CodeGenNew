# Restriction checkboxes for API_EssentialTests_v1.tt (see Docs/Reference.md section 3).
# The test project the per-table API_Test classes live in: no table and no database, only the project settings. Writes nothing unless the project sets ApiTests=true.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Api
OutputRoot=ApiTests
EssentialsGroup=Tests
Description=The API test project (.csproj, ApiFixture.cs, GlobalUsings.cs) for the API_Test classes; only with ApiTests=true
