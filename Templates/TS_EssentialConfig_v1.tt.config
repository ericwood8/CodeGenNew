# Restriction checkboxes for TS_EssentialConfig_v1.tt (see Docs/Reference.md section 3).
# One of the files every Angular app needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Angular
EssentialsGroup=Config
Description=app.config.ts (HttpClient, the router) and proxy.conf.json (/api to the API)
