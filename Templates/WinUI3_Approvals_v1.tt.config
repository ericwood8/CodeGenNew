# Restriction checkboxes for WinUI3_Approvals_v1.tt (see Docs/Reference.md section 3).
# One set of files for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# No OutputName: the template writes its own paths (Repositories/ApprovalSupport.cs, Repositories/ApprovalService.cs, Views/ApprovalsPage.cs) with @@@FILE markers.
# Whole-project generation (codegen generate): written only for a project with RowApprovals (and ApiAuth).
Stacks=WinUI3
InPlan=false
