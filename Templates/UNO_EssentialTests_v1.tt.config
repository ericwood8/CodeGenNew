# Restriction checkboxes for UNO_EssentialTests_v1.tt (see Docs/Reference.md section 3).
# The test project the per-table UNO_Test classes live in: no table and no database, only the project settings. Writes nothing unless the project sets DesktopTests=true.
Scope=None
Stacks=Uno
OutputRoot=UnoTests
EssentialsGroup=Tests
Description=The Uno view-model test project (.csproj, FakeApi.cs, TestJson.cs, PlatformShims.cs) for the UNO_Test classes; only with DesktopTests=true
