<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Globalization" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#@ import namespace="static CodeGenNew.Core.TemplateHelpers" #>
<#
    // ==========================================================================================
    // PY_Validate_v1.tt
    // Generates: app/validation/<table>.py   (the template writes its own path with an @@@FILE marker; the output folder is the Python API's folder)
    // The rules the schema states for a row, as a function: required text, the longest length, the values a CHECK list or an enum allows, an email, phone or URL shape by the column's name, and
    // the range a CHECK or the column's name gives a number. The rules are ColumnRules (Core), the same list CS_Validator, RS_Validate and the TypeScript validators follow. Written for a project
    // with ApiValidation=true; the create and update routes answer 400 with every problem in the ASP.NET validation-problem form. No package is needed.
    // Full notes: Docs/TemplateNotes/PY_Validate_v1.md
    // ==========================================================================================

    var t = PythonTable.Of(Model, Project);
    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');
    string Str(string text) => PythonNames.Str(text);

    var checks = new List<string>();
    var shapes = new HashSet<string>();
    bool anyFuture = false;
    foreach (var f in t.SchemaFields)
    {
        var rule = f.Column.RuleOf(Project, Model.TableName);
        if (rule is null || f.ReadOnly)
            continue;
        string label = Labels.Words(f.Column.Name);
        string property = f.Column.Name;
        string value = $"row.{f.Name}";
        var body = new List<string>();
        if (f.Annotation == "str")
        {
            if (rule.Required && !f.IsNullable)
                body.Add($"if not {value}.strip():\n    problems.append(({Str(property)}, {Str(RuleMessages.Required(label))}))");
            if (rule.MaxLength > 0)
                body.Add($"if len({value}) > {rule.MaxLength}:\n    problems.append(({Str(property)}, {Str(RuleMessages.MaxLength(label, rule.MaxLength))}))");
            if (rule.Choices is { Count: > 0 } choices)
                body.Add($"if {value} and {value} not in ({string.Join(", ", choices.Select(Str))},):\n    problems.append(({Str(property)}, {Str(RuleMessages.Choices(label, choices))}))");
            if (rule.Shape == TextShape.Custom)
            {
                shapes.Add("matches_pattern");
                body.Add($"if {value} and not matches_pattern({value}, {Str(rule.Pattern!)}):\n    problems.append(({Str(property)}, {Str(RuleMessages.Shape(label, rule))}))");
            }
            else if (rule.Shape != TextShape.None)
            {
                string function = RuleMessages.ShapeFunction(rule.Shape);
                shapes.Add(function);
                body.Add($"if {value} and not {function}({value}):\n    problems.append(({Str(property)}, {Str(RuleMessages.Shape(label, rule.Shape))}))");
            }
        }
        else if (rule.NotFuture && f.Annotation is "date" or "datetime")
        {
            anyFuture = true;
            string day = f.Annotation == "datetime" ? $"{value}.date()" : value;
            body.Add($"if {value} is not None and {day} > date.today():\n    problems.append(({Str(property)}, {Str(RuleMessages.NotFuture(label))}))");
        }
        else if (rule.HasRange && f.Annotation is "int" or "float" or "Decimal")
        {
            if (rule.Min is { } min)
                body.Add($"if {value} is not None and float({value}) {(rule.MinStrict ? "<=" : "<")} {Num(min)}:\n    problems.append(({Str(property)}, {Str(RuleMessages.AtLeast(label, min, rule.MinStrict))}))");
            if (rule.Max is { } max)
                body.Add($"if {value} is not None and float({value}) {(rule.MaxStrict ? ">=" : ">")} {Num(max)}:\n    problems.append(({Str(property)}, {Str(RuleMessages.AtMost(label, max, rule.MaxStrict))}))");
        }
        // a nullable text column is only checked when it has a value, and on an update only when the value is not the stored one
        var fieldChecks = body.Select(b => f.Annotation == "str" && f.IsNullable ? $"if {value} is not None:\n" + string.Join("\n", b.Split('\n').Select(l => "    " + l)) : b).ToList();
        if (fieldChecks.Count > 0)
            checks.Add($"if stored is None or {value} != stored.{f.Name}:\n" + string.Join("\n", fieldChecks.SelectMany(c => c.Split('\n')).Select(l => "    " + l)));
    }

    // a date that must not be earlier than another date of the row (an end and its start); checked when either changed
    foreach (var pair in DatePairs.For(Model, Project))
    {
        var start = t.SchemaFields.FirstOrDefault(x => x.Column.Name == pair.Start.Name);
        var end = t.SchemaFields.FirstOrDefault(x => x.Column.Name == pair.End.Name);
        if (start is null || end is null || start.ReadOnly || end.ReadOnly || start.Annotation is not ("date" or "datetime") || end.Annotation is not ("date" or "datetime"))
            continue;
        string Day(string name, string annotation) => annotation == "datetime" ? $"row.{name}.date()" : $"row.{name}";
        checks.Add($"if stored is None or row.{start.Name} != stored.{start.Name} or row.{end.Name} != stored.{end.Name}:\n    if row.{start.Name} is not None and row.{end.Name} is not None and {Day(end.Name, end.Annotation)} < {Day(start.Name, start.Annotation)}:\n        problems.append(({Str(pair.End.Name)}, {Str(pair.Message)}))");
    }

    Line($"@@@FILE app/validation/{t.Module}.py@@@");
    if (anyFuture)
        Line("from datetime import date");
    Line($"from app.schemas.{t.Module} import {t.Schema}");
    var support = new List<string> { "ApiValidationError" };
    support.AddRange(shapes.OrderBy(s => s, StringComparer.Ordinal));
    Line($"from app.support import {string.Join(", ", support)}");
    Line();
    Line();
    Line($"def validate(row: {t.Schema}, stored: object | None = None) -> None:");
    Line("    \"\"\"Checks the row against what the schema says: required, length, allowed values, shape and range. The error carries every problem, by property name. On an update `stored` is the row as it is now: a value that has not changed is not checked again, so a stored value that breaks a rule does not stop an edit of another column.\"\"\"");
    if (checks.Count == 0)
    {
        Line("    return");
    }
    else
    {
        Line("    problems: list[tuple[str, str]] = []");
        foreach (string check in checks)
            foreach (string line in check.Split('\n'))
                Line("    " + line);
        Line("    if problems:");
        Line("        raise ApiValidationError(problems)");
    }
    Write(sb.ToString());
#>
