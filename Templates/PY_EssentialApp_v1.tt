<#
    // ==========================================================================================
    // PY_EssentialApp_v1.tt
    // Generates: app/__init__.py, app/db.py, app/support.py and app/main.py   (no table, no database: an essentials group; the output folder is the Python API's own folder)
    // The files every generated Python API needs, written once and kept (they are edited by hand afterwards). db.py: the declarative Base, the engine and the session, built from the project's
    // DatabaseProvider, DatabaseServer, DatabaseName and DatabaseUser, or from DATABASE_URL; the password is never written: it is read from PGPASSWORD (PostgreSQL), MYSQL_PWD (MySQL) or
    // DB_PASSWORD (SQL Server). support.py: ApiError, the validation problems in the ASP.NET problem form, Page (the search answer), the JSON form of a decimal, the LIKE escape, suggest_free
    // (a free unique value for a clone) and the shape checks of the validators. main.py: the FastAPI app with every router (routes.routers), the error handlers and CORS for the front ends' dev servers.
    // Settings: DatabaseProvider, DatabaseServer, DatabaseName, DatabaseUser, ProjectTitle, Stacks.
    // ==========================================================================================
    var dialect = Project.DatabaseDialect;
    string user = Project.DatabaseUser ?? "";
    string server = Project.DatabaseServer ?? "localhost";
    string portFlag = new string((char)45, 2) + "port";   // a template line may not hold two hyphens in a row (see TemplateDashTests)
    string Str(string text) => PythonNames.Str(text);
    var stacks = Project.Stacks.Where(s => s.Equals("React", StringComparison.OrdinalIgnoreCase) || s.Equals("Angular", StringComparison.OrdinalIgnoreCase) || s.Equals("Blazor", StringComparison.OrdinalIgnoreCase)).ToList();
    if (stacks.Count == 0) stacks = ["React"];
    string origins = string.Join(", ", stacks.Select(s => Str($"http://localhost:{Project.DevPort(s)}")));
#>
