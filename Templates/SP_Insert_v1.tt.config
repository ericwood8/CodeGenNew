# Restriction checkboxes for SP_Insert_v1.tt (see Docs/Reference.md section 3).
# Insert doesn't require a primary key -- a table can be inserted into without one.
RequiresPrimaryKey=false
TableOnly=true
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Api,WinUI3
PlanTables=Entity
OutputRoot=Sql
InPlan=false
