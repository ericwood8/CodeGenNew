# Restriction checkboxes for CS_DtoInput_v1.tt (see Docs/Reference.md section 3).
# The input class is for the entity class, which needs a key.
# Name the file like the class: Customer -> CustomerInput.cs
OutputName={Table}Input.cs
# Whole-project generation (codegen generate): the project's Dtos=true adds the template to the plan for the tables whose API takes it.
Stacks=Api
PlanTables=Dto
OutputFolder=Dtos
InPlan=false
