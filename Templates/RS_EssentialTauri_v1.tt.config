# Restriction checkboxes for RS_EssentialTauri_v1.tt (see Docs/Reference.md section 3).
# An optional file group for the Rust API: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials --stack rust --groups Tauri`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Rust
EssentialsGroup=Tauri
EssentialsDefault=false
Description=desktop/: a Tauri 2 shell that runs the API inside the app and shows the built front end in a window (Windows, macOS, Linux)
Needs=src/lib.rs
