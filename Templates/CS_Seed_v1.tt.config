# Restriction checkboxes for CS_Seed_v1.tt (see Docs/Reference.md section 3).
# The seed class is for the entity class, which needs a key.
# The class IS the table's rows, so the rows must be read.
NeedsRowData=true
# Name the file like the class: Region -> RegionSeed.cs
OutputName={Table}Seed.cs
# Whole-project generation (codegen generate): the project's SeedTables names the tables; the setting adds the template to the plan.
Stacks=Api
PlanTables=Seed
OutputFolder=Seeding
InPlan=false
