# Restriction checkboxes for TS_EssentialCrud_v1.tt (see Docs/Reference.md section 3).
# Two of the files every generated Angular app needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Angular
EssentialsGroup=Crud
Description=services/crud.service.ts and components/crud-screen.ts: the bases of the generated services and screens (CrudService, NamedCrudService, CrudScreen, PagedCrudScreen)
