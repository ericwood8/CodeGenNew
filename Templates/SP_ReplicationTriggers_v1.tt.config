# Restriction checkboxes for SP_ReplicationTriggers_v1.tt (see Docs/Reference.md section 3).
# Needs a primary key (a replicated update or delete names the row by it). It writes T-SQL triggers, so a table read from another database is refused.
RequiresPrimaryKey=true
TableOnly=true
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso (and its targets in ReplicationTargets).
Stacks=Api,WinUI3
PlanTables=Entity
OutputRoot=Sql
InPlan=false
Dialects=SqlServer
