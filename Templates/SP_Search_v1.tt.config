# Restriction checkboxes for SP_Search_v1.tt (see Docs/Reference.md section 3).
# The result set needs something stable for a caller to act on, and the primary key is the final ORDER BY
# tiebreaker, so a table with none wouldn't return anything usable.
RequiresPrimaryKey=true
TableOnly=true
# The sort by a foreign key column orders by the parent's display column (what the grid shows), so the parents' display columns must be looked up.
NeedsReferencedDisplayColumns=true
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Api,WinUI3
PlanTables=Search
OutputRoot=Sql
