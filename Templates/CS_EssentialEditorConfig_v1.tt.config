# Restriction checkboxes for CS_EssentialEditorConfig_v1.tt (see Docs/Reference.md section 3).
# One of the files every app of a stack needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Api,WinUI3
EssentialsGroup=EditorConfig
Description=.editorconfig (the style rules the generated C# follows, as IDE warnings) and .gitignore for a .NET project
