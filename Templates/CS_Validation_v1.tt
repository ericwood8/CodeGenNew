<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Text.RegularExpressions" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names,
    // lists of tables). Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string entityNamespace = "MyApp.Common.Entities";
    // Namespaces the generated file must "using" (for example "MyApp.Entities"; leave empty when the project supplies them through
    // global usings). Each entry becomes a using line in the generated file.
    string[] usings = { };
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    entityNamespace = Project.EntityNamespace ?? entityNamespace;
    usings = Project.Usings ?? usings;
    // ==========================================================================================

    // ==========================================================================================
    // CS_Validation_v1.tt
    // Generates: <TableName>Validation.cs   (see OutputName in CS_Validation_v1.tt.config)
    // A validation "buddy" class: [Required], [StringLength], [DataType], [Display] and [Range] on a separate <Table>Metadata class attached to the
    // entity with [MetadataType], so it works for a generated or a hand-maintained entity without editing either. [Required] is the runtime check
    // the entity's C# required modifier is not. The ranges come from the column's name and type (a year, a month, a percentage).
    // Full notes: Docs/TemplateNotes/CS_Validation_v1.md

    var validatedColumns = Model.Columns
        .Where(c => !c.IsComputed && !c.IsAuditColumn && !(c.IsPrimaryKey && c.IsIdentity))
        .ToList();

    if (validatedColumns.Count == 0)
        Error($"CS_Validation cannot generate from [{Model.SchemaName}].[{Model.TableName}]: every column is computed, audit-classified, or an identity primary key, leaving nothing to validate.");

    // ==== naming helpers (same as CS_Entity.tt, kept local rather than shared - every template here is a
    // standalone .tt file with no code shared between templates)
    string Id(ColumnModel c) => c.IsCSharpReservedWordName ? "@" + c.Name : c.Name;
    string Words(string name, bool isBit)
    {
        string s = name;
        if (isBit && Regex.IsMatch(s, "^Is[A-Z]")) s = s.Substring(2);
        s = s.Replace('_', ' ');
        s = Regex.Replace(s, "(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])", " ");
        return Regex.Replace(s, " +", " ").Trim();
    }
    string Str(string s) => s.Replace("\\", "\\\\").Replace("\"", "\\\"");

    string ClrType(ColumnModel c)
    {
        string t = c.SqlType switch
        {
            SqlDbType.Int => "int",
            SqlDbType.BigInt => "long",
            SqlDbType.SmallInt => "short",
            SqlDbType.TinyInt => "byte",
            SqlDbType.Bit => "bool",
            SqlDbType.Decimal or SqlDbType.Money or SqlDbType.SmallMoney => "decimal",
            SqlDbType.Float => "double",
            SqlDbType.Real => "float",
            SqlDbType.Date or SqlDbType.DateTime or SqlDbType.DateTime2 or SqlDbType.SmallDateTime => "DateTime",
            SqlDbType.DateTimeOffset => "DateTimeOffset",
            SqlDbType.Time => "TimeSpan",
            SqlDbType.UniqueIdentifier => "Guid",
            SqlDbType.Char or SqlDbType.VarChar or SqlDbType.NChar or SqlDbType.NVarChar or SqlDbType.Text or SqlDbType.NText or SqlDbType.Xml => "string",
            SqlDbType.Binary or SqlDbType.VarBinary or SqlDbType.Image or SqlDbType.Timestamp => "byte[]",
            _ => "object"
        };
        return c.IsNullable ? t + "?" : t;
    }

    string? SemanticDataType(ColumnModel c, bool multiline)
    {
        if (c.Name.ContainsIgnoreCase("Email")) return "DataType.EmailAddress";
        if (c.Name.ContainsIgnoreCase("Password")) return "DataType.Password";
        if (c.Name.ContainsIgnoreCase("Phone")) return "DataType.PhoneNumber";
        return multiline ? "DataType.MultilineText" : null;
    }

    var o = new StringBuilder();
    void L(string s = "") => o.Append(s).Append('\n');
    var body = new StringBuilder();
    void B(string s = "") => body.Append(s).Append('\n');

    bool first = true;
    foreach (var c in validatedColumns)
    {
        if (!first) B();
        first = false;

        bool isBit = c.SqlType == SqlDbType.Bit;
        string words = Str(Words(c.Name, isBit));
        int chars = c.MaxLength is null ? 0 : (c.SqlType is SqlDbType.NChar or SqlDbType.NVarChar ? c.MaxLength.Value / 2 : c.MaxLength.Value);
        bool isText = c.SqlType is SqlDbType.Char or SqlDbType.VarChar or SqlDbType.NChar or SqlDbType.NVarChar;
        bool multiline = isText && chars >= 100;
        string? dataType = SemanticDataType(c, multiline);

        if (!c.IsNullable) B("    [Required]");
        B($"    [Display(Name = \"{words}\", Description = \"{words}\")]");
        if (isText && chars > 0) B($"    [StringLength({chars})]");
        if (dataType is not null) B($"    [DataType({dataType})]");
        // A whole-number column whose name says what it holds (a year, a month, a percentage, ...) gets that range; every other
        // integer keeps the plain limits of its SQL type, which a [Range] would only repeat.
        // (a CHECK constraint of the database says the same for any numeric column; a decimal gets it as double bounds)
        if ((c.NumericKind != NumericKind.None || c.Check is not null) && Project.RangeFor(c) is { } range) B($"    [Range({range.Min}, {range.Max})]");
        else if (c.Check is { } check && !c.IsIntegerColumn && c.IsNumericColumn)
            B($"    [Range({(check.Min is { } lo ? lo.ToString("0.########", System.Globalization.CultureInfo.InvariantCulture) : "double.MinValue")}, {(check.Max is { } hi ? hi.ToString("0.########", System.Globalization.CultureInfo.InvariantCulture) : "double.MaxValue")})]");
        B($"    public {ClrType(c)} {Id(c)} {{ get; set; }}");
    }

    var headUsings = usings.ToList();
    headUsings.Insert(0, "System.ComponentModel.DataAnnotations");
    foreach (string u in headUsings) L($"using {u};");
    L();
    L($"namespace {entityNamespace};");
    L();
    string tableIdentifier = (Model.IsCSharpReservedWordName ? "@" : "") + Model.TableName;
    L($"[MetadataType(typeof({Model.TableName}Metadata))]");
    L($"public partial class {tableIdentifier}");
    L("{");
    L("}");
    L();
    L($"public class {Model.TableName}Metadata");
    L("{");
    o.Append(body);
    L("}");
    Write(o.ToString());
#>
