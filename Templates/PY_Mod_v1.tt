<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PY_Mod_v1.tt
    // Generates: app/models/__init__.py, app/schemas/__init__.py, app/routes/__init__.py and, with ApiValidation=true, app/validation/__init__.py   (whole-database; the paths are written by the template)
    // The package lists of the API: the models are all imported (so SQLAlchemy knows every table), and routes.routers is the list of every table's router, which main.py includes. A new table is a
    // regenerate; main.py lists nothing. With Dashboard=true the list also holds the dashboard router (PY_Dashboard). The tables are those that have an API (a single int, uniqueidentifier or text key, not a name/active table, not an enum).
    // Full notes: Docs/TemplateNotes/PY_Routes_v1.md
    // ==========================================================================================

    var tables = Database.PythonRustApiTables(Project)
        .Select(t => PythonTable.Of(t, Project)).OrderBy(t => t.Module, StringComparer.Ordinal).ToList();
    if (tables.Count == 0)
        Error("PY_Mod found no table to list: none has an API of its own with a single int, uniqueidentifier or text key.");

    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');

    Line("@@@FILE app/models/__init__.py@@@");
    Line("# Generated by PY_Mod: every model is imported, so Base.metadata knows every table.");
    foreach (var t in tables)
        Line($"from app.models.{t.Module} import {t.Class}  # noqa: F401");
    Line("@@@FILE app/schemas/__init__.py@@@");
    Line("# Generated by PY_Mod: the request and response schemas, one module per table.");
    if (Project.ApiValidation)
    {
        Line("@@@FILE app/validation/__init__.py@@@");
        Line("# Generated by PY_Mod: the rules of every table, one module per table (PY_Validate).");
    }
    // the dashboard (PY_Dashboard) is one route file for the whole database, listed with the tables' routers
    // and so are the routes of the many-to-many junction tables (PY_Junction)
    var junctionModules = Database.Tables.Where(t => t.IsJunctionTable).Select(t => PythonNames.Snake(t.TableName) + "_junction");
    var modules = tables.Select(t => t.Module).Concat(junctionModules).ToList();
    if (Project.Dashboard)
        modules.Add("dashboard");
    modules = modules.OrderBy(m => m, StringComparer.Ordinal).ToList();
    // the CSV routes (PY_Csv) come first: a table's /{id} route would otherwise read export.csv as a key
    if (Project.ApiCsv)
        modules.Insert(0, "csv_files");
    // so are the approval routes (PY_Approvals): /api/<table>/toapprove would be read as a key and refused
    if (Project.ApiAuth && ApprovalPlan.Resolve(Database, Project).Tables.Count > 0)
        modules.Insert(0, "approvals");
    // the tenant routes (PY_Tenants) are one more router
    if (PythonTenantWriter.Applies(Project) && TenantPlan.TenantTableOf(Database, Project) is not null)
        modules.Insert(0, "tenancy");
    // and the queue routes (PY_Queue): /api/<table>/stats and /claim would be read as a key and refused
    if (Database.Tables.Any(t => QueuePlan.For(t, Project) is not null))
        modules.Insert(0, "queue");
    Line("@@@FILE app/routes/__init__.py@@@");
    Line("# Generated by PY_Mod: the router of every table; main.py includes them all.");
    foreach (string module in modules)
        Line($"from app.routes import {module}");
    Line();
    Line("routers = [");
    foreach (string module in modules)
        Line($"    {module}.router,");
    Line("]");
    Write(sb.ToString());
#>
