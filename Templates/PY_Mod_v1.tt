<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PY_Mod_v1.tt
    // Generates: app/models/__init__.py, app/schemas/__init__.py, app/routes/__init__.py and, with ApiValidation=true, app/validation/__init__.py   (whole-database; the paths are written by the template)
    // The package lists of the API: the models are all imported (so SQLAlchemy knows every table), and routes.routers is the list of every table's router, which main.py includes. A new table is a
    // regenerate; main.py lists nothing. The tables are those that have an API (a single int, uniqueidentifier or text key, not a name/active table, not an enum).
    // Full notes: Docs/TemplateNotes/PY_Routes_v1.md
    // ==========================================================================================

    var tables = Database.CrudApiTables(Project)
        .Select(t => PythonTable.Of(t, Project)).OrderBy(t => t.Module, StringComparer.Ordinal).ToList();
    if (tables.Count == 0)
        Error("PY_Mod found no table to list: none has an API of its own with a single int, uniqueidentifier or text key.");

    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');

    Line("@@@FILE app/models/__init__.py@@@");
    Line("# Generated by PY_Mod: every model is imported, so Base.metadata knows every table.");
    foreach (var t in tables)
        Line($"from app.models.{t.Module} import {t.Class}  # noqa: F401");
    Line("@@@FILE app/schemas/__init__.py@@@");
    Line("# Generated by PY_Mod: the request and response schemas, one module per table.");
    if (Project.ApiValidation)
    {
        Line("@@@FILE app/validation/__init__.py@@@");
        Line("# Generated by PY_Mod: the rules of every table, one module per table (PY_Validate).");
    }
    Line("@@@FILE app/routes/__init__.py@@@");
    Line("# Generated by PY_Mod: the router of every table; main.py includes them all.");
    foreach (var t in tables)
        Line($"from app.routes import {t.Module}");
    Line();
    Line("routers = [");
    foreach (var t in tables)
        Line($"    {t.Module}.router,");
    Line("]");
    Write(sb.ToString());
#>
