# Restriction checkboxes for API_EssentialProgram_v1.tt (see Docs/specs.md section 5.3).
# One of the files every web API needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Api
EssentialsGroup=Program
Description=The .csproj, Program.cs, appsettings.json (connection string, no password, the port) and GlobalUsings.cs
