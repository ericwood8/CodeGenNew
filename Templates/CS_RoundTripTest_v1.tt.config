# Restriction checkboxes for CS_RoundTripTest_v1.tt (see Docs/Reference.md section 3).
# The transfer class needs no key; the mapper tests are written only for a table that has one.
# Name the file like the table: Customer -> CustomerRoundTripTests.cs
OutputName={Table}RoundTripTests.cs
# Whole-project generation (codegen generate): for a project that sets ApiTests=true and Dtos=true. The files go to the test project, not the API.
Stacks=Api
PlanTables=Dto
OutputRoot=ApiTests
InPlan=false
