<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // BLZ_Client_v1.tt
    // Generates: Services/<Table>Client.cs   (the path is written by the template; point the output folder at the Blazor app's folder)
    // The Blazor counterpart of TSX_Api: a class over the app's HttpClient with GetAll, GetPage (search, paging, sort), Get, Create, Update, Delete and, for a cloneable table, Clone.
    // A failed call throws ApiException with the HTTP status (Services/ApiSupport.cs, the Support essentials group). The BaseAddress of the HttpClient is the API (wwwroot/appsettings.json).
    // Full notes: Docs/TemplateNotes/BLZ_Client_v1.md
    // ==========================================================================================

    if (BlazorNames.Refusal(Model, Project) is { } reason)
    {
        Error($"BLZ_Client writes no client for [{Model.SchemaName}].[{Model.TableName}]: {reason}");
    }
    else
    {
        string type = BlazorNames.TypeName(Model.TableName);
        Write($"@@@FILE Services/{type}Client.cs@@@\n" + ApiClientCode.Client(Model, Project, BlazorNames.Namespace(Project) + ".Models", BlazorNames.Namespace(Project) + ".Services", EditableChild.Lists(Model, Project)));
    }
#>
