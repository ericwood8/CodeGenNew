<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // RS_Mod_v1.tt
    // Generates: src/models/mod.rs, src/repos/mod.rs, src/routes/mod.rs and, with ApiValidation=true, src/validation/mod.rs   (whole-database; the output folder is the Rust crate's folder)
    // The module lists of the Rust crate and the router that merges the router of every table, so main.rs lists nothing: a new table is a regenerate. The tables are those that have an API.
    // With Dashboard=true the router also merges the dashboard's (src/routes/dashboard.rs, RS_Dashboard).
    // Full notes: Docs/TemplateNotes/RS_Mod_v1.md
    // ==========================================================================================

    var modules = Database.PythonRustApiTables(Project).Select(t => RustNames.Snake(t.TableName)).OrderBy(m => m, StringComparer.Ordinal).ToList();
    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');

    void ModuleList(string folder)
    {
        Line($"@@@FILE src/{folder}/mod.rs@@@");
        foreach (string m in modules)
            Line($"pub mod {m};");
    }

    ModuleList("models");
    ModuleList("repos");
    if (Project.ApiValidation)
        ModuleList("validation");

    Line("@@@FILE src/routes/mod.rs@@@");
    Line("use axum::Router;");
    Line("use crate::support::Pool;");
    Line();
    // the dashboard (RS_Dashboard) is one route file for the whole database, merged with the tables' routers
    var routeModules = modules.Concat(Database.Tables.Where(t => t.IsJunctionTable && !FeatureFlagTables.IsPlanLinkTable(Project, t.TableName)).Select(t => RustNames.Snake(t.TableName) + "_junction")).ToList();
    if (Project.Dashboard)
        routeModules.Add("dashboard");
    routeModules = routeModules.OrderBy(m => m, StringComparer.Ordinal).ToList();
    if (Project.ApiCsv)
        routeModules.Add("csv_files");
    // the gates (RS_Gates) answer GET <route>/guards and hold the checks the tables' routes call
    if (Project.ApiAuth && (Project.ChangeGates is not null || Project.GuardedColumns is not null))
        routeModules.Add("gates");
    // the approval routes (RS_Approvals) are one route file for the whole database
    // the queue routes (RS_Queue) too; axum prefers their fixed paths (stats, claim) to a table's /{id}
    if (Database.Tables.Any(t => TableShapes.For(t, Project).Queue is not null))
        routeModules.Add("queue");
    // and the upload and download routes of the asset tables (RS_Assets)
    if (Database.Tables.Any(t => TableShapes.For(t, Project).Asset is not null))
        routeModules.Add("asset_files");
    // and the checks of the polymorphic links (RS_Links), which have no routes of their own
    if (RustLinkWriter.Links(Database, Project).Count > 0)
        routeModules.Add("link_rules");
    // and the inbound event routes (RS_Inbound); its receive routes are merged by main.rs after the sign-in check
    if (Database.Tables.Any(t => TableShapes.For(t, Project).Inbound is not null))
        routeModules.Add("inbound");
    // and the token routes (RS_Token)
    if (Project.ApiAuth && Database.Tables.Any(t => TableShapes.For(t, Project).Token is not null))
        routeModules.Add("tokens");
    // and the usage ledger routes (RS_Usage)
    if (Project.ApiAuth && Database.Tables.Any(t => TableShapes.For(t, Project).Usage is not null))
        routeModules.Add("usage");
    if (Project.ApiAuth && ApprovalPlan.Resolve(Database, Project).Tables.Count > 0)
        routeModules.Add("approvals");
    foreach (string m in routeModules)
        Line($"pub mod {m};");
    Line();
    Line("/// The routes of every table, merged.");
    Line("pub fn router() -> Router<Pool> {");
    Line("    Router::new()");
    foreach (string m in routeModules)
        Line($"        .merge({m}::router())");
    // TenantTable: GET /api/auth/tenants and POST /api/auth/switch-tenant (RS_Tenants, src/tenancy.rs)
    if (RustTenantWriter.Applies(Project) && TenantPlan.TenantTableOf(Database, Project) is not null)
        Line("        .merge(crate::tenancy::router())");
    // SubscriptionTable: GET /api/subscription and PUT /api/subscription/{tenant_id} (RS_Subscriptions, src/subscriptions.rs)
    if (RustSubscriptionWriter.Applies(Project) && TenantPlan.TenantTableOf(Database, Project) is not null)
        Line("        .merge(crate::subscriptions::router())");
    // FeatureTables: GET /api/features and PUT /api/features/{name} (RS_Features, src/features.rs)
    if (RustFeatureWriter.PlanOf(Database, Project) is not null)
        Line("        .merge(crate::features::router())");
    // UserTable: PUT /api/auth/password and the members of a tenant (RS_UserDirectory, src/people.rs)
    if (Project.ApiAuth && Project.UserTable is not null)
        Line("        .merge(crate::people::router())");
    Line("}");
    // ContentTables: the public reads of a content table are left out of the sign-in check, so main.rs merges them after it
    var contentModules = Project.ApiAuth ? modules.Where(m => Database.PythonRustApiTables(Project).Any(t => RustNames.Snake(t.TableName) == m && TableShapes.For(t, Project).Content is not null)).ToList() : [];
    if (contentModules.Count > 0)
    {
        Line();
        Line("/// The public reads of the content tables, merged after the sign-in check.");
        Line("pub fn public_router() -> Router<Pool> {");
        Line("    Router::new()");
        foreach (string m in contentModules)
            Line($"        .merge({m}::public_router())");
        Line("}");
    }
    if (Project.WantsUsageSchedule)
    {
        Line();
        Line("/// Starts the work that runs while the API is up (UsageRollupHours).");
        Line("pub fn start_background(pool: Pool) {");
        Line(UsagePlan.HasSchedule(Database, Project) && routeModules.Contains("usage") ? "    usage::start_roll_up(pool);" : "    let _ = pool;");
        Line("}");
    }
    Write(sb.ToString());
#>
