# Restriction checkboxes for WinUI3_Members_v1.tt (see Docs/Reference.md section 3).
# One set of files for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# No OutputName: the template writes its own paths (Views/MembersPage.xaml and Views/MembersPage.xaml.cs) with @@@FILE markers.
# Whole-project generation (codegen generate): written only for a project with the desktop sign-in, a TenantTable and a TenantMembership.
Stacks=WinUI3
InPlan=false
