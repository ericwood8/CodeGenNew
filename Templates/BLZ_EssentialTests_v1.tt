<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // BLZ_EssentialTests_v1.tt
    // Generates: <ProjectName>.Blazor.Tests.csproj, FakeApi.cs and PageTestContext.cs   (no table, no database: an essentials group; the output folder is the test project's own folder, OutputBlazorTests)
    // The project the per-table BLZ_Test classes live in. FakeApi stands in for the API (a list answers the rows it was given, a read by key the row, every write 204, and it remembers what was sent);
    // PageTestContext is the bUnit context every test class derives from: the HttpClient over FakeApi, the app's clients, a loose JS runtime and, with Auth=true, the sign-in (SignIn(role)).
    // Writes nothing unless the project sets BlazorTests=true. Settings: BlazorTests, OutputBlazorTests, OutputBlazor, Auth. Full notes: Docs/TemplateNotes/BLZ_Test_v1.md
    // ==========================================================================================
    if (Project.BlazorTests)
    {
        string ns = BlazorNames.Namespace(Project);
        string testsFolder = Project.OutputFolderOf("blazortests");
        string appFolder = Project.OutputFolderOf("blazor");
        string appPath = Path.GetRelativePath(testsFolder, appFolder).Replace('\\', '/');
        string appProject = (Project.ProjectName ?? "MyApp") + ".Blazor.csproj";
#>
@@@FILE <#= ns #>.Tests.csproj@@@
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace><#= ns #>.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
    <PackageReference Include="bunit" Version="2.12.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="<#= appPath #>/<#= appProject #>" />
  </ItemGroup>

</Project>
@@@FILE FakeApi.cs@@@
using System.Net;
using System.Text;

namespace <#= ns #>.Tests;

/// <summary> Stands in for the API: a read answers the text given for the end of its path (an empty list when none), a failure the status given, a write answers 204 (or the text or failure given for its method and the end of its path), and every call is remembered. </summary>
public class FakeApi : HttpMessageHandler
{
    private readonly Dictionary<string, string> answers = [];
    private readonly Dictionary<string, HttpStatusCode> failures = [];
    private readonly Dictionary<(HttpMethod, string), string> writeAnswers = [];
    private readonly Dictionary<(HttpMethod, string), HttpStatusCode> writeFailures = [];

    /// <summary> The calls made so far: the method, the path with its query and the body sent. </summary>
    public List<(HttpMethod Method, string Path, string Body)> Requests { get; } = [];

    /// <summary> The role the sign-in answers with. </summary>
    public string Role { get; set; } = "Tester";

    /// <summary> A read whose path ends with <paramref name="pathEnd"/> answers <paramref name="json"/>. </summary>
    public FakeApi Answer(string pathEnd, string json)
    {
        answers[pathEnd] = json;
        return this;
    }

    /// <summary> A read whose path ends with <paramref name="pathEnd"/> fails with this status. </summary>
    public FakeApi Fail(string pathEnd, HttpStatusCode status)
    {
        failures[pathEnd] = status;
        return this;
    }

    /// <summary> A write of this method whose path ends with <paramref name="pathEnd"/> answers <paramref name="json"/> (a clone answers the copy). </summary>
    public FakeApi AnswerWrite(HttpMethod method, string pathEnd, string json)
    {
        writeAnswers[(method, pathEnd)] = json;
        return this;
    }

    /// <summary> A write of this method whose path ends with <paramref name="pathEnd"/> fails with this status. </summary>
    public FakeApi FailWrite(HttpMethod method, string pathEnd, HttpStatusCode status)
    {
        writeFailures[(method, pathEnd)] = status;
        return this;
    }

    /// <summary> The answer of an OData list: <paramref name="rowsJson"/> (the rows, separated by commas) and their count. </summary>
    public static string ODataPage(string rowsJson, int count) => "{ \"value\": [" + rowsJson + "], \"@odata.count\": " + count + " }";

    /// <summary> The answer of a search: page <paramref name="page"/> holding <paramref name="rowsJson"/> (the rows, separated by commas) of <paramref name="count"/> rows in all. </summary>
    public static string Page(string rowsJson, int count, int page = 1, int pageSize = 10) =>
        "{ \"items\": [" + rowsJson + "], \"page\": " + page + ", \"pageSize\": " + pageSize + ", \"totalCount\": " + count + ", \"totalPages\": " + Math.Max(1, (count + pageSize - 1) / pageSize) + " }";

    protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
    {
        string path = request.RequestUri!.AbsolutePath;
        string body = request.Content is null ? "" : await request.Content.ReadAsStringAsync(cancellationToken);
        Requests.Add((request.Method, request.RequestUri.PathAndQuery, body));
        if (request.Method == HttpMethod.Post && path.EndsWith("/auth/login", StringComparison.OrdinalIgnoreCase) && writeFailures.TryGetValue((HttpMethod.Post, "/auth/login"), out var refused))
            return new HttpResponseMessage(refused);
        if (request.Method == HttpMethod.Post && path.EndsWith("/auth/login", StringComparison.OrdinalIgnoreCase))
            return Json("{ \"token\": \"abc\", \"expiresUtc\": \"2999-01-01T00:00:00Z\", \"user\": { \"name\": \"Pat\", \"role\": \"" + Role + "\", \"ownerId\": null } }");
        if (request.Method != HttpMethod.Get)
        {
            if (writeFailures.FirstOrDefault(f => f.Key.Item1 == request.Method && path.EndsWith(f.Key.Item2, StringComparison.OrdinalIgnoreCase)) is { Key.Item2: not null } writeFailure)
                return new HttpResponseMessage(writeFailure.Value);
            if (writeAnswers.FirstOrDefault(a => a.Key.Item1 == request.Method && path.EndsWith(a.Key.Item2, StringComparison.OrdinalIgnoreCase)) is { Key.Item2: not null } written)
                return Json(written.Value);
            return new HttpResponseMessage(HttpStatusCode.NoContent);
        }
        if (failures.FirstOrDefault(f => path.EndsWith(f.Key, StringComparison.OrdinalIgnoreCase)) is { Key: not null } failure)
            return new HttpResponseMessage(failure.Value);
        return Json(answers.FirstOrDefault(a => path.EndsWith(a.Key, StringComparison.OrdinalIgnoreCase)).Value ?? (path.StartsWith("/odata/", StringComparison.OrdinalIgnoreCase) ? "{ \"value\": [] }" : "[]"));
    }

    private static HttpResponseMessage Json(string json) => new(HttpStatusCode.OK) { Content = new StringContent(json, Encoding.UTF8, "application/json") };
}
@@@FILE PageTestContext.cs@@@
using Bunit;
<# if (Project.Auth) { #>
using Microsoft.AspNetCore.Components.Authorization;
<# } #>
using Microsoft.Extensions.DependencyInjection;
using <#= ns #>.Services;

namespace <#= ns #>.Tests;

/// <summary> What every page test needs: the app's clients over <see cref="FakeApi"/> and a JS runtime that accepts any call (the pages keep the shown columns and the sorts in the browser's storage). </summary>
public abstract class PageTestContext : BunitContext
{
    protected FakeApi Api { get; } = new();

    protected PageTestContext()
    {
        JSInterop.Mode = JSRuntimeMode.Loose;
        Services.AddScoped(_ => new HttpClient(Api) { BaseAddress = new Uri("http://localhost") });
        Services.AddApiClients();
<# if (Project.Auth) { #>
        Services.AddAuthorizationCore();
        Services.AddCascadingAuthenticationState();
        Services.AddScoped<AuthSession>();
        Services.AddScoped<AuthenticationStateProvider, SessionAuthenticationStateProvider>();
<# } #>
    }
<# if (Project.Auth) { #>

    /// <summary> Signs in as someone with this role, as the sign-in page would. </summary>
    protected void SignIn(string role)
    {
        Api.Role = role;
        Services.GetRequiredService<AuthSession>().LoginAsync(Services.GetRequiredService<HttpClient>(), "pat", "secret").GetAwaiter().GetResult();
    }
<# } #>

    [TestCleanup]
    public void Cleanup() => Dispose();
}
<#
    }
#>
<#
    if (Project.BlazorTests && Project.Dashboard)
    {
        string ns2 = BlazorNames.Namespace(Project);
        string symbol = Project.CurrencySymbol.Replace("\\", "\\\\").Replace("\"", "\\\"");
#>
@@@FILE DashboardPageTests.cs@@@
using Bunit;
using System.Net;
using <#= ns2 #>.Pages;

namespace <#= ns2 #>.Tests;

[TestClass]
public class DashboardPageTests : PageTestContext
{
    private const string Widgets = """
        { "widgets": [
          { "id": "count", "kind": "count", "title": "Sample count", "table": "T", "route": "", "isMoney": false, "points": [ { "label": "Rows", "value": 7 } ], "rows": [] },
          { "id": "money", "kind": "money", "title": "Sample money", "table": "T", "route": "", "isMoney": true, "points": [ { "label": "Total", "value": 1234.5 } ], "rows": [] },
          { "id": "top", "kind": "topBy", "title": "Sample bars", "table": "T", "route": "", "isMoney": false, "points": [ { "label": "First place", "value": 9 }, { "label": "Second place", "value": 3 } ], "rows": [] },
          { "id": "recent", "kind": "recent", "title": "Sample recent", "table": "T", "route": "", "isMoney": false, "points": [], "rows": [ { "label": "Newest row", "detail": "2026-01-01" } ] }
        ] }
        """;

    [TestMethod]
    public void Shows_a_card_a_money_card_a_bar_list_and_the_recent_rows()
    {
        Api.Answer("/api/dashboard", Widgets);
        var page = Render<Dashboard>();
        page.WaitForAssertion(() => StringAssert.Contains(page.Markup, "Sample count"));
        StringAssert.Contains(page.Find("section[aria-label='Sample count']").TextContent, "7");
        StringAssert.Contains(page.Find("section[aria-label='Sample money']").TextContent, "<#= symbol #>1,234.50");
        StringAssert.Contains(page.Find("section[aria-label='Sample bars']").TextContent, "First place");
        StringAssert.Contains(page.Find("section[aria-label='Sample recent']").TextContent, "Newest row");
    }

    [TestMethod]
    public void Says_so_when_the_schema_suggests_nothing_to_show()
    {
        Api.Answer("/api/dashboard", "{ \"widgets\": [] }");
        var page = Render<Dashboard>();
        page.WaitForAssertion(() => StringAssert.Contains(page.Markup, "The schema suggests nothing to show."));
    }

    [TestMethod]
    public void Says_so_when_the_dashboard_cannot_be_loaded()
    {
        Api.Fail("/api/dashboard", HttpStatusCode.InternalServerError);
        var page = Render<Dashboard>();
        page.WaitForAssertion(() => StringAssert.Contains(page.Markup, "Failed to load the dashboard."));
    }
}
<#
    }
    if (Project.BlazorTests && TenantPlan.HasSwitcher(Project))
    {
        string ns3 = BlazorNames.Namespace(Project);
#>
@@@FILE TenantSwitcherTests.cs@@@
using Bunit;
using Bunit.TestDoubles;
using Microsoft.AspNetCore.Components;
using Microsoft.Extensions.DependencyInjection;
using System.Net;
using <#= ns3 #>.Components;
using <#= ns3 #>.Pages;
using <#= ns3 #>.Services;

namespace <#= ns3 #>.Tests;

[TestClass]
public class TenantSwitcherTests : PageTestContext
{
    private const string Acme = """{ "id": 1, "text": "Acme", "role": "Administrator", "current": true }""";
    private const string Globex = """{ "id": 2, "text": "Globex", "role": "Employee", "current": false }""";

    [TestMethod]
    public void Shows_the_name_of_the_only_tenant_without_a_choice()
    {
        Api.Answer("/api/auth/tenants", "[" + Acme + "]");
        SignIn("Tester");
        var page = Render<TenantSwitcher>();
        page.WaitForAssertion(() => Assert.AreEqual("Acme", page.Find("span.tenant").TextContent));
        Assert.IsEmpty(page.FindAll("select"));
    }

    [TestMethod]
    public void Offers_a_drop_down_with_the_current_tenant_chosen_when_the_person_belongs_to_several()
    {
        Api.Answer("/api/auth/tenants", "[" + Acme + "," + Globex + "]");
        SignIn("Tester");
        var page = Render<TenantSwitcher>();
        page.WaitForAssertion(() => Assert.HasCount(2, page.FindAll("select.tenant option")));
        Assert.IsTrue(page.Find("option[value='1']").HasAttribute("selected"));
        Assert.IsFalse(page.Find("option[value='2']").HasAttribute("selected"));
    }

    [TestMethod]
    public void Asks_for_a_token_for_the_chosen_tenant_keeps_it_and_loads_the_app_again()
    {
        Api.Answer("/api/auth/tenants", "[" + Acme + "," + Globex + "]");
        Api.AnswerWrite(HttpMethod.Post, "/auth/switch-tenant", """{ "token": "def", "expiresUtc": "2999-01-01T00:00:00Z", "user": { "name": "Pat", "role": "Employee", "ownerId": null, "tenantId": 2 } }""");
        SignIn("Tester");
        var page = Render<TenantSwitcher>();
        page.WaitForAssertion(() => Assert.HasCount(2, page.FindAll("select.tenant option")));

        page.Find("select.tenant").Change("2");

        var session = Services.GetRequiredService<AuthSession>();
        page.WaitForAssertion(() => Assert.AreEqual("def", session.Token));
        Assert.AreEqual(2, session.User!.TenantId);
        Assert.IsTrue(Api.Requests.Any(r => r.Method == HttpMethod.Post && r.Path.EndsWith("/auth/switch-tenant") && r.Body.Contains("\"tenantId\":2")));
        Assert.IsTrue(((BunitNavigationManager)Services.GetRequiredService<NavigationManager>()).History.Any(h => h.Options.ForceLoad));
    }

    [TestMethod]
    public void Shows_nothing_when_the_API_has_no_tenants_route()
    {
        Api.Fail("/api/auth/tenants", HttpStatusCode.NotFound);
        SignIn("Tester");
        var page = Render<TenantSwitcher>();
        Assert.AreEqual("", page.Markup.Trim());
    }
}

[TestClass]
public class TenantSignInTests : PageTestContext
{
    private IRenderedComponent<Login> Fill(string? tenant)
    {
        Api.Answer("<#= TenantWords.SignInListPath #>", "[{ \"id\": 1, \"name\": \"Acme\" }, { \"id\": 2, \"name\": \"Globex\" }, { \"id\": 3, \"name\": \"Initech\" }]");
        var page = Render<Login>();
        page.WaitForAssertion(() => Assert.AreEqual(4, page.FindAll("#tenant option").Count));
        page.Find("#userName").Input("pat");
        page.Find("#password").Input("secret");
        if (tenant is not null)
            page.Find("#tenant").Change(tenant);
        page.Find("form").Submit();
        return page;
    }

    [TestMethod]
    public void Lists_the_tenants_by_name_with_a_blank_first_for_the_first_tenant()
    {
        var page = Fill(null);
        CollectionAssert.AreEqual(new[] { "", "Acme", "Globex", "Initech" }, page.FindAll("#tenant option").Select(o => o.TextContent.Trim()).ToArray());
    }

    [TestMethod]
    public void Posts_the_tenant_that_is_picked_beside_the_name_and_password()
    {
        Fill("2");
        Assert.IsTrue(Api.Requests.Any(r => r.Method == HttpMethod.Post && r.Path.EndsWith("/auth/login") && r.Body.Contains("\"tenantId\":2")));
    }

    [TestMethod]
    public void Names_no_tenant_when_the_blank_entry_is_picked()
    {
        Fill(null);
        var login = Api.Requests.Single(r => r.Path.EndsWith("/auth/login"));
        Assert.IsFalse(login.Body.Contains("tenantId"));
    }

    [TestMethod]
    public void Says_the_tenant_is_not_one_of_theirs_on_a_403()
    {
        Api.FailWrite(HttpMethod.Post, "/auth/login", HttpStatusCode.Forbidden);
        var page = Fill("3");
        page.WaitForAssertion(() => StringAssert.Contains(page.Markup, "<#= TenantWords.SignInRefused #>"));
    }
}
<#
    }
#>
