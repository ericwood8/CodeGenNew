<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // UNO_EssentialSupport_v1.tt
    // Generates: Services/ApiSupport.cs   (no table, no database: an essentials group; the output folder is the Uno app's own folder)
    // What every generated client and screen shares: ApiException (the HTTP status of a failed call and a sentence for the screen), PagedResult<T> (the search endpoint's answer) and the
    // helpers the clients use to read a response.
    // ==========================================================================================
    string ns = UnoNames.ServicesNamespace(Project);
#>
@@@FILE Services/ApiSupport.cs@@@
using System.Net.Http.Json;

namespace <#= ns #>;

public class ApiException(int status, string message<# if (Project.RateTables.Length > 0) { #>, bool sentence = false<# } #>) : Exception(message)
{
    public int Status => status;
<# if (Project.RateTables.Length > 0) { #>
    // true when the message is the API's own sentence of a rate refusal (RateTables, RateDocuments)
    public bool Sentence => sentence;
<# } #>

    // The sentence a screen shows for a failed save, delete or clone.
    public string Explain(string action) => Status switch
    {
<# if (Project.RateTables.Length > 0) { #>
        _ when Sentence => Message,
<# } #>
        <#= HttpStatus.BadRequest #> => action == "deleting" ? "It cannot be deleted because it is in use!" : "Some of the values are not acceptable!",
        <#= HttpStatus.NotFound #> => "It no longer exists!",
<# if (Project.PartyTables.Length > 0) { #>
        <#= HttpStatus.Conflict #> when Message == "<#= PartyWords.IdentifierTaken #>" => Message,   // an identifier another row holds (PartyTables): the API's own sentence
<# } #>
<# if (SubscriptionFeature.IsEnabled(Project)) { #>
        <#= HttpStatus.PaymentRequired #> => Message,   // the subscription is paused or the plan allows no more: the API's own sentence
<# } #>
        _ => $"Problem while {action}!"
    };
}

public class PagedResult<T>
{
    public List<T> Items { get; set; } = [];
    public int Page { get; set; }
    public int PageSize { get; set; }
    public int TotalCount { get; set; }
    public int TotalPages { get; set; }
}

public static class ApiSupport
{
    public static async Task EnsureSuccessAsync(this HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
            return;
        string message = $"{(int)response.StatusCode} {response.ReasonPhrase}";
<# if (SubscriptionFeature.IsEnabled(Project)) { #>
        if ((int)response.StatusCode == <#= HttpStatus.PaymentRequired #>)
            message = await ProblemDetailAsync(response) ?? "<#= SubscriptionFeature.PausedFallback #>";
<# } #>
<# if (Project.PartyTables.Length > 0) { #>
        if ((int)response.StatusCode == <#= HttpStatus.Conflict #> && await ProblemDetailAsync(response) is { } refusal)
            message = refusal;
<# } #>
<# if (Project.RateTables.Length > 0) { #>
        if ((int)response.StatusCode is <#= HttpStatus.BadRequest #> or <#= HttpStatus.Conflict #> && await RateRefusalAsync(response) is { } sentence)
            throw new ApiException((int)response.StatusCode, sentence, true);
<# } #>
        throw new ApiException((int)response.StatusCode, message);
    }

    /// <summary> The detail of a problem-details answer (the API's own sentence), or null when the answer is not one. </summary>
    public static async Task<string?> ProblemDetailAsync(HttpResponseMessage response)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(await response.Content.ReadAsStringAsync());
            return document.RootElement.TryGetProperty("detail", out var detail) && detail.ValueKind == System.Text.Json.JsonValueKind.String ? detail.GetString() : null;
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }

<# if (Project.RateTables.Length > 0) { #>
    /// <summary> The API's own sentence of a rate refusal (a problem whose type starts with <#= ProblemTypes.Prefix #>rate-), or null. </summary>
    public static async Task<string?> RateRefusalAsync(HttpResponseMessage response)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(await response.Content.ReadAsStringAsync());
            var root = document.RootElement;
            return root.TryGetProperty("type", out var type) && type.GetString()?.StartsWith("<#= ProblemTypes.Prefix #>rate-") == true && root.TryGetProperty("detail", out var detail) ? detail.GetString() : null;
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }

<# } #>
    public static async Task<T> ReadAsync<T>(this HttpResponseMessage response)
    {
        await response.EnsureSuccessAsync();
        return (await response.Content.ReadFromJsonAsync<T>())!;
    }
}
