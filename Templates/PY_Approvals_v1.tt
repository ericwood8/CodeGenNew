<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PY_Approvals_v1.tt
    // Generates: app/routes/approvals.py   (whole-database; the path is written by the template)
    // The Python counterpart of API_Approvals: for each table of RowApprovals the routes request, approve, reject and withdraw, GET toapprove and GET {id}/approvals over the <Table>Approval side table,
    // with the same sentences, problem types and status codes as the ASP.NET API (ApprovalWords and ApprovalWriter in Core). A decision is one guarded UPDATE of the Pending row; the requester and the
    // approver are people of the user table, and an approver is never the requester. hooks.validate (no side effects) and hooks.on_decided (in the decision's transaction) are the project's own rules.
    // PY_Mod lists this router before the tables' routers. A ChangeGates clause approval is checked by PY_Gates. Needs ApiAuth, UserTable and the side tables (SP_ApprovalTable writes their script).
    // Full notes: Docs/TemplateNotes/API_Approvals_v1.md
    // ==========================================================================================
    var plan = ApprovalPlan.Resolve(Database, Project);
    if (plan.Problems.Count > 0)
    {
        Error(string.Join(" | ", plan.Problems));
    }
    else if (plan.Tables.Count > 0)
    {
        Write("@@@FILE app/routes/approvals.py@@@\n" + PythonApprovalWriter.File(plan, Project));
    }
#>
