# Restriction checkboxes for BLZ_EssentialProject_v1.tt (see Docs/Reference.md section 3).
# One of the files every Blazor app needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Blazor
EssentialsGroup=Project
Description=the .csproj, Program.cs, App.razor, _Imports.razor, index.html, appsettings.json (the API's address) and launchSettings.json
Needs=Services/ApiClients.cs
