# Restriction checkboxes for BLZ_Approvals_v1.tt (see Docs/Reference.md section 3).
# One set of files for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# No OutputName: the template writes its own paths (Services/ApprovalsClient.cs, Pages/Approvals.razor) with @@@FILE markers.
# Whole-project generation (codegen generate): written only for a project with RowApprovals (and ApiAuth).
Stacks=Blazor
InPlan=false
