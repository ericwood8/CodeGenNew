<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Data" #>
<#@ import namespace="System.Globalization" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // API_Test_v1.tt
    // Generates: <TableName>ApiTests.cs   (see OutputName in API_Test_v1.tt.config; goes to the test project, OutputApiTests)
    // An MSTest class that drives one table's API in process (WebApplicationFactory) against a scratch database: add a row, read it, change it, remove it and see a 404 afterwards; ask for a row
    // that is not there; fetch a page of the search; and, with ApiValidation=true, send a value past a limit and see a 400. The bodies are made like API_Http's (one value for every column that
    // cannot be NULL); text gets a unique ending so a unique index does not stop a second run, and a foreign key takes the key of the first row of the parent's API.
    // Writes for the tables API_Crud writes an API for. The ApiFixture and the project file come from the Tests essentials group (API_EssentialTests).
    // Full notes: Docs/TemplateNotes/API_Test_v1.md
    // ==========================================================================================

    if (!Model.HasCrudApiOfAnyKey(Project))
    {
        Error($"API_Test writes tests for the tables API_Crud writes an API for (a single int, uniqueidentifier or text key, not an enum or a name/active table), and [{Model.SchemaName}].[{Model.TableName}] is not one.");
    }
    else if (LogTablePlan.For(Model, Project) is not null)
    {
        // a log table is only read: its tests do not add, change or remove rows (ApiLogTests, Core)
        Write(ApiLogTests.Text(ApiTestPlan.For(Model, Project)!, Project, QueuePlan.For(Model, Project)));
    }
    else
    {
        // what the class checks and with which values is ApiTestPlan's (Core); this template writes the text
        var plan = ApiTestPlan.For(Model, Project)!;
        string projectName = Project.ProjectName ?? "MyApp";
        string singular = plan.Singular;
        string route = plan.Route;
        string keyJson = plan.KeyJson;
        string keyCs = plan.KeyCs;
        string idRef = plan.IdRef;
        string absentKey = plan.AbsentKey;
        var bodyColumns = plan.BodyColumns;
        string Expression(ColumnModel c) => plan.Expression(c);
        var changed = plan.Changed;
        string changedJson = plan.ChangedJson;
        string changedType = plan.ChangedType;
        var sortNames = plan.SortNames;
        bool canClone = plan.CanClone;
        var uniqueText = plan.UniqueText;
        var writeRoles = plan.WriteRoles;
        var readRoles = plan.ReadRoles;
        bool scopedToPerson = plan.ScopedToPerson;
        var usedParents = plan.UsedParents;
        var longText = plan.LongText;
        var ranged = plan.Ranged;
        long over = plan.OverLimit;
#>
namespace <#= projectName #>.Api.Tests;

[TestClass]
public class <#= singular #>ApiTests
{
    private const string Route = "<#= route #>";

    internal static async Task<JsonObject> NewBodyAsync() => new()
    {
<#
        foreach (var c in bodyColumns)
        {
#>
        [<#= ApiSampleValues.Json(JsonNames.Camel(c.Name)) #>] = <#= Expression(c) #>,
<#
        }
#>
    };

    [TestMethod]
    public async Task A_row_can_be_added_read_changed_and_removed()
    {
        ApiFixture.RequireDatabase();
        var client = ApiFixture.Client;

        using var created = await client.PostAsJsonAsync(Route, await NewBodyAsync());
        Assert.AreEqual(HttpStatusCode.Created, created.StatusCode, await created.Content.ReadAsStringAsync());
        var row = (await created.Content.ReadFromJsonAsync<JsonObject>())!;
        <#= keyCs #> id = row[<#= ApiSampleValues.Json(keyJson) #>]!.GetValue<<#= keyCs #>>();
        try
        {
            using var read = await client.GetAsync($"{Route}/{<#= idRef #>}");
            Assert.AreEqual(HttpStatusCode.OK, read.StatusCode, "the new row can be read");
<#
        if (changed is not null)
        {
#>

<#
            if (changedType == "string")
            {
#>
            string after = ApiFixture.Unique("Changed", <#= changed.CharacterLength #>);
<#
            }
            else
            {
#>
            <#= changedType #> after = <#= changedType == "bool" ? "!" : "" #>row[<#= ApiSampleValues.Json(changedJson) #>]!.GetValue<<#= changedType #>>()<#= changedType == "long" ? " + 1" : "" #>;
<#
            }
#>
            row[<#= ApiSampleValues.Json(changedJson) #>] = after;
            using var updated = await client.PutAsJsonAsync($"{Route}/{<#= idRef #>}", row);
            Assert.AreEqual(HttpStatusCode.OK, updated.StatusCode, await updated.Content.ReadAsStringAsync());

            var again = (await client.GetFromJsonAsync<JsonObject>($"{Route}/{<#= idRef #>}"))!;
            Assert.AreEqual(after, again[<#= ApiSampleValues.Json(changedJson) #>]!.GetValue<<#= changedType #>>(), "the change was saved");
<#
        }
#>
        }
        finally
        {
            using var removed = await client.DeleteAsync($"{Route}/{<#= idRef #>}");
        }

        using var gone = await client.GetAsync($"{Route}/{<#= idRef #>}");
        Assert.AreEqual(HttpStatusCode.NotFound, gone.StatusCode, "the removed row is gone");
    }

    [TestMethod]
    public async Task A_row_that_is_not_there_answers_404()
    {
        ApiFixture.RequireDatabase();
        using var response = await ApiFixture.Client.GetAsync($"{Route}/{<#= absentKey #>}");
        Assert.AreEqual(HttpStatusCode.NotFound, response.StatusCode);
    }
<#
        if (Project.ApiAuth)
        {
#>

    [TestMethod]
    public async Task Without_a_token_the_list_answers_401()
    {
        ApiFixture.RequireDatabase();
        using var anonymous = ApiFixture.Anonymous();
        using var response = await anonymous.GetAsync(Route);
        Assert.AreEqual(HttpStatusCode.Unauthorized, response.StatusCode);
    }
<#
            if (writeRoles.Count > 0)
            {
#>

    [TestMethod]
    public async Task A_role_the_write_rule_does_not_list_cannot_change_rows()
    {
        ApiFixture.RequireDatabase();
        using var client = ApiFixture.ClientInRole("NoSuchRole");

        using var create = await client.PostAsJsonAsync(Route, await NewBodyAsync());
        Assert.AreEqual(HttpStatusCode.Forbidden, create.StatusCode);
        Assert.AreEqual("<#= ProblemTypes.RoleNotAllowed #>", (await create.Content.ReadFromJsonAsync<JsonObject>())!["type"]!.GetValue<string>());

        using var delete = await client.DeleteAsync($"{Route}/{<#= absentKey #>}");
        Assert.AreEqual(HttpStatusCode.Forbidden, delete.StatusCode, "the role is refused before the row is looked for");
    }
<#
                if (writeRoles.Count > 1 && !scopedToPerson)
                {
#>

    [TestMethod]
    public async Task A_role_the_write_rule_lists_can_add_a_row()
    {
        ApiFixture.RequireDatabase();
        using var client = ApiFixture.ClientInRole("<#= writeRoles[1] #>");
        using var created = await client.PostAsJsonAsync(Route, await NewBodyAsync());
        Assert.AreEqual(HttpStatusCode.Created, created.StatusCode, await created.Content.ReadAsStringAsync());
        var row = (await created.Content.ReadFromJsonAsync<JsonObject>())!;
        <#= keyCs #> id = row[<#= ApiSampleValues.Json(keyJson) #>]!.GetValue<<#= keyCs #>>();
        using var removed = await ApiFixture.Client.DeleteAsync($"{Route}/{<#= idRef #>}");
    }
<#
                }
            }
            if (readRoles.Count > 0)
            {
#>

    [TestMethod]
    public async Task A_role_the_read_rule_does_not_list_cannot_read_rows()
    {
        ApiFixture.RequireDatabase();
        using var client = ApiFixture.ClientInRole("NoSuchRole");

        using var list = await client.GetAsync(Route);
        Assert.AreEqual(HttpStatusCode.Forbidden, list.StatusCode);
        Assert.AreEqual("<#= ProblemTypes.RoleNotAllowed #>", (await list.Content.ReadFromJsonAsync<JsonObject>())!["type"]!.GetValue<string>());

        using var one = await client.GetAsync($"{Route}/{<#= absentKey #>}");
        Assert.AreEqual(HttpStatusCode.Forbidden, one.StatusCode, "the role is refused before the row is looked for");
    }
<#
                if (readRoles.Count > 1 && !scopedToPerson)
                {
#>

    [TestMethod]
    public async Task A_role_the_read_rule_lists_can_read_the_list()
    {
        ApiFixture.RequireDatabase();
        using var client = ApiFixture.ClientInRole("<#= readRoles[1] #>");
        using var list = await client.GetAsync(Route);
        Assert.AreEqual(HttpStatusCode.OK, list.StatusCode, await list.Content.ReadAsStringAsync());
    }
<#
                }
            }
        }
        if (Model.HasSearchApi(Project))
        {
#>

    [TestMethod]
    public async Task The_search_answers_a_page()
    {
        ApiFixture.RequireDatabase();
        using var response = await ApiFixture.Client.GetAsync($"{Route}/search?pageNumber=1&pageSize=5");
        Assert.AreEqual(HttpStatusCode.OK, response.StatusCode, await response.Content.ReadAsStringAsync());
        Assert.IsFalse(string.IsNullOrWhiteSpace(await response.Content.ReadAsStringAsync()));
    }
<#
        }
        if (sortNames.Count > 0)
        {
#>

    [TestMethod]
<#
            foreach (string sortName in sortNames)
            {
#>
    [DataRow(<#= ApiSampleValues.Json(sortName) #>)]
<#
            }
#>
    public async Task The_search_sorts_by_each_column_it_offers(string column)
    {
        ApiFixture.RequireDatabase();
        foreach (string direction in new[] { "asc", "desc" })
        {
            using var response = await ApiFixture.Client.GetAsync($"{Route}/search?pageNumber=1&pageSize=5&sortBy={Uri.EscapeDataString(column)}&sortDir={direction}");
            Assert.AreEqual(HttpStatusCode.OK, response.StatusCode, column + " " + direction + ": " + await response.Content.ReadAsStringAsync());
        }
    }

    [TestMethod]
    public async Task A_sort_column_the_search_does_not_offer_is_ignored()
    {
        ApiFixture.RequireDatabase();
        using var response = await ApiFixture.Client.GetAsync($"{Route}/search?pageNumber=1&pageSize=5&sortBy={Uri.EscapeDataString("x' OR 1=1 " + new string('-', 2))}");
        Assert.AreEqual(HttpStatusCode.OK, response.StatusCode, await response.Content.ReadAsStringAsync());
    }
<#
        }
        if (canClone)
        {
#>

    [TestMethod]
    public async Task A_row_can_be_cloned()
    {
        ApiFixture.RequireDatabase();
        var client = ApiFixture.Client;

        using var created = await client.PostAsJsonAsync(Route, await NewBodyAsync());
        Assert.AreEqual(HttpStatusCode.Created, created.StatusCode, await created.Content.ReadAsStringAsync());
        long id = (await created.Content.ReadFromJsonAsync<JsonObject>())![<#= ApiSampleValues.Json(keyJson) #>]!.GetValue<long>();
        long? copyId = null;
        try
        {
            using var cloned = await client.PostAsync($"{Route}/{id}/clone", null);
            Assert.AreEqual(HttpStatusCode.Created, cloned.StatusCode, await cloned.Content.ReadAsStringAsync());
            copyId = (await cloned.Content.ReadFromJsonAsync<JsonObject>())![<#= ApiSampleValues.Json(keyJson) #>]!.GetValue<long>();
            Assert.AreNotEqual(id, copyId, "the copy is a new row");
        }
        finally
        {
            using var removedCopy = copyId is null ? null : await client.DeleteAsync($"{Route}/{copyId}");
            using var removed = await client.DeleteAsync($"{Route}/{id}");
        }
    }
<#
        }
        if (uniqueText is not null)
        {
#>

    [TestMethod]
    public async Task A_second_row_with_a_value_that_must_be_unique_is_refused()
    {
        ApiFixture.RequireDatabase();
        var client = ApiFixture.Client;

        var body = await NewBodyAsync();
        using var created = await client.PostAsJsonAsync(Route, body);
        Assert.AreEqual(HttpStatusCode.Created, created.StatusCode, await created.Content.ReadAsStringAsync());
        <#= keyCs #> id = (await created.Content.ReadFromJsonAsync<JsonObject>())![<#= ApiSampleValues.Json(keyJson) #>]!.GetValue<<#= keyCs #>>();
        try
        {
            var again = await NewBodyAsync();
            again[<#= ApiSampleValues.Json(JsonNames.Camel(uniqueText.Name)) #>] = body[<#= ApiSampleValues.Json(JsonNames.Camel(uniqueText.Name)) #>]!.GetValue<string>();
            using var duplicate = await client.PostAsJsonAsync(Route, again);
            if (duplicate.IsSuccessStatusCode)
            {
                <#= keyCs #> extra = (await duplicate.Content.ReadFromJsonAsync<JsonObject>())![<#= ApiSampleValues.Json(keyJson) #>]!.GetValue<<#= keyCs #>>();
                using var removedExtra = await client.DeleteAsync($"{Route}/{extra}");
            }
            Assert.IsTrue((int)duplicate.StatusCode is >= 400 and < 500, "the duplicate is refused with a client error, not saved and not a 500: " + (int)duplicate.StatusCode);
        }
        finally
        {
            using var removed = await client.DeleteAsync($"{Route}/{<#= idRef #>}");
        }
    }
<#
        }
        foreach (var used in usedParents)
        {
            var usedColumn = used.Column;
            var usedKey = used.Key;
            string usedRoute = used.Route;
#>

    [TestMethod]
    public async Task A_<#= usedKey!.ReferencedTable #>_row_that_<#= usedColumn.Name #>_points_at_cannot_be_removed()
    {
        ApiFixture.RequireDatabase();
        var client = ApiFixture.Client;

        var body = await NewBodyAsync();
        using var created = await client.PostAsJsonAsync(Route, body);
        Assert.AreEqual(HttpStatusCode.Created, created.StatusCode, await created.Content.ReadAsStringAsync());
        <#= keyCs #> id = (await created.Content.ReadFromJsonAsync<JsonObject>())![<#= ApiSampleValues.Json(keyJson) #>]!.GetValue<<#= keyCs #>>();
        try
        {
            string parentId = Uri.EscapeDataString(body[<#= ApiSampleValues.Json(JsonNames.Camel(usedColumn.Name)) #>]!.ToString());
            using var refused = await client.DeleteAsync($"<#= usedRoute #>/{parentId}");
            Assert.AreEqual(HttpStatusCode.BadRequest, refused.StatusCode, "a row that is in use is not removed: " + await refused.Content.ReadAsStringAsync());

            using var still = await client.GetAsync($"<#= usedRoute #>/{parentId}");
            Assert.AreEqual(HttpStatusCode.OK, still.StatusCode, "the row is still there");
        }
        finally
        {
            using var removed = await client.DeleteAsync($"{Route}/{<#= idRef #>}");
        }
    }
<#
        }
        if (longText is not null)
        {
#>

    [TestMethod]
    public async Task Text_longer_than_the_column_is_refused()
    {
        ApiFixture.RequireDatabase();
        var body = await NewBodyAsync();
        body[<#= ApiSampleValues.Json(JsonNames.Camel(longText.Name)) #>] = new string('x', <#= longText.CharacterLength + 1 #>);
        using var response = await ApiFixture.Client.PostAsJsonAsync(Route, body);
        Assert.AreEqual(HttpStatusCode.BadRequest, response.StatusCode);
    }
<#
        }
        if (ranged is not null)
        {
#>

    [TestMethod]
    public async Task A_number_past_its_limit_is_refused()
    {
        ApiFixture.RequireDatabase();
        var body = await NewBodyAsync();
        body[<#= ApiSampleValues.Json(JsonNames.Camel(ranged.Name)) #>] = <#= over.ToString(CultureInfo.InvariantCulture) #>;
        using var response = await ApiFixture.Client.PostAsJsonAsync(Route, body);
        Assert.AreEqual(HttpStatusCode.BadRequest, response.StatusCode);
    }
<#
        }
        // TreeTables, SoftDeleteTables and EffectiveDatedTables: the tests of the table's shape (RowShapeTests, Core)
        Write(RowShapeTests.Methods(plan, Model, Project));
#>
}
<#
    }
