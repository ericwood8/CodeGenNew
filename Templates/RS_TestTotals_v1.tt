<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // RS_TestTotals_v1.tt
    // Generates: tests/api/totals_routes.rs   (whole-database; the output folder is the Rust crate's folder)
    // Integration tests of what RS_Routes writes for DocumentTotals, run in process over a scratch database like RS_Test. Each test adds its own rows through the router and removes them again.
    // The cases: the totals a client writes replaced, the lines total following every line added or removed, the payable amount following the prepaid amount and the check route. The words are
    // DocumentTotalsWords, as in the Python tests.
    // Written only for a project with RustTests=true and a header and a line table the tests can fill (DocumentTotalsTestPlan).
    // Needs Client.start of tests/api/test_support.rs (RS_EssentialTests); RS_TestBodies lists the module.
    // Full notes: Docs/TemplateNotes/API_RowShapes_v1.md
    // ==========================================================================================
    if (RustTotalsTests.Applies(Database, Project))
        Write("@@@FILE tests/api/totals_routes.rs@@@\n" + RustTotalsTests.File(Database, Project));
#>
