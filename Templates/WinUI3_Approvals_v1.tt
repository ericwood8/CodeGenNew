<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string viewNamespace = "MyApp.Desktop.Views";
    string repositoryNamespace = "MyApp.Common.Repositories";
    string contextType = "MyAppContext";
    string[] usings = { };   // namespaces the generated files must "using" (the context's)
    string viewsFolder = "Views";   // under the WinUI3 project root (where -o points)
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    viewNamespace = Project.ViewNamespace ?? viewNamespace;
    repositoryNamespace = Project.RepoNamespace ?? repositoryNamespace;
    contextType = Project.ContextName ?? contextType;
    usings = Project.Usings ?? usings;
    viewsFolder = Project.ViewsFolder ?? viewsFolder;
    // ==========================================================================================

    // ==========================================================================================
    // WinUI3_Approvals_v1.tt
    // Generates: Repositories/ApprovalSupport.cs, Repositories/ApprovalService.cs and Views/ApprovalsPage.cs   (the paths are written by the template)
    // The approvals page of the WinUI3 app, for the tables of RowApprovals. The app reads the database itself, so the rules the API has (a request per row, a decision by someone else, withdrawal, the
    // history, the hooks) run in process in ApprovalService, in the API's words; the person is DesktopCaller.Name, the Windows sign-in unless the project sets it, looked up in the user table. The page is
    // the one the Uno app draws (DesktopApprovalsCode in Core). WinUI3_Screens adds the menu entry. Like the gates, this is a check in the client: the API is where it is enforced.
    // Full notes: Docs/TemplateNotes/API_Approvals_v1.md
    // ==========================================================================================
    var plan = ApprovalPlan.Resolve(Database, Project);
    if (plan.Problems.Count > 0)
    {
        Error(string.Join(" | ", plan.Problems));
    }
    else if (plan.Tables.Count > 0)
    {
        var tables = ApprovalScreens.For(Database, Project);
#>
@@@FILE Repositories/ApprovalSupport.cs@@@
<#= DesktopApprovalsCode.Support(repositoryNamespace) #>@@@FILE Repositories/ApprovalService.cs@@@
<#= DesktopApprovalsCode.Service(plan, tables, repositoryNamespace, contextType, usings, !DesktopApprovalsCode.GatesWriteCaller(Project)) #>@@@FILE <#= viewsFolder #>/ApprovalsPage.cs@@@
<#= DesktopApprovalsCode.Page(viewNamespace, repositoryNamespace) #>
<#
    }
#>
