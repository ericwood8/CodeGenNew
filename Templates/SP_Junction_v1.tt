<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // MySQL has real stored procedures with its own syntax: CodeGenNew.Core's MySqlProcedures writes this one for a table read from MySQL.
    if (Model.Dialect == SqlDialect.MySql)
    {
        Write(MySqlProcedures.Junction(Model));
        return GenerationEnvironment.ToString();
    }
#>
<#
    // PostgreSQL has functions rather than stored procedures: CodeGenNew.Core's PostgresProcedures writes this one for a table read from PostgreSQL.
    if (Model.Dialect == SqlDialect.PostgreSql)
    {
        Write(PostgresProcedures.Junction(Model));
        return GenerationEnvironment.ToString();
    }
#>
<#
    // ==========================================================================================
    // SP_Junction_v1.tt
    // Generates: <TableName>_Junction.sql   (three routines for a many-to-many junction table)
    // <Table>_List (the target rows with whether each is selected for one anchor row), <Table>_Link and <Table>_Unlink, behind the two-list shuttle screen
    // (WinUI3_JunctionEditor, TSX_JunctionPage, TS_JunctionComponent) and API_Junction. Needs a table detected as a junction table
    // (TableModel.IsJunctionTable) and the target table's display columns; anything else stops with an error.
    // Full notes: Docs/TemplateNotes/SP_Junction_v1.md

    if (!Model.IsJunctionTable)
        Error($"SP_Junction cannot generate from [{Model.SchemaName}].[{Model.TableName}]: it is not a many-to-many junction table - TableModel.IsJunctionTable is false. " +
              "A junction table's primary key (or, for a surrogate-identity-key table, its only two non-audit columns) must be exactly two single-column foreign keys.");
    if (!Model.HasReferencedDisplayColumns)
        Error("SP_Junction needs the target table's display columns; its .tt.config must say NeedsReferencedDisplayColumns=true.");

    string Q(string identifier) => "[" + identifier.Replace("]", "]]") + "]";

    var anchorFk = Model.JunctionForeignKeys[0];
    var targetFk = Model.JunctionForeignKeys[1];
    var anchorColumn = Model.Columns.First(c => c.Name.EqualsIgnoreCase(anchorFk.ReferencingColumns[0]));
    var targetColumn = Model.Columns.First(c => c.Name.EqualsIgnoreCase(targetFk.ReferencingColumns[0]));
    string anchorParam = "@Anchor" + anchorColumn.Name;
    string targetParam = "@Target" + targetColumn.Name;
    string targetKeyColumn = targetFk.ReferencedColumns[0];

    string junctionTable = $"{Q(Model.SchemaName)}.{Q(Model.TableName)}";
    string targetTable = $"{Q(targetFk.ReferencedSchema)}.{Q(targetFk.ReferencedTable)}";

    var createDateColumn = Model.Columns.FirstOrDefault(c => c.IsCreateDateColumn);
    var createUserColumn = Model.Columns.FirstOrDefault(c => c.IsCreateUserColumn);

    // ==== List: every target row, plus whether it's linked to the given anchor. Display columns are CAST
    // to NVARCHAR regardless of their real type - the same "a display column is something to SHOW a
    // person, not typed data to compute with" convention SP_Update.tt already established for its own
    // VarChar-for-everything parameters - so the generated ViewModel's row type can bind every display
    // column as a plain string without needing to know each one's real SQL type.
    var selectItems = new List<string> { $"[t].{Q(targetKeyColumn)} AS TargetId" };
    foreach (string displayColumn in targetFk.ReferencedDisplayColumns)
        selectItems.Add($"CAST([t].{Q(displayColumn)} AS NVARCHAR(500)) AS {Q(displayColumn)}");
    string orderBy = targetFk.ReferencedDisplayColumns.Count > 0 ? Q(targetFk.ReferencedDisplayColumns[0]) : Q(targetKeyColumn);

    // ==== Link: the association columns, plus any audit columns this table happens to have.
    var linkColumns = new List<(string Name, string Value)> { (anchorColumn.Name, anchorParam), (targetColumn.Name, targetParam) };
    if (createDateColumn is not null)
        linkColumns.Add((createDateColumn.Name, "GETDATE()"));
    if (createUserColumn is not null)
        linkColumns.Add((createUserColumn.Name, "@CreateUser"));
#>
CREATE OR ALTER PROCEDURE [<#= Model.SchemaName #>].[<#= Model.TableName #>_List]
(
	<#= anchorParam #> <#= anchorColumn.SqlTypeDeclaration #>
)
AS
BEGIN
	SET NOCOUNT ON;

	SELECT
<#
    for (int i = 0; i < selectItems.Count; i++)
    {
#>
		<#= i == 0 ? " " : "," #><#= selectItems[i] #>
<#
    }
#>
		, CASE WHEN EXISTS (
			SELECT 1 FROM <#= junctionTable #> AS [x]
			WHERE [x].<#= Q(anchorColumn.Name) #> = <#= anchorParam #> AND [x].<#= Q(targetColumn.Name) #> = [t].<#= Q(targetKeyColumn) #>
		) THEN 1 ELSE 0 END AS IsSelected
	FROM <#= targetTable #> AS [t]
	ORDER BY [t].<#= orderBy #>;
END
GO

CREATE OR ALTER PROCEDURE [<#= Model.SchemaName #>].[<#= Model.TableName #>_Link]
(
	<#= anchorParam #> <#= anchorColumn.SqlTypeDeclaration #>,
	<#= targetParam #> <#= targetColumn.SqlTypeDeclaration #><#= createUserColumn is not null ? "," : "" #>
<#
    if (createUserColumn is not null)
    {
#>
	@CreateUser <#= createUserColumn.SqlTypeDeclaration #> = NULL
<#
    }
#>
)
AS
BEGIN
	SET NOCOUNT ON;

	IF NOT EXISTS (
		SELECT 1 FROM <#= junctionTable #>
		WHERE <#= Q(anchorColumn.Name) #> = <#= anchorParam #> AND <#= Q(targetColumn.Name) #> = <#= targetParam #>
	)
		INSERT INTO <#= junctionTable #>
		(
<#
    for (int i = 0; i < linkColumns.Count; i++)
    {
#>
			<#= i == 0 ? " " : "," #><#= Q(linkColumns[i].Name) #>
<#
    }
#>
		)
		VALUES
		(
<#
    for (int i = 0; i < linkColumns.Count; i++)
    {
#>
			<#= i == 0 ? " " : "," #><#= linkColumns[i].Value #>
<#
    }
#>
		);
END
GO

CREATE OR ALTER PROCEDURE [<#= Model.SchemaName #>].[<#= Model.TableName #>_Unlink]
(
	<#= anchorParam #> <#= anchorColumn.SqlTypeDeclaration #>,
	<#= targetParam #> <#= targetColumn.SqlTypeDeclaration #>
)
AS
BEGIN
	SET NOCOUNT ON;

	DELETE FROM <#= junctionTable #>
	WHERE <#= Q(anchorColumn.Name) #> = <#= anchorParam #> AND <#= Q(targetColumn.Name) #> = <#= targetParam #>;
END
