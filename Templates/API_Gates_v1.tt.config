# Restriction checkboxes for API_Gates_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
OutputName=Gates.cs
# Whole-project generation (codegen generate): written only for a project with ChangeGates or GuardedColumns (and ApiAuth).
Stacks=Api
OutputFolder=Apis
InPlan=false
