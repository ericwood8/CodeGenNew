<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // TSX_EssentialShell_v1.tt
    // Generates: index.html, src/main.tsx and src/App.tsx   (no table, no database: an essentials group; the output folder is the React app's own folder)
    // The React shell: the page that hosts the app, the entry point with the router, and App with the menu (the hamburger button opens and closes it, the choice is remembered in the browser)
    // and the routes. The screens themselves (route, menu text, page) are imported from src/screens.tsx, which TSX_Screens writes from the project's Screens setting.
    // Setting: ProjectTitle (the page title). Auth=true: the menu and the hamburger show only to a signed-in person, a screen the person's role may not read (the roles ReadRoles gives it) is not in the menu,
    // every route needs the sign-in (RequireAuth of the Auth group), /login is the sign-in page, and the top bar shows the user's name with a Sign out button.
    // TenantTable with TenantMembership (and Auth): the top bar also has the TenantSwitcher of the Auth group.
    // ==========================================================================================
    bool tenants = TenantPlan.HasSwitcher(Project);   // the top bar also shows the tenant (a drop-down for a person in several) and every screen is made again on a switch
#>
@@@FILE index.html@@@
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><#= Project.ProjectTitle #></title>
  </head>
  <body>
    <div id="root"></div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>
@@@FILE src/main.tsx@@@
import { StrictMode } from 'react';
import { createRoot } from 'react-dom/client';
import { BrowserRouter } from 'react-router-dom';
import { App } from './App';
import './index.css';

createRoot(document.getElementById('root')!).render(
  <StrictMode>
    <BrowserRouter>
      <App />
    </BrowserRouter>
  </StrictMode>,
);
@@@FILE src/App.tsx@@@
<# if (Project.Auth) { #>
import { useState } from 'react';
import { NavLink, Navigate, Route, Routes } from 'react-router-dom';
import { screens } from './screens';
import { useAuth } from './<#= Project.ApiFolder #>/auth';
import { LoginPage } from './<#= Project.PagesFolder #>/LoginPage';
import { RequireAuth } from './<#= Project.ComponentsFolder #>/RequireAuth';
<# if (tenants) { #>
import { TenantSwitcher } from './<#= Project.ComponentsFolder #>/TenantSwitcher';
<# } #>
import './<#= Project.ComponentsFolder #>/auth.css';

// The screens (route, menu text, page, and the roles that may read it) are in screens.tsx, generated by TSX_Screens from the Screens project setting: a new table is a regenerate, not an edit here.
const rolesOf = (screen: object): readonly string[] | undefined => (screen as { roles?: readonly string[] }).roles;

// The menu opens and closes with the hamburger button (like the WinUI3 pane); the choice is remembered in the browser.
function readMenuOpen(): boolean {
  try { return localStorage.getItem('menuOpen') !== 'false'; } catch { return true; }
}

export function App() {
  const auth = useAuth();
  const [menuOpen, setMenuOpen] = useState(readMenuOpen);
  const toggleMenu = () => {
    setMenuOpen(!menuOpen);
    try { localStorage.setItem('menuOpen', String(!menuOpen)); } catch { /* storage unavailable: the choice just is not remembered */ }
  };
  // a person sees the screens their role may read
  const open = screens.filter((s) => { const roles = rolesOf(s); return !roles || auth.hasRole(roles); });

  return (
    <div className={menuOpen && auth.isLoggedIn ? 'app' : 'app menu-closed'}>
      {menuOpen && auth.isLoggedIn && (
        <nav className="rail">
          {open.map((s) => (
            <NavLink key={s.path} to={`/${s.path}`}>{s.label}</NavLink>
          ))}
        </nav>
      )}
      <main>
        {auth.isLoggedIn && (
          <div className="topbar">
            <button type="button" className="hamburger" aria-label="Toggle the menu" aria-expanded={menuOpen} onClick={toggleMenu}>&#9776;</button>
            <span className="spacer" />
<# if (tenants) { #>
            <TenantSwitcher />
<# } #>
            <span className="user">{auth.user?.name}</span>
            <button type="button" className="signout" onClick={auth.logout}>Sign out</button>
          </div>
        )}
<# if (tenants) { #>
        {/* a new key when the person switches tenant: every screen is made again and reads the rows of the new tenant */}
        <Routes key={String(auth.user?.['tenantId'] ?? '')}>
<# } else { #>
        <Routes>
<# } #>
          <Route path="/login" element={<LoginPage />} />
          <Route path="/" element={<RequireAuth>{open.length > 0 ? <Navigate to={`/${open[0].path}`} replace /> : <p>No screen is open to your role.</p>}</RequireAuth>} />
          {screens.map((s) => (
            <Route key={s.path} path={`/${s.path}`} element={<RequireAuth roles={rolesOf(s)}>{s.element}</RequireAuth>} />
          ))}
        </Routes>
      </main>
    </div>
  );
}
<# } else { #>
import { useState } from 'react';
import { NavLink, Navigate, Route, Routes } from 'react-router-dom';
import { screens } from './screens';

// The screens (route, menu text, page) are in screens.tsx, generated by TSX_Screens from the Screens project setting: a new table is a regenerate, not an edit here.

// The menu opens and closes with the hamburger button (like the WinUI3 pane); the choice is remembered in the browser.
function readMenuOpen(): boolean {
  try { return localStorage.getItem('menuOpen') !== 'false'; } catch { return true; }
}

export function App() {
  const [menuOpen, setMenuOpen] = useState(readMenuOpen);
  const toggleMenu = () => {
    setMenuOpen(!menuOpen);
    try { localStorage.setItem('menuOpen', String(!menuOpen)); } catch { /* storage unavailable: the choice just is not remembered */ }
  };

  return (
    <div className={menuOpen ? 'app' : 'app menu-closed'}>
      {menuOpen && (
        <nav className="rail">
          {screens.map((s) => (
            <NavLink key={s.path} to={`/${s.path}`}>{s.label}</NavLink>
          ))}
        </nav>
      )}
      <main>
        <button type="button" className="hamburger" aria-label="Toggle the menu" aria-expanded={menuOpen} onClick={toggleMenu}>&#9776;</button>
        <Routes>
          <Route path="/" element={<Navigate to={`/${screens[0].path}`} replace />} />
          {screens.map((s) => (
            <Route key={s.path} path={`/${s.path}`} element={s.element} />
          ))}
        </Routes>
      </main>
    </div>
  );
}
<# } #>
