<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // TSX_EssentialShell_v1.tt
    // Generates: index.html, src/main.tsx and src/App.tsx   (no table, no database: an essentials group; the output folder is the React app's own folder)
    // The React shell: the page that hosts the app, the entry point with the router, and App with the menu (the hamburger button opens and closes it, the choice is remembered in the browser)
    // and the routes. The screens themselves (route, menu text, page) are imported from src/screens.tsx, which TSX_Screens writes from the project's Screens setting.
    // Setting: ProjectTitle (the page title).
    // ==========================================================================================
#>
@@@FILE index.html@@@
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><#= Project.ProjectTitle #></title>
  </head>
  <body>
    <div id="root"></div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>
@@@FILE src/main.tsx@@@
import { StrictMode } from 'react';
import { createRoot } from 'react-dom/client';
import { BrowserRouter } from 'react-router-dom';
import { App } from './App';
import './index.css';

createRoot(document.getElementById('root')!).render(
  <StrictMode>
    <BrowserRouter>
      <App />
    </BrowserRouter>
  </StrictMode>,
);
@@@FILE src/App.tsx@@@
import { useState } from 'react';
import { NavLink, Navigate, Route, Routes } from 'react-router-dom';
import { screens } from './screens';

// The screens (route, menu text, page) are in screens.tsx, generated by TSX_Screens from the Screens project setting: a new table is a regenerate, not an edit here.

// The menu opens and closes with the hamburger button (like the WinUI3 pane); the choice is remembered in the browser.
function readMenuOpen(): boolean {
  try { return localStorage.getItem('menuOpen') !== 'false'; } catch { return true; }
}

export function App() {
  const [menuOpen, setMenuOpen] = useState(readMenuOpen);
  const toggleMenu = () => {
    setMenuOpen(!menuOpen);
    try { localStorage.setItem('menuOpen', String(!menuOpen)); } catch { /* storage unavailable: the choice just is not remembered */ }
  };

  return (
    <div className={menuOpen ? 'app' : 'app menu-closed'}>
      {menuOpen && (
        <nav className="rail">
          {screens.map((s) => (
            <NavLink key={s.path} to={`/${s.path}`}>{s.label}</NavLink>
          ))}
        </nav>
      )}
      <main>
        <button type="button" className="hamburger" aria-label="Toggle the menu" aria-expanded={menuOpen} onClick={toggleMenu}>&#9776;</button>
        <Routes>
          <Route path="/" element={<Navigate to={`/${screens[0].path}`} replace />} />
          {screens.map((s) => (
            <Route key={s.path} path={`/${s.path}`} element={s.element} />
          ))}
        </Routes>
      </main>
    </div>
  );
}
