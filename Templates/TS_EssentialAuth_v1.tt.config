# Restriction checkboxes for TS_EssentialAuth_v1.tt (see Docs/Reference.md section 3).
# One of the files an app of a stack can have: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`;
# a project that says Auth=true gets it with every `codegen generate --essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Angular
EssentialsGroup=Auth
EssentialsDefault=false
Description=Sign-in (Auth=true): auth.service.ts, auth.interceptor.ts, auth.guard.ts, models/auth.ts and the login page, with their specs
