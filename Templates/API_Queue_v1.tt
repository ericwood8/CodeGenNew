<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string apiNamespace = "MyApp.ApiService.Apis";
    string contextType = "MyAppContext";
    string[] usings = { };   // namespaces the generated file must "using" (the context's)
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    contextType = Project.ContextName ?? contextType;
    apiNamespace = Project.ApiNamespace ?? apiNamespace;
    usings = Project.Usings ?? usings;
    // ==========================================================================================

    // ==========================================================================================
    // API_Queue_v1.tt
    // Generates: Queue.cs   (see OutputName in API_Queue_v1.tt.config)
    // The routes of the work queues (QueueTables): for each table GET stats (the counts by status and the oldest pending row), GET failed, POST claim (the oldest pending row, taken with one guarded UPDATE, 204 when
    // there is none), POST {id}/complete, POST {id}/fail (one more retry, back to pending until QueueMaxRetries, then failed) and POST {id}/retry (a failed row back to pending). A claim nobody completed is
    // released after QueueClaimMinutes. The table itself is a read-only list (no write route), so rows are never edited by hand. With ApiAuth the routes need a signed-in caller.
    // Full notes: Docs/TemplateNotes/API_Queue_v1.md
    // ==========================================================================================

    var tables = Database.Tables.Select(t => QueuePlan.For(t, Project)).OfType<QueueTable>()
        .OrderBy(q => q.Table.TableName, StringComparer.OrdinalIgnoreCase).ToList();
    var problems = Database.Tables.Select(t => QueuePlan.Problem(t, Project)).Where(p => p is not null).ToList();
    problems.AddRange(QueuePlan.Entries(Project).Where(e => !Database.Tables.Any(t => t.TableName.EqualsIgnoreCase(e.Table)))
        .Select(e => $"QueueTables: {e.Table} is not a table of the database."));
    if (problems.Count > 0)
    {
        Error(string.Join(" | ", problems));
    }
    else if (tables.Count > 0)
    {
        Write("namespace " + apiNamespace + ";\n\n");
        Write(QueueWriter.File(tables, Project, contextType, usings));
    }
#>
