<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // UNO_EssentialOData_v1.tt
    // Generates: Services/ODataSupport.cs   (written once and kept; a replacing run refreshes it; OData=true ticks the group)
    // The helpers of the Uno OData pages (UNO_ODataPage) and clients (UNO_ODataClient), the Blazor ones (BLZ_EssentialOData) without the browser storage:
    //   ODataApiException  an ApiException that also holds the detail of the API's problem answer (the words of a 409), read by the OData calls;
    //   ODataQuery         ODataString / Literal (a text becomes one quoted literal, a quote doubled, so it can never end the literal), Contains / ContainsAny, And, OrderBy, Query (every value
    //                      URL-encoded), RelativeLink (the server's next link) and the pieces of the filter row (Range, Equals);
    //   ODataFilters       the kinds of filter control, one field per column and what a person typed into it, turned into $filter conditions;
    //   ODataTable         what a client knows about its table that the entity set does not say (key, search boxes, sortable headers, order without a sort);
    //   ODataClient<T,K>   the calls of one table over GET /odata/<set>: the list, the page with $count, $top, $skip, $filter and $orderby, the key routes, and the REST route a clone goes through.
    // Needs Services/ApiSupport.cs (UNO_EssentialSupport). Full notes: Docs/TemplateNotes/UNO_ODataPage_v1.md
    // ==========================================================================================
    string ns = UnoNames.Namespace(Project);
#>
@@@FILE Services/ODataSupport.cs@@@
using System.Globalization;
using System.Net.Http.Json;
using System.Text;
using System.Text.Json;
using System.Text.RegularExpressions;

namespace <#= ns #>.Services;

/// <summary> A failed OData call: the status, and the detail of the problem answer when the API sent one (a duplicate says what is duplicated). </summary>
public class ODataApiException(int status, string message, string? detail) : ApiException(status, message)
{
    public string? Detail => detail;
}

public static class ODataSupport
{
    private static readonly JsonSerializerOptions Web = new(JsonSerializerDefaults.Web);

    /// <summary> Throws <see cref="ODataApiException"/> for a failed answer, with the detail (or the title) of a problem-details body. </summary>
    public static async Task EnsureODataSuccessAsync(this HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode) return;
        string? detail = null;
        try
        {
            using var body = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
            if (body.RootElement.ValueKind == JsonValueKind.Object)
                detail = (body.RootElement.TryGetProperty("detail", out var d) && d.ValueKind == JsonValueKind.String ? d.GetString() : null)
                    ?? (body.RootElement.TryGetProperty("title", out var t) && t.ValueKind == JsonValueKind.String ? t.GetString() : null);
        }
        catch (JsonException)
        {
            // the body is not a problem answer: only the status is known
        }
        throw new ODataApiException((int)response.StatusCode, $"{(int)response.StatusCode} {response.ReasonPhrase}", detail);
    }

    public static async Task<T> ReadODataAsync<T>(this HttpResponseMessage response)
    {
        await response.EnsureODataSuccessAsync();
        return (await response.Content.ReadFromJsonAsync<T>())!;
    }

    /// <summary> The sentence a screen shows for a failed call: the API's own words for a conflict, "in use" for a delete the database refused, else the usual sentence. </summary>
    public static string ExplainOData(this ApiException error, string action)
    {
        if (error.Status == <#= HttpStatus.Conflict #>)
            return action == "deleting" ? "It cannot be deleted because it is in use!" : (error as ODataApiException)?.Detail ?? "A row with this value already exists!";
        return error.Explain(action);
    }

    /// <summary> The rows of an OData query (a path with its query string), following @odata.nextLink until the server has no more. </summary>
    public static async Task<List<T>> ReadRowsAsync<T>(this HttpClient http, string path)
    {
        var rows = new List<T>();
        string? next = path;
        while (next is not null)
        {
            var response = await http.GetAsync(next);
            await response.EnsureODataSuccessAsync();
            using var body = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
            rows.AddRange(body.RootElement.GetProperty("value").Deserialize<List<T>>(Web) ?? []);
            next = body.RootElement.TryGetProperty("@odata.nextLink", out var link) && link.GetString() is { } text ? ODataQuery.RelativeLink(text) : null;
        }
        return rows;
    }
}

/// <summary> Pieces of an OData query. A value goes into the query only as a literal written here. </summary>
public static class ODataQuery
{
    /// <summary> A text as an OData string literal: wrapped in single quotes with every single quote doubled, so whatever a person types stays one value. </summary>
    public static string ODataString(string value) => "'" + value.Replace("'", "''") + "'";

    /// <summary> A value as the literal its type needs in $filter: numbers with the invariant culture, a date as yyyy-MM-dd, a guid as it is, a text quoted; null is <c>null</c>. </summary>
    public static string Literal(object? value) => value switch
    {
        null => "null",
        string text => ODataString(text),
        bool flag => flag ? "true" : "false",
        Guid guid => guid.ToString(),
        DateTime date => date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
        DateOnly day => day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
        IFormattable number => number.ToString(null, CultureInfo.InvariantCulture),
        _ => ODataString(Convert.ToString(value, CultureInfo.InvariantCulture) ?? "")
    };

    /// <summary> The rows whose property contains the text, ignoring case: contains(tolower(name),'text'). </summary>
    public static string Contains(string property, string text) => $"contains(tolower({property}),{ODataString(text.ToLowerInvariant())})";

    /// <summary> The rows where any of the properties contains the text. </summary>
    public static string ContainsAny(IReadOnlyList<string> properties, string text) =>
        properties.Count == 1 ? Contains(properties[0], text) : "(" + string.Join(" or ", properties.Select(p => Contains(p, text))) + ")";

    /// <summary> The conditions that are there, joined with and; null when none is. </summary>
    public static string? And(IEnumerable<string?> parts)
    {
        var there = parts.Where(p => !string.IsNullOrEmpty(p)).ToList();
        return there.Count == 0 ? null : string.Join(" and ", there);
    }

    /// <summary> The $orderby value: paths, each descending when asked (customerStatus/description, name desc). A path named twice counts once. </summary>
    public static string? OrderBy(IEnumerable<(string Path, bool Descending)> items)
    {
        var seen = new HashSet<string>();
        var parts = new List<string>();
        foreach (var (path, descending) in items)
            if (seen.Add(path))
                parts.Add(descending ? path + " desc" : path);
        return parts.Count == 0 ? null : string.Join(",", parts);
    }

    /// <summary> The query string of the options that have a value, every value URL-encoded (the names are $top, $filter and so on). </summary>
    public static string Query(IEnumerable<(string Name, object? Value)> options)
    {
        var pairs = options
            .Where(o => o.Value is not null && Convert.ToString(o.Value, CultureInfo.InvariantCulture) is { Length: > 0 })
            .Select(o => o.Name + "=" + Uri.EscapeDataString(o.Value is bool flag ? (flag ? "true" : "false") : Convert.ToString(o.Value, CultureInfo.InvariantCulture)!));
        string text = string.Join("&", pairs);
        return text.Length == 0 ? "" : "?" + text;
    }

    /// <summary> The server's next link without its host, so the call goes to the app's own API address. </summary>
    public static string RelativeLink(string link)
    {
        var url = new Uri(link, UriKind.RelativeOrAbsolute);
        return url.IsAbsoluteUri ? url.PathAndQuery : link;
    }

    /// <summary> A number as the filter needs it: refused (never sent) when it is not one. </summary>
    public static string Number(string text)
    {
        if (!decimal.TryParse(text.Trim(), NumberStyles.Number, CultureInfo.InvariantCulture, out decimal value))
            throw new FormatException($"'{text}' is not a number.");
        return value.ToString(CultureInfo.InvariantCulture);
    }

    /// <summary> A day as yyyy-MM-dd: refused (never sent) when it is not one. </summary>
    public static DateOnly Day(string text)
    {
        string day = text.Trim();
        if (day.Length > 10) day = day[..10];
        if (!DateOnly.TryParseExact(day, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var value))
            throw new FormatException($"'{text}' is not a date.");
        return value;
    }
}

/// <summary> What a filter row control filters by: text (contains), number or date (a range), boolean (yes or no), parent or choice (one value). </summary>
public enum ODataFilterKind { Text, Number, Date, Boolean, Parent, Choice }

/// <summary> One column of the filter row: the header name it is sorted by, its property in the OData answer, the kind of control, whether the column can be empty and how a chosen value is written
/// in $filter (<c>number</c>, <c>string</c> or <c>guid</c>). </summary>
public sealed record ODataFilterField(string Name, string Property, ODataFilterKind Kind, bool Nullable, string? Literal = null);

/// <summary> What the person typed into the controls of one column. </summary>
public sealed class ColumnFilter
{
    public string? Text { get; set; }
    public string? From { get; set; }
    public string? To { get; set; }
    public string? Flag { get; set; }
    public string? Value { get; set; }
    public bool Empty { get; set; }
}

public static class ODataFilters
{
    private static readonly Regex GuidShape = new("^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$");

    /// <summary> What the filter row asks for, as pieces of $filter: a column left alone adds none; "empty" wins over the other controls of its column. A value that is not a number, a date or a guid
    /// throws <see cref="FormatException"/> instead of being sent. </summary>
    public static List<string> ConditionsOf(IEnumerable<ODataFilterField> fields, IReadOnlyDictionary<string, ColumnFilter> typed)
    {
        var conditions = new List<string>();
        foreach (var field in fields)
        {
            if (!typed.TryGetValue(field.Name, out var entry)) continue;
            if (entry.Empty) { conditions.Add($"{field.Property} eq null"); continue; }
            switch (field.Kind)
            {
                case ODataFilterKind.Text:
                    if (!string.IsNullOrWhiteSpace(entry.Text)) conditions.Add(ODataQuery.Contains(field.Property, entry.Text.Trim()));
                    break;
                case ODataFilterKind.Number:
                    if (!string.IsNullOrWhiteSpace(entry.From)) conditions.Add($"{field.Property} ge {ODataQuery.Number(entry.From)}");
                    if (!string.IsNullOrWhiteSpace(entry.To)) conditions.Add($"{field.Property} le {ODataQuery.Number(entry.To)}");
                    break;
                case ODataFilterKind.Date:
                    // a range on a date ends before the day after the last day, so the whole last day is in (a date and time on that day too)
                    if (!string.IsNullOrWhiteSpace(entry.From)) conditions.Add($"{field.Property} ge {ODataQuery.Literal(ODataQuery.Day(entry.From))}");
                    if (!string.IsNullOrWhiteSpace(entry.To)) conditions.Add($"{field.Property} lt {ODataQuery.Literal(ODataQuery.Day(entry.To).AddDays(1))}");
                    break;
                case ODataFilterKind.Boolean:
                    if (entry.Flag is "true" or "false") conditions.Add($"{field.Property} eq {entry.Flag}");
                    break;
                default:
                    if (!string.IsNullOrEmpty(entry.Value)) conditions.Add($"{field.Property} eq {ValueLiteral(field, entry.Value)}");
                    break;
            }
        }
        return conditions;
    }

    private static string ValueLiteral(ODataFilterField field, string value) => field.Literal switch
    {
        "number" => ODataQuery.Number(value),
        "guid" => GuidShape.IsMatch(value) ? value : throw new FormatException($"'{value}' is not a guid."),
        _ => ODataQuery.ODataString(value)
    };
}

/// <summary> What a client knows about its table that the entity set does not say (UNO_ODataClient writes it): the key, the search boxes, the sortable headers and the order without a sort. All names are the JSON names. </summary>
public sealed record ODataTable(string Key, IReadOnlyList<(string Key, string Property)> Filters, IReadOnlyList<(string Name, string Path)> Sorts, IReadOnlyList<string> DefaultOrder);

/// <summary> What an OData page asks for: the page, the search boxes by name, the sorts in the order given, the conditions of the filter row and, when the grid shows only some columns, the
/// properties to read ($select; the key is always read). </summary>
public sealed record ODataPageQuery(int Page, int PageSize, IReadOnlyDictionary<string, string?>? Filters = null, IReadOnlyList<(string Column, bool Descending)>? Sorts = null, IReadOnlyList<string>? Conditions = null, IReadOnlyList<string>? Select = null);

/// <summary> The calls of one table over its entity set (GET /odata/&lt;set&gt;) instead of its REST route. The key route and the JSON of one row are the same on both routes; a clone is the table's REST route
/// (there is no OData verb for it). </summary>
public class ODataClient<T, TKey>(HttpClient http, string set, ODataTable table, string restPath) where T : class
{
    private readonly string apiUrl = "/odata/" + set;

    private string KeyPath(TKey id) => $"{apiUrl}/{Uri.EscapeDataString(Convert.ToString(id, CultureInfo.InvariantCulture)!)}";

    /// <summary> Every row, in the table's default order; the server's pages are followed to the end. </summary>
    public Task<List<T>> GetAllAsync() =>
        http.ReadRowsAsync<T>(apiUrl + ODataQuery.Query([("$orderby", ODataQuery.OrderBy(table.DefaultOrder.Select(p => (p, false))))]));

    /// <summary> The rows whose property equals the value (a child grid reads the rows of its parent this way). </summary>
    public Task<List<T>> GetWhereAsync(string property, object value) =>
        http.ReadRowsAsync<T>(apiUrl + ODataQuery.Query([("$filter", $"{property} eq {ODataQuery.Literal(value)}"), ("$orderby", ODataQuery.OrderBy(table.DefaultOrder.Select(p => (p, false))))]));

    public async Task<T> GetAsync(TKey id) => await (await http.GetAsync(KeyPath(id))).ReadODataAsync<T>();

    public async Task<T> CreateAsync(T row) => await (await http.PostAsJsonAsync(apiUrl, row)).ReadODataAsync<T>();

    public async Task UpdateAsync(TKey id, T row) => await (await http.PutAsJsonAsync(KeyPath(id), row)).EnsureODataSuccessAsync();

    public async Task DeleteAsync(TKey id) => await (await http.DeleteAsync(KeyPath(id))).EnsureODataSuccessAsync();

    /// <summary> A copy of the row, made by the API's REST route; the copy comes back. </summary>
    public async Task<T> CloneAsync(TKey id) =>
        await (await http.PostAsync($"{restPath}/{Uri.EscapeDataString(Convert.ToString(id, CultureInfo.InvariantCulture)!)}/clone", null)).ReadODataAsync<T>();

    /// <summary> One page: $count, $top and $skip for the page, $filter for the boxes (contains, ignoring case; the one "search" box matches every searchable property) and the filter row, $orderby for the sorts. </summary>
    public async Task<PagedResult<T>> QueryPageAsync(ODataPageQuery query)
    {
        var conditions = new List<string?>();
        foreach (var (key, value) in query.Filters ?? new Dictionary<string, string?>())
        {
            string text = (value ?? "").Trim();
            if (text.Length == 0) continue;
            var properties = key == "search"
                ? table.Filters.Select(f => f.Property).ToList()
                : table.Filters.Where(f => f.Key == key).Select(f => f.Property).ToList();
            if (properties.Count > 0) conditions.Add(ODataQuery.ContainsAny(properties, text));
        }
        conditions.AddRange(query.Conditions ?? []);
        var chosen = (query.Sorts ?? []).SelectMany(sort =>
            table.Sorts.Where(s => s.Name.Equals(sort.Column, StringComparison.OrdinalIgnoreCase)).Take(1).Select(s => (s.Path, sort.Descending)));
        var order = chosen.Concat(table.DefaultOrder.Select(p => (p, false)));
        string path = apiUrl + ODataQuery.Query([
            ("$count", true),
            ("$top", query.PageSize),
            ("$skip", (query.Page - 1) * query.PageSize),
            ("$filter", ODataQuery.And(conditions)),
            ("$orderby", ODataQuery.OrderBy(order)),
            ("$select", query.Select is { Count: > 0 } ? string.Join(",", new[] { table.Key }.Concat(query.Select).Distinct()) : null)
        ]);
        var response = await http.GetAsync(path);
        await response.EnsureODataSuccessAsync();
        using var body = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
        var items = body.RootElement.GetProperty("value").Deserialize<List<T>>(new JsonSerializerOptions(JsonSerializerDefaults.Web)) ?? [];
        int total = body.RootElement.TryGetProperty("@odata.count", out var count) ? count.GetInt32() : items.Count;
        return new PagedResult<T> { Items = items, Page = query.Page, PageSize = query.PageSize, TotalCount = total, TotalPages = (int)Math.Ceiling(total / (double)query.PageSize) };
    }
}
