# Restriction checkboxes for SP_ForeignKeyIndexes_v1.tt (see Docs/Reference.md section 3).
# One script for the whole database; the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# Whole-project generation (codegen generate): only for a project that names the template in PlanAlso.
Stacks=Api,WinUI3
OutputRoot=Sql
InPlan=false
