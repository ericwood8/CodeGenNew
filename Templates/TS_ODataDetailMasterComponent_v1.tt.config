# TS_DetailMasterComponent_v1.tt run as its OData form (see Base and Variant in TemplateConfig). Opt in with OData=true and an Angular stack; written only for the master-detail tables the project serves as OData.
Base=TS_DetailMasterComponent_v1.tt
Variant=OData
RequiresPrimaryKey=true
TableOnly=true
RequiredPrimaryKeyShape=SingleIntGuidOrText
RequiresChildTables=true
NeedsReferencedDisplayColumns=true
Stacks=Angular
PlanTables=ScreenDetailMaster
OutputFolder=src/app
InPlan=false
