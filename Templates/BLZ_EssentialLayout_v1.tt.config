# Restriction checkboxes for BLZ_EssentialLayout_v1.tt (see Docs/Reference.md section 3).
# One of the files every Blazor app needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Blazor
EssentialsGroup=Layout
Description=Layout/MainLayout.razor (the menu with its hamburger button) and wwwroot/css/app.css: the grid, search bar, paging and edit panel the generated pages assume
Needs=Layout/NavMenu.razor
