# Restriction checkboxes for RS_Token_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t.
Scope=Database
# The template writes its own path (src/routes/tokens.rs) with an @@@FILE marker.
OutputName=src/routes/tokens.rs
# Whole-project generation (codegen generate): written only for a project with TokenTables and ApiAuth.
Stacks=Rust
InPlan=false
