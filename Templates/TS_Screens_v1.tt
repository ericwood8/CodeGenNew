<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (folders).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string componentsFolder = Project.ComponentsFolder;   // where TS_Component / TS_DetailMasterComponent write the screens, relative to the file this template writes
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    // The screens and their order come from the project's Screens setting, the master-detail ones from DetailMasterTables (see DatabaseModel).
    // ==========================================================================================

    // ==========================================================================================
    // TS_Screens_v1.tt
    // Generates: app.routes.ts   (see OutputName in TS_Screens_v1.tt.config; point the output folder at the Angular app's src\app folder)
    // The routes and menu entries of an Angular shell: one per table, in menu order from the project's Screens setting, with the component each
    // route opens. A master-detail screen whose child table has no screen gets a WARNING comment at the top.
    // With OData=true each table served as OData also gets the entry of its OData screen (TS_ODataComponent) after the REST ones, with the route <table>-odata and the label "<Table> (OData)".
    // Full notes: Docs/TemplateNotes/TS_Screens_v1.md

    var screens = Database.ScreenTables(Project, "Angular");
    var odataScreens = ODataPlan.AngularScreenTables(Database, Project);
    foreach (string name in Database.UnknownScreens(Project))
        Error($"The Screens setting lists '{name}', which is not a table of the database with a single-column primary key.");
    if (screens.Count == 0)
        Error("TS_Screens found no table to list: no table has an API and a search endpoint, and the project's Screens setting is empty.");
    var missingChildren = DatabaseModel.ChildrenWithoutScreen(screens, Project);
    // ODataScreens=Replace: a table served as OData has its OData screen at the REST screen's route, label and menu place instead of a second entry (a table hosted with dashboard cards keeps its REST screen)
    var stripNames = Project.DashboardStrip ? DashboardPlan.Build(Database, Project).StripTables.ToHashSet(StringComparer.OrdinalIgnoreCase) : new HashSet<string>();
    var replaced = Project.ODataReplacesScreens ? odataScreens.Where(t => !stripNames.Contains(t.TableName)).ToList() : new List<TableModel>();
    bool Replaced(TableModel t) => replaced.Any(r => r.TableName.EqualsIgnoreCase(t.TableName));
    string ODataLoad(TableModel t) => $"load: () => import('./{componentsFolder}/{AngularNames.ODataComponentStem(t.TableName)}/{AngularNames.ODataComponentStem(t.TableName)}.component').then((m) => m.{AngularNames.ODataComponentClass(t.TableName)})";

    var junctions = JunctionPlan.Tables(Database, Project);   // a screen for each many-to-many junction table, after the screens
    string JunctionRoles(TableModel t) => Project.Auth && JunctionPlan.Roles(Project, t) is { Count: > 0 } roles ? ", roles: [" + WriteRolePlan.Literal(roles, (char)39) + "]" : "";
    string ClassName(TableModel t) => AngularNames.ComponentClass(t, Project);
    string FileStem(TableModel t) => AngularNames.ComponentStem(t, Project);

    var sb = new StringBuilder();
    void Line(string text = "") => sb.Append(text).Append('\n');

    // With Dashboard=true the dashboard is the first screen; with DashboardStrip=true each table that has cards is hosted with them above its screen.
    var stripTables = Project.DashboardStrip ? DashboardPlan.Build(Database, Project).StripTables.Where(name => screens.Any(t => t.TableName.EqualsIgnoreCase(name))).ToHashSet(StringComparer.OrdinalIgnoreCase) : new HashSet<string>();

    // Auth=true: every generated route has the guard of the Auth group, and /login is the sign-in page.
    bool auth = Project.Auth;
    // ReadRoles with the sign-in: a screen of a table whose reads are limited to some roles carries them (the menu hides it, the route sends the person to a screen they may open)
    string RolesOf(TableModel t) => auth && ScreenMenu.RolesOf(Project, t) is { Count: > 0 } roles ? ", roles: [" + WriteRolePlan.Literal(roles, (char)39) + "]" : "";
    bool anyRoles = auth && screens.Concat(odataScreens).Concat(junctions).Any(t => ScreenMenu.RolesOf(Project, t).Count > 0);
    string guard = auth ? (anyRoles ? ", canActivate: [canRead], data: { roles: s.roles }" : ", canActivate: [authGuard]") : "";
    string stripGuard = auth ? (anyRoles ? ", canActivate: [canRead]" : ", canActivate: [authGuard]") : "";
    if (anyRoles)
        Line("import { inject } from '@angular/core';");
    Line(anyRoles ? "import { CanActivateFn, Router, Routes } from '@angular/router';" : "import { Routes } from '@angular/router';");
    if (auth)
    {
        Line($"import {{ LoginComponent }} from './{componentsFolder}/login/login.component';");
        Line($"import {{ authGuard }} from './{Project.ServicesFolder}/auth.guard';");
        if (anyRoles)
            Line($"import {{ AuthService }} from './{Project.ServicesFolder}/auth.service';");
    }
    if (Project.Dashboard)
        Line($"import {{ DashboardComponent }} from './{componentsFolder}/dashboard/dashboard.component';");
    if (stripTables.Count > 0)
        Line($"import {{ ScreenWithStripComponent }} from './{componentsFolder}/screen-with-strip/screen-with-strip.component';");
    foreach (var t in screens.Where(t => !Replaced(t)))
        Line($"import {{ {ClassName(t)} }} from './{componentsFolder}/{FileStem(t)}/{FileStem(t)}.component';");
    foreach (var t in junctions)
        Line($"import {{ {JunctionPlan.AngularClass(t.TableName)} }} from './{componentsFolder}/{JunctionPlan.AngularStem(t.TableName)}/{JunctionPlan.AngularStem(t.TableName)}.component';");
    Line();
    Line("// Generated by TS_Screens: one entry per screen, in menu order. Change the list with the Screens project setting and regenerate.");
    Line("// The paths are the kebab-case of the table name (\"SalesInvoice\" -> \"sales-invoice\"): the master-detail screens open a child row at that path");
    Line("// (/sales-invoice?edit=<id>&back=<parent url>) and are generated from the same rule, so the two stay in step.");
    if (missingChildren.Count > 0)
        Line("// WARNING: these child tables are linked from a master-detail screen but have no screen of their own: " + string.Join(", ", missingChildren) + ".");
    Line("export const screens = [");
    if (Project.Dashboard)
        Line("  { path: 'dashboard', label: 'Dashboard', component: DashboardComponent },");
    foreach (var t in screens)
        if (Replaced(t))
            Line($"  {{ path: '{ScreenNames.Route(t.TableName)}', label: '{ScreenNames.Label(t.TableName)}', {ODataLoad(t)}{RolesOf(t)} }},");
        else
            Line($"  {{ path: '{ScreenNames.Route(t.TableName)}', label: '{ScreenNames.Label(t.TableName)}', component: {ClassName(t)}" + (stripTables.Contains(t.TableName) ? $", strip: '{t.TableName}'" : "") + RolesOf(t) + " },");
    // the OData screens are loaded when their route is first opened (a separate chunk each), so they do not add to the first download
    foreach (var t in odataScreens.Where(t => !Replaced(t)))
        Line($"  {{ path: '{AngularNames.ODataRoute(t.TableName)}', label: '{AngularNames.ODataLabel(t.TableName)}', {ODataLoad(t)}{RolesOf(t)} }},");
    foreach (var t in junctions)
        Line($"  {{ path: '{JunctionPlan.Route(t.TableName)}', label: '{JunctionPlan.Label(t.TableName)}', component: {JunctionPlan.AngularClass(t.TableName)}{JunctionRoles(t)} }},");
    Line("];");
    Line();
    if (anyRoles)
    {
        Line("// A person whose role may not read a screen is sent to the first screen they may read (false when there is none).");
        Line("const canRead: CanActivateFn = (route) => {");
        Line("  const auth = inject(AuthService);");
        Line("  const router = inject(Router);");
        Line("  if (!auth.isLoggedIn()) { return router.createUrlTree(['/login']); }");
        Line("  const roles = route.data['roles'] as readonly string[] | undefined;");
        Line("  if (!roles || auth.hasRole(roles)) { return true; }");
        Line("  const first = screens.find((s) => !s.roles || auth.hasRole(s.roles));");
        Line("  return first ? router.createUrlTree(['/' + first.path]) : false;");
        Line("};");
        Line();
    }
    Line("export const routes: Routes = [");
    if (auth)
        Line("  { path: 'login', component: LoginComponent },");
    Line("  { path: '', pathMatch: 'full', redirectTo: screens[0].path },");
    if (stripTables.Count > 0)
        Line("  ...screens.map((s) => (" + (odataScreens.Count > 0 ? "s.load ? { path: s.path, loadComponent: s.load" + guard + " } : " : "") + "s.strip ? { path: s.path, component: ScreenWithStripComponent, data: { table: s.strip, screen: s.component" + (anyRoles ? ", roles: s.roles" : "") + " }" + stripGuard + " } : { path: s.path, component: s.component" + guard + " })),");
    else
        Line("  ...screens.map((s) => (" + (odataScreens.Count > 0 ? "s.load ? { path: s.path, loadComponent: s.load" + guard + " } : " : "") + "{ path: s.path, component: s.component" + guard + " })),");
    Line("];");
    Write(sb.ToString());
#>
