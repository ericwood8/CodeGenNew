<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // BLZ_EssentialSupport_v1.tt
    // Generates: Services/ApiSupport.cs and Components/CurrencyInput.razor   (no table, no database: an essentials group; the output folder is the Blazor app's own folder)
    // What every generated client and page shares: ApiException (the HTTP status of a failed call and a sentence for the screen), PagedResult<T> (the search endpoint's answer) and the helpers the
    // clients use to read a response and the pages use to copy a row for editing, and CurrencyInput (the money box of a form).
    // ==========================================================================================
    string ns = BlazorNames.Namespace(Project);
#>
@@@FILE Services/ApiSupport.cs@@@
using System.Net.Http.Json;
using System.Text.Json;

namespace <#= ns #>.Services;

public class ApiException(int status, string message) : Exception(message)
{
    public int Status => status;

    // The sentence a screen shows for a failed save, delete or clone.
    public string Explain(string action) => Status switch
    {
        <#= HttpStatus.BadRequest #> => action == "deleting" ? "It cannot be deleted because it is in use!" : "Some of the values are not acceptable!",
        <#= HttpStatus.NotFound #> => "It no longer exists!",
        _ => $"Problem while {action}!"
    };
}

public class PagedResult<T>
{
    public List<T> Items { get; set; } = [];
    public int Page { get; set; }
    public int PageSize { get; set; }
    public int TotalCount { get; set; }
    public int TotalPages { get; set; }
}

public static class ApiSupport
{
    public static Task EnsureSuccessAsync(this HttpResponseMessage response) =>
        response.IsSuccessStatusCode
            ? Task.CompletedTask
            : throw new ApiException((int)response.StatusCode, $"{(int)response.StatusCode} {response.ReasonPhrase}");

    public static async Task<T> ReadAsync<T>(this HttpResponseMessage response)
    {
        await response.EnsureSuccessAsync();
        return (await response.Content.ReadFromJsonAsync<T>())!;
    }

    // A copy of a row, so the form edits the copy and the grid keeps showing the saved row.
    public static T Copy<T>(this T row) => JsonSerializer.Deserialize<T>(JsonSerializer.Serialize(row))!;
}
@@@FILE Components/StoredValueValidator.cs@@@
using System.ComponentModel.DataAnnotations;
using Microsoft.AspNetCore.Components;
using Microsoft.AspNetCore.Components.Forms;

namespace <#= ns #>.Components;

/// <summary> The DataAnnotations check of a form (what <c>DataAnnotationsValidator</c> does), except that a property still holding the value the row came with is not held against the person: an old
/// value that breaks an attribute (an email without an @) does not stop an edit of another field. <c>Original</c> is a copy of the stored row; without one (a new row) every property counts. </summary>
public class StoredValueValidator : ComponentBase, IDisposable
{
    private ValidationMessageStore? _messages;

    [CascadingParameter] private EditContext? Context { get; set; }

    [Parameter] public object? Original { get; set; }

    protected override void OnInitialized()
    {
        if (Context is null)
            throw new InvalidOperationException($"{nameof(StoredValueValidator)} must be inside an EditForm.");
        _messages = new ValidationMessageStore(Context);
        Context.OnValidationRequested += Validate;
        Context.OnFieldChanged += Validate;
    }

    private void Validate(object? sender, EventArgs e)
    {
        var model = Context!.Model;
        _messages!.Clear();
        var results = new List<ValidationResult>();
        Validator.TryValidateObject(model, new ValidationContext(model), results, validateAllProperties: true);
        foreach (var result in results)
        {
            var members = result.MemberNames.ToList();
            if (members.Count == 0)
                _messages.Add(new FieldIdentifier(model, string.Empty), result.ErrorMessage ?? "The value is not valid.");
            foreach (string member in members.Where(member => Changed(model, member)))
                _messages.Add(new FieldIdentifier(model, member), result.ErrorMessage ?? "The value is not valid.");
        }
        Context.NotifyValidationStateChanged();
    }

    private bool Changed(object model, string member)
    {
        var property = Original is null ? null : model.GetType().GetProperty(member);
        return property is null || !Equals(property.GetValue(model), property.GetValue(Original));
    }

    public void Dispose()
    {
        if (Context is not null)
        {
            Context.OnValidationRequested -= Validate;
            Context.OnFieldChanged -= Validate;
        }
        _messages?.Clear();
    }
}
@@@FILE Components/TypeAheadOption.cs@@@
namespace <#= ns #>.Components;

/// <summary> One match of a type-ahead: the key of the row and the text to show for it. </summary>
public record TypeAheadOption<TValue>(TValue Id, string Name);
@@@FILE Components/TypeAhead.razor@@@
@typeparam TValue
@using <#= ns #>.Services

@* A box that finds the row of a parent with too many rows for a drop-down by what is typed in it: after a short pause it asks Find for the rows whose text contains it and lists them; picking one calls
   OnPick with it. Typing calls OnPick with null (nothing is chosen any more), and leaving the box without a pick empties it. Name is the text of the chosen key. *@
<div class="type-ahead">
    <input id="@Id" type="text" role="combobox" aria-autocomplete="list" aria-expanded="@(open ? "true" : "false")" aria-label="@Label" placeholder="@Placeholder" autocomplete="off"
           required="@Required" pattern="@Unpicked" title="@(Unpicked is null ? null : "Pick one of the matches.")" value="@(typed ?? Name)" @oninput="TypeAsync" @onblur="Leave" />
    @if (open)
    {
        <ul class="type-ahead-list" role="listbox">
            @foreach (var option in options)
            {
                <li role="option" @onmousedown="() => PickAsync(option)">@option.Name</li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public Func<string, Task<IReadOnlyList<TypeAheadOption<TValue>>>> Find { get; set; } = default!;
    [Parameter] public EventCallback<TypeAheadOption<TValue>?> OnPick { get; set; }

    private string? typed;
    private IReadOnlyList<TypeAheadOption<TValue>> options = [];
    private bool open;
    private CancellationTokenSource? pause;

    // Text typed and not picked is not an answer, and the browser's required check sees a filled box: a pattern only an empty box matches fails it until a row is picked.
    private string? Unpicked => Required && !string.IsNullOrWhiteSpace(typed) ? "^$" : null;

    private async Task TypeAsync(ChangeEventArgs args)
    {
        typed = args.Value?.ToString() ?? "";
        await OnPick.InvokeAsync(null);
        pause?.Cancel();
        pause = new CancellationTokenSource();
        var token = pause.Token;
        string wanted = typed.Trim();
        if (wanted.Length == 0)
        {
            options = [];
            open = false;
            return;
        }

        try
        {
            await Task.Delay(250, token);
            var found = await Find(wanted);
            if (token.IsCancellationRequested)
                return;   // a later keystroke asked again: this answer is old
            options = found;
            open = true;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            options = [];
            open = false;
        }
    }

    private async Task PickAsync(TypeAheadOption<TValue> option)
    {
        pause?.Cancel();
        typed = null;
        options = [];
        open = false;
        await OnPick.InvokeAsync(option);
    }

    private void Leave()
    {
        pause?.Cancel();
        typed = null;
        open = false;
    }
}
@@@FILE Components/CurrencyInput.razor@@@
@typeparam TValue
@inherits InputBase<TValue>
@using System.Globalization

@* A money box: $1,234.50 while it is not being edited, the plain number while it is. Takes decimal, double and their nullable forms; text that is not an amount is refused with the form's validation message. *@
<input @attributes="AdditionalAttributes" type="text" inputmode="decimal" class="@CssClass" value="@Shown" @onfocus="OnFocus" @onblur="OnBlur" @onchange="OnChange" />

@code {
    [Parameter] public int Digits { get; set; } = 2;
    [Parameter] public string Symbol { get; set; } = "$";

    private bool focused;

    private static readonly CultureInfo Invariant = CultureInfo.InvariantCulture;

    private string Shown => focused ? Plain : Pretty;

    private string Plain => Value is null ? "" : Convert.ToDecimal(Value, Invariant).ToString("0.########", Invariant);

    private string Pretty
    {
        get
        {
            if (Value is null) return "";
            decimal amount = Convert.ToDecimal(Value, Invariant);
            return (amount < 0 ? "-" : "") + Symbol + Math.Abs(amount).ToString("N" + Digits, Invariant);
        }
    }

    // min and max arrive as plain attributes (they do nothing on a text box); an edited amount outside them is refused, an untouched stored one is not looked at
    private decimal? Limit(string name) =>
        AdditionalAttributes is not null && AdditionalAttributes.TryGetValue(name, out var limit) && decimal.TryParse(Convert.ToString(limit, Invariant), NumberStyles.Float, Invariant, out decimal value) ? value : null;

    private void OnFocus() => focused = true;

    private void OnBlur() => focused = false;

    private void OnChange(ChangeEventArgs args) => CurrentValueAsString = args.Value?.ToString();

    protected override string? FormatValueAsString(TValue? value) => value is null ? "" : Convert.ToString(value, Invariant);

    protected override bool TryParseValueFromString(string? value, out TValue result, out string? validationErrorMessage)
    {
        var target = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
        string text = (value ?? "").Replace(Symbol, "").Replace(",", "").Replace(" ", "").Trim();
        if (text.Length == 0 && Nullable.GetUnderlyingType(typeof(TValue)) is not null)
        {
            result = default!;
            validationErrorMessage = null;
            return true;
        }

        if (decimal.TryParse(text, NumberStyles.Number, Invariant, out decimal amount))
        {
            if (Limit("min") is { } smallest && amount < smallest)
            {
                result = default!;
                validationErrorMessage = "Enter an amount of at least " + smallest.ToString("0.########", Invariant) + ".";
                return false;
            }
            if (Limit("max") is { } largest && amount > largest)
            {
                result = default!;
                validationErrorMessage = "Enter an amount of at most " + largest.ToString("0.########", Invariant) + ".";
                return false;
            }
            result = (TValue)Convert.ChangeType(amount, target, Invariant);
            validationErrorMessage = null;
            return true;
        }

        result = default!;
        validationErrorMessage = "Enter an amount.";
        return false;
    }
}
