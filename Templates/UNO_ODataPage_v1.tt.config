# UNO_MasterScreen_v1.tt run as its OData form (see Base and Variant in TemplateConfig). Opt in with OData=true and an Uno stack; written only for the tables the project serves as OData.
Base=UNO_MasterScreen_v1.tt
Variant=OData
Requires=PrimaryKey,SingleKey,NotNameActive
NeedsReferencedDisplayColumns=true
Stacks=Uno
PlanTables=Screen
InPlan=false
