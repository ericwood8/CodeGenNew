<#@ template language="C#" #>
<#@ parameter name="Database" type="CodeGenNew.Core.DatabaseModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // RS_Links_v1.tt
    // Generates: src/routes/link_rules.rs   (whole-database; the path is written by the template)
    // The Rust counterpart of the polymorphic-link part of API_RowShapes (PolymorphicLinks): check_<table> for a link table (a record type that names no listed table, or an id that is no row of it, is refused
    // with 400 and the type is written in the table's own spelling), refuse_linked_<table> for a listed table (its delete is refused with 409 while a link names the row) and remove_links_<table> (:remove).
    // RS_Routes calls them from the create, update and delete handlers; the same sentences and problem types as the ASP.NET API (LinkWords and RustLinkWriter in Core).
    // Full notes: Docs/TemplateNotes/API_RowShapes_v1.md
    // ==========================================================================================
    var links = RustLinkWriter.Links(Database, Project);
    var problems = PolymorphicPlan.Problems(Database, Project);
    if (problems.Count > 0)
    {
        Error(string.Join(" | ", problems));
    }
    else if (links.Count > 0)
    {
        Write("@@@FILE src/routes/link_rules.rs@@@\n" + RustLinkWriter.File(links, Project, Database.Dialect));
    }
#>
