# Restriction checkboxes for PY_EssentialProject_v1.tt (see Docs/Reference.md section 3).
# One of the files every Python API needs: no table and no database, only the project settings. Run it from the Essentials menu or `codegen essentials`.
NoDatabase=true
RequiresPrimaryKey=false
TableOnly=false
Stacks=Python
EssentialsGroup=Project
Description=requirements.txt, .env.example, .gitignore and README.md (the packages, the variables the API reads, how to run it)
