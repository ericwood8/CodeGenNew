<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // PROJECT SETTINGS - the lines to change to use this template in your own project (namespaces, names).
    // Everything below this block describes and implements the template itself.
    // ==========================================================================================
    string apiNamespace = "MyApp.ApiService.Apis";
    string contextType = "MyAppContext";
    string[] usings = { };
    // A project settings file (Projects\<ProjectName>.config, chosen with the project CLI parameter or in the app) overrides the values above.
    contextType = Project.ContextName ?? contextType;
    apiNamespace = Project.ApiNamespace ?? apiNamespace;
    usings = Project.Usings ?? usings;
    // ==========================================================================================

    // ==========================================================================================
    // API_Junction_v1.tt
    // Generates: <TableName>JunctionApi.cs   (see OutputName in API_Junction_v1.tt.config)
    // The HTTP side of a many-to-many junction table: GET /<plural>/junction/{anchorId} (every target row with IsSelected), POST .../junction/link
    // and POST .../junction/unlink, calling the three routines SP_Junction writes (generate that first). Needs a table detected as a junction
    // table (TableModel.IsJunctionTable) and the target table's display columns; anything else stops with an error.
    // Full notes: Docs/TemplateNotes/API_Junction_v1.md

    if (!Model.IsJunctionTable)
        Error($"API_Junction cannot generate from [{Model.SchemaName}].[{Model.TableName}]: it is not a many-to-many junction table - TableModel.IsJunctionTable is false.");
    if (!Model.HasReferencedDisplayColumns)
        Error("API_Junction needs the target table's display columns; its .tt.config must say NeedsReferencedDisplayColumns=true.");

    string CSharpType(System.Data.SqlDbType type) => type switch
    {
        System.Data.SqlDbType.Int => "int",
        System.Data.SqlDbType.BigInt => "long",
        System.Data.SqlDbType.SmallInt => "short",
        System.Data.SqlDbType.TinyInt => "byte",
        System.Data.SqlDbType.UniqueIdentifier => "Guid",
        System.Data.SqlDbType.Char or System.Data.SqlDbType.VarChar or System.Data.SqlDbType.NChar or System.Data.SqlDbType.NVarChar => "string",
        _ => "int"
    };

    var anchorFk = Model.JunctionForeignKeys[0];
    var targetFk = Model.JunctionForeignKeys[1];
    var anchorColumn = Model.Columns.First(c => c.Name.Equals(anchorFk.ReferencingColumns[0], System.StringComparison.OrdinalIgnoreCase));
    var targetColumn = Model.Columns.First(c => c.Name.Equals(targetFk.ReferencingColumns[0], System.StringComparison.OrdinalIgnoreCase));
    string anchorType = CSharpType(anchorColumn.SqlType);
    string targetType = CSharpType(targetColumn.SqlType);
    string entity = Model.TableName;
    var displayColumns = targetFk.ReferencedDisplayColumns;
    // How the generated code calls the routines: EXEC of a stored procedure on SQL Server, a function call on PostgreSQL, CALL on MySQL.
    var call = new JunctionCall(Model, entity, anchorColumn.Name);

    string usingLines = string.Concat(usings.Select(u => $"using {u};\n"));
#>
namespace <#= apiNamespace #>;

<#= usingLines #>using Microsoft.EntityFrameworkCore;
using static Microsoft.AspNetCore.Http.TypedResults;

/// <summary> One row of <#= entity #>_List's result set. Display columns are plain strings - see
/// <#= entity #>_List's CAST in SP_Junction.tt's output for why. </summary>
public class <#= entity #>JunctionItem
{
<#
    for (int i = 0; i < displayColumns.Count; i++)
    {
#>
    public string? <#= displayColumns[i] #> { get; set; }
<#
    }
#>
    public <#= targetType #> TargetId { get; set; }
    public bool IsSelected { get; set; }
}

public record <#= entity #>JunctionLinkRequest(<#= anchorType #> AnchorId, <#= targetType #> TargetId);

public class <#= entity #>JunctionApi<T> : BaseApi<T> where T : class
{
    public override void Register(WebApplication app)
    {
        BreakIntoStrings(out string _singular, out string plural, out string _apiSubDir);

        app.MapGet(_apiSubDir + "/junction/{anchorId}", GetJunctionList)
        .WithName($"Get{plural}JunctionList")
        .WithOpenApi()
        .Produces<IEnumerable<<#= entity #>JunctionItem>>()
        .ProducesProblem(500);

        app.MapPost(_apiSubDir + "/junction/link", Link)
        .WithName($"Link{plural}Junction")
        .WithOpenApi()
        .ProducesProblem(500);

        app.MapPost(_apiSubDir + "/junction/unlink", Unlink)
        .WithName($"Unlink{plural}Junction")
        .WithOpenApi()
        .ProducesProblem(500);
    }

    private static async Task<IResult> GetJunctionList([FromServices] <#= contextType #> context, <#= anchorType #> anchorId)
    {
        var rows = await context.Database
            .SqlQueryRaw<<#= entity #>JunctionItem>("<#= call.ListSql #>",
                <#= call.AnchorParameter("anchorId") #>)
            .ToListAsync();
        return Ok(rows);
    }

    private static async Task<IResult> Link([FromServices] <#= contextType #> context, [FromBody] <#= entity #>JunctionLinkRequest request)
    {
        await context.Database.ExecuteSqlInterpolatedAsync(
            $"<#= call.LinkSql("request.AnchorId", "request.TargetId") #>");
        return Ok();
    }

    private static async Task<IResult> Unlink([FromServices] <#= contextType #> context, [FromBody] <#= entity #>JunctionLinkRequest request)
    {
        await context.Database.ExecuteSqlInterpolatedAsync(
            $"<#= call.UnlinkSql("request.AnchorId", "request.TargetId") #>");
        return Ok();
    }
}
