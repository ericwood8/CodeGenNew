<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // WinUI3_EssentialApp_v1.tt
    // Generates: App.xaml and App.xaml.cs   (no table, no database: an essentials group)
    // The WinUI 3 application class: the control resources and OnLaunched, which opens MainWindow. Namespace: the project's AppNamespace (default <ProjectName>.App).
    // ==========================================================================================
    string appNamespace = Project.AppNamespace;
#>
@@@FILE App.xaml@@@
<Application
    x:Class="<#= appNamespace #>.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
@@@FILE App.xaml.cs@@@
using Microsoft.UI.Xaml;

namespace <#= appNamespace #>;

public partial class App : Application
{
    private Window? _window;

    public App()
    {
        InitializeComponent();
    }

    protected override void OnLaunched(LaunchActivatedEventArgs args)
    {
        _window = new MainWindow();
        _window.Activate();
    }
}
