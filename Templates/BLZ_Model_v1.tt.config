# Restriction checkboxes for BLZ_Model_v1.tt (see Docs/Reference.md section 3).
# The client calls api/<table>s/{id}, with the primary key taken as {id:int}, {id:guid} or {id} (text).
RequiresPrimaryKey=true
TableOnly=true
RequiredPrimaryKeyShape=SingleIntGuidOrText
RequiresNotNameActiveTable=true
# No OutputName: the template writes its own path (Models/<Table>.cs) with an @@@FILE marker.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=Blazor
PlanTables=CrudApi
