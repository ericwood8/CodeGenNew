# Restriction checkboxes for TSX_Screens_v1.tt (see Docs/Reference.md section 3).
# One file for the whole database: the menu offers it on the database, the CLI runs it without -t.
DatabaseOnly=true
RequiresPrimaryKey=false
TableOnly=false
OutputName=screens.tsx
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=React
OutputFolder=src
