# Restriction checkboxes for WinUI3_MasterScreen_v1.tt (see Docs/specs.md section 5.3).
RequiresPrimaryKey=true
TableOnly=true
# <Table>Repo (CS_Repo, GenericRepo<T>) takes a plain int id.
RequiredPrimaryKeyShape=SingleInt
# A name/active table's repository is a NameActiveRepo, which has no GetAll for this page to call.
RequiresNotNameActiveTable=true
# The grid resolves foreign key ids to the parent's display column, so ask for it.
NeedsReferencedDisplayColumns=true
# No OutputName: the template writes its own paths (Views/..., ViewModels/...) with @@@FILE markers.
