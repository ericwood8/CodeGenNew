# Restriction checkboxes for WinUI3_MasterScreen_v1.tt (see Docs/Reference.md section 3).
Requires=PrimaryKey,SingleKey,NotNameActive
# <Table>Repo (CS_Repo, GenericRepo<T, TKey>) takes the key as an int, a Guid or a string.
# A name/active table's repository is a NameActiveRepo, which has no GetAll for this page to call.
# The grid resolves foreign key ids to the parent's display column, so ask for it.
NeedsReferencedDisplayColumns=true
# No OutputName: the template writes its own paths (Views/..., ViewModels/...) with @@@FILE markers.
# Whole-project generation (codegen generate): the stacks that include this template, the tables it runs for and where its files go.
Stacks=WinUI3
PlanTables=Screen
