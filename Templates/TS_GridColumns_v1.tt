/** A column the Columns list offers: its name (what the grid sorts by and the saved choice holds), the words the list shows, its property in the JSON and whether the server sorts by it. */
export interface GridColumn {
  name: string;
  label: string;
  property: string;
  sortable: boolean;
}

const columnsKey = (gridKey: string) => `gridColumns:${gridKey}`;

/**
 * The columns a grid shows: the saved ones the table still offers (in the table's order), or the starting columns when nothing valid was saved
 * (no list, something that is not a list of names, or names that are no column any more).
 */
export function loadColumns(gridKey: string, offered: readonly string[], initial: readonly string[]): string[] {
  try {
    const saved: unknown = JSON.parse(localStorage.getItem(columnsKey(gridKey)) ?? 'null');
    if (!Array.isArray(saved)) return [...initial];
    const kept = offered.filter((name) => saved.includes(name));
    return kept.length > 0 ? kept : [...initial];
  } catch {
    return [...initial];
  }
}

/** Remember the choice of a grid, or forget it when it is the starting columns again. */
export function saveColumns(gridKey: string, chosen: readonly string[], initial: readonly string[]): void {
  try {
    const same = chosen.length === initial.length && chosen.every((name, i) => name === initial[i]);
    if (same) localStorage.removeItem(columnsKey(gridKey));
    else localStorage.setItem(columnsKey(gridKey), JSON.stringify(chosen));
  } catch {
    // storage unavailable: the choice just is not remembered
  }
}

/** The choice after one column is ticked or cleared: the table's order is kept, and the last shown column cannot be cleared. */
export function toggleColumn(chosen: readonly string[], offered: readonly string[], name: string): string[] {
  if (!offered.includes(name)) return [...chosen];
  if (chosen.includes(name)) return chosen.length === 1 ? [...chosen] : chosen.filter((n) => n !== name);
  return offered.filter((n) => n === name || chosen.includes(n));
}

/** A long or multi-line text as a grid cell shows it: the first <#= ChosenGridColumns.CutLength #> characters, then three dots. */
export function cutText(value: string | null | undefined): string {
  const text = value ?? '';
  return text.length > <#= ChosenGridColumns.CutLength #> ? text.substring(0, <#= ChosenGridColumns.CutLength - 3 #>) + '...' : text;
}

/**
 * The columns of one grid that a person can show or hide. `chosen` is what is shown; `sortable` and `properties` (the shown columns that sort, and the properties an OData page asks for with
 * $select) are single arrays that change in place, so a screen can give them to its base class once and still see the person's choice.
 */
export class GridColumns {
  chosen: string[];
  readonly sortable: string[] = [];
  readonly properties: string[] = [];

  constructor(private readonly gridKey: string, readonly offered: readonly GridColumn[], readonly initial: readonly string[]) {
    this.chosen = loadColumns(gridKey, offered.map((column) => column.name), initial);
    this.refresh();
  }

  has(name: string): boolean {
    return this.chosen.includes(name);
  }

  /** The only shown column: its check box is disabled, because a grid with no column shows nothing to open a row from. */
  isLast(name: string): boolean {
    return this.chosen.length === 1 && this.chosen[0] === name;
  }

  toggle(name: string): void {
    this.set(toggleColumn(this.chosen, this.offered.map((column) => column.name), name));
  }

  reset(): void {
    this.set([...this.initial]);
  }

  private set(chosen: string[]): void {
    this.chosen = chosen;
    saveColumns(this.gridKey, chosen, this.initial);
    this.refresh();
  }

  private refresh(): void {
    const shown = this.offered.filter((column) => this.chosen.includes(column.name));
    this.sortable.splice(0, this.sortable.length, ...shown.filter((column) => column.sortable).map((column) => column.name));
    this.properties.splice(0, this.properties.length, ...shown.map((column) => column.property));
  }
}
<# Write("@@@FILE grid-columns.spec.ts@@@\n"); #>
import { GridColumn, GridColumns, cutText, loadColumns, saveColumns, toggleColumn } from './grid-columns';

const offered = ['Name', 'City', 'Total', 'Notes'];
const initial = ['Name', 'City'];
const columns: GridColumn[] = [
  { name: 'Name', label: 'Name', property: 'name', sortable: true },
  { name: 'City', label: 'City', property: 'city', sortable: true },
  { name: 'Total', label: 'Total', property: 'total', sortable: true },
  { name: 'Notes', label: 'Notes', property: 'notes', sortable: false }
];

describe('grid-columns', () => {
  beforeEach(() => localStorage.clear());

  it('starts with the starting columns and keeps a choice between visits', () => {
    expect(loadColumns('rows', offered, initial)).toEqual(initial);
    saveColumns('rows', ['Name', 'Total'], initial);
    expect(loadColumns('rows', offered, initial)).toEqual(['Name', 'Total']);
    expect(loadColumns('other', offered, initial)).toEqual(initial);
  });

  it('forgets the choice when it is the starting columns again', () => {
    saveColumns('rows', ['Name', 'Total'], initial);
    saveColumns('rows', initial, initial);
    expect(localStorage.getItem('gridColumns:rows')).toBeNull();
  });

  it('drops a saved column the table no longer has, and keeps the table order', () => {
    localStorage.setItem('gridColumns:rows', JSON.stringify(['Total', 'Gone', 'Name']));
    expect(loadColumns('rows', offered, initial)).toEqual(['Name', 'Total']);
  });

  it('ignores a saved value that is not a list of columns', () => {
    for (const bad of ['{not json', '5', '{"Name":true}', '[]', '["Gone"]', '[7]']) {
      localStorage.setItem('gridColumns:rows', bad);
      expect(loadColumns('rows', offered, initial)).toEqual(initial);
    }
  });

  it('ticks a column in the table order and clears one, but never the last', () => {
    expect(toggleColumn(['Name', 'City'], offered, 'Total')).toEqual(['Name', 'City', 'Total']);
    expect(toggleColumn(['City'], offered, 'Name')).toEqual(['Name', 'City']);
    expect(toggleColumn(['Name', 'City'], offered, 'City')).toEqual(['Name']);
    expect(toggleColumn(['Name'], offered, 'Name')).toEqual(['Name']);
    expect(toggleColumn(['Name'], offered, 'Gone')).toEqual(['Name']);
  });

  it('cuts a long text and leaves a short one', () => {
    expect(cutText(null)).toBe('');
    expect(cutText('short')).toBe('short');
    expect(cutText('x'.repeat(<#= ChosenGridColumns.CutLength #>))).toBe('x'.repeat(<#= ChosenGridColumns.CutLength #>));
    expect(cutText('x'.repeat(<#= ChosenGridColumns.CutLength + 1 #>))).toBe('x'.repeat(<#= ChosenGridColumns.CutLength - 3 #>) + '...');
  });

  it('keeps the sortable columns and the properties up to date in the same arrays', () => {
    const shown = new GridColumns('rows', columns, initial);
    const sortable = shown.sortable;
    const properties = shown.properties;
    expect(sortable).toEqual(['Name', 'City']);
    expect(properties).toEqual(['name', 'city']);

    shown.toggle('Notes');
    expect(shown.has('Notes')).toBe(true);
    expect(sortable).toEqual(['Name', 'City']);   // the notes column cannot sort the grid
    expect(properties).toEqual(['name', 'city', 'notes']);

    shown.toggle('Name');
    expect(sortable).toEqual(['City']);
    expect(properties).toEqual(['city', 'notes']);
    expect(JSON.parse(localStorage.getItem('gridColumns:rows') ?? 'null')).toEqual(['City', 'Notes']);

    shown.reset();
    expect(sortable).toEqual(['Name', 'City']);
    expect(properties).toEqual(['name', 'city']);
    expect(localStorage.getItem('gridColumns:rows')).toBeNull();
  });

  it('knows the one column left, which cannot be cleared', () => {
    const shown = new GridColumns('rows', columns, ['Name']);
    expect(shown.isLast('Name')).toBe(true);
    shown.toggle('Name');
    expect(shown.has('Name')).toBe(true);
    shown.toggle('City');
    expect(shown.isLast('Name')).toBe(false);
  });
});
