<#@ template language="C#" #>
<#@ parameter name="Model" type="CodeGenNew.Core.TableModel" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // MySQL has real stored procedures with its own syntax: CodeGenNew.Core's MySqlProcedures writes this one for a table read from MySQL.
    if (Model.Dialect == SqlDialect.MySql)
    {
        Write(MySqlProcedures.Search(Model));
        return GenerationEnvironment.ToString();
    }
#>
<#
    // ==========================================================================================
    // SP_Search_v1.tt
    // Generates: <TableName>_Search.sql - two procedures in one file (CodeGenPossibilities\Pagination in
    // the research folder), the same "several CREATE PROCEDURE...GO blocks in one output file" convention
    // SP_Junction.tt already uses for its List/Link/Unlink trio.
    //
    // <TableName>_Search: a list/search screen that builds a dynamic filter from whichever of several
    // optional text boxes the user actually filled in (CodeGenPossibilities\SearchFilterBuilder in the
    // research folder): one @Column parameter per searchable column, defaulting to NULL (not filtered on);
    // every supplied parameter contributes an AND-ed "column LIKE '%value%'" clause, so a caller can search
    // by any combination of columns, or none (returns every row). Paginated (CodeGenPossibilities\Pagination):
    // @PageNumber (1-based) and @PageSize, applied via OFFSET/FETCH NEXT after the ORDER BY every paginated
    // query needs to be deterministic.
    //
    // <TableName>_SearchCount: the identical WHERE clause (same filter parameters, same rule for what counts
    // as searchable), but SELECT COUNT(*) - no columns, no ORDER BY, no paging. A caller needs this to know
    // how many pages exist. Kept as a SEPARATE procedure/round-trip rather than a COUNT(*) OVER() column on
    // every row of <TableName>_Search: that column would stop <TableName>_Search's result shape from matching
    // the entity's own mapped columns exactly, which breaks the Set<T>().FromSqlRaw(...) call every consumer
    // of this procedure already uses the same way the real TimeEntryContext.SpCanDeleteAsync does today -
    // avoided rather than asking every target project to register a second per-table DTO type just to read
    // one extra column.
    //
    // Searchable columns are every string column (ColumnModel.IsStringColumn) that isn't audit-classified
    // (IsAuditColumn - Create*/Modif*/Change*/Delete*/Update*/Activ*/Inactiv*, per AuditColumnClassifier):
    // nobody types into a search box for "who created this row". A table with none (all-numeric/date/bit
    // columns, e.g. a monthly-summary table keyed only by ids/numbers) still gets both procedures, just with
    // no filter parameters and no WHERE clause at all - pagination and searchability are separate concerns,
    // found live needing pagination on exactly such a table (2026-09-28): a table only grows over time, with
    // or without anything to type into a search box.
    //
    // Parameters are LTRIM/RTRIM'd before the LIKE, matching SP_Insert.tt's "trim strings" rule - a caller
    // who fat-fingers a leading/trailing space still gets the match they meant.
    //
    // No index is assumed for any searched column: LIKE '%...%' is a leading-wildcard scan, O(n) per
    // filtered column on a large table. That's a real performance cost on a big table with many searchable
    // columns - add an index (or trim which columns this searches, by hand, in the generated file) if it
    // gets slow, the same "documented limit, not silently generated as if free" choice TS_Component.tt's
    // own no-paging note makes.
    //
    // <TableName>_Search returns every column (not just the display columns SP_Lookup.tt returns), since a
    // search results grid usually wants to show more than just the row's identity - this is a plain
    // filtered SELECT, not a summary. ORDER BY is the same "best display column, then primary key"
    // convention SP_Lookup.tt uses.
    //
    // Requires a primary key (the result set needs something stable for a caller to act on) and a table,
    // not a view. Does not filter out inactive/soft-deleted rows - that's a different, orthogonal concern
    // from "which columns can I type into a search box" and is left to the caller (or SP_Lookup.tt, which
    // already handles it) rather than folded in here silently.

    var searchableColumns = Model.SearchableColumns;

    string Q(string identifier) => "[" + identifier.Replace("]", "]]") + "]";

    var whereClauses = searchableColumns
        .Select(c => $"({c.ParameterName} IS NULL OR {Q(c.Name)} LIKE '%' + LTRIM(RTRIM({c.ParameterName})) + '%')")
        .ToList();
    // Empty when there's nothing to filter on - both procedures below then read/count every row
    // unconditionally, instead of a "WHERE" with nothing after it.
    string whereClause = whereClauses.Count > 0 ? "\tWHERE " + string.Join("\r\n\t  AND ", whereClauses) + "\r\n" : "";

    var sortColumn = Model.DisplayColumns
        .OrderBy(c => c.DisplayRank ?? int.MaxValue).ThenBy(c => c.OrdinalPosition)
        .FirstOrDefault();
    var orderBy = new List<string>();
    if (sortColumn is not null)
        orderBy.Add(Q(sortColumn.Name) + " ASC");
    foreach (var pk in Model.PrimaryKeyColumns.Where(pk => pk != sortColumn))
        orderBy.Add(Q(pk.Name) + " ASC");

    if (Model.Dialect == SqlDialect.PostgreSql)
    {
        // PostgreSQL has functions, not procedures with @parameters and OFFSET/FETCH: <Table>_Search returns SETOF the table's own row type
        // (so EF Core maps it exactly like the table, and "SELECT * FROM" it is composable) and <Table>_SearchCount returns an integer.
        // Names are quoted so they keep their case; a parameter is "p" + the column name, never equal to a column name. ILIKE gives the
        // case-insensitive match SQL Server's default collation gives.
        string PQ(string identifier) => "\"" + identifier.Replace("\"", "\"\"") + "\"";
        string PParam(ColumnModel c) => PQ(c.ParameterName.TrimStart('@'));
        string pgTable = PQ(Model.SchemaName) + "." + PQ(Model.DbTableName);
        string pgWhere = searchableColumns.Count == 0 ? "" : "\tWHERE " + string.Join("\n\t  AND ", searchableColumns
            .Select(c => $"({PParam(c)} IS NULL OR {PQ(c.DbName)}{(c.DbEnumType is null ? "" : "::text")} ILIKE '%' || btrim({PParam(c)}) || '%')")) + "\n";   // an enum column has no ILIKE: compare its text
        // The default order (best display column, then the key) follows the chosen sort as the tie-breaker.
        var pgDefaultOrder = new List<string>();
        if (sortColumn is not null)
            pgDefaultOrder.Add(PQ(sortColumn.DbName) + " ASC");
        foreach (var pk in Model.PrimaryKeyColumns.Where(pk => pk != sortColumn))
            pgDefaultOrder.Add(PQ(pk.DbName) + " ASC");
        string pgOrderBy = string.Join(", ", pgDefaultOrder);
        var searchParams = searchableColumns.Select(c => $"{PParam(c)} {c.SqlTypeDeclaration} DEFAULT NULL").ToList();

        var pg = new System.Text.StringBuilder();
        // A function with a different parameter list is a second function with the same name, not a replacement, and a call that leaves defaults out is then
        // ambiguous: drop the earlier signature (the same list without SortColumn / SortDescending) if it exists.
        pg.Append("DROP FUNCTION IF EXISTS " + PQ(Model.SchemaName) + "." + PQ(Model.TableName + "_Search") + "("
            + string.Join(", ", searchableColumns.Select(c => c.SqlTypeDeclaration).Append("integer").Append("integer")) + ");\n\n");
        pg.Append("CREATE OR REPLACE FUNCTION " + PQ(Model.SchemaName) + "." + PQ(Model.TableName + "_Search") + "(\n");
        // SortColumn / SortDescending: the grid's chosen sort (SearchSort); both default to "the default order".
        pg.Append(string.Join(",\n", searchParams.Append("\"PageNumber\" integer DEFAULT 1").Append("\"PageSize\" integer DEFAULT 100")
            .Append("\"SortColumn\" text DEFAULT NULL").Append("\"SortDescending\" boolean DEFAULT false")) + "\n)\n");
        pg.Append("RETURNS SETOF " + pgTable + "\nLANGUAGE sql STABLE\nAS $$\n");
        pg.Append("\tSELECT t.* FROM " + pgTable + " AS t\n" + pgWhere);
        pg.Append("\tORDER BY\n" + SearchSort.Postgres(Model) + "\t\t" + pgOrderBy + "\n\tOFFSET (\"PageNumber\" - 1) * \"PageSize\" LIMIT \"PageSize\";\n$$;\n\n");
        pg.Append("CREATE OR REPLACE FUNCTION " + PQ(Model.SchemaName) + "." + PQ(Model.TableName + "_SearchCount") + "(");
        pg.Append(searchParams.Count > 0 ? "\n" + string.Join(",\n", searchParams) + "\n" : "");
        pg.Append(")\nRETURNS integer\nLANGUAGE sql STABLE\nAS $$\n");
        pg.Append("\tSELECT count(*)::integer FROM " + pgTable + (pgWhere.Length > 0 ? "\n" + pgWhere.TrimEnd('\n') : "") + ";\n$$;\n");
        Write(pg.ToString());
    }
    else
    {
#>
CREATE OR ALTER PROCEDURE [<#= Model.SchemaName #>].[<#= Model.TableName #>_Search]
(
<#
    foreach (var c in searchableColumns)
    {
#>
<#= c.ParameterName #> <#= c.SqlTypeDeclaration #> = NULL,
<#
    }
#>
@PageNumber INT = 1,
@PageSize INT = 100,
@SortColumn NVARCHAR(128) = NULL,
@SortDescending BIT = 0
)
AS
BEGIN
	SET NOCOUNT ON;

	SELECT <#= Q(Model.Columns[0].Name) #>
<#
    for (int i = 1; i < Model.Columns.Count; i++)
    {
#>
		,<#= Q(Model.Columns[i].Name) #>
<#
    }
#>
	FROM [<#= Model.SchemaName #>].[<#= Model.TableName #>] AS t
<#= whereClause #>	ORDER BY
<#= SearchSort.SqlServer(Model) #>		<#= string.Join(", ", orderBy) #>
	OFFSET (@PageNumber - 1) * @PageSize ROWS FETCH NEXT @PageSize ROWS ONLY;
END
GO

CREATE OR ALTER PROCEDURE [<#= Model.SchemaName #>].[<#= Model.TableName #>_SearchCount]
<#
    // Empty "( )" is invalid T-SQL (CREATE PROCEDURE with no parameters omits the parens entirely) -
    // found live (2026-09-28) generating this for a table with no searchable columns.
    if (searchableColumns.Count > 0)
    {
#>
(
<#
        for (int i = 0; i < searchableColumns.Count; i++)
        {
            var c = searchableColumns[i];
            string comma = (i < searchableColumns.Count - 1) ? "," : "";
#>
<#= c.ParameterName #> <#= c.SqlTypeDeclaration #> = NULL<#= comma #>
<#
        }
#>
)
<#
    }
#>
AS
BEGIN
	SET NOCOUNT ON;

	SELECT COUNT(*)
	FROM [<#= Model.SchemaName #>].[<#= Model.TableName #>]<#= whereClauses.Count > 0 ? "\r\n" + whereClause.TrimEnd('\r', '\n') : "" #>;
END
<#
    }
#>
