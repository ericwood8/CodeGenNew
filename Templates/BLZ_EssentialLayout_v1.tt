<#@ template language="C#" #>
<#@ parameter name="Project" type="CodeGenNew.Core.ProjectSettings" #>
<#@ import namespace="CodeGenNew.Core" #>
<#
    // ==========================================================================================
    // BLZ_EssentialLayout_v1.tt
    // Generates: Layout/MainLayout.razor and wwwroot/css/app.css   (no table, no database: an essentials group; the output folder is the Blazor app's own folder)
    // The page frame: the menu (Layout/NavMenu.razor, which BLZ_Screens writes from the Screens setting) beside the page, a hamburger button that opens and closes the menu, and the stylesheet
    // the generated pages assume (grid, search bar, paging, the edit form as a panel over the page). The pages use plain elements and these few class names.
    // ==========================================================================================
#>
@@@FILE Layout/MainLayout.razor@@@
@inherits LayoutComponentBase

<div class="@(menuOpen ? "app" : "app menu-closed")">
    @if (menuOpen)
    {
        <NavMenu />
    }
    <main>
        <button type="button" class="hamburger" aria-label="Toggle the menu" aria-expanded="@menuOpen" @onclick="() => menuOpen = !menuOpen">&#9776;</button>
        @Body
    </main>
</div>

@code {
    private bool menuOpen = true;
}
@@@FILE wwwroot/css/app.css@@@
:root { font-family: system-ui, sans-serif; color-scheme: light dark; }
body { margin: 0; }
.app { display: grid; grid-template-columns: 220px 1fr; min-height: 100vh; }
.app.menu-closed { grid-template-columns: 1fr; }
.hamburger { padding: 4px 10px; margin-bottom: 8px; font-size: 20px; line-height: 1; background: none; border: 1px solid transparent; border-radius: 4px; color: inherit; cursor: pointer; }
.hamburger:hover { background: #8883; }
.rail { display: flex; flex-direction: column; gap: 4px; padding: 16px 12px; border-right: 1px solid #8884; }
.rail a { padding: 8px 10px; border-radius: 4px; color: inherit; text-decoration: none; }
.rail a.active { background: #8883; font-weight: 600; }
main { padding: 16px 24px; }
table { border-collapse: collapse; width: 100%; }
th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid #8884; }
th button.sort { background: none; border: 0; color: inherit; font: inherit; font-weight: 600; cursor: pointer; padding: 0; }
tbody tr:hover { background: #8881; }
td button { background: #8883; border: 1px solid #8886; border-radius: 4px; font-weight: 700; cursor: pointer; }
td button:hover { background: #8885; }
main button { padding: 4px 12px; font: inherit; }
.search { margin: 8px 0; }
.search input { margin: 4px 6px 4px 0; padding: 6px 8px; font: inherit; }
.paging { display: flex; align-items: center; gap: 12px; margin-top: 12px; }
.error { color: #c62828; font-weight: 600; }

/* The add / edit form is a panel fixed over the page, wherever the grid is scrolled to. */
.editor { position: fixed; inset: 5vh 0 auto 0; margin: 0 auto; width: min(920px, 94vw); max-height: 90vh; overflow: auto; box-sizing: border-box; padding: 8px 24px 24px;
  border: 1px solid #8886; border-radius: 8px; background: Canvas; box-shadow: 0 0 0 100vmax rgb(0 0 0 / 0.45); }
.editor .field { display: flex; flex-direction: column; gap: 4px; margin-top: 12px; }
.editor label { font-weight: 600; }
.editor input[type='text'], .editor input[type='number'], .editor input[type='date'], .editor input:not([type]), .editor select, .editor textarea { width: 100%; box-sizing: border-box; padding: 6px 8px; font: inherit; }
.editor textarea { min-height: 80px; resize: vertical; }
.editor input[type='checkbox'] { align-self: flex-start; width: 18px; height: 18px; }
.editor .actions { display: flex; gap: 8px; margin-top: 16px; }
.validation-message { color: #c62828; }

#blazor-error-ui { display: none; position: fixed; bottom: 0; left: 0; right: 0; padding: 8px 16px; background: #ffe9a8; color: #000; }
