# Project settings for the write routines of TimeEntry_test (copied into the CLI's Projects folder by Rebuild-TestDatabase.ps1).
# The sample project only generates Search and Clone for SQL Server; the test database also gets the routines that write, with the value rules switched on.
ProjectName=TimeEntry
EnumTables=none
NoApiTables=TimeEntryUser,sysdiagrams
Stacks=Api
OutputSql=sql
DatabaseProvider=SqlServer
DatabaseName=TimeEntry_test
PlanAlso=SP_Insert,SP_Update,SP_Save,SP_Delete,SP_Lookup
NonNegativeColumns=HoursDonated,AvailableLeaveHours
# SP_BulkUpdate adds nothing here: no column of TimeEntry is rewritten in bulk
