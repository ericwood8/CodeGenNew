# Project settings for the write routines of InvoiceSystem_test (copied into the CLI's Projects folder by Rebuild-TestDatabase.ps1).
# The sample projects (InvoiceSystemBlazor and the rest) only generate Search and Clone for SQL Server; the test database also gets the routines that write,
# with the value rules switched on, so the guards of SP_Insert, SP_Update, SP_Save and SP_BulkUpdate can be run against stored rows that already break a rule.
ProjectName=InvoiceSystem
EnumTables=none
Stacks=Api
OutputSql=sql
DatabaseProvider=SqlServer
DatabaseName=InvoiceSystem_test
PlanAlso=SP_Insert,SP_Update,SP_Save,SP_Delete,SP_Lookup,SP_BulkUpdate
NonNegativeColumns=CreditLimit,OrderLimit,ListPrice,LastCost
NotFutureDateColumns=DateClosed
# SP_BulkUpdate adds 1 to the credit limit of every customer and leaves a negative one alone, so the stored -5 of ZZ-NEGCREDIT passes;
# change the expression to {column} - 1000 to see the routine refuse a row it changed into a negative value
BulkUpdateColumns=CreditLimit
BulkUpdateExpression=CASE WHEN {column} < 0 THEN {column} ELSE {column} + 1 END
