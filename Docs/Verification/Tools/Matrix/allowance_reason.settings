# the reason of an allowance or charge as a look-up (the foreign key makes the drop-down on every form): python matrix_check.py ReasonShop --settings-file Matrix/allowance_reason.settings
@schema=allowance_charges_reason
@stack=api,python,rust,blazor
AllowanceCharges=InvoiceAllowanceCharge:IsCharge:BaseAmount:Percentage:Amount:InvoiceId
AccessMode=Ef
ApiTests=true
BlazorTests=true
PythonTests=true
RustTests=true
