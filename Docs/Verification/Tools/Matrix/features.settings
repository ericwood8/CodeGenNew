# feature flags with a plan link and a cache: python matrix_check.py Flags --settings-file Matrix/features.settings
@schema=features
@stack=api,python,rust
ApiAuth=true
TenantTable=Tenant
TenantMembership=EmployeeTenant:EmployeeId:TenantId:Role
UserTable=Employee
UserNameColumn=Login
UserRoleColumn=IsManager
UserAdminColumn=IsAdministrator
UserOwnerColumn=EmployeeId
SubscriptionTable=Subscription
PlanTable=Plan
FeatureTables=Feature,FeatureOverride
FeaturePlanTable=PlanFeature
FeatureCacheSeconds=30
ApiTests=true
PythonTests=true
RustTests=true
